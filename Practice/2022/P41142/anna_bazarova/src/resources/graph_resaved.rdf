        <cha rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</cha>
        <cmb rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</cmb>
        <cmd rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">26</cmd>
        <con rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</con>
        <dex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</dex>
        <hasFlatFootedValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19</hasFlatFootedValue>
        <hasFortValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</hasFortValue>
        <hasInitValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</hasInitValue>
        <hasRefValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</hasRefValue>
        <hasSpeedValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</hasSpeedValue>
        <hasTouchValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</hasTouchValue>
        <hasWillValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasWillValue>
        <hasXPValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3200</hasXPValue>
        <int rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</int>
        <str rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">23</str>
        <wis rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</wis>
        <hasACValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19</hasACValue>
        <hasCRValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</hasCRValue>
        <hasHPvalue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">90</hasHPvalue>
    </owl:NamedIndividual>
    


