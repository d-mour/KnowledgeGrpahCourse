                        <owl:onProperty rdf:resource="http://www.semanticweb.org/annab/ontologies/2022/3/ontology#canSpell"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/annab/ontologies/2022/3/ontology#Spells"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/annab/ontologies/2022/3/ontology#Beast"/>
    </owl:Class>
    


