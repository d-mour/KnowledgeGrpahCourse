<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/neeraj/ontologies/2020/10/books-ontology#" xml:base="http://www.semanticweb.org/neeraj/ontologies/2020/10/books-ontology" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:xml="http://www.w3.org/XML/1998/namespace" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:books="http://www.semanticweb.org/books#" xmlns:ontobooks="http://www.semanticweb.org/e1izabeth/ontobooks#">
  <owl:Ontology rdf:about="http://www.semanticweb.org/e1izabeth/ontobooks">
    <rdfs:comment>A book Ontology that describes various books and their relations</rdfs:comment>
  </owl:Ontology>
  <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->
  <!-- http://www.semanticweb.org/e1izabeth/ontobooks#hasAuthoredBy -->
  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/e1izabeth/ontobooks#hasAuthoredBy">
    <rdfs:domain rdf:resource="http://www.semanticweb.org/e1izabeth/ontobooks#Books" />
    <rdfs:range rdf:resource="http://www.semanticweb.org/e1izabeth/ontobooks#Author" />
  </owl:ObjectProperty>
  <!-- http://www.semanticweb.org/e1izabeth/ontobooks#hasGenre -->
  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/e1izabeth/ontobooks#hasGenre">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <rdfs:domain rdf:resource="http://www.semanticweb.org/e1izabeth/ontobooks#Books" />
    <rdfs:range rdf:resource="http://www.semanticweb.org/e1izabeth/ontobooks#Genre" />
  </owl:ObjectProperty>
  <!-- http://www.semanticweb.org/e1izabeth/ontobooks#isBasedOnBook -->
  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/e1izabeth/ontobooks#isBasedOnBook">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <rdfs:domain rdf:resource="http://www.semanticweb.org/e1izabeth/ontobooks#Film" />
    <rdfs:range rdf:resource="http://www.semanticweb.org/e1izabeth/ontobooks#Books" />
  </owl:ObjectProperty>
  <!-- http://www.semanticweb.org/e1izabeth/ontobooks#origin -->
  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/e1izabeth/ontobooks#origin">
    <rdfs:domain rdf:resource="http://www.semanticweb.org/e1izabeth/ontobooks#Author" />
    <rdfs:domain rdf:resource="http://www.semanticweb.org/e1izabeth/ontobooks#Books" />
    <rdfs:range rdf:resource="http://www.semanticweb.org/e1izabeth/ontobooks#Country" />
  </owl:ObjectProperty>
  <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->
  <!-- http://www.semanticweb.org/e1izabeth/ontobooks#hasNoOfPages -->
  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/e1izabeth/ontobooks#hasNoOfPages">
    <rdfs:domain rdf:resource="http://www.semanticweb.org/e1izabeth/ontobooks#Books" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
    <rdfs:comment>Number of pages in the book</rdfs:comment>
  </owl:DatatypeProperty>
  <!-- http://www.semanticweb.org/e1izabeth/ontobooks#hasPublishedYear -->
  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/e1izabeth/ontobooks#hasPublishedYear">
    <rdfs:domain rdf:resource="http://www.semanticweb.org/e1izabeth/ontobooks#Books" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
    <rdfs:comment>The year the book was published</rdfs:comment>
  </owl:DatatypeProperty>
  <!-- http://www.semanticweb.org/e1izabeth/ontobooks#hasRating -->
  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/e1izabeth/ontobooks#hasRating">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <rdfs:domain rdf:resource="http://www.semanticweb.org/e1izabeth/ontobooks#Books" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <!-- http://www.semanticweb.org/e1izabeth/ontobooks#hasTitle -->
  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/e1izabeth/ontobooks#hasTitle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <rdfs:domain rdf:resource="http://www.semanticweb.org/e1izabeth/ontobooks#Books" />
    <rdfs:domain rdf:resource="http://www.semanticweb.org/e1izabeth/ontobooks#Film" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->
  <!-- http://www.semanticweb.org/e1izabeth/ontobooks#Author -->
  <owl:Class rdf:about="http://www.semanticweb.org/e1izabeth/ontobooks#Author" />
  <!-- http://www.semanticweb.org/e1izabeth/ontobooks#BigSize -->
  <owl:Class rdf:about="http://www.semanticweb.org/e1izabeth/ontobooks#BigSize">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.semanticweb.org/e1izabeth/ontobooks#Books" />
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://www.semanticweb.org/e1izabeth/ontobooks#hasNoOfPages" />
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">400</xsd:minInclusive>
                  </rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:comment>A big book is the one that has more than 400 pages</rdfs:comment>
  </owl:Class>
  <!-- http://www.semanticweb.org/e1izabeth/ontobooks#Books -->
  <owl:Class rdf:about="http://www.semanticweb.org/e1izabeth/ontobooks#Books" />
  <!-- http://www.semanticweb.org/e1izabeth/ontobooks#Classics -->
  <owl:Class rdf:about="http://www.semanticweb.org/e1izabeth/ontobooks#Classics">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.semanticweb.org/e1izabeth/ontobooks#Books" />
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://www.semanticweb.org/e1izabeth/ontobooks#hasPublishedYear" />
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1990</xsd:maxInclusive>
                  </rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:comment>Classics are the books which were published before 1990</rdfs:comment>
  </owl:Class>
  <!-- http://www.semanticweb.org/e1izabeth/ontobooks#Country -->
  <owl:Class rdf:about="http://www.semanticweb.org/e1izabeth/ontobooks#Country" />
  <!-- http://www.semanticweb.org/e1izabeth/ontobooks#Film -->
  <owl:Class rdf:about="http://www.semanticweb.org/e1izabeth/ontobooks#Film" />
  <!-- http://www.semanticweb.org/e1izabeth/ontobooks#Genre -->
  <owl:Class rdf:about="http://www.semanticweb.org/e1izabeth/ontobooks#Genre">
    <rdfs:comment>Change Equivalent class as you update the individuals</rdfs:comment>
  </owl:Class>
  <!-- http://www.semanticweb.org/e1izabeth/ontobooks#Latest -->
  <owl:Class rdf:about="http://www.semanticweb.org/e1izabeth/ontobooks#Latest">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.semanticweb.org/e1izabeth/ontobooks#Books" />
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://www.semanticweb.org/e1izabeth/ontobooks#hasPublishedYear" />
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2015</xsd:minInclusive>
                  </rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:comment>Latest books are published after 2015</rdfs:comment>
  </owl:Class>
  <!-- http://www.semanticweb.org/e1izabeth/ontobooks#SmallSize -->
  <owl:Class rdf:about="http://www.semanticweb.org/e1izabeth/ontobooks#SmallSize">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.semanticweb.org/e1izabeth/ontobooks#Books" />
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://www.semanticweb.org/e1izabeth/ontobooks#hasNoOfPages" />
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">200</xsd:maxInclusive>
                  </rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:comment>A book is small if it has less than 200 pages</rdfs:comment>
  </owl:Class>
  <!-- http://www.semanticweb.org/e1izabeth/ontobooks#Top_Book -->
  <owl:Class rdf:about="http://www.semanticweb.org/e1izabeth/ontobooks#Top_Book">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.semanticweb.org/e1izabeth/ontobooks#Books" />
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://www.semanticweb.org/e1izabeth/ontobooks#hasRating" />
            <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">4</owl:minQualifiedCardinality>
            <owl:onDataRange rdf:resource="http://www.w3.org/2002/07/owl#rational" />
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/e1izabeth/ontobooks#Books" />
  </owl:Class>
