    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/b6086d22-56fa-11eb-8798-fa163e99870e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/b6086d22-56fa-11eb-8798-fa163e99870e">
