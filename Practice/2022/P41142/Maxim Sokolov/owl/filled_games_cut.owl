    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/772d7540-3062-11e9-92d9-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/772d7540-3062-11e9-92d9-00163e97122a">
