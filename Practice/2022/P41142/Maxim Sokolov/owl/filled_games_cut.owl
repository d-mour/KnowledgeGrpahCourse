    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/fb8bfcd8-e9eb-11e9-8422-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/fb8bfcd8-e9eb-11e9-8422-00163e97122a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-08T19:52:15</review:date>
        <review:description>A nice, platformer shooter, suited for every type of gamer (the game is as hard as the score u want to get). Keeps a fast pace up until the last part, where it becomes a bit more tactical. There are also some easy puzzles involving shoothing. My fav part is the music, just boosts it so much. Also has good replay value if u want to improve. And what other ame has a talking banana companion.
RAISE YOUR BANANAS ( ͡° ͜ʖ ͡°)▄︻̷̿┻̿═━一
this is you</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</review:downvotes>
