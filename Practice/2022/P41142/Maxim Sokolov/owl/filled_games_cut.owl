    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/304c5ec6-94bc-11e8-a8ff-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/304c5ec6-94bc-11e8-a8ff-00163e97122a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2012-06-13T18:36:12</review:date>
        <review:description>i have tried many games old and new,trying to find a space sim as good as the wing commander series is to me.some are more advanced, some have huge galaxies,but none have the stories or atmosphere i was looking for, until i found freespace great frikkin game man!!!! i can&apos;t wait to finish so i can get freespace 2.</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</review:downvotes>
