    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/a96ac294-f5da-11ea-9c60-fa163edf6d96 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/a96ac294-f5da-11ea-9c60-fa163edf6d96">
