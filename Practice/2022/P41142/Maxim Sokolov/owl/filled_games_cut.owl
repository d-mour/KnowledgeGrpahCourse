    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/b6be2038-3a50-11ec-a148-fa163e9aa6fa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/b6be2038-3a50-11ec-a148-fa163e9aa6fa">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-10-31T15:44:47</review:date>
        <review:description>It is so hard to find a good adventure game these days. 
When it happens I actually feel moved.

Saint Kotar offers a compelling plot and a great gameplay system.
I&apos;ve only played it for an hour and it got me hooked like so few games before.

I&apos;m so glad I backed this project and so happy of how it turned out!</review:description>
