    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/dee0a49e-a43d-11ec-aca7-fa163e99870e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/dee0a49e-a43d-11ec-aca7-fa163e99870e">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-03-15T10:56:58</review:date>
        <review:description>The game visuals and story are good BUT in normal mode I can one shot most enemies from the start .

the combat is a big component of the game  and I am not finding it fun.

I have ask for a refund even though I would like to know how the story will go But its to repetitive to play I found myself trying to avoid combat encounters.</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</review:downvotes>
        <review:id>dee0a49e-a43d-11ec-aca7-fa163e99870e</review:id>
        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</review:rating>
        <review:title>I Have got a big Problem </review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/def064f6-b265-11e8-9461-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/def064f6-b265-11e8-9461-00163e97122a">
