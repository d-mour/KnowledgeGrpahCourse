    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d90e27a0-94c2-11e8-9449-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d90e27a0-94c2-11e8-9449-00163e97122a">
