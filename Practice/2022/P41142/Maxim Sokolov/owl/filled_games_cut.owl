    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/c127db96-d523-11eb-81b6-fa163e048183 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/c127db96-d523-11eb-81b6-fa163e048183">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-06-24T22:38:30</review:date>
        <review:description>I think there is definitely room for a pirate game like this. But sadly this is definitely not it. Lots of gameplay and UI aspects that are extremely shoddy and the underlying game is just outright not fun.</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</review:downvotes>
