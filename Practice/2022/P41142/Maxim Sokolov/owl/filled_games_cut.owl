    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/f798f1a0-e0b0-11ea-88e1-fa163e93294d -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/f798f1a0-e0b0-11ea-88e1-fa163e93294d">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-17T20:42:06</review:date>
        <review:description>I still feel like I can play through the first game but second loses me in seconds. Awful.</review:description>
