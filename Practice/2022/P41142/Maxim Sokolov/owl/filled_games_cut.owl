    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/b079b76e-93fa-11e8-8939-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/b079b76e-93fa-11e8-8939-00163e97122a">
