    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/ac2d58ce-ea9d-11e8-829d-00163e4e60cc -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/ac2d58ce-ea9d-11e8-829d-00163e4e60cc">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-11-17T21:19:15</review:date>
        <review:description>Obra Dinn is a unique game in the fact that most of the gameplay comes from your ability to reason and deduce.  You are tasked with finding the fates of the members aboard a ship in 1803.  Everything the game gives you contains clues that you might not expect at first glance.  All in all this a phenomenal time with a well executed idea, supported by great music and voice acting.</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</review:downvotes>
        <review:id>ac2d58ce-ea9d-11e8-829d-00163e4e60cc</review:id>
        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</review:rating>
        <review:title>A Unique and Compelling Title</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/ac59a0fe-94ae-11e8-ab73-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/ac59a0fe-94ae-11e8-ab73-00163e97122a">
