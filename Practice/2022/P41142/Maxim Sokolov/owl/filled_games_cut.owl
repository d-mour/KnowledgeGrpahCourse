    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/fb816abe-698f-11eb-a682-fa163e99870e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/fb816abe-698f-11eb-a682-fa163e99870e">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-02-08T00:01:08</review:date>
        <review:description>This made a huge impact when it came out back in the days. The story was really exciting, and the dogfights intense. And these huge battleships which you could blow to pieces with a couple bombing runs.... so satisfying. And even today, the graphics are somewhat okay. Only surpassed by Freespace 2. </review:description>
