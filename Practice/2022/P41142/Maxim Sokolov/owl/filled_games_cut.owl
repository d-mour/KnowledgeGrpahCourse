    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/fde7b976-d3fa-11ec-bbf6-fa163e99870e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/fde7b976-d3fa-11ec-bbf6-fa163e99870e">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
