    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/c9e4e65c-5d60-11ea-9cdc-fa163e62c76a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/c9e4e65c-5d60-11ea-9cdc-fa163e62c76a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-03T17:08:07</review:date>
        <review:description>I&apos;ve been playing since 2016, back when you could only buy it on their site.  This game is one of my top always GO-TO games when I&apos;m not sure what to play.   Who does not love making a chair out of the skin of raiders who attacked you‽  If you ever get bored of vanilla RimWorld, the mods take this game to 11.  This is a must-own game.</review:description>
