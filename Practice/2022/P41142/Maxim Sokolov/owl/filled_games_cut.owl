    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/2faa1322-100d-11eb-b3fd-fa163edf6d96 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/2faa1322-100d-11eb-b3fd-fa163edf6d96">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-10-17T03:10:38</review:date>
        <review:description>As has become so prevalent a trend in video games these days, the theme of this game is nihilism. I regret having played it, I regret having spent money on it.</review:description>
