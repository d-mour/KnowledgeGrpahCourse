    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/4e7ceb6c-d39c-11e8-8252-00163e4e60cc -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/4e7ceb6c-d39c-11e8-8252-00163e4e60cc">
