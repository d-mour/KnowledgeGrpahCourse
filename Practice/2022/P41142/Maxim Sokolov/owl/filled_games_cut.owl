    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/b3b6034a-93fc-11e8-b83b-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/b3b6034a-93fc-11e8-b83b-00163e97122a">
