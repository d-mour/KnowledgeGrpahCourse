    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/5f6a969e-93fb-11e8-8b40-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/5f6a969e-93fb-11e8-8b40-00163e97122a">
