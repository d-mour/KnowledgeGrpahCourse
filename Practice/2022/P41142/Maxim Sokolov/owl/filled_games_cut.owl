        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/3628a2c8-93f9-11e8-bda7-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/3628a2c8-93f9-11e8-bda7-00163e97122a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-09-15T09:30:26</review:date>
        <review:description>For a great challenge and good fun (who doesn&apos;t love a chaingun attached to their hand?) MDK delivers. It has excellent graphics for it&apos;s time period, and superb gameplay.</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</review:downvotes>
