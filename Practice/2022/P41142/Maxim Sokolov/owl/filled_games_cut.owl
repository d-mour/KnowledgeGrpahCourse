    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/5925d538-d812-11eb-8599-fa163e99870e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/5925d538-d812-11eb-8599-fa163e99870e">
