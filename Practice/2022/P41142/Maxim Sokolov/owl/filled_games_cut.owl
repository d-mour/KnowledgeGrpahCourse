    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/3b665fbe-952f-11e8-be0b-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/3b665fbe-952f-11e8-be0b-00163e97122a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2014-03-16T09:33:25</review:date>
        <review:description>MDK is one of those game you will never forget. Very interesting sense of humor, very interesting artistic design along with funny backstory (reading manual is definitely worth it!). It&apos;s lighthearted third person shooter, combined with platforming and puzzle solving. Good thing it&apos;s more fun than frustrating (good for person that is not good at this like me anyway).
Art, level design, sound, one of the best I know. The only thing I experienced were some graphical glitches, but game was still playable no problem.</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</review:downvotes>
        <review:id>3b665fbe-952f-11e8-be0b-00163e97122a</review:id>
        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</review:rating>
        <review:title>Great short experience</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</review:upvotes>
    </owl:NamedIndividual>
    


