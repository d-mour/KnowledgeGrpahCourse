    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d67d9f04-af95-11e9-9b39-5a139edad411 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d67d9f04-af95-11e9-9b39-5a139edad411">
