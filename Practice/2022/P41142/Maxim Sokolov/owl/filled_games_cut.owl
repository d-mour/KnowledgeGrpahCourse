    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/ad2bef32-7ccc-11ec-90a6-fa163e99870e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/ad2bef32-7ccc-11ec-90a6-fa163e99870e">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-01-24T06:18:26</review:date>
        <review:description>This game has just the right amount of difficulty with it&apos;s puzzles, so that you feel challenged but don&apos;t resort to online help forums every few puzzles.

It has a very addictive game loop of identifying plants and locating plants on the map via a varieties of puzzles.

All in all a very fun game well worth the $20 I paid for it.</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</review:downvotes>
