    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/dea21034-6240-11eb-a284-fa163e9aa6fa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/dea21034-6240-11eb-a284-fa163e9aa6fa">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-29T16:47:11</review:date>
        <review:description>This game has some old-fashioned gameplay mechanics and it is also rather difficult. BUT: this game is historical for genre, so it is suitable for this price.
P.S.: the game has unique atmosphere. If You played, You know what i mean.</review:description>
