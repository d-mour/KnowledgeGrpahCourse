    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d811b3b4-37f7-11eb-8c38-fa163e4cd76b -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d811b3b4-37f7-11eb-8c38-fa163e4cd76b">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-12-06T21:18:38</review:date>
        <review:description>It is not a classic 3rd-person point&amp;amp;click adventure. But that doesn&apos;t matter. Chicken Police is a great adventure game. Very entertaining, exciting and amusing from beginning to end. The film noir ambience is perfectly realised graphically and musically. This is further supported by the great voice acting - something that for me personally is always an important quality feature of a game. I have nothing to criticise about it. Chicken Police is certainly the best animal fable crime noir game currently available and far outshines rival titles such as Blacksad or the ill-fated Backbone. </review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</review:downvotes>
        <review:id>d811b3b4-37f7-11eb-8c38-fa163e4cd76b</review:id>
        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</review:rating>
        <review:title>Great game!</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d86cd2a4-65ce-11ea-8a3a-fa163e62c76a -->

