    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/dlc/1106009053 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/dlc/1106009053">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#DLC"/>
        <product:has_genre rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/genre/adventure"/>
        <product:has_genre rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/genre/role-playing"/>
        <product:has_lang_support rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/language/en"/>
        <product:has_tag rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/tag/artbook"/>
        <product:has_tag rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/tag/indie"/>
        <product:has_tag rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/tag/sexual-content"/>
        <product:has_tag rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/tag/violent"/>
        <product:active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</product:active>
        <product:full_desc>The Pirate&apos;s Fate has a ton of art, and the Pirate&apos;s Fate Art Book has it all - and then some. Prepare for over 400 pages of art, including multiple characters, sequences, costumes, romances, backgrounds, and endings that didn&apos;t make it into the game. Along with way, you&apos;ll also be treated to special commentary by artist Volkenfox and writer T.F. Wright as they explain their insight into the design process.
</product:full_desc>
        <product:id rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1106009053</product:id>
        <product:is_pre_order rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</product:is_pre_order>
        <product:lead_desc>The Pirate&apos;s Fate has a ton of art, and the Pirate&apos;s Fate Art Book has it all - and then some. Prepare for over 400 pages of art, including multiple characters, sequences, costumes, romances, backgrounds, and endings that didn&apos;t make it into the game. Along with way, you&apos;ll also be treated to special commentary by artist Volkenfox and writer T.</product:lead_desc>
        <product:release_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-07-07T15:50:00</product:release_date>
        <product:slug>the_pirates_fate_art_book</product:slug>
        <product:title>The Pirate&apos;s Fate - Art Book</product:title>
