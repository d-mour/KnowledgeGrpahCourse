        <product:has_review rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/48965054-6108-11e9-b54b-00163e97122a"/>
        <product:has_review rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/94738df8-b22f-11e8-85c8-00163e97122a"/>
