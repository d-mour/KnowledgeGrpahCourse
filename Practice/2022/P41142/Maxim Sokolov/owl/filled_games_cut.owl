        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/96c0769a-b1b0-11e8-a64d-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/96c0769a-b1b0-11e8-a64d-00163e97122a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-05-13T19:39:22</review:date>
        <review:description>Инди-поделка по цене Ведьмака 3? Серьёзно? А ничего не треснет и не слипнется?</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">360</review:downvotes>
        <review:id>96c0769a-b1b0-11e8-a64d-00163e97122a</review:id>
