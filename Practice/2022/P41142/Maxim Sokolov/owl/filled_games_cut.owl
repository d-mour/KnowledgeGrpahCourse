    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/1158103a-c2e8-11ea-826a-fa163e62c76a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/1158103a-c2e8-11ea-826a-fa163e62c76a">
