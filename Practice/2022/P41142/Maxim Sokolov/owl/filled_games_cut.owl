    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/c24522d0-93ff-11e8-8dec-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/c24522d0-93ff-11e8-8dec-00163e97122a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-10-03T16:14:26</review:date>
        <review:description>Anyone remember the wing commander series? The Privateer Series? well this has just as much meaty game play if not more. Get a joystick and a sub woofer for an awsome experiance!</review:description>
