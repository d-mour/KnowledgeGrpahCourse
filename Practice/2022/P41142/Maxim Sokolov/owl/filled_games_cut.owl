    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/9bb48436-d4f1-11eb-b22c-fa163e9aa6fa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/9bb48436-d4f1-11eb-b22c-fa163e9aa6fa">
