        <review:title>Turn based game done right</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/3cf226d8-b1f9-11e8-ac2b-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/3cf226d8-b1f9-11e8-ac2b-00163e97122a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-12-02T20:06:31</review:date>
        <review:description>I bought this game from the store years ago and it was one of my favorites. It has one of the most unique story lines I&apos;ve seen where they mix actual history into the fantasy setting. I found the game to be a lot of fun but it all ended when I got past the goblin camp and went into a cave, causing the game to crash, every. single. time.  I&apos;m guessing they fixed this glitch with a patch but now I don&apos;t have a system to run it, otherwise I&apos;d buy it in a heartbeat to relive and finish that story line.</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</review:downvotes>
        <review:id>3cf226d8-b1f9-11e8-ac2b-00163e97122a</review:id>
        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</review:rating>
        <review:title>Unique storyline, but crashed</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/3d059170-949c-11e8-8220-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/3d059170-949c-11e8-8220-00163e97122a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2012-01-23T11:56:33</review:date>
        <review:description>Just download this Game, the free Add-Ons and enjoy gorgeous Graphics, fast paced Dogfights and the full Conversions like &quot;Babylon 5&quot; and &quot;Wing Commander&quot;. Worth the Money big time.</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</review:downvotes>
