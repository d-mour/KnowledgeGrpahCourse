    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/9508628e-22b7-11eb-8665-fa163e99870e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/9508628e-22b7-11eb-8665-fa163e99870e">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-09T20:15:43</review:date>
        <review:description>This game took me by surprise - haven&apos;t heard of it before. After trying the demo, I decided to buy it (on a different platform) and didn&apos;t regret it. The story is good and has you guessing till the end (but makes sense from the beginning), voice acting is top notch, setting is also original. There are some issues with text not matching the voiceover (but the context is always preserved), some puzzles aren&apos;t perfect, but it&apos;s all minor issues compared to the very solid foundation of great writing, story and voice acting.
Very recommended!</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</review:downvotes>
        <review:id>9508628e-22b7-11eb-8665-fa163e99870e</review:id>
        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</review:rating>
        <review:title>Quite short, but very, very good</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</review:upvotes>
    </owl:NamedIndividual>
    


