    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/e5cae9d6-9483-11e8-8dc0-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/e5cae9d6-9483-11e8-8dc0-00163e97122a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-10-12T12:00:54</review:date>
        <review:description>The first free space was amazing, this one took all the things of the first one and made it better and it was the last best space-combat-sim to ever be released. If I had to pick one old game to get a sequel it would be this one. Here is to volition taking up this series again.</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</review:downvotes>
        <review:id>e5cae9d6-9483-11e8-8dc0-00163e97122a</review:id>
        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</review:rating>
        <review:title>Bring back the space combat</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/e61f7928-93fd-11e8-bcc1-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/e61f7928-93fd-11e8-bcc1-00163e97122a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-06-05T16:52:20</review:date>
        <review:description>We all know this is the best space sim ever made.  What you might not know is that Volition open sourced Freespace 2 before closing their doors for good, spawning the Freespace Sourcecode Project.  If you can extract the GOG installer on a Windows PC (or in WINE), you can use the FSP installer to install on OS X or Linux (or Windows) and give the FS2 updated graphics!   Yea!</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</review:downvotes>
        <review:id>e61f7928-93fd-11e8-bcc1-00163e97122a</review:id>
        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</review:rating>
        <review:title>Runs on OS X and Linux!</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</review:upvotes>
    </owl:NamedIndividual>
    


