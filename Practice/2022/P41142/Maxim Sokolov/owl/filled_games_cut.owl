    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d9b51d40-946c-11e8-baea-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d9b51d40-946c-11e8-baea-00163e97122a">
