    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/f7165fce-93fa-11e8-b00b-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/f7165fce-93fa-11e8-b00b-00163e97122a">
