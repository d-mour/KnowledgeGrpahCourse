    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/8b918b48-2c4d-11e9-b752-00163e4e60cc -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/8b918b48-2c4d-11e9-b752-00163e4e60cc">
