    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/ffed6306-ce4c-11eb-a82f-fa163ed508dc -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/ffed6306-ce4c-11eb-a82f-fa163ed508dc">
