    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/a260356c-3fca-11eb-8e6a-fa163e99870e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/a260356c-3fca-11eb-8e6a-fa163e99870e">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-12-16T20:15:10</review:date>
        <review:description>Only just came to know that the game requires Galaxy to run co-op even over a local network. Anyone that cares about DRM or the health of the industry should shun this like the plague.</review:description>
