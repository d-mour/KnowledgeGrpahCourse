    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/c0934c42-2e77-11e9-a2cc-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/c0934c42-2e77-11e9-a2cc-00163e97122a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
