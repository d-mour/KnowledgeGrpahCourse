    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/4aadd700-9a3d-11e8-ad7f-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/4aadd700-9a3d-11e8-ad7f-00163e97122a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-04-24T19:54:02</review:date>
        <review:description>- To this day no one really knows what “MDK” actually stands for...
Oh really? I knew it since I first played the game on PS1.
M = Max (the dog)
D = Dr. Fluke Hawkins
K = Kurt (the protagonist)
How hard can it be? 
By the way, the game is amazing, spent loads of hours in it!</review:description>
