    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/5bc1ad66-9400-11e8-9d39-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/5bc1ad66-9400-11e8-9d39-00163e97122a">
