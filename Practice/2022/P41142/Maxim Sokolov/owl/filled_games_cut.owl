    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/3b0f10c6-1106-11e9-933b-00163e4e60cc -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/3b0f10c6-1106-11e9-933b-00163e4e60cc">
