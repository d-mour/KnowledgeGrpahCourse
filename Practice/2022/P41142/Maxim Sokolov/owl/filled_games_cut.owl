    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/cfef51b6-cf41-11e9-b136-aa89d8c282e1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/cfef51b6-cf41-11e9-b136-aa89d8c282e1">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-04T18:28:38</review:date>
        <review:description>I&apos;m a huge fan of OutRun and love it when an OutClone passes along. Slipstream is very simplified in it&apos;s mechanics but enjoyable enough to pass as a fun game. Mainly love that it has a 4-player splitscreen feature allowing you to take up to three friends on a tour of Slipstream&apos;s roads. I also found the custom music option interesting which gave me the idea of converting VGM files into MP3 for that Sega Genesis feeling.

My biggest and only complaint is that, as a CRT monitor user, there are no 4:3 resolutions available and I&apos;m stuck with a letterbox regardless if I use fullscreen or not. Sadly, this has been the only game that I&apos;ve come across on GOG that only offers 16:9.</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</review:downvotes>
        <review:id>cfef51b6-cf41-11e9-b136-aa89d8c282e1</review:id>
        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</review:rating>
        <review:title>Great Game!</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d000998c-8284-11ec-a71d-fa163e9aa6fa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d000998c-8284-11ec-a71d-fa163e9aa6fa">
