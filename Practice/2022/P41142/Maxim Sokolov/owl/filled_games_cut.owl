    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/9de411fc-7d4a-11ec-aa3a-fa163e99870e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/9de411fc-7d4a-11ec-aa3a-fa163e99870e">
