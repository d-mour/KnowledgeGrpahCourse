    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/34c67dd4-c3f5-11e8-a6c1-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/34c67dd4-c3f5-11e8-a6c1-00163e97122a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-09-16T17:12:38</review:date>
        <review:description>It&apos;s a funny platforming game with interesting ideas, like basing everything in rhythm, which makes it funny to play. However, it&apos;s extremely short, and it tries to be longer artificially, by having a &quot;no death mode&quot;, which personally is not the best way to make a game longer and it can be frustrating.
Despite this, it&apos;s a game i had fun with and will come back again</review:description>
