    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/c728db1e-b1de-11e8-89c4-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/c728db1e-b1de-11e8-89c4-00163e97122a">
