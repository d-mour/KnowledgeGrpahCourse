    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/adaf2bfe-8bc8-11eb-a514-fa163e1219be -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/adaf2bfe-8bc8-11eb-a514-fa163e1219be">
