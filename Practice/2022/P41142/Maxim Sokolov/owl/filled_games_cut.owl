    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/842e68d0-1550-11e9-bd71-00163e4e60cc -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/842e68d0-1550-11e9-bd71-00163e4e60cc">
