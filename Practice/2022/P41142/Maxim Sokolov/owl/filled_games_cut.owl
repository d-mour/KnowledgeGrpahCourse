    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/caa92e66-8007-11eb-bb93-fa163e99870e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/caa92e66-8007-11eb-bb93-fa163e99870e">
