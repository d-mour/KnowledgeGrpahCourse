    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/c0211a34-c1a5-11e9-839e-e62905560e1c -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/c0211a34-c1a5-11e9-839e-e62905560e1c">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-08-18T10:48:44</review:date>
        <review:description>This is what &quot;games are art&quot; movement should stand for. I&apos;m that kind of person who never really finished Dark Souls because it was too hard but Pathologic 2 got me obsessed despite its brutal difficulty. I&apos;ve beaten this game two times already. It made me reflect on so many things and question existance itself. The writing is tight, the art es amazing and the lore is incredibly deep. Please buy this game. It needs to continue. We can&apos;t let this gem die.</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</review:downvotes>
        <review:id>c0211a34-c1a5-11e9-839e-e62905560e1c</review:id>
        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</review:rating>
        <review:title>True art</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">69</review:upvotes>
    </owl:NamedIndividual>
    


