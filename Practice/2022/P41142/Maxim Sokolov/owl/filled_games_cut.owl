    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/908e2a1e-aa9c-11eb-a5ae-fa163e99870e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/908e2a1e-aa9c-11eb-a5ae-fa163e99870e">
