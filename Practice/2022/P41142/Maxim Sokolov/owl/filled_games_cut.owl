        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</review:rating>
        <review:title>Good ol&apos; isometric RPG vibes</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/1c679296-efbf-11e8-a91f-00163e4e60cc -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/1c679296-efbf-11e8-a91f-00163e4e60cc">
