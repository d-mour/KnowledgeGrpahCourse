    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/4e7caebc-ea29-11eb-a040-fa163e99870e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/4e7caebc-ea29-11eb-a040-fa163e99870e">
