    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/73c446b0-aaac-11eb-a1fd-fa163e99870e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/73c446b0-aaac-11eb-a1fd-fa163e99870e">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-01T21:38:41</review:date>
        <review:description>Have your wife call her boyfriend, cuz you&apos;re gonna need some time to play this. This game will allow you to fulfill your deepest fantasies of siding with globalist corporations and bankers to destroy free western nations.

If you&apos;re a low t type of guy this will be right up your alley. Crappy pixel art? Check. Terrible controls? Check. Cringe music? Check. Go get a pack of soy milk, your estrogen shot, and strap your face diaper on cuz your in for a treat.</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">70</review:downvotes>
