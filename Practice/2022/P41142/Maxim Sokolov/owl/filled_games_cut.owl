    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/9b3bb888-d0b7-11ea-a5a8-fa163e62c76a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/9b3bb888-d0b7-11ea-a5a8-fa163e62c76a">
