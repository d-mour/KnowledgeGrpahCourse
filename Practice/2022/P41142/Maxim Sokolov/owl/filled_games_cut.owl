    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/8e669f2e-dbd0-11e9-9b63-9e2ad9b0bcf4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/8e669f2e-dbd0-11e9-9b63-9e2ad9b0bcf4">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
