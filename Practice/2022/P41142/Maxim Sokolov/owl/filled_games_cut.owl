    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/5a26a1f0-b1f6-11e8-9df8-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/5a26a1f0-b1f6-11e8-9df8-00163e97122a">
