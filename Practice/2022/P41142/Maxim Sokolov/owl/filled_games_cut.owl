    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/f9792a5e-169d-11ea-9f2c-00163e4e60cc -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/f9792a5e-169d-11ea-9f2c-00163e4e60cc">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-04T15:57:13</review:date>
        <review:description>Ein meist unterhaltsames Abenteuer mit manchen Längen und Logiklöchern, das aber trotzdem durch die ordentliche Sprachausgabe und die Animationen einen Platz im Adventure-Mittelfeld ergattert.

+ gute Steuerung (mit Hotspotanzeige)
+ schöne Grafiken und Animationen
+ größtenteils gute deutsche Sprecher

- Minispiele manchmal frustrierend (können übersprungen werden)
- teilweise fehlendes Sound-Ambiente (z.B. fehlender Stadtlärm)
- gelegentliche Abstürze (oft speichern, keine Autosaves)</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</review:downvotes>
        <review:id>f9792a5e-169d-11ea-9f2c-00163e4e60cc</review:id>
        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</review:rating>
        <review:title>Gute Unterhaltung mit Aussetzern...</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/f987675c-730f-11eb-8695-fa163e99870e -->

