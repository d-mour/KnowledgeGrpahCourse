        <review:title>Work of Love</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/6a1c333e-b298-11e8-8b87-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/6a1c333e-b298-11e8-8b87-00163e97122a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-12-31T20:07:58</review:date>
        <review:description>Take the same awful combat as when boarding ships, turn it into a DLC that&apos;s just as awful, and charge €5 for it. Even better, forget what&apos;s already inherently broken in the core game, who cares, here&apos;s some shiny extras with the same terrible combat mechanics.</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</review:downvotes>
