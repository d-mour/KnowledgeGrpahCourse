    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/c385132c-b299-11e8-8890-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/c385132c-b299-11e8-8890-00163e97122a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-01-06T00:25:58</review:date>
        <review:description>Die Grafik ist sehr gut. Die ersten zwei Stunden machen Spaß. Dann wird es einfach nur langweilig.</review:description>
