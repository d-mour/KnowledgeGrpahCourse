    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/f5d96c26-946f-11e8-bb06-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/f5d96c26-946f-11e8-bb06-00163e97122a">
