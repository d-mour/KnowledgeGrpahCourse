    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/2378d8e2-6029-11eb-a160-fa163e9aa6fa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/2378d8e2-6029-11eb-a160-fa163e9aa6fa">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T00:52:17</review:date>
        <review:description>Had no toubles updating, worked out automatically. Found it annoying how there are in-game &apos;teases&apos; for DLC content, but I guess it makes sense cause the DLC is essential in making the game feel more complete, when you love it so much and have spent so much time on it</review:description>
