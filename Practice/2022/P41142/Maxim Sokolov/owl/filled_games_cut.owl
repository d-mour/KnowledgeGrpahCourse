    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/b5a0f080-373c-11eb-bb67-fa163e4cd76b -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/b5a0f080-373c-11eb-bb67-fa163e4cd76b">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-12-05T22:59:04</review:date>
        <review:description>If you are on the fence about playing this game allow me to help you. BUY IT!!! Freespace 2 is one of the greatest space combat games of all time. It is one of my favorite games of all time. The universe and the story alone are great. The huge space battles with swarms of fighters and bombers laying siege to massive capital ships are amazing. The game gives you the freedom to choose your craft and customize its loadout. The franchise is an epic space opera that you need to experience. Now get off the fence and join the rest of us in Freespace. STOP READING AND PLAY IT ALREADY!!!</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</review:downvotes>
        <review:id>b5a0f080-373c-11eb-bb67-fa163e4cd76b</review:id>
        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</review:rating>
        <review:title>You should own this game. NOW!!!</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/b5e6dbe0-f9c5-11ea-8b58-fa163e62c76a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/b5e6dbe0-f9c5-11ea-8b58-fa163e62c76a">
