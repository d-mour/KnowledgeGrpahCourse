    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/b1387788-f146-11eb-a8e2-fa163e9aa6fa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/b1387788-f146-11eb-a8e2-fa163e9aa6fa">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-07-30T17:59:08</review:date>
        <review:description>This game feels like the Dev&apos;s just threw shit together in hopes to lure in the sheeple that they obviously did. Not that great. the animations are amateur as all hell, and some of the recycled assets and content is laughable to say the least. It is enjoyable for a couple hours though. thats it.</review:description>
