    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/680b9e72-6cdc-11ea-ba6a-fa163e62c76a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/680b9e72-6cdc-11ea-ba6a-fa163e62c76a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-23T10:00:48</review:date>
        <review:description>This game is simply epic! I own it on other platform, and I cannot bow enough before the guy responsible of developing this gem. Yes, the micromanagement included in the game can be tiring, but the game is so beautiful, complex and deep!! The possibilities and replayability value are almost endless. And the community around the game is as awesome as the game itself, so every player should definitely use some of the many existing mods, ranging from adding new content to awesome QOL improvements!
</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</review:downvotes>
