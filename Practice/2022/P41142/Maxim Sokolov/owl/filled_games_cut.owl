    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/68c70918-93f9-11e8-b929-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/68c70918-93f9-11e8-b929-00163e97122a">
