    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/7ba069f0-d872-11ec-834f-fa163e9aa6fa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/7ba069f0-d872-11ec-834f-fa163e9aa6fa">
