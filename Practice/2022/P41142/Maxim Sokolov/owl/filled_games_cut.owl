    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d463d2a8-b27d-11e8-8835-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d463d2a8-b27d-11e8-8835-00163e97122a">
