    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/bdf4de3e-943e-11e8-a4a3-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/bdf4de3e-943e-11e8-a4a3-00163e97122a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
