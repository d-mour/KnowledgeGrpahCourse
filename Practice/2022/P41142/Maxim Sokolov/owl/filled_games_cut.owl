    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/9f987334-93fc-11e8-a6ce-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/9f987334-93fc-11e8-a6ce-00163e97122a">
