    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/2531f86a-93ff-11e8-848d-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/2531f86a-93ff-11e8-848d-00163e97122a">
