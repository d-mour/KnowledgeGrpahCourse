        <review:title>Absolute rubbish</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">48</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/9739b3d4-5dd5-11ea-8e45-fa163e93294d -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/9739b3d4-5dd5-11ea-8e45-fa163e93294d">
