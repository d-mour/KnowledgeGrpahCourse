    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/cac6ef72-b1bb-11e8-9c6f-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/cac6ef72-b1bb-11e8-9c6f-00163e97122a">
