    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/2bd411da-93ff-11e8-8cd6-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/2bd411da-93ff-11e8-8cd6-00163e97122a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-10-26T06:50:25</review:date>
        <review:description>Fast action, nice tactics moments, amazing art direction, terrific music, wow moments!, perfect gameplay, innovation, hilarious and misterious plot...

It has everything on it.

MDK it´s a diamond even today, and it´s a must have for everyone. It has incredible graphics and gameplay, even for today standars.</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</review:downvotes>
