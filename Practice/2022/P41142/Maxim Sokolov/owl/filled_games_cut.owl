    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/3a056274-2443-11ea-bae0-00163e4e60cc -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/3a056274-2443-11ea-bae0-00163e4e60cc">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-22T00:42:54</review:date>
        <review:description>This is a piece of art. Deep, difficult and dark. The graphics are very good I think ... but the design is just outstanding. Music fits very good and the story is complex and very interesting. I tried other games like this in the past but they were all ugly und clunky. This is a true gem and for me the best game in 2019. </review:description>
