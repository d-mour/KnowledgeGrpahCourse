    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/ad595bcc-c32e-11ec-8dfa-fa163e99870e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/ad595bcc-c32e-11ec-8dfa-fa163e99870e">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-04-23T20:56:18</review:date>
        <review:description>The game is difficult, but I had fun with that. The storytelling is a bit weak.

Thanks for support linux :)</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</review:downvotes>
        <review:id>ad595bcc-c32e-11ec-8dfa-fa163e99870e</review:id>
