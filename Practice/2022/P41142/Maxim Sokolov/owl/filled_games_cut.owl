    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/ad1781e0-43df-11eb-9d77-fa163e9aa6fa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/ad1781e0-43df-11eb-9d77-fa163e9aa6fa">
