    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/bd8eb940-b4f8-11ec-9fea-fa163e9aa6fa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/bd8eb940-b4f8-11ec-9fea-fa163e9aa6fa">
