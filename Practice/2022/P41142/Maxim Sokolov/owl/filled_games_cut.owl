        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</review:rating>
        <review:title>Bitte mehr davon!!</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/1abe9580-3265-11eb-b27d-fa163e99870e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/1abe9580-3265-11eb-b27d-fa163e99870e">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-29T19:05:38</review:date>
        <review:description>I know this is a Demo, but the game has nothing much to offer yet.
You are limited to build your ski tracks, and lifts.

Voluntairs are needed to keep everything running, and here lies the problem for me;
you unlock new voluntairs every X people that are visiting you resort.

After a while this feels unbalanced. Once you get 500 people, there&apos;s much more demand for repairs etc. But you are just limited by that factor of X.

For now; this is not the game I hoped for; Let&apos;s see what the final game has to offer...</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</review:downvotes>
        <review:id>1abe9580-3265-11eb-b27d-fa163e99870e</review:id>
        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</review:rating>
        <review:title>Very limited Demo</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/1ad220b6-9468-11e8-84ed-00163e97122a -->

