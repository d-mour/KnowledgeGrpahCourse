        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</review:rating>
        <review:title>I rebought this game so many times</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/95eef036-b1c2-11e8-bc26-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/95eef036-b1c2-11e8-bc26-00163e97122a">
