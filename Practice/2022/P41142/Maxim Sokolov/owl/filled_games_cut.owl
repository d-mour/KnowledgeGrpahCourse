    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/c31c7e10-9f5b-11ea-a1f6-fa163e93294d -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/c31c7e10-9f5b-11ea-a1f6-fa163e93294d">
