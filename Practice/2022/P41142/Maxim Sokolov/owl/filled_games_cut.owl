    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/b563d88a-f746-11e9-b3c4-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/b563d88a-f746-11e9-b3c4-00163e97122a">
