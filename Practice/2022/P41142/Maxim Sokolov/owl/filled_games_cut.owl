        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/12d5889e-0eb6-11e9-bccf-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/12d5889e-0eb6-11e9-bccf-00163e97122a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-01-02T19:44:37</review:date>
        <review:description>The game could&apos;ve been fun, perhaps, but Crimea and Donetsk as provinces of Russia? Not a good idea. Although not really surprising, considering that the game has a Russian publisher. </review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</review:downvotes>
