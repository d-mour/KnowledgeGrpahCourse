    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/0c0ba994-94ef-11e8-be24-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/0c0ba994-94ef-11e8-be24-00163e97122a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-04-19T12:58:13</review:date>
        <review:description>I just bought this when i was on sale for 3 dollars along with stonekeep. Played it all night 10 hours none-stop. Got to the part with the goblin kahn. Failed at lockpicking his chest.... and ran out of the zone... when i got back into the zone he was gone and he just vanished. AWFUL! Sooo many bugs... I don&apos;t know what to do! sometimes when you pick locks it won&apos;t register your lockpicking bonuses which is terrible... Game could have been great if it didn&apos;t have so many bugs.</review:description>
