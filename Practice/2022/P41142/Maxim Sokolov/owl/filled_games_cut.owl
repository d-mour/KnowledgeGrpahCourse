    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/0b9398b0-94e8-11e9-b363-fa18e6945d7c -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/0b9398b0-94e8-11e9-b363-fa18e6945d7c">
