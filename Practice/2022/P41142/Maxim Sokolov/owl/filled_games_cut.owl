    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/30d3e354-94b3-11e8-a407-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/30d3e354-94b3-11e8-a407-00163e97122a">
