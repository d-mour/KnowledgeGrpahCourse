    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/ac757ea8-22f9-11e9-a02f-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/ac757ea8-22f9-11e9-a02f-00163e97122a">
