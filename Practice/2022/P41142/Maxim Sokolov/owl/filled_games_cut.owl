    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/a51cd926-c91b-11e9-a3a7-c6223cb2d957 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/a51cd926-c91b-11e9-a3a7-c6223cb2d957">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
