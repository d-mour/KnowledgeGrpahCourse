    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/cedca67a-8606-11eb-a93c-fa163e99870e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/cedca67a-8606-11eb-a93c-fa163e99870e">
