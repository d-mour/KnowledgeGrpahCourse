    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/3a6f5c5e-b1e1-11e8-9820-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/3a6f5c5e-b1e1-11e8-9820-00163e97122a">
