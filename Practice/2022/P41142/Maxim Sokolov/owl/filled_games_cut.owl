    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/9363b896-9ea2-11ea-a365-fa163e93294d -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/9363b896-9ea2-11ea-a365-fa163e93294d">
