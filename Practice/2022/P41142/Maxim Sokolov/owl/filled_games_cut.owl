    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/bab34e22-478d-11eb-b698-fa163e99870e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/bab34e22-478d-11eb-b698-fa163e99870e">
