    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/521963ac-5d63-11ea-bd95-fa163e62c76a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/521963ac-5d63-11ea-bd95-fa163e62c76a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-03T17:26:14</review:date>
        <review:description>A revelation. I have been playing Rimworld for years, one of the best experiences I have ever found in a game. Do not look at the price, do not look at the graphics. The only issue with this game is the hundred of hours you will put in it without even noticing.</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</review:downvotes>
