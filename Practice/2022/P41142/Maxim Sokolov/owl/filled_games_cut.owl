    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/cf0a2f66-9244-11ea-83c1-fa163e93294d -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/cf0a2f66-9244-11ea-83c1-fa163e93294d">
