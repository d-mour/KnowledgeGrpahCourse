    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/ac635a06-037d-11ea-9f5b-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/ac635a06-037d-11ea-9f5b-00163e97122a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-10T07:48:08</review:date>
        <review:description>I like it. It&apos;s the story of strong people in a tough situation. A story of responsibility, the will to cleanse your doubts, the power to go on despite the exhaustion and mistakes, the wrongness and incomprehensibility. It&apos;s hard, but meaningful.

And I am happy to be here.

♦ Good for you.</review:description>
