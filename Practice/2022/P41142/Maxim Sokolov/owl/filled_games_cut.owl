    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/414d1cf8-9456-11e8-9ef1-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/414d1cf8-9456-11e8-9ef1-00163e97122a">
