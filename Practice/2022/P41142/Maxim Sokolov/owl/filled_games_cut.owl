    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/a3a5bf50-0dab-11ec-b394-fa163e9aa6fa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/a3a5bf50-0dab-11ec-b394-fa163e9aa6fa">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-04T21:12:17</review:date>
        <review:description>This game runs fairly well, but it is a very early version of this game and literally NO ONE has any kind to play through that can be used when you are stuck!  Everything that is available is for later versions, or the on-line version and doesn&apos;t apply to this game. 
I&apos;m stuck in the first city investigating the deaths, and I have NO idea what I should do next.  This game is not very good at clues or aiming you in the appropriate directions to continue the plot.
Sad because until this point, I was enjoying the game as it is. </review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">44</review:downvotes>
        <review:id>a3a5bf50-0dab-11ec-b394-fa163e9aa6fa</review:id>
        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</review:rating>
        <review:title>Just Old enough !</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/a3b55a08-946b-11e8-a1b0-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/a3b55a08-946b-11e8-a1b0-00163e97122a">
