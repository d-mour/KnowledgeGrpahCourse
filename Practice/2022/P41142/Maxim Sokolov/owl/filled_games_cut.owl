        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/5ec6897e-22a4-11ec-b149-fa163e9aa6fa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/5ec6897e-22a4-11ec-b149-fa163e9aa6fa">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-10-01T13:43:10</review:date>
        <review:description>i played this back in the days i was searching for it long ago now finally it&apos;s here😍</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</review:downvotes>
