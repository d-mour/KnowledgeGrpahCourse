    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/80b24de2-7f95-11ea-bc28-fa163e93294d -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/80b24de2-7f95-11ea-bc28-fa163e93294d">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-16T06:51:07</review:date>
        <review:description>I was lucky enough to play this when I was much younger and it was only years later that I realised the reason I fondly remembered the voice acting so much in this game was because it is by the fantastic talents of Robert Loggia, Ronny Cox and Kurtwood Smith to name a few. The games mechanics borrow heavily from the wonderful X-wing/TIE Fighter games and when combined with a long, engrossing and excellently narrated campaign it results in a truly epic space shooter that deserved so much more attention than it received. 10/10.</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</review:downvotes>
        <review:id>80b24de2-7f95-11ea-bc28-fa163e93294d</review:id>
        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</review:rating>
