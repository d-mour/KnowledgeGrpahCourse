    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/15bdefbe-93fb-11e8-bfd2-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/15bdefbe-93fb-11e8-bfd2-00163e97122a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-12-23T14:29:38</review:date>
        <review:description>This game truly is one of the best games of all time. Under appreciated for sure. This is in my top 5, possibly top 3, it is likely the pinnacle of the now dead (comatose?) space-sim genre, and the story is epic enough to match the fantastic game play. This will provide tons of entertainment for the price, as so many of the games here do- but this is just a step above. Very well worth it.</review:description>
