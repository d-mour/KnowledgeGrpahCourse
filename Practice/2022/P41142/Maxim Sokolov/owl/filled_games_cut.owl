    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/1f130b42-acf5-11eb-b107-fa163e3a9b6e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/1f130b42-acf5-11eb-b107-fa163e3a9b6e">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
