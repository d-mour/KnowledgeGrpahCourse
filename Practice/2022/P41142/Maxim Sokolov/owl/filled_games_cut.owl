    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/5943f0e8-bf25-11e9-903c-aa8c4583af0c -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/5943f0e8-bf25-11e9-903c-aa8c4583af0c">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-08-15T06:24:34</review:date>
        <review:description>For the first look you may find this game an old space shooter with blurry textures and old school gameplay.
But if you give it time the game shines: energy systems management, countermeasures, sensors use, advanced weapon use are key features in Freespace 2. The campaign is a long one, the missions are vibrants, varied in goals and the atmosphere is fantastic.
</review:description>
