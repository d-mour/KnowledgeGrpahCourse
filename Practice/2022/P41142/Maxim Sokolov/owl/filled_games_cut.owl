    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/1621644c-4d25-11ea-b2aa-fa163e62c76a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/1621644c-4d25-11ea-b2aa-fa163e62c76a">
