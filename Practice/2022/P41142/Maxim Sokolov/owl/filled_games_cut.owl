    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/5c2bf264-94d9-11e8-915b-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/5c2bf264-94d9-11e8-915b-00163e97122a">
