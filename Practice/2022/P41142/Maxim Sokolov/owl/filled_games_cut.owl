        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/59479c40-459a-11ec-851a-fa163e9aa6fa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/59479c40-459a-11ec-851a-fa163e9aa6fa">
