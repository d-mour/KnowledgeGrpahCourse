    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/82cffdbe-55c6-11ec-b2e6-fa163e99870e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/82cffdbe-55c6-11ec-b2e6-fa163e99870e">
