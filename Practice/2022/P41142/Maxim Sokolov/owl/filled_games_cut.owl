    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d5bc9f5c-6561-11ea-b68a-fa163e93294d -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d5bc9f5c-6561-11ea-b68a-fa163e93294d">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-13T21:35:46</review:date>
        <review:description>Relaxing and calming, yet depressing and desolate walking simulator. </review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</review:downvotes>
        <review:id>d5bc9f5c-6561-11ea-b68a-fa163e93294d</review:id>
        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</review:rating>
        <review:title>next level of walking sim </review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</review:upvotes>
