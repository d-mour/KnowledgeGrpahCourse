        <product:release_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-28T12:45:00</product:release_date>
        <product:slug>pathfinder_kingmaker_varnholds_lot</product:slug>
        <product:title>Pathfinder: Kingmaker - Varnhold&apos;s Lot</product:title>
    </owl:NamedIndividual>
    


