    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/386e230c-1a0b-11ea-b731-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/386e230c-1a0b-11ea-b731-00163e97122a">
