        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</review:rating>
        <review:title>One of my all-time favorites</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</review:upvotes>
