    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/2ed98222-5d2b-11ec-bf1f-fa163e99870e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/2ed98222-5d2b-11ec-bf1f-fa163e99870e">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
