    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/4e951ef0-2939-11ea-9c43-00163e4e60cc -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/4e951ef0-2939-11ea-9c43-00163e4e60cc">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-28T08:14:29</review:date>
        <review:description>This game is excellent, but has little-to-no replayability.  So, even though it&apos;s a single-player game, don&apos;t waste your most enjoyable play-through playing alone.  I recommend playing through it on a TV with your nerdiest friends and family.
I played through it with my in-laws over the Christmas holiday, and it was the preferred activity for any time the kids were asleep.  I&apos;m sorry it&apos;s over.</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</review:downvotes>
        <review:id>4e951ef0-2939-11ea-9c43-00163e4e60cc</review:id>
        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</review:rating>
        <review:title>Excellent adventure to share with nerds</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/4e9a0fe0-0175-11eb-abf2-fa163edf6d96 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/4e9a0fe0-0175-11eb-abf2-fa163edf6d96">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-28T13:28:10</review:date>
        <review:description>For a game that only requires you to be idle for 400 days it sure did captivate me spending a lot of time with it. Exploring the kingdom underneath at Shade&apos;s pace was a jolly experience.</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</review:downvotes>
        <review:id>4e9a0fe0-0175-11eb-abf2-fa163edf6d96</review:id>
        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</review:rating>
