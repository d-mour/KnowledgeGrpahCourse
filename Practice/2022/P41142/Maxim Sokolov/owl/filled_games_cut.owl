    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/9d2e25be-2f61-11eb-bd71-fa163e9aa6fa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/9d2e25be-2f61-11eb-bd71-fa163e9aa6fa">
