    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/4d2d708a-889c-11eb-aefa-fa163e9aa6fa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/4d2d708a-889c-11eb-aefa-fa163e9aa6fa">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-19T12:17:25</review:date>
        <review:description>This was one of my very first RPGs. It has a fantastic calming atmosphere which always reminds me of the &quot;good old&quot; days when you went home from school after a troublesome day and just dived into this magnificant world.</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</review:downvotes>
