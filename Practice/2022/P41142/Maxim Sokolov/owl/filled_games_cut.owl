    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/62eda082-31c3-11eb-98d5-fa163e9aa6fa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/62eda082-31c3-11eb-98d5-fa163e9aa6fa">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
