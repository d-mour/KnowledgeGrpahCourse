    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d5baf5a2-b262-11e8-9b4a-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d5baf5a2-b262-11e8-9b4a-00163e97122a">
