    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/39cda002-cfa7-11ec-9cd0-fa163e99870e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/39cda002-cfa7-11ec-9cd0-fa163e99870e">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-05-09T17:49:27</review:date>
        <review:description>i loved the game. great storyline, well rounded characters, a lot of suspense, you wish it lasted longer. 
the only objection is that it crashes quite often, so save as soon as you can. 
the graphics could be better, but they are not bad either. i would love to see a remake with the more advanced graphics. or even a sequel. 
a thoroughly enjoyable experience. i highly recommend it to all who love this type of games, especially when you can get it on discount. </review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</review:downvotes>
