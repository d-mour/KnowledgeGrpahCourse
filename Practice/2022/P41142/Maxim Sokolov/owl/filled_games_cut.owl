    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/5b5c5fb2-93f9-11e8-9872-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/5b5c5fb2-93f9-11e8-9872-00163e97122a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-10-03T09:39:53</review:date>
        <review:description>You know the feeling you get when you cna&apos;t help but play the same game over and over?  This is such an example for me.  Turns out after all this time, I still have an urge to play this yet again, but until recently, compacability issues kinda hindered me, but now that I have found this will full support for XP and Vista and the extra content I get (I&apos;m especially happy about the soundtrack :D), I&apos;m now very content.  Keep up the good work, GOG! *thumbs up*</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</review:downvotes>
