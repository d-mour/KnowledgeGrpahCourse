    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/919ca858-5deb-11ea-9f8a-fa163e93294d -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/919ca858-5deb-11ea-9f8a-fa163e93294d">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-04T09:41:32</review:date>
        <review:description>I&apos;ve been playing RW for a few years, since v0.16 or 0.17. Absolutely love it. Make sure you check out the mods.</review:description>
