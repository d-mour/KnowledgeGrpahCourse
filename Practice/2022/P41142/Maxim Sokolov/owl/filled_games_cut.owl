    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/202728ba-c71c-11eb-b841-fa163e9aa6fa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/202728ba-c71c-11eb-b841-fa163e9aa6fa">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-06-07T02:08:37</review:date>
        <review:description>The game&apos;s ally AI is confusing and dumb. The health system is too unforgiving and certain regular hits from enemies cost you the half your health. The bosses are confusing. It&apos;s too short and still has bad game design. You can barely keep yourself alive but it still wants you to keep others alive as well. Plus, the  story is uninteresting and readable at best.</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</review:downvotes>
        <review:id>202728ba-c71c-11eb-b841-fa163e9aa6fa</review:id>
        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</review:rating>
        <review:title>Overall bad</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/206e5ea6-94a2-11e8-8b6b-00163e97122a -->

