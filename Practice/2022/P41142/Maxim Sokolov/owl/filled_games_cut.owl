    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/a422fbb0-176c-11e9-9dce-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/a422fbb0-176c-11e9-9dce-00163e97122a">
