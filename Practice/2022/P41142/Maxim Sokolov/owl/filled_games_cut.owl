    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/fab938a8-016d-11eb-af70-fa163edf6d96 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/fab938a8-016d-11eb-af70-fa163edf6d96">
