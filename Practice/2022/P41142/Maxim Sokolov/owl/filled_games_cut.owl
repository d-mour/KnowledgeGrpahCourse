    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/73390706-9459-11e8-aef8-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/73390706-9459-11e8-aef8-00163e97122a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-02-19T20:45:18</review:date>
        <review:description>I loved this game... from the music to the &quot;trash talking&quot; simulation. 

walking up to random people, acting all calm, then all of a sudden snapping at them and pulling out your gun is just CLASSIC... 

This game is too fun to pass up. ;)</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</review:downvotes>
        <review:id>73390706-9459-11e8-aef8-00163e97122a</review:id>
        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</review:rating>
