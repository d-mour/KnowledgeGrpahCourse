    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/51b27b26-93fa-11e8-87b2-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/51b27b26-93fa-11e8-87b2-00163e97122a">
