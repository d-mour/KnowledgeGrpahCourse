        <product:is_pre_order rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</product:is_pre_order>
        <product:lead_desc>
Whateverland is coming soon on GOG.com. You can wishlist it </product:lead_desc>
        <product:release_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-28T17:50:00</product:release_date>
        <product:slug>whateverland_prologue</product:slug>
        <product:title>Whateverland: Prologue</product:title>
    </owl:NamedIndividual>
    


