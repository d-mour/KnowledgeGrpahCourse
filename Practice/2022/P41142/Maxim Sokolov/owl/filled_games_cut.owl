    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/b70384f0-d64e-11ea-956f-fa163e93294d -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/b70384f0-d64e-11ea-956f-fa163e93294d">
