    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/95c58810-41c8-11ec-9637-fa163e9aa6fa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/95c58810-41c8-11ec-9637-fa163e9aa6fa">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-11-10T03:50:30</review:date>
        <review:description>I use to have this game on Playstation and played it multiple times, then a friend from highschool sold me his copy of MDK for PC which I still have but cant run on any modern PC then later bought it on Steam but then it was glitchy and unplayable on modern PC so finally i bought it on GOG and it works perfectly fine. No tricks of making it run on a fake video card from 3DFX just instals and it plays. Thanks GOG for living my childhood games and Theres still Giants Citizen of Kabuto which I have a physical copy but I am going to rebuy it on GOG so it can be working perfectly like this game.</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</review:downvotes>
