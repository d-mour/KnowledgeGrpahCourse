        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</review:rating>
        <review:title>This game is awesome</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/926dc400-98a1-11eb-be00-fa163e9aa6fa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/926dc400-98a1-11eb-be00-fa163e9aa6fa">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
