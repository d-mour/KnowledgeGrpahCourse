    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/100ed300-7ecc-11e9-8c73-00163e4e60cc -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/100ed300-7ecc-11e9-8c73-00163e4e60cc">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-25T12:04:11</review:date>
        <review:description>Uwielbiam takie niespodzianki! Nic nie słyszałem o tej grze i kupiłem ją na jakiejś przecenie . A tu krył się mały diamencik. Ze świetnymi postaciami, fabułą, niezatrudnymi zagadkami i doskonałą muzyką. Diament ten wprawdzie nie jest oszlifowany (pewne problemy ze stabilnością gry, nie rozwiązany wątek ojca głównej bohaterki...), ale nie zmienia to faktu, że gra jest kapitalna. Jak to możliwe, że jest ona tak mało znana w środowisku przygodomaniaków?</review:description>
