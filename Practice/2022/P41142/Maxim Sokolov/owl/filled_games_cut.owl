    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d2c0008e-1e9d-11e9-a1ed-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d2c0008e-1e9d-11e9-a1ed-00163e97122a">
