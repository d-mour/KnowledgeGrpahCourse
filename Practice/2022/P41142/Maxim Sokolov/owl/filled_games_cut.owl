    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/11b51d1c-d328-11e9-b133-3a389ce68cce -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/11b51d1c-d328-11e9-b133-3a389ce68cce">
