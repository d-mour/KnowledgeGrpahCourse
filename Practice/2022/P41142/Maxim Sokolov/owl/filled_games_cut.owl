    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/5a26e308-edca-11e8-b77a-fa163ecdd5fb -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/5a26e308-edca-11e8-b77a-fa163ecdd5fb">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
