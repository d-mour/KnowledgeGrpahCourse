    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/3ba1b4ac-d5e5-11eb-bc88-fa163e048183 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/3ba1b4ac-d5e5-11eb-bc88-fa163e048183">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-06-25T21:43:28</review:date>
        <review:description>They have the audacity to ask money for this DLC when the game came completely broken on release and with a lot of missing features that previous games in the franchise had. Talk about being out of touch with the community ...</review:description>
