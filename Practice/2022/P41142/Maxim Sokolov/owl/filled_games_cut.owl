    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/a8a424e0-953c-11e9-88f0-caad2746f022 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/a8a424e0-953c-11e9-88f0-caad2746f022">
