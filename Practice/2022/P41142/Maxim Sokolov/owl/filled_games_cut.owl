        <review:title>Short Review</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/bf81e092-c659-11e8-8137-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/bf81e092-c659-11e8-8137-00163e97122a">
