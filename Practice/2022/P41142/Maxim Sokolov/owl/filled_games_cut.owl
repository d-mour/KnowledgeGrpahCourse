    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/game/1098187752">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Game"/>
        <product:has_genre rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/genre/action"/>
        <product:has_genre rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/genre/adventure"/>
        <product:has_genre rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/genre/survival"/>
        <product:has_lang_support rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/language/en"/>
