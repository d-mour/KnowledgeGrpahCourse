    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/c57c8240-9477-11e8-9299-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/c57c8240-9477-11e8-9299-00163e97122a">
