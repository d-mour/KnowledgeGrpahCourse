    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/dlc/1074122773">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#DLC"/>
        <product:has_genre rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/genre/roguelike"/>
