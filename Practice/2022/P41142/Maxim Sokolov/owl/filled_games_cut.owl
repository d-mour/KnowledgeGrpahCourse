    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/b84643be-95a2-11e8-8a29-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/b84643be-95a2-11e8-8a29-00163e97122a">
