    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/92cca71e-93fd-11e8-a283-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/92cca71e-93fd-11e8-a283-00163e97122a">
