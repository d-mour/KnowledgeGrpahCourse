    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/c0fb40ea-34e2-11eb-ab0a-fa163e57a8b6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/c0fb40ea-34e2-11eb-ab0a-fa163e57a8b6">
