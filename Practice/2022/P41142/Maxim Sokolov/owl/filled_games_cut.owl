    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/513fc6fa-4bc9-11ec-acfc-fa163e9aa6fa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/513fc6fa-4bc9-11ec-acfc-fa163e9aa6fa">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-11-22T21:20:56</review:date>
        <review:description>Ein Piraten Diablo 2 mit nicht all zu viel Tiefang.
Lässt sich (für mich) wunderbar mit Maus und Tastatur spielen.. weiss nicht was Ihr alle habt.
Schöner neuer Inhalt mit den Seemonstern...gerne mehr davon.

Habs im Sale für 15eu geholt und dafür ist es gut.

&quot;Soll Sie uns verdammen, sterben werden wir nie....&quot;</review:description>
