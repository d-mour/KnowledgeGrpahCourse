    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/25798662-c672-11e8-aadf-00163e4e60cc -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/25798662-c672-11e8-aadf-00163e4e60cc">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
