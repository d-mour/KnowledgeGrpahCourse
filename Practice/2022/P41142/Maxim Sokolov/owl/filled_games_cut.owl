    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/df13f50a-995b-11e9-a28f-1e4175a0f718 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/df13f50a-995b-11e9-a28f-1e4175a0f718">
