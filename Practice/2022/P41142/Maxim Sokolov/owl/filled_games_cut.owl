    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d054bf48-0297-11ec-a6fa-fa163e99870e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d054bf48-0297-11ec-a6fa-fa163e99870e">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-21T18:52:40</review:date>
        <review:description>Restricting purchases to people who own the game is either some seriously bizarre licensing or just really bad store management. I was unable to complete the purchase and GOG wasn&apos;t telling me why. Impressively dumb.</review:description>
