    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/925b15fa-aa0b-11eb-aa47-fa163e99870e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/925b15fa-aa0b-11eb-aa47-fa163e99870e">
