    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/1c61b3de-d3ba-11ec-98ad-fa163e99870e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/1c61b3de-d3ba-11ec-98ad-fa163e99870e">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-05-14T22:14:43</review:date>
        <review:description>Played for 2 hours and enjoyed it way more than was my expectations. If devs polish some game mechanics, expand the soundtrack a bit so the one song won&apos;t play on repeat, maybe add dubbing over time...then it will turn out to be very nice loveletter to old schoold cRPGs like Fallout 1 and 2.

I have high hopes for this game&apos;s full release. If it lives to my current expectations I&apos;ll be more than glad to change the rating to 5*</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</review:downvotes>
