    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/f03f07a0-1b59-11e9-a156-00163e4e60cc -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/f03f07a0-1b59-11e9-a156-00163e4e60cc">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-01-18T21:47:50</review:date>
        <review:description>Very nice, calming sandbox game where there&apos;s always something new to do or explore. The pacing feels just about right (even if waiting for those metal bars to smelt can be sometimes a bit tedious). Portia is great for weekday evenings when you just want to unwind after work with something that isn&apos;t too fast-paced nor super demanding, but not brainless either. Can definitely recommend.</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</review:downvotes>
