    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/c9b4c14e-f742-11ea-a029-fa163e62c76a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/c9b4c14e-f742-11ea-a029-fa163e62c76a">
