    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/ff52fe38-161d-11ec-88bd-fa163e99870e -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/ff52fe38-161d-11ec-88bd-fa163e99870e">
