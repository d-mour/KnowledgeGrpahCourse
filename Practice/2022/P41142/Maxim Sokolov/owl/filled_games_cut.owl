        <review:title>Check the community wishlist before tank</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d2228cf6-b29a-11e8-9319-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d2228cf6-b29a-11e8-9319-00163e97122a">
