        <product:has_genre rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/genre/adventure"/>
        <product:has_genre rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/genre/platformer"/>
        <product:has_lang_support rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/language/en"/>
        <product:has_review rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/b00a1d82-4e28-11ec-bc63-fa163e9aa6fa"/>
        <product:has_review rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/e490b68e-6560-11ec-a5c5-fa163e9aa6fa"/>
        <product:has_review rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/7e4a710c-734e-11ec-8237-fa163e9aa6fa"/>
        <product:has_tag rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/tag/demo"/>
        <product:has_tag rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/tag/female-protagonist"/>
        <product:has_tag rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/tag/platformer"/>
        <product:has_tag rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/tag/third-person"/>
