        <review:title>Gameplay is fun, humor is bad</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/a8c57806-953e-11e8-b6a5-00163e97122a -->

