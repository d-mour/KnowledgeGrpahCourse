    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/c6a8fda4-24d3-11ea-9a05-00163e4e60cc -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/c6a8fda4-24d3-11ea-9a05-00163e4e60cc">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-22T17:57:37</review:date>
        <review:description>Still a plethora of bugs and glitches.  Developers have stated that they don&apos;t consider GoG important enough to update. DLC &amp;amp; Updates on GoG are significantly delayed, and some are just missing.

Decent game for early access, its a pity they don&apos;t seem to communicate very well.</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</review:downvotes>
