    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d9917aba-e596-11eb-93ac-fa163e9aa6fa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/d9917aba-e596-11eb-93ac-fa163e9aa6fa">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-07-15T21:02:42</review:date>
        <review:description>Очень простая метройдвания с интерсной механикой
открытия новых путей с помощью умения превращаться в разных животных.

Про геймплей многого не скажешь, а вот визуал радует глаза. 
Персонажи при разговорах очень приятно и добротно нарисованы.
Анимационные вставки перед битвами с боссами приятно удивили.

Неплохой и легкий юмор (особенно порадовал кальмарный босс).</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</review:downvotes>
        <review:id>d9917aba-e596-11eb-93ac-fa163e9aa6fa</review:id>
        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</review:rating>
        <review:title>Простенькая метройдвания</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</review:upvotes>
    </owl:NamedIndividual>
    


