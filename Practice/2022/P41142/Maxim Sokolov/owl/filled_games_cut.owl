    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/47a439ca-4f97-11eb-919b-fa163e9aa6fa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/47a439ca-4f97-11eb-919b-fa163e9aa6fa">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
