        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</review:upvotes>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/e943f62a-93fc-11e8-aa54-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/e943f62a-93fc-11e8-aa54-00163e97122a">
