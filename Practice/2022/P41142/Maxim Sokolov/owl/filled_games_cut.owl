    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/0efeaffe-2282-11e9-890e-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/0efeaffe-2282-11e9-890e-00163e97122a">
