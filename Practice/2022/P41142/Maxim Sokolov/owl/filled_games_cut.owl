    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/e5293930-9463-11e8-8356-00163e97122a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/e5293930-9463-11e8-8356-00163e97122a">
        <rdf:type rdf:resource="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl#Review"/>
        <review:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-09-16T06:38:27</review:date>
        <review:description>This game follows right on from the original Freespace and takes you back into that wonderful universe.  The graphics are improved and the storyline is just fantastic!

Play it through and enjoy every second of it.  But wait, that&apos;s not all, the engine became open source and the community have done wonderful things with it.  Mods, improved performance and effects as well as integrating seamlessly into the original game.  So go and buy this game, go to fsoinstaller dot com and get the installer which will set up all the necessary files for you to play the game with the latest updates.  Well worth it - believe me!</review:description>
        <review:downvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</review:downvotes>
        <review:id>e5293930-9463-11e8-8356-00163e97122a</review:id>
        <review:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</review:rating>
        <review:title>Amazing and still gets better!</review:title>
        <review:upvotes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</review:upvotes>
    </owl:NamedIndividual>
    


