    <!-- http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/adc3ea80-6c58-11e9-a88e-00163e4e60cc -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/naymoll/ontologies/2022/3/games.owl/review/adc3ea80-6c58-11e9-a88e-00163e4e60cc">
