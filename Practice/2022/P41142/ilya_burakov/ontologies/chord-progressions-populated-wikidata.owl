        owl:ObjectProperty ;
    rdfs:domain chp:ChordProgressionEntry ;
    rdfs:range chp:ChordProgressionEntry ;
    rdfs:subPropertyOf owl:topObjectProperty .

chp:hasProgressionPosition a owl:DatatypeProperty,
