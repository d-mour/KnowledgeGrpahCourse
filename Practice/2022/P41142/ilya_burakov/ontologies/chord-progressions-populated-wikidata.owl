    rdfs:domain chp:Composition ;
    rdfs:range chp:Key .

chp:hasName a owl:DatatypeProperty ;
    rdfs:domain chp:Artist,
        chp:Composition ;
    rdfs:range xsd:string .

chp:hasNextEntry a owl:AsymmetricProperty,
        owl:FunctionalProperty,
