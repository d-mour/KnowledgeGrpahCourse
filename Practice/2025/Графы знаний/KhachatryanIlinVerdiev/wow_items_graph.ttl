@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix wow: <http://example.org/wowkg#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wow: a owl:Ontology ;
    rdfs:label "WoW Knowledge Graph Ontology"@en,
        "Онтология графа знаний WoW"@ru ;
    rdfs:comment "Начальная онтология для графа знаний World of Warcraft: предметы, источники добычи, активности, классы/спеки и их связи."@ru .

wow:Consumable a owl:Class ;
    rdfs:label "Consumable"@en,
        "Расходник"@ru ;
    rdfs:subClassOf wow:WoWEntity .

wow:Crafting a owl:Class ;
    rdfs:label "Crafting"@en,
        "Крафт (Профессия)"@ru ;
    rdfs:subClassOf wow:Source .

wow:Difficulty_Heroic a wow:Difficulty ;
    rdfs:label "Heroic"@en .

wow:Difficulty_LFR a wow:Difficulty ;
    rdfs:label "Raid Finder (LFR)"@en .

wow:Difficulty_M0 a wow:Difficulty ;
    rdfs:label "Mythic 0 (M0)"@en .

wow:Difficulty_Mythic a wow:Difficulty ;
    rdfs:label "Mythic"@en .

wow:Difficulty_Normal a wow:Difficulty ;
    rdfs:label "Normal"@en .

