  <rdf:Description rdf:about="http://example.org/lovecraft#Closure">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Closure</rdfs:label>
    <ex:hasAnnotation>" echo of a distant screamwitch fire" is a short mythos story by glynn owen barrass . It is a direct follow-on to c. j. henderson's short story " cruelty ." The story is set in the iconic town of arkham . The entity is in fact the outer god nyarlathotep .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Glynn_Owen_Barrass"/>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
