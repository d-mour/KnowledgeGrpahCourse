    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Rise of Azathoth</rdfs:label>
    <ex:hasAnnotation>Lara Turner Evil Hat Productions Publication Date 2021 Roleplaying game Fate is a timeline supplement for the Fate of Cthulhu supernatural horror roleplaying game. Designed by Lara Turner , it was published in a digital format by Evil Hat Productions in 2021 . Overview References</ex:hasAnnotation>
    <ex:wasPublishedOnW>2021</ex:wasPublishedOnW>
  </rdf:Description>
