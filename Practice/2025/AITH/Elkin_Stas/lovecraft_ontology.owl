  <rdf:Description rdf:about="http://example.org/lovecraft#Jack_Walters">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Jack Walters</rdfs:label>
    <ex:hasAnnotation>Human First appearance EXP : Call of Cthulhu: Dark Corners of the Earth Created by Christopher Gray is a fictional character and the main protagonist of the 2005 video game Call of Cthulhu: Dark Corners of the Earth . Biography A former police detective, after an encounter with the cult the Fellowship of Yith at a manor house in Boston in 1915, which turns him insane, he is committed into Arkham Asylum for six years. After being released, Walters becomes a private investigator and in 1922 undertakes the missing person case of Brian Burnham in Innsmouth . Trivia In Call of Cthulhu: Dark Corners of the Earth , Walters was voiced by Milton Lawrence. Gallery</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Call_of_Cthulhu:_Dark_Corners_of_the_Earth"/>
    <ex:wasCreatedByC>Christopher Gray</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Mystery_of_the_Grave-Yard">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Mystery of the Grave-Yard</rdfs:label>
    <ex:hasAnnotation>"the mystery of the grave yard" is a 1959 short story by american lovecraft . Written when he was only eight years old, it forms part of his juvinilia . Concerns the kidnapping of a man by a group of ne'er-do-wells . Titular mystery in the grave-yard refers to a family tomb with a hidden room .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Crime</ex:hasGenreW>
    <ex:hasGenreW>Mystery</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Shuttered_Room"/>
    <ex:isPublishedAsW>Other Pieces</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1959</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>1898</ex:wasWrittenOnW>
  </rdf:Description>
