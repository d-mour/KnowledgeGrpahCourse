  <rdf:Description rdf:about="http://example.org/lovecraft#The_Recurring_Doom">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Recurring Doom</rdfs:label>
    <ex:hasAnnotation>Jefferson coler is a prestigious but controversial british archaeologist with a strong interest in arcane books and ancient languages . In 1940, after returning from an expedition to arabia, he shows his colleague collins a strange object he had found . The object is a green rectangular crystal, similar to a box, with no openings, and made of an unknown material . The next week, coler contacts collins to show him that the interior of the crystal is now glowing, as if a small</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#S._T._Joshi"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Lovecraftian Ramblings #15</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1980</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Merritt">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>A Merritt</rdfs:label>
    <ex:diedOnR>1943</ex:diedOnR>
    <ex:hasAnnotation>Writer of fantasy and horror tales for the pulps. His work was much admired by Lovecraft in spite of its concessions to pulp formulae. His late novel, Dwellers in the Mirage (1932), may have been influenced by Lovecraft.</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1884</ex:wasBornOnR>
  </rdf:Description>
