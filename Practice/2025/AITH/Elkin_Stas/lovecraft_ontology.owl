  <rdf:Description rdf:about="http://example.org/lovecraft#Il_richiamo_di_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Il richiamo di Cthulhu</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Boris Vallejo Italy Italian I Miti di Cthulhu (Italian- ) Genre(s) Weird fiction Fanucci Editore Release Date 1987 211 (translation: The Call of Cthulhu ) is an Italian- Cthulhu Mythos anthology which consists primarily of translations of previously-published English- works. Overview Containing five short stories and running to a total of 211 , was published in 1987 by Fanucci Editore as part of their I Miti di Cthulhu . Contents "Due parole su Cthulhu" introduction by Gianni Pilo "Orrore al Luna-Park" by Brian Lumley (translation of " The Fairground Horror ") "La cosa che fischiava nel buio" by Robert E. Howard (translation of "Pigeons from Hell") "Oscurità è il mio nome" by Eddy C. Bertin (translation of "Duisternis is mijn naam"- "Darkness, My Name Is") "Dove cammina Yidhra" by Walter C. DeBill, Jr. (translation of " Where Yidhra Walks ") "Il pozzo" by Agostino Ponzo</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>Italy</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:hasPageCountW>211</ex:hasPageCountW>
    <ex:isInLanguageW>Italian</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#I_Miti_di_Cthulhu_%28Italian-language_series%29"/>
    <ex:wasReleasedOnW>1987</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#John_J._Weir">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
