    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Work"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sean_Rodgers">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Sean Rodgers</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Lovecraftian fiction Years Active 1997-1998 is an author active during the late 1990s, who has written a number of Lovecraftian short stories. These have appeared primarily in fanzines, including Cthulhu Cultus , Al-Azif , Dark Legacy , and Nightscapes . Selected Bibliography Short Fiction "Archaeological Findings" (1997) "The Gospel According to Cthulhu" (1997) "The Statue" (1997) "The Last Survivor" (1997) " The Dig " (1997) "The Tunnels" (1997) "The Missive of Thaddeus" (1998) External Links at the Internet Speculative Fiction Database</ex:hasAnnotation>
    <ex:hasYearsActiveR>1997-1998</ex:hasYearsActiveR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#hasAlternativeNamesO">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>hasAlternativeNamesO</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
