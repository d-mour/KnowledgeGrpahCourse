    <ex:hasGenreW>mystery</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>1994</ex:isPublishedAsW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Through_Dark_Angles:_Works_Inspired_by_H._P._Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Through Dark Angles: Works Inspired by H. P. Lovecraft</rdfs:label>
    <ex:hasAnnotation>Through Angles Darkly: Works Inspired by H. P. Lovecraft Don Webb United States English Hippocampus Press Release Date August 2014 252 Through Angles Darkly: Works Inspired by H. P. Lovecraft is a collection of Lovecraftian fiction by American and occultist Don Webb . It was published by Hippocampus Press in August 2014; both paperback and digital editions were released. Overview Contents "The Mythos and I" "The Man Who Scared Lovecraft" "The Megalith Plague" "Lavinia's Lament" "The Gold of the Vulgar" "The Doom That Came to Devil's Reef" "Wilbur's Song" " from a Diary" "Sanctuary" "Wilbur Whatley's Twin" "Platinum Hearts" "Plush Cthulhu" "Emily's Rose Window" "A Ship Afar" "Looking Glass" " To Mars and Providence " "After Alhazred" "Lovecraft's Pillow" "The Codex" "Doc Corman's Haunted Palace One Fourth of July" "Slowness" "Rats" "A Game of Nine Pins" "Powers of Air and Darkness" "Casting Call"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Don_Webb"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>252</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>August 2014</ex:wasReleasedOnW>
  </rdf:Description>
