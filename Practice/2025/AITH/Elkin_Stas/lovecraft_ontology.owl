  <rdf:Description rdf:about="http://example.org/lovecraft#The_Call_of_Rlyeh">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Call of R'lyeh</rdfs:label>
    <ex:hasAnnotation>Full story online here Ron Shiflet United States English Publication date October 1997 " " is a Cthulhu Mythos poem by American Ron Shiflet . Synopsis The unnamed institutionalised narrator dreams of the day when he can escape his prison and join Great Cthulhu beneath the waves in sunken R'lyeh . Publication History "" was published in the E. P. Berglund -edited zine Nightscapes in October 1997.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>October 1997</ex:wasPublishedOnW>
  </rdf:Description>
