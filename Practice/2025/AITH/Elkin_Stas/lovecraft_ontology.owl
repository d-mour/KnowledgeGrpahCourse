  <rdf:Description rdf:about="http://example.org/lovecraft#The_Upside_Down_%28Stranger_Things%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Dimensions"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsOriginatingFromMythosInspiredWorks"/>
    <rdfs:label>The Upside Down (Stranger Things)</rdfs:label>
    <ex:hasAnnotation>The upside down is a dark and eldritch parallel dimension featured in the netflix series stranger things . It is a twisted, decaying mirror image of the real world, specifically the town of hawkins, indiana . It is filled with grotesque creatures and an ever-growing, malevolent force known as the mind flayer .</ex:hasAnnotation>
    <ex:hasOriginL>Unknown</ex:hasOriginL>
    <ex:hasTypeL>Alternate dimension Sentient Interdimensional Organism Hive mind</ex:hasTypeL>
    <ex:isInhabitedByL>Demogorgons Vines Demobats The Mind Flayer Vecna</ex:isInhabitedByL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Haiyoru%21_Nyaruani">
    <rdf:type rdf:resource="http://example.org/lovecraft#MediaAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Haiyoru! Nyaruani</rdfs:label>
    <ex:hasAnnotation>The first anime adaptation of the light novel series haiyore! Nyaruko-san . It was followed by a second season titled : remember my mr. lovecraft . The series was directed by azuma tani and produced by dle .</ex:hasAnnotation>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#Haiyore%21_Nyaruko-san"/>
    <ex:isInLanguageW>Japanese</ex:isInLanguageW>
    <ex:wasReleasedOnW>2010 2009 – March 15 October 23</ex:wasReleasedOnW>
  </rdf:Description>
