  <rdf:Description rdf:about="http://example.org/lovecraft#Idea_of_Evil">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Idea of Evil</rdfs:label>
    <ex:hasAnnotation>The is an eldritch being from the fictional universe of the berserk franchise . It came into existence because of humanity's need for transcendental reasons for what happens in their lives . Its core is a many-eyed flesh-like heart that lays at the centre of the abyss, a realm at the deepest level of the astral world .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Will_of_Claude_Ashur">
