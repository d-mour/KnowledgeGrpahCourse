    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cabal (chapbook)</rdfs:label>
    <ex:hasAnnotation>Cabal Armand Rosamilia United States English Keyport Cthulhu Genre(s) Weird fiction Rymfire Books Release Date December 2012 46 Cabal is a Cthulhu Mythos chapbook by American Armand Rosamilia . Overview First published in December 2012 by Rymfire Books, Cabal contains two stories and runs to a total of 46 . It was released solely on Amazon's digital Kindle platform. Contents " Cabal " " Rats in the Cellars "</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Armand_Rosamilia"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
