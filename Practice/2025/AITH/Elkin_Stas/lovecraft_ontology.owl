    <ex:wasReleasedOnW>February 2022</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Wanda_Maximoff">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Wanda Maximoff</rdfs:label>
    <ex:hasAnnotation>Scarlet witch is a fictional character created by marvel comics . Introduced as a minor villain in the x-men series, she soon became a popular hero, joining the avengers . She has been a member of the avengers superhero team for decades, and for a long time believed that she was the daughter of magneto .</ex:hasAnnotation>
    <ex:hasAppearanceC>Nights of Wundagore Chaos Cascade Mystic Arcana</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC>X-Men #4</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Jack Kirby</ex:wasCreatedByC>
    <ex:wasCreatedByC>Stan Lee</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Music_of_Erich_Zann_%281980_film%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleFilmAndTelevisionAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Music of Erich Zann (1980 film)</rdfs:label>
    <ex:hasAnnotation>The Music of Erich Zann (1980 film) Based on " The Music of Erich Zann " John Strysik Howard Phillips Lovecraft (original story) John Strysik (screenplay) Release date October 1980 Running time 17 minutes United States English " The Music of Erich Zann " is a low-budget 17-minute short film adaptation of the H. P. Lovecraft short story of the same name, written and directed by John Strysik and released in October 1980. It remains faithful to the original plot line, although the narrator is inexplicably named Charles Dexter Ward . Gallery</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasWriterW>http://example.org/lovecraft#Howard_Phillips_Lovecraft John Strysik</ex:hasWriterW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Music_of_Erich_Zann"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>October 1980</ex:wasReleasedOnW>
  </rdf:Description>
