    <rdfs:label>Cancerverse</rdfs:label>
    <ex:hasAccessibilityL>various</ex:hasAccessibilityL>
    <ex:hasAnnotation>Earth-10011 is a fictional universe in the . Appeared in the 's the thanos imperative mini-series in 2010 . It is one of the realities conquered by the many-angled ones .</ex:hasAnnotation>
    <ex:hasNotableFeatureL>Endless life</ex:hasNotableFeatureL>
    <ex:hasNotableFeatureL>Tentacled living worlds</ex:hasNotableFeatureL>
