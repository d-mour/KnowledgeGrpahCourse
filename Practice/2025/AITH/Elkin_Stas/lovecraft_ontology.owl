    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Horace L. Lawson</rdfs:label>
    <ex:diedOnR>unknown</ex:diedOnR>
    <ex:hasAnnotation>, amateur journalist and editor of the Wolverine, which published several of Lovecraft’s stories and also some installments of the pseudonymous column “The Vivisector” (as by “Zoilus”).</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>unknown</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Death_May_Die">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Death May Die</rdfs:label>
    <ex:hasAnnotation>A starship captain who makes his living by robbing old burial ships accidentally awakens an ancient, deathless entity . The being takes over the man's ship before transporting him into the cosmos to be offered up as a servant to the outer god azathoth .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Nathan_Wunner"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Shall Be</ex:isPublishedAsW>
    <ex:isPublishedAsW>Whispers from the Abyss Vol. 2: The Horrors That Are</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Saves_the_World">
