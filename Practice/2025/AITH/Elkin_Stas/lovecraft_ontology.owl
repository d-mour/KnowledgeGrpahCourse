    <ex:hasWebsiteR>https://www.aaattanasio.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>20 September 1951</ex:wasBornOnR>
  </rdf:Description>
