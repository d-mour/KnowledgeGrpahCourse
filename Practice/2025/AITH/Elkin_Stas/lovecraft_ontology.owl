    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Census Issue 4</rdfs:label>
    <ex:hasAnnotation>Census was created by marc bernardin, adam freeman, and sebastian piriz . The book was published in january 2023 by dazzling urbanite through amazon as part of their digital comic book originals line .</ex:hasAnnotation>
    <ex:hasAuthorW>Adam Freeman</ex:hasAuthorW>
    <ex:hasAuthorW>Marc Bernardin</ex:hasAuthorW>
