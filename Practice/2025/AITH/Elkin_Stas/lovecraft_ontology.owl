    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Ascellan Conspiracy</rdfs:label>
    <ex:hasAnnotation>Pascal Godbout Daniele Gay Thalia Godbout Yuri Zhuravljov English Fate of Cthulhu Genre(s) Roleplaying game Evil Hat Productions Release Date 2023 Flub is a timeline supplement for the Fate of Cthulhu horror roleplaying game. Written by Pascal Godbout and featuring artwork by Daniele Gay, Thalia Godbout, and Yuri Zhuravljov, it was published by Evil Hat Productions in a solely digital format in 2023 . Overview References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Pascal_Godbout"/>
