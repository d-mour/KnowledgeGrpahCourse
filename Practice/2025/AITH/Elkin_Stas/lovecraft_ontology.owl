    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Call of Cthulhu: The Coloring Book</rdfs:label>
    <ex:hasAnnotation>Andrey Fetisov United States English Call of Cthulhu Genre(s) Hobby book Chaosium Release Date February 2017 32 is a novelty hobby book supplement for the Call of Cthulhu roleplaying game. Featuring artwork by Andrey Fetisov, it was published by Chaosium in February 2017; both print and digital editions were released. Overview Gallery</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
