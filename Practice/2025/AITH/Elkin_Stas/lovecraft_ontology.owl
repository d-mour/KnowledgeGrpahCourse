    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Beyond the Wall of Sleep (collection)</rdfs:label>
    <ex:hasAnnotation>Beyond the wall of sleep is a collection of fantasy, horror and science fiction short stories, poems and essays by american h. p. lovecraft . It was released in 1943 and was the second collection of lovecraft's work published by arkham house . 1,217 copies were printed. The dust jacket art was a collage of photographs of sculptures by clark ashton smith .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Fantasy</ex:hasGenreW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>Science fiction short stories]</ex:hasGenreW>
    <ex:hasGenreW>essay</ex:hasGenreW>
    <ex:hasGenreW>poetry</ex:hasGenreW>
    <ex:hasPageCountW>458 pp xxix</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1943</ex:wasReleasedOnW>
