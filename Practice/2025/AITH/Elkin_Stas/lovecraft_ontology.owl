    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Low Red Moon</rdfs:label>
    <ex:hasAnnotation>Caitlin r. kiernan's preceded by threshold followed by daughter of hounds is a novel . It centers on characters that earlier appeared in kiernan's threshold . Part of the background of these novels is a secret subterranean world of ghouls .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
