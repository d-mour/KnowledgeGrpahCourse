    <ex:wasReleasedOnW>2022</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Thomas_Olney">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Thomas Olney</rdfs:label>
    <ex:hasAnnotation>Olney is a fictional character who appears in h. p. lovecraft's " the strange high house in the mist " he represents the observation that "humdrum lives breed wistful longings of the unknown" lovecraft describes him as a "philosopher" who "taught ponderous things in a college by narragansett bay"</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Strange_High_House_in_the_Mist"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ashley_Dioses">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Ashley Dioses</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Poet Author Birth Date 20 December 1990 California, USA United States Horror Dark Fantasy http://fiendlover.blogspot.com/ is a poet and author from California, USA, who has written several works set in the expanded Cthulhu Mythos established by H. P. Lovecraft and others. The majority of her works fall into the horror and dark fantasy genres. Selected Bibliography Poems " Asenath " (2019)</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA http://example.org/lovecraft#California</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>http://fiendlover.blogspot.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Poet</ex:isConnectedToMythosR>
    <ex:wasBornOnR>20 December 1990</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nyarlatophis,_A_Fable_of_Ancient_Egypt">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Nyarlatophis, A Fable of Ancient Egypt</rdfs:label>
    <ex:hasAnnotation>is a short story by Stanley C. Sargent , appearing in his anthology The Taint of Lovecraft (2002). Synopsis In the 13th Century BC a war of the gods rages between the Ennead (the pantheon of gods of Egypt) and the Great Old Ones . Nyarlathotep leads the conquest of Egypt on behalf of his terrifying masters.</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Treacherous_Memory">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Treacherous Memory</rdfs:label>
    <ex:hasAnnotation>Is a short story by american glynn owen barrass . Is published in the doug draa -edited anthology weirdbook annual 2 by wildside press in 2019 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Glynn_Owen_Barrass"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Weirdbook Annual 2</ex:isPublishedAsW>
    <ex:wasPublishedOnW>February 2019</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mike_Lee">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Mike Lee</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Birth Date 1962 Nashville, Tennessee, USA United States (born 1962) is an American author, games designer and video game scriptwriter. Although perhaps best known for the extensive Warhammer and Warhammer 40,000 stories he has written for tabletop miniatures manufacturer Games Workshop , he has also contributed gaming material for several of White Wolf's World of Darkness roleplaying games, including Vampire: The Masquerade , Vampire: The Dark Ages , and Hunter: The Reckoning . Lee has also written at least one short story set in the greater Cthulhu Mythos . Selected Works Short Fiction " Castle of Circles " (2017) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Tennessee Nashville</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1962</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shub-Niggurath">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OuterGods"/>
    <rdfs:label>Shub-Niggurath</rdfs:label>
    <ex:hasAffiliationC>EXP )</ex:hasAffiliationC>
    <ex:hasAffiliationC>Great Old Ones ( AWD</ex:hasAffiliationC>
    <ex:hasAffiliationC>Outer Gods ( EXP )</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>All-Mother</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Lord of the Woods</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Mother Goddess</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Quake</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Shupnikkurat</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Black Goat of the Woods</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Goat with a Thousand Young</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Mighty Mother</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The black goat of the woods with a thousand young is an outer god in the pantheon of the cthulhu mythos of h. p. lovecraft . She is a perverse fertility deity, said to appear in the form of a goat with a thousand young . The being is first mentioned in lovecraft's revision story " the last test " (1928)</ex:hasAnnotation>
    <ex:hasAppearanceC>The Dunwich Horror The Mound Medusa's Coil The Whisperer in Darkness The Dreams in the Witch-House The Man of Stone The Horror in the Museum Out of the Aeons The Thing on the Doorstep The Diary of Alonzo Typer The Moon-Lens The Shade of Pierre Girault Pathfinder</ex:hasAppearanceC>
    <ex:hasAppearanceC>The Inner Sea World Guide</ex:hasAppearanceC>
    <ex:hasCharacterMateC>Yog-Sothoth ( HPL ) Hastur the Unspeakable ( EXP )</ex:hasCharacterMateC>
    <ex:isLocatedAtC>Yaddith ( EXP )</ex:isLocatedAtC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Last_Test"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Carry_Me_Softly_Into_the_Land_of_Dreams">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Carry Me Softly Into the Land of Dreams</rdfs:label>
    <ex:hasAnnotation>Bruce Brown Renzo Podesta English Genre(s) Cthulhu Mythos Arcana Comics Release Date November 2010 " " is a short Cthulhu Mythos comic book story written by Bruce Brown and illustrated by Renzo Podesta. It was published in the Arcana Comics horror anthology Velvet Rope in November 2010. Synopsis A young Howard Phillips Lovecraft is present at the moment a malevolent entity comes to claim the soul of his insane father Winfield . Begging the entity to realise his father, the two strike a bargain: Howard must spend his life writing of the horrors which lurk just out of sight of humankind, or his father's immortal soul shall suffer eternal torment.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Bruce_Brown"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>November 2010</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Shuttered_Room">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Shuttered Room</rdfs:label>
    <ex:hasAnnotation>Short story by august derleth first appeared in and other pieces in 1959 . Tells of a young man who returns to the old town of dunwich, massachusetts . His grandfather, luther whateley, died and left him the family home . In a letter, luther urges him to destroy the mill and kill anything he finds in it, "no matter how small" while investigating the mill, he discovers tracks around the window .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Shuttered_Room"/>
    <ex:isPublishedAsW>HPL</ex:isPublishedAsW>
    <ex:isPublishedAsW>Other Pieces</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1959</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Clear_the_Air">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Clear the Air</rdfs:label>
    <ex:hasAnnotation>Cia killer lester parker has infiltrated a cell of eco-terrorists . Now ordered to terminate the group, he discovers its leader is an ancient chinese sorcerer . Parker is killed by chang at the story's conclusion . Published in the dark regions press anthology arkham detective agency .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_M._Sammons"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Arkham_Detective_Agency"/>
    <ex:wasPublishedOnW>November 2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Cry_of_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosFilmAndTelevision"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Cry of Cthulhu</rdfs:label>
    <ex:hasAnnotation>United states was a planned film which never made it past the pre-production phase . It was envisioned as being the first original lovecraftian film to directly incorporate elements of the cthulhu mythos .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasWriterW>http://example.org/lovecraft#Byron_Craft</ex:hasWriterW>
    <ex:wasReleasedOnW>Unfinished project</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ngirrthlu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Ngirrth'lu</rdfs:label>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#The_Stalker_in_the_Snows"/>
    <ex:hasAlternativeNamesC>He Who Hunts</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Na-girt-a-lu</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Wolf-Thing</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Wolf-Thing The Stalker in the Snows He Who Hunts Na-girt-a-lu First appearance " The Stalker in the Snows " is a ferocious and towering wolf-like humanoid with bat wings. He is served by Werewolf servants known as the Lupine Ones .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Stalker_in_the_Snows"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mythos_Tales_%26_Others">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Mythos Tales &amp; Others</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Stanley Sargent United States English Mythos Books Release Date 1996 94 is an anthology of Lovecraftian fiction, poetry and scholarly work. Published by Mythos Books in 1996, it was edited by David Wynn and features cover art by Stanley Sargent . Contents Editorial Ravings, introduction by David Wynn "An Eldritch City, Horrible with Antiquity" by David Barker "The Alley" by Jason Kuhl "Kiosk to Kadath" by Chad Hensley "The Call" by Chad Hensley "The Outsider" by Michael Siefener "In the Nethermost Cavern" by Chad Hensley "In the Small Hours" by Chad Hensley "The Face of Baphomet" by Jeffrey Thomas "From the 'Journals of John Kincaid'" by Don Webb "In a Dark Time" by Michael Siefener "The Ghastlycrumb Ickies" by Michael Tice "Dark Dreamer" by Chad Hensley "Dagon and the Occult" by Paul Rydeen "From 'The Yellow Text of Thanos Khan'" by Don Webb "Cuthubutt" by Michael Siefener "Candlewax" by W. H. Pugmire "The Orb from Outside" by Allen Mackey "That Which Is Waiting" by Gary Lovisi "Dark Dreams" by Gary Lovisi " The Advent of Uvhash " by James Ambuehl "Old "Man" Cthulhu" by Stanley C. Sargent "The Cthulhu Mythos: Lovecraft vs. Derleth" by S. T. Joshi "The Tentacle" by Daniel del Valle "Sleeping on Trains" by Daniel del Valle Reception was given an overall favourable review by James Ambuehl in the second issue of Edward P. Berglund 's online fanzine Nightscapes . Reflist</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
