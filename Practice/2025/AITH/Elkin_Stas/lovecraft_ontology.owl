    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Armitage Files</rdfs:label>
    <ex:hasAnnotation>Robin D. Laws Jérôme Huguenin Sarah Wroot English Trail of Cthulhu Genre(s) Roleplaying game Pelgrane Press Release Date 2010 149 is a scenario supplement for the Trail of Cthulhu horror roleplaying game. Written by Robin D. Laws , it featured artwork by Jérôme Huguenin and handouts by Sarah Wroot, and was published by Pelgrane Press in 2010 ; both print and digital editions were released. Overview Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robin_D._Laws"/>
