    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1963</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Transition_of_Elizabeth_Haskings">
    <rdf:type rdf:resource="http://example.org/lovecraft#CaitlinRKiernanWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Transition of Elizabeth Haskings</rdfs:label>
    <ex:hasAnnotation>Caitlin R. Kiernan English Sirenia Digest date January 2012 "" is a short story by Caitlin R. Kiernan that first appeared in the January 2012 issue of Sirenia Digest (#74). Synopsis The story describes the plight of a Deep One hybrid woman whose transition involves shapeshifting back and forth between human and batrachian forms. She survives these ordeals with the help of a gay male friend. History The story was reprinted in the anthologies Weirder Shadows Over Innsmouth ( Fedogan &amp; Bremer , 2013) and New Cthulhu 2: More Recent Weird (Prime Books, 2015). It later appeared in Kiernan's collection Houses Under the Sea: Mythos Tales ( Subterranean Press , 2019).</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Sirenia_Digest"/>
    <ex:wasPublishedOnW>January 2012</ex:wasPublishedOnW>
  </rdf:Description>
