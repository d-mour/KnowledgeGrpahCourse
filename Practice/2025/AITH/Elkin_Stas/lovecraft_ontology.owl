  <rdf:Description rdf:about="http://example.org/lovecraft#Baalblo">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Stars"/>
    <rdfs:label>Baalblo</rdfs:label>
    <ex:hasAccessibilityL>Star travel</ex:hasAccessibilityL>
    <ex:hasAnnotation>Dead star Star travel First appearance EXP : " The Inhabitant of the Lake " Created by Ramsey Campbell is a fictional celestial body created by British author Ramsey Campbell for his 1964 short story " The Inhabitant of the Lake ." Overview is a dead star which forms part of a binary system with Yifne , its green-hued twin. It is mentioned in passing in The Revelations of Glaaki , and is orbited by Tond , home of the intelligent humanoids known as yarkdao . It is likely that the Great Old One Glaaki passed by before making its way to Earth .</ex:hasAnnotation>
    <ex:hasTypeL>Dead star</ex:hasTypeL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Inhabitant_of_the_Lake"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#J._Scott_Vanlester">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>J. Scott Vanlester</rdfs:label>
    <ex:hasAnnotation>Vanlester is an american author and artist who has adapted several of h. p. lovecraft's works into a visual format . He has also illustrated guides to the people, places and entities created by lovecraft as part of his lovecraft comics series . He has also written at least one original illustrated story, the science fiction novel anna's song .</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Comic book creator</ex:isConnectedToMythosR>
    <ex:isKnownForR>Lovecraft Comics</ex:isKnownForR>
  </rdf:Description>
