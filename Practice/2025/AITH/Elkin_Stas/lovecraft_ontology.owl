  <rdf:Description rdf:about="http://example.org/lovecraft#Ech_Pi_El">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>E'ch Pi El</rdfs:label>
    <ex:hasAnnotation>John B. Ford &amp; Steve Lines English Rainfall Books Sporadic July 2006 Final Publication April 2018 , which boasted the tagline Chilling Tales of the Cthulhu Mythos , was a fanzine devoted to works of the Cthulhu Mythos . Overview Edited by John B. Ford and Steve Lines (although Ford edited it alone from issues 7 to 9), featured works from both established authors and newcomers, and ran for thirteen irregularly-released issues between July 2006 and April 2018. Gallery</ex:hasAnnotation>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Der_Cthulhu-Mythos:_1976_-_2002">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Der Cthulhu-Mythos: 1976 - 2002</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Philippe Jozelon Germany German Genre(s) Horror Release Date May 2003 296 is a German- horror fiction anthology. Overview Containing a collection of eleven works both translated from English and originally written in German, was edited by Frank Festa and was published in May 2003. Contents "Die Türme" by Edward P. Berglund (translation of " The Towers ", 1976) "Die Stimme des Strandes" by Ramsey Campbell (translation of " The Voice of the Beach " 1982) "Die Glocke im Turm" by Lin Carter and H. P. Lovecraft (translation of " The Bell in the Tower " 1989) "Der Runde Turm" by Robert M. Price (translation of " The Round Tower (Being the Narrative of Armitage Harper) " 1990) "Das Innsmouth-Syndrom" by Brian Stableford (translation of " The Innsmouth Heritage " 1992) "Bildwelten" by Michael Siefener "Blick aufs Meer" by Michael Marshall Smith (translation of " To See the Sea " 1994) "Der Schrecken von Toad Lake" by James Ambuehl (translation of " The Terror of Toad Lake " 1997) "Die Feuerbrand-Symphonie" by Brian Hodge (translation of " The Firebrand Symphony " 2001) "Die Krakelkult-Kampagne" by Malte S. Sembten "Ein Porträt Torquemadas" by Christian von Aster</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>Germany</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>296</ex:hasPageCountW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:wasReleasedOnW>May 2003</ex:wasReleasedOnW>
  </rdf:Description>
