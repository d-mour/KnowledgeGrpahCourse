    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Cthulhu Mythos</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#John_Lovecraft_Taylor">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>John Lovecraft Taylor</rdfs:label>
    <ex:diedOnR>28 January 1899</ex:diedOnR>
    <ex:hasAnnotation>Lovecraft’s paternal uncle through his wife, the sister and adopted daughter of Helen Allgood, Augusta Charlotte Allgood.</ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1836</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Last_Stand_at_Walthams_Cabin">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Last Stand at Waltham's Cabin</rdfs:label>
    <ex:hasAnnotation>Bill waltham, a retired widower, decides to move to a cabin in the backwoods . After only a few days, an unidentified beast kills and skins his dog . Expending the few shells for his shotgun, he decides to go out with a bang .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Madness</ex:isPublishedAsW>
    <ex:isPublishedAsW>They Thrive in Darkness: Mythos</ex:isPublishedAsW>
    <ex:wasPublishedOnW>June 2018</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Khurt_Khave">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Khurt Khave</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Editor Games Designer St. Louis, Missouri, United States United States Lovecraftian horror http://www.chainsawalice.com/ is an American author and the current head priest of the First United Church of Cthulhu . He has also produced a number of fictional works through the church, including short stories, roleplaying games, and Lovecraftian anthologies. Selected Works Author Astronomicon minorem (2015) Can Such Things Still Be?: Complete Literary Guide to the King in Yellow (2016) Editor Urban Temples of Cthulhu (2016) Kill Those Damn Cats (2016) Games and Gaming Supplements Shub-Niggurath: The Black Goat of the Woods with a Thousand Young (2016) Scooby Doom versus the Cult of Cthulhu (2016) Don’t Let Them Take You Alive (2017) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>United States Missouri St. Louis</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>http://www.chainsawalice.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Games Designer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dimension">
    <rdf:type rdf:resource="http://example.org/lovecraft#Dimensions"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromFolkloreMythAndReligion"/>
    <rdfs:label>Dimension</rdfs:label>
    <ex:hasAnnotation>The concept of different dimensions is present throughout the writings of h. p. lovecraft and the cosmic horror genre as a whole . Dimensions can also be interpreted as higher spatial dimensions, which as seen in " through the gates of the silver key ", go up until "archetypal infinity".</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Gog-Hoor">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Gog-Hoor</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Eater of the Insane</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Eater of the insane is a fictional entity created by weston ochse for his short story "a spectacle of a man" the character was later incorporated into the call of cthulhu role-playing game .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>A Spectacle of a Man</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Weston Ochse</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dreams_and_Fancies">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dreams and Fancies</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft United States English French Genre(s) Non-fiction Arkham House date 1962 " " is a short collection of letters written by the late American Howard Phillips Lovecraft to Rheinhart Kleiner , Maurice W. Moe, Alfred Galpin , Bernard Austin Dwyer, Donald Wandrei , Clark Ashton Smith , Duane W. Rimel , R. H. Barlow , William Lumley , Willis Conover, Jr., and Virgil Finlay . It was first included as an introductory piece in a 1962 Arkham House collection also titled . History (1962) Howard Phillips Lovecraft 3 (1992, 2016) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:isPublishedAsW>Dreams</ex:isPublishedAsW>
    <ex:isPublishedAsW>Fancies</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1962</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Handful_of_Dust">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Handful of Dust</rdfs:label>
    <ex:hasAnnotation>Preceded by devil's children : the witch cycle part 2 is a scenario supplement for the delta green setting of call of cthulhu roleplaying game . Written by australian and games designer david conyers, it was published by call of cthulhu licensee yog-sothoth.com in 2003 . Originally written as a tournament game for the melbourne, australia tournament conquest 1994 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#David_Conyers"/>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2003</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Call_Number_of_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Call Number of Cthulhu</rdfs:label>
    <ex:hasAnnotation>The book is the sixth in a series featuring libraries and librarians . It was independently published on amazon's digital kindle platform in may 2018 . The title is a reference to call numbers, a form of address in book cataloguing which allows the book to be more easily located .</ex:hasAnnotation>
    <ex:hasAuthorW>Tom Bruno</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>51</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>L is for Librarian</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>May 2018</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Worm_that_Walks">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Worm that Walks</rdfs:label>
    <ex:hasAnnotation>The is a fictional entity created by sandy petersen for chaosium 's call of cthulhu horror role-playing game . Made its first appearance in the 1982 campaign supplement shadows of yog-sothoth .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Shadows_of_Yog-Sothoth"/>
    <ex:madeFirstAppearanceOnC>Chapter 5: The Worm That Walks</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Sandy_Petersen"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Rendezvous_in_Averoigne">
    <rdf:type rdf:resource="http://example.org/lovecraft#AveroigneCycle"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ClarkAshtonSmithWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Rendezvous in Averoigne</rdfs:label>
    <ex:hasAnnotation>It is part of a cycle of stories set in a fictionalized province of medieval france . It was the title story of a collection of smith's fantastic fiction published in 1988 . It has been reprinted by weird tales in the january 1939 issue .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>April 1931</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#H._P._Lovecrafts_Arkham">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>H. P. Lovecraft's Arkham</rdfs:label>
    <ex:hasAnnotation>Keith Herber Louis Cortez Real Carol Triplett-Smith Gus DiZerega Andy Hopp Cover Artist Lee Gibbons United States English Call of Cthulhu Genre(s) Roleplaying game Chaosium Release Date 2003 248 is a gaming supplement for the Call of Cthulhu horror roleplaying game, focused on the fictional New England town of Arkham , Massachusetts . Written by Keith Herber , it features a cover by Lee Gibbons , interior art by Louis Cortez Real, Carol Triplett-Smith, Gus DiZerega, and Andy Hopp , and was published by Chaosium in 2003. The book is an update of The Compact Arkham Unveiled (1995), itself an update of Arkham Unveiled (1990) . Overview References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Keith_Herber"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>248</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2003</ex:wasReleasedOnW>
  </rdf:Description>
