  <rdf:Description rdf:about="http://example.org/lovecraft#Idealism_and_Materialism:_A_Reflection">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Idealism and Materialism: A Reflection</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft United States English (original) French Genre(s) Non-fiction SSR Publications Selected Essays Volume I Date of writing July 1919 date December 1952 " " is a short non-fiction piece by the late American Howard Phillips Lovecraft . Although it was written in July 1919, it did not see until December 1952, when it was included in the George T. Wetzel -edited collection Selected Essays Volume I . It has been reprinted a handful of times, and has also been translated into French . History Selected Essays Volume I (1952) The Shuttered Room and Other Pieces (1959) Howard Phillips Lovecraft 3 (1992, 2016) Miscellaneous Writings (1995) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Selected_Essays_Volume_I"/>
    <ex:wasPublishedOnW>December 1952</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>July 1919</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shadows_Over_Rlyeh">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Shadows Over R'lyeh</rdfs:label>
    <ex:hasAnnotation>Don D'Ammassa English Managansett Press Release Date June 2015 172 is a collection of ten Lovecraftian short stories by the American Don D'Ammassa . Published by Managansett Press in June 2016, both paperback and digital editions were released. Contents "Dark Paris" "Dark Providence" "The Dunwich Gate" "The Managansett Horror" "Night Duty" "Parting Shot" "Bad Soil" "The Thing in the Library" "The New Guy" "Shadow Over R'lyeh"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Don_DAmmassa"/>
    <ex:hasPageCountW>172</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>June 2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Colossus_In_The_Catacombs">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Colossus In The Catacombs</rdfs:label>
    <ex:hasAnnotation>History is a short story by authors mark mclaughlin and michael sheehan, jr. it functions as something of a follow-up to " the abominations of nephren-ka " insofar as it charts the next stage of the history of the shining trapezohedron .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mark_McLaughlin"/>
    <ex:hasAuthorW>Michael Sheehan. Jr.</ex:hasAuthorW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Abominations: 24 Tales of the Cthulhu Mythos</ex:isPublishedAsW>
    <ex:isPublishedAsW>Horrors</ex:isPublishedAsW>
    <ex:wasPublishedOnW>December 2018</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Chor-Tal">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Chor-Tal</rdfs:label>
    <ex:hasAlternativeNamesC>The God of Hellish Laughter</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Created by ron shiflet is a deity, possibly a great old one . Made its debut appearance in the 1997 short story "the last laugh" deity is imprisoned under a star-stone in exactly the same manner as the great old ones .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#When_in_Leng..."/>
    <ex:hasAppearanceC>The Isle of Chor-Tal</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC>The Last Laugh</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Those_Folk_Below">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Those Folk Below</rdfs:label>
    <ex:hasAnnotation>Arkham detective agency is working security for an auction at miskatonic university . A pack of ghouls attack the attendees and steal a grimoire of ancient knowledge . A large portion of the story is set in miskatonic's miskatonic university .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Josh_Reynolds"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Arkham_Detective_Agency"/>
    <ex:wasPublishedOnW>November 2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Pathfinder">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Pathfinder</rdfs:label>
    <ex:hasAnnotation>The setting of the role-playing game is one of high fantasy with a touch of sci-fi and elements of horror . There are several dozen sentient species (normal, magical, aberrant, and demonic) living on the world of golarion . The greatest human civilization on golarion is that of the empires on the continent of tian xia .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Fantasy</ex:hasGenreW>
    <ex:hasGenreW>Horror role-playing game</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Fronti_Nulla_Fides">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Fronti Nulla Fides</rdfs:label>
    <ex:hasAnnotation>No faith in appearances is a scenario supplement for chaosium 's call of cthulhu mythos roleplaying game . It contains a total of six stand-alone adventures for the cthulhu invictus period of the roleplaying game . Behind the mythos was published by licensed third-party content provider golden goblin press .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Jeffrey_Moeller"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Oscar_Rios"/>
    <ex:hasAuthorW>Charles Gerard</ex:hasAuthorW>
    <ex:hasAuthorW>William Adcock</ex:hasAuthorW>
    <ex:hasPageCountW>70</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>August 2019</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Crisis_on_Infinite_Betties">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Crossovers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Crisis on Infinite Betties</rdfs:label>
    <ex:hasAnnotation>Bettie page was a secret agent sent to investigate the artist richard pickman after one of his paintings depicted the mysterious entity "unsub ede 17" page was given a briefcase containing a slip of paper with a chant written on it, as well as an a .22 pistol in case pickman gets out of hand . The two of them get into a brief scuffle before pickman uses a chant to send both page and himself to an alternate dimension . There,</ex:hasAnnotation>
    <ex:hasAuthorW>David Avallone</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>June - October 2019</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ny-Rakath">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Ny-Rakath</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAnnotation>Great Old Ones First appearance Mythos (Collectible Card Game) is a Great Old One in the Mythos collectible card game. It resembles a hulking winged bidepal goat with four horns and a serpentine tongue, similar in appearance to the entity from the Devil card of the traditional A.E. Waite Tarot deck. Its effect was to eliminate and prevent the use of assistant character cards. Its location was listed as Underground.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Mythos</ex:madeFirstAppearanceOnC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Flame_in_the_Ice">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Flame in the Ice</rdfs:label>
    <ex:hasAnnotation>Swords-for-hire olbur and peltamash are engaged by a wizard to protect his caravan on a trip into the cold north of hyperborea . However, once they reach the frozen tundra, temsol reveals that his true intention is to steal the power of an entity ensconced in a city of ice . Realising at the last minute that allowing temsol to claim teloth's power would be disastrous, olbur and peltamash release</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#DJ_Tyrer"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Swords_Against_Cthulhu_II:_Hyperborean_Nights"/>
    <ex:wasPublishedOnW>January 2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Case_of_the_Missing_Grimoire">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Case of the Missing Grimoire</rdfs:label>
    <ex:hasAnnotation>Looking for darla: stories of mythos noir was published in his collection looking for darla: stories of mythos noir by elder signs press in september 2008 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Looking_for_Darla:_Stories_of_Mythos_Noir"/>
    <ex:wasPublishedOnW>September 2008</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Horrorscope">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Horrorscope</rdfs:label>
    <ex:hasAnnotation>A group of cultists believe a horoscope in the local newspaper predicts the coming of their god . When their new dawn fails to materialise, they track down and sacrifice the astrologer who wrote the article .</ex:hasAnnotation>
    <ex:hasAuthorW>Charles Black</ex:hasAuthorW>
    <ex:hasGenreW>Humour</ex:hasGenreW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Whispers_from_the_Abyss"/>
    <ex:wasPublishedOnW>November 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_4_Kids:_Raising_Rlyeh:_Volume_2">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Storybooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu 4 Kids: Raising R'lyeh: Volume 2</rdfs:label>
    <ex:hasAnnotation>Luke J. Morris Mo Simpson Cover Artist Mo Simpson English Release Date December 2014 40 Preceded by Cthulhu 4 Kids: Old Ones at the Beach: Volume 1 is a children's book written by Luke J. Morris and illustrated by Mo Simpson. It was self-published through the CreateSpace platform in December 2014; both paperback and digital editions were released. Overview Gallery</ex:hasAnnotation>
    <ex:hasAuthorW>Luke J. Morris</ex:hasAuthorW>
    <ex:hasPageCountW>40</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>December 2014</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Dark">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Dark</rdfs:label>
    <ex:hasAnnotation>Graham Walmsley Horror is a rules-light Lovecraftian tabletop role-playing game by Graham Walmsley . Full rules are available for free on the author's website. It has two small supplements, Tales and Dark Depths , also available for free. External links Rules of Gallery</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Rhesus_Chart">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Rhesus Chart</rdfs:label>
    <ex:hasAnnotation>The novel tells the story of a programmer who turns himself into a vampire-like creature . The vampires are known as phangs--photogolic hemophagic anagathic neurotropic mumble-mumble . The investment bankers are recruited by the laundry (britain's occult secret service)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Charles_Stross"/>
    <ex:hasGenreW>Cthulhu Mythos et al.</ex:hasGenreW>
    <ex:hasPageCountW>359</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Laundry_Files"/>
    <ex:wasReleasedOnW>July 2014</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Unaussprechlichen_Kulten">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Unaussprechlichen Kulten</rdfs:label>
    <ex:hasAlternativeNamesA>Black Book</ex:hasAlternativeNamesA>
    <ex:hasAlternativeNamesA>Das Buch von den unaussprechlichen Kulten</ex:hasAlternativeNamesA>
    <ex:hasAlternativeNamesA>Nameless Cults</ex:hasAlternativeNamesA>
    <ex:hasAnnotation>The black book is a fictional occult tome said to have been published in düsseldorf in 1839 . The pages written in the last months of the author's life were found in pieces with his body after his death . The book was widely suppressed and after von junzt's death in 1840 many people burned their copies .</ex:hasAnnotation>
    <ex:hasFunctionA>Tome</ex:hasFunctionA>
    <ex:hasPlaceOfOriginA>Germany</ex:hasPlaceOfOriginA>
    <ex:hasTypeA>Data Storage</ex:hasTypeA>
    <ex:hasTypeA>Transmission</ex:hasTypeA>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_Black_Stone"/>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#Friedrich_von_Junzt"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yorith">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Yorith</rdfs:label>
    <ex:hasAffiliationC>possibly Outer Gods</ex:hasAffiliationC>
    <ex:hasAnnotation>possibly Outer Gods First appearance " The Oldest Dreamer " Created by Walter C. DeBill, Jr. is a creature, possibly a Great Old One , who dwells in the ocean depths of the planet Yilla . ( EXP : " The Oldest Dreamer " Walter C. DeBill Jr. )</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Oldest Dreamer</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Walter C. DeBill. Jr.</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Case_of_Charles_Dexter_Ward_%28DART_production%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAudioAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Case of Charles Dexter Ward (DART production)</rdfs:label>
    <ex:hasAnnotation>The case of charles dexter ward is a production released by the h. p. lovecraft historical society as part of their dark adventure radio theatre series . Based on the short story of the same name, running to a total of 154 minutes . Also in keeping with previous releases is the inclusion of period-authentic props designed to complement the immersive experience .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Case_of_Charles_Dexter_Ward"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Spawn_of_Dagon_%28short_story%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Spawn of Dagon (short story)</rdfs:label>
    <ex:hasAnnotation>"spawn of dagon" is a short story by american and lovecraft contemporary henry kuttner . It is part of his elak about an atlantean criminal and swordsman . At the story's conclusion, elak and lycon escape, along with a comely wench .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Henry_Kuttner"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Fantasy</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Elak</ex:isPartOfSeriesW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>July 1938</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Elder_Ice">
    <rdf:type rdf:resource="http://example.org/lovecraft#CrossroadPress"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Elder Ice</rdfs:label>
    <ex:hasAnnotation>Former boxer and world war 1 veteran is sent to recover a debt for his law firm from a deceased antarctic explorer, sir ernest shackleton . It is speculated by some that he may have encountered a primordial pre-human civilization in his travels and brought back relics of their culture . He finds himself caught between multiple employers who are willing to do anything to see if there is any truth to their claim .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#David_Hambling"/>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Urban Fantasy</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Harry Stubbs</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2014 August 1st</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Aartna">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Aartna</rdfs:label>
    <ex:hasAnnotation>The Artna are a species living in the Pleiades region, around Celaeno . The are linked to Gtuhanai . ( EXP : Forces of Change )</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#On_a_Beach_Near_Innsmouth">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>On a Beach Near Innsmouth</rdfs:label>
    <ex:hasAnnotation>Full story online here Ron Shiflet United States English Publication date August 1999 " " is a Cthulhu Mythos poem by American Ron Shiflet . Synopsis The narrator, suffering from some form of mental block over a horrifying incident which took his loved ones from him, returns to Innsmouth to uncover the truth. Publication History "" was first featured in the online fanzine Nightscapes in August 1999. It later appeared in Innsmouth Tales - 2000 (January 2000; this collection was co-edited by Shiflet), and twice in Lovecraft's Disciples (July 2011 and March 2015).</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>August 1999</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Scott_Dorward">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Scott Dorward</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Games designer Podcaster Roleplaying games is a traditional games designer and podcaster who specialises in tabletop Lovecraftian roleplaying games. His gaming credits include material for Cthulhu Dark and the World War Cthulhu line of Call of Cthulhu supplements, the latter of which he line developed for Cubicle 7 Entertainment until 2017; he has also written Call of Cthulhu material for Chaosium , the game's creator company, and Pelgrane Press . Dorward is also the co-creator, with Matthew Sanderson and Paul Fricker , of Good Friends of Jackson Elias , a podcast devoted to the Call of Cthulhu horror roleplaying game and related topics, named for one of the primary characters in the Masks of Nyarlathotep supplement . Dorward, Sanderson, and Fricker have also worked together on written material for the game, including Nameless Horrors (2015, 2023) and The Two-Headed Serpent (2017). Selected Bibliography Call of Cthulhu Nameless Horrors (2015, 2023) The Two-Headed Serpent (2017) External Links BlasphemousTomes.com , a Lovecraftian gaming podcast co-created by at RPGGeek References</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Games designer</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Podcaster</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Black_Letter_Day">
    <rdf:type rdf:resource="http://example.org/lovecraft#BhyhlunSeries"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Black Letter Day</rdfs:label>
    <ex:hasAnnotation>History is the first part of his bh'yhlun series of post-apocalyptic mythos fiction . A survivor named lucy recalls how the end of the world came about while attempting to make her way to glastonbury, rumoured to be a place of great power . Through lucy's musings we are told how her boyfriend georgio, a filmmaker, came across a cop of feery's notes on the necronomicon</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ian_Davey"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Nightscapes #1</ex:isPublishedAsW>
    <ex:wasPublishedOnW>June 1997</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Holiness_of_Az%C3%A9darac">
    <rdf:type rdf:resource="http://example.org/lovecraft#AveroigneCycle"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ClarkAshtonSmithWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Holiness of Azédarac</rdfs:label>
    <ex:hasAnnotation>A young monk in medieval france is on his way to alert his superiors to the existence of a subversive cult in the ranks of the catholic church . He is soon intercepted by one of his opponents and cast back in time seven hundred years . In the past, the monk falls for the charms of a beautiful sorceress and after engaging in an aborted attempt to return to his own era, stays in the arms of his new love .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Fantasy Short Fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>November 1933</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Villiers_de_lIsle_Adam">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsInspirationsAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Villiers de l'Isle Adam</rdfs:label>
    <ex:diedOnR>1889 August 19th</ex:diedOnR>
    <ex:hasAnnotation>Jean-marie-mathias-philippe-auguste, comte de villiers de l'isle-adam (november 7, 1838 – august 19, 1889) was a french symbolist writer . Important among his works are the drama axel (1890), the novel l've future ("tomorrow's eve")</ex:hasAnnotation>
    <ex:hasBirthplaceR>Brittany Saint-Brieuc</ex:hasBirthplaceR>
    <ex:hasFullNameR>Jean-Marie-Mathias-Philippe-Auguste comte de Villiers de l'Isle-Adam</ex:hasFullNameR>
    <ex:hasNationalityR>French</ex:hasNationalityR>
    <ex:isConnectedToMythosR>H. P. Lovecraft had a fondness for his works</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1838 November 7th</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Black_Book_Issue_2_%28August_2002%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Black Book Issue 2 (August 2002)</rdfs:label>
    <ex:hasAnnotation>The Black Book Issue 2 Various Cover Artist Ken Withrow English The Black Book Release Date August 2002 Preceded by Issue 1 Followed by Issue 3 The Black Book Issue 2 was the second issue of the short-lived Lovecraftian fanzine The Black Book . Edited by Peter Worthy and featuring cover art by Ken Withrow, it was self-published in a digital format in August 2002. Contents Editorial by Peter A. Worthy " The Black Brat of Dunwich " by Stanley C. Sargent "The Horror South of Red Hook" by Ova Hamlet "The Book of the Overseer" by Adam Niswander "Nyarlathotep, the Crawling Chaos" by Franklyn Searight " The Worm in the Wood " by Laurence J. Cornford "Shunned Things" by Ann K. Schwader "Philosophy in the Work of H. P. Lovecraft" by E. P. Berglund "Attack of the Deep Ones" by Daniel Alan Ross "Sonnet: Cthulhu" by Scott H. Urban " The Mark of Yig " by Robert M. Price " The Sealed Casket " by Richard F. Searight "The Hound" by Mark Francis "The Barrett Horror" by Walter C. DeBill, Jr. "Wind on the Lakes" by Peter F. Guenther "The Crawlers from Beyond" by James Gruetzmacher</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>The Black Book</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>August 2002</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shipping_on_the_River">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Shipping on the River</rdfs:label>
    <ex:hasAnnotation>Sergio Palumbo Ivan Bertazonni English Genre(s) Weird fiction Lovecraftiana Vol 5, Issue 1 date 2020 " " is a short story by Sergio Palumbo and Ivan Bertozzoni. It is unusual for a story in the Cthulhu Mythos genre in that it describes what appears to be a peaceful interaction between humans and the creatures of the Mythos. Synopsis Glasgow, late 1800s: two men stumble across what at first appears to be a people-smuggling operation, or perhaps even an annual mass sacrifice being undertaken by the crew of a small ship. As they delve further however, they discover that the ship's captain is merely trying to help Deep One hybrids who are coming of age in their first steps towards realising their aquatic heritage. History "" was published in Vol 5, Issue 1 of the Lovecraftiana zine in 2020.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Sergio_Palumbo"/>
    <ex:hasAuthorW>Ivan Bertazonni</ex:hasAuthorW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 1</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 5</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#To_Quebec_and_the_Stars">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>To Quebec and the Stars</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft H. P. Lovecraft Cover Artist Robert MacIntyre English Genre(s) Non-fiction Donald M. Grant Release Date 1976 318 is a collection of non-fiction works by the late American Howard Phillips Lovecraft . Edited by L. Sprague de Camp and featuring cover art by Robert MacIntyre, it runs to a total of 318 and was published by Donald M. Grant in 1976; it has not been reissued . The book is divided into four sections, with de Camp providing an introduction for each. The majority of is occupied by A Description of the Town of Quebeck, in New France, Lately added to His Britannick Majesty's Dominions , a substantial travelogue which made its first print appearance in this volume . Introduction Contents Interior artwork by H. P. Lovecraft Introduction by L. Sprague de Camp Science "Letter (Scientific American, August 5, 1906): Trans-Neptunian Planets" " November Skies " " June Skies " " May Skies " " The Truth About Mars " Literature and Esthetics " Metrical Regularity " " The Allowable Rhyme " " A Reminiscence of Dr. Samuel Johnson " " The Literature of Rome " " What Belongs in Verse " Philosophy " The Crime of the Century " " Nietzscheism and Realism " " A Confession of Unfaith " Travel, Description and History " A Descent to Avernus " " Some Dutch Footprints in New England " " The Unknown City in the Ocean " A Description of the Town of Quebeck, in New France, Lately added to His Britannick Majesty's Dominions External Links Review of at spraguedecampfan Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:hasPageCountW>318</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1976</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ithaqua">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Ithaqua</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#Avaloth"/>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#Wendigo"/>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#Yeti"/>
    <ex:hasAlternativeNamesC>Death-Walker</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>God of the Cold</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>God of the Winds</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Ithaka</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Lord of the Winds</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The White Silence</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Wind-Walker</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The wind-walker is a fictional character in the cthulhu mythos of h.p. Lovecraft . He is also known as the yeti or the wendigo . He is believed to have inspired the native american legend of the wendigo and possibly the yeti .</ex:hasAnnotation>
    <ex:hasAppearanceC>Ithaqua Beyond the Threshold The Burrowers Beneath The Transition of Titus Crow Born of the Winds Jendick's Swamp Wrath of the Wind-Walker Allan</ex:hasAppearanceC>
    <ex:hasAppearanceC>the Sundered Veil</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Thing_That_Walked_on_the_Wind"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#August_Derleth"/>
  </rdf:Description>
