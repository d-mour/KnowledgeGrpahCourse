  <rdf:Description rdf:about="http://example.org/lovecraft#Aforgomon">
    <rdf:type rdf:resource="http://example.org/lovecraft#Avatars"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OuterGods"/>
    <rdfs:label>Aforgomon</rdfs:label>
    <ex:hasAffiliationC>Possibly Yog-Sothoth</ex:hasAffiliationC>
    <ex:hasAnnotation>Possibly Yog-Sothoth First appearance CIRCLE : " The Chain of " CIRCLE " The Dark Eidolon " EXP : Malleus Monstrorum Created by Clark Ashton Smith is believed by some to be a god of time ( CIRCLE : " The Chain of "), and may be an avatar of Yog-Sothoth . ( EXP : Malleus Monstrorum ) A necromancer used "avorgomon" as part of an incantation. ( CIRCLE : " The Dark Eidolon ")</ex:hasAnnotation>
    <ex:hasAppearanceC>CIRCLE The Dark Eidolon Malleus Monstrorum</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Chain_of_Aforgomon"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
