    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Ngiri's Catch</rdfs:label>
    <ex:hasAnnotation>Aaron Polson Innsmouth Free Press Historical Lovecraft Media type Anthology date April 2011 is a short story written by American Aaron Polson which was published in the Cthulhu Mythos anthology Historical Lovecraft in April 2011. Synopsis TBA</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Aaron_Polson"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Historical_Lovecraft"/>
    <ex:wasPublishedOnW>April 2011</ex:wasPublishedOnW>
  </rdf:Description>
