  <rdf:Description rdf:about="http://example.org/lovecraft#John_Gregory_Betancourt">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>John Gregory Betancourt</rdfs:label>
    <ex:hasAnnotation>Betancourt is an american author and editor . Co-founded wildside press in 1989 with his future wife, kim . Has published numerous works from a wide spectrum of the cthulhu mythos .</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Missouri St. Louis</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
    <ex:wasBornOnR>25 October 1963</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Rockets_Red_Glare">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Rockets' Red Glare</rdfs:label>
    <ex:hasAnnotation>Cthulhu mythos flash fiction piece by david c. roncoli . First published in graphic novel fall of cthulhu volume 3: the gray man . Describes encounter of a well-armed man with a mi-go "summoned up by some pimply faced cultists"</ex:hasAnnotation>
    <ex:hasAuthorW>David C. Roncoli</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Fall_of_Cthulhu_Volume_3:_The_Gray_Man"/>
    <ex:wasPublishedOnW>December 2008</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Twilight_Horror_%28Call_of_Cthulhu_LCG%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Twilight Horror (Call of Cthulhu LCG)</rdfs:label>
    <ex:hasAnnotation>Twilight horror is an expansion pack for fantasy flight games' call of cthulhu: the card game . It contains 60 cards in the usual division of three sets of 20 . It also introduces a new game mechanic called day/night . It was discontinued in 2015 with the demise of its parent game .</ex:hasAnnotation>
    <ex:wasPublishedOnW>2008</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Antarktos_Cycle">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Antarktos Cycle</rdfs:label>
    <ex:hasAnnotation>Robert M. Price , ed. Cover Artist John Snyder English Call of Cthulhu Fiction Genre(s) Cthulhu Mythos Chaosium Release Date August 1999 572 : At the Mountains of Madness and Other Chilling Tales is an anthology of writings related to H. P. Lovecraft 's At the Mountains of Madness , including stories that inspired and were in turn inspired by the novella, which is itself included in the volume. Edited by Robert M. Price , it was published by Chaosium in 1999, part of the Call of Cthulhu Fiction . Contents "Introduction: Lovecraft's Cosmic History" (essay) by Robert M. Price (1999) " Antarktos " (poem) by H. P. Lovecraft (1930) The Narrative of Arthur Gordon Pym of Nantucket by Edgar Allan Poe (1838) "Introduction ( The Sphinx of the Ice Fields )" (essay) by Harold Beaver The Sphinx of the Ice Fields (excerpt) by Jules Verne (1975) The Greatest Adventure by John Taine (1929) At the Mountains of Madness by H. P. Lovecraft (1936) The Tomb of the Old Ones by Colin Wilson (1999) " At the Mountains of Murkiness: or, From Lovecraft to Leacock " by Arthur C. Clarke (1940) The Thing from Another World by John W. Campbell, Jr. (1952) "The Brooding City" by John S. Glasby (1990) "The Dreaming City" by Roger Johnson (1987)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
    <ex:hasAuthorW>ed.</ex:hasAuthorW>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasPageCountW>572</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu Fiction</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>August 1999</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Robert_Suydam">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Robert Suydam</rdfs:label>
    <ex:ceasedOnC>Early 20th century</ex:ceasedOnC>
    <ex:hasAnnotation>"the horror at red hook" is a fictional character created by h. p. lovecraft . He is a lettered recluse of ancient dutch family . Relatives tried unsuccessfully to have him declared insane .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Horror_at_Red_Hook"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
