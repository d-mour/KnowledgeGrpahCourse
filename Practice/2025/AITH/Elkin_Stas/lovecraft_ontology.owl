    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Mtal</rdfs:label>
    <ex:hasAnnotation>Dreamlands Country Humans First appearance HPL : " The Doom That Came to Sarnath " Created by H. P. Lovecraft is a coastal region in the Dreamlands . Pearls from "wave-washed" dissolved in vinegar produced in the city of Thraa were considered a delicacy in Sarnath . ( HPL : " The Doom That Came to Sarnath ")</ex:hasAnnotation>
    <ex:hasTypeL>Country</ex:hasTypeL>
    <ex:isInhabitedByL>Humans</ex:isInhabitedByL>
