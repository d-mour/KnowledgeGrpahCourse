  <rdf:Description rdf:about="http://example.org/lovecraft#Henry_George_Weiss">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Henry George Weiss</rdfs:label>
    <ex:diedOnR>1946</ex:diedOnR>
    <ex:hasAnnotation>Canadian-born poet and essayist who wrote weird fiction under the pseudonym “Francis Flagg”. He came into touch with Lovecraft in 1930; his communist leanings may have influenced Lovecraft’s leftward political shift in the 1930s.</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1898</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Earthworms">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Earthworms</rdfs:label>
    <ex:hasAnnotation>Is a lovecraftian short story by american cody goodfellow . First published in the november 2011 edition of midnight echo magazine . Has also been included in the jason . Andrew-edited thematic anthology apotheosis: stories of human survival after the rise of the elder gods .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Cody_Goodfellow"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Midnight Echo</ex:isPublishedAsW>
    <ex:wasPublishedOnW>November 2011</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#To_Skin_a_Corpse">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>To Skin a Corpse</rdfs:label>
    <ex:hasAnnotation>"to skin a dead man" is a short story by cody goodfellow . It first appeared (as "to skin a dead man" in hardboiled cthulhu . The story is about reanimated dead ala "herbert west--re-animator"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Cody_Goodfellow"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasGenreW>Hardboiled</ex:hasGenreW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Hardboiled_Cthulhu"/>
    <ex:wasPublishedOnW>2006 May 30</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cxaxukluth">
