    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Orryx">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ElderGods"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Orryx</rdfs:label>
    <ex:hasAffiliationC>Elder Gods</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Bright Flame</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Bright Flame Elder Gods First appearance AWD : " The Lair of the Star-Spawn " Created by August Derleth &amp; Mark Schorer ( The Bright Flame ) is a fictional deity created by August Derleth and Mark Schorer for their short story " The Lair of the Star-Spawn ". Description is an Elder God that manifests as a giant pillar of blinding white and purple flames. Although its expression is bright and blinding, no one feels its heat. No one can look at more than a few seconds; after the first glance, the eyes of anyone who looks become sore and watery.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Lair_of_the_Star-Spawn"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Mark_Schorer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crypt_of_Cthulhu_St._Johns_Eve_1991">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crypt of Cthulhu St. John's Eve 1991</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Peter Smith United States English Necronomicon Press Release Date June 1991 36 Preceded by Eastertide 1991 Followed by Hallowmas 1991 is the 78th issue of long-running Lovecraftian fanzine Crypt of Cthulhu . Edited by Robert M. Price , it was published by Necronomicon Press in June 1991. Contents Editorial Shards by Robert M. Price "Second Thoughts on the "Fungi from Yuggoth"" by Robert M. Price " The Unspeakable Spawning of the Proto-Shoggoths " by Robert M. Price "The Courier" by Robert A. W. Lowndes "The Worshippers" by Robert A. W. Lowndes "Liberation" by Robert A. W. Lowndes "The Guardian" by Robert A. W. Lowndes "The Summons" by Robert A. W. Lowndes "The Viola" by Robert A. W. Lowndes "The Poet" by Robert A. W. Lowndes "The Street" by Robert A. W. Lowndes "The Council" by Robert A. W. Lowndes "The House" by Robert A. W. Lowndes "The Whisperer" by Robert A. W. Lowndes "The Crawler" by Robert A. W. Lowndes "The Shadows over Albertus Magnus" by Richard L. Tierney "Lovecraft: An American Allegory" Donald R. Burleson, Ph.D. "Strange Cylinders" by Robert M. Price "Inside the Bud" by D. F. Lewis "The Critique" by Lew Cthew Reviews by Scott D. Briggs, Robert M. Price, and Stefan Dziemianowicz</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>36</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>June 1991</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#hasHalfSibling">
