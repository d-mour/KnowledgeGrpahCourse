    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Two-Headed Serpent</rdfs:label>
    <ex:hasAnnotation>Paul Fricker Scott Dorward Matt Sanderson Cover Artist Pinturero English Call of Cthulhu ( Pulp Cthulhu ) Genre(s) Roleplaying game Chaosium Release Date 2017 272 is a ENnie and Origins award-winning campaign supplement for the Call of Cthulhu horror roleplaying game. Written by Paul Fricker , Scott Dorward , and Matt Sanderson , it was published by Chaosium in 2017; both hardcover and digital editions were released . Overview Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Paul_Fricker"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Scott_Dorward"/>
