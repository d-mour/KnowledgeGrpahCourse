  <rdf:Description rdf:about="http://example.org/lovecraft#Wrath_of_the_Wind-Walker">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Wrath of the Wind-Walker</rdfs:label>
    <ex:hasAnnotation>The ithaqua cycle: the wind-walker of the icy wastes is a short story by american authors robert m. price and james ambuehl . In the first part of the story, reporter j.j. hanley listens to an ageing professor winslow tell the story of how in his youth he led an expedition into the jungles of cambodia in search of an anomalous cult of ice worshipers . The mercenaries in their bloodlust also murdered</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#James_Ambuehl"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu Fiction</ex:isPartOfSeriesW>
    <ex:isPublishedAsW>The Ithaqua Cycle: The Wind-Walker of the Icy Wastes</ex:isPublishedAsW>
    <ex:wasPublishedOnW>July 1998</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Whisperers">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Whisperers</rdfs:label>
    <ex:hasAnnotation>Fantastic date september 1977is a cthulhu mythos story by richard a. lupoff . It first appeared in the september 1977 issue of fantastic . The story follows two high school journalists who interview a hot rock band . The band has an occult shtick .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Richard_A._Lupoff"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Fantastic</ex:isPublishedAsW>
    <ex:wasPublishedOnW>September 1977</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dark_Planet">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dark Planet</rdfs:label>
    <ex:hasAnnotation>Full story online here Phillip A. Ellis English Genre(s) Fantasy Nightscapes date March 1999 " " is a Cthulhu Mythos poem by Australian Phillip A. Ellis . Synopsis A short piece on the fungoid Mi-Go and their home world of Yuggoth . History "" was published in the March 1999 edition of online fanzine Nightscapes .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Phillip_A._Ellis"/>
    <ex:hasGenreW>Fantasy</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Nightscapes"/>
    <ex:wasPublishedOnW>March 1999</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Madness_of_Wonderland">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Madness of Wonderland</rdfs:label>
    <ex:hasAnnotation>Dan Wickline Jim Webb English Media Type Comic book is a four-issue comic book mini-series written by Dan Wickline in 2008-2009 which was published by Zenescope Entertainment. Synopsis Detective Legrasse investigates the murders that happened in the Call of Wonderland , and the mysterious disappearance of the two murder suspects. In the back-story, Lovecraft 's disturbing dreams become ever more real.</ex:hasAnnotation>
    <ex:hasAuthorW>Dan Wickline</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Whipple_Van_Buren_Phillips">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPeople"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Whipple Van Buren Phillips</rdfs:label>
    <ex:diedOnR>28 March 1904</ex:diedOnR>
    <ex:hasAnnotation>H. p. lovecraft 's grandfather was a successful businessman who owned much of the land in and around the town of greene, rhode island . He left his family a substantial inheritance, though it was greatly mismanaged . Though he left his family a substantial inheritance, it was greatly mismanaged .</ex:hasAnnotation>
    <ex:hasChildrenR rdf:resource="http://example.org/lovecraft#Sarah_Susan_Phillips_Lovecraft"/>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasRelativeR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:isConnectedToMythosR>H. P. Lovecraft 's grandfather</ex:isConnectedToMythosR>
    <ex:wasBornOnR>22 November 1833</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Tales_Vol._1">
