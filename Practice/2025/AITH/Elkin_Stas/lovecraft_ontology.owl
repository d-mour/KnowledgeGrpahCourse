    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Longdock Air</rdfs:label>
    <ex:hasAnnotation>History was first published in the thematic anthology shadows over main street: volume 2 by cutting block books in october 2017 . It was also included in the collection of meikle's own works into the black: tales of lovecraftian terror in may 2019 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
