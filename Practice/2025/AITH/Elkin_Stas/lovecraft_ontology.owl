    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Some Dutch Footprints in New England</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft English Genre(s) Non-fiction Donald M. Grant To Quebec and the Stars Date of writing October 1933 date 1976 " " is a short non-fiction work by the late American Howard Phillips Lovecraft . Although it was written in October 1933, it did not see until its inclusion in L. Sprague de Camp 's 1976 collection To Quebec and the Stars . History To Quebec and the Stars (1976) Howard Phillips Lovecraft 3 (1992, 2016) Miscellaneous Writings (1995) Collected Essays Volume 4: Travel (2006) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>To Quebec</ex:isPublishedAsW>
    <ex:isPublishedAsW>the Stars</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1976</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>October 1933</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Festival">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Festival</rdfs:label>
    <ex:hasAnnotation>"yule horror" is a seasonal horror poem by the late american author . First published in the december 1926 edition of popular pulp magazine weird tales . Has since been reprinted numerous times in many different publications .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>December 1926</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dagon_November_1987-January_1988">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dagon November 1987-January 1988</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Dave Carson United Kingdom English Carl T. Ford Release Date November 1987 60 was the twentieth issue of the now-defunct Lovecraftian fanzine Dagon , billed as a weird fiction special. It was edited by the late British and occasional Carl T. Ford . Contents (incomplete) "The Apothecarium of Yabool-Syn" by Gary Lovisi Crossword Puzzle by N. Mark Gordon "The Stories of Murkales Parts I to V" by D. F. Lewis "The Journal of J. P. Drapeau • short story by Thomas Ligotti</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>60</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>November 1987</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cult_of_Panacea">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cult of Panacea</rdfs:label>
    <ex:hasAnnotation>A group of drones in service to gla'aki maintain his city-starship whilst trading memories to while away the time . When a facet of the god-cancer breaks through from another dimension and attempts to consume his home, the drones sacrifice themselves in an effort to allow their master time to retaliate .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Konstantine_Paradias"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Children_of_Glaaki"/>
    <ex:wasPublishedOnW>2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#John_Henry_Booth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>John Henry Booth</rdfs:label>
    <ex:hasAffiliationC>New Arkham The University</ex:hasAffiliationC>
    <ex:hasAnnotation>John is a former ranger that led gamma squadron for the council of leaders in new arkham . He was raised as the son of marcus booth and winifred booth . When he was a boy, his father murdered his mother and attempted to kill him before being killed by john in return.</ex:hasAnnotation>
    <ex:hasAppearanceC>See main article Cthulhu Armageddon (series)</ex:hasAppearanceC>
    <ex:hasCharacterMateC>Martha Booth</ex:hasCharacterMateC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Cthulhu_Armageddon"/>
    <ex:wasCreatedByC>C.T. Phipps</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Stormbreaker:_The_Saga_of_Beta_Ray_Bill">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Stormbreaker: The Saga of Beta Ray Bill</rdfs:label>
    <ex:hasAnnotation>Mike Oeming, Dan Berman Andrea Di Vito English Marvel Comics Release Date March 2005-Aug 2005 Media Type Comic book is a 6-part miniseries written by Mike Oeming and Dan Berman. Synopsis Fighting between two alien superpowered beings releases Asteroth , one of the Old Ones from its imprisonment who then threatens the cosmos with oblivion.</ex:hasAnnotation>
    <ex:hasAuthorW>Dan Berman</ex:hasAuthorW>
    <ex:hasAuthorW>Mike Oeming</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>March 2005-Aug 2005</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Fungi_from_Yuggoth_and_Other_Poems">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Fungi from Yuggoth and Other Poems</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft Frank Utpatel Cover Artist Gervasio Gallardo English Ballantine Adult Fantasy Ballantine Books Release Date 1971 138 is a collection of poetry by the late American H. P. Lovecraft . Overview Published by Ballantine Books as part of their Adult Fantasy , runs to 138 and features cover art by Gervasio Gallardo with interior illustrations by Frank Utpatel . It is by and large a reprint of the Arkham House release Collected Poems . was issued as an individual volume and with three other books in the boxed set The World of H. P. Lovecraft . Contents Foreword by August Derleth " Providence " " On a Grecian Colonnade in a Park " " Old Christmas " " New-England Fallen " " On a New-England Village Seen by Moonlight " " Astrophobos " " Sunset " " To Pan " " A Summer Sunset and Evening " " To Mistress Sophia Simple, Queen of the Cinema " " A Year Off " " Sir Thomas Tryout " " Phaeton " " August " " Death " " To a Youth " " My Favorite Character " " To Templeton and Mount Monadnock " " The Poe-et's Nightmare: A Fable " " Lament for the Vanished Spider " " Regnar Lodbrug's Epicedium " " Drinking Song from the Tomb " " Little Sam Perkins " " The Ancient Track " " The Eidolon " " The Nightmare Lake " " The Outpost " " The Rutted Road " " The Wood " " The House " " The City " " Hallowe'en in a Suburb " " Primavera " " October " " To a Dreamer " " Despair " " Nemesis " " Yule Horror " " To Mr. Finlay, Upon His Drawing for Mr. Bloch's Tale, "The Faceless God" " " Christmas Greeting to Mrs. Phillips Gamwell—1925 " " Where Once Poe Walked " " The Messenger " " To Klarkash-Ton, Lord of Averoigne " " Psychopompos " Fungi from Yuggoth "Pursuit" "The Book" "Recognition" "The Key" "Homecoming" "The Lamp" "Zaman's Hill" "The Courtyard" "The Port" "The Pigeon-Flyers" "The Well" "The Howler" "Hesperia" "Antarktos" "Star-Winds" "The Window" "A Memory" "The Gardens of Yin" "Night-Gaunts" "The Bells" "Azathoth" "Nyarlathotep" "Mirage" "The Canal" "St. Toad's" "The Elder Pharos" "The Familiars" "Expectancy" "Nostalgia" "Background" "The Dweller" "Alienation" "Harbour Whistles" "Recapture" "Continuity" "Evening Star"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasPageCountW>138</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Ballantine Adult Fantasy</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>1971</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Simon_Birks">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Simon Birks</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Comic book creator Games designer United Kingdom United Kingdom is a U.K.-based actor, producer, screenplay writer, comic book creator and author. In addition he, in partnership with Marielle Bouleau, founded Blue Fox Comics, an independent small press based in Linlithgow, Scotland, which was initially created to publish Birks's work. Due to the company's success, it has branched out to encompass the works of other authors and comic book creators, and has published dozens of works via successful Kickstarter campaigns . Birks has adapted a number of H. P. Lovecraft ’s stories into a comic book format, including " The Thing on the Doorstep " and " The Shadow Over Innsmouth ", has written a sequel to At the Mountains of Madness in the same format, and was the creator of the Fighting Fantasy -style gamebook Innsmouth: The Stolen Child . Selected Works Comic Books The Thing on the Doorstep (2022) The Shadow Over Innsmouth (2023) The Mountains of Madness (2023) Gamebooks Innsmouth: The Stolen Child (2022) External Links at IMDb at Goodreads Blue Fox Comics official website References</ex:hasAnnotation>
    <ex:hasBirthplaceR>United Kingdom</ex:hasBirthplaceR>
    <ex:hasNationalityR>United Kingdom</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Comic book creator</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Games designer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Betelgeuse">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Stars"/>
    <rdfs:label>Betelgeuse</rdfs:label>
    <ex:hasAlternativeNamesL>Glyu'uho</ex:hasAlternativeNamesL>
    <ex:hasAlternativeNamesL>Glyu-vho</ex:hasAlternativeNamesL>
    <ex:hasAnnotation>Glyu-vho is the brightest star in the constellation of orion and one of the largest stars in our galaxy . In the works of august derleth , the elder gods dwell in the vicinity of , which they refer to as glyu-vho ( awd : " the return of hastur ", exp : " the horror from the bridge " .</ex:hasAnnotation>
    <ex:hasAppearanceL rdf:resource="http://example.org/lovecraft#The_Eater_of_Souls"/>
    <ex:hasTypeL>Star</ex:hasTypeL>
    <ex:isInhabitedByL>Elder Gods</ex:isInhabitedByL>
    <ex:isLocatedAtL>Milky Way Galaxy</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Lair_of_the_Star-Spawn"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Abbey">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Abbey</rdfs:label>
    <ex:hasAnnotation>Resources for cthulhu dark ages is a supplement for call of cthulhu offshoot . Split into three sections, contains background allowing keepers to run games in medieval france . First section provides information on a pregenerated backdrop in southeast france of 982ad .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Michael_Patty"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>52</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>February 2004</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Worlds_of_H._P._Lovecraft:_Arthur_Jermyn">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Worlds of H. P. Lovecraft: Arthur Jermyn</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft (original story) Steven Philip Jones (adaptation) United States English The Worlds of H. P. Lovecraft Genre(s) Weird fiction Caliber Comics Release Date 1993 Followed by The Worlds of H. P. Lovecraft: Dagon is a comic book format adaptation of the H. P. Lovecraft short story " Facts Concerning the Late Arthur Jermyn and His Family ". Overview First published by Caliber Comics in 1993 as the first part of their Worlds of H. P. Lovecraft , Arthur Jermyn was later collected in the omnibus H. P. Lovecraft's Worlds: Volume 2 . It was adapted by American Steven Philip Jones .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Steven_Philip_Jones"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>The Worlds of H. P. Lovecraft</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>1993</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Earth-666_%28Alternate_Marvel_Earth%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Planets"/>
    <rdfs:label>Earth-666 (Alternate Marvel Earth)</rdfs:label>
    <ex:hasAnnotation>Earth-666 is an alternate reality that first appears in secret avengers vol 1 #33 . The reason it's called earth-666 is because in that reality, earth is a world of the undead . It's run by a totalitarian regime, in which "civilians" require permits for various things .</ex:hasAnnotation>
    <ex:hasTypeL>Planet</ex:hasTypeL>
    <ex:isInhabitedByL>Undead humans</ex:isInhabitedByL>
    <ex:isInhabitedByL>monstrous humanoids</ex:isInhabitedByL>
    <ex:isLocatedAtL>Earth-666 Reality</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL>Secret Avengers Vol 1 33</ex:madeFirstAppearanceOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Grinding_Rock">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Grinding Rock</rdfs:label>
    <ex:hasAnnotation>"” is a cthulhu mythos story by cody goodfellow that first appeared in book of dark wisdom . It tells the story of a firefighter battling a wildfire near san diego . The title refers to a type of native american artifact commonly found in the region .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Cody_Goodfellow"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Book of Dark Wisdom</ex:isPublishedAsW>
    <ex:wasPublishedOnW>January 2005</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Gaslight_Equipment_Catalogue">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Gaslight Equipment Catalogue</rdfs:label>
    <ex:hasAnnotation>United States English Call of Cthulhu Chaosium Release Date June 2007 Media Type Digital Download (PDF) 126 is a sourcebook for Call of Cthulhu , a horror roleplaying game by Chaosium . Overview Consisting of game stats and uses for a variety of items, vehicles and weapons from the Victorian Age, is a part of Chaosium's Monograph line, a of digital-only releases whose content is primarily generated by the fan base. Publication History was first released in June 2007. It is only available as a digital PDF download.</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>126</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>June 2007</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Brick_Cylinders_of_Kadatheron">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Brick Cylinders of Kadatheron</rdfs:label>
    <ex:hasAnnotation>The cylinders are a collection of ancient writings created by h. p. lovecraft for his short story " the doom that came to sarnath ". Their number, provenance and current whereabouts were never given by lovecraft; similarly, whether the kadatheron given in their title is their author or place of origin is unclear .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_Doom_That_Came_to_Sarnath"/>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Delta_Green:_Countdown">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Delta Green: Countdown</rdfs:label>
    <ex:hasAnnotation>John Tynes Dennis Detwiller Adam Scott Glancy Cover Artist Blair Reynolds English Call of Cthulhu Genre(s) Roleplaying game Pagan Publishing Release Date August 1999 is a sourcebook for Chaosium 's Call of Cthulhu roleplaying game which places investigators in an expanded Delta Green sub-setting. Written by John Tynes , Dennis Detwiller , and Adam Scott Glancy , it was issued by Pagan Publishing in August 1999; both hardcover and paperback editions were released. According to games designer Shannon Appelcline in his 2014 book Designers &amp; Dragons: The 90s , the book experienced marketing difficulties in Germany, a country with a solid Call of Cthulhu player base, due to the censorship laws regarding the cover's Nazi imagery . Overview References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Adam_Scott_Glancy"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Dennis_Detwiller"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#John_Tynes"/>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>August 1999</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Initiations_of_the_Favored_%28Call_of_Cthulhu_LCG%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Initiations of the Favored (Call of Cthulhu LCG)</rdfs:label>
    <ex:hasAnnotation>Initiations of the Favored Fantasy Flight Games Publication Date 2010 Living Card Game Call of Cthulhu: The Card Game Initiations of the Favored is an expansion pack for Fantasy Flight Games ' Call of Cthulhu: The Card Game . Overview The third Asylum Pack in The Rituals of the Order Cycle series of expansions, Initiations of the Favored is divided into the standard format of three duplicate sets of 20 unique cards for a total of 60, with the cards contained divided between the existing factions. First released in 2010, it was discontinued in 2015 with the demise of Call of Cthulhu: The Card Game . Contents New Recruit (Character; The Agency) Arrest Warrant (Event; The Agency) Horrific Shoggoth (Character; Cthulhu ) Ghatanothoa , Out Of The Aeons (Character; Cthulhu) Bloated Leng Spider (Character; Hastur ) Come With Us (Event; Hastur) Board of Directors (Character; Miskatonic University ) Zeiss Model C (Support; Miskatonic University) Trampling Dark Young (Character; Shub-Niggurath ) Slime Covered Dhole (Character; Shub-Niggurath) Grasping Chthonian (Character; Shub-Niggurath) Protector of Secrets (Character; Silver Twilight) Wealthy Sponsor (Character; Silver Twilight) Ritual of Power, Gears of Armageddon (Support; Silver Twilight) Satchel of the Void (Support; Silver Twilight) Thief for Hire (Character; Syndicate) Southside Speakeasy, Hidden Business (Support; Syndicate) Expensive Guitar (Support; Syndicate) Constricting Elder Thing (Character; Yog-Sothoth ) Evolving Shoggoth (Character; Yog-Sothoth)</ex:hasAnnotation>
    <ex:wasPublishedOnW>2010</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Athammaus">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Athammaus</rdfs:label>
    <ex:hasAnnotation>A character created by the late american author and lovecraft contemporary clark ashton smith for his hyperborean cycle series of fantasy stories . He appears in " the testament of ", first published in the october 1932 issue of weird tales . The chief headsman of commoriom in its final days, was the latest in a family which had held that title for generations .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Testament_of_Athammaus"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Curse_of_the_Dark_Pharaoh_%28Arkham_Horror_Expansion%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#ArkhamHorror"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Curse of the Dark Pharaoh (Arkham Horror Expansion)</rdfs:label>
    <ex:hasAnnotation>The curse of the dark pharaoh was the first expansion pack for fantasy flight games' second edition of lovecraftian adventure board game arkham horror . Included were the soon-to-be-standard set of 76 investigator cards featuring additional items, spells and allies for players to select from . Also included were 90 ancient one cards to diversify the ways in which the core game could be played .</ex:hasAnnotation>
    <ex:hasAuthorW>Rob Vaughn</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror Action Adventure</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Arkham_Horror"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Azathoth_Awakening">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Azathoth Awakening</rdfs:label>
    <ex:hasAnnotation>A woman's dream awakens the sleeping azathoth , summoning it into our universe . As it comes to claim its prize, all of existence devolves into madness and chaos from its mere presence . Finally arriving at sol, it takes the woman and consumes her before destroying all of creation .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ran_Cartwright"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Cosmic Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>2000</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dybbuk">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Dybbuk</rdfs:label>
    <ex:hasAnnotation>Sociocultural Characteristics Outer Space Real World Information First appearance Cthulhu Invictus Created by Chad Bowser Andi Newton The are a fictional race created in 2009 by Chaosium for its Call of Cthulhu roleplaying game. Background The are a race from an alien planet whom have a gaseous form. They arrived on Earth, millennia ago, fleeing the Mi-Go , where they discovered they were unable to complete the simplest tasks, but if a human inhaled them, their consciousness could replace that of the host. Though reluctant to abandon their hosts, occasionally one is convinced to do so. The host has no recollection of its possession.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Cthulhu_Invictus"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Chad_Bowser"/>
    <ex:wasCreatedByC>Andi Newton</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Roger_Zelazny">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Roger Zelazny</rdfs:label>
    <ex:diedOnR>14 June 1995</ex:diedOnR>
    <ex:hasAnnotation>Full Name Roger Joseph Zelazny Connection to the Mythos Author Birth Date 13 May 1937 Euclid, Ohio, USA Death Date 14 June 1995 Santa Fe, New Mexico, USA United States http://www.roger-zelazny.com/ (13 May 1937 - 14 June 1995) was a noted American author of science fiction and fantasy, as well as an editor and poet of related works, receiving a number of Hugo and Nebula nominations and awards. He did not explore Lovecraft -related concepts until later in the career, writing one short story/novella, 24 Views of Mt. Fuji, by Hokusai , and a novel, A Night in the Lonesome October , which incorporate obvious references to canon mythos elements. Selected Works Novels/Novellas 24 Views of Mt. Fuji, by Hokusai (1985) A Night in the Lonesome October (1993) External Links at Wikipedia at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Ohio Euclid</ex:hasBirthplaceR>
    <ex:hasFullNameR>Roger Joseph Zelazny</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>http://www.roger-zelazny.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>13 May 1937</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Remorseless">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Remorseless</rdfs:label>
    <ex:hasAnnotation>David Conyers Harrison Peel Genre(s) Cthulhu Mythos David Conyers Release Date November 2021 255 Preceded by Cthulhu Resurgent is a collection of Cthulhu Mythos stories by David Conyers (often with a co-). It is the third book in a collecting the adventures of the recurring character Harrison Peel . It was self-published by Conyers in 2021. Contents "The Masked Messenger" (2011) (by David Conyers and John Goodrich ) "Stomach Acid" (2006) (by David Conyers and Brian M. Sammons ) "War Gods of Men" (2014) (by David Conyers and David Kernot ) "Invisible Demons" (2021) (by David Conyers and Brian M. Sammons) " The Bullet and the Flesh " (2014) (by David Conyers and David Kernot) "The R'lyeh Singularity" (2013) (by David Conyers and Brian M. Sammons) "The Mouth of Jupiter" (2021) "Supersymmetry Blues" (2021)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#David_Conyers"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasPageCountW>255</ex:hasPageCountW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Harrison_Peel"/>
    <ex:wasReleasedOnW>November 2021</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#C._Hall_Thompson">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>C. Hall Thompson</rdfs:label>
    <ex:diedOnR>1991 February 11</ex:diedOnR>
    <ex:hasAnnotation>Charles john thompson (march 17, 1923 - february 11, 1991) was a pulp writer who used the pen name . He reportedly faced resistance to his mythos writings from arkham house publisher august derleth .</ex:hasAnnotation>
    <ex:hasBirthplaceR>Pennsylvania Philadelphia</ex:hasBirthplaceR>
    <ex:hasFullNameR>Charles John Thompson</ex:hasFullNameR>
    <ex:wasBornOnR>1923 March 17</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#01Publishing">
    <rdf:type rdf:resource="http://example.org/lovecraft#Publishers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>01Publishing</rdfs:label>
    <ex:hasAnnotation>Current Status Active 2011 Kat Rocha United States https://.com/  is an independent publishing house specialising in the weird fiction genre and by author and editor Kat Rocha in 2011. Amongst other things, it has released prose works and comic books both Lovecraftian in nature and set in the Cthulhu Mythos . Selected Publications Collections Whispers from the Abyss (2014) Whispers from the Abyss Vol. 2: The Horrors That Are &amp; Shall Be (2015) Comic Books Casefile: Arkham- Nightmare on the Canvas (2016) Casefile: Arkham- Her Blood Runs Cold (2018) External Links at The Speculative Fiction Database</ex:hasAnnotation>
    <ex:hasWebsiteR>https://01publishing.com/</ex:hasWebsiteR>
  </rdf:Description>
