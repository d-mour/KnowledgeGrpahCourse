  <rdf:Description rdf:about="http://example.org/lovecraft#Echidna">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Echidna</rdfs:label>
    <ex:hasAffiliationC>Olympians (Greek Gods)</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Snake Goddess</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as snake goddess relatives parents: phorcys (father), ceto (mother) offspring: angerboda , chimaera , ladon , orthrus , nemean lion , cerberus , lernean hydra , and the snakes of many colors . First appearance in issue #11 of the 1st volume of the fearless defenders comic book series .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Fearless Defenders Vol 1 #11</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Cullen Bunn</ex:wasCreatedByC>
    <ex:wasCreatedByC>William Sliney</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Encyclopedia_Cthulhiana">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Encyclopedia Cthulhiana</rdfs:label>
    <ex:hasAnnotation>Daniel Harms Cover Artist Allen Koszowski United States English (original) Japanese Chaosium Release Date November 1994 , later known as The Cthulhu Mythos Encyclopedia , is a reference book written by Daniel Harms , and first published by Chaosium in December 1994. Cover art was provided by Allen Koszowski . Several editions of the Encyclopedia have been released: the first, second, and expanded and revised second editions were all published by Chaosium (1994, 1998, 2003, respectively); the third edition by Arc Dream Publishing (2008, 2018); and the fourth by Elder Signs Press (2012). A Japanese- translation was also made available in 2007 . Table of Contents 3rd edition Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Daniel_Harms"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>Japanese</ex:isInLanguageW>
    <ex:wasReleasedOnW>November 1994</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Tree_on_the_Hill">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Tree on the Hill</rdfs:label>
    <ex:hasAnnotation>The battle that ended the century is a short story written by horror writer h.p. Lovecraft and duane w. rimel . It was written in 1934 and published in 1940 in the horror magazine polaris . The story's narrator is exploring an area called hell's acres, near the salmon river gorge in the blue mountain forest reserve .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Duane_W._Rimel"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Howard_Phillips_Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Cthulhu Mythos</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Star-Warrior">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Star-Warrior</rdfs:label>
    <ex:hasAffiliationC>Elder Gods</ex:hasAffiliationC>
    <ex:hasAnnotation>Star-warriors of orion are giant luminous beings which dwell among the stars of the orion belt and serve the elder gods . They have six flailing appendages described as "similar to arms, yet not arms", and ride through the sky mounted on limbless animals . The tube-like weapons they carry with them, supplied by their masters, fire destructive beams of energy that can harm even the great old ones .</ex:hasAnnotation>
    <ex:hasAppearanceC>Zanma Taisen Demonbane</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Lair_of_the_Star-Spawn"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Mark_Schorer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Adventures_of_Andrew_Doran:_Box_Set">
    <rdf:type rdf:resource="http://example.org/lovecraft#CrossroadPress"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Adventures of Andrew Doran: Box Set</rdfs:label>
    <ex:hasAnnotation>Matthew Davenport United States English Andrew Doran Davenport Writes LLC Release Date February 2015 is an omnibus collection of the Andrew Doran of Cthulhu Mythos stories by American Matthew Davenport . It was self-published through his Davenport Writes LLC label in February 2015; both paperback and digital copies were released. Contents "The Early Adventures of Andrew Doran" (2014) The Statement of Andrew Doran (2013) Andrew Doran at the Mountains of Madness (2018) Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Matthew_Davenport"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Andrew Doran</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>February 2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Aspirations_of_Ascension_%28Call_of_Cthulhu_LCG%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Aspirations of Ascension (Call of Cthulhu LCG)</rdfs:label>
    <ex:hasAnnotation>First released in 2010, it was discontinued in 2015 with the demise of call of cthulhu: the card game . Aspirations of ascension is divided into the standard format of three duplicate sets of 20 unique cards for a total of 60 . The cards contained divided between the existing factions .</ex:hasAnnotation>
    <ex:wasPublishedOnW>2010</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Doom_of_Enos_Harker">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Doom of Enos Harker</rdfs:label>
    <ex:hasAnnotation>" the strange doom of enosharker " is a short story based on a fragment by lin carter . It was completed by laurence cornford and published in 1997 . The story is narrated by paxton blaine, an anthropologist graduated from miskatonic university in 1931 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Laurence_J._Cornford"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Cthulhu Cultus #7</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1997</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Carl_Sanford">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Carl Sanford</rdfs:label>
    <ex:hasAffiliationC>The Silver Twilight Lodge</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Carl Sandford</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Sanford is a tall, slim man with an air of breeding about him . Holds a degree of influence in nearly every organisation in the city . Behind the mythos 's name is a nod to games designer sandy petersen .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Gateway_to_Carcosa">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Gateway to Carcosa</rdfs:label>
    <ex:hasAnnotation>A man with a desire to vindicate his dead fathers belief in the existence of carcosa travels to the aylesbury public library to consult their copy of the book . The madness which results from his reading the book causes him to kill himself, whereupon the gates to carcosa open and he is reunited with his father .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mark_McLaughlin"/>
    <ex:hasAuthorW>Michael Sheehan. Jr.</ex:hasAuthorW>
    <ex:hasGenreW>Fantasy</ex:hasGenreW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Abominations: 24 Tales of the Cthulhu Mythos</ex:isPublishedAsW>
    <ex:isPublishedAsW>Horrors</ex:isPublishedAsW>
    <ex:wasPublishedOnW>December 2018</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sfatlicllp">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Sfatlicllp</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Great Old One who mated with Voormis</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Fallen Wisdom</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Fallen Wisdom Great Old One who mated with Voormis Kythanil (likely) Current location N'kai (likely) Relatives Zvilpogghua (parent) Ossadagowah (possible uncle, if not just an alternative name for Zvilpogghua) Tsathoggua (grandparent) Knygathin Zhaum (offspring) Formless spawn (offspring) Great Old Ones First appearance CIRCLE : " The Family Tree of the Gods " Created by Clark Ashton Smith is the daughter of Zvilpogghua . She is the wife of a Voormi and their offspring is Knygathin Zhaum . was likely born on Kythanil and may have procreated the Formless spawn once on Earth and probably became their leader (or co-leader). She probably dwells in N'kai with Tsathoggua . Possibly she became the "wife" of Nyogtha , who dwells in Yoth .</ex:hasAnnotation>
    <ex:isLocatedAtC rdf:resource="http://example.org/lovecraft#Nkai"/>
    <ex:madeFirstAppearanceOnC>The Family Tree of the Gods</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nuja_of_Lomar">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Nuja of Lomar</rdfs:label>
    <ex:hasAnnotation>Nuja is a statuesque and beautiful warrior-woman hailing from the ancient land of lomar . Appears in several of american author jason scott aiken's sword-and-sorcery short stories . Appears to have been at least partially inspired by the robert e. howard character red sonja .</ex:hasAnnotation>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Jason_Scott_Aiken"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dark_Waters_of_Sin">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dark Waters of Sin</rdfs:label>
    <ex:hasAnnotation>A father in desperate financial straits strikes a bargain with an ancient entity lurking beneath the waves of keyport bay . The deal means that he will never again struggle to catch fish in those dark waters, but he and his daughter are changed to better serve the being . The story was first published in the revised and expanded edition of the collection keyport cthulhu in 2017 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Chuck_Buda"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Keyport_Cthulhu"/>
    <ex:wasPublishedOnW>2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Crusader_to_Protect">
    <rdf:type rdf:resource="http://example.org/lovecraft#Crossovers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Crusader to Protect</rdfs:label>
    <ex:hasAnnotation>Short story written by natsume akatsuki as part of his konosuba light novel series . Originally released as a booklet that came with a blu-ray disc for the anime adaptation in 2016 . Featured in the first volume of the yorimichi anthology series, published by kadokawa in 2020 .</ex:hasAnnotation>
    <ex:hasAuthorW>Natsume Akatsuki</ex:hasAuthorW>
    <ex:isInLanguageW>Japanese</ex:isInLanguageW>
    <ex:isPublishedAsW>KonoSuba BD 3</ex:isPublishedAsW>
    <ex:isPublishedAsW>KonoSuba: Yorimichi Volume 1</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2016 May 27</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Servant_of_Gloon">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Servant of Gloon</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Gloon"/>
    <ex:hasAnnotation>Sociocultural Characteristics Gloon Real World Information Created by Chaosium The Servants of Gloon are eldritch servants created by Chaosium for their Call of Cthulhu role-playing game. Description Despite tending to the every need of Gloon , these servants are said to more closely resemble Zoth-Ommog .</ex:hasAnnotation>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Chaosium"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Beyond_Wonderland">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Beyond Wonderland</rdfs:label>
    <ex:hasAnnotation>Raven Gregory David Leister English Zenescope Entertainment Release Date May 2008-April 2009 Media Type Comic book is a seven-issue comic book mini-series written by Raven Gregory in 2008-2009 which was published by Zenescope Entertainment. Synopsis Its been months since Calie Liddle returned from Wonderland , losing everything to the realm of madness. Living in New York City and trying to live a normal life, only to discover that Wonderland is not done with her.</ex:hasAnnotation>
    <ex:hasAuthorW>Raven Gregory</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>May 2008-April 2009</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Last_Moments_of_Lomar">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Last Moments of Lomar</rdfs:label>
    <ex:hasAnnotation>Norbert Gora English Rogue Planet Press Swords Against Cthulhu II: Hyperborean Nights date January 2017 " " is a short Cthulhu Mythos poem by Norbert Gora . It was published in Gavin Chappell 's Rogue Planet Press anthology Swords Against Cthulhu II: Hyperborean Nights in January 2017. Synopsis The 43 lines tell in brief how the savage Inutos descended on the ancient land of Lomar , burning its cities and killing its people.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Norbert_Gora"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Swords_Against_Cthulhu_II:_Hyperborean_Nights"/>
    <ex:wasPublishedOnW>January 2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Yoth</rdfs:label>
    <ex:hasAccessibilityL>Via K'n-yan</ex:hasAccessibilityL>
    <ex:hasAnnotation>Red-litten is a fictional subterranean world featured in the novella the mound . It is adjacent to blue-litten k'n-yan and black n'kai . It was formerly inhabited by a species of sapient quadrupedal reptiles .</ex:hasAnnotation>
    <ex:hasAppearanceL>The Whisperer in Darkness The Man of Stone</ex:hasAppearanceL>
    <ex:hasTypeL>Subterranean realm</ex:hasTypeL>
    <ex:isInhabitedByL>Unnamed species of reptile</ex:isInhabitedByL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Mound"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cth%C3%A4at_Aquadingen">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Cthäat Aquadingen</rdfs:label>
    <ex:hasAnnotation>The (trans. Things of the water) is a fictional grimoire created by british brian lumley . It is a combination of occult reference work and spell book . It has a focus on entities associated with water, and ubbo-satthla in particular .</ex:hasAnnotation>
    <ex:hasAppearanceA rdf:resource="http://example.org/lovecraft#Billys_Oak"/>
    <ex:hasAppearanceA>De Marigny's Clock</ex:hasAppearanceA>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_Cyprus_Shell"/>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Children_of_Arion">
    <rdf:type rdf:resource="http://example.org/lovecraft#Cults"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OrganisationsOriginatingFromMythosAdjacentWorks"/>
    <rdfs:label>Children of Arion</rdfs:label>
    <ex:hasAffiliationO>Secret Six Dark Giants</ex:hasAffiliationO>
    <ex:hasAnnotation>Secret six are a fictional organization in the dc universe whose first appearance was in 2016 in issue #8 of the 4th volume of the secret six comics series . They claim to be true atlanteans and recently manipulated the secret six a group of super-villains and sometimes heroes to help bring about the return of the dark giants .</ex:hasAnnotation>
    <ex:hasNotableMemberO>Uvian</ex:hasNotableMemberO>
    <ex:wasCreatedBynO>Gail Simone Dale Eaglesham</ex:wasCreatedBynO>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Miskatonic_University_-_Pride_of_the_Ivy_League">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Miskatonic University - Pride of the Ivy League</rdfs:label>
    <ex:hasAnnotation>Full story online here Franklyn Searight United States English Genre(s) Horror Nightscapes #16 date October 2006 " " is a Cthulhu Mythos poem by American Franklyn Searight . Overview The five verses offer a brief description of the Miskatonic University , checklists a number of occult volumes which may be found there, and offers a short rundown of "do's and dont's" for prospective students. History "Miskatonic University- Pride of the Ivy League" was published in issue #16 of the online Mythos zine Nightscapes in October 2006.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Franklyn_Searight"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Nightscapes #16</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2006</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecraft:_A_Biography">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraft: A Biography</rdfs:label>
    <ex:hasAnnotation>L. Sprague de Camp Cover Artist Nicholas Gaetano United States English Genre(s) Non-Fiction Doubleday Release Date February 1975 480 is, as it name would seem to suggest, a biography of the late American Howard Phillips Lovecraft . It was written by L. Sprague de Camp and first published by Doubleday in 1975. Although it was considered the most definitive work on the subject on its release, it has since been mostly superseded by the works of Lovecraft scholar S. T. Joshi . has been translated into several other languages, and has been extensively reissued, including in the digital medium.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#L._Sprague_de_Camp"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-Fiction</ex:hasGenreW>
    <ex:hasPageCountW>480</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>February 1975</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Queen_of_Diamonds">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Queen of Diamonds</rdfs:label>
    <ex:hasAlternativeNamesC>Adina</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as adina powers and abilities leadership swordsmanship ruler human first appeared in 2013 in issue #13 of 1st volume of wonderland . Created by patrick shand &amp; raven gregory .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Wonderland Vol 1 13</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Patrick Shand</ex:wasCreatedByC>
    <ex:wasCreatedByC>Raven Gregory</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sarah_Susan_Phillips_Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPeople"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Sarah Susan Phillips Lovecraft</rdfs:label>
    <ex:diedOnR>24 May 1921</ex:diedOnR>
    <ex:hasAnnotation>Birth Date 17 October 1857 Foster, Rhode Island, United States Death Date 24 May 1921 Providence, Rhode Island, United States United States Winfield Scott Lovecraft Howard Phillips Lovecraft (17 Oct 1857-24 May 1921) was the mother of Howard Phillips Lovecraft and the wife of Winfield Scott Lovecraft . Sarah was born on October 17, 1857, in Foster, Rhode Island , the second of five of Whipple Van Buren Phillips and Robie Alzada Place Phillips. She died May 24, 1921, in Providence , Rhode Island. She is buried in Providence's Swan Point Cemetery , along with Howard and Winfield. References</ex:hasAnnotation>
    <ex:hasBirthplaceR>United States http://example.org/lovecraft#Rhode_Island Foster</ex:hasBirthplaceR>
    <ex:hasChildrenR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:wasBornOnR>17 October 1857</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Invisible_Menace">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Invisible Menace</rdfs:label>
    <ex:hasAnnotation>A group of scientists are inspired by the film the war of the worlds to create a magnetic field generator capable of defending against intercontinental ballistic missiles . Activation opens a gateway to another dimension through which a colossal, invisible, insect-like creature emerges and begins laying waste to the historical city . Scientists devise a plan involving reversing the magnetism of the field, which sends the beast back home and closes the gateway to its dimension permanently .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>Science Fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>B.E.M.</ex:isPublishedAsW>
    <ex:wasPublishedOnW>April 2016</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Falona">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Falona</rdfs:label>
    <ex:hasAnnotation>A region of the dreamlands whose people are described as brave and adventurous . Created by h. p. lovecraft is a region of the dreamlands whose people are described as brave and adventurous, with yellow hair and blue eyes .</ex:hasAnnotation>
    <ex:hasTypeL>Country</ex:hasTypeL>
    <ex:isInhabitedByL>Humans</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Dreamlands"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Doom_That_Came_to_Sarnath"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ha%C3%AFta_the_Shepherd">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Haïta the Shepherd</rdfs:label>
    <ex:hasAnnotation>Short story by ambrose bierce first published in wave (san francisco) january 24, 1891 . Hata is a naive shepherd who prays at the shrine of hastur , god of shepherds .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ambrose_Bierce"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Fantasy short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Wave</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1891 January 24</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Norman_Withers">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
