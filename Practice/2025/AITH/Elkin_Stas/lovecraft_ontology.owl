  <rdf:Description rdf:about="http://example.org/lovecraft#David_Busboom">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>David Busboom</rdfs:label>
    <ex:hasAnnotation>Full Name David Bruce Busboom Connection to the Mythos Author Birth Date 9 December 1991 Urbana, Illinois, USA United States https://davidbusboom.com/ David Bruce Busboom is an American author, screenwriter, actor and film producer who has written a small number of works set in the expanded Cthulhu Mythos . These have been published in anthologies such as Swords Against Cthulhu ( Rogue Planet Press , 2015) and Whispers from the Abyss Vol. 2: The Horrors That Are &amp; Shall Be ( 01Publishing , 2015). Busboom counts authors related to the Mythos Laird Barron , Robert W. Chambers , William Hope Hodgson , Robert E. Howard , and Stephen King amongst his influences, as well as H. P. Lovecraft himself. Selected Works Short Fiction " The Vindication of Y'ha-Nthlei " (2015) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Illinois Urbana</ex:hasBirthplaceR>
    <ex:hasFullNameR>David Bruce Busboom</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://davidbusboom.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>9 December 1991</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dreaming_in_Rlyeh_Issue_2">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dreaming in R'lyeh Issue 2</rdfs:label>
    <ex:hasAnnotation>Dreaming in R'lyeh Issue Various English C. Brut Release Date January 2004 60 Preceded by Dreaming in R'lyeh Issue 1 Followed by Dreaming in R'lyeh Issue 3 was the second issue of short-lived Lovecraftian fanzine Dreaming in R'lyeh . Edited by C. Brut, it was independently published in January 2004. Contents "Trust Me" by Stanley Sargent "Feasters of the Dark" by William Jones "Lheen Khart Urr" C. Baron "Down Twelvemile Slough" by Lee Clark Zumpe "A Shared Romance" by David Conyers "Deep Dendo" C. Baron " Alhazred's Demise " by Lee Clark Zumpe</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>60</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>January 2004</ex:wasReleasedOnW>
  </rdf:Description>
