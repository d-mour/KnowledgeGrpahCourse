    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Against Religion</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft United States English Italian Sporting Gentlemen Release Date August 2010 190 : The Atheist Writings of H. P. Lovecraft is a non-fiction work compiled and annotated by Lovecraft scholar S. T. Joshi . It was first published in August 2010 by Sporting Gentlemen, and has since been translated into Italian, with the Italian edition also receiving an ebook release. Overview Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
