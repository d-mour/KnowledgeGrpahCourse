  <rdf:Description rdf:about="http://example.org/lovecraft#Rlyeh_Rising">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>R'lyeh Rising</rdfs:label>
    <ex:hasAnnotation>Various United States English Call of Cthulhu Fiction Chaosium Release Date December 2008 is an anthology of Lovecraftian fiction edited by William Jones and published by Chaosium as part of their Call of Cthulhu Fiction line in December 2008 . It is worth noting that due to lack of information on this book, it is entirely possible that this was a planned but unreleased collection. Overview References</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu Fiction</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>December 2008</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Michael_Griffin">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Michael Griffin</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author USA https://griffinwords.com/ is an American author who has written a number of Lovecraftian short stories, as well as at least one which takes place in Jeffrey Thomas 's dystopian future Punktown setting , a milieu with strong connections to the Cthulhu Mythos . These works have appeared in anthologies such as Autumn Cthulhu (2016, Lovecraft eZine Press ) , Walk on the Weird Side (2017, LASC Press) , Transmissions from Punktown (2018, Dark Regions Press ) , and The Leaves of a Necronomicon (2022, Chaosium ) . Selected Works Short Fiction "The Smoke Lodge" (2016) "Everyone Gathers at Haystack Rock" (2017) "Miles and Kathrine at the Crimson" (2022) External Links at the Internet Speculative Fiction Database at Goodreads References</ex:hasAnnotation>
    <ex:hasNationalityR>USA</ex:hasNationalityR>
    <ex:hasWebsiteR>https://griffinwords.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#It_Slumbers_Beneath_the_Ice">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>It Slumbers Beneath the Ice</rdfs:label>
    <ex:hasAnnotation>"it came from the seait lives in the woods" is a short cthulhu mythos story by troy young . It is the second story in his nyarlathotep cycle .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Troy_Young"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Nyarlathotep_Cycle"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Other:_Encounters_with_the_Cthulhu_Mythos_Book_1"/>
    <ex:wasPublishedOnW>2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#F_Lee_Baldwin">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>F Lee Baldwin</rdfs:label>
    <ex:diedOnR>1987</ex:diedOnR>
    <ex:hasAnnotation>Weird fiction fan who came into epistolary contact with Lovecraft in 1933. He wrote an early biography, “H.P. Lovecraft: A Biographical Sketch” (Fantasy Magazine, April 1935).</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1913</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Metrical_Regularity">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Metrical Regularity</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft English Genre(s) Non-fiction Donald M. Grant To Quebec and the Stars Date of writing July 1915 date 1976 " " is a short non-fiction work by the late American Howard Phillips Lovecraft . Although it was written in July 1915, it did not see until its inclusion in L. Sprague de Camp 's 1976 collection To Quebec and the Stars . History To Quebec and the Stars (1976) A Winter Wish and Other Poems (1977) Miscellaneous Writings (1995) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>To Quebec</ex:isPublishedAsW>
    <ex:isPublishedAsW>the Stars</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1976</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>July 1915</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_New_Annotated_H._P._Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The New Annotated H. P. Lovecraft</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft United States English Liveright Release Date October 13, 2014 928 is a collection of H. P. Lovecraft 's stories, edited and annotated by Leslie S. Klinger. It was published by Liveright in 2014 and was later followed by : Beyond Arkham in 2019. Overview Contents Introduction by Alan Moore Foreword Editor's Note The Stories " Dagon " " The Statement of Randolph Carter " " Nyarlathotep " " The Picture in the House " " Herbert West--Reanimator " " The Nameless City " " The Hound " " The Festival " " The Unnamable " " The Call of Cthulhu " " The Silver Key " The Case of Charles Dexter Ward " The Colour Out of Space " " The Dunwich Horror " " The Whisperer in Darkness " At the Mountains of Madness " The Shadow Over Innsmouth " " The Dreams in the Witch-House " " The Thing on the Doorstep " " The Shadow Out of Time " " The Haunter of the Dark " Additional Material Appendix 1: Chronological Table Appendix 2: Faculty of Miskatonic University Appendix 3: History of the Necronomicon Appendix 4: Genealogy of the Elder Races Appendix 5: The Works of H. P. Lovecraft Appendix 6: The "Revisions" of H. P. Lovecraft Appendix 7: H. P. Lovecraft in Popular Culture Bibliography Acknowledgments</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>928</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2014 October 13</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Spawn_of_Nyogtha">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Spawn of Nyogtha</rdfs:label>
    <ex:hasAlternativeNamesC>Blasphemous Children of the Dark</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The are produced by the blasphemous unions between ghouls , humans, and nyogtha . They are charismatic, strong, and tough creatures whom serve nyogtha and seduce others into its cult .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Ye_Booke_of_Monstres_II"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Scott_David_Aniolowski"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Hugo_Gernsback">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Publishers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Hugo Gernsback</rdfs:label>
    <ex:diedOnR>19 August 1967</ex:diedOnR>
    <ex:hasAnnotation>Born in luxembourg city, he later emigrated to the united states where he established his name in the burgeoning publishing industry . Referred to as "hugo the rat" by both h. p. lovecraft and clark ashton smith as a result of his tendency to pay authors both poorly and late .</ex:hasAnnotation>
    <ex:hasBirthplaceR>Luxembourg Luxembourg City</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Publisher</ex:isConnectedToMythosR>
    <ex:isKnownForR rdf:resource="http://example.org/lovecraft#Amazing_Stories"/>
    <ex:wasBornOnR>16 August 1884</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dave_Carson">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Dave Carson</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Artist Birth Date 1955 United Kingdom Horror British Fantasy Award - Best Artist (5 time winner) is a multi-award winning Irish artist and editor best known for his prolific contributions to a wealth of Cthulhu Mythos publications, including Chaosium 's Call of Cthulhu horror roleplaying game. Selected Works Editor H. P. Lovecraft's Book of Horror (1993) Artwork H. P. Lovecraft's Book of Horror (1993) In the Shadows (1995) The Ithaqua Cycle (1998) See Also Images by at The Internet Speculative Fiction Database</ex:hasAnnotation>
    <ex:hasNationalityR>United Kingdom</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Artist</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1955</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Angerboda">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Angerboda</rdfs:label>
    <ex:hasAffiliationC>Giants of Jotunheim</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Mother of Three Monsters</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>A giant in norse mythology, the mother of the most famous norse monsters . Made its first appearance in issue #360 of the 1st volume of thor . Created by walt simonson in 1985 .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Thor Vol 1 #360</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Walt Simonson</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Eihort">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Eihort</rdfs:label>
    <ex:hasAlternativeNamesC>God of the Labyrinth</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Pale Beast</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Created by british horror writer ramsey campbell for his short story " the franklyn paragraphs " whenever encounters a human, it makes a bargain with them. If the human declines, kills the human. If the human accepts, implants an undeveloped brood into their body. When the brood hatches it will kill the human host .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Before_the_Storm"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Franklyn_Paragraphs"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dan_OBannon">
    <rdf:type rdf:resource="http://example.org/lovecraft#ContentCreators"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Dan O'Bannon</rdfs:label>
    <ex:diedOnR>17 December 2009</ex:diedOnR>
    <ex:hasAnnotation>Daniel thomas "dan" o'bannon was an american writer, actor and filmmaker . He directed the 1991 film the resurrected , adapted from h.p. Lovecraft's novel . He also co-wrote the screenplay for the 1997 film hemoglobin .</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Missouri St. Louis</ex:hasBirthplaceR>
    <ex:hasFullNameR>Daniel Thomas O'Bannon</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Filmmaker</ex:isConnectedToMythosR>
    <ex:wasBornOnR>30 September 1936</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Unfathomable">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Unfathomable</rdfs:label>
    <ex:hasAnnotation>Horror mystery is a cthulhu mythos game for 3-6 players by fantasy flight games . Designed by tony fanchi and corey konieczka, it was released in 2021 . The game takes place aboard the steamer ss atlantica on a voyage to boston, massachusetts in 1913 .</ex:hasAnnotation>
    <ex:wasPublishedOnW>2021</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Exham_Priory_%28short_story%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Exham Priory (short story)</rdfs:label>
    <ex:hasAnnotation>"exham priory " is a short story by american robert m. price . It is a direct sequel to h.p. Lovecraft 's " the rats in the walls " . It was first published in crypt of cthulhu #72 in may 1990 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Crypt of Cthulhu #72</ex:isPublishedAsW>
    <ex:wasPublishedOnW>May 1990</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Operation_Antarctica">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Operation Antarctica</rdfs:label>
    <ex:hasAnnotation>132 is a novella by british william meikle . It is loosely connected to the cthulhu mythos .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasGenreW>Military Action</ex:hasGenreW>
    <ex:hasGenreW>fantasy</ex:hasGenreW>
    <ex:hasPageCountW>132</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>S-Squad</ex:isPartOfSeriesW>
