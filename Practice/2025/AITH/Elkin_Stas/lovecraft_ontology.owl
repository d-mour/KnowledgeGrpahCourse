    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Crime of the Century</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft English Genre(s) Non-fiction Donald M. Grant To Quebec and the Stars Date of writing April 1915 date 1976 " " is a short non-fiction work by the late American Howard Phillips Lovecraft . Although it was written in April 1915, it did not see until its inclusion in L. Sprague de Camp 's 1976 collection To Quebec and the Stars . History To Quebec and the Stars (1976) Howard Phillips Lovecraft 3 (1992, 2016) Miscellaneous Writings (1995) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>To Quebec</ex:isPublishedAsW>
    <ex:isPublishedAsW>the Stars</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1976</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>April 1915</ex:wasWrittenOnW>
