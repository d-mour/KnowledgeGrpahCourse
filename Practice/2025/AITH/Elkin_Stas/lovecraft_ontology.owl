  <rdf:Description rdf:about="http://example.org/lovecraft#Ruth_Tillman">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Ruth Tillman</rdfs:label>
    <ex:hasAnnotation>Full Name Ruth Kitchin Tillman Connection to the Mythos Games designer United States Horror roleplaying games https://ruthtillman.com/ Ruth Kitchin Tillman is an American games designer and librarian working at Penn State University. She is perhaps best known for her roleplaying game work, with her credits including both core game and supplementary material for Chaosium 's Call of Cthulhu , and Pelgrane Press 's Trail of Cthulhu , Cthulhu Confidential and The Yellow King . Selected Works Call of Cthulhu Harlem Unbound (2017) Trail of Cthulhu Hideous Creatures: A Bestiary of the Cthulhu Mythos (2018) Cthulhu Confidential Ex Astoria The Howling Fog Cthulhu Confidential (2017) Even Death Can Die (2023) The Yellow Sign Black Star Magic External Links at Goodreads References</ex:hasAnnotation>
    <ex:hasFullNameR>Ruth Kitchin Tillman</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://ruthtillman.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Games designer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Acolytes_of_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Acolytes of Cthulhu</rdfs:label>
    <ex:hasAnnotation>Robert M. Price , editor Cover Artist Gahan Wilson English Fedogan &amp; Bremer Release Date 2001  is a Cthulhu Mythos anthology edited by Robert M. Price , published by Fedogan &amp; Bremer in 2001. A reprint by Titan Books in 2014 omitted the story "Black Noon" by C. M. Eddy . Contents "Introduction", by Robert M. Price "Doom of the House of Duryea", by Earl Pierce, Jr. "The Seventh Incantation", by Joseph Payne Brennan " Black Noon ", by C. M. Eddy, Jr. "The Jewels of Charlotte", by Duane Rimel "The Letters of Cold Fire", by Manly Wade Wellman "Horror at Vecra", by Henry Hasse " Out of the Jar ", by Charles R. Tanner "The Earth-Brain", by Edmond Hamilton "Through the Alien Angle", by Elwin G. Powers "Legacy in Crystal", by James Causey " The Will of Claude Ashur ", by C. Hall Thompson "The Final War", by David H. Keller, M.D. "The Dunstable Horror", by Arthur Pendragon "The Crib of Hell", by Arthur Pendragon "The Last Work of Pietro of Apono", by Steffan B. Aletti "The Eye of Horus", by Steffan B. Aletti "The Cellar Room", by Steffan B. Aletti "Mythos", by John Glasby "There Are More Things", by Jorge Luis Borges "The Horror Out of Time", by Randall Garrett "The Recurring Doom", by S. T. Joshi "Necrotic Knowledge", by Dirk W. Mosig "Night Bus", by Donald R. Burleson "The Pewter Ring", by Peter Cannon "John Lehmann Alone", by David Kaufman "The Purple Death", by Gustav Meyrink, translated by Kathleen Houlihan &amp; Robert M. Price " Mists of Death ", by Richard F. &amp; Franklyn Searight " Shoggoth's Old Peculiar ", by Neil Gaiman Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
    <ex:hasAuthorW>editor</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2001</ex:wasReleasedOnW>
  </rdf:Description>
