    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dare</rdfs:label>
    <ex:hasAnnotation>Bret Kramer Kevin Ross English Call of Cthulhu Genre(s) Roleplaying games Sentinel Hill Press Release Date 2017 is a scenario supplement book for Chaosium 's Call of Cthulhu horror roleplaying game. Written by Bret Kramer and Kevin Ross , it was published by Sentinel Hill Press in 2017 . Overview References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Bret_Kramer"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Kevin_Ross"/>
    <ex:hasGenreW>Roleplaying games</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
