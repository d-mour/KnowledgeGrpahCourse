    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Selected Papers on Lovecraft</rdfs:label>
    <ex:hasAnnotation>S. T. Joshi Cover Artist Jason Eckhardt United States English Genre(s) Non-fiction Necronomicon Press Release Date June 1986 75 is a collection of non-fiction works by prominent H. P. Lovecraft scholar S. T. Joshi . Overview Containing five individual studies and running to a total of 75 , was published by Necronomicon Press in June 1986. Cover art was supplied by Jason Eckhardt . Contents Introduction by Steven J. Mariconda 's Note " Lovecraft's Alien Civilisations: A Political Interpretation " " The Structure of Lovecraft's Longer Narratives " " Lovecraft's Other Planets " " Lovecraft's Revisions: How Much of Them Did He Write? " " A Look at Lovecraft's Letters " Select Bibliography</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#S._T._Joshi"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:hasPageCountW>75</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>June 1986</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Creeper_in_the_Crypt">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Creeper in the Crypt</rdfs:label>
    <ex:hasAnnotation>Gangster from new york comes to arkham with a scheme to kidnap prominent families . He picks a local haunted house to use as a hideout--not realizing that in arkham, the ghosts are real . The story includes a considerable amount of lore about arkham .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_Bloch"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>July 1937</ex:wasPublishedOnW>
  </rdf:Description>
