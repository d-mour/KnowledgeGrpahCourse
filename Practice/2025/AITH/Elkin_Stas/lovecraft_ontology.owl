    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>hasPseudonymR</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu:_Xothic_Wars">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu: Xothic Wars</rdfs:label>
    <ex:hasAnnotation>Xothic wars is a sci-fi horror tactical miniature board game . The game is set over 250 million years ago, before man evolved on earth . The game is published by gobbotown games which also produces the miniatures .</ex:hasAnnotation>
    <ex:hasAuthorW>Jason Coffey</ex:hasAuthorW>
    <ex:hasAuthorW>Sandy Dobbs</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>Sci-Fi</ex:hasGenreW>
    <ex:hasGenreW>miniature wargaming</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Cthulhu: Xothic Games</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Chitin_Proctor">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Chitin Proctor</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Games editor Horror is a gaming supplement designer and editor working for British third-party content provider Stygian Fox . He has worked on a number of their publications, including satellite material for Chaosium 's Cthulhu Mythos roleplaying game Call of Cthulhu , and has had a hand in works from a variety of different time settings. Selected Works Gaming Supplements Autophagia (2019, editor) Aspirations (2019, contributor) The Dark Forest (2019) Whatever Happened to Alicia Thorne? (2020) Eyes Like Red Balls of Flame (2020, editor) The Wild Hunt (2021) Never Meet Again (2021) External Links at RPGGeek</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Games editor</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ibn_Schacabac">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Ibn Schacabac</rdfs:label>
    <ex:hasAlternativeNamesC>Ibn Schacabao</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Ibn schacabao is a fictional character mentioned in two stories by h.p. Lovecraft . There is some confusion about the correct spelling of the character's name . Behind the mythos means "son of schacabac" in classical arabic .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Case_of_Charles_Dexter_Ward"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Festival"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yaddith">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Planets"/>
    <rdfs:label>Yaddith</rdfs:label>
    <ex:hasAnnotation>A fictional planet created by the late american author howard phillips lovecraft . It is also inhabited by the burrowing dholes . The climax of the 2019 film color out of space features a vision of an alien planet overrun by huge worm-like creatures which may represent the dholes .</ex:hasAnnotation>
    <ex:hasAppearanceL>Through the Gates of the Silver Key The Diary of Alonzo Typer The Haunter of the Dark</ex:hasAppearanceL>
    <ex:hasTypeL>Planetary Body</ex:hasTypeL>
    <ex:isInhabitedByL>The Yaddithians (formerly) The Dholes</ex:isInhabitedByL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#Fungi_from_Yuggoth"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Voorm">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Voorm</rdfs:label>
    <ex:hasAnnotation>Voormis First appearance CIRCLE : " The Scroll of Morloc " Created by Lin Carter Clark Ashton Smith (posthumously) is the eponymous ancestor of the Voormi race who founded the Voormi civilization after the fall of the Serpent People . The Voormis believe that was the son of Tsathoggua and Shathak ( EXP : " The Scroll of Morloc "). If true, this would make him a brother of Zvilpogghua .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Scroll_of_Morloc"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mark_Morrison">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Mark Morrison</rdfs:label>
    <ex:hasAnnotation>As of november 2022 he was also a chaosium employee, focused on the companions of arthur community content program for the pendragon role-playing game . Morrison's first-ever credit for the call of cthulhu role-playing game was the scenario "the land of lost dreams" since then he has written and edited an array of scenarios and books for the game, including co-writing the first edition of terror australis .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cult_of_the_Dead_and_Other_Weird_and_Lovecraftian_Tales">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cult of the Dead and Other Weird and Lovecraftian Tales</rdfs:label>
    <ex:hasAnnotation>Lois H. Gresh Cover Artist Robert H. Knox English Hippocampus Press Release Date 2015 240  is a collection of the works of and editor Lois H. Gresh . Including an introduction by Lovecraft scholar S. T. Joshi , it was published by Hippocampus Press in 2015. Overview Contents Introduction by S. T. Joshi "Cult of the Dead" (2015) " Devil's Bathtub " (2014) " Dreams of Death " (2013) " Necrotic Cove " (2014) "Old Enough to Drink" (2014) "Death Doll" (2015) "Willie the Protector" (2014) "Wee Sweet Girlies" (2011) "Debutante Ball" (2011) "Let Me Make You Suffer" (1995) " Where I Go, Mi-Go " (1997) "The Lagoon of Insane Plants" (2011) "Soleman" (2011) "Snip My Suckers" (1995) "Psychomildew Love" (1995) "Digital Pistil" (1994) "Algorithms and Nasal Structures" (1998) "Little Whorehouse of Horrors" (1998) " Showdown at Red Hook " (2011) " Mandelbrot Moldrot " (1996) External Link Publication: at Internet Speculative Fiction Database</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lois_H._Gresh"/>
    <ex:hasPageCountW>240</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Hanwell_Asylum">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Hanwell Asylum</rdfs:label>
    <ex:hasAnnotation>Hanwell was the first pauper lunatic asylum for the county of middlesex . It opened in june 1831, originally to take 500 patients . In time the system was somewhat abused and patient labour was used . In 1980 it was absorbed into ealing hospital and is now known as hanwell .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Gwarloth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Gwarloth</rdfs:label>
    <ex:hasAnnotation>Great Old Ones is a tentacled amoebic horror with multiple eyes, orifices, and a dangling gland forming a hideous face. Its appearance is based on the logo of the metal music group of the same name. It is a Great Old One not yet used in any works of fiction and only exists as a Mythos -adjacent piece of artwork.</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cults">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Character"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Organisation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#ExtraDimensionalCharacters">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Character"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#St._John">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>St. John</rdfs:label>
    <ex:hasAnnotation>Created by h. p. lovecraft was a fictional character who appeared in his 1924 short horror story " the hound ". Whether was his first or last name, or simply an affectation, is never revealed .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Hound</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tim_Lebbon">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Tim Lebbon</rdfs:label>
    <ex:hasAnnotation>Tim lebbon is a prolific author whose work focuses on horror, science fiction and fantasy genres . He has won several awards for his fiction, including the bram stoker award for short fiction and the august derleth award . Many of his works are franchise tie-in pieces; he has written for properties including the x-files, aliens, firefly , hellboy , predator , star wars , king kong, and 30 days of night</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#England London</ex:hasBirthplaceR>
    <ex:hasNationalityR>United Kingdom</ex:hasNationalityR>
    <ex:hasWebsiteR>https://www.timlebbon.net/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>28 July 1969</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yokai">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SpeciesIncorporatedFromFolkloreMythAndReligion"/>
    <rdfs:label>Yokai</rdfs:label>
    <ex:hasAlternativeNamesC>Children of Azathoth</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The are part of japanese folklore. In 2005 they were first used as a fictional species by chaosium for the call of cthulhu rpg . They are the manifestations of chaos incarnate. When the fabric of space-time is ripped or rended, tendrils of azathoth seep through .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Secrets_of_Japan"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Zaratan">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonSapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SpeciesIncorporatedFromFolkloreMythAndReligion"/>
    <rdfs:label>Zaratan</rdfs:label>
    <ex:hasAnnotation>The are a fictional species which has its origins in the folklore and mythology of islam . Chaosium incorporated the into its call of cthulhu roleplaying game in the cthulhu invictus setting .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Cthulhu_Invictus"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Haemovore">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Haemovore</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Fenric"/>
    <ex:hasAnnotation>The haemovores are a species created by the bbc in 1989 for doctor who . They are servants of fenric , a cosmic entity who would later be identified as one of the great old ones , specifically hastur . They are a possible future evolution of mankind, half a million years into the future .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Curse of Fenric</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Ian Briggs</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Space-devil">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Space-devil</rdfs:label>
    <ex:hasAnnotation>The space-devils are a fictional alien species mentioned by h. p. lovecraft in the novella the mound . The k'n-yanians claim that the space-devils are "hostile alike to men and to men's gods", and blame them for the great sinking . The space-devils returned to earth and caused most of the world's landmass to sink, with the only human survivors being their own agents .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Mound"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Newt_Bardhoff">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Newt Bardhoff</rdfs:label>
    <ex:hasAffiliationC>Innsport Police Department</ex:hasAffiliationC>
    <ex:hasAnnotation>Lieutenant is a character created by american author brandon berntson . Made his debut appearance in 2018's the night of dagon . Married to a shy bookstore owner named amelia .</ex:hasAnnotation>
    <ex:hasCharacterMateC>Amelia</ex:hasCharacterMateC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Night_of_Dagon"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Brandon_Berntson"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#AlterEgosCharactersIncorporatedFromTheRealWorld">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cool_Air">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cool Air</rdfs:label>
    <ex:hasAnnotation>"the call of cthulhu" is a short story by the american horror fiction writer . It is set up as the narrator's explanation for why a "draught of " causes him more discomfort than one would expect . The tale opens up in the spring of 1923 with the narrator looking for housing in new york city . He eventually settlings in a converted brownstone on west fourteenth street .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Short Fiction Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Shadow_from_the_Steeple">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Shadow from the Steeple</rdfs:label>
    <ex:hasAnnotation>Wtis a short story by robert bloch that first appeared in the september 1950 issue of weird tales . It is the third and final story in a trilogy by bloch and h. p. lovecraft . The plot follows edmund fiske, a friend of robert blake 's, who spends years searching for ambrose dexter .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lexuriga-serrroth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Lexur'iga-serr'roth</rdfs:label>
    <ex:hasAlternativeNamesC>He Who Devours All in the Dark</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as He Who Devours All in the Dark First appearance EXP : " The Brown Tower " Created by John Prescott is a photophobic bat-winged monstrosity with both a thousand-eyed misshapen head and a huge maw.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Brown Tower</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>John Prescott</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Necronomicon/Variants">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Necronomicon/Variants</rdfs:label>
    <ex:hasAnnotation>The fictional necronomicon has been translated and transcribed many times, giving rise to a number of distinct editions . This page aims to give a guide to these editions . The last known copy of the book was lost in a library fire in salem in 1692 .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Donald_A._Wollheim">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonFictionAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Donald A. Wollheim</rdfs:label>
    <ex:diedOnR>2 November 1990</ex:diedOnR>
    <ex:hasAnnotation>Full Name Donald Allen Wollheim Connection to the Mythos Author Publisher Birth Date 1 October 1914 New York City , New York , USA Death Date 2 November 1990 New York City , New York , USA United States Donald Allen Wollheim (1 October 1914-2 November 1990 ) was an American author, editor, publisher, and early promoter of the concept which would (much later) come to be known as "fandom." He wrote a number of works which intersect with the purview of this wiki, including a hoax review of a non-existent translation of the fabled Necronomicon , and a real-world eulogy for H. P. Lovecraft himself, published only two months after the author's death , as well as being responsible for the first professional printings of some of Lovecraft's works, including " The Nameless City " ( Fanciful Tales , Fall 1936). American novelist F. Paul Wilson , who has cited Lovecraft as one of his major influences, cites Wollheim as the catalyst for his fascination with Lovecraftian horror . Selected Works Non-Fiction " Howard Phillips Lovecraft " (1937) External Links at Wikipedia at the Internet Speculative Fiction Database at Goodreads References</ex:hasAnnotation>
    <ex:hasBirthplaceR>New York USA http://example.org/lovecraft#New_York_City</ex:hasBirthplaceR>
    <ex:hasFullNameR>Donald Allen Wollheim</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Publisher</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1 October 1914</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Arthur_Goodenough">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Arthur Goodenough</rdfs:label>
    <ex:diedOnR>1936</ex:diedOnR>
    <ex:hasAnnotation>Amateur poet who resided in Brattleboro, Vermont. Lovecraft visited him there on several occasions.</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1871</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Space-Eaters">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Space-Eaters</rdfs:label>
    <ex:hasAnnotation>The story was originally published in the july 1928 issue of weird tales . It was reprinted in long's collection the hounds of tindalos (1946) and in august derleth's seminal anthology tales of the cthulhu mythos (1969) its narrator, frank, appears to be the same character from " the hounds of tindalos ", as both stories are set in the fictional town of</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Frank_Belknap_Long"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>July 1928</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lord_of_Tindalos">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Lord of Tindalos</rdfs:label>
    <ex:hasAnnotation>Lords of tindalos are a fictional race created by chaosium in 1995 for the call of cthulhu roleplaying game . They are transcendental creatures which are perceived by humans as having wolflike shapes consisting of sharp angular pieces . They have been in conflict with yog-sothoth from the beginning of time, as the lords of tindalos represent angular time .</ex:hasAnnotation>
    <ex:hasAppearanceC>Call of Cthulhu</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC>Gateway to Forever</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Frank_Belknap_Long"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Richard_Launius">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Richard Launius</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Games designer Traditional games is a prolific independent games designer with dozens of titles to his credit in a wide range of genres. These include Cthulhu Mythos titles such as the first and second editions of Arkham Horror , Elder Sign , and Cthulhu's Vault , as well as contributions to the Call of Cthulhu horror roleplaying game. He has collaborated with Kevin Wilson on several of these projects . In other media, Launius was also the designer of the uniform worn by the Chicago White Sox from 1982 to 1986 . Selected Works Board Games Arkham Horror first edition (1987) Arkham Horror second edition (2005) Dunwich Horror (2006) Kingsport Horror Innsmouth Horror Card Games Elder Sign (2011) Cthulhu's Vault (2015) Roleplaying Games H. P. Lovecraft's Dreamlands (1986, contributor) External Links publication history at BoardGameGeek References</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Games designer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#SapientSpecies">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Character"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Pyramid_of_the_Black_Pharaoh">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Pyramid of the Black Pharaoh</rdfs:label>
    <ex:hasAnnotation>The druid of castle rock is the third story in book 2 of the nyarlathotep cycle by canadian author troy young . Investigator malcolm mayweather is seconded to an international team comprised of agents from counterpart organisations . The story concludes with a former agent whose consciousness has been stripped from her body, beginning to rebuild her mind in the face of cosmic horror .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Troy_Young"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Nyarlathotep_Cycle"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Other:_Encounters_with_the_Cthulhu_Mythos_Book_2"/>
    <ex:wasPublishedOnW>2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Spawn_of_Dagon_%28species%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Spawn of Dagon (species)</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Dagon"/>
    <ex:hasAlternativeNamesC>The Children of Dagon</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The spawn of dagon, also known as the children of dagon, are an ancient species which first featured in the short story of the same name . They were said to have control over earthquakes, but proved to be vulnerable to the light emitted by the wizard zend's red sphere .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Spawn of Dagon</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Henry_Kuttner"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bruce_Sterling">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Bruce Sterling</rdfs:label>
    <ex:hasAnnotation>Michael (born 1954) is an American science fiction author particularly associated with the cyberpunk movement. His work notably includes the Shaper/Mechanist universe and the 1988 novel Islands in the Net . Sterling's 1991 short story " The Unthinkable " is set in an alternative world where humans have employed fantastic and paranormal creatures, including those of the Cthulhu Mythos , for military purposes.</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#New_England">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>New England</rdfs:label>
    <ex:hasAnnotation>Northeastern united states geographical region is the semi-imaginary setting of many cthulhu mythos tales . Ancestral home of algonquin indians like the narragansetts and the wampanoag, was one of the first areas in north america to be colonized by english settlers . Lovecraft would sometimes suggest that was particularly conducive to evoking the feeling of horror that his fiction specialized in .</ex:hasAnnotation>
    <ex:hasTypeL>Geographical region</ex:hasTypeL>
    <ex:isLocatedAtL>Northeastern United States</ex:isLocatedAtL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#H._P._Lovecrafts_The_Shadow_Out_of_Time">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>H. P. Lovecraft's The Shadow Out of Time</rdfs:label>
    <ex:hasAnnotation>Gou Tanabe Gou Tanabe Japanese Kadokawa Corporation Release Date 2015 Media Type Manga is a manga written and illustrated by Gou Tanabe which was published by Kadokawa Corporation in 2018. It is an adaptation of The Shadow Out of Time by Howard Phillips Lovecraft . The manga is yet to be translated into an English- version.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Gou_Tanabe"/>
    <ex:isInLanguageW>Japanese</ex:isInLanguageW>
    <ex:wasReleasedOnW>2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Hooded_Harbinger">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Hooded Harbinger</rdfs:label>
    <ex:hasAnnotation>Hooded harbingers are a fictional race created by paizo in 2016 for the pathfinder roleplaying game . They are clad in a tattered yellow hood and rags and resemble humanoid mummies . They possess several abilities including teleportation, plane shift, and bloodless touch .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Whisper Out of Time</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Ed Grabianowski</ex:wasCreatedByC>
    <ex:wasCreatedByC>Greg A. Vaughan</ex:wasCreatedByC>
    <ex:wasCreatedByC>James Jacob</ex:wasCreatedByC>
    <ex:wasCreatedByC>Richard Pett</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crypt_of_Cthulhu_Roodmas_1986">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crypt of Cthulhu Roodmas 1986</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Peter H. Gilmore United States English Crypt of Cthulhu Cryptic Publications Release Date May 1986 64 Preceded by Eastertide 1986 Followed by St. John's Eve 1986 is the 39th issue of long-running fanzine Crypt of Cthulhu . Running to a total of 64 , it was edited by Robert M. Price , featured cover art by Peter H. Gilmore, interior art by Lance Brown, Robert H. Knox, and Jervas Dudley (likely a pseudonym), and was published in an A5 format by Cryptic Publications in May 1986 . Contents Editorial Shards by Robert M. Price "The Madness Out of Time" by Lin Carter "Offspring" by Carl Jacobi "The Voice of Doom" by Robert E. Howard "Embrace of Clay, Embrace of Straw" by Steve Rasnic Tem "Manly Wade Wellman" by uncredited "And When We Sleep" by Hugh B. Cave "In the Tomb of Semenses" by Frank Belknap Long "Wilfred Blanch Talman" by Gerry de la Ree Review by uncredited Letters by Roger G. Knuth, Henry J. Vester, III , Wilum Pugmire , Rah Hoffman, Fritz Leiber , Kevin Walsh, Jeff Lefstin, Carl Budka, William Fulwiler, Robert M. Price, and Robert Bloch References</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>64</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu"/>
    <ex:wasReleasedOnW>May 1986</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Chaos">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Chaos</rdfs:label>
    <ex:hasAnnotation>The mad god is a fictional demonic god in the fictional universe of the vampirella comic book series by warren publishing, harris comics, and now dynamicmite entertainment . Its armies were scattered and its seven demonic servants were banished to the nether-void, imprisoned within that dimension . Only powerful supernatural beings like vampirella or dracula are able to see its face without dying .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Spawn_of_the_Sleeper_%28Call_of_Cthulhu_LCG%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Spawn of the Sleeper (Call of Cthulhu LCG)</rdfs:label>
    <ex:hasAnnotation>The Spawn of the Sleeper Fantasy Flight Games Publication Date 2008 Living Card Game Call of Cthulhu: The Card Game The Spawn of the Sleeper is an expansion pack for Fantasy Flight Games ' Call of Cthulhu: The Card Game . Overview The first Asylum Pack in the Summons of the Deep Cycle , The Spawn of the Sleeper contains 20 unique cards in sets of three and focuses on expanding the Terror Struggle sub-phase of the Story Phase . First issued in 2008, it was discontinued with the demise of Call of Cthulhu: The Card Game in 2015. Contents Government Exorcist (Character; The Agency) Interrogation Center (Support; The Agency) Dr. Carson, Fringe Psychologist (Character; Miskatonic University ) Rabbit's Foot (Support; Miskatonic University) Sleeping Pills (Support; Miskatonic University) Trent Dixon, Workaholic (Character; Syndicate) Underground Asylum (Support; Syndicate) Emerging Deep One (Character; Cthulhu ) Called by Azathoth (Support; Cthulhu) Erich Zann , Strange Virtuoso (Character; Hastur ) Spawn of the Sleeper (Event; Hastur) Terrifying Visage (Support; Hastur) Bloodthirsty Zealot (Character; Yog-Sothoth ) Touched with Madness (Event; Yog-Sothoth) Grim Wraith (Character; Shub-Niggurath ) The Black Goat's Rage (Event; Shub-Niggurath) Julia Brown, Insomniac (Character; Neutral) Those Without Faces (Character; Neutral) Sleepless Nights (Event; Neutral) The Underwater Conspiracy (Conspiracy; Neutral)</ex:hasAnnotation>
    <ex:wasPublishedOnW>2008</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Matthew_Davenport">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Matthew Davenport</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Editor United States https://authormatthewdavenport.wordpress.com/ is an American author, editor, and former archaeologist who has worked on several publications and stories related to the greater Cthulhu Mythos , the majority of which has been published through Crossroad Press . His editorial credits include the anthologies Tales of the Al-Azif and Eldritch Prisoners , his novels include the Andrew Doran series, and his short fiction has been included in anthologies such as Tales of Yog-Sothoth , The Book of Yig , and Tales of Nyarlathotep . Selected Bibliography Editor Tales of the Al-Azif (2019, with C. T. Phipps ) Eldritch Prisoners (2023, with David Conyers , John A. DeLaughter, and David Hambling ) Author The Adventures of Andrew Doran: Box Set (2015) Andrew Doran Omnibus: Volume 1 (2021) The Trials of Obed Marsh (2012) The Statement of Andrew Doran (2013, Andrew Doran ) Andrew Doran at the Mountains of Madness (2018, Andrew Doran) Andrew Doran and the Scroll of Nightmares (2021, Andrew Doran) Miskatonic University: Elder Gods 101 (2022) "The Early Adventures of Andrew Doran" (2014, Andrew Doran) "Andrew Doran and the Obsidian Key" (2018, Andrew Doran) "Time Trapped" (2020) "A Stitch in Time" (with Byron Craft , John DeLaughter, and David Hambling) "The Forever Gate" (2021, Andrew Doran) "Andrew Doran and the Journey to the Serpent Temple" (2021, Andrew Doran) "Andrew Doran and the Obsidian Key" (2023, Andrew Doran) "Andrew Doran and the Crawling Caves" (2023, Andrew Doran) "The Prisoner from Beyond" (2023) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://authormatthewdavenport.wordpress.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cellar_Dweller">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cellar Dweller</rdfs:label>
    <ex:hasAnnotation>Franklyn searight's short story historywas published in the doug draa -edited anthology weirdbook annual 2 in 2019 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Franklyn_Searight"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Weirdbook Annual 2</ex:isPublishedAsW>
    <ex:wasPublishedOnW>February 2019</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Magenta_Nero">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Magenta Nero</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Weird fiction  is an author and poet who has written a handful of works inspired by Howard Phillips Lovecraft and the Cthulhu Mythos . These have been published in collections such as James Ward Kirk Publishing's 2015 thematic anthology Lovecraft after Dark . Selected Works Short Fiction " Medusa's Harem " (2015) Poetry " The Garden " (2015) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#On_the_Reef">
    <rdf:type rdf:resource="http://example.org/lovecraft#CaitlinRKiernanWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>On the Reef</rdfs:label>
    <ex:hasAnnotation>Caitlin R. Kiernan English Sirenia Digest date October 2010 "" is a short story by Caitlin R. Kiernan that originally appeared in the October 2010 issue of Sirenia Digest (#59). It describes a ceremony conducted by a cult on Innsmouth 's Devil's Reef , examining the motivations of volunteers for human sacrifice. The story refers explicitly to the events of H. P. Lovecraft 's The Shadow Over Innsmouth . History The story was republished in the anthologies Halloween (Prime Books, 2011) and Weirder Shadows Over Innsmouth ( Fedogan &amp; Bremer , 2013). It was also included in Kiernan's collection Houses Under the Sea: Mythos Tales ( Subterranean Press , 2019).</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Sirenia_Digest"/>
    <ex:wasPublishedOnW>October 2010</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Jonathan_L._Howard">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Jonathan L. Howard</rdfs:label>
    <ex:hasAnnotation>Jonathan l. howard is best known for his series of books featuring johannes cabal the necromancer . He is the author of carter &amp; lovecraft (2015) and its sequel, after the end of the world (2017) . The rights to the characters are owned by macmillan .</ex:hasAnnotation>
    <ex:hasNationalityR>United Kingdom</ex:hasNationalityR>
    <ex:hasWebsiteR>http://www.jonathanlhoward.com/index.html</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Beyond_the_Dunwich_Horror">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosFilmAndTelevision"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Beyond the Dunwich Horror</rdfs:label>
    <ex:hasAnnotation>$75,000 is a low- horror movie which uses " the dunwich horror " as a historical background story for this new tale . Although it takes place in the present day, it contains many nods to the works of h. p. lovecraft . It was released in the united states on 23 may 2008 .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>23 May 2008</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Clark_Ulman">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Clark Ulman</rdfs:label>
    <ex:hasAnnotation>Ulman is an american archaeologist who ventured into the remote and inhospitable plateau of tsang in central asia . He brought back what was originally believed to be a statue of chaugnar faugn, but was actually the ancient god itself . Contact with the eldritch deity resulted in a physical change in ulman, whose nose and ears grew abnormally long and flabby .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Horror_from_the_Hills"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Frank_Belknap_Long"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Toth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Toth</rdfs:label>
    <ex:hasAnnotation>First appearance EXP : " Usurped " Created by William Browning Spencer is a colossal burrowing arthropodal horror which appeared in William Browning Spencer 's short story " Usurped ". is served by humans, such as the one in the story in which it appears, which can send insectoid creatures, the size of normal insects, to sting or bite victims. Once bitten by one of 's insecfoit servants, a person is slowly possessed by its evil alien intelligence.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Usurped</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#William_Browning_Spencer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bruce_Ballon">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Bruce Ballon</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Games Designer Horror Dr. is a games designer perhaps best known for his work on Chaosium 's Call of Cthulhu roleplaying game. He is also a fully-qualified psychiatrist who uses the gaming medium to raise awareness of mental health issues. Selected Bibliography Unseen Masters (2001)</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Games Designer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Cultus_Issue_8">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Cultus Issue 8</rdfs:label>
    <ex:hasAnnotation>Cthulhu Cultus #8 Various Cover Artist Tani Jantsang United States English P. Marsh Release Date March 1997 62 Preceded by Cthulhu Cultus #7 Followed by Cthulhu Cultus #9 Cthulhu Cultus #8 is an issue of sporadic American fanzine Cthulhu Cultus , edited by Tani Jantsang and James Ambuehl and published by P. Marsh in March 1997. Contents " Finding God(s) " by James Ambuehl "Men in Black" by James Ambuehl "The Last Laugh" by Ron Shiflet "St. Toad Pays a Call" by Peter A. Worthy " The Dig " by Sean Rodgers " The Tower of Madness " by James Ambuehl "Birth of a Warrior" by Mik Clarke "The Lake of Stars" by Boyd E. Pearson "The Last Spell of Malygris" by Boyd E. Pearson " Cthulhu Lies Dreaming " by Ron Shiflet " Forbidden Knowledge " by Ron Shiflet " Ghouls " by Ron Shiflet "The Man in the Bookstore" by Lee C. Zumpe "Nocturnal Emission" by Chad Hensley "The Court of the Crystal Flame" by James Ambuehl "Satampra Zeiros" by Boyd E. Pearson " People of the Monolith " (Part 2 of 7) by Crispin Burnham "News Flash!!!" uncredited</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>62</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>March 1997</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Gothic_Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Gothic Lovecraft</rdfs:label>
    <ex:hasAnnotation>Various Jason V. Brock Cover Artist Jason V. Brock English Cycatrix Press Release Date November 2016 265 is an anthology of Lovecraftian fiction edited by Lynne Jamneck and S. T. Joshi . It was published by Cycatrix Press in November 2016 in two editions: a hardcover limited to 300 copies, and a signed hardcover limited to only 52 copies. It runs to a total of 265 , and features artwork by Jason V. Brock. Contents Introduction by Lynne Jamneck and S. T. Joshi "The Shadow Over Lear" by Donald R. Burleson "The Revelation at the Abbey" by Don Webb "Old Goodman Brown" by Jonathan Thomas "Square of the Inquisition" by Lois H. Gresh "The Rime of the Cosmic Mariner" by John Shirley "A Yuletide Carol" by Mollie L. Burleson "Curse of the House of Usher" by Donald Tyson "The Rolling of Old Thunder" by Mark Howard Jones "Always a Castle?" by Nancy Kilpatrick "As Red As Red" by Caitlín R. Kiernan "Four Arches" by Robert S. Wilson "The Old Schoolhouse" by Gwyneth Jones "Dream House" by Orrin Grey "The Unknown Chambers" by Lynda E. Rucker</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>265</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>November 2016</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#LovecraftCircleFilmAndTelevisionAdaptations">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Work"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tomorrows_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Tomorrow's Cthulhu</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Jeremy Zerfoss English Broken Eye Books Release Date January 2016 318 : Stories at the Dawn of Posthumanity is an anthology of Lovecraftian fiction edited by C. Dombrowski and Scott Gable . Published in January 2016 by Broken Eye Books , paperback, hardcover and digital editions were all released. Overview Contents "Tangles" by Daria Patrie "The Stricken" by Molly Tanzer "Beige Walls" by Joshua L. Hood "The Five Hundred Days of Ms. Between" by Joshua Alan Doetsch "68 Days" by Kaaron Warren " Tekeli-li, They Cry " by A. C. Wise "The Sky Isn't Blue" by Clinton J. Boomer "A Pathway for the Broken" by Damien Angelica Walters "The Crunch Underfoot" by Lizz-Ayn Shaarawi "The Lark Ascending" by Samantha Henderson "Astral and Arcane Science" by S. J. Leary "Advanced Placement" by Richard Lee Byers "Friday Night Dance Party" by Thomas M. Reid "Boots on the Ground" by Jeff C. Carter "Innsmouth Redemption" by Joette Rozanski "Church of the Renewed Covenant" by Shannon Fay "The Posthumous Recruitment of Timothy Horne" by Pete Rawlik "Curiosity" by Adam Heine "Perfect Toy for a Nine Year Old" by Bruce R. Cordell "The Steel Plague • short story by Nate Southard "Between Angels and Insects" by Simon Bestwick "The Judas Goat" by Robert Brockway "Madness on the Black Planet" by Darrell Schweitzer "Drift from the Windrows" by Mike Allen "Chunked" by Matt Maxwell "Testimony XVI" by Lynda E. Rucker "The World Ends in Neon Yellow" by LA Knight "Nimrod's Tongue" by Cody Goodfellow "The Great Dying of the Holocene" by Desirina Boskovich</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>318</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>January 2016</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhus_Reign">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu's Reign</rdfs:label>
    <ex:hasAnnotation>Various English DAW Books April 2010 is a Cthulhu Mythos anthology edited by Darrell Schweitzer , focused on "the return of Cthulhu and the Old Ones to Earth ." It was published by DAW Books in 2010. Contents "Introduction" (essay) by Darrell Schweitzer "The Walker in the Cemetery" by Ian Watson "Sanctuary" by Don Webb "Her Acres of Pastoral Playground" by Mike Allen "Spherical Trigonometry" by Ken Asamatsu "What Brings the Void" by Will Murray "The New Pauline Corpus" by Matt Cardin "Ghost Dancing" by Darrell Schweitzer " This Is How the World Ends " by John R. Fultz "The Shallows" by John Langan "Such Bright and Risen Madness in Our Names" by Jay Lake "The Seals of New R'lyeh" by Gregory Frost "The Holocaust of Ecstasy" by Brian Stableford "Vastation" by Laird Barron "Nothing Personal" by Richard A. Lupoff "Remnants" by Fred Chappell</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>April 2010</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#David_Gerrold">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>David Gerrold</rdfs:label>
    <ex:hasAnnotation>born 1944 in Chicago, Illinois) is an American science fiction author whose work includes the War Against the Chtorr and Star Wolf series, as well as several other novels and short stories. He is also known for writing numerous scripts for television, including episodes of Star Trek , Land of the Lost , and Babylon 5 . Gerrold wrote two episodes of the animated series The Real Ghostbusters , one of which, " The Hole in the Wall Gang ", takes place in the town of Arkham , Massachusetts. It was one of three episodes of the show to incorporate elements of the Cthulhu Mythos , along with Michael Reaves ' " The Collect Call of Cathulhu " and J. Michael Straczynski 's " Russian About ". External Links at the Internet Speculative Fiction Database at the Internet Movie Database</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dark_Heritage">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleFilmAndTelevisionAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dark Heritage</rdfs:label>
    <ex:hasAnnotation>Based on " The Lurking Fear David McCormick Release date 1989 Running time 94 minutes United States English , also known as : The Final Descendant , is a 1989 low-budget horror film from David McCormick. It is an uncredited adaptation of the H. P. Lovecraft short story " The Lurking Fear ". Synopsis A reporter investigating an incident involving several mutilated bodies uncovers a degenerate clan of cannibals in the Louisiana backwoods.</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Lurking_Fear"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1989</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ash_and_the_Army_of_Darkness">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Ash and the Army of Darkness</rdfs:label>
    <ex:hasAnnotation>Steve Niles Dennis Calero English Dynamite Entertainment Release Date Oct 2013 - June 2014 Media Type Comic book is 8-issue comic book series (plus one annual) that was written by Steve Niles. Part of American film director Sam Raimi 's Evil Dead franchise, it was published in 2013-2014 by Dynamite Entertainment. Synopsis Ash and his entire S-Mart store gets sent to 1300 AD. Where he is forced to fight a Deadite Wise Man, only for Sheila to become possessed again and threaten the world with her own Army of Darkness.</ex:hasAnnotation>
    <ex:hasAuthorW>Steve Niles</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>Oct 2013 - June 2014</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#C_L_Moore">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>C L Moore</rdfs:label>
    <ex:diedOnR>1987</ex:diedOnR>
    <ex:hasAnnotation>Late associate of Lovecraft who later married Henry Kuttner and became a leading figure in science fiction and fantasy.</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1911</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mythos_Collector_Summer_2001">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Mythos Collector Summer 2001</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Ken Withrow English Mythos Collector Dark Tree Press Release Date June 2001 40 Followed by Winter 2002 was the inaugural edition of the sporadically-released fanzine Mythos Collector . Edited by Brian Lingard, it featured cover art by Ken Withrow (who also provided an interview with fellow artist John Coulthart), and was published by Dark Tree Press in June 2001 . Contents First Words by Brian Lingard Interview with John Coulthart by Ken Withrow "Half Past Five" by Christopher O'Brien "A Matter of Religion" by James P. Roberts Lovecraft Comic Price Guide by Brian Lingard Auction Watch Reviews Contributor Bios References</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>40</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Mythos_Collector"/>
    <ex:wasReleasedOnW>June 2001</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Location"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Edward_Francis_Gamwell">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Edward Francis Gamwell</rdfs:label>
    <ex:diedOnR>26 March 1846</ex:diedOnR>
    <ex:hasAnnotation>Lovecraft’s maternal uncle through Annie Emeline Phillips, whom Edward married 3 June 1897. After Edward and Annie married, they moved from Providence, Rhode Island to Cambridge, Massachusetts, where he was successively employed as the city editor of the Cambridge &lt;i&gt;Chronicle,&lt;/i&gt; the owner and editor of the Cambridge &lt;i&gt;Tribune,&lt;/i&gt; and the editor of the &lt;i&gt;Budget&lt;/i&gt; and the &lt;i&gt;American Cultivator.&lt;/i&gt; Sometime in or before 1916 Edward and Annie separated, although they never legally divorced.</ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1809</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lernean_Hydra">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Lernean Hydra</rdfs:label>
    <ex:hasAnnotation>The is a monster of greek mythology, which fought hercules . The marvel adaptation was created in 1985 by john buscema and roy thomas . Making its first appearance in issue #356 of the 1st volume of the thor comic book series .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Thor Vol 1 #356</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Roy_Thomas"/>
    <ex:wasCreatedByC>John Buscema</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Massa_di_Requiem_per_Shuggay">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Massa di Requiem per Shuggay</rdfs:label>
    <ex:hasAnnotation>It is a fictional opera in the cthulhu mythos . It first appeared in the unspeakable oath , a magazine about chaosium 's call of cthulhu rpg . It is described as a never-published opera composed by benvento chieti bordighera around 1768 in italy . A single performance resulted in a riot, leading to the opera's ban and to bordighera's arrest and later execution</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#FritzLeiberWorks">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Work"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Spawn_of_Yog-Sothoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonSapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Spawn of Yog-Sothoth</rdfs:label>
    <ex:hasAlternativeNamesC>Son of Yog-Sothoth That of the Mass</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The are thoughtless squirming masses of flesh, tentacles, eyes, and tails . They are amorphous and can fit through most gaps, pulling themselves through with tentacles . They are capable of magic but rarely use it for more than fundamental rites .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Dunwich_Horror"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Harry_Turtledove">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Harry Turtledove</rdfs:label>
    <ex:hasAnnotation>Harry Norman Turtledove (born 1949) is an American author and historian who has contributed a handful of stories to the Cthulhu Mythos , and wrote the novel Conan of Venarium , featuring Robert E. Howard 's character Conan in his teenage years. While prolific in the fields of fantasy, historical fiction, and science fiction, Turtledove is most well-known for his numerous works of alternate history, a genre that he helped to popularise. His oeuvre notably includes the Worldwar series, in which World War II was derailed by an alien invasion in 1942, and the Crosstime Traffic series, in which each book features a protagonist transported to a divergent timeline. Selected Bibliography "The Genetics Lecture" (2005) " The Fillmore Shoggoth " (2014) "Nine Drowned Churches" (2015) "Interlibrary Loan" (2017) "The Hill of the Beast" (2019) External Links at the Wiki. at the Internet Speculative Fiction Database</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Robert_Olmstead">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Robert Olmstead</rdfs:label>
    <ex:hasAnnotation>Robert martin olmstead is the narrator of h.p. Lovecraft's the shadow over innsmouth . He is the great-great-grandson of obed marsh and a deep one . In the story's final pages, he learns he himself is the great-great-grandson of obed marsh and a deep one .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Shadow_Over_Innsmouth"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Maker_of_Gods">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Maker of Gods</rdfs:label>
    <ex:hasAnnotation>Gary Myers English Arkham House The House of the Worm date 1975 " " is a short Cthulhu Mythos story by American Gary Myers . It made its first appearance in the 1975 Arkham House collection The House of the Worm . History The House of the Worm The Country of the Worm: Excursions Beyond the Wall of Sleep</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Gary_Myers"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>The House of the Worm</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1975</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yifne">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Stars"/>
    <rdfs:label>Yifne</rdfs:label>
    <ex:hasAccessibilityL>Star travel</ex:hasAccessibilityL>
    <ex:hasAnnotation>Star Star travel Notable Features Green star-fire First appearance " The Inhabitant of the Lake " Created by Ramsey Campbell is a green star first mentioned by Ramsey Campbell in his short Cthulhu Mythos story " The Inhabitant of the Lake " in 1964. All that is known of comes from the occult grimoire The Revelations of Glaaki , which suggests that the Great Old One Glaaki may have passed the star on its travels. appears to be one half of a binary star system, its partner being the dead star Baalblo . The system includes the planet Tond , home to the humanoid yarkdao .</ex:hasAnnotation>
    <ex:hasNotableFeatureL>Green star-fire</ex:hasNotableFeatureL>
    <ex:hasTypeL>Star</ex:hasTypeL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Inhabitant_of_the_Lake"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shadow_of_the_Comet">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Shadow of the Comet</rdfs:label>
    <ex:hasAnnotation>Adventure is a third person single-player adventure following a photographer in the town of illsmouth . He must unravel a sinister conspiracy while surviving his three-day stay . An official strategy guide, which included the short story the call of cthulhu , was written by steve schwartz and released the following year .</ex:hasAnnotation>
    <ex:wasPublishedOnW>1993</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kevin_Wilson">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Kevin Wilson</rdfs:label>
    <ex:hasAnnotation>Wilson has dozens of writing credits to his name, including several cthulhu mythos works for the most part produced for fantasy flight games . These include the second edition of arkham horror - and several of its supplements - elder sign , and achtung! Cthulhu: the secret war . His non-mythos credits include work on tie-in games for batman: the animated series, a game of thrones , mortal kombat , teenage mutant ninja turtles</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Games designer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#JohnDHaefele">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Work"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dagon_September-October_1986">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dagon September-October 1986</rdfs:label>
    <ex:hasAnnotation>Various United Kingdom English Carl T. Ford Release Date September 1986 48 was the fourteenth issue of the now-defunct Lovecraftian fanzine Dagon . It was edited by the late British and occasional Carl T. Ford . Contents (incomplete) "Great Zimbabwe" by Richard Watts " The Plain of Sound " by Ramsey Campbell</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>48</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>September 1986</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Atal">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Atal</rdfs:label>
    <ex:hasAnnotation>The dream-quest of unknown kadath is a fictional character created by h. p. lovecraft for the cthulhu mythos . As a young man he became a priest and the apprentice of barzai the wise, loyally accompanying him on his doomed climb to the top of mount hatheg-kla to see the gods . Despite his age he was "still very keen of mind and memory" and, knowing the danger, initially refused</ex:hasAnnotation>
    <ex:hasAppearanceC>The Other Gods The Dream-Quest of Unknown Kadath</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Cats_of_Ulthar"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Aylith">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Aylith</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Shub-Niggurath"/>
    <ex:hasAlternativeNamesC>The Widow in the Woods The Many-Mother</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Widow in the Woods The Many-Mother Shub-Niggurath First appearance EXP : Twilight Memories Created by Clint Krause , otherwise known as The Widow in the Woods or The Many-Mother , is a tall, shadowy humanoid entity with glowing yellow eyes and branch-like protrusions. She is a servant of Shub-Niggurath . Gallery</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Twilight Memories</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Clint Krause</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Zanthu_Tablets">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Zanthu Tablets</rdfs:label>
    <ex:hasAnnotation>Real World Information First appearance EXP : " The Dweller in the Tomb " Created by Lin Carter The are a series of occult writings created by the late American author Lin Carter for his short story " The Dweller in the Tomb ". Carter describes them as written by Zanthu the hierophant, and relates that they were discovered by the Copeland-Ellington expedition. They were translated by Harold Hadley Copeland into English from Naacal , the original language of Muvians ( EXP : " The Dweller in the Tomb " Lin Carter ). In Other Media In The Real Ghostbusters episode " The Collect Call of Cathulhu ", a woman named Alice Derleth invited Peter Venkman to attend a lecture on the at Columbia University with her.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_Dweller_in_the_Tomb"/>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Prince">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Prince</rdfs:label>
    <ex:hasAnnotation>Deadman's tome first published in the anthology ancient ones ii in march 2018 . Anddre valdivia's story has yet to be reprinted .</ex:hasAnnotation>
    <ex:hasAuthorW>Anddre Valdivia</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Ancient_Ones_II"/>
    <ex:wasPublishedOnW>March 2018</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Zoog">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Zoog</rdfs:label>
    <ex:hasAnnotation>The zoogs are a race of sentient forest-dwelling creatures that inhabit the dreamlands of earth . They are mortal enemies of cats, as they prey upon kittens and are preyed upon in return by adult cats . They have the means to visit the waking world of earth, travelling physically to and from the dreamlands at two places kept secret from the general public .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Dream-Quest_of_Unknown_Kadath"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Arkham_Detective_Collection_Volume_1">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Arkham Detective Collection Volume 1</rdfs:label>
    <ex:hasAnnotation>Byron Craft English Release Date September 2017 328 Followed by The Arkham Detective Collection Volume 2 is a collection of Arkham Detective novellas by American Byron Craft . It was independently published in September 2017; both paperback and digital versions were released. Overview Contents Cthulhu's Minions The Innsmouth Look The Devil Came to Arkham The Dunwich Dungeon</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Byron_Craft"/>
    <ex:hasPageCountW>328</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>September 2017</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Substitute">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Substitute</rdfs:label>
    <ex:hasAnnotation>Fred Van Lente Scott Koblish English Marvel Comics Release Date April 2009 Media Type Comic book is a story in issue #12 of the 1st volume of Wolverine: First Class written by Fred Van Lente. Synopsis Two members of the X-Men , Cyclops and a teenage Shadowcat find themselves trapped within the eldritch prison of Quoggoth , the rebellious creation of Shuma-Gorath , which tries to manipulate and then force them to release it from its imprisonment.</ex:hasAnnotation>
    <ex:hasAuthorW>Fred Van Lente</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>April 2009</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Chrysalis_Corporation">
    <rdf:type rdf:resource="http://example.org/lovecraft#Cults"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdfs:label>Chrysalis Corporation</rdfs:label>
    <ex:hasAffiliationO rdf:resource="http://example.org/lovecraft#Nyarlathotep"/>
    <ex:hasAffiliationO>Children of Chaos</ex:hasAffiliationO>
    <ex:hasAnnotation>Corporation is a front for the children of chaos, a terrible cult that worships nyarlathotep . Corporation creates the "dhohanoids", shapeshifting super-soldiers which serve the corporation . Corporation works its sinister agenda within the halls of power of the new earth government and spreads its influence throughout human controlled territory .</ex:hasAnnotation>
    <ex:hasTypeO>Cult</ex:hasTypeO>
    <ex:isLocatedAtO rdf:resource="http://example.org/lovecraft#Earth"/>
    <ex:wasCreatedBynO>Wildfire LLC</ex:wasCreatedBynO>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Beyond_the_Wall_of_Sleep_%28Nick_OGorman%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Beyond the Wall of Sleep (Nick O'Gorman)</rdfs:label>
    <ex:hasAnnotation>Beyond the Wall of Sleep H. P. Lovecraft (original story) Nick O'Gorman (adaptation) Nick O'Gorman Cover Artist Nick O'Gorman English Target Destroyed Comics Release Date 2019 Beyond the Wall of Sleep is a comic book adaptation of the H. P. Lovecraft short story of the same name . Adapted by Nick O'Gorman who also provided the artwork, it was published through his independent label Target Destroyed Comics in 2019 after obtaining funding through a successful Kickstarter campaign . The comic was later included as the opening story in the collection HPL Vol. 1: Comic Adaptations of the Works of HP Lovecraft , also by Target Destroyed, in May 2023. References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Nick_OGorman"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2019</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Jason_Scott_Aiken">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Jason Scott Aiken</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author United States United States http://jasonscottaiken.com/index.shtml is an American author and games designer who has written a small number of stories set in the Cthulhu Mythos , as well as material for related franchises such as the Pathfinder roleplaying game. His stories have been printed in anthologies such as Swords Against Cthulhu , Swords Against Cthulhu II: Hyperborean Nights , The Fall of Cthulhu Volume II , and Kill Those Damn Cats . Aiken has written several stories on his character Nuja of Lomar . Selected Works Short Stories " The Last to Die " (2017) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>United States</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>http://jasonscottaiken.com/index.shtml</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
