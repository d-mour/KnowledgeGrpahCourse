  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Arkham_Detective">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#StoryCycles"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Arkham Detective</rdfs:label>
    <ex:hasAnnotation>Byron craft english is a series of cthulhu mythos stories . Began in 2015 with novella cthulhu's minions . Runs to a total of 7 novellas and a short story . The complete set later released in two collections .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Byron_Craft"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#BMoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Avatars"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>B'Moth</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Cthulhu"/>
    <ex:hasAlternativeNamesC>Beh'Moth the Devourer</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Behemoth ( EXP )</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Bhemaut</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Phemaut ( EXP )</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Master</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Cult of whilst is worshipped the world over, its cultists appear to be most numerous in south america and africa . It has no direct control over the physical realm, and must rely on its - admittedly extensive - mental abilities to exert its influence . Its power also seems to increase in proximity to large bodies of water .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Ye_Booke_of_Monstres_II"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Scourge_of_BMoth"/>
    <ex:wasCreatedByC>Bertram Russell</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Eilor_%28poem%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Ei'lor (poem)</rdfs:label>
    <ex:hasAnnotation>Ei'lor (poem) Full story online here James Gruetzmacher English Genre(s) Horror Nightscapes #7 date April 1998 " Ei'lor " is a Cthulhu Mythos poem by James Gruetzmacher . Synopsis The six four-line verses describe a cultist's summoning of the plantlike Great Old One Ei'lor , and his wish for it to wreak destruction on the cosmos. History "Ei'lor" was published in the E. P. Berglund -edited Mythos zine Nightscapes in April 1998.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#James_Gruetzmacher"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Nightscapes #7</ex:isPublishedAsW>
    <ex:wasPublishedOnW>April 1998</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Samuel_Seaton">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Samuel Seaton</rdfs:label>
    <ex:ceasedOnC>1852 Oct 19</ex:ceasedOnC>
    <ex:hasAnnotation>Explorer who was murdered by the noted anthropologist and fellow explorer sir robert jermyn . Created by h.p. Lovecraft was an explorer who was murdered by the noted anthropologist and fellow explorer sir robert jermyn . The unhinged robert strangled seaton to death and murdered his own three children in order to eradicate his stained bloodline .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Facts Concerning the Late Arthur Jermyn</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>His Family</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Barry_Pain">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsInspirationsAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Barry Pain</rdfs:label>
    <ex:diedOnR>5 May 1928</ex:diedOnR>
    <ex:hasAnnotation>Full Name Barry Eric Odell Pain Connection to the Mythos Possible inspiration Birth Date 28 September 1864 Cambridge, England Death Date 5 May 1928 Great Britain Humour Horror Barry Eric Odell Pain (28 September 1864 – 5 May 1928) was a British author and journalist active in the late 19th and early 20th centuries, perhaps most famous for his work on the now-defunct satirical magazine Punch . His 1911 novel An Exchange of Souls , published by Eveleigh Nash, has been suggested as an inspiration for H. P. Lovecraft 's short story " The Thing on the Doorstep ". The book was reprinted in May 2007 by indie publisher Hippocampus Press as part of Lovecraft's Library , a series focusing stories which Lovecraft was known to have read and admired . Selected Bibliography Novels An Exchange of Souls (1911) External Links at Wikipedia at the Internet Speculative Fiction Database Gallery References</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#England Cambridge</ex:hasBirthplaceR>
    <ex:hasFullNameR>Barry Eric Odell Pain</ex:hasFullNameR>
    <ex:hasNationalityR>Great Britain</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Possible inspiration</ex:isConnectedToMythosR>
    <ex:wasBornOnR>28 September 1864</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mnomquah">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Mnomquah</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Lord of the Black Lake</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Monster in the Moon</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as Lord of the Black Lake The Monster in the Moon Great Old Ones First appearance EXP : " The Sorcerer's Book " Created by Brian Lumley is a great reptilian creature, with a crown of writhing feelers and empty sockets in place of eyes (although it is still able to see). He is trapped inside the Dreamlands ' moon, though how he became trapped there is unknown. In Brian Lumley 's version of the expanded Cthulhu Mythos , he is the mate of the disgusting Oorn , and when the Great Old Ones awaken to lay waste to our world, then will be reunited with his repulsive bride. He is called the Lord of the Black Lake, because he rules over the Lake of Ubboth , a great lake which is under the moon. Gallery</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Sorcerer's Book</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Black_Tallow">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Black Tallow</rdfs:label>
    <ex:hasAnnotation>The dark rites of cthulhu was published in the anthology the dark rites of cthulhu by april moon books in march 2014 . It is a short story by american author edward m. erdelac about a businessman who wants to pay him seven million dollars to translate a ritualistic text . In preparation for the ritual, paul has murdered his wife and daughter, and rendered them down into tallow for devotional candles .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Edward_M._Erdelac"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Dark_Rites_of_Cthulhu"/>
    <ex:wasPublishedOnW>March 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lithard">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Lithard</rdfs:label>
    <ex:hasAffiliationC>The Elder Gods</ex:hasAffiliationC>
    <ex:hasAnnotation>The lithards are a species of extraterrestrial dragonoid creatures who appear in brian lumley 's titus crow series of cthulhu mythos novels . They are great, scaled, winged creatures with a high degree of intelligence and the ability to converse in english . They evolved on a world called thak'r-yon, but were relocated to the realm of elysia by the elder gods when thak'r-yon'</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Transition_of_Titus_Crow"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Inhabitant_of_the_Lake_and_Less_Welcome_Tenants">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RamseyCampbellWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Inhabitant of the Lake and Less Welcome Tenants</rdfs:label>
    <ex:hasAnnotation>207 is a collection of short horror stories by british horror fiction and mythos contributor ramsey campbell published by arkham house . As it was edited by august derleth , the stories are considered by this wiki to be set in the derleth cthulhu mythos . The stories are set in the fictional severn valley region of england conceived by campbell for his expansions into the mythos .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
    <ex:hasGenreW>Short Horror</ex:hasGenreW>
    <ex:hasPageCountW>207</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1964</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Urban_Temples_of_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Urban Temples of Cthulhu</rdfs:label>
    <ex:hasAnnotation>Modern Mythos Anthology Various Cover Artist Chico Iwana English First United Church of Cthulhu Release Date April 2016 214 : Modern Mythos Anthology is a collection of short Lovecraftian works published by the First United Church of Cthulhu through CreateSpace in April 2016, and later given a digital release via Amazon's Kindle platform. Editorial duties were performed by the Church's head priest Khurt Khave . Contents "Little Gods” by James Pratt “Sects and the Single Girl” by Steven A. Roman “The Kings in Rebel Yellow” by Khurt Khave “The Face of God Within” by Brian H. Seitzman “The Black Metal of Derek Zann” by Aaron Besson “Cosmic Cavity; or, the Mouth of Man” by Carl R. Jennings “Along the Shore of Old Ridge” by Stuart Conover “Sleep Talking” by Jeff C. Stevenson “Matriarch of Skid Row” by M. C. Bluhm “Uncle The Complete Oral History” by David Acord “Strange Communion” by Allen Griffin “Death in the Sunset” by Guy Riessen “The Abomination of St. Jude” by David F. Gray “Flesh-Bound Shadow Sun” by M. S. Swift “Doorstepping” by Kelda Crich “Saturday Night at the Esoteric Order of Dagon” by Jill Hand “City of our Lady, Queen of the Angels, Virgin Mother of a Thousand Young” by Kevin Wetmore “Warm Red Sea” by Jaap Boekestein</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>214</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>April 2016</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ramjet">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Ramjet</rdfs:label>
    <ex:hasAnnotation>Background was once unicron's most dangerous lieutenant and a sadistic monster who enjoyed helping his master destroy many realities throughout the multiverse . Was granted godlike interdimensional powers, often using them to torture and wipe out entire planets as a means of announcing the inevitable outcome of their universe . However, after his physical body collapsed into a massive black hole, found himself stranded in unspace . Encountered some ancient evil entities of indesc</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Folks_of_Innsmouth_%28series%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Folks of Innsmouth (series)</rdfs:label>
    <ex:hasAnnotation>Folks of innsmouth is a of poems by american franklyn searight . Each poem is a vignette of a different resident of the town of innsmouth or it’s surroundings . Many are available to read online .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Franklyn_Searight"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Folks of Innsmouth</ex:isPartOfSeriesW>
    <ex:wasPublishedOnW>1997-2005</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ride_the_Star_Wind">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Ride the Star Wind</rdfs:label>
    <ex:hasAnnotation>Various Various Cover Artist Nick Gucker English Broken Eye Books Release Date September 2017 445 : Cthulhu, Space Opera, and the Cosmic Weird is an anthology of Lovecraftian fiction edited by Scott Gable and C. Dombrowski . Running to a total of 445 , it was published by Broken Eye Books in September 2017; hardcover, paperback and digital editions all received a release. Overview Each story in the book is accompanied by its own piece of art, with a wide range of artists being featured. Artists include Mythos regulars Michael Bukowski , Nick Gucker , and Dave Felton. Contents "The Children of Leng" by Remy Nakamura "Blossoms Blackened Like Dead Stars" by Lucy A. Snyder "The Eater of Stars" by J. E. Bates "Vol de Nuit" by Gord Sellar "Lord of the Vats" by Brian Evenson "Be on Your Way" by Heather Hatch "Cargo" by Desirina Boskovich "The Blood Will Come Later" by DaVaun Sanders "Starship in the Night Sky" by D. W. Baldwin "Behold, a White Ship" by J. Edward Tremlett "Vishwajeet: Conqueror of the Universe" by D. A. Xiaolin Spires "The Multiplication" by Tom Dullemond "Fortunato" by Premee Mohamed "The Writing Wall" by Wendy N. Wagner "Canary Down" by Kara Dennison "Song of the Seirēnes" by Brandon O'Brien "The Pillars of Creation" by Heather Terry "When the Stars Were Wrong" by Wendy Nikel "Union" by Robert White "Under Venusian Skies" by Ingrid Garcia "Sense of Wonder" by Richard Lee Byers "Departure Beach" by Joseph S. Pulver, Sr. "When Yiggrath Comes" by Tim Curran "The Immortals" by Angus McIntyre "Minor Heresies" by Ada Hoffmann "A Superordinate Set of Principles" by Bogi Takács "The Sixth Vital Sign" by Wendi Dunlap "The Temptation of St. Ivo" by Cody Goodfellow "A Dream, and a Monster at the End of It" by Nadia Bulkin</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>445</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>September 2017</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovely_Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovely Lovecraft</rdfs:label>
    <ex:hasAnnotation>A webcomic written and illustrated by sara bardi, based on life and tales of h. p. lovecraft . It originated as a webcomic but only 1 compilation volume has been published . In 1936, a middle-aged lovecraft is struggling with his latest novel, when he notices a flyer for a performer calling himself "the great nyarlathotep " . While monologuing about what he knows about said performer, he</ex:hasAnnotation>
    <ex:hasAuthorW>Sara Bardi</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>Italy</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>120</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>Italian</ex:isInLanguageW>
    <ex:wasReleasedOnW>2016 October 1</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Thasaidon">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Thasaidon</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Black God of Evil</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Master of the Endless Void</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as Black God of Evil Master of the Endless Void Great Old Ones First appearance CIRCLE : " The Tomb-Spawn " CIRCLE : " The Dark Eidolon " Created by Clark Ashton Smith is a malignant entity manifesting as a mace-wielding armored warrior. He is revered as the Principle of Evil in Zothique , but his cult dates back to the time of Mu . Behind the Mythos Although was mentioned in Clark Ashton Smith 's " The Tomb-Spawn ", it plays no real role in the story.</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Dark_Eidolon"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Tomb-Spawn"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Graveyard_Rats">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Graveyard Rats</rdfs:label>
    <ex:hasAnnotation>A lovecraftian short story by h. kuttner appeared in the march 1936 issue of weird tales . It is the author's first published piece and caught the attention of h. p. lovecraft . The story has no explicit references to the mythos, but its depiction of corpse-eating humanoids seems to owe a great deal to lovecraft .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Henry_Kuttner"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Short Fiction Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>1996) Weird Tales: Seven Decades of Terror (1997) The Cthulhu Mythos Megapack (2012)</ex:isPartOfSeriesW>
    <ex:isPartOfSeriesW>Weird Tales (March 1936) The Gruesome Book (1983) Trilogy of Terror II (movie adaptation</ex:isPartOfSeriesW>
    <ex:wasPublishedOnW>1936</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Daoloth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OuterGods"/>
    <rdfs:label>Daoloth</rdfs:label>
    <ex:hasAffiliationC>Outer Gods</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#The_Render_of_the_Veils"/>
    <ex:hasAlternativeNamesC>The Parter of Veils</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Background is an entity that dwells beyond the three dimensions known to humans . His astrologer-priests are said to be able to see the past and the future . 's worship is rare on earth .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Render_of_the_Veils"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Home_Sweet_Hell">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Home Sweet Hell</rdfs:label>
    <ex:hasAnnotation>James Kuhoric, Mike Raicht Fernando Blanco English Dynamite Entertainment Release Date April 2008-Sept 2008 Media Type Comic book is a 4-part story arc written by James Kuhoric and Mike Raicht in 2008. It appeared in issues #9-12 of the 2nd volume of the Army of Darkness by Dynamite Entertainment. Synopsis Ash and Sheila have returned to Ash's time, and are now working at S-Mart. Due to Ash wanting nothing to do with the Necronomicon , his wish was granted and he remembers nothing about his role as the Chosen One. The Seven Deadly Sins arrive as the demons have chosen him to be the new Sloth.</ex:hasAnnotation>
    <ex:hasAuthorW>James Kuhoric</ex:hasAuthorW>
    <ex:hasAuthorW>Mike Raicht</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>April 2008-Sept 2008</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Book_in_the_House">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Book in the House</rdfs:label>
    <ex:hasAnnotation>Full story online here Ron Shiflet United States English Publication date December 1997 " " is a short Cthulhu Mythos poem by American Ron Shiflet . Synopsis An unnamed narrator finds a musty old tome in an abandoned house on a cliff which causes him to dream of Cthulhu . Publication History "" was published in the December 1997 edition of Nightscapes and then again in Cthulhu Cultus #11 in March 1998.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>December 1997</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Secret_of_Sebek">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Secret of Sebek</rdfs:label>
    <ex:hasAnnotation>Narrator is a writer of horror fiction visiting new orleans . He is invited to a special costume party for mardi gras . Encounters an all-too-real incarnation of the crocodile-headed egyptian god .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_Bloch"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>November 1937</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Joe_Slater">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Joe Slater</rdfs:label>
    <ex:hasAnnotation>Slater was an inmate at a mental hospital in new york state, having been confined there as a criminally insane murderer during the winter of 1900-1901 . An intern at the hospital began to suspect that a higher cosmic intelligence was trapped within the physical confines of slater's brain . The intern made contact with the soul being inside slater's mind as slater lay dying . The night after his death, a bright new star was discovered near algol . Within a</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Beyond_the_Wall_of_Sleep"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Man-Serpent">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Man-Serpent</rdfs:label>
    <ex:hasAlternativeNamesC>Snake-People</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>man headed pythons</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>man headed serpents</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Man-serpents are a race created by robert e. howard . First appearing in his story, "the god in the bowl" published in 1952 . First appearance in 1971 in the first volume of the conan the barbarian .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Marvel: Conan the Barbarian Vol 1 #7</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>Robert E. Howard : The God in the Bowl</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Tiger">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Tiger</rdfs:label>
    <ex:hasAnnotation>Assassin caley faith dayton and a special team of heavily-armed soldiers are sent to sanitise a facility . Experiments with dimensional portals go awry and unleash the spawn of ubbo-sathla into the surrounding environments .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Jones"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Beasts</ex:isPublishedAsW>
    <ex:isPublishedAsW>Dark Furies: Weird Tales of Beauties</ex:isPublishedAsW>
    <ex:wasPublishedOnW>September 2005</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#John_Taggart">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>John Taggart</rdfs:label>
    <ex:hasAnnotation>Human First appearance EXP : The Winds of Zarr Created by Richard L. Tierney is a fictional character created by Richard L. Tierney , a time traveller who works both for and against alien forces inimical to humanity. Taggart is Tierney's first series hero, created when the author was still a teenager; he first emerged as a villain in Tierney's story "The Howler in the Dark," published in 1984 but written much earlier. Taggart's first appearance in print was in Tierney's 1975 novel The Winds of Zarr . The character was subsequently featured in several short stories, as well as in the 2008 cross-over novel The Drums of Chaos , where Taggart joins forces with Simon of Gitta . Appearances The Winds of Zarr (Silver Scarab Press, 1975) " Countdown for Kalara " ( Space and Time !, July 1980) " The Howler in the Dark " ( Crypt of Cthulhu #24, Lammas 1984) " The Last Decision " ( Eldritch Tales #15 1988) " The Lords of Pain " ( Nightscapes , September 1997) " Let There Be Darkness " (Nightscapes #16, 2006) The Drums of Chaos ( Mythos Books , 2008)</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Winds of Zarr</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Richard_L._Tierney"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#World-Eater">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>World-Eater</rdfs:label>
    <ex:hasAlternativeNamesC>Ciakla the Hunger</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Feed Demon</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>King of Souls</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Eater</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>World Eater</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as Ciakla the Hunger The Eater Feed Demon King of Souls World Eater Extra-dimensional Powers and Abilities Dimensional travel Electrokinesis Telepathy Host possession First appearance Extraordinary X-Men #8 (March 2016) Created by Jeff Lemire Victor Ibanez  The is an extra-dimensional eldritch entity from the fictional universe of Marvel from Marvel Comics . Background The is an entity which feeds on dimensions. It uses a host that is native to that dimension to consume it before jumping to the next dimension. Its weakness was that it could not enter much less feed on that dimension without a native host body.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Extraordinary X-Men #8 (March 2016)</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Jeff Lemire</ex:wasCreatedByC>
    <ex:wasCreatedByC>Victor Ibanez</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#New_Tales_of_the_Cthulhu_Mythos">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RamseyCampbellWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>New Tales of the Cthulhu Mythos</rdfs:label>
    <ex:hasAnnotation>New Tales of he Cthulhu Mythos Various United States English Genre(s) Horror Fantasy Arkham House English Release date 1980 Media Type Print is an anthology of previously unpublished Cthulhu Mythos short stories. Edited by British horror writer Ramsey Campbell , the book was first published by Arkham House in 1980. Overview In his introduction to the collection, Campbell states: Of particular note is the story " The Black Tome of Alsophocus " by Martin S. Warnes, which is an expansion of H. P. Lovecraft 's fragment " The Book ". Contents "Introduction" " Crouch End " by Stephen King "The Star Pools" by A. A. Attanasio " The Second Wish " by Brian Lumley "Dark Awakening" by Frank Belknap Long "Shaft Number 247" by Basil Copper " Black Man with a Horn " by T. E. D. Klein " The Black Tome of Alsophocus " by H. P. Lovecraft &amp; Martin S. Warnes "Than Curse the Darkness" by David Drake " The Faces at Pine Dunes " by Ramsey Campbell "Notes on Contributors" Gallery</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror Fantasy</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#To_Arkham_and_the_Stars">
    <rdf:type rdf:resource="http://example.org/lovecraft#FritzLeiberWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>To Arkham and the Stars</rdfs:label>
    <ex:hasAnnotation>"the dark brotherhood and other pieces" is a short story by american writer fritz leiber . It revisits h. p. lovecraft's miskatonic university setting and many of his characters in an affectionate tribute to a writer who served as a mentor to leiber . Along the way we see a version of the town and school updated to the 1960s .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Fritz_Leiber"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Dark_Brotherhood"/>
    <ex:isPublishedAsW>Other Pieces</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1966</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Sleeping_One">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Sleeping One</rdfs:label>
    <ex:hasAnnotation>Cthulhu mythos is a short story by american frank forte . It is first published in his collection beyond lovecraft by asylum press in september 2020 . The story is prefaced with a quote from lovecraft 's " the call of cthulhu "</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Frank_Forte"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Beyond_Lovecraft"/>
    <ex:wasPublishedOnW>September 2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Voormish_Tablets">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Voormish Tablets</rdfs:label>
    <ex:hasAnnotation>The Real World Information Created by Lin Carter The are a set of stone tablets, likely containing the scriptures of the Voormi race. They are mentioned in the Pnakotic Manuscripts and the Book of Eibon , although no copies seem to have survived into the present day. The were created by Lin Carter .</ex:hasAnnotation>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Vampirella/Army_of_Darkness">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Vampirella/Army of Darkness</rdfs:label>
    <ex:hasAnnotation>Mark Rahner Jethro Morales English Dynamite Entertainment Release Date July 2015- October 2015 Media Type Comic book is a 4-issue crossover mini-series written by Mark Rahner. Synopsis Vampirella is pulled back in time to the Middle Ages by Ash Williams who misspelled a spell from the Necronomicon , and helps him fight Evil Ash and the Army of Darkness.</ex:hasAnnotation>
    <ex:hasAuthorW>Mark Rahner</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>July 2015- October 2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dacia">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#TechnologicalArtefacts"/>
    <rdfs:label>Dacia</rdfs:label>
    <ex:hasAnnotation>Vehicle (Ocean liner) Transportation Real World Information H. P. Lovecraft First Appearance HPL : " The Temple " The was an ocean liner active in the North Atlantic during the First World War. The German submarine U-29 under Lieutenant-Commander Karl Heinrich had intended to intercept and sink the , but missed it altogether while trying to deal with the supernatural events that befell the U-29. ( HPL : " The Temple ")</ex:hasAnnotation>
    <ex:hasFunctionA>Transportation</ex:hasFunctionA>
    <ex:hasTypeA>Vehicle (Ocean liner)</ex:hasTypeA>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_Temple"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mr._Stone">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Fictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Mr. Stone</rdfs:label>
    <ex:ceasedOnC>November 1926</ex:ceasedOnC>
    <ex:hasAffiliationC>The Silver Twilight Lodge</ex:hasAffiliationC>
    <ex:hasAnnotation>History was an alien mi-go who appeared in peter j. evans' 2013 novel feeders from within . He was one of the mi-go present in the cave encountered by mark harrigan's squad during the pancho villa expedition . Although grievously injured in the conflict with the soldiers, he managed to reconstruct both himself and the barely-alive squad leader .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Feeders_from_Within"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Peter_J._Evans"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#James_Desborough">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>James Desborough</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Traditional games designer Author United Kingdom https://postmortemstudios.wordpress.com/ James "Grim" Desborough is a prolific British games designer and author. He is the current owner of gaming company Postmortem Studios, and has produced a number of works for former business partners Cubicle 7 Entertainment . Selected Works Short Fiction " The Black Pool " (2015) Gaming Supplements Folklore (2013, with Stuart Boon and others) External Links at Wikipedia at the Internet Speculative Fiction Database James 'Grim' Desborough at Goodreads</ex:hasAnnotation>
    <ex:hasNationalityR>United Kingdom</ex:hasNationalityR>
    <ex:hasWebsiteR>https://postmortemstudios.wordpress.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Traditional games designer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yian-Ho">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Yian-Ho</rdfs:label>
    <ex:hasAnnotation>Description is described as a "shunned", "dreaded" and "abhorred" place . It's not known whether is related to (or even synonymous with) the mystical city of yian, mentioned in robert w. chambers' " the maker of moons " and h. p. lovecraft's the whisperer in darkness .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Robert_E_Howard">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Robert E Howard</rdfs:label>
    <ex:diedOnR>1936</ex:diedOnR>
    <ex:hasAnnotation>Prolific Texas author of weird and adventure tales for Weird Tales and other pulp magazines; creator of the adventure hero Conan the Barbarian. He and Lovecraft corresponded voluminously from 1930 to 1936. He committed suicide when he heard of his mother’s impending death. [The Robert E. Howard Foundation was “organized to foster understanding of the life and works of Robert E. Howard”.]</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1906</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Feeders_from_Within">
    <rdf:type rdf:resource="http://example.org/lovecraft#ArkhamHorrorFiction"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Feeders from Within</rdfs:label>
    <ex:hasAnnotation>Print is a novel set within the fictional cthulhu mythos . It was written by peter j. evans and published by fantasy flight games . The story features several characters from fantasy flight's associated games .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Peter_J._Evans"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror Mystery</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Arkham_Horror_Fiction"/>
    <ex:wasReleasedOnW>2013</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mirror_to_Wonderland">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MysticalArtefacts"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Mirror to Wonderland</rdfs:label>
    <ex:hasAnnotation>The is a fictional item in the Grimm Fairy Tales universe of Zenescope Entertainment which first appeared in 2007 in the 1st issue of the 1st volume of the Return to Wonderland mini series. Background The accidentally absorbed the energies of the portal to Wonderland due to the actions of the scientist Henry Allen. It became a portal to Wonderland, one that was portable and which has been used often. The mirror has been smashed several times but keeps returning. Being near the mirror has at times permitted the forces of Wonderland to influence those on Earth.</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Gnashing_Whispers">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Gnashing Whispers</rdfs:label>
    <ex:hasAnnotation>David Kenney English Lost Archivist Rogue Planet Press Lovecraftiana Vol 5, Issue 2 date July 2020 " : A Lost Archivist Story " is a short Cthulhu Mythos story by David Kenney . Forming part of his Lost Archivist , it was published in Vol 5, Issue 2 of Lovecraftiana by Rogue Planet Press in July 2020. Synopsis Chief Archivist of the Miskatonic University forbidden archives Wendell Hunt is tasked with uncovering a thief and murderer who has been targeting those involved with one of the most dangerous areas of the subterranean vaults: Storage Area B. His investigations in the facility, while driving him to the brink of madness, uncover a jealous professor using necromancy and other forbidden arts to steal occult manuscripts. Although Hunt is able to defeat the perpetrator and his undead minion, it comes at the cost of his ear, chewed off by the zombie during the conflict.</ex:hasAnnotation>
    <ex:hasAuthorW>David Kenney</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Lost Archivist</ex:isPartOfSeriesW>
    <ex:isPublishedAsW>Issue 2</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 5</ex:isPublishedAsW>
    <ex:wasPublishedOnW>July 2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kenneth_J._Sterling">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Kenneth J. Sterling</rdfs:label>
    <ex:diedOnR>1995</ex:diedOnR>
    <ex:hasAnnotation>Young science fiction fan who came into contact with Lovecraft in 1934. They collaborated on the science fiction story “In the Walls of Eryx” (1935). Sterling later became a distinguished physician.</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1920</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#William_L_Crawford">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>William L Crawford</rdfs:label>
    <ex:diedOnR>1984</ex:diedOnR>
    <ex:hasAnnotation>Editor of Marvel Tales and Unusual Stories and publisher of the Visionary Publishing Company, which issued Lovecraft’s The Shadow over Innsmouth (1936).</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1911</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Martian">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Martian</rdfs:label>
    <ex:hasAnnotation>The martians are a fictional race developed for the call of cthulhu roleplaying game in 1995 . They are inspired by h.g. Wells' the war of the worlds and frank belknap long's the blue earthman . They are armed with heat rays, black smoke projectors, and mechanical tentacles .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Blue Earthman</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>The War of the Worlds</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._G._Wells"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Animus">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Animus</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Lloigor</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Pwodarauk</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The is an extraterrestrial life form created by the bbc for doctor who in 1965 . It was later retconned into being a great old one during the 1990s . It was the only one of its race to cross into the physical universe . The is capable of taking over anything living which came into contact with gold .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Web Planet</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Bill Strutton</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bret_Kramer">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Bret Kramer</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Traditional games designer Editor Roleplaying games is a games designer and editor who has worked on a number of Cthulhu Mythos projects for both the Call of Cthulhu horror roleplaying game and it’s spin-off Delta Green: Need to Know . In addition to these works, he has also edited at least one issue of the Lovecraftian gaming magazine The Unspeakable Oath ., and has been a regular contributor to the The Arkham Gazette , a magazine dedicated to Call of Cthulhu . Selected Works Editor The Unspeakable Oath (2018) Games Delta Green: Need to Know (2016) Gaming Supplements Machine Tractor Station Kharkov-37 (2007) More Adventures in Arkham Country (2010, contributor) Masks of Nyarlathotep Companion (2013, contributor) Cthulhu Britannica: London (2015, contributor) The Dare (2017) Arkham (2024) External Links at RPGGeek gaming credits at RPG.net</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Traditional games designer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Horror_from_the_Depths">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Horror from the Depths</rdfs:label>
    <ex:hasAnnotation>A dredging operation in lake minneapolis in 1931 awakens a group of ancient beings which go on to slaughter and spread madness . An engineer and a university professor discover through their research that the beings were imprisoned by the elder gods untold aeons ago . In an attempt to re-inter the creatures, the two locate a number of star-stones which the dredger had also brought up .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mark_Schorer"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Colonel Markesan</ex:isPublishedAsW>
    <ex:isPublishedAsW>Less Pleasant People</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1966</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dragons_of_Mons_Fractus">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dragons of Mons Fractus</rdfs:label>
    <ex:hasAnnotation>Simon of gitta confronts an undead version of one of the main villains of christian tradition . In search of vengeance, he tracks pontius pilate to the hinterland of the roman empire . He discovers an undead horror menacing germania, and finds unlikely allies in two survivors of the ancient serpent people .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Richard_L._Tierney"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Weirdbook 19</ex:isPublishedAsW>
    <ex:wasPublishedOnW>March 1984</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Machine_Tractor_Station_Kharkov-37">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Machine Tractor Station Kharkov-37</rdfs:label>
    <ex:hasAnnotation>A Cthulhu Scenario Set in Stalin's USSR Bret Kramer Mithras United States English Call of Cthulhu Monograph Genre(s) Roleplaying game Chaosium Release Date August 2004 113 : A Cthulhu Scenario Set in Stalin's USSR is an adventure supplement for Chaosium 's Call of Cthulhu roleplaying game. Overview contains a compete stand-alone scenario for classic-era Call of Cthulhu , along with a selection of pre-generated characters and a full set of player handouts. Behind the Mythos Written by Bret Kramer and running to a total of 113 , was first published in 2004 by Chaosium as part of their Monograph of supplements; a revised edition was released in 2007. Although both softcover and digital download versions were issued, it is currently unavailable in either format. Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Bret_Kramer"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>113</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu Monograph</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>August 2004</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Selected_Letters_of_Clark_Ashton_Smith">
    <rdf:type rdf:resource="http://example.org/lovecraft#ClarkAshtonSmithWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Selected Letters of Clark Ashton Smith</rdfs:label>
    <ex:hasAnnotation>Clark Ashton Smith Arkham House Date of writing 1911-1961 date 2003 are a compilation of extracts of Smith's known correspondence published by Arkham House . Contents Introduction by Scott Connors and David E. Schultz</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Arkham_House"/>
    <ex:wasPublishedOnW>2003</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>1911-1961</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Amateur_Journalism:_Its_Possible_Needs_and_Betterment">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Amateur Journalism: Its Possible Needs and Betterment</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft United States English Genre(s) Non-fiction Arkham House The Dark Brotherhood and Other Pieces Date of writing 1920 date 1966 " " is a short non-fiction piece by the late American Howard Phillips Lovecraft . written in 1920, it was first published in August Derleth 's 1966 collection The Dark Brotherhood and Other Pieces . History The Dark Brotherhood and Other Pieces (1966) Miscellaneous Writings (1995)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Dark_Brotherhood"/>
    <ex:isPublishedAsW>Other Pieces</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1966</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>1920</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Asteroth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Asteroth</rdfs:label>
    <ex:hasAlternativeNamesC>Omega</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as omega great old one or a lesser old one . Appeared in final four issues of stormbreaker: the saga of beta ray . Created by mike oeming .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Stormbreaker: The Saga of Beta Ray Bill Vol 3</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Andrea Di Vito</ex:wasCreatedByC>
    <ex:wasCreatedByC>Mike Oeming</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Codex_August_1996">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Codex August 1996</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Jason C. Eckhardt English Necronomicon Press Release Date August 1996 44 Preceded by May 1996 Followed by November 1996 is the eighth issue of the Necronomicon Press fanzine Cthulhu Codex . Running to a total of 43 , it was edited by Lovecraft scholar Robert M. Price and featured artwork by Jason C. Eckhardt . Contents Editorial: From the Scriptorium by Robert M. Price "Return of the Shoggoth" by Gregory Luce "The Lips" by Frederick Stansfield "The Guardian of the Pit" by Franklyn Searight "The Bane of the Byagoona" by James Ambuehl "The House of Azathoth" by Peter Cannon "Wilbur's Helpless Brother" by Stanley C. Sargent "Uncollected Letter" by M. Cisco</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>44</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>August 1996</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#John_R._Fultz">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>John R. Fultz</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Kentucky, USA United States https://johnrfultz.com/  𝐓 is an American author and editor whose output includes novels, short fiction and comic books. He has written several stories set in the greater Cthulhu Mythos established by the works of H. P. Lovecraft , whom he lists as one of his literary heroes . His works have appeared in a wide range of publications, including the long-running Weird Tales and the Weirdbook anthology series by Wildside Press . Selected Bibliography Short Fiction " This Is How the World Ends " (2010) " I Do the Work of the Bone Queen " (2013) " The Thing in the Pond " (2019) Poems " R'lyeh Rising " (1997) External Links at the Internet Speculative Fiction Database at Goodreads References</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Kentucky</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://johnrfultz.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
