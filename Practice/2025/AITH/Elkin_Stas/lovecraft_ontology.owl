    <ex:wasPublishedOnW>2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tales_of_Sesqua_Valley">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Tales of Sesqua Valley</rdfs:label>
    <ex:hasAnnotation>W. H. Pugmire Cover Artist Earl Geier English Necropolitan Press Release Date August 1997 66 is a thematic collection of Cthulhu Mythos fiction by the late American W. H. Pugmire . It was published by Necropolitan Press in August 1997, and featured an introduction by Jeffrey Thomas and cover art by Earl Geier . Contents "Introduction: Beyond the Valley of the Damned" by Jeffrey Thomas "Another Flesh" "Beneath the Deepest Wound" "Apotheosis" "Born in Strange Shadow" "An Image in Chalk" "An Imp of Aether" "Immortal Remains" "The Million-Shadowed One" "The Child of Dark Mania" "The Balm of Nepenthe"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#W._H._Pugmire"/>
    <ex:hasPageCountW>66</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>August 1997</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Scat_%28Michael_Shea%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Scat (Michael Shea)</rdfs:label>
    <ex:hasAnnotation>Scat is a recurrent character who appears in the works of the late american author michael shea . She is a sex worker in a more run-down part of san francisco . Describes herself as "a hooker that reads"</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Dagoniad"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Tsathoggua"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Michael_Shea"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Zobna">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Zobna</rdfs:label>
    <ex:hasAnnotation>Dreamlands Kingdom Humans First appearance HPL : " Polaris " Created by H. P. Lovecraft was a far northern kingdom in the Dreamlands that was eventually overwhelmed by the gradual encroachment of a great advancing ice sheet. The Zobnarians were forced to move southward and became the ancestors of the Lomarians . During their southward migration, the Zobnarians "valiantly and victoriously swept aside the hairy, long-armed, cannibal Gnophkehs that stood in their way." The wisdom of the Zobnarian Fathers, as the people of Lomar refer to their ancestors, is preserved in books in the Lomarian city of Olathoë . ( HPL : " Polaris ")</ex:hasAnnotation>
    <ex:hasTypeL>Kingdom</ex:hasTypeL>
    <ex:isInhabitedByL>Humans</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Dreamlands"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#Polaris"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cassius">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cassius</rdfs:label>
    <ex:hasAnnotation>"mrs. lorriquer" is a horror short story by h.s. Whitehead . It is based on one of the entries of h.p. Lovecraft's commonplace book . The story features the return of two other characters, namely dr. pelletier and arthur carswell .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Description_of_the_Town_of_Quebeck,_in_New_France,_Lately_added_to_His_Britannick_Majestys_Dominions">
