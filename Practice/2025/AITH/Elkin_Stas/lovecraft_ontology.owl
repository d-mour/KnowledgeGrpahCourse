    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Bayt al Azif, Issue 2, September 2019</rdfs:label>
    <ex:hasAnnotation>Bayt al Azif Issue 2 Various Various English Bayt al Azif Genre(s) Roleplaying game Release Date September 2019 104 Preceded by Bayt al Azif , Issue 1, October 2018 Followed by Bayt al Azif , Issue 3, November 2020 Bayt al Azif Issue 2 is the second issue of the sporadically-released Cthulhu Mythos roleplaying game magazine Bayt al Azif . Running to a total of 104 , it was published in September 2019; hardback, softcover, and digital editions were all made available. Overview</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>104</ex:hasPageCountW>
