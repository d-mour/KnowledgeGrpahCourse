  <rdf:Description rdf:about="http://example.org/lovecraft#C._C._Senf">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>C. C. Senf</rdfs:label>
    <ex:diedOnR>1949</ex:diedOnR>
    <ex:hasAnnotation>Full Name Curtis Charles Senf Connection to the Mythos Artist Birth Date 1873 Death Date 1949 Prussia 𝐓 Curtis Charles Senf (1873 - 1949) was a Prussian-American artist who worked extensively for Weird Tales , regularly providing covers and interior art for the magazine from 1927 to 1932. During this period, he illustrated dozens of stories, including H. P. Lovecraft 's The Whisperer in Darkness , Frank Belknap Long 's " The Hounds of Tindalos " and The Horror from the Hills , Robert E. Howard 's " The Children of the Night ", and several tales by Clark Ashton Smith , among others. Born in Rosslau, Prussia, Senf moved to the United States at a young age and lived in Chicago, Illinois. Outside of Weird Tales , his career was mostly focused on newspaper advertising. See also Images by</ex:hasAnnotation>
    <ex:hasFullNameR>Curtis Charles Senf</ex:hasFullNameR>
    <ex:hasNationalityR>Prussia</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Artist</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1873</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#In_the_Shadow_of_BhYhlun">
    <rdf:type rdf:resource="http://example.org/lovecraft#BhyhlunSeries"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>In the Shadow of Bh'Yhlun</rdfs:label>
    <ex:hasAnnotation>Ian Davey English Bh'Yhlun Genre(s) Weird fiction Urban Cthulhu: Nightmare Cities date May 2012 ← Previous " The Epiphany of Dissolution " " " is a short story by Ian Davey . It is the final instalment in his Bh'Yhlun of Cthulhu Mythos stories. Synopsis TBA History "" was published in the anthology Urban Cthulhu: Nightmare Cities in May 2012.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ian_Davey"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
