    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Around the Corner</rdfs:label>
    <ex:hasAnnotation>Historywas first published in the anthology return of the old ones: apocalyptic lovecraftian horror in 2017 . It was later included in the collection of thomas's own works the coming of the old ones in 2019 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Jeffrey_Thomas"/>
