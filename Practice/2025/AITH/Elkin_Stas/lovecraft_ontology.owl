    <rdfs:label>Roy Leakey</rdfs:label>
    <ex:hasAnnotation>The moon-lens was a character created by ramsey campbell for his short story " the moon-lens " . He was a bookish man who enjoyed antiquarian pursuits . One day he decided to take the train to exham in the severn valley, which had only a single line which made its journey infrequently .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Moon-Lens"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Demiurge:_The_Complete_Cthulhu_Mythos_Tales_of_Michael_Shea">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Demiurge: The Complete Cthulhu Mythos Tales of Michael Shea</rdfs:label>
    <ex:hasAnnotation>Michael Shea Aeron Alfrey Cover Artist Aeron Alfrey United States English Genre(s) Horror Dark Regions Press Release Date December 2017 340 is a collection of Lovecraftian fiction by the late American Michael Shea . Overview Containing thirteen stories and running to a total of 340 , was edited by leading Lovecraft scholar S. T. Joshi and published by Dark Regions Press in December 2017. It is available in both physical paperback and digital ebook formats. Contents Introduction by S. T. Joshi " Fat Face " " Nemo Me Impune Lacessit " " The Presentation " " The Pool " " The Recruiter " " The Battery " " Copping Squid " " Dagoniad " " Tsathoggua " " Beneath the Beardmore " " Momma Durtt " " Under the Shelf " " Demiurge "</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Michael_Shea"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>340</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>December 2017</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yhagni">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Yhagni</rdfs:label>
    <ex:hasAnnotation>Relatives Cthulhu (Cousin) Hastur (Cousin) Nug and Yeb (Uncles) First appearance " 's Priest " Created by James William Hjort is the female or hermaphroditic cousin of Hastur and Cthulhu , who is known for her disgusting appearance and insane power. The other Great Old Ones saw her as a major threat and had her locked deep in the Temple of Pillars in the dephs of Kyartholm , which is hidden somewhere in the Northern Hemisphere. She is believed to appear as a formless, maggot-like creature, though her true appearance is unknown.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Yhagni's Priest</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>James William Hjort</ex:wasCreatedByC>
  </rdf:Description>
