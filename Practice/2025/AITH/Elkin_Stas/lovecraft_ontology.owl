  <rdf:Description rdf:about="http://example.org/lovecraft#Robert_Jermyn">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Robert Jermyn</rdfs:label>
    <ex:ceasedOnC>1854</ex:ceasedOnC>
    <ex:hasAnnotation>Sir was a noted anthropologist who explored africa, and was the great-grandfather of arthur jermyn . Robert discovered to his horror that there was a simian strain in his own family originating from a union between his grandfather wade jermyn and a female member of a race of african white apes . The unhinged robert murdered samuel seaton along with his own three children, but his two year old grandson alfred survived .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Facts Concerning the Late Arthur Jermyn</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>His Family</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Theft_of_Thirty-Nine_Girdles">
