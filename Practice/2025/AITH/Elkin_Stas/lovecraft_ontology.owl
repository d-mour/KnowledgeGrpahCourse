  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Black_Rites">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Black Rites</rdfs:label>
    <ex:hasAnnotation>The Created by Luveh-Keraphf Used by James Allington Occult text Real World Information Robert Bloch First Appearance CIRCLE : " The Suicide in the Study " Other Appearances CIRCLE : " The Grinning Ghoul " The are a fictional text invented by Robert Bloch , attributed by Bloch to his character Luveh-Keraphf , a thinly veiled allusion to Bloch's friend H. P. Lovecraft . The are first mentioned in Bloch’s " The Suicide in the Study " (1935), where a copy is owned by the wizard James Allington. They are described as being written by "the mad poet Luveh-Keraphf, priest of Bast ." The book comes up again in " The Grinning Ghoul " (1936), where Bloch refers to it as "the grotesque of mystic Luveh-Keraph, the priest of cryptic Bast."</ex:hasAnnotation>
    <ex:hasTypeA>Occult text</ex:hasTypeA>
    <ex:isUsedByA>James Allington</ex:isUsedByA>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_Suicide_in_the_Study"/>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#Luveh-Keraphf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bat-Winged_Devil">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Bat-Winged Devil</rdfs:label>
    <ex:hasAnnotation>Real World Information First appearance HPL : " The Call of Cthulhu " Created by H. P. Lovecraft The Bat-Winged Devils are a type of fictional creature briefly made mention of in H. P. Lovecraft 's 1928 short story " The Call of Cthulhu ". Overview Little is revealed of these creatures, other than that they were a species of winged beasts, possibly subterranean in nature, which inhabited the Louisiana bayous south of New Orleans , and seemed to worship the white polypous thing also mentioned in "The Call of Cthulhu".</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Call_of_Cthulhu"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Primavera">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Primavera</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft United States English (original) French Arkham House Beyond the Wall of Eleep Date of writing April 1925 date 1943 " " is a poem by the late American Howard Phillips Lovecraft . Although it was written in April 1925, it did not see until its inclusion in the 1943 Arkham House collection Beyond the Wall of Sleep . It has since been reprinted several times, and has also been translated into French . History Beyond the Wall of Sleep (1943) Collected Poems (1963) The World of H. P. Lovecraft (1971) Fungi from Yuggoth and Other Poems (1971) The Fantastic Poetry (1990) The Ancient Track: The Complete Poetical Works of H. P. Lovecraft (2001, 2013) Essais - Correspondance - Poésie - Révisions (2021) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:isPublishedAsW>Beyond the Wall of Eleep</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1943</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>April 1925</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dream-Quest_of_Vellitt_Boe">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dream-Quest of Vellitt Boe</rdfs:label>
    <ex:hasAnnotation>172 is a novella by kij johnson set in the dreamlands created by h.p. Lovecraft . It tells the story of vellitt boe, a native of the dreamlands who was a far-traveller in her youth . When her best student, clarie jurat, runs off with a man from the waking world, she must relearn her travelling ways .</ex:hasAnnotation>
    <ex:hasAuthorW>Kij Johnson</ex:hasAuthorW>
    <ex:hasPageCountW>172</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2016 August 16</ex:wasReleasedOnW>
  </rdf:Description>
