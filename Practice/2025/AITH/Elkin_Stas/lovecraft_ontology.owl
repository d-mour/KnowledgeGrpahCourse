  <rdf:Description rdf:about="http://example.org/lovecraft#The_Colossus_of_Ylourgne">
    <rdf:type rdf:resource="http://example.org/lovecraft#AveroigneCycle"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ClarkAshtonSmithWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Colossus of Ylourgne</rdfs:label>
    <ex:hasAnnotation>Clark Ashton Smith United States English Weird Tales date June 1934 𝐓 "" is a story by Clark Ashton Smith , set in his pseudo-historical setting of Averoigne . It first appeared in the June 1934 issue of Weird Tales . Set in 1281, it tells the story of the necromancer Nathaire , who combines corpses in the ruined castle of Ylourgne to create an undead giant under his control to wreak vengeance on the city of Vyônes . The student of the occult Gaspard du Nord uses his own magic to defeat Nathaire and save the city.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>June 1934</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Necronomicon_of_Solar_Pons">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Necronomicon of Solar Pons</rdfs:label>
    <ex:hasAnnotation>Various English Belanger Books Release Date April 2020 433 is an anthology of Lovecraftian fiction edited by Derrick Belanger which was published through Belanger Books in April 2020. Both paperback and digital editions were released. Overview Contents " The Rondure of Cthulhu " by Stephen Herczeg " The Meandering Mathematician " by Robert Perret " A Matter of Blood " by Nick Cardillo " To Everything There is a Season " by Stephen Persing " The Adventure of the Book and the Gate " by Eleanor Sciolistein " Solar Pons and the Testament in Ice " by Jeff Baker " The Adventure of the Drowned Genealogist " by I.A. Watson " The Man with the Writhing Skin " by David Marcum " The Devil's Tongue of Blue John Gap " by Derrick Belanger</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>433</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>April 2020</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Brandon_Berntson">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Brandon Berntson</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Colorado, United States United States Horror Fantasy Children's/Young Adult https://www.brandonberntson.com/ is an author of horror, fantasy and children's stories from Colorado, USA. For this wiki, his most notable works are his Lovecraft Mysteries series of Cthulhu Mythos books, a trilogy of pulp novels based around Innsport private detective Devlin Macky and his supernatural adventures. In the "About the Author" section of The Night of Dagon , Berntson cites Stephen King and Ramsey Campbell as amongst his influences; he also states that he enjoys The X-Files television show. Selected Bibliography Novels The Night of Dagon (2018) Arkham: Reanimated (2019) The Lurker at the Threshold (2021) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>United States Colorado</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://www.brandonberntson.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
