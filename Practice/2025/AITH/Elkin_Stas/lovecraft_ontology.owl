    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>January 1951</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Faceless_God">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Faceless God</rdfs:label>
    <ex:hasAnnotation>A ruthless black marketeer named doctor . Stugatche discovers that a caravan of traders have uncovered a potentially-priceless . Statue in the desert . He mounts an expedition to retrieve it, but finds that his hired . Group of locals are unwilling to touch the thing, and he has to resort to violence to force them to dig it from beneath the sands .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_Bloch"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Short Fiction Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>May 1936</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yellow_Labelled_VHS_Tape">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Yellow Labelled VHS Tape</rdfs:label>
    <ex:hasAnnotation>A young man comes across a box of video cassettes at a flea market . After watching one of the tapes - labelled "the king in the tattered cloak- castaigne" - he begins a descent into madness . The story was published in the anthology wildside press weirdbook annual 2 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#R._C._Mulhare"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Weirdbook Annual 2</ex:isPublishedAsW>
    <ex:wasPublishedOnW>February 2019</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Selected_Essays_Volume_I">
