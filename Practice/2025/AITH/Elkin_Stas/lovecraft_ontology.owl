    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Passing of a Dreamer</rdfs:label>
    <ex:hasAnnotation>The arkham collector, spring 1971is a short horror story by american gary myers . The story tells of how a priest named . Shireth-ko, who prepared the incense burned at all hours in the left ear of the image . Nasht . But he was able to discern the nonexistence of the gods and turned them away .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Gary_Myers"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Arkham_Collector"/>
