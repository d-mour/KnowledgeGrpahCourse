  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Xinlurgash">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Xinlurgash</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Great_Old_One"/>
    <ex:hasAlternativeNamesC>The Ever-Consuming</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Ever-Consuming Great Old One First appearance "The Mysterious Millionaire" Created by William Jones is an entity manifesting as a bristly mass with gaping maws made out of tentacles and spider legs. Trivia William Jones used this deity in "The Mysterious Millionaire" and "An Ancient Summoning", two short stories in his The Strange Cases of Rudolph Pearson book published by Chaosium .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Mysterious Millionaire</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#William_Jones"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sea_Memory">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Sea Memory</rdfs:label>
    <ex:hasAnnotation>Maria Mitchell English James Ward Kirk Publishing Lovecraft after Dark date November 2015  " " is a Lovecraftian poem by Maria Mitchell . It was published in the James Ward Kirk Publishing thematic anthology Lovecraft after Dark in November 2015. Synopsis Consisting of 39 lines in two verses, the poem tells of a being called Unda, both a life-giver to the ocean, and a terror to all its inhabitants.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Maria_Mitchell"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Lovecraft_after_Dark"/>
    <ex:wasPublishedOnW>November 2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Wonderful_Musician">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Wonderful Musician</rdfs:label>
    <ex:hasAnnotation>Into the black: tales of lovecraftian terror is a collection of short stories by author william meikle . Despite lacking any direct reference to the works of h. p. lovecraft or the greater cthulhu mythos, meikle's inclusion indicates his belief that it follows in the spirit of such works .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>A Mythos Grimmly</ex:isPublishedAsW>
    <ex:wasPublishedOnW>November 2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Heat-Lizard">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonSapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Heat-Lizard</rdfs:label>
    <ex:hasAlternativeNamesC>Groko</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Sociocultural Characteristics Also known as Groko Mercury Real World Information First appearance " The Immortals of Mercury " Created by Clark Ashton Smith Heat-Lizards , also known as Grokos by the Oumni , are a salamandrine species of large, non-intelligent creatures from the planet Mercury. ( CIRCLE : " The Immortals of Mercury ")</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Immortals of Mercury</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Inhabitant_of_the_Lake">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RamseyCampbellWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Inhabitant of the Lake</rdfs:label>
    <ex:hasAnnotation>Artist thomas cartwright rents a secluded lakeside property in the severn valley . There, nightmares and half-imagined happenings begin to plague him . He discovers a set of ancient manuscripts which detail the coming of an ancient entity to earth and its activities thereafter . As the strange happenings escalate, cartwright calls on his friend alan kearney for help .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Marsh_family">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Marsh family</rdfs:label>
    <ex:hasAffiliationC>Deep Ones</ex:hasAffiliationC>
    <ex:hasAnnotation>Deep one bloodline has its roots in the small fishing village of innsmouth . Descendants of captain obed marsh will gradually mutate into amphibious beings . The last of the line appears to be robert and his cousin lawrence .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Shadow_Over_Innsmouth"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nioth-Korghai_%28character%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Nioth-Korghai (character)</rdfs:label>
    <ex:ceasedOnC>The Far Future</ex:ceasedOnC>
    <ex:hasAffiliationC>Ossaru</ex:hasAffiliationC>
    <ex:hasAnnotation>Nioth-korghai is an extraterrestrial character who appears in clark ashton smith 's zothique cycle story " the tomb-spawn " nioth-korghai was developed by colin wilson for his novel the star vampires .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Tomb-Spawn"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Emma">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#TechnologicalArtefacts"/>
    <rdfs:label>Emma</rdfs:label>
    <ex:hasAnnotation>Place of origin Auckland, New Zealand Vehicle Transportation Real World Information H. P. Lovecraft First Appearance HPL : " The Call of Cthulhu " The was a fictional ship created by H. P. Lovecraft , which makes its only appearance in the 1928 short story " The Call of Cthulhu ". It is a two-masted schooner which originated in Auckland, New Zealand, and is manned by eleven crew members. These are Captain Collins , First Mate Green , Second Mate Gustaf Johansen , William Briden , Rodriguez , Donovan , Hawkins , Guerrera , Angstrom , Parker and one unnamed man. The was damaged and presumably sunk in the aftermath of an encounter with an armored steam yacht, the Alert , manned by Cthulhu cultists .</ex:hasAnnotation>
    <ex:hasFunctionA>Transportation</ex:hasFunctionA>
    <ex:hasPlaceOfOriginA>New Zealand Auckland</ex:hasPlaceOfOriginA>
    <ex:hasTypeA>Vehicle</ex:hasTypeA>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_Call_of_Cthulhu"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Works_by_H._P._Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Works by H. P. Lovecraft</rdfs:label>
    <ex:hasAnnotation>This is a complete, exhaustive list of extant works by howard phillips lovecraft . Many of these works can be found on wikisource . Lovecraft was a member of the pin-feathers .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Faces_at_Pine_Dunes">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RamseyCampbellWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Faces at Pine Dunes</rdfs:label>
    <ex:hasAnnotation>A young man reaches adulthood, his father reveals his family legacy of witchcraft . He sacrifices himself to let the boy claim his birthright as a scion of the great old ones .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>1980</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kaunuzoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Kaunuzoth</rdfs:label>
    <ex:hasAlternativeNamesC>Cannoosut</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Great One</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Samuel milligan is a fictional creature introduced in r.s. Cartwright's story " the moore dam monster "--a squat, sea cucumber-like monstrosity with five eyes, three-toed, taloned appendages, and a large mouth . He is described as one of gla'aki 's brethren, and dwells within the moore reservoir of vermont,</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Moore Dam Monster</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>R.S. Cartwright</ex:wasCreatedByC>
    <ex:wasCreatedByC>Samuel H. Milligan</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Leviathan_%28Nicholas_Almand%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Leviathan (Nicholas Almand)</rdfs:label>
    <ex:hasAnnotation>" leviathan " is a short story by nicholas almand . It is inspired by the works of howard phillips lovecraft . The story was published in the anthology of lovecraft-inspired works .</ex:hasAnnotation>
    <ex:hasAuthorW>Nicholas Almand</ex:hasAuthorW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Whispers_from_the_Abyss"/>
    <ex:wasPublishedOnW>November 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Fire_of_Asshurbanipal">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RobertEHowardWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Fire of Asshurbanipal</rdfs:label>
    <ex:hasAnnotation>A short story by robert e. howard that first appeared in the 1936 issue of weird tales . Although connected to the cthulhu mythos, the story ends with a suggestion that the events in the story have a rational explanation .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>December 1936</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#William_Dyer">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>William Dyer</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Miskatonic_University"/>
    <ex:hasAnnotation>1875 Professor of geology at Miskatonic University Miskatonic University Human First appearance HPL : At the Mountains of Madness HPL : The Shadow Out of Time EXP : " The City at the Two Magnetic Poles " Created by H. P. Lovecraft is a fictional character created by H. P. Lovecraft , who makes his first appearance in the 1936 novella At the Mountains of Madness . Description Dyer is a professor of geology at Miskatonic University in Arkham , Massachusetts, and the leader of the disastrous Pabodie Expedition to Antarctica in 1930–31. Only his last name is mentioned in the text of Mountains , though he is fully identified as , in Lovecraft's The Shadow Out of Time , where he accompanies an expedition to Australia's Great Sandy Desert. Gallery</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Shadow_Out_of_Time"/>
    <ex:hasAppearanceC>The City at the Two Magnetic Poles</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#At_the_Mountains_of_Madness"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Worse_Things_Waiting">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Worse Things Waiting</rdfs:label>
    <ex:hasAnnotation>Preceded by downward to darkness is a cthulhu mythos novel written by brian mcnaughton . It is a sequel to 1978's downward to darkness (aka satan's mistress) combines mcnaughton's trademark black humour, plenty of gore and sexuality .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_McNaughton"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasPageCountW>159</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1980</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Frontier_Cthulhu:_Ancient_Horrors_in_the_New_World">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Frontier Cthulhu: Ancient Horrors in the New World</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Steven Gilberts United States English Call of Cthulhu Fiction Chaosium Release Date November 2007 266 is an anthology of Cthulhu Mythos fiction released by Chaosium as part of their Call of Cthulhu Fiction line. Edited by William Jones and featuring cover art from Steven Gilberts, it was published in November 2007. Overview Contents "The Long Road Home" by Paul Melniczek "In Waters Black the Lost Ones Sleep" by Angeline Hawkes "Where Men Had Seldom Trod" by Lee Clark Zumpe "Something to Hold the Door Closed" by Lon Prater "Terror from Middle Island" by Durant Haire and Stephen Mark Rainey "Children of the Mountain" by Stewart Sternberg "They Who Dwell Below" by William Jones "Wagon Train for the Star" by Scott Lette " Incident at Dagon Wells " by Ron Shiflet "Ahiga and the Machine" by Robert J. Santa "The Dead Man's Hand" by Jason Andrew "Jedediah Smith and the Undying Chinaman" by Charles P. Zaglanis "Snake Oil" by Matthew Baugh "Cemetery, Nevada" by Tim Curran "The Rider of the Dark" by Darrell Schweitzer Gallery</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>266</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu Fiction</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>November 2007</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Edwin_Lillibridge">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Edwin Lillibridge</rdfs:label>
    <ex:ceasedOnC>1893</ex:ceasedOnC>
    <ex:hasAffiliationC>The Providence Telegram</ex:hasAffiliationC>
    <ex:hasAnnotation>Edwin m. lillibridge is a fictional character who appears in " the haunter of the dark " he is an "inquisitive reporter" who disappears while investigating the church of starry wisdom . Much of the backstory of the church and the shining trapezohedron is conveyed through his notes .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Haunter_of_the_Dark"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Lovecraft_Anthology:_Volume_II">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Lovecraft Anthology: Volume II</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft Various Cover Artist Francesco Francavilla United Kingdom English SelfMadeHero Release Date March 2012 128 is a collection of comic book adaptations of the works of H. P. Lovecraft . Overview With each story being adapted by a different writer and featuring illustrations from a different artist, was published in 2012 by SelfMadeHero. Contents " Pickman's Model " (Jamie Delano &amp; Steve Pugh) " The Temple " (Chris Lackey &amp; Adrian Salmon) " From Beyond " (David Camus &amp; Nicolas Fructus) " He " (Dwight L. MacPherson &amp; Paul Peart-Smith) " The Hound " (Chad Fifer &amp; Bryan Baugh) " The Nameless City " (Pat Mills &amp; Attila Futaki) " The Picture in the House " (Benjamin Dickson &amp; Mick McMahon) " The Festival " (Simon Spurrier &amp; Matt Timson) " The Statement of Randolph Carter " (Dan Lockwood &amp; Warwick Johnson Cadwell) See Also The Lovecraft Anthology: Volume I (2011)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>128</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>March 2012</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Joseph_Payne_Brennan">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Scholars"/>
    <rdfs:label>Joseph Payne Brennan</rdfs:label>
    <ex:diedOnR>28 January 1990</ex:diedOnR>
    <ex:hasAnnotation>Born in bridgeport, connecticut, his works were almost exclusively set in new england . Brennan's contributions to the magazine weird tales only cover a short period between 1952 and the end of the magazine's run in 1954 . In addition to writing prose, he was also an accomplished poet and literary critic .</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Connecticut Bridgeport</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>20 December 1918</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Zath">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Zath</rdfs:label>
    <ex:hasAnnotation>Ulthar Coroner Human First appearance HPL : " The Cats of Ulthar " Created by H. P. Lovecraft is a resident of the town of Ulthar where he works as a coroner. He was one of the town burgesses who helped pass the law that made it illegal to kill cats . ( HPL : " The Cats of Ulthar ")</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Cats_of_Ulthar"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Brandon_Barrows">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Brandon Barrows</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Comic book creator https://www.brandonbarrowscomics.com/ in an author, poet and comic book creator. He is best known for his work in the comic book industry, where his output includes a collection of adaptations of H. P. Lovecraft 's short stories, but he has also written prose about both the Cthulhu Mythos , and William Hope Hodgson 's occult investigator Thomas Carnacki . Selected Bibliography Short Fiction " Suck It Up, Get It Done " (2013) " The Madness of Arthur Malbrey " (2016, Thomas Carnacki ) Comic Book Adaptations Mythos: Lovecraft's Worlds (2016) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasWebsiteR>https://www.brandonbarrowscomics.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Comic book creator</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Devondra">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Devondra</rdfs:label>
    <ex:hasAnnotation>is a Lovecraftian -like eldritch entity from the fictional universe of Marvel by Marvel Comics. In Cthulhu Mythos terms she would presumably be a Great Old One . Background lives inside the pocket dimension within the Infinity Soul Gem, called Soul World. Devouring any souls that are sent into the gem. She can warp reality on a vast scale and if she devours enough souls, she can create a new reality.</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Johnny_Liddle">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Johnny Liddle</rdfs:label>
    <ex:hasAlternativeNamesC>Mad Hatter</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The white rabbitt was created by lewis carroll in 1865, first appearing in alice's adventures in wonderland . In 2008, it first appeared in zenescope entertainment's grimm fairy tales fictional universe, in the issue #1 of the 1st volume of grimm fairy tales: return to wonderland .</ex:hasAnnotation>
    <ex:hasAppearanceC>1st ( ADJ ): Grimm Fairy Tales: Return to Wonderland Vol 1 1</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC>Alice's Adventures in Wonderland</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Lewis Carroll</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Algol">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Stars"/>
    <rdfs:label>Algol</rdfs:label>
    <ex:hasAlternativeNamesL>Daemon-Star</ex:hasAlternativeNamesL>
    <ex:hasAnnotation>The daemon-star is a double (and possibly quintary) star mentioned by h. p. lovecraft as the sidereal home of a demonic shining entity made of light . The name is derived from an arabic phrase meaning "the demon's head" and concordantly occupies a place in the constellation of perseus often assigned to the head of medusa .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#Beyond_the_Wall_of_Sleep"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Hydra_%28Henry_Kuttner_entity%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Hydra (Henry Kuttner entity)</rdfs:label>
    <ex:hasAnnotation>Hydra Powers and Abilities Life-energy vampirism Limited dimensional travel First appearance CIRCLE : " Hydra " Created by Henry Kuttner The Hydra is a fictional creature created by American author Henry Kuttner for his short story " Hydra ". Overview An extra-dimensional being which feeds on the life essence of its victims, the Hydra requires a portal to be opened to enter universes other than its own; at least as far as the human race is concerned, it utilises cultists who lay honey-traps which grant the ability to project one's astral self. Once the ritual is enacted and the person has projected, a gateway to the Hydra's realm is opened, allowing it to enter our universe and claim its victim, which it does by beheading some poor unfortunate. This person's consciousness is then held in eternal torment whilst the Hydra takes its sustenance from him. The Hydra appears to dwell in the same plane of existence as the slumbering Outer God Azathoth ; indeed, it is entirely possible that the two were intended by Kuttner to be one and the same.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Hydra"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Henry_Kuttner"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Beyond_the_Wall_of_Sleep">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Beyond the Wall of Sleep</rdfs:label>
    <ex:hasAnnotation>H. p. lovecraft's "the green meadow memory" is a short story published in 1919 . Story was inspired by an article in the new york tribune about the catskills . Intern at a mental hospital relates his experience with a criminally insane murderer .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Inpesca">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Inpesca</rdfs:label>
    <ex:hasAlternativeNamesC>The Sea Horror</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Sea Horror First appearance EXP : " The Cyprus Shell " Created by Brian Lumley is a formless expansive bluish-black mass, haunting both the Ecuadorian and Peruvian coasts, mentioned in the Cthäat Aquadingen as inimical to the Deep Ones .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Cyprus_Shell"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Game_Changers">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Game Changers</rdfs:label>
    <ex:hasAnnotation>A squad of american gis lost behind enemy lines make their way to the site of a downed b-52 bomber . There, they discover an attempt to weaponise a hungry entity from another dimension . The story was first published in the brian m. sammons / glynn owen barrass -edited anthology world war cthulhu</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Stephen_Mark_Rainey"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>War</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#C._T._Phipps">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>C. T. Phipps</rdfs:label>
    <ex:hasAnnotation>Kat phipps is an american horror-fiction author and games designer from kentucky . His writing credits include several cthulhu mythos works, most notably the post-apocalyptic cthulhu armageddon series . His non-mythos author credits include the series the supervillainy saga and the united states of monsters .</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Kentucky Ashland</ex:hasBirthplaceR>
    <ex:hasFullNameR>Charles T. Phipps</ex:hasFullNameR>
    <ex:hasNationalityR>American</ex:hasNationalityR>
    <ex:hasWebsiteR>http://unitedfederationofcharles.blogspot.com/</ex:hasWebsiteR>
    <ex:hasWebsiteR>https://ctphipps.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1980 December 19</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Army_of_Darkness_%28comics%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Army of Darkness (comics)</rdfs:label>
    <ex:hasAnnotation>Army of darkness is an ongoing comic book franchise starring the character ash williams from the evil dead comedy-horror property . The series follows williams as he battles the forces of the supernatural, which usually involves the possessed grimoire the necronomicon ex-mortis .</ex:hasAnnotation>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>November 1992 - ongoing</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Innsmouth_Horror_Deluxe_Expansion_%28Arkham_Horror%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#ArkhamHorror"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Innsmouth Horror Deluxe Expansion (Arkham Horror)</rdfs:label>
    <ex:hasAnnotation>Innsmouth horror deluxe expansion was a big-box expansion set for fantasy flight games' board game of lovecraftian adventure, arkham horror . Included with the set are a host of new item, spell and ally cards for investigators to choose from, 32 spawn monsters showcasing the horrors found in that blighted town . It was chronologically the sixth to be released .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Kevin_Wilson"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Richard_Launius"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Action Adventure</ex:hasGenreW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Arkham_Horror"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Statement_of_One_John_Gibson">
    <rdf:type rdf:resource="http://example.org/lovecraft#BrianLumleyWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Statement of One John Gibson</rdfs:label>
    <ex:hasAnnotation>The story is presented as a transcript made by john gibson, born in 1957, of surrey, england . On his father's side he is descended from the "typers of new hampshire" on his mother's side he is from an old dutch family, the sleghts .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu_Candlemas_1984"/>
    <ex:wasPublishedOnW>February 1984</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Army_of_Darkness:_Ash_Gets_Hitched">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Army of Darkness: Ash Gets Hitched</rdfs:label>
    <ex:hasAnnotation>Steve Niles Nacho Tenorio English Dynamite Entertainment Release Date July 2014 - Nov 2014 Media Type Comic book is a 4-issue mini-series written by Steve Niles. It was published in 2014 by Dynamite Entertainment. Synopis Ash gets ready to marry Sheila back in 1300 AD, when a new threat arrives. It's a champion of the Army of Darkness , the Faceless Man; the most powerful monster that Ash has ever faced.</ex:hasAnnotation>
    <ex:hasAuthorW>Steve Niles</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>July 2014 - Nov 2014</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Doom_That_Came_to_Dunwich">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Doom That Came to Dunwich</rdfs:label>
    <ex:hasAnnotation>Before... 12:01 ...and after is a short story by the late american richard a. lupoff . It is a sequel to h.p. Lovecraft's "the dunwich horror" it was originally published in 1996 by fedogan &amp; bremer .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Richard_A._Lupoff"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Before... 12:01 ...and After</ex:isPublishedAsW>
    <ex:wasPublishedOnW>August 1996</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Happenings_of_December_13th,_2012">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Happenings of December 13th, 2012</rdfs:label>
    <ex:hasAnnotation>The story is the final instalment of book 1 of the nyarlathotep cycle . It details harjit singh's first encounter with the forces of the cthulhu mythos .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Troy_Young"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Nyarlathotep_Cycle"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Other:_Encounters_with_the_Cthulhu_Mythos_Book_1"/>
    <ex:wasPublishedOnW>2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Arkham_House_Books:_A_Collectors_Guide">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Arkham House Books: A Collector's Guide</rdfs:label>
    <ex:hasAnnotation>Leon Nielsen United States English Genre(s) Non-Fiction McFarland &amp; Co. Release Date 2004 Media Type Print Ebook is a non-fiction work by Leon Nielsen . Overview Intended as a reference guide for every book published by Arkham House up until 2004, A Collector's Guide contains a chronological list of the works featuring details such as editions, reprints, value, etc, and includes titles from the imprints Mycroft &amp; Moran and Stanton &amp; Lee . It is fully illustrated with dust jacket covers, and also includes a history of Arkham House and a biography of its first editor and co-founder, August Derleth . It should be noted that although the values of works given within were correct at the time of going to press, they are likely out of date in the current year. Publication History Compiled by Leon Nielsen, was first published by McFarland &amp; Co. in 2004.</ex:hasAnnotation>
    <ex:hasAuthorW>Leon Nielsen</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-Fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2004</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Nest_of_Pain">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Nest of Pain</rdfs:label>
    <ex:hasAnnotation>" crueltyslaves for the slaughter sect" is the third story in the arkham detective agency . It was written by american author c. j. henderson prior to his death in 2014 . The story is set in the fictional town of arkham created by h.p. Lovecraft .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#C._J._Henderson"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror Short Fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Arkham_Detective_Agency"/>
    <ex:wasPublishedOnW>November 2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crypt_of_Cthulhu_St._Johns_Eve_1986">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crypt of Cthulhu St. John's Eve 1986</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Allen Koszowski United States English Crypt of Cthulhu Cryptic Publications Release Date June 1986 64 Preceded by Roodmas 1986 Followed by Lammas 1986 is the 40th issue of long-running fanzine Crypt of Cthulhu . Running to a total of 64 , it was edited by Robert M. Price , featured cover art by Allen Koszowski , and was published in an A5 format by Cryptic Publications in June 1986 . The issue was a special, with the majority of its contents devoted to the works of accomplished American Robert Bloch . Contents Editorial Shards by Robert M. Price "The Sorcerer's Jewel" by Robert Bloch (writing as Tarleton Fiske) "Writer's Bloch" by Charles Garofalo "Eldritch Egypt" by Richard L. Tierney "On "The Feast in the Abbey"" by Randall D. Larson "Bloch on the Box" by Charles Garofalo "The Cthulhu Mythos Fiction of Robert Bloch" by Randall D. Larson Interview of Robert Bloch by Will Murray Interview of Robert Bloch by Randall D. Larson "More Mythos in Bloch" by Robert M. Price "The Hell Bound Train" by unknown "The Books of Robert Bloch: A Bibliography" by R. Dixon Smith Interior artwork by uncredited artist "It Pays to Increase Your Weird Power" by Jim Cort (quiz) "From the Vaults of Yoh-Vombis" by Lin Carter "New Tales of the Marvelous and the Ridiculous" by Stefan R. Dziemianowicz Reviews by Robert M. Price and Stefan Dziemianowicz Letters by Darrell Schweitzer , Allen Koszowski , Michael J. Lotus, Mark Morrison, Jim Cort, and S. T. Joshi References</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>64</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu"/>
    <ex:wasReleasedOnW>June 1986</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dagon">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Dagon</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones ( EXP )</ex:hasAffiliationC>
    <ex:hasAffiliationC>Lesser Old Ones ( EXP )</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Father Dagon</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>In the real world, or dagan was a deity worshipped in mesopotamia, particularly in what is now syria . He appears in the hebrew bible as a leading god of the philistines, notably in judges 16, where samson brings down the temple of where he is being held captive . In the short story "," written in 1917, the narrator finds ancient carvings that depict humanoid creatures with webbed hands and bulging eyes .</ex:hasAnnotation>
    <ex:hasAppearanceC>Dagon The Shadow Over Innsmouth The Holiness of Azédarac</ex:hasAppearanceC>
    <ex:hasAppearanceC>Innsmouth Harvest It Ends Where It Began</ex:hasAppearanceC>
    <ex:hasCharacterMateC rdf:resource="http://example.org/lovecraft#Mother_Hydra"/>
    <ex:madeFirstAppearanceOnC>Hebrew Bible</ex:madeFirstAppearanceOnC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Cultus">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Cultus</rdfs:label>
    <ex:hasAnnotation>P. marsh tri-monthly 1995 final publication 2001 is a now-defunct american small press horror magazine . It ran to a total of 18 sporadically-released issues between 1995 and 2001 . Its purview was weird, supernatural and horror fiction, with a particular focus on the cthulhu mythos established by h.p. Lovecraft .</ex:hasAnnotation>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Curse_of_the_Windsor_Witch">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Curse of the Windsor Witch</rdfs:label>
    <ex:hasAnnotation>The other: encounters with the cthulhu mythos book 3 was published in 2021 . It forms the fourth part of book 3 in his nyarlathotep cycle . The story is set in the fictional town of windsor, canada .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Troy_Young"/>
    <ex:hasCountryOfOriginW>Canada</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Nyarlathotep_Cycle"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Other:_Encounters_with_the_Cthulhu_Mythos_Book_3"/>
    <ex:wasPublishedOnW>2021</ex:wasPublishedOnW>
  </rdf:Description>
