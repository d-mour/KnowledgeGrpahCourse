    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu:_Le_mythe_-_Livre_III">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu: Le mythe - Livre III</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft Cover Artist Loïc Muzy France French Bragelonne Release Date September 2016 373 Preceded by Cthulhu: Le mythe - Livre II ( Cthulhu: The Myth - Book III ) is a French- translation of the works of H. P. Lovecraft . Running to a total of 373 , it was published by Bragelonne in a paperback format in September 2016, and features both cover and interior art by Loïc Muzy . Contents "Horreur à Red Hook" (" The Horror at Red Hook ") "Herbert West, réanimateur" (" Herbert West--Reanimator ") "La maison maudite" (" The Shunned House ") "La bête de la caverne" (" The Beast in the Cave ") "Le livre" (" The Book ") "Le modèle de Pickman" (" Pickman's Model ") "Les rats dans les murs" (" The Rats in the Walls ") "Je suis d'ailleurs" (" The Outsider ") "La tombe" (" The Tomb ") "L'indicible" (" The Unnamable ") "L'affaire Charles Dexter Ward" (" The Case of Charles Dexter Ward ") References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW rdf:resource="http://example.org/lovecraft#France"/>
    <ex:hasPageCountW>373</ex:hasPageCountW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:wasReleasedOnW>September 2016</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Our_Lady_of_Darkness">
    <rdf:type rdf:resource="http://example.org/lovecraft#FritzLeiberWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Our Lady of Darkness</rdfs:label>
    <ex:hasAnnotation>Fritz leiber's 1977 novella was repurposed as a source for the call of cthulhu campaign "our ladies of sorrow" it introduces the concepts of paramentals , megalopolisomancy and also references the magical powers of music for good and evil .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecraftiana_Vol_5,_Issue_2">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraftiana Vol 5, Issue 2</rdfs:label>
    <ex:hasAnnotation>Various Dean Wirth Cover Artist Javier García Ureña English Rogue Planet Press Release Date July 2020 103  is an edition of the digital zine Lovecraftiana which was edited by Gavin Chappell and published by Rogue Planet Press in July 2020. Both physical and digital editions were released. Cover art featuring Dr. Herbert West was supplied by Javier García Ureña, with interior illustrations by Dean Wirth . Contents " Sun and Sentinel " by Avery Kit Malone " Windows to the Soul " by Time Kane " Deconstruction " by Harris Coverly " Shreds of a Suit on a Library Floor " by R. C. Mulhare " The Tower of Dreams " by Mike Adamson " The Seen and the Unseen " by Tim Stevens " Acquired Through Deaccession " by Lee Clark Zumpe " The Green Fireballs " by Jason Radak " Prom Night, or Whateley Family Happiness " by G. Large " Gnashing Whispers " by David Kenney " The Riddle of Jeremy Roman " by Dean Wirth " Memory " by Josh Maybrook " A Vision " by Kieran Dacey Boylan " Strangeness of the Night " by Kieran Dacey Boylan " Horror Fiction " by Kieran Dacey Boylan " Alive " by Kieran Dacey Boylan " Obsidian Eyes " by Kieran Dacey Boylan</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>103</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>July 2020</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Oorn">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Oorn</rdfs:label>
    <ex:hasAnnotation>A pudgy creature with short grey-colored fur and three small red eyes, is believed to have originated from the mysterious "outer abyss" it hasn't demonstrated actual intelligence, but does have the ability to mimic speech . The shamith priests of zeth have declared it to be a god and oracle .</ex:hasAnnotation>
    <ex:hasCharacterMateC rdf:resource="http://example.org/lovecraft#Mnomquah"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Hoard_of_the_Wizard-Beast"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#R._H._Barlow"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Galactus_%28Mangaverse%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Galactus (Mangaverse)</rdfs:label>
    <ex:hasAnnotation>The galactus of mangaverse is a living planet created by the skrulls, in service to the dark god mephisto . It was defended by a field of asteroids which it used as weapons to destroy a planet's defenses and then bombard the world . The planetoid had a continent-sized cyclopean eye and several planetary-length tentacles which at the tip were as thick as cities .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#James_S._Dorr">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>James S. Dorr</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author United States Horror Fantasy https://jamesdorrwriter.wordpress.com/ is an author and poet based in Indiana, United States, who has written a number of works set in the Cthulhu Mythos established with the works of Howard Phillips Lovecraft and his circle of friends. Focusing primarily on the horror and fantasy genres, his works have been published in anthologies such as Future Lovecraft , The Children of Cthulhu , Cthulhu Christmas Special and Other Lovecraftian Yuletide Tales , and Deep Fried Horror Cthulhu Cheese Burger , as well as the Lovecraftian magazine Arkham Tales . Amongst others, Dorr counts Ray Bradbury and Edgar Allan Poe as his influences . Selected Bibliography Short Fiction " A Christmas Carnage " (2017) " The Reading: Three Variants on a Theme " (2020) External Links at the Internet Speculative Fiction Database at Goodreads References</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://jamesdorrwriter.wordpress.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Lovecraft_Anthology:_Volume_I">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Lovecraft Anthology: Volume I</rdfs:label>
    <ex:hasAnnotation>Various Various Cover Artist Ben Templesmith United Kingdom English SelfMadeHero Release Date 2011 is a collection of comic book adaptations of the works of H. P. Lovecraft . Contents " The Call of Cthulhu " (Ian Edginton &amp; D'Israeli) " The Haunter of the Dark " (Dan Lockwood &amp; Shane Ivan Oakley) " The Dunwich Horror " (Rob Davis &amp; I. N. J. Culbard ) " The Colour Out of Space " (David Hine &amp; Mark Stafford) " The Shadow Over Innsmouth " (Leah Moore, John Reppion &amp; Leigh Gallagher) " The Rats in the Walls " (Dan Lockwood &amp; David Hartman) " Dagon " (Dan Lockwood &amp; Alice Duke) See also The Lovecraft Anthology: Volume II (2012)</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2011</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Surama">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Surama</rdfs:label>
    <ex:hasAffiliationC>Dr. Alfred Clarendon</ex:hasAffiliationC>
    <ex:hasAnnotation>Dr. alfred clarendon is a character created by h. p. lovecraft and adolphe de castro for their short story " the last test " he is a bald, clean-shaven and abnormally lean man . He also has some form of psychic perception that allows him to pick up images and ideas from the minds of others . His personality is noted for his keen intellect, but also for his sardonic demeanor, as seen in the way he treats test animals .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Last_Test"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Adolphe_de_Castro"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Haunter_of_the_Dark_%28DART_production%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAudioAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Haunter of the Dark (DART production)</rdfs:label>
    <ex:hasAnnotation>The haunter of the dark is a dark adventure radio theatre production by the h. p. lovecraft historical society . Based on lovecraft's short story of the same name . Comes complete with a set of period-authentic props to enhance the immersive experience .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Haunter_of_the_Dark"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Hydra">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Disambiguations"/>
    <rdfs:label>Hydra</rdfs:label>
    <ex:hasAnnotation>may refer to one of the following articles: , a creature created by Henry Kuttner . " ", a short story by Henry Kuttner . Mother , related to Dagon and the Deep Ones , and created by H.P. Lovecraft in The Shadow Over Innsmouth . The Lernaean , a creature from Greek mythology which has been incorporated into the Mythos.</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bug_of_the_Stars">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Bug of the Stars</rdfs:label>
    <ex:hasAnnotation>History is a short lovecraftian story by evan rodenhausen . It was published in the lovecraftiana zine in 2020 .</ex:hasAnnotation>
    <ex:hasAuthorW>Evan Rodenhausen</ex:hasAuthorW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 1</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 5</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Eliza_W._Gardner">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Eliza W. Gardner</rdfs:label>
    <ex:diedOnR>26 March 1846</ex:diedOnR>
    <ex:hasAnnotation>Wife of Whipple Phillips, whom she married 10 March 1830. She gave birth to four children: Mary Brayton, Theodore Winthrop, William Henry, and an unnamed infant daughter who died soon after birth.</ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1809</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Christopher_Sequeira">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Christopher Sequeira</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Editor Sydney, New South Wales, Australia Australia is an Australian author, editor and comic book creator who has worked on several Cthulhu Mythos anthologies. His editorial credits include the Cthulhu Deep Down Under series; he has also had a hand in several works set in the Sherlock Holmes shared universe, including anthologies and short fiction. Many of his works have been published through IFWG Publishing . Selected Bibliography Editor Cthulhu Deep Down Under: Volume 1 (2015, with Steve Proposch and Bryce Stevens ) Cthulhu Deep Down Under: Volume 2 (2018, with Steve Proposch and Bryce Stevens) Cthulhu: Land of the Long White Cloud (2018, with Steve Proposch and Bryce Stevens) Cthulhu Deep Down Under: Volume 3 (2021, with Steve Proposch and Bryce Stevens) External Links at Wikipedia at the Internet Speculative Fiction Database at Goodreads References</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#Australia New South Wales Sydney</ex:hasBirthplaceR>
    <ex:hasNationalityR>http://example.org/lovecraft#Australia</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Games_Workshop">
    <rdf:type rdf:resource="http://example.org/lovecraft#Publishers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Games Workshop</rdfs:label>
    <ex:hasAnnotation>In 1975 by steve jackson, ian livingston, and john peake, started out selling traditional gaming accessories such as game boards through a mail order service . Gained traction in the gaming industry after landing distribution rights for tsr, inc.'s fantasy roleplaying game . Produced a number of supplements for another of chaosium's franchises, call of cthulhu .</ex:hasAnnotation>
    <ex:hasWebsiteR>https://www.warhammer.com/en-GB/home</ex:hasWebsiteR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Hungry_One_Must_Feed">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Hungry One Must Feed</rdfs:label>
    <ex:hasAnnotation>Apathetic soul discovers his true calling after inheriting an unusual cat from his deceased neighbour . Creature pupates into an insectile monstrosity which wishes to lay its eggs into the man's still-living flesh .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mark_McLaughlin"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecraftian_Tales:_Volume_1">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraftian Tales: Volume 1</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Heather Landry English Ulthar Press Release Date April 2017 151 is an anthology of Lovecraftian fiction edited by Matthew Carpenter and Alex Kreitner and published by Ulthar Press in April 2017. Both paperback and digital editions were released . Each of the seven stories comes acompanied by its own original piece of artwork, with each piece created by a different artist. The featured artists were Isaac Passwater, Jesse Campbell, Maxima Fobia, Max Martelli, Nikos Alteri, Aaron White, and Sean O'Keefe . Contents "Discarded" by Sarah Walker "Floater" by Richard Lee Byers "The Library of Leng" by Sebastian Normandin "Elder Gods in the Machine" by D. F. Shultz "The Innsmouth Run" Paul McNamee "Jonas Bell Presents The King in Yellow" by James Pratt "Prisoners of an Invisible Labyrinth" by Joshua Dobson Gallery</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>151</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>April 2017</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Abraham_Merritt">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsCoAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsInspirationsAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Abraham Merritt</rdfs:label>
    <ex:diedOnR>1943 August 21st</ex:diedOnR>
    <ex:hasAnnotation>Born in new jersey, he moved to philadelphia, pennsylvania, in 1894 . He was assistant editor of the american weekly from 1912 to 1937 . He died suddenly of a heart attack, at his winter home in indian rock keys, florida .</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#New_Jersey</ex:hasBirthplaceR>
    <ex:hasFullNameR>Abraham Grace Merritt</ex:hasFullNameR>
    <ex:hasNationalityR>American</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Co-author ( The Challenge from Beyond )</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Inspiration to H. P. Lovecraft</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1884 January 20th</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#LovecraftsInspirationsWorks">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Location"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Pushing_the_Sky_Away_%28Death_of_a_Blasphemer%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#CaitlinRKiernanWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Pushing the Sky Away (Death of a Blasphemer)</rdfs:label>
    <ex:hasAnnotation>Pushing the Sky Away (Death of a Blasphemer) Caitlin R. Kiernan English Sirenia Digest date August 2013 "Pushing the Sky Away (Death of a Blasphemer)" is a short story by Caitlin R. Kiernan that first appeared in the August 2013 issue of Sirenia Digest (#91). Synopsis The story tells of Elisheba, a thief dying in a labyrinth after stealing two treasures from the Ghul. The dying thief is attended by a succubus. History The story's first appearance in print was in Kiernan's collection Houses Under the Sea: Mythos Tales ( Subterranean Press , 2019).</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Sirenia_Digest"/>
    <ex:wasPublishedOnW>August 2013</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Rat_God_%28being%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Rat God (being)</rdfs:label>
    <ex:hasAnnotation>The rat god is a fictional monster created by richard corben for his comic book series of the same name . It serves as the mysterious deity venerated by the people of lame dog, massachusetts . Its origins are unknown, but it has been alive since prehistory .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Rat_God"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Richard_Corben"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mount_Voormithadreth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Mount Voormithadreth</rdfs:label>
    <ex:hasAnnotation>Hyperborea is a continent that was in the arctic who is said to be a warm and fertile paradise . The toad-goat god tsathoggua used to live there and the spider-god atlach-nacha was also living there .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Fillmore_Shoggoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Fillmore Shoggoth</rdfs:label>
    <ex:hasAnnotation>The madness of cthulhu is a short story by american author harry turtledove . It was published in the anthology the madness of cthulhu by titan books in october 2014 . The story is set in a world in which humankind coexists with the elder ones following the discoveries of the pabodie expedition .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Harry_Turtledove"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Madness_of_Cthulhu"/>
    <ex:wasPublishedOnW>October 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Pierre_%28The_Alchemist%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Pierre ("The Alchemist")</rdfs:label>
    <ex:hasAnnotation>Pierre was the servant of the young antoine de c-- , from the story " the alchemist " by h. p. lovecraft . Antoine was near the age of thirty when the elderly pierre died, presumably of natural causes .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Alchemist"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Jermyn_family">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Jermyn family</rdfs:label>
    <ex:ceasedOnC>1913 (lineal extinction) Aug 3</ex:ceasedOnC>
    <ex:hasAnnotation>The and their history is the basis of the story "facts concerning the late arthur jermyn and his family " by h. p. lovecraft . Little is mentioned of the family's history prior to the birth of sir wade jermyn . Lovecraft described him as a poet and scholar who had come to accept his unusual appearance .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Facts Concerning the Late Arthur Jermyn</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>His Family</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Edward_Pickman_Derby">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Edward Pickman Derby</rdfs:label>
    <ex:hasAnnotation>H. p. lovecraft was a poet and the husband of asenath waite . Lovecraft's depiction of derby's childhood is considered to be in large part autobiographical . Lovecraft evoked his protégé frank belknap long, whom he teased for his moustache .</ex:hasAnnotation>
    <ex:hasCharacterMateC rdf:resource="http://example.org/lovecraft#Asenath_Waite"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Thing_on_the_Doorstep"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Bones_of_the_Old_Ones">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Bones of the Old Ones</rdfs:label>
    <ex:hasAnnotation>"the avatars of the old ones" is a short story set in the dystopian sci-fi setting of punktown . It was first published in and other lovecraftian tales by necropolitan press in 1995 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Jeffrey_Thomas"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Punktown"/>
    <ex:isPublishedAsW>Other Lovecraftian Tales</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1995</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dolmen_of_the_Moon">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dolmen of the Moon</rdfs:label>
    <ex:hasAnnotation>Narrator (fr. Wm. Von junzt) realises he has reached a doorway behind which lurks a being of great power . Published in the anthology weirdbook annual 2 by wild</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Deuce_Richardson"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Weirdbook Annual 2</ex:isPublishedAsW>
    <ex:wasPublishedOnW>February 2019</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Charles_St._Cyprian">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Charles St. Cyprian</rdfs:label>
    <ex:hasAffiliationC>The Crown of Great Britain</ex:hasAffiliationC>
    <ex:hasAnnotation>St. cyprian is the protagonist of a series of occult detective stories created by josh reynolds . The character has appeared in at least one story directly tied to the cthulhu mythos . He is known to have been the protégé of esteemed occultist thomas carnacki in the years before his appointment to the crown .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Krampusnacht (2011)</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Josh_Reynolds"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Daniel_Upton">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Daniel Upton</rdfs:label>
    <ex:hasAnnotation>Architect Human First appearance HPL : " The Thing on the Doorstep " Created by H. P. Lovecraft is a fictional character and the narrator of H.P. Lovecraft 's short story " The Thing on the Doorstep ". He is an architect and the best friend of the story's protagonist, Edward Pickman Derby . Overview In Fritz Lieber 's short story " To Arkham and the Stars ", Upton is mentioned as having designed Miskatonic University 's new Administration Building and its Pickman Nuclear Laboratory, as well as Arkham 's Polish Quarter apartment development. Albert Wilmarth remarks that Upton "has had a distinguished career ever since he was given a clean bill of mental health and discharged with a verdict of ‘justified homicide’."</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Thing_on_the_Doorstep"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Grey_skies_at_dusk_fall:">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Grey skies at dusk fall:</rdfs:label>
    <ex:hasAnnotation>Grey skies at dusk fall: Full story online here Phillip A. Ellis English Nightscapes #16 date October 2006 " Grey skies at dusk fall: " is a Cthulhu Mythos poem by Phillip A. Ellis . Synopsis The six four-line verses form a vignette of Devil Reef on the eve of the United States Navy attack on the underwater city of Y'ha-nthlei . History "Grey skies at dusk fall:" was published in the online Mythos zine Nightscapes in October 2006.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Phillip_A._Ellis"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Nightscapes #16</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2006</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#ElderGods">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Character"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Britannica:_London">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Britannica: London</rdfs:label>
    <ex:hasAnnotation>Various English Call of Cthulhu Genre(s) Roleplaying game Cubicle 7 Entertainment Release Date 2015 is a setting supplement for Chaosium 's Call of Cthulhu horror roleplaying game. Created by an ensemble lineup of games designers, it was published by Cubicle 7 Entertainment in 2015. Unusually for a roleplaying game supplement, it was released as a boxed set containing three books as well as maps and handouts. holds a middling rating of 6.11/10 on roleplaying games aggregate site RPG.net , and a high review of 9.1/10 on RPGGeek . Overview Designers Stuart Boon Steve Dempsey Paula Dempsey Scott Dorward Paul Fricker Andrew Kenrick James King Bret Kramer Mark Latham Alistair Montgomery Scott Purdy Marc Torley James Wallis Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Thing_in_the_Jar">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Thing in the Jar</rdfs:label>
    <ex:hasAnnotation>Carlton herzog's lovecraftian short story first published in zine in 2020 . Story concerns a man born with severe physical abnormalities . He stumbles across an ancient organism buried in a jar in his back garden . The being offers to construct knock a new body if he provides a sacrificial form .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Carlton_Herzog"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 3</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 5</ex:isPublishedAsW>
    <ex:wasPublishedOnW>31 October 2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Curse_of_Yig">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Curse of Yig</rdfs:label>
    <ex:hasAnnotation>Yig, "the father of serpents", is a 1928 short story by h.p. Lovecraft and zealia bishop . It was the first of three tales lovecraft wrote for bishop, the others being "the mound" and "medusa's coil "</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Howard_Phillips_Lovecraft"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Zealia_Bishop"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Cthulhu Mythos</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#James_Blish">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsCorrespondents"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>James Blish</rdfs:label>
    <ex:diedOnR>30 July 1975</ex:diedOnR>
    <ex:hasAnnotation>James benjamin blish was a prominent american author of science fiction, fantasy, and horror . As a teenager in 1936, he and his friend william miller corresponded briefly with h.p. Lovecraft . In high school, he published a fanzine called planeteer that ran for six issues .</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#New_Jersey East Orange</ex:hasBirthplaceR>
    <ex:hasNationalityR>American</ex:hasNationalityR>
    <ex:isKnownForR>More Light</ex:isKnownForR>
    <ex:wasBornOnR>23 May 1921</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Curse_of_Yig_%28DART_production%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAudioAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Curse of Yig (DART production)</rdfs:label>
    <ex:hasAnnotation>The curse of yig is a dark adventure radio theatre production by the h. p. lovecraft historical society . It is an adaptation of lovecraft and bishop's story from which it takes its name . It runs to a total of 77 minutes, and comes with a set of period-authentic props to enhance the immersive experience for the listener .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Curse_of_Yig"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Claire">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Claire</rdfs:label>
    <ex:hasAnnotation>Is a lovecraftian short story by a. henry keene . Published in the james ward kirk publishing thematic anthology lovecraft after dark in november 2015 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#A._Henry_Keene"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Lovecraft_after_Dark"/>
    <ex:wasPublishedOnW>November 2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tchtkaa">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Tch'tkaa</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Atlach-Nacha"/>
    <ex:hasAnnotation>Atlach-Nacha Gray Weaver First appearance EXP : " The Descent into the Abyss " Created by Lin Carter is a character created by Lin Carter for his short story " The Descent into the Abyss ". It is a multi-legged creature and the prototype of the Gray Weavers who serve Atlach-Nacha , being the first-born member of the . Its speech has been described as "dry and rasping but not discourteous".</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Descent_into_the_Abyss"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthaat_Aquadingen:_A_Guide_to_Further_Research">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthaat Aquadingen: A Guide to Further Research</rdfs:label>
    <ex:hasAnnotation>Cthaat Aquadingen : A Guide to Further Research Carl T. Ford English Genre(s) Non-fiction Cryptic Publications Crypt of Cthulhu Hallowmas 1987 date November 1987 " Cthaat Aquadingen : A Guide to Further Research " is a short non-fiction piece by the late editor, and Carl T. Ford . It appeared in the Hallowmas 1987 edition of Robert M. Price 's long-running Lovecraftian fanzine Crypt of Cthulhu . References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Carl_T._Ford"/>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
