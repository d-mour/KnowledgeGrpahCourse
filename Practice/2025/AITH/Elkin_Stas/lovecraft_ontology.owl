  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Shadow_Over_Innsmouth">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Shadow Over Innsmouth</rdfs:label>
    <ex:hasAnnotation>The narrator is a student on an antiquarian tour of new england . He sees exotic jewelry in a museum, and learns its source is a seaport . A local resident tells him a horrifying story of aquatic monsters . He flees, but finds that his pursuers are hybrid monsters .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror novella</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Farnsworth_Wright">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Farnsworth Wright</rdfs:label>
    <ex:diedOnR>1940 12 June</ex:diedOnR>
    <ex:hasAnnotation>Wright was a veteran of world war i when he began his association with weird tales . He replaced founding editor edwin bailrd in 1924 when the latter was fired . He had a strained relationship with all three writers, rejecting major works .</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA http://example.org/lovecraft#California Santa Barbara</ex:hasBirthplaceR>
    <ex:hasChildrenR>Robert Wright</ex:hasChildrenR>
    <ex:hasNationalityR>American</ex:hasNationalityR>
    <ex:hasPseudonymR>Francis Hard</ex:hasPseudonymR>
    <ex:isConnectedToMythosR>Publisher</ex:isConnectedToMythosR>
    <ex:isKnownForR rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasBornOnR>1888 29 July</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Amateur_Press_Works">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Amateur Press Works</rdfs:label>
    <ex:hasAnnotation>George T. Wetzel United States English Genre(s) Non-fiction SSR Publications Bibliographies date 1955 " " is a short non-fiction piece by the late American and H. P. Lovecraft scholar George T. Wetzel . As it’s name might suggest, it charts Lovecraft's writings published through the amateur press industry. History Bibliographies (1955) Howard Phillips Lovecraft: Memoirs, Critiques &amp; Bibliographies (1955)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#George_T._Wetzel"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Bibliographies</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1955</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#B._A._Lee">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>B. A. Lee</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Writer United States https://www.merzo.net/ContactUs.htm is an American writer most famous for their work on the Russell's Guide series of Cthulhu Mythos books (independently published between August 2015 and October 2016 with J. Alan Russell ) and the unrelated novel Merrow Tale (2016). From the author's : Notable Works Russell's Guide to Interdimensional Entities (2015, with J. Alan Russell ) Russell's Guide to Interdimensional Entities, Artefacts and Incantations (2016, with J. Alan Russell) External Links at Goodreads</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://www.merzo.net/ContactUs.htm</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Writer</ex:isConnectedToMythosR>
  </rdf:Description>
