    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraft and Benefit Street</rdfs:label>
    <ex:hasAnnotation>Dorothy C. Walker United States English Genre(s) Non-fiction Driftwind Press date 1943 " " is a short non-fiction piece by American Dorothy C. Walker . It was first published in the Driftwind Press chapbook to which it lends its name in 1943. History (1943) Rhode Island on Lovecraft (1945, 1946) Lovecraft Remembered (1998)</ex:hasAnnotation>
    <ex:hasAuthorW>Dorothy C. Walker</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
