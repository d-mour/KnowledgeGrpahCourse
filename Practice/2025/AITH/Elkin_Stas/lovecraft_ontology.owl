    <ex:wasPublishedOnW>August 2013</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Comte_Louis_de_C--">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Comte Louis de C--</rdfs:label>
    <ex:hasAnnotation>Comte Louis de C-- Relatives Comte Robert de C-- (father) Comte Antoine de C-- (descendant) Nobleman Human First appearance HPL : " The Alchemist " Created by H. P. Lovecraft Comte Louis de C-- (no surname given) was a French count in the story " The Alchemist " by H. P. Lovecraft . He was the son of Comte Robert and an ancestor of Comte Antoine . Like other members of his line, Louis was killed at the age of 32, a victim of the curse put on his family by Charles le Sorcier who drowned Louis in the castle moat. Behind the Mythos In the comic book adaptation from The Worlds of H. P. Lovecraft series, the C-- stands for Chabrillane.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Alchemist"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Wailer_Below_%28Call_of_Cthulhu_LCG%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Wailer Below (Call of Cthulhu LCG)</rdfs:label>
    <ex:hasAnnotation>The Wailer Below Fantasy Flight Games Publication Date 2010 Living Card Game Call of Cthulhu: The Card Game The Wailer Below is an expansion pack for Fantasy Flight Games ' Call of Cthulhu: The Card Game . Overview The fourth Asylum Pack in The Yuggoth Contract Cycle series of expansions, The Wailer Below contains 60 cards in the standard division of three sets of 20 unique cards. First released in 2010, it was discontinued with the demise of Call of Cthulhu: The Card Game . Contents Sam Archer, Private Investigator (Character; The Agency) Exploring the Ruins (Event; The Agency) Degenerate Serpent Cultist (Character; Cthulhu ) Cthulhu, Lord of R'lyeh (Character; Cthulhu) Deep One Scout (Character; Cthulhu) Renowned Sculptor (Character; Hastur ) Wraith (Character; Hastur) Field Research Station (Support; Miskatonic University ) Derby Hall, M.U. Dormitory (Support; Miskatonic University) Museum Curator (Character; Miskatonic University) Taming the Storm (Conspiracy; Neutral) Getaway Vehicle (Support; Neutral) Feasting Ghoul s (Character; Shub-Niggurath ) Optic Warehouse (Support; Shub-Niggurath) Smugglers (Character; Syndicate) Eyes in a Jar (Support; Syndicate) Meat Wagon (Support; Syndicate) Curse of the Stone (Event; Yog-Sothoth ) Doppelganger (Character; Yog-Sothoth) Cultist of the Key (Character; Yog-Sothoth)</ex:hasAnnotation>
    <ex:wasPublishedOnW>2010</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dragon_of_the_Moon">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Dragon of the Moon</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Set"/>
    <ex:hasAnnotation>The is an eldritch lovecraftian entity from the fictional universe of marvel by marvel comics . It was created in 1984 by peter b. gillis and don perlin, making its first appearance in issue #138 of the defenders comic book series . The dragon has claimed to be responsible for committing various evils but it is a great liar, and thus many of its claims are difficult to verify .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Defenders Vol 1 #138</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Don Perlin</ex:wasCreatedByC>
    <ex:wasCreatedByC>Peter B. Gillis</ex:wasCreatedByC>
  </rdf:Description>
