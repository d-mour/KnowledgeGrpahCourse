    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>June 2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sherlock_Holmes">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Sherlock Holmes</rdfs:label>
    <ex:hasAnnotation>Holmes is a fictional character created by the late british author arthur conan doyle, who made his first appearance in the 1887 novel a study in scarlett . In the years since, many other authors have also given their own takes on the character, and the body of fiction surrounding him likely numbers in the tens of thousands . Holmes is considered one of the greatest detectives of his age, perhaps the greatest in history .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>A Study in Scarlett</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Arthur Conan Doyle</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cerberus">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Cerberus</rdfs:label>
    <ex:hasAffiliationC>Olympians (Greek Gods)</ex:hasAffiliationC>
    <ex:hasAnnotation>The is a monster of greek mythology, which fought hercules . The marvel adaptation was created in 1966 by stan lee and jack kirby .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Thor Vol #130</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Jack Kirby</ex:wasCreatedByC>
    <ex:wasCreatedByC>Stan Lee</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#League_of_Light">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdfs:label>League of Light</rdfs:label>
    <ex:hasAnnotation>Team is made up of protectors. Legacy heroes whom inherited their powers from bloodlines. Whom are the protectors of their respective continents . Brought together by the chosen one, ash williams to fight the deadites and prevent the apocalypse . Failed to prevent the conquest of earth by the deadites and the extermination of the human race .</ex:hasAnnotation>
    <ex:hasNotableMemberO rdf:resource="http://example.org/lovecraft#Ash_Williams"/>
    <ex:hasNotableMemberO rdf:resource="http://example.org/lovecraft#Cybil"/>
    <ex:hasTypeO>team</ex:hasTypeO>
    <ex:wasCreatedBynO>Mike Raicht</ex:wasCreatedBynO>
  </rdf:Description>
