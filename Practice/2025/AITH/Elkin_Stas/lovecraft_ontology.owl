    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Opener of the Way (story)</rdfs:label>
    <ex:hasAnnotation>"the opener of the way" is a short story by robert bloch that appeared in the october 1936 issue of weird tales . It served as the title story of bloch's first collection, the opener of the way (1945) it is included in the third edition of his collection of mythos fiction, mysteries of the worm .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_Bloch"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>October 1936</ex:wasPublishedOnW>
  </rdf:Description>
