  <rdf:Description rdf:about="http://example.org/lovecraft#Not_One_the_Same">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Not One the Same</rdfs:label>
    <ex:hasAnnotation>A violent storm awakens ithaqua the wind-walker . The creature then proceeds to possess the bodies of two young people . It is the first stage of the conquest of planet earth .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#J._B._Lee"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>January 1998</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Revelations_from_Yuggoth_3">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Revelations from Yuggoth 3</rdfs:label>
    <ex:hasAnnotation>Revelations from yuggoth #3 was the third and final issue of shawn ramsey's short-lived fanzine revelations from yuggoth . Edited by ramsey, it ran to a total of 68 in an a5 format and was published by cryptic publications in february 1989 . Cover art was by peter smith, and it featured interior pieces from smith, robert g. knox, and allen koszowski .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>68</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Revelations_from_Yuggoth"/>
    <ex:wasReleasedOnW>February 1989</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dark_Demon">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dark Demon</rdfs:label>
    <ex:hasAnnotation>Cthulhu mythos short story first appeared in the november 1936 issue of weird tales . It features a reclusive writer of weird fiction who is a thinly veiled portrait of lovecraft . Narrator is "a hopeful (and at times, hopeless) amateur writer" who is "last of all of friends"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_Bloch"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>November 1936</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Jeffrey_Combs_Reads_H._P._Lovecrafts_Herbert_West_-_Re-Animator">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAudioAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Jeffrey Combs Reads H. P. Lovecraft's Herbert West - Re-Animator</rdfs:label>
    <ex:hasAnnotation>Jeffrey Combs Reads H. P. Lovecraft's Herbert West- Re-Animator Based on " Herbert West--Reanimator " Jeffrey Combs Production Company Beyond Books Release date 1999 Running time 72 minutes (approx.) English is an audio reading of Howard Phillips Lovecraft 's episodic short story " Herbert West--Reanimator " by Jeffrey Combs , the actor who portrayed Herbert West in Stuart Gordon 's screen adaptation. Overview Herbert West - Reanimator was released on compact disc by Beyond Books in 1999. It runs to a total of 72 minutes and is an abridged version of the original tale.</ex:hasAnnotation>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#Herbert_West--Reanimator"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1999</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crypt_of_Cthulhu_Roodmas_1984">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crypt of Cthulhu Roodmas 1984</rdfs:label>
    <ex:hasAnnotation>Crypt of cthulhu is the 22nd issue of leading h. p. lovecraft scholar robert m. price's long-running fanzine . Edited by price, it featured cover art by allen koszowski . It ran to a total of 64 in an a5 format .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>64</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu"/>
    <ex:wasReleasedOnW>May 1984</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Feaster_from_the_Stars">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Feaster from the Stars</rdfs:label>
    <ex:hasAnnotation>": the history of yzduggor the eremite" is a horror fantasy short story set in the ancient continent of hyperborea . It was first published in the magazine crypt of cthulhu #26 ( hallowmas 1984 ) billed as by clark ashton smith and lin carter .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Cryptic Publications Hallowmas 1984</ex:isPublishedAsW>
    <ex:wasPublishedOnW>November 1984</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#City_of_Living_Shadows_%26_More_Lovecraftian_Tales">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>City of Living Shadows &amp; More Lovecraftian Tales</rdfs:label>
    <ex:hasAnnotation>Mark McLaughlin Michael Sheehan, Jr. English Independent Release Date August 2019 120 is a collection of short stories by authors Mark McLaughlin and Michael Sheehan, Jr. Overview Containing five stories and running to a total of 120 , was independently published in August 2019. Most of the stories were reprinted in the digital collection Nightmares &amp; Tentacles: 13 Tales Of The Cthulhu Mythos . Contents "City of Living Shadows" "Pyramid of The Shoggoths" "The Black-and-White House" " The Ambassador from Ulthar " "The Idol in the Hedge Maze"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mark_McLaughlin"/>
    <ex:hasAuthorW>Michael Sheehan. Jr.</ex:hasAuthorW>
    <ex:hasPageCountW>120</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>August 2019</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Jupiter_%28Rifts%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Jupiter (Rifts)</rdfs:label>
    <ex:hasAnnotation>Jupiter is a malevolent alien intelligence worshiped by man, including the ancient romans . It enjoys causing sorrow, death, suffering, destruction, and torture . In its humanoid form it is nine feet tall but is fifteen feet tall and twenty feet in diameter in its true form .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Rifts"/>
    <ex:wasCreatedByC>Palladium Games</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mark_Berkenwald">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Mark Berkenwald</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Arkham_Detective_Agency"/>
    <ex:hasAnnotation>Private investigator Arkham Detective Agency Human First appearance EXP : " The Nest of Pain " Created by C. J. Henderson is a supporting character created by the late American author C. J. Henderson for his Arkham Detective Agency series of hard-boiled/ Cthulhu Mythos stories. A founding partner in the supernaturally-focussed Arkham Detective Agency , Berkenwald is portrayed as neither as senior nor as outspoken as the series' main protagonist, Frank Nardi . Appearances " The Nest of Pain " " Family Tradition " " Those Folk Below "</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Nest_of_Pain"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#C._J._Henderson"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#John_Richmond">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>John Richmond</rdfs:label>
    <ex:hasAnnotation>Fisherman Human First appearance HPL : " The Green Meadow " Created by H. P. Lovecraft and Elizabeth Berkeley was, along with Peter B. Carr and Simon Canfield , a member of the three-man fishing party responsible for dragging a 360-pound metallic rock ashore after it crashed into the water off the coast of Potowonket, Maine . The object fell from the sky on Wednesday, August 27, 1913, at approximately 8:30 PM. The fishing party retrieved the object the following Sunday, August 31.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Green_Meadow"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasCreatedByC>Elizabeth Berkeley</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Keeper_of_Memory">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Keeper of Memory</rdfs:label>
    <ex:hasAnnotation>Return of the old ones: apocalyptic lovecraftian horror is a short story by american christine morgan . The story is set in a far future where the earth has been conquered by malevolent gods .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Christine_Morgan"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Return of the Old Ones: Apocalyptic Lovecraftian Horror</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Coming_of_the_White_Worm">
    <rdf:type rdf:resource="http://example.org/lovecraft#ClarkAshtonSmithWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#HyperboreanCycle"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Coming of the White Worm</rdfs:label>
    <ex:hasAnnotation>The theft of thirty-nine girdles" is the penultimate tale in the hyperborean cycle of fantasy works . It is the story of the sorcerer evagh, who is forcibly recruited into the dreaded entity rlim shaikorth's priesthood of mages . Although it has cost him his life, the brave sorcerer has saved his land from certain destruction .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>Dutch</ex:isInLanguageW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:isInLanguageW>Hungarian</ex:isInLanguageW>
    <ex:isInLanguageW>Italian</ex:isInLanguageW>
    <ex:isInLanguageW>Portuguese</ex:isInLanguageW>
    <ex:isInLanguageW>Spanish</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Hyperborean_Cycle"/>
    <ex:isPublishedAsW>Stirring Science Stories</ex:isPublishedAsW>
    <ex:wasPublishedOnW>April 1941</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dead_Giveaway">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dead Giveaway</rdfs:label>
    <ex:hasAnnotation>J. Vernon Shea English Outré date May 1976 "" is a short story by J. Vernon Shea , first published in the May 1976 issue of Outré magazine. It describes the goings-on on Halloween in Old Dethshill Cemetery, located near Innsmouth . History "" was reprinted in In Search of Lovecraft , a collection of Shea's work published by Necronomicon Press (1991), and in the anthology The New Lovecraft Circle ( Fedogan &amp; Bremer , 1996).</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#J._Vernon_Shea"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Outré</ex:isPublishedAsW>
    <ex:wasPublishedOnW>May 1976</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crimson_Bat">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Crimson Bat</rdfs:label>
    <ex:hasAnnotation>The is an eldritch monster, a chaos demon which is the terror of glorantha . It's form is that of a nightmarish giant bat that weighs a 1000 tons . It's fanged maw can unhinge to swallow extremely large targets .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Hermaeus_Mora">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Hermaeus Mora</rdfs:label>
    <ex:hasAffiliationC>Daedra</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Daedric Prince of Knowledge Lord of Secrets One Who Knows</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The daedric prince of knowledge is a character in the elder scrolls video game series . His sphere of influence encompasses the scrying of fate, past and future, as well as the vast realm of knowledge itself . His personality is as enigmatic as his appearance, driven solely by an insatiable hunger for knowledge .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Elder Scrolls franchise</ex:madeFirstAppearanceOnC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Masks_of_the_Mythos">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Masks of the Mythos</rdfs:label>
    <ex:hasAnnotation>Various Various English Scion Genre(s) Roleplaying game Onyx Path Publishing Release Date 2020 198 is an expansion book for the White Wolf Publishing/Onyx Path Publishing roleplaying game Scion . It was published by Onyx Path in 2022 ; hardcover and digital formats were released, with the former issued in both standard and premium editions . Scion is a roleplaying game in which the players take on the roles of the Earthly children of the gods, acting as their agents in various celestial conflicts . introduces players to new characters descended from the gods of the Cthulhu Mythos , allowing for more varied character creation and storytelling possibilities. Overview Design Team Writers Adam Alexander David Castro Ariel Celeste Hiromi Cota Alison Cybe Erykah Fassett Charles Gerard Danielle Lauzon Spider B. Perry Chris Spivey H. Ulrich Vera Vartanian Artists Shen Fei Alejandro Colucci Darko Stojanovic Digital Art Chefs Studios Sam Denmark Farri Lensen Martina Scafa Ivan Vegar Laura King Niko Pope Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>198</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Scion</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2020</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#SymbiOS">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>SymbiOS</rdfs:label>
    <ex:hasAnnotation>The biote is a symbiotic entity engineered from both flatworm and shoggoth dna . When the human partner sleeps, the biote claims control of their body . What purpose this will serve is not revealed .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu Fiction</ex:isPartOfSeriesW>
    <ex:isPublishedAsW>Eldritch Chrome: Unquiet Tales of a Mythos-Haunted Future</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2013</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Minion_of_Karakal">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ServitorRaces"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Minion of Karakal</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Karakal"/>
    <ex:hasAnnotation>The minions of karakal are supernatural beings that resemble floating spheres of electricity native to the dark dimension . Like their name indicates, they worship the great one known as karakal . They feed on electricity and have an affinity for dry environments, as humidity causes them to gradually dissipate over a period of weeks .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#H._P._Lovecrafts_Dreamlands"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Sandy_Petersen"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sefton">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Sefton</rdfs:label>
    <ex:hasAnnotation>Massachusetts Town Notable Features Asylum Humans First appearance HPL : " Herbert West--Reanimator " Created by H. P. Lovecraft is a fictional town in Massachusetts about fifty miles from Boston and located near the fictional town of Arkham . Asylum is located there. ( HPL : " Herbert West--Reanimator ")</ex:hasAnnotation>
    <ex:hasNotableFeatureL rdf:resource="http://example.org/lovecraft#Sefton_Asylum"/>
    <ex:hasTypeL>Town</ex:hasTypeL>
    <ex:isInhabitedByL>Humans</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Massachusetts"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#Herbert_West--Reanimator"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Night_of_the_Demon">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Night of the Demon</rdfs:label>
    <ex:hasAnnotation>Chris Claremont, Bill Mantlo Dave Cockrum, Sam Grainger English Marvel Comics Release Date December 1975 Media Type Comic book is a story in issue #96 of the 1st volume of Uncanny X-Men written by Chris Claremont and Bill Mantlo. Synopsis The X-Men encounter the demonic N'Garai for the first time, as their ruler Kierrok appears at the Xavier Mansion.</ex:hasAnnotation>
    <ex:hasAuthorW>Bill Mantlo</ex:hasAuthorW>
    <ex:hasAuthorW>Chris Claremont</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>December 1975</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Brichester_University">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Brichester University</rdfs:label>
    <ex:hasAnnotation>Created by ramsey campbell is a fictional school created by campbell . It is located in campbell's invented town of brichester . In " the mine on yggoth ", a witch cult member is expelled from the university .</ex:hasAnnotation>
    <ex:hasTypeL>Institute for higher learning</ex:hasTypeL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#England"/>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Severn_Valley"/>
    <ex:isLocatedAtL>United Kingdom</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL>The Horror From the Bridge</ex:madeFirstAppearanceOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Orions_Sword">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Stars"/>
    <rdfs:label>Orion's Sword</rdfs:label>
    <ex:hasAnnotation>" beyond the wall of sleep " is a group of stars (known as an asterism) in the constellation orion . It is made up of three stars and the orion nebula, which together are thought to resemble a sword (or the scabbard of a sword) the sword is "suspended" from the asterism known as orion's belt .</ex:hasAnnotation>
    <ex:hasAppearanceL rdf:resource="http://example.org/lovecraft#Beyond_the_Wall_of_Sleep"/>
    <ex:hasTypeL>Asterism</ex:hasTypeL>
    <ex:isLocatedAtL>Northern sky (Orion)</ex:isLocatedAtL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Littlest_Lovecraft:_The_Dunwich_Horror">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Storybooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Littlest Lovecraft: The Dunwich Horror</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft (original story) Tro Rex (adaptation) Eyona Bella English Genre(s) Children's Esoteric Order of Publishing Release Date November 11, 2014 64 is a children's book, published by the Esoteric Order of Publishing in 2014. It was written by Tro Rex and illustrated by Eyona Bella, as an adaptation of H. P. Lovecraft 's " The Dunwich Horror ". Overview</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasAuthorW>Tro Rex</ex:hasAuthorW>
    <ex:hasGenreW>Children's</ex:hasGenreW>
    <ex:hasPageCountW>64</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2014 November 11</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#D._F._Lewis">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>D. F. Lewis</rdfs:label>
    <ex:hasAnnotation>Full Name Desmond Francis Lewis Connection to the Mythos Author Birth Date 18 January 1948 Walton-on-Naze, Essex, England, U.K. United Kingdom https://nullimmortalis.wordpress.com/ Desmond Francis Lewis (born 18 January 1948) is a prolific British horror author and editor who has written several works of Lovecraftian fiction. He was a regular contributor to the now-defunct fanzine Cthulhu Cultus , and has had numerous collections of his works released through various publishing houses. Amongst his editorial credits is the magazine Nemonymous , a science fiction, fantasy and horror anthology series. It was unusual in that it did not credit the stories until the following issue, a setup intended to remove the reader's prejudices against particular authors . External Links at the Internet Speculative Fiction Database at Goodreads References</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#England Essex U.K. Walton-on-Naze</ex:hasBirthplaceR>
    <ex:hasFullNameR>Desmond Francis Lewis</ex:hasFullNameR>
    <ex:hasNationalityR>United Kingdom</ex:hasNationalityR>
    <ex:hasWebsiteR>https://nullimmortalis.wordpress.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>18 January 1948</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Pokethulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Pokethulhu</rdfs:label>
    <ex:hasAnnotation>Cthulhu mythos made its first - and to date, only - appearance in the jesse dedman -edited anthology ancient ones ii in march 2018 . It tells the story of four former high school track stars who had made a pact with an elder entity in exchange for sporting success . As they gather the shards of their dark lord, they realise that pitting them against each other in combat strengthens the shards .</ex:hasAnnotation>
    <ex:hasAuthorW>John Taloni</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Ancient_Ones_II"/>
    <ex:wasPublishedOnW>March 2018</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Observations_on_the_Several_Parts_of_Africa">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Observations on the Several Parts of Africa</rdfs:label>
    <ex:hasAnnotation>Wade Jermyn England English Genre(s) Anthropology, ethnology, geography Real World Information First appearance HPL : " Facts Concerning the Late Arthur Jermyn and His Family " Created by H. P. Lovecraft is a fictional book written by the noted explorer Sir Wade Jermyn and published sometime before 1765 (the year he was confined to an asylum ). The book was the target of ridicule due to the 's "bizarre conjectures" regarding a prehistoric white civilization in the Congo region of Africa. ( HPL : " Facts Concerning the Late Arthur Jermyn and His Family ")</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnA>Facts Concerning the Late Arthur Jermyn</ex:madeFirstAppearanceOnA>
    <ex:madeFirstAppearanceOnA>His Family</ex:madeFirstAppearanceOnA>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Likeness">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Likeness</rdfs:label>
    <ex:hasAnnotation>Dan Perez English Genre(s) Short Fiction Horror Chaosium Cthulhu's Heirs date 1994 "" is a Cthulhu Mythos short story by American Dan Perez. Synopsis The story begins with Mindy being dropped off by her boyfriend Jake at a tattoo store. Uninterested in the usual selection of designs, the tattooer Cal realizes that Mindy wanted to get something that is truly special so he decides to give her a full-body tattoo, based on an illustration of Vthyarilops the Starfish God from the Necronomicon . Taking almost an entire week to complete it, Mindy began to have some weird side-effects such as becoming more violent and having weird dreams about the Starfish God traveling through outer space. When it was finally finished, Vthyarilops manifested through Mindy and devoured her boyfriend.</ex:hasAnnotation>
    <ex:hasAuthorW>Dan Perez</ex:hasAuthorW>
    <ex:hasGenreW>Short Fiction Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Cthulhus_Heirs"/>
    <ex:wasPublishedOnW>1994</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Pursuit_to_Kadath">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Pursuit to Kadath</rdfs:label>
    <ex:hasAnnotation>71 is a third-party scenario sourcebook for chaosium 's mythos roleplaying game . It was written by bob gallagher and e.s. Erkes with cover art by l.flournoy . It ran to a total of 71 and contained two self-contained but linked scenarios . The primary scenario involves a group of miskatonic university students .</ex:hasAnnotation>
    <ex:hasAuthorW>Bob Gallagher</ex:hasAuthorW>
    <ex:hasAuthorW>E. S. Erkes</ex:hasAuthorW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>71</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>1983</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Owen_Gwynedd">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Owen Gwynedd</rdfs:label>
    <ex:hasAnnotation>Relatives Llunwy of Wales (ancestor) First appearance HPL : Selected Letters of H. P. Lovecraft 4.617 Created by H.P. Lovecraft Owen Gwynned is, along with H. P. Lovecraft , a descendant of Llunwy of Wales. Behind the Mythos He most likely is a reference to Owain Gwynedd, a medieval Welsh King. Lovecraft jokingly introduced him in his 1933 family tree: ( HPL : Selected Letters of H. P. Lovecraft 4.617) References</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Selected Letters of H. P. Lovecraft 4.617</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Independent_race">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SpeciesIncorporatedFromFolkloreMythAndReligion"/>
    <rdfs:label>Independent race</rdfs:label>
    <ex:hasAnnotation>Independent races are one of the three categories employed to classify species in the role-playing game Call of Cthulhu , along with servitor races and fabulous creatures . Unlike servitor races, independent races are not intrinsically associated with one particular deity . While some might be irreligious, others might still form cults. The game further classifies them as "Greater Independent Races" or "Lesser Independent Races", depending on the danger posed by an average individual of the species. Greater Independent Races Bunyips Chthonians Colours out of Space Dholes Flying Polyps Gnoph-keh Great Race of Yith Great Trees Horses of the Invisible Hounds of Tindalos Larvae of the Other Gods Lloigor Lords of Tindalos Shoggoth Lords Spawn of the Green Abyss Zy'tl Q'ae The following individual beings are also classified as Greater Independents: Lesser Independent Races Adumbrali Alskali Cats Cats from Saturn Cats from Uranus Children of the Wind Coleopterans Degenerate Serpent People Desh Dhole Ant-Lions Dimensional Shamblers Elder Things Ghasts Ghouls Gn'icht' Tyaacht Gnorri Gugs Haemophores Hyperboreans K'n-yanians Kyresh Leng Spiders L'gy'hxians Lords of Luz Martense Kin Martians Men of Leng Mi-Go Mind Parasites Moon-beasts Nioth-Korghai Ny'ghan Grii Pitch Spiders Rat People Reptile People Serpent People S'glhuoans Shaggai Shans Space Eaters Spider Hounds Star Vampires Swine Folk Ter-Men Terrors from Beyond Things Tick-men Tindalosian Hybrids Travelers Triffids Tunnelers Below Urhags Url Worms Vile Fungus Voormis Voors Wamps Wenelians Xiclotlans Xo Tl'mi-go Yaddithians Yekubians Zoogs The following individual beings are also classified as Lesser Independents: Running Thing See also Servitor races Fabulous creatures</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Anton_Zarnak">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Anton Zarnak</rdfs:label>
    <ex:hasAffiliationC>Lloigor</ex:hasAffiliationC>
    <ex:hasAffiliationC>Zhar</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Mouthpiece of Zhar</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Zarnak is a supernatural detective in the style of others such as . William hope hodgson 's thomas carnacki . Appears to possess a degree of magical power, which includes the ability to mesmerise others and to detect whether certain objects have been tampered with .</ex:hasAnnotation>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Althea_E._Veazie">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Althea E. Veazie</rdfs:label>
    <ex:diedOnR>8 August 1905</ex:diedOnR>
    <ex:hasAnnotation>Wife of Aaron Lovecraft, whom she married in 1842. She gave birth to five children: Georgia Frances, Mary Mindwell, Martha, Frederick Aaron, and Florence Veazie. Her mother, like Lovecraft’s wife, Sonia, operated a millinery (hat) store.</ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1818</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Xiclotl">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Planets"/>
    <rdfs:label>Xiclotl</rdfs:label>
    <ex:hasAnnotation>Planetary Body Notable Features Thick Vegetation Zy'tl Q'ae Xiclotlan First appearance " The Insects from Shaggai " Xictlotl is a fictional planet created by Ramsey Campbell in his short story, The Insects from Shaggai . Background Xictlotl is a planet located in the same solar system as Shaggai , a system with twin green suns. It's a planet that has very dense vegetation, and it's home of two sentient species and possibly more. When Shaggai was destroyed, the surviving insects of Shaggai moved to the planet, though they eventually left due to the threat posed to them by the Zy'tl Q'ae .</ex:hasAnnotation>
    <ex:hasNotableFeatureL>Thick Vegetation</ex:hasNotableFeatureL>
    <ex:hasTypeL>Planetary Body</ex:hasTypeL>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#Xiclotlan"/>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#Zytl_Qae"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Insects_from_Shaggai"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#When_We_Change">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>When We Change</rdfs:label>
    <ex:hasAnnotation>Mason Ian Bundschuh English Genre(s) Weird fiction Whispers from the Abyss date 2013 " " is a Cthulhu Mythos flash fiction piece by Mason Ian Bundschuh. Synopsis Two Innsmouth residents who have just killed their children and burned the bodies decide what they will do if they themselves begin to undergo the same changes. History "" was published in the Kat Rocha -edited anthology Whispers from the Abyss in 2013. Trivia Although the changes which occurred in the couple's children are never specifically described, the Innsmouth connection would imply that the family are descended from Deep One stock</ex:hasAnnotation>
    <ex:hasAuthorW>Mason Ian Bundschuh</ex:hasAuthorW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Whispers_from_the_Abyss"/>
    <ex:wasPublishedOnW>2013</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Wheres_My_Shoggoth%3F">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Storybooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Where's My Shoggoth?</rdfs:label>
    <ex:hasAnnotation>Where's my shoggoth? Is a children's book centred around the cthulhu mythos by ian thomas and artist david bolton . The story is told in a series of rhymes and centres around a young boy who wants to take his pet shoggoth for a walk . However, the creature has managed to escape</ex:hasAnnotation>
    <ex:hasAuthorW>Ian Thomas</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Children's</ex:hasGenreW>
    <ex:hasPageCountW>56</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>October 2012</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mite_of_Yuggoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Mite of Yuggoth</rdfs:label>
    <ex:hasAnnotation>The mites of yuggoth are a fictional species created for the call of cthulhu role-playing game supplement the bermuda triangle . They are closely related to the mi-go, an intelligent race of half-fungoid, half-crustacean creatures from the planet yuggoth . Like their mi-go brethren, the mites hide from the light, change colours to communicate with each other, and their bodies dissolve upon death .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Bermuda Triangle</ex:madeFirstAppearanceOnC>
    <ex:usesLanguageC>Colour-changing</ex:usesLanguageC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Tribute_to_Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Tribute to Lovecraft</rdfs:label>
    <ex:hasAnnotation>Robert A. W. Lowndes English Genre(s) Non-fiction Arkham House Lovecraft Remembered Date of writing 1937 date July 1998 " " is a short non-fiction piece by the late American and correspondent of H. P. Lovecraft 's Robert A. W. Lowndes . Written in 1937, it made its first, and to date only, appearance in Peter Cannon 's non-fiction anthology Lovecraft Remembered , a mere five months before Lowndes' death . References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_A._W._Lowndes"/>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Lovecraft_Remembered"/>
    <ex:wasPublishedOnW>July 1998</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>1937</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Deep_Roots">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Deep Roots</rdfs:label>
    <ex:hasAnnotation>Ruthanna Emrys Cover Artist John Jude Palencar English Innsmouth Legacy Genre(s) Cthulhu Mythos Tor Release Date July 10, 2018 346 Preceded by Winter Tide is a Cthulhu Mythos novel by Ruthanna Emrys , part of her Innsmouth Legacy . Published by Tor in 2018, the book continues the story pf Winter Tide, taking the characters to New York City , where they become involved in a civil war between Mi-Go factions with different visions for the fate of humanity.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ruthanna_Emrys"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasPageCountW>346</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Innsmouth_Legacy"/>
    <ex:wasReleasedOnW>2018 July 10</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Three_Hours_with_H._P._Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Three Hours with H. P. Lovecraft</rdfs:label>
    <ex:hasAnnotation>Dorothy C. Walter English Genre(s) Non-fiction Arkham House The Shuttered Room and Other Pieces date 1959 " " is a short non-fiction piece by Dorothy C. Walter . It was first published in the August Derleth -edited anthology The Shuttered Room and Other Pieces by Arkham House in 1959 . Since its first appearance, "" has also been translated into German by Festa for their H. P. Lovecraft's Bibliothek des Schreckens series . History The Shuttered Room and Other Pieces (1959) Lovecraft Remembered (1998) Das schleichende Chaos (2006) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Dorothy_C._Walter"/>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Shuttered_Room"/>
    <ex:isPublishedAsW>Other Pieces</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1959</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Gardner_Lyon">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Gardner Lyon</rdfs:label>
    <ex:diedOnR>1910</ex:diedOnR>
    <ex:hasAnnotation>Husband of Anna Phillips, whom he married 17 March 1823.</ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1863</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Corey_Konieczka">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Corey Konieczka</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Games designer is an American traditional games developer who designs for Fantasy Flight Games . His output to date has included nearly 100 releases, including tie-in games for franchises such as the Marvel universe, Game of Thrones , Battlestar Galactica , Gears of War , and Warhammer 40,000 , in addition to several of Fantasy Flights' Arkham Horror Files Cthulhu Mythos games. Selected Works Core Games Mansions of Madness (2011) Eldritch Horror (2013) Unfathomable (2021) Expansion Sets Forbidden Alchemy (2011) Signs of Carcosa (2016) External Links designer profile at BoardGameGeek</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Games designer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Gnicht_Tyaacht">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Gn'icht' Tyaacht</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Cthugha"/>
    <ex:hasAnnotation>Sociocultural Characteristics West Africa Forest Cthugha (formerly) Physical Characteristics Skin colour Hard, bark-like Real World Information First appearance EXP : Green and Pleasant Land (1987) Created by Pete Tamlyn The are a species of African tree spirits created for Chaosium 's Call of Cthulhu horror role-playing game. They first appeared in Pete Tamlyn's scenario "The Horror of the Glen", included in the 1987 Games Workshop anthology collection Green and Pleasant Land . Description The are spirits who inhabit the black-leaved Nuwanda trees of West Africa, emerging mostly in their childhoods to hunt for food. They have been tamed over the years by native witch-doctors, who feed them dried human flesh when young, a process which allows them to be controlled through the use of magic ( EXP : Green and Pleasant Land ). At one point in their history, the were forced into slavery by the visiting Great Old One Cthugha ; although they are now free of its influence, they nurse an ancient grudge against the malevolent cosmic being ( EXP : Green and Pleasant Land ).</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Green"/>
    <ex:madeFirstAppearanceOnC>Pleasant Land (1987)</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Pete Tamlyn</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Guy">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RamseyCampbellWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Guy</rdfs:label>
    <ex:hasAnnotation>Demons by daylight is a short story by english ramsey campbell . First published by arkham house in 1973; since then, a german- translation has also been released . Takes place in a town located in campbell's severn valley setting, which has been the backdrop for many of his lovecraftian stories .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Demons_by_Daylight"/>
    <ex:wasPublishedOnW>1973</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Charles_Stross">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Charles Stross</rdfs:label>
    <ex:hasAnnotation>Charles davidson (born 18 october 1964) is a british science fiction and fantasy author . Several of his works were directly inspired by the cthulhu mythos of h. p. lovecraft . Of particular note is the laundry files series, which center on a secret agency dedicated to fighting extradimensional threats .</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#England UK Leeds</ex:hasBirthplaceR>
    <ex:hasNationalityR>United Kingdom</ex:hasNationalityR>
    <ex:hasPseudonymR>Charles Davidson</ex:hasPseudonymR>
    <ex:hasWebsiteR>http://www.accelerando.org/</ex:hasWebsiteR>
    <ex:hasYearsActiveR>1987-present</ex:hasYearsActiveR>
    <ex:wasBornOnR>18 October 1964</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Beyond_the_Threshold">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Beyond the Threshold</rdfs:label>
    <ex:hasAnnotation>Wtis a story by august derleth, first published in the september 1941 issue of weird tales . It's set in a "lonely house deep in the forest places of northern wisconsin" the story is about a miskatonic librarian who has become obsessed with his uncle's papers .</ex:hasAnnotation>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>September 1941</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Atrocity_Archive">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Atrocity Archive</rdfs:label>
    <ex:hasAnnotation>"the concrete jungle" is the first novel in the laundry files series . It was originally serialized in spectrum sf (2001-2002), then released as the atrocity archives . It is narrated by a character employed by the secret british occult agency, the laundry .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Charles_Stross"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>November 2001 - November 2002</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Fritz_Leiber">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsCorrespondents"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Fritz Leiber</rdfs:label>
    <ex:diedOnR>1992 September 5</ex:diedOnR>
    <ex:hasAnnotation>Fritz reuter leiber was an american author of science fiction, fantasy, and horror . He was also a correspondent of lovecraft in the year before lovecraft's death . His greatest fame is as the creator of the swords series of novels and stories .</ex:hasAnnotation>
    <ex:hasAnnotation>Late associate of Lovecraft who became one of the leading figures in science fiction and fantasy from the 1940s onward. He and his wife, Jonquil, corresponded separately with Lovecraft during the last few months of the latter’s life.</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Chicago Illinois</ex:hasBirthplaceR>
    <ex:hasNationalityR>American</ex:hasNationalityR>
    <ex:hasPseudonymR>Fritz Reuter Leiber Jr. (full name)</ex:hasPseudonymR>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1910 December 24</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Zindarak">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Zindarak</rdfs:label>
    <ex:hasAlternativeNamesC>The Fiery Messenger</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as the fiery messenger is a fictional entity created by american author llewellyn m. cabos for his 1982 cthulhu mythos story " dr. dexter " 's true alignment is unknown. It's believed that he is a representative of the fire vampires , a pyrokinetic race of alien beings that serves one of the great old ones known as cthugha .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Dr._Dexter"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Llewellyn_M._Cabos"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Abhoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OuterGods"/>
    <rdfs:label>Abhoth</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAffiliationC>Outer Gods</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Source of Uncleanliness</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The source of uncleanliness is a fictional entity created by the late american author clark ashton smith for his 1934 short story " the seven geases " resides in the cavern of y'quaa beneath mount voormithadreth . When first appeared in chaosium 's call of cthulhu roleplaying game, it was described as an outer god . But more recent editions have changed this interpretation to that of a great old one .</ex:hasAnnotation>
    <ex:isLocatedAtC rdf:resource="http://example.org/lovecraft#Mount_Voormithadreth"/>
    <ex:isLocatedAtC>The Cavern of Y'quaa</ex:isLocatedAtC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Seven_Geases"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dreams_in_the_Witch_House_and_Other_Weird_Stories">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dreams in the Witch House and Other Weird Stories</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft English Genre(s) Horror Penguin Classics Release Date 8 September 2004 Media Type Print Preceded by The Thing on the Doorstep and Other Weird Stories is an anthology of short works by American Howard Phillips Lovecraft . Overview First published in 2004 by Penguin Classics and edited by noted Lovecraft scholar S. T. Joshi , is the third book in Penguin's series on the . The stories contained within are the "definitive" editions, edited again by Joshi. Contents " Polaris " " The Doom that Came to Sarnath " " The Terrible Old Man " " The Tree " " The Cats of Ulthar " " From Beyond " " The Nameless City " " The Moon-Bog " " The Other Gods " " Hypnos " " The Lurking Fear " " The Unnamable " " The Shunned House " " The Horror at Red Hook " " In the Vault " " The Strange High House in the Mist " " The Dream-Quest of Unknown Kadath " " The Silver Key " " Through the Gates of the Silver Key " " The Dreams in the Witch House " " The Shadow Out of Time " Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>8 September 2004</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#White_Fire">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>White Fire</rdfs:label>
    <ex:hasAnnotation>Joseph S. Pulver, Sr. English Titan Books The Madness of Cthulhu Volume 1 date October 2014 " " is a short Cthulhu Mythos story by the late American Joseph S. Pulver, Sr. It was published in the S. T. Joshi -edited anthology The Madness of Cthulhu: Volume 1 by Titan Books in October 2014. Synopsis To be added. Behind the Mythos The story makes reference to the character of Danforth and the monstrous Shoggoths , which both made their first appearance in H. P. Lovecraft 's 1936 novella At the Mountains of Madness .</ex:hasAnnotation>
    <ex:hasAuthorW>Joseph S. Pulver. Sr.</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>The Madness of Cthulhu Volume 1</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Richard_Watts">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Richard Watts</rdfs:label>
    <ex:hasAnnotation>Watts is an australian game designer, arts journalist and broadcaster . Has contributed to the call of cthulhu roleplaying game for over three decades . Most recently contributed to the second edition of chaosium's terror australis (2018) .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#At_the_Gate_of_the_Deeper_Slumber">
    <rdf:type rdf:resource="http://example.org/lovecraft#CaitlinRKiernanWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>At the Gate of the Deeper Slumber</rdfs:label>
    <ex:hasAnnotation>Caitlin R. Kiernan English Genre(s) Cthulhu Mythos Sirenia Digest date July 2009 "" is a short story by Caitlin R. Kiernan . A sequel to H. P. Lovecraft 's " The Haunter of the Dark ," it describes the fate of a Providence couple who find the Shining Trapezohedron on a Rhode Island beach and take it home with them. It first appeared in the July 2009 issue of Sirenia Digest (#41). History The story was reprinted in Kiernan's collections Confessions of a Five-Chambered Heart (Subterranean Press, 2012) and Houses Under the Sea: Mythos Tales (Centipede Press, 2018).</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Sirenia_Digest"/>
    <ex:wasPublishedOnW>July 2009</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bloated_Woman">
    <rdf:type rdf:resource="http://example.org/lovecraft#Avatars"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Bloated Woman</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Nyarlathotep"/>
    <ex:hasAlternativeNamesC>Goddess of the Black Fan</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The , also known as the goddess of the black fan, is a character created by american games designer scott david aniolowski for chaosium's call of cthulhu roleplaying game . She made her first appearance in the critically acclaimed 1984 scenario supplement masks of nyarlathotep .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Masks_of_Nyarlathotep"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Scott_David_Aniolowski"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dr._Dexter">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dr. Dexter</rdfs:label>
    <ex:hasAnnotation>Secret agent john blake is a thinly-veiled pastiche of ian fleming's spy james bond . He is a thinly-veiled pastiche of the popular film series version of the character . He is a thinly-veiled pastiche of the popular film series version of the character .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Llewellyn_M._Cabos"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Threshold of Fantasy #1</ex:isPublishedAsW>
    <ex:wasPublishedOnW>March 1982</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Jennifer_M._Oaks">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Jennifer M. Oaks</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Johnstown, Pennsylvania, USA United States is an American author and screenwriter from Johnstown, Pennsylvania. Her works have appeared in publications such as Steampunk Tales , and she has self-published at least one chapbook, The Brides of Innsmouth . Selected Publications Chapbooks The Brides of Innsmouth (year unknown) Short Fiction " The Innsmouth Covenant " (year unknown) " The Diary of Hannah Greeley " (year unknown) References</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Pennsylvania Johnstown</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mysterious_Ways">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Mysterious Ways</rdfs:label>
    <ex:hasAnnotation>A roman centurion pleads to any god who will listen when his garrison is overrun by barbarians . As the centurion has decided who lives and who dies, he must remain as a servant on earth, forever choosing the fate of those who go to war . Historywas published in august 2014 in the dark regions press anthology world war cthulhu .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#C._J._Henderson"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#World_War_Cthulhu"/>
    <ex:wasPublishedOnW>August 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Compact_Arkham_Unveiled">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Compact Arkham Unveiled</rdfs:label>
    <ex:hasAnnotation>Keith Herber Lynn Willis John B. Monroe Tim Callender Cover Artist Lee Gibbons United States English Call of Cthulhu Chaosium Release Date 1995 95 is a setting supplement for the Call of Cthulhu horror roleplaying game, which focuses on the fictional New England town of Arkham , Massachusetts . Written by Keith Herber , Lynn Willis , and John B. Monroe, it features a cover by Lee Gibbons and interior art by Tim Callender, and was published by Chaosium in 1995 . The book is in essence a reprint of the 1990 supplement Arkham Unveiled with the scenarios of the earlier book omitted and changes made to the maps included. A poster map of Arkham is also included, as is a four-page edition of fictional newspaper The Arkham Gazette . References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Keith_Herber"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lynn_Willis"/>
    <ex:hasAuthorW>John B. Monroe</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>95</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>1995</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Set_%28Conan%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Avatars"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdfs:label>Set (Conan)</rdfs:label>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#Yig"/>
    <ex:hasAlternativeNamesC>Quetzalcoatl</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Great Dragon</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>the Father Serpent</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Set was a "dark" god (chaos, violence, fire, storms, etc) who was worshiped in historical pharaonic egypt . According to one account, set is a great old one, but according to another, it is an avatar of nyarlathotep . Apostate stygians who speak blasphemies against set often meet sticky ends .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>EXP</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>Great Old One: Nameless Cults</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>Hyborian Tales: The Phoenix on the Sword EXP</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>The Phoenix on the Sword</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Larkhill_Barrow">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Larkhill Barrow</rdfs:label>
    <ex:hasAnnotation>" carnacki: " is a short story by british-born william meikle . It tells of an investigation conducted by famous occultist thomas carnacki . He is summoned to assist a military man with a problem his unit have been having . Every time they test a new machine gun atop a rise in the ground, it results in the shooter going insane .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Carnacki: Heaven</ex:isPublishedAsW>
    <ex:isPublishedAsW>Hell</ex:isPublishedAsW>
    <ex:wasPublishedOnW>December 2011</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Stone_on_the_Island">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RamseyCampbellWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Stone on the Island</rdfs:label>
    <ex:hasAnnotation>A young man finds his father dead from suicide, leaving behind a mysterious warning . The warning centers on a mysterious stone on the island beyond severnford . He touches it, despite explicit warnings about "going too near the stone" he finds himself haunted by floating faces: first one, then two and more .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isPartOfSeriesW>Over the Edge</ex:isPartOfSeriesW>
    <ex:wasPublishedOnW>1964</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Valentia">
    <rdf:type rdf:resource="http://example.org/lovecraft#CaitlinRKiernanWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Valentia</rdfs:label>
    <ex:hasAnnotation>The story involves the discovery of strange fossils on the real-life island of ireland . It advances a common theme in kiernan's fiction: that paleontological evidence has been suppressed . The final phrase maire utters is revealed by an invented quote from a real book .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Dark Terrors 5</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2000</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecrafts_The_Alchemist">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraft's The Alchemist</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft J. Scott Vanlester United States English Lovecraft Comics Release Date November 2023 is a comic book-format adaptation of the H. P. Lovecraft short story from which it takes its name by American and artist J. Scott Vanlester . One of his Lovecraft Comics , it was self-published in November 2023; both paperback and digital editions were released. The book's art is rendered entirely in black and white with a strong emphasis on line drawings, and a highly minimalist presentation. Overview</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Lovecraft Comics</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>November 2023</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lord_Dunsany">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsInspirationsAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosAdjacentAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Lord Dunsany</rdfs:label>
    <ex:diedOnR>25 October 1957 (aged 79)</ex:diedOnR>
    <ex:hasAnnotation>Edward john moreton drax plunkett, 18th baron of dunsany was an irish writer and dramatist, notable for his work, mostly in fantasy . The mystical city of bethmoora, first mentioned in dunsany's . A dreamer's tales, was incorporated into the . Cthulhu mythos by h. p. lovecraft in the . Whisperer in darkness .</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#England London</ex:hasBirthplaceR>
    <ex:hasChildrenR>19th Baron of Dunsany (1906 –1999)</ex:hasChildrenR>
    <ex:hasChildrenR>Randal Plunkett</ex:hasChildrenR>
    <ex:hasFullNameR>18th Baron of Dunsany Edward John Moreton Drax Plunkett</ex:hasFullNameR>
    <ex:hasNationalityR>British Irish</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Inspiration to H. P. Lovecraft</ex:isConnectedToMythosR>
    <ex:isKnownForR>A Dreamer's Tales</ex:isKnownForR>
    <ex:isKnownForR>The Gods of Pegana</ex:isKnownForR>
    <ex:isKnownForR>The King of Elfland's Daughter</ex:isKnownForR>
    <ex:wasBornOnR>24 July 1878</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Captain_Abraham_Whipple">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdfs:label>Captain Abraham Whipple</rdfs:label>
    <ex:ceasedOnC>1819 (aged 85) May 27</ex:ceasedOnC>
    <ex:hasAnnotation>September 26, 1733 May 27, 1819 (aged 85) Sarah Hopkins Commander Human First appearance The Case of Charles Dexter Ward The Case of Charles Dexter Ward , was an American Revolutionary War commander in the Continental Navy. He plays an important role in The Case of Charles Dexter Ward and is mentioned in The Shunned House . Role in the Mythos The Captain Whipple leads the Town militiaman against Joseph Curwen in the siege of Curwen's farm. The siege results with a victory for the townsfolk, however many of the troops are wounded both mentally and physically. ( HPL : The Case of Charles Dexter Ward ) External links Abraham Whipple on Wikipedia</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Case_of_Charles_Dexter_Ward"/>
    <ex:hasCharacterMateC>Sarah Hopkins</ex:hasCharacterMateC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Case_of_Charles_Dexter_Ward"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Gtynadc">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>G'tynad'c</rdfs:label>
    <ex:hasAlternativeNamesC>The Cosmic</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Grandiose</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Vast</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Grandiose The Vast The Cosmic First appearance " The Revelations of Alexander Dyer " Created by Todd H. C. Fischer is a Great Old One who is as large as the Universe, or in some way literally is the Universe. References</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Revelations of Alexander Dyer</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Todd_H._C._Fischer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Memory">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Memory</rdfs:label>
    <ex:hasAnnotation>Beyond the wall of sleep old bugsis a prose poem by american horror and science fiction writer h. p. lovecraft . The story takes place in the ancient valley of nis, in vegetation-covered stone ruins described by lovecraft in great detail . The story owes a heavy debt to edgar allan poe, particularly his story "the conversation of eiros and charmion"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Flash Fiction short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yellow_Is_the_Color_of_Tomorrow">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Yellow Is the Color of Tomorrow</rdfs:label>
    <ex:hasAnnotation>Historywas first published in book of dark wisdom #4 in fall 2004 . It later appeared in the anthology rehearsals for obslivion (act i) in 2006, and again in shiflet's own collection they thrive in darkness: mythos and madness in june 2018 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Book of Dark Wisdom #4</ex:isPublishedAsW>
    <ex:wasPublishedOnW>Fall 2004</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yian">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsOriginatingFromMythosAdjacentWorks"/>
    <rdfs:label>Yian</rdfs:label>
    <ex:hasAccessibilityL>Magic</ex:hasAccessibilityL>
    <ex:hasAnnotation>Created by robert w. chambers is a fabulous city created by robert w. chambers for his short story " the maker of moons " it is mentioned in the whisperer in darkness , by h. p. lovecraft , and " the isle of dark magic ", by hugh b. cave . A woman named ysonde, raised in for the first 16 years of her life, described it as a beautiful city, "sweet with perfume and the sound of silver bells all day long" the</ex:hasAnnotation>
    <ex:hasAppearanceL>The Whisperer in Darkness The Isle of Dark Magic</ex:hasAppearanceL>
    <ex:hasTypeL>City</ex:hasTypeL>
    <ex:isInhabitedByL>Humans</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#China"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Maker_of_Moons"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Ceremonies">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Ceremonies</rdfs:label>
    <ex:hasAnnotation>T. e. d. klein's only published novel, it is an expansion of his 1972 short story . Won the 1986 british fantasy award for best novel . A limited-edition hardcover version came out from ps publishing in june 2016 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#T._E._D._Klein"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>505</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>June 1984</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Weird_Shadows_over_Innsmouth">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Weird Shadows over Innsmouth</rdfs:label>
    <ex:hasAnnotation>Preceded by shadows over innsmouth followed by weirder shadows over innsmouth is a collection of short stories which are thematically linked to h. p. lovecraft 's novella the shadow over innsmouth . Includes a discarded draft of the novella along with 11 other stories, eight of which were first published in this collection .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror Short Fiction</ex:hasGenreW>
    <ex:hasPageCountW>297</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2005</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Slorioth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Slorioth</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Omnivorous One</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Powers is an eldritch being that disrupts temporal continuity . Reveals in the self-destructive indolent nature of humanity . First appeared in secret defenders #24 (february, 1995)</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Secret Defenders #24</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Mike Kanterovich</ex:wasCreatedByC>
    <ex:wasCreatedByC>Tom Brevoort</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Gug">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Gug</rdfs:label>
    <ex:hasAffiliationC>Great Ones</ex:hasAffiliationC>
    <ex:hasAnnotation>Gugs are a species of extra-dimensional monstrosities creatures first featured in h. p. lovecraft 's the dream-quest of unknown kadath . They are worshippers of the great ones , the gods of earth who reside in kadath .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Dream-Quest_of_Unknown_Kadath"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Fear_the_Reaper">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Fear the Reaper</rdfs:label>
    <ex:hasAnnotation>Len Kaminski M.C. Wyman, Tom Palmer English Marvel Comics Release Date Sept 1992 - October 1992 Media Type Comic book is a 3-part story arc in issues #352-354 of the 1st volume of Avengers written by Len Kaminski. Synopsis The supervillain Grim Reaper makes a pact with the Great Old One Lloigoroth to get revenge on the superhero team, the Avengers.</ex:hasAnnotation>
    <ex:hasAuthorW>Len Kaminski</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>Sept 1992 - October 1992</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yad-Thaddag">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ElderGods"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Yad-Thaddag</rdfs:label>
    <ex:hasAffiliationC>Elder Gods</ex:hasAffiliationC>
    <ex:hasAnnotation>Elder Gods First appearance Elysia Created by Brian Lumley is possibly the Elder God equivalent of the Outer God Yog-Sothoth . This being has the same appearance as Yog-Sothoth, except its spheres are of a different color and its nature is purely benevolent.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Elysia"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#R._H._Barlow">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsCoAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsCorrespondents"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>R. H. Barlow</rdfs:label>
    <ex:diedOnR>1951 (Aged 32) January 2</ex:diedOnR>
    <ex:hasAnnotation>Robert barlow was an american author, avant-garde poet, anthropologist and historian of early mexico . He was a correspondent and friend of horror writer h. p. lovecraft . Barlow was head of the department of anthropology at mexico city college when he died .</ex:hasAnnotation>
    <ex:hasBirthplaceR>Kansas Leavenworth</ex:hasBirthplaceR>
    <ex:wasBornOnR>1918 May 18</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Artefact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>An object of historical, mystical, or fictional significance, often tied to the mythos.</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ghizguth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Ghizguth</rdfs:label>
    <ex:hasAlternativeNamesC>Ghisghuth</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Ghisguth</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Sound in the Deep Waters</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Sound in the Deep Waters, Ghisguth, Ghisghuth Relatives Cxaxukluth (father) Hziulquoigmnzhah (sibling) Tsathoggua (offspring) Zstylzhemghi Great Old Ones First appearance CIRCLE : Selected Letters of Clark Ashton Smith 189 Created by Clark Ashton Smith is a Great Old One . According to the Parchments of Pnom ( Pnom being the chief Hyperborean genealogist as well as a noted prophet), he is a male spawn of Cxaxukluth and the brother of Hziulquoigmnzhah and Tulu . He is the of Zstylzhemghi and the father of Tsathoggua . Behind the Mythos The character first appeared in Clark Ashton Smith 's family tree of Azathoth ("Genealogical Chart of the Elder Gods"). Gallery References</ex:hasAnnotation>
    <ex:hasCharacterMateC>Zstylzhemghi</ex:hasCharacterMateC>
    <ex:madeFirstAppearanceOnC>Selected Letters of Clark Ashton Smith 189</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crypt_of_Cthulhu_Candlemas_1982">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crypt of Cthulhu Candlemas 1982</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Jason C. Eckhardt United States English Crypt of Cthulhu Release Date February 1982 28 Preceded by Yuletide 1981 Followed by Eastertide 1982 was the third issue of Robert M. Price 's long-running Lovecraftian fanzine Crypt of Cthulhu . Edited by Price, it featured cover art by Jason C. Eckhardt , ran to a total of 28 in an A5 format, and was self-published in February 1982. Interior artwork was provided by Price, Richard Abate, and an uncredited contributor. This issue was reprinted in 1984. Contents Editorial Shards by Robert M. Price "The Strange Case of Robert Ervin Howard" by Marc A. Cerasini and Charles Hoffman "The Borrower Beneath: Howard's Debt to Lovecraft in "The Black Stone"" by Robert M. Price " The Black Stone " by Robert E. Howard "Yag-kosha the Elephant Man" by Robert M. Price "Gol-Goroth, A Forgotten Old One" by Robert M. Price "Genres in the Lovecraftian Library" by Robert M. Price "Fun Guys from Yuggoth: The Call of Cthulhu's Cadillac" by John Anthony (I) Review by C. J. Henderson Letter by Ed Babinski</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>28</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu"/>
    <ex:wasReleasedOnW>February 1982</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Chain_of_Aforgomon">
    <rdf:type rdf:resource="http://example.org/lovecraft#ClarkAshtonSmithWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Chain of Aforgomon</rdfs:label>
    <ex:hasAnnotation>Narrator recollects about the occult writings of an acquaintance of his named john milwarp . In his will, he made the narrator his executor and how he wanted him to spread interest in publishing for his newest novel, which is his diary . The narrator has been trying to decipher the text before the ink of the text dissipates .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>December 1935</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dire_Documents">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dire Documents</rdfs:label>
    <ex:hasAnnotation>United States English Call of Cthulhu Genre(s) Roleplaying game Chaosium Release Date 1993 9 is a player aid for the Call of Cthulhu horror roleplaying game, published by Chaosium in 1993 , and running to a meagre nine in length. It is currently out of print, and likely to remain so due to the ease of replicating similar contents digitally in the current age. Overview contains a selection of blank player handouts for use by keepers to enhance the immersion of Call of Cthulhu games, as well as a novelty form to award the player whose character died in the most entertaining way. Contents Arkham Sanitorium inpatient admission form Arkham Sanitorium letterhead Award for Meritorious Service Near East Treasure Import letterhead Eye of Amara Society letterhead Dewey Cheatham &amp; Howe Attorneys at Law letterhead Miskatonic University letterhead Formal invitation Keeper's Choice Award for Superlative Demise. References</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>9</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>1993</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Azathoth_%28short_story%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Azathoth (short story)</rdfs:label>
    <ex:hasAnnotation>Azathoth is the beginning of a never-completed novel written by h. p. lovecraft in june 1922 . It is the first piece of fiction to mention the fictional being azathoth , one of the major entities in lovecraft's cthulhu mythos . It was published as a fragment in the journal leaves in 1938, after lovecraft's death .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>novel (incomplete)</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>1938</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>June 1922</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#ComicBooks">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Work"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dz%C3%A9w%C3%A0">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Dzéwà</rdfs:label>
    <ex:hasAlternativeNamesC>The White God</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The White God First appearance " The Insects from Shaggai " (unnamed) Lord of the Jungle (Role-play Game Supplement) Created by Ramsey Campbell , The White God , is a ravenous plant-god that came from Xiclotl to Earth , awed by the Insect from Shaggai . Appears as a great white orb hiding an enormous magenta excrescence, an orchid or lamprey mouth with emerald tentacles, tipped with hands emerging from the mass. Behind the Mythos was created by Ramsey Campbell for his short story " The Insects from Shaggai ".</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Insects_from_Shaggai"/>
    <ex:madeFirstAppearanceOnC>Lord of the Jungle</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lloigoroth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Lloigoroth</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAffiliationC>temporary benefactor of the Grim Reaper</ex:hasAffiliationC>
    <ex:hasAnnotation>Len kaminski is a fictional character in marvel comics . First appeared in avengers vol. 1 #352 written by len kaminski and penciled by m.c. Wynman . He is an old one who was summoned by the supervillain, the grim reaper .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Avengers Vol. 1 #352</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Len Kaminski</ex:wasCreatedByC>
    <ex:wasCreatedByC>M.C. Wyman</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Chthonian">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Chthonian</rdfs:label>
    <ex:hasAffiliationC>G'harne</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Burrowers Beneath</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Dark Tunnelers</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Deep Crawlers</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>G'harne Spawn</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Helmatodes</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Chthonians are massive burrowing worm-like creatures . They live toward the earth's core, with only a few individuals visiting the upper strata . Adults can withstand enormous temperatures, up to 4,000°c (7,000°f)</ex:hasAnnotation>
    <ex:hasAppearanceC>The Burrowers Beneath Big Nasty</ex:hasAppearanceC>
    <ex:hasDistinctionC>Immense worms</ex:hasDistinctionC>
    <ex:hasDistinctionC>with tough elongated bodies coated with vicious slime</ex:hasDistinctionC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Cement_Surroundings"/>
    <ex:madeFirstAppearanceOnC>The Haunter of the Dark (allusion)</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Reimagining_Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Reimagining Lovecraft</rdfs:label>
    <ex:hasAnnotation>Various English Tor.com English Release date October 2017 343 : Four Tor.com Novellas is an omnibus of four Lovecraftian stories published by Tor.com. The novellas, previously published by Tor, were packaged together as an omnibus on October 10, 2017. Three of the four stories included were finalists for Best Novella in the 2017 Locus Awards. Contents The Ballad of Black Tom by Victor LaValle The Dream-Quest of Vellitt Boe by Kij Johnson Hammers on Bone by Cassandra Khaw Agents of Dreamland by Caitlín R. Kiernan References</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>343</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Idle_Days_on_the_Yann">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Idle Days on the Yann</rdfs:label>
    <ex:hasAnnotation>"idle days" tells the story of a dreamer who voyages down the river yann . It was a major influence on h. p. lovecraft's "dreamlands" tales . The dreamer prays to "sheol nugganoth," who is now unworshipped and alone .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lord_Dunsany"/>
    <ex:hasCountryOfOriginW>Republic of Ireland</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Fantasy</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>A Dreamer's Tales</ex:isPartOfSeriesW>
    <ex:wasPublishedOnW>September 1910</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tim_Waggoner">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Tim Waggoner</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Dayton, Ohio, USA United States Science fiction Fantasy Horror https://www.timwaggoner.com/ is an American author, English professor, and former editor. Overview Writing primarily in he science fiction, fantasy and horror genres, 's output has included tie-in novels and stories for many major film and gaming franchises as well as a number of Cthulhu Mythos works. He is also a teacher of creative writing. Selected Bibliography " Foundling " (1997) " MIBs " (1998) " The Backwards Man " (2016) " The Nature of Water " (2017) " Sorrow Road " (2017)</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Ohio Dayton</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://www.timwaggoner.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Norse_Blood">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Norse Blood</rdfs:label>
    <ex:hasAnnotation>is a one-issue comic story published in Marvel Comics Presents #63 starring Thor against Varnae , also known as Tsathoggua . It also mentions Tcho-Tcho people and the Old Gods. External links at the Marvel Database wiki</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Mantle_of_Graag">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Mantle of Graag</rdfs:label>
    <ex:hasAnnotation>The story follows a group of writers dabbling in the occult . They unearth a mysterious chest and break its seal, allowing an evil entity to enter the world and consume them .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_A._W._Lowndes"/>
    <ex:hasAuthorW>Dirk Wylie</ex:hasAuthorW>
    <ex:hasAuthorW>Frederik Pohl</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>The Unique Magazine</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 1941</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#NGarai">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>N'Garai</rdfs:label>
    <ex:hasAlternativeNamesC>Great Devourers</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The are a fictional elder race in the marvel universe that first appeared in 1974, in a prose story in issue #4 of the 2nd volume of haunt of horror . Their first appearance in a comic was in 1975, in issue #96 of the 1st volume of the x-men comic book series . They are a race that ranges in size from an average human to multi-story ones . They possess superhuman strength and durability, being able to tear out a motor vehicle's</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Haunt of Horror Vol 2 #4</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Chris Claremont</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ceph">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Ceph</rdfs:label>
    <ex:hasAnnotation>The are an eldritch-like extra-galactic race and a cosmic horror element in the fictional universe of the crysis video game . Pure-strain cephs are approximately 2 meters long with a bluish/purple color . The human-derived strain of the have three tentacles coming from their back, vary in height, and are a pink or red color .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Frank_Utpatel">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsCorrespondents"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Frank Utpatel</rdfs:label>
    <ex:diedOnR>12 July 1980</ex:diedOnR>
    <ex:hasAnnotation>Full Name Frank Albert Bernhardt Utpatel Connection to the Mythos Mythos Artist Birth Date 4 March 1905 Waukegan, Illinois, United States Death Date 12 July 1980 United States 𝐓 Frank Albert Bernhardt Utpatel (March 4, 1905 - July 12, 1980) was an American artist whose work was featured both inside and on the covers of many weird fiction publications, including several works of Cthulhu Mythos -related content and long-running pulp magazine Weird Tales . He was also a correspondent of H. P. Lovecraft . See Also Images by External Links at the Internet Speculative Fiction Database Gallery</ex:hasAnnotation>
    <ex:hasBirthplaceR>United States Illinois Waukegan</ex:hasBirthplaceR>
    <ex:hasFullNameR>Frank Albert Bernhardt Utpatel</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Mythos Artist</ex:isConnectedToMythosR>
    <ex:wasBornOnR>4 March 1905</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Herbert_West">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Herbert West</rdfs:label>
    <ex:hasAnnotation>Doctor west is a scientist who creates a formula capable of animating unliving bodies . His ultimate aim is to bring living creatures back to life, complete with all of their faculties . Created by h.p. Lovecraft 's short story " --reanimator " as well as the re-animator series of films and comics .</ex:hasAnnotation>
    <ex:hasAppearanceC>Re-Animator Bride of Re-Animator Beyond Re-Animator Demonbane Feeders from Within Atonement</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Herbert_West--Reanimator"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
