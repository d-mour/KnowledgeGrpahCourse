    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Druid of Castle Rock</rdfs:label>
    <ex:hasAnnotation>The other: encounter with the cthulhu mythos book 2 date 2020 . It is the fourth story in book 2 of the nyarlathotep cycle by canadian author .</ex:hasAnnotation>
