    <ex:wasPublishedOnW>October 2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Call_of_Cthulhu_%28ARTC_audio_drama%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAudioAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Call of Cthulhu (ARTC audio drama)</rdfs:label>
    <ex:hasAnnotation>The Call of Cthulhu (ARTC audio drama) Based on " The Call of Cthulhu " Ron N. Butler David Benedict Production Company Atlanta Radio Theatre Company Running time 51 minutes United States English The Call of Cthulhu is an audio drama adaptation of the H. P. Lovecraft short story of the same name . It was performed by amateur troupe the Atlanta Radio Theatre Company as part of an ongoing series of adaptations and original works set in the world of the Cthulhu Mythos . It is available in both CD and digital download formats from the ARTC website.</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Call_of_Cthulhu"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Godzilla">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Godzilla</rdfs:label>
    <ex:hasAlternativeNamesC>Gojira</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>King of the Monsters</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Cthulhu is a fictional kaiju, who first appeared in toho's 1954 film of the same name . Has since gone through many different iterations in various films, comics, novels, animated series and video games .</ex:hasAnnotation>
    <ex:hasAppearanceC>Godzilla vs. Cthulhu: A Death May Die Story Dreidel of Dread: The Very Cthulhu Hanukkah</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC>Godzilla (1954)</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Eiji Tsuburaya</ex:wasCreatedByC>
    <ex:wasCreatedByC>Ishirō Honda</ex:wasCreatedByC>
    <ex:wasCreatedByC>Tomoyuki Tanaka</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Arkham_Sampler_Winter_1949">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Periodicals"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Arkham Sampler Winter 1949</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Ronald Clyne United States English The Arkham Sampler Arkham House Release Date Winter 1949 100 Preceded by Autumn 1949 was the eighth and final issue of the short-lived magazine The Arkham Sampler . Edited by H. P. Lovecraft ’s friend and literary champion August Derleth and featuring cover art by Ronald Clyne, it ran to a total of 100 and was published by Arkham House . Contents "A Basic Science-Fiction Library by Forrest J. Ackerman , Everett Bleiler , David H. Keller, M.D., Henry Kuttner , Sam Merwin, Jr., P. Schuyler Miller, C. L. Moore , Sam Moskowitz, Paul L. Payne, A. Langley Searles, Theodore Sturgeon, A. E. van Vogt, and Donald Wandrei "Avowal" by Clark Ashton Smith "The Spring Night" by Ray Bradbury "The Case for Science-Fiction" by Sam Moskowitz "Dear Pen Pal" by A. E. van Vogt "The Pool in the Wood" by August Derleth "Solution of Mind Problems by Imagination" by Jules Verne "The Swallowers of Universes" by Peter Viereck "David Henry Keller and the Scientific Novel in the United States" by Régis Messac "Time to Rest" by John Beynon Harris "Open, Sesame!" by Stephen Grendon "Travel Talk" by Vincent Starrett "The Moon as Goal" by Everett Bleiler "Charles WIlliams' Novel" by Edward Wagenknecht "From the Fan Presses" by Fritz Leiber, Jr. "Frank Merriwell on Venus" by Robert Bloch "Factual Fantasies" by Carl Jacobi "Dr. Keller Again" by Weaver Wright "Whimsy and Whamsy" by Leah Bodine Drake Reviews by Everett Bleiler, Edward Wagenknecht, Fritz Leiber, Jr., Robert Bloch, Carl Jacobi, Weaver Wright , Leah Bodine Drake, and uncredited contributors External Links full issue online at the Internet Archive</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>100</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Arkham_Sampler"/>
    <ex:wasReleasedOnW>Winter 1949</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Pnom">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Pnom</rdfs:label>
    <ex:hasAnnotation>Hyperborea Powers and Abilities Clairvoyance Genealogist Human Created by Clark Ashton Smith is a character created by the late American author and Lovecraft contemporary Clark Ashton Smith . Overview In prehistory, was the chief Hyperborean genealogist in addition to being a well-respected prophet. He is also noted for being the author of the Parchments of , a series of occult texts which deal which the entities of the Cthulhu Mythos ; some copies of the Parchments are known to survive into the modern day.</ex:hasAnnotation>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#John_Shirley">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>John Shirley</rdfs:label>
    <ex:hasAnnotation>Full Name John Patrick Shirley Pseudonym(s) John Cutter D. B. Drumm John Sherley ジョン・シャーリイ Джон Ширли Connection to the Mythos Author Birth Date 10 February 1953 Houston, Texas, USA United States John Patrick Shirley is a prolific American author, screenwriter and musician. His writing credits include novels, short stories, scripts, screenplays and song lyrics; he has received numerous awards, and many more nominations, for his fiction works, while his notable screen credits include the 1994 movie The Crow , and the 1998 animated show Todd McFarlane's Spawn . Selected Bibliography Collections Lovecraft Alive! (2016) Short Fiction " Loyalty " (2014) " The Witness in Darkness " (2014)</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Texas Houston</ex:hasBirthplaceR>
    <ex:hasFullNameR>John Patrick Shirley</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasPseudonymR>D. B. Drumm</ex:hasPseudonymR>
    <ex:hasPseudonymR>John Cutter</ex:hasPseudonymR>
    <ex:hasPseudonymR>John Sherley</ex:hasPseudonymR>
    <ex:hasPseudonymR>Джон Ширли</ex:hasPseudonymR>
    <ex:hasPseudonymR>ジョン・シャーリイ</ex:hasPseudonymR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>10 February 1953</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Skids_OToole">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>"Skids" O'Toole</rdfs:label>
    <ex:hasAlternativeNamesC>The Ex-Convict</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Skids" o'toole is a character conceived by fantasy flight games as part of their arkham horror files range of cthulhu mythos -relates games and fiction . He is a former prisoner who has since become a real-life friend of his cell mate, a man named brad hollins . He is also known as the ex-convict and has a number of powers and abilities .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Innsmouth Horror Deluxe Expansion</ex:madeFirstAppearanceOnC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#NonSapientSpecies">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Character"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Shadow_Over_Innsmouth_%28DART_production%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAudioAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Shadow Over Innsmouth (DART production)</rdfs:label>
    <ex:hasAnnotation>The shadow over innsmouth is a dark adventure radio theatre production . It is presented in the style of a 1930s radio broadcast . The physical edition comes with a set of period-authentic props .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Shadow_Over_Innsmouth"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Writing_on_the_Wall">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Writing on the Wall</rdfs:label>
    <ex:hasAnnotation>Jeffrey Thomas English Mythos Books Unholy Dimensions date October 2005 " " is a very short Cthulhu Mythos story by American Jeffrey Thomas . Although first seeing print in a works newsletter, its first official was in the 2005 Mythos Books collection Unholy Dimensions . Synopsis When archaeologist Dr. Henry Paxton uncovers a lost Egyptian tomb, he ventures into the darkness alone to explore its secrets. Inside he discovers a story, carved in previously-unseen hieroglyphics, which appears to describe the awakening of an octopus-headed, bat-winged mummy before it creeps up behind a suspiciously modern-looking explorer… Behind the Mythos In Unholy Terrors , Thomas adds the following 's note:</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Jeffrey_Thomas"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Unholy_Dimensions"/>
    <ex:wasPublishedOnW>October 2005</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Return_to_Lovecraft_Country">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Return to Lovecraft Country</rdfs:label>
    <ex:hasAnnotation>Various English Triad Entertainments Impressions Release Date 1997 234  is a collection of Lovecraftian fiction edited by Scott David Aniolowski and first published by Triad Entertainments in 1997. A second edition was released by Impressions in February 2007. Overview Contents "Connect the Dots" by Donald R. Burleson "Dark Providence" by Don D'Ammassa " The Arkham Collector " by Peter Cannon "In the Times After" by Fred Behrendt " The Doom That Came to Dunwich " by Richard A. Lupoff "Keeping Festival" by Mollie L. Burleson "Frank the Cnidarian" by Benjamin Adams "Tuttle" by James Robert Smith "The Horror at Columbia Terrace" by C. J. Henderson "The Hitch" by Gary Sumpter "The Shunpike" by Robert M. Price "Van Graf's Painting" by J. Todd Kingrea " The Events at Poroth Farm " by T. E. D. Klein " The Last Feast of Harlequin " by Thomas Ligotti " Strange Manuscript Found in the Vermont Woods " by Lin Carter</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>234</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1997</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Arkham_House_Companion">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Arkham House Companion</rdfs:label>
    <ex:hasAnnotation>Sheldon Jaffery United States English Genre(s) Non-Fiction Starmont House, Inc. Release Date 1989 Media Type Print 184 , Fifty Years of Arkham House: A Bibliographical History and Collector's Price Guide to Arkham House and Mycroft &amp; Moran Including the Revised and Expanded Horrors and Unpleasantries is a non-fiction book which offers a listing and review of every Arkham House publication up until 1989. Publication History Written by Sheldon Jaffery and first published in 1989 by Starmont House, Inc., received a re-release in May 1992. It has not been reissued since.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Sheldon_Jaffery"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-Fiction</ex:hasGenreW>
    <ex:hasPageCountW>184</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1989</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Swords_Against_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Swords Against Cthulhu</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Stephen Cooney English Rogue Planet Press Release Date June 2015 155 Followed by II: Hyperborean Nights is a Cthulhu Mythos anthology focused on the sword-and-sorcery genre. Overview Running to a total of 155 , was edited by Gavin Chappell and published by Rogue Planet Press as a paperback release in June 2015. It features cover art by Stephen Cooney. Contents "In the Gate of the Inner City" by Damir Salkovic "The Burning Messenger" by Matt Sullivan "The Caverns of Khidina" by DJ Tyrer "Rite of Passage" by Carl Fox "Modu" by Mark Sims "Followers of Mogolith" by Mark Slade "Tube Worm Utopia" by David S. Pointer "Post Climate Regulators" by David S. Pointer "The Voyage of the Clewtunt" by Ernesto Canepa and Sergio Palumbo "A Muezzin from the Tower of Darkness" by Gavin Chappell "The Sword of Lomar" by Jason Scott Aiken "The Duellists" by David Busboom "The Worms Crawl In" by J. Stratton "The Thing in the Swamp" by Stephen Hernandez "The Lost Legion" by Craig Sawyer "Where Gods Fear to Tread" by Benjamin Sperduto</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>155</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>June 2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Gable_Window">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Gable Window</rdfs:label>
    <ex:hasAnnotation>The murky glass is a collaboration between august derleth and h.p. Lovecraft . It was first published in may 1957 in saturn magazine under the name "the murky glass" derleth took several tiny story ideas or the briefest of notes, wrote stories related to them or somehow inspired by them, and used lovecraft's name on them . These are not lovecraft stories, albeit they are indeed mythos stories .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Other:_Encounters_with_the_Cthulhu_Mythos_Book_3">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Other: Encounters with the Cthulhu Mythos Book 3</rdfs:label>
    <ex:hasAnnotation>Book focuses on the development of field agents malcolm mayweather , a former firefighter, and charlene hines , an ex-convict . Together with director harjit singh, the group attempts to prevent the awakening of the great old one cthulhu .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Troy_Young"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Nyarlathotep_Cycle"/>
    <ex:wasReleasedOnW>2021</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Chronology_of_Selected_Works_by_H._P._Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Chronology of Selected Works by H. P. Lovecraft</rdfs:label>
    <ex:hasAnnotation>S. T. Joshi United States English Genre(s) Non-fiction Ohio University Press H. P. Lovecraft: Four Decades of Criticism date 1980 " " is a short literary work by leading H. P. Lovecraft scholar S. T. Joshi . Overview Running to only a handful of pages, "" was published in the non-fiction collection H. P. Lovecraft: Four Decades of Criticism by Ohio University Press in 1980. This volume was also edited by Joshi.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#S._T._Joshi"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft:_Four_Decades_of_Criticism"/>
    <ex:wasPublishedOnW>1980</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Survivor_and_Others">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Survivor and Others</rdfs:label>
    <ex:hasAnnotation>August Derleth H. P. Lovecraft Cover Artist Ronald Clyne United States English French Genre(s) Weird fiction Arkham House Release Date 1957 is a collection of short stories billed as "posthumous collaborations" between August Derleth and H. P. Lovecraft , released in 1957 by Arkham House . In fact, the stories were for the most part written by Derleth, based on unused story ideas jotted down by Lovecraft. With the exceptions of " The Survivor ", published by Weird Tales in July 1954, and " The Gable Window ", published (as "The Murky Glass") in the May 1957 issue of Saturn magazine, all the stories made their first appearance in this collection. Ballantine Books reissued the collection in paperback in 1962 and again in 1971, and a French- version has also been produced. Contents " The Survivor " " Wentworth's Day " " The Peabody Heritage " " The Gable Window " " The Ancestor " " The Shadow Out of Space " " The Lamp of Alhazred " Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:wasReleasedOnW>1957</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Harry_K_Brobst">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Harry K Brobst</rdfs:label>
    <ex:diedOnR>2010</ex:diedOnR>
    <ex:hasAnnotation>Late associate of Lovecraft who moved to Providence in 1932, becoming a psychiatric nurse at Butler Hospital and seeing Lovecraft regularly thereafter.</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1909</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Marie_Lambeau">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Marie Lambeau</rdfs:label>
    <ex:hasAlternativeNamesC>The Entertainer</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Smokey Velvet</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as the entertainer and the smokey velvet . Created by fantasy flight games for their arkham horror files line of cthulhu mythos releases . Made her first appearance in the dunwich horror expansion for arkham horror in july 2006 .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Dunwich_Horror_Deluxe_Expansion"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Fantasy_Flight_Games"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Young_of_the_Old_Ones">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Young of the Old Ones</rdfs:label>
    <ex:hasAnnotation>'"the avatars of the old ones" is a short story by american jeffrey thomas . It is the third and final story in a series set in a pointown milieu involving the character john bell . It is the third and final story in a series set in a pointown milieu involving the character .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Jeffrey_Thomas"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Unholy_Dimensions"/>
    <ex:wasPublishedOnW>October 2005</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Jim_Culver">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Jim Culver</rdfs:label>
    <ex:hasAlternativeNamesC>The Musician</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Culver is a character created by fantasy flight games for their arkham horror files series of cthulhu mythos releases . He made his debut appearance in the dunwich horror expansion for the second edition of arkham horror . Despite being a talented trumpeter, playing the instrument allows him to commune with the dead, and even raise them to life .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Dunwich Horror</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Fantasy_Flight_Games"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#LifeformsAndEntities">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Character"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Edwin_Baird">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Edwin Baird</rdfs:label>
    <ex:diedOnR>27 September 1954</ex:diedOnR>
    <ex:hasAnnotation>Career baird was the first editor of weird tales and detective tales . He published some of the magazine's most famous writers, including h.p. Lovecraft . The magazine lost a considerable amount of money under his editorship .</ex:hasAnnotation>
    <ex:hasNationalityR>American</ex:hasNationalityR>
    <ex:wasBornOnR>1886</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Medusas_Harem">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Medusa's Harem</rdfs:label>
    <ex:hasAnnotation>Magenta Nero English James Ward Kirk Publishing Lovecraft after Dark date November 2015  " " is a Lovecraftian short story by Magenta Nero . It was published in the James Ward Kirk Publishing thematic anthology Lovecraft after Dark in November 2015. Synopsis The chosen devotee of a cult searches out a being known as the Queen Medusa in an attempt to harness her power for some dark purpose. Locating her in a high mountain cave, he is seduced by her before and her followers being transformed into something powerful and inhuman. The story concludes by telling of the cultist's intent to return to his group and take control of them by force.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Magenta_Nero"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Lovecraft_after_Dark"/>
    <ex:wasPublishedOnW>November 2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#At_the_Mountains_of_Madness_%28DART_production%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAudioAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>At the Mountains of Madness (DART production)</rdfs:label>
    <ex:hasAnnotation>At the mountains of madness is an audio production of the story of the same name by the h. p. lovecraft historical society . Available in both physical (compact disc) and digital download formats . Runs to a total of 75 minutes and includes a set of thematic props, including: two photographs depicting dyer and danforth investigating the ruins of the elder thing city .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#At_the_Mountains_of_Madness"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Iku-Turso">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Iku-Turso</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAnnotation>Mahtavat ammoiset was a great old one who ruled over the areas of finland, until he, along with the other old ones, were sung into the swamps by finnish sages and poets . Only myths and some of the deep ones remained in the country .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Mahtavat_Ammoiset"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Tuomas_Saloranta"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Looking_for_Darla">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Looking for Darla</rdfs:label>
    <ex:hasAnnotation>The story was published in the collection to which it lends its name : stories of mythos noir by elder signs press in september 2008 . It is a semi-recurrent character in the mythos fiction of american ron shiflet .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Looking_for_Darla:_Stories_of_Mythos_Noir"/>
    <ex:wasPublishedOnW>September 2008</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#One_Rainy_Afternoon_Spent_in_the_Company_of_Dr._Thulask">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>One Rainy Afternoon Spent in the Company of Dr. Thulask</rdfs:label>
    <ex:hasAnnotation>Story takes place in the town of braving, minnesota , a setting for many of the 's mythos tales . A reporter interviews an enigmatic psychiatrist who relates the story of one of his most unusual cases .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#James_Ambuehl"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Lovecrafts_Disciples"/>
    <ex:wasPublishedOnW>December 2005</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Unter_Zee_Kulten">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Unter Zee Kulten</rdfs:label>
    <ex:hasAnnotation>German Real World Information First appearance AWD : " The Aquarium " Created by Carl Jacobi is a fictional book invented by Carl Jacobi , part of a set of books mentioned in his story " The Aquarium " (1962) that deal with the mysteries of the sea. Jacobi says of it that "all copies...had supposedly been destroyed in the seventeenth century," but a pirated version of it still exists. The other eldritch aquatic books named by Jacobi are Hydrophinnae and Dwellers in the Depths ; all three texts are frequently mentioned together by Brian Lumley to indicate an unwholesome interest in oceanic secrets, in such stories as " The Cypress Shell ," " Rising with Surtsey ", " Dagon's Bell ", " De Marigny's Clock ", " Lord of the Worms ", and " The House of the Temple ". Don Webb 's story " The Sound of a Door Opening " involves two pranksters creating a hoax about a film called Unterzee Kulten , supposedly directed by George Pabst and released by UPA. The perpetrators are told that there really was a film by that name, based on a book called Das Geheimnis Der Unterzeerunen , written by Guido Von List and released in Vienna in 1908.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_Aquarium"/>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#Carl_Jacobi"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Wreck_of_the_Charles_Dexter_Ward">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Wreck of the Charles Dexter Ward</rdfs:label>
    <ex:hasAnnotation>The story concerns an attempt by the arkhamers to salvage a hospital ship that was once a living spaceship called a boojum . It was first published in audio form in two parts on the podcast the drabblecast . The story won the 2013 locus award for best novelette .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Elizabeth_Bear"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Sarah_Monette"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Boojumverse"/>
    <ex:isPublishedAsW>The Drabblecast</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2012 August 31</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mhar">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Mhar</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Great_Old_One"/>
    <ex:hasAlternativeNamesC>The World Thunder</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Great old one is a living volcano with fangs of lava surrounding its caldera and eight crystalline legs coming out of the base . It is constantly erupting, afterwards cooling or melting away, bringing it endless pain . It was born when the essence of the planes of earth and fire were made to fuse together by a unique planar rift .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Spires of Xin-Shalast</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Greg A. Vaughan</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#David_Rose">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonFictionAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>David Rose</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Birth Date 1983 United States Lovecraftian horror Military fiction (born 1983 ) is an American author, artist, and former serviceman who has written a number of Lovecraftian works including several short stories and at least one novel, Lovecraft's Iraq . A veteran of the Iraq War, he served as a marine during the conflict; as a result of his background, much of his work revolves around life in the armed forces. Rose has cited Clark Ashton Smith , Brian McNaughton , and Caitlin R. Kiernan as amongst his influences . Selected Bibliography Collections Monsters in the Bush (2023) Novels Lovecraft's Iraq (2022) Short Fiction "The Shadow Over Onslow Beach" "The Brothers Khalid" "LZ Rep Disrupted" "Rejection Notice" "Monsters in the Bush" "Lovecraft in Lockup" "Magic and the Desert" External Links at the Internet Speculative Fiction Database at Goodreads References</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1983</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Through_a_Mythos_Darkly">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Through a Mythos Darkly</rdfs:label>
    <ex:hasAnnotation>253 is a cthulhu mythos –inspired anthology, edited by glynn owen barrass &amp; brian m. sammons . The stories are "alternate history" tales inspired by the cthulhu mythos . Authors were instructed to "take a steampunk world, fill it with giant steam powered robots .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>253</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>June 2017</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#isInhabitedByL">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label>isInhabitedByL</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/lovecraft#Location"/>
    <rdfs:range rdf:resource="http://example.org/lovecraft#Character"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Hammers_on_Bone">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Hammers on Bone</rdfs:label>
    <ex:hasAnnotation>The novella was a finalist for best novella in the 2017 locus awards and bfa . It features a private detective who is an alien entity wearing a human form . It is the first of two works in the persons non grata series .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Cassandra_Khaw"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasGenreW>Hard-Boiled Detective</ex:hasGenreW>
    <ex:hasPageCountW>110</ex:hasPageCountW>
    <ex:isPartOfSeriesW>Persons Non Grata</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2016 October 11</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Red_Americans">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Red Americans</rdfs:label>
    <ex:hasAnnotation>Cody Goodfellow United States English 01Publishing Whispers from the Abyss Vol. 2: The Horrors That Are &amp; Shall Be date October 2015 " " is a short Cthulhu Mythos story by American Cody Goodfellow , first published in the anthology of Lovecraftian fiction Whispers from the Abyss Vol. 2: The Horrors That Are &amp; Shall Be by 01Publishing in October 2015. Synopsis The plant supervisor of a hellish Chinese work camp which uses Tcho-Tcho labour to assemble a revolutionary new toy watches in disgust as her labour force are physically changed by the bizarre material used in their construction. After being introduced to a Tcho-Tcho priestess, she makes a deal with a dark god - either Zhar or Lloigor , the story is unclear - to spread their malevolent influence.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Cody_Goodfellow"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Shall Be</ex:isPublishedAsW>
    <ex:isPublishedAsW>Whispers from the Abyss Vol. 2: The Horrors That Are</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Tree_Men_of_Mbwa_%28short_story%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Tree Men of M'bwa (short story)</rdfs:label>
    <ex:hasAnnotation>The tree men of m'bwa is a short story by donald wandrei . It was first published in the february 1932 edition of weird tales . Some of its content has been incorporated into later mythos stories .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Donald_Wandrei"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>February 1932</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mountains_of_Madness_%28Eldritch_Horror%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Mountains of Madness (Eldritch Horror)</rdfs:label>
    <ex:hasAnnotation>Mountains of Madness Nikki Valens Fantasy Flight Games Publication Date 2014 Board game Eldritch Horror Mountains of Madness is an expansion set for the Eldritch Horror Cthulhu Mythos roleplaying game. Designed by Nikki Valens and featuring artwork by Jake Murray, it was published by Fantasy Flight Games in 2014 . Overview External Links "Breaking the Ice" at the Fantasy Flight Games website Gallery References</ex:hasAnnotation>
    <ex:wasPublishedOnW>2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mbasui_Gwandu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>M'basui Gwandu</rdfs:label>
    <ex:hasAlternativeNamesC>The River Abomination</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The River Abomination Congo River (speculated) First appearance EXP : " Ngiri's Catch " Created by Aaron Polson , also known as The River Abomination , is a fictional entity created by American author Aaron Polson for his short Cthulhu Mythos story " Ngiri's Catch ". Overview is a spider-eyed bat-winged horror which lurks in the depths of the Congo River.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Ngiris_Catch"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Aaron_Polson"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Etienne_Roulet">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Etienne Roulet</rdfs:label>
    <ex:ceasedOnC>http://example.org/lovecraft#Rhode_Island Providence</ex:ceasedOnC>
    <ex:hasAnnotation>Jacques roulet is a fictional character in h. p. lovecraft's short story " the shunned house " it is suggested in the story that he is a relative of the historical figure jacques roulet . The roulets moved to east greenwich, r.i., in 1686, "after the revocation of the edict of nantes"</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Shunned_House"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mlandoth_Cycle">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#StoryCycles"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Mlandoth Cycle</rdfs:label>
    <ex:hasAnnotation>The cycle gets its name from the creator deity, mlandoth . Other important deities are ngyr-khorath , its avatar or "extension" 'ymnar , the "nuclear force-creature" paighon and the fertility goddess yidhra .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Francescis_Cult_of_the_Necronomicon:_An_Interlude">
    <rdf:type rdf:resource="http://example.org/lovecraft#BhyhlunSeries"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Francesci's Cult of the Necronomicon: An Interlude</rdfs:label>
    <ex:hasAnnotation>Ian Davey English Bh'Yhlun Al-Azif date March 1998 " " is a short story by Ian Davey . It is the third entry in his Bh'Yhlun of Cthulhu Mythos fiction. Synopsis TBA History "" was published in the March/April 1998 issue of short-lived fanzine Al-Azif .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ian_Davey"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#BhYhlun"/>
    <ex:isPublishedAsW>Al-Azif</ex:isPublishedAsW>
    <ex:wasPublishedOnW>March 1998</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Urgo-Hem">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Urgo-Hem</rdfs:label>
    <ex:ceasedOnC>21st Century</ex:ceasedOnC>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Ogdru_Jahad"/>
    <ex:hasAnnotation>Dawn of time 21st Century Earth Relatives Ogdru Jahad (parents) Ogdru Jahad Ogdru Hem First appearance Hellboy: The Island B.P.R.D.: The Devil You Know — Ragna Rok Created by Mike Mignola  is one of the Ogdru Hem , spawn on the Ogdru Jahad . It served as the main antagonist in Hellboy: The Island .</ex:hasAnnotation>
    <ex:hasAppearanceC>B.P.R.D.: The Devil You Know — Ragna Rok</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC>Hellboy: The Island</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Mike_Mignola"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Algernon_Harris">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Algernon Harris</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Manhattan_Museum_of_Fine_Arts"/>
    <ex:hasAnnotation>Despite being only 26 at the time of the novel, has post-graduate degrees from yale and oxford, and has recently succeeded the late halpin chalmers as curator of archaeology . Despite his young age and generally informal attitude, harris is very capable of speaking with authority if needed .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Horror_from_the_Hills"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Frank_Belknap_Long"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_in_the_Comics_Part_One:_The_Superhero_Books">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu in the Comics Part One: The Superhero Books</rdfs:label>
    <ex:hasAnnotation>Despite its title, no follow-up articles were ever published . The piece offers a brief history of cthulhu mythos and lovecraftian elements in the comic book medium . It was published in the online fanzine nightscapes in december 1997 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Boyd_E._Pearson"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#James_Ambuehl"/>
    <ex:hasAuthorW>Dan Ross</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Nightscapes_December_1997"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Crawler">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Crawler</rdfs:label>
    <ex:hasAnnotation>Full story online here James A. Gruetzmacher English Genre(s) Horror Nightscapes #16 date October 2006 " " is a Cthulhu Mythos poem by James A. Gruetzmacher . Synopsis A man unwittingly summons a creature from Yeb (possibly one of its offspring), which proceeds to stalk him, with the intent of consuming him body and soul. History "" was published in the online Mythos zine Nightscapes in October 2006.</ex:hasAnnotation>
    <ex:hasAuthorW>James A. Gruetzmacher</ex:hasAuthorW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Nightscapes #16</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2006</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Patrick_McEvoy">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Patrick McEvoy</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Artist http://www.megaflowgraphics.com/  is an artist who has provided images for Lovecraftian and Cthulhu Mythos works, including book covers and graphic novels. With regards to this wiki, he is most notable for his association with independent publishing house 01Publishing and his work on the Arkham Horror Files line of Mythos gaming by Fantasy Flight Games . Selected Works Collections Whispers from the Abyss Vol. 2: The Horrors That Are &amp; Shall Be (2015) Graphic Novels Casefile: Arkham- Nightmare on the Canvas (2016) Casefile: Arkham- Her Blood Runs Cold (2018) See Also Images by External Links at The Internet Speculative Fiction Database</ex:hasAnnotation>
    <ex:hasWebsiteR>http://www.megaflowgraphics.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Artist</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mongoose_%28story%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Mongoose (story)</rdfs:label>
    <ex:hasAnnotation>"mongoose" centers on the relationship between . Izrael irizarry, an exterminator of interdimensional vermin, and . Mongoose, an alien creature with whom he has a symbiotic bond . The story first appeared in the anthology lovecraft unbound (dark horse books, 2009)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Elizabeth_Bear"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Sarah_Monette"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Boojumverse"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Lovecraft_Unbound"/>
    <ex:wasPublishedOnW>2009 October 13</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Waycross">
    <rdf:type rdf:resource="http://example.org/lovecraft#CaitlinRKiernanWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Waycross</rdfs:label>
    <ex:hasAnnotation>" alabaster les fleurs empoisonnées " is a short story by caitlin r. kiernan . It tells of the capture by and eventual defeat of the gynander . Along the way, she kills the gynander's friend sinethella .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Dancy_Flammarion"/>
    <ex:wasPublishedOnW>2003</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>March 2002</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Every_Star_is_Mad">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Every Star is Mad</rdfs:label>
    <ex:hasAnnotation>C. M. Fields English Genre(s) Weird fiction Lovecraftiana Vol 5 Issue 1 date 2020  " " is a short Lovecraftian story by C. M. Fields. Synopsis A National Aeronautics and Space Administration researcher searches for something deep in space as a series of astronomical anomalies occurs throughout the galaxy. When she finds the event she is looking for, it starts to move closer, and reality begins to unravel. History "" was published in Vol 5, Issue 1 of the Lovecraftiana zine in 2020</ex:hasAnnotation>
    <ex:hasAuthorW>C. M. Fields</ex:hasAuthorW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Lovecraftiana Vol 5 Issue 1</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yikilth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MysticalArtefacts"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Yikilth</rdfs:label>
    <ex:hasAnnotation>Colossal iceberg-fortress created by clark ashton smith for his short cthulhu mythos story " the coming of the white worm " emitted a pale light for miles which froze solid anything it touched . Grew as its master consumed the bodies and souls of sorcerers, and absorbed the domiciles of these dead unfortunates into its mass .</ex:hasAnnotation>
    <ex:hasOriginA>Unknown possibly extra-dimensional</ex:hasOriginA>
    <ex:hasTypeA>Iceberg-fortress</ex:hasTypeA>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_Coming_of_the_White_Worm"/>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
    <ex:wasDestroyedOnA>Hyperborean Age</ex:wasDestroyedOnA>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Supernatural_%28TV_show%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MediaAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Supernatural (TV show)</rdfs:label>
    <ex:hasAnnotation>"supernatural" was a tv series that ran from 2005-2020 on the cw network . In one episode, lovecraft appears in a flashback, killed by an unseen intruder . The show borrowed from numerous folkloric and horror traditions, including the cthulhu mythos .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Walter_J_Coates">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Walter J Coates</rdfs:label>
    <ex:diedOnR>1941</ex:diedOnR>
    <ex:hasAnnotation>Friend of W. Paul Cook and editor of the Vermont magazine Driftwind.</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1880</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Bones_of_the_Old_Ones_and_Other_Lovecraftian_Tales">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Bones of the Old Ones and Other Lovecraftian Tales</rdfs:label>
    <ex:hasAnnotation>Jeffrey Thomas English Necropolitan Press Release Date 1995 Followed by Avatars of the Old Ones  is a chapbook collection of Lovecraftian and Cthulhu Mythos fiction by American Jeffrey Thomas . It was published by Necropolitan Press in 1995. Contents " The Bones of the Old Ones " "Book Worm" "The Ice Ship" " Lost Soul " "The Boarded Window" "The House on the Plain"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Jeffrey_Thomas"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1995</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Collapsing_Cosmoses">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Collapsing Cosmoses</rdfs:label>
    <ex:hasAnnotation>Full story online here Howard Phillips Lovecraft and R. H. Barlow United States English Genre(s) Science Fiction short story Leaves Media type Print (periodical) ← Previous Next → " Till A' the Seas " with R. H. Barlow " The Challenge from Beyond " with C. L. Moore ; A. Merritt ; Robert E. Howard , and Frank Belknap Long " " is a very short (and apparently humorous) science fiction story by the late American authors H. P. Lovecraft and R. H. Barlow . Despite being billed as a short story, a more accurate description might be a fragment of an uncompleted work. It was published the year after Lovecraft's death by the fanzine Leaves . Synopsis Alien beings begin to muster their forces for war after receiving notice that a fleet of unidentified ships are converging on their area of the cosmos.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Howard_Phillips_Lovecraft"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#R._H._Barlow"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Science Fiction short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#PS_Publishing">
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SmallPress"/>
    <rdfs:label>PS Publishing</rdfs:label>
    <ex:hasAnnotation>Current Status Active 1999 Peter Crowther United Kingdom Drugstore Indian Press https://pspublishing.co.uk/ is a World Fantasy Award-winning small press by Peter Crowther in 1999 and based in the United Kingdom. Specialising in novella-length works, as well as a number of anthologies and collections, it publishes horror, science fiction, and fantasy works in collectible editions, many of which are offered as signed copies upon their initial release. PS has issued a number of Lovecraftian and Cthulhu Mythos publications, including the Black Wings anthologies, and the Lovecraft Illustrated series, which reprints H. P. Lovecraft stories along with new artwork and a selection of related short stories and/or non-fiction. Selected Publications Lovecraft Illustrated The Dunwich Horror (2014) The Shadow Out of Time (2015) The Shadow Over Innsmouth (2015) Black Wings Black Wings (2010) Black Wings II (2012) Black Wings III (2014) Black Wings IV (2015) Black Wings V (2016) Black Wings VI (2017) Anthologies The Starry Wisdom Library (2014) Innsmouth Nightmares (2015) Through a Mythos Darkly (2017) Tales from the Miskatonic University Library (2017) Mountains of Madness Revealed (2019) New Maps of Dream (2021) Collections The Inhabitant of the Lake and Less Welcome Tenants (2011, Ramsey Campbell ) Dark Gods (2021, T. E. D. Klein ) Novels The Darkest Part of the Woods (2003, Ramsey Campbell ) The Ceremonies (2016, T. E. D. Klein ) References About Us section , at Wikipedia</ex:hasAnnotation>
    <ex:hasWebsiteR>https://pspublishing.co.uk/</ex:hasWebsiteR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Primal_Sources:_Essays_on_H._P._Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Primal Sources: Essays on H. P. Lovecraft</rdfs:label>
    <ex:hasAnnotation>208 is a collection of non-fiction by renowned lovecraft scholar s. t. joshi . It is divided into three themed sections and contains 23 previously-published essays . It was published by hippocampus press in 2003 and is now available in a digital download format .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#S._T._Joshi"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:hasPageCountW>208</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2003</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dunwich_Father">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dunwich Father</rdfs:label>
    <ex:hasAnnotation>A short story by american josh reynolds writing as joshua reynolds . 'saul whateley' is a direct descendant of wilbur whateley with all of the abilities and deformities one might expect from such a creature . Absinthe marsh is a deep one hybrid on the cusp of claiming her birthright .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Josh_Reynolds"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>May 2003</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#An_Age_Undreamed_Of">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>An Age Undreamed Of</rdfs:label>
    <ex:hasAnnotation>Chris Claremont John Romita Jr, Dan Green English Marvel Comics Release Date Feb 1985-March 1985 Media Type Comic book An Age of Undreamed Of is a 2-part story arc in issues #190-191 of the 1st volume of Uncanny X-Men written by Chris Claremont. Synopsis The Hyborian sorcerer Kulan Gath attempts to remake the world in his image. External Links at the Marvel Database wiki</ex:hasAnnotation>
    <ex:hasAuthorW>Chris Claremont</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>Feb 1985-March 1985</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Vampire_Intelligence">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Vampire Intelligence</rdfs:label>
    <ex:hasAnnotation>Vampire intelligences are a race of sadistic and malevolent alien intelligences . They are inter-dimensional conquerors and rivals of the splugorth . Can send fragments of their essence into other dimensions .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Rifts"/>
    <ex:wasCreatedByC>Palladium Games</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Changeling_%28Lumley%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#BrianLumleyWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Changeling (Lumley)</rdfs:label>
    <ex:hasAnnotation>The Changeling (Lumley) Brian Lumley English Genre(s) Cthulhu Mythos Jo Fletcher Books Fearie Tales date October 24, 2013 "The Changeling" is a Cthulhu Mythos short story by Brian Lumley , first published in the anthology Fearie Tales: Stories of the Grimm and Gruesome (Jo Fletcher Books, 2013). It was later republished in Lumley's collection Earth, Air, Fire &amp; Water: Four Tales of Elemental Mythos Horror! (Tor, 2017); the story was chosen to represent the element of water. Synopsis A British visitor to a Greek island meets a monk on the beach with the Innsmouth look. The Englishman, an antiquarian with a specialty in old coins, finds himself fascinated with the monk's medallion.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Fearie Tales</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2013 October 24</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dust_of_the_Gods">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dust of the Gods</rdfs:label>
    <ex:hasAnnotation>Wtis is a science fiction short story by c. l. moore . It was first published in the august 1934 issue of weird tales . It is notable for providing information about pharol . Pharol was first incorporated into the cthulhu mythos by henry kuttner .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Old_One_%28disambiguation%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Disambiguations"/>
    <rdfs:label>Old One (disambiguation)</rdfs:label>
    <ex:hasAnnotation>" old one " is an ambiguous term in the cthulhu mythos . May refer to: great old ones , a pantheon of dormant alien deities buried inside the earth . May also refer to: elder things , a species of alien lifeform .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Augusta_Charlotte_Allgood">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Augusta Charlotte Allgood</rdfs:label>
    <ex:diedOnR>12 March 1884</ex:diedOnR>
    <ex:hasAnnotation>The younger sister by 22 years of Helen Allgood, she was adopted at age ten by Helen’s husband, George, when her father, William Allgood, died.</ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1842</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Fane_of_the_Black_Pharaoh">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Fane of the Black Pharaoh</rdfs:label>
    <ex:hasAnnotation>One of bloch's egyptian tales, it elaborates on the hints dropped in h. p. lovecraft 's fiction about the black pharaoh nephren-ka . Focuses on captain carteret, an archaeologist who is given a chance by a mysterious egyptian stranger to see the legendary temple-tomb of nephren-ka .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_Bloch"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>December 1937</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sheriff_Engle">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Sheriff Engle</rdfs:label>
    <ex:hasAffiliationC>Arkham County Sheriff's Department</ex:hasAffiliationC>
    <ex:hasAnnotation>Arkham horror engle is the head of the arkham county sheriff's department . Made his first appearance as a blight card for the expansion exp : the king in yellow . Hinted that he may have been in the pocket of the lodge's high priest .</ex:hasAnnotation>
    <ex:hasAppearanceC>( EXP ): The King in Yellow ( EXP ): Feeders from Within ( EXP ): Ire of the Void</ex:hasAppearanceC>
    <ex:hasCharacterMateC>Irma Engle (wife)</ex:hasCharacterMateC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Grace">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Grace</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Great_Old_One"/>
    <ex:hasAlternativeNamesC>Greater Old Ones</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The are a benevolent group of great old ones who created the key to time . They exist outside of time and space, in a state of non-existence . The doctor imagined them as "big, peaceful, pan-dimensional creatures"</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Judgement of Isskar</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>The Prisoner's Dilemma</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Simon Guerrier</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#NGarai_Cairn">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ArtefactsOriginatingFromMythosAdjacentWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MysticalArtefacts"/>
    <rdfs:label>N'Garai Cairn</rdfs:label>
    <ex:hasAnnotation>The cairns are used by the demonic n'garai to cross over into other dimensions . The number of n'garai that can come through one of them varies . One can also travel to the n'garai dimension via one of these cairns .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Boyd_E._Pearson">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonFictionAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Boyd E. Pearson</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Poet Lovecraftian Horror Non-fiction is an author of fiction, non-fiction and poetry who has written a handful of works in and around the Cthulhu Mythos of H. P. Lovecraft . These have been included in publications such as the Cthulhu Cultus and Nightscapes fanzines. Selected Bibliography Poetry " Mob Hit " (1997) Non-Fiction " Cthulhu in the Comics Part One: The Superhero Books " (1997, with James Ambuehl and Dan Ross) External Links at the Internet Speculative Fiction Database</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Poet</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mi-Go_Brain_Cylinder">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#TechnologicalArtefacts"/>
    <rdfs:label>Mi-Go Brain Cylinder</rdfs:label>
    <ex:hasAnnotation>Brain cylinders are a cylindrical, medium sized machine used by the mi-go . They contain a living human brain, vivisected from its host and preserved in nutrient fluid . The cylinder can be connected with various devices that provide the faculties of sight, hearing and speech to the brain .</ex:hasAnnotation>
    <ex:hasFunctionA>Life support</ex:hasFunctionA>
    <ex:hasTypeA>Medical equipment</ex:hasTypeA>
    <ex:isUsedByA>The Mi-Go</ex:isUsedByA>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_Whisperer_in_Darkness"/>
    <ex:wasCreatedByA>The Mi-Go</ex:wasCreatedByA>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Fictional">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Character"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Satyr">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SpeciesIncorporatedFromFolkloreMythAndReligion"/>
    <rdfs:label>Satyr</rdfs:label>
    <ex:hasAnnotation>Satyrs are imaginary creatures from greek mythology, often depicted as having the upper half of a man and the lower half of a goat . Though creatures resembling them have frequently been incorporated into cthulhu mythos fiction, they aren't actual satyrs in the sense of the greek legends .</ex:hasAnnotation>
    <ex:hasAppearanceC>The Satyr The Dark Eidolon Ire of the Void</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC>Poetry</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>the Gods</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Anna_Helen_Crofts"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nitokris">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Nitokris</rdfs:label>
    <ex:hasAnnotation>Nitocris was a possibly historical queen of ancient egypt . She may have ruled at the end of the 6th dynasty, from 2184–2181 bc . Legend was incorporated into the cthulhu mythos .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Imprisoned_with_the_Pharaohs"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Arcturus">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Stars"/>
    <rdfs:label>Arcturus</rdfs:label>
    <ex:hasAnnotation>Polaris is a red giant star in the constellation boötes in the northern sky . It is the fourth brightest star in the night sky, and the brightest in the northern celestial hemisphere . One easy method of finding from the northern hemisphere is by following the curve of the handle of the big dipper .</ex:hasAnnotation>
    <ex:hasTypeL>Star</ex:hasTypeL>
    <ex:isLocatedAtL>Northern sky (Boötes)</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#Polaris"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Darghuds_Doll">
    <rdf:type rdf:resource="http://example.org/lovecraft#BrianLumleyWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Darghud's Doll</rdfs:label>
    <ex:hasAnnotation>Brian Lumley English Titus Crow Genre(s) Cthulhu Mythos The Horror at Oakdeene and Others date 1977 ← Previous Next → Billy's Oak De Marigny's Clock "" is a Cthulhu Mythos story by Brian Lumley , featuring the occult investigator Titus Crow . It first appeared in The Horror at Oakdeene and Others ( Arkham House , 1977). Synopsis When writer Gerald Dawson asks for an example of "imitative magic," Titus Crow offers a tale of a British doctor in Africa whose life is first threatened and then accidentally ended by means of a magical doll. History After its initial appearance in The Horror at Oakdeene , "" was reprinted in Lumley's collection The Compleat Crow (W. Paul Ganley, 1987). References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Titus_Crow"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Horror_at_Oakdeene"/>
    <ex:isPublishedAsW>Others</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1977</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Algol_%28Adrian_M._Kleinbergen%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Algol (Adrian M. Kleinbergen)</rdfs:label>
    <ex:hasAnnotation>Algol Full story online here Adrian M. Kleinbergen English Genre(s) Horror Nightscapes #8 date July 1998 " Algol " is a short Cthulhu Mythos poem by Canadian and artist Adrian M. Kleinbergen . Synopsis The three four-line verses recap the story narrated in H. P. Lovecraft 's " Beyond the Wall of Sleep ". History "Algol" was published in Edward P. Berglund 's online Mythos fanzine Nightscapes in July 1998.</ex:hasAnnotation>
    <ex:hasAuthorW>Adrian M. Kleinbergen</ex:hasAuthorW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Nightscapes #8</ex:isPublishedAsW>
    <ex:wasPublishedOnW>July 1998</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Guerrera">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Guerrera</rdfs:label>
    <ex:ceasedOnC>1925</ex:ceasedOnC>
    <ex:hasAnnotation>Cthulhu is a fictional character created by h. p. lovecraft . He makes his only appearance in the 1928 short story " the call of cthulhu " .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Call_of_Cthulhu"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#wasCreatedBynO">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>wasCreatedBynO</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/lovecraft#Organisation"/>
