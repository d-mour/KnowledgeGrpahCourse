    <ex:hasAlternativeNamesC>The Astronomer</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as the astronomer unknown, possibly arkham . Created by fantasy flight games who has made numerous in their various expansions to the cthulhu mythos .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Arkham_Horror:_The_Card_Game"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Eldritch_Horror"/>
