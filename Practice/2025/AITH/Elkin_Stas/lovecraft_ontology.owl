  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Thing_on_the_Roof">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RobertEHowardWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Thing on the Roof</rdfs:label>
    <ex:hasAnnotation>A london scholar is contacted by a rival academic who wants his help in finding an original copy of von junzt's nameless cults . He failed to heed von junzt's warning, however, and met his doom in the form of a hoofprint from a vengeful god . The exact nature of the entity which kills tussman at the climax ofis left intentionally vague .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>February 1932</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shuma-Gorath">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Shuma-Gorath</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAffiliationC>unknown</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#The_Sleeping_One"/>
    <ex:hasAlternativeNamesC>Lord of the Nothing Realm</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Mr. Tentacles</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The All-Killer of the Dawn</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Conqueror of Midnight</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Devourer-God of the Eternal Ever-Was</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Evil One Who Sleeps</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Father of All Evil</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The God Who Sleeps</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Great One Who Slumbers</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Unclosing Eye</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Void Made Flesh</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Withering Devourer</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>History is a member of the great old ones, a race of malevolent cosmic entities that fed on the flesh and bones of mankind's ancestors . First mentioned in a short story by robert e. howard from the 1920s called " the curse of the golden skull " has appeared in other marvel comics and his manifestations have battled various heroes and teams, including the x-men .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Appearance - Marvel Premiere #10</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>Mentioned - The Curse of the Golden Skull</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Roy_Thomas"/>
    <ex:wasCreatedByC>Frank Brunner.</ex:wasCreatedByC>
    <ex:wasCreatedByC>Gardner Fox</ex:wasCreatedByC>
    <ex:wasCreatedByC>Steve Englehart</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Hydra_%28short_story%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Hydra (short story)</rdfs:label>
    <ex:hasAnnotation>"hydra " is a short story by american and friend of h.p. Lovecraft 's henry kuttner . It was originally published in 1939 . Two amateur occult enthusiasts stumble upon a pamphlet with instructions on astral projection . Their experiment results in kenneth scott being captured by a transdimensional entity .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Henry_Kuttner"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>April 1939</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Salem_Hawley_%28series%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#StoryCycles"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Salem Hawley (series)</rdfs:label>
    <ex:hasAnnotation>Salem Hawley Michael Patrick Hicks United States English Genre(s) Lovecraftian horror Release Date 2019-2020 Salem Hawley is a series of Cthulhu Mythos novellas by American Michael Patrick Hicks . As of March 2024, there are only two books in the series, although in the "Acknowledgements" section of the first book, The Resurrectionists , Hicks states that there are another " two Salem Hawley books to follow ." Overview Taking place on America 's east coast in 1788, the series follows the adventures of Salem Hawley, a freed black slave from New York , as he tackles the otherworldly forces of the Cthulhu Mythos and their human agents. The first book puts a supernatural spin on the 1788 Doctors' Riot, a real-world event involving a spat of civil disobedience in the aftermath of a series of high-profile graverobbings , while the second concerns Hawley's search for the stolen Al Azif amidst a plague of supernatural beasts in the town of Arkham , Massachusetts . Books The Resurrectionists (2019) Borne of the Deep (2020) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Michael_Patrick_Hicks"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Lovecraftian horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2019-2020</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Gray_Man">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Gray Man</rdfs:label>
    <ex:hasAnnotation>The is a supernatural character created by american comic book creator michael alan nelson for the fall of cthulhu story arc named for the character . He made his first appearance in issue #11 of that series in march 2008 . Possesses a ceremonial knife which he prefers to use to kill his victims .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Fall_of_Cthulhu_Volume_3:_The_Gray_Man"/>
    <ex:madeFirstAppearanceOnC>issue #11</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Michael_Alan_Nelson"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Keeping_it_Under_Wraps">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Keeping it Under Wraps</rdfs:label>
    <ex:hasAnnotation>Looking for darla was published as a bonus story in the second edition of his collection looking for darla: stories of mythos noir by tenoka press in 2017 . Private detective wade kearney takes on a case for former miskatonic university faculty member professor kearney . After tracking the mummy to its hiding place in a pit of quicksand, kearney is able to destroy the malevolent being .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Looking_for_Darla:_Stories_of_Mythos_Noir"/>
    <ex:wasPublishedOnW>2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Quachil_Uttaus">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Quachil Uttaus</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Keeper of the Dust</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Treader of the Dust</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Ultimate Corruption</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The treader of the dust is a fictional entity created by . Clark ashton smith for his short story " the treader of the dust ". Later incorporated into the cthulhu mythos . Is usually associated with age, death, and decay .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Treader of the Dust</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Chorazin">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Disambiguations"/>
    <rdfs:label>Chorazin</rdfs:label>
    <ex:hasAnnotation>Locations , a Galilean village mentioned in the New Testament, or one of the places in horror fiction that takes its name from it. Entities , an avatar of Cthulhu created for the Call of Cthulhu roleplaying game .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Houses_Under_the_Sea">
    <rdf:type rdf:resource="http://example.org/lovecraft#CaitlinRKiernanWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Houses Under the Sea</rdfs:label>
    <ex:hasAnnotation>Caitlin R. Kiernan English Robinson The Mammoth Book of Best New Horror: Volume 18 date October 2007  "" is a short story by Caitlin R. Kiernan , originally published in the 2007 anthology The Mammoth Book of Best New Horror: Volume 18 . It takes the form of a journalist's reminiscences about his affair with Jacova Angevine, a cult leader who led a mass suicide into the Pacific Ocean . The story was reprinted in Thrillers 2 (2007) and Lovecraft Unbound: Twenty Stories (2009). It was included in Kiernan's collections Two Worlds and In Between: The Best of Caitlin R. Kiernan (2011) and The Very Best of Caitlin R. Kiernan (2019). It is the title story of Kiernan's Lovecraftian collection, : Mythos Tales (2018).</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>The Mammoth Book of Best New Horror: Volume 18</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2007</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Fragments_from_the_Journal_of_a_Solitary_Man">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Fragments from the Journal of a Solitary Man</rdfs:label>
    <ex:hasAnnotation>Nathaniel Hawthorne United States English James R. Osgood and Co. Fanshawe, the Dolliver Romance, and Other Pieces date 1876 " " is a short story by the late American Nathaniel Hawthorne , first published posthumously in the collection Fanshawe, the Dolliver Romance, and Other Pieces in 1876. Lovecraft scholars S. T. Joshi and David E. Schultz have suggested that it was an inspiration for the short story " The Outsider " . Synopsis A man dreams that he is walking down Broadway in a burial shroud, only understanding the shocked reaction of passersby when he sees his reflection in a shop window. References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Nathaniel_Hawthorne"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Fanshawe</ex:isPublishedAsW>
    <ex:isPublishedAsW>Other Pieces</ex:isPublishedAsW>
    <ex:isPublishedAsW>the Dolliver Romance</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1876</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Subtler_Magick:_The_Writings_and_Philosophy_of_H._P._Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Subtler Magick: The Writings and Philosophy of H. P. Lovecraft</rdfs:label>
    <ex:hasAnnotation>316 is a non-fiction work by lovecraft scholar and critic s. t. joshi . It was published by wildside press in october 1996 under their borgo press imprint . Focuses on the writings of lovecraft rather than his life .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#S._T._Joshi"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:hasPageCountW>316</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>October 1996</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Arkham_Sanitarium_%28Call_of_Cthulhu%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Arkham Sanitarium (Call of Cthulhu)</rdfs:label>
    <ex:hasAnnotation>Arkham Sanitarium Drashi Khendup Eric Vogt (additional material) Cover Artist Drashi Khendup English Call of Cthulhu Genre(s) Roleplaying game Chaosium Release Date May 1997 32 Arkham Sanitarium is a collection of gaming aids/player handouts for Chaosium 's Call of Cthulhu horror roleplaying game. Created by Drashi Khendup with additional material by Eric Vogt , it was published in a paperback format in May 1997 . The book is currently out-of-print and likely to remain so due to the ease of players creating digital aids themselves using current technology, and the wealth of player-created resources which have sprung up in the years since its release, particularly through initiatives such as the Miskatonic Repository . Overview References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Drashi_Khendup"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Eric_Vogt"/>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>32</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>May 1997</ex:wasReleasedOnW>
  </rdf:Description>
