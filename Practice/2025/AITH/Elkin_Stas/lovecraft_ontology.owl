    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Howard Lovecraft and the Kingdom of Madness</rdfs:label>
    <ex:hasAnnotation>Preceded by howard lovecraft and the undersea kingdom followed by howard lovecraft and the three kingdoms is a graphic novel published by arcana studio . Written by bruce brown and featuring artwork by thomas boatwright, it was released in november 2013 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Bruce_Brown"/>
    <ex:hasPageCountW>84</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Howard Lovecraft</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>November 2013</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#In_the_Vaults_Beneath">
    <rdf:type rdf:resource="http://example.org/lovecraft#BrianLumleyWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>In the Vaults Beneath</rdfs:label>
    <ex:hasAnnotation>Archaeologist and two amateur colleagues decipher the g'harne fragments . Discover an undercover complex, known only as the outpost, built by the elder things . Before they have a chance to return to the site, it suddenly disappears along with all items taken from it .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Caller_of_The_Black"/>
    <ex:wasPublishedOnW>1971</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Something_Missing">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Something Missing</rdfs:label>
    <ex:hasAnnotation>M. Stern English Genre(s) Weird fiction Rogue Planet Press Lovecraftiana Vol 8, Issue 2 date July 2023 " " is a short Cthulhu Mythos story by M. Stern . It was published in the Gavin Chappell -edited zine Lovecraftiana , Vol 8, Issue 2 by Rogue Planet Press in July 2023 . Synopsis When a crazed drug addict attempts to rob a fast food restaurant, a series of cosmic events is set in motion. During the course of the robbery, a priest of Azathoth in the guise of a homeless man opens a portal to his dark god, and the cashier, who has always felt that he was missing a part of himself, unites with his mirror self from another dimension. References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#M._Stern"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 2</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 8</ex:isPublishedAsW>
    <ex:wasPublishedOnW>July 2023</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Final_Defense">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Final Defense</rdfs:label>
    <ex:hasAnnotation>Tom Brevoort, Mike Kanterovich Bill Wylie, Tony DeZuniga English Marvel Comics Release Date Dec 1994 - March 1995 Media Type Comic book is a 4-part story arc in issues #22-25 of the 1st volume of Secret Defenders written by Tom Brevoort and Mike Kanterovich. Synopsis A corrupted Doctor Druid attempts bring to Earth Slorioth , one of the Great Old Ones , and two superhero teams (The Defenders and the Secret Defenders) stand against him and Slorioth.</ex:hasAnnotation>
    <ex:hasAuthorW>Mike Kanterovich</ex:hasAuthorW>
    <ex:hasAuthorW>Tom Brevoort</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>Dec 1994 - March 1995</ex:wasReleasedOnW>
  </rdf:Description>
