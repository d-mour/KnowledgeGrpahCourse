    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Punktown (gaming supplement)</rdfs:label>
    <ex:hasAnnotation>Punktown: a setting book for call of cthulhu and basic roleplaying is a setting supplement designed for use with chaosium 's call of cthulhu and basic roleplaying game systems . It was designed by mike tresca, glynn owen barrass, and brian m. sammons . Punktown contains three ready-to-play scenarios and a pair of short stories by . Jeffrey thomas set in his dystopian punktown milieu .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_M._Sammons"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Glynn_Owen_Barrass"/>
