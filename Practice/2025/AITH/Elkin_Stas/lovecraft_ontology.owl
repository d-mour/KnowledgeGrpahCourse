  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Unspeakable_Betrothal">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Unspeakable Betrothal</rdfs:label>
    <ex:hasAnnotation>Avis long is obsessed with creatures from her dreams and the round window in her bedroom . The creatures from her dreams come from yuggoth, which is described as "not beyond the rim of stars but between it" the story originally appeared in avon fantasy reader no. 9 (1949)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_Bloch"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>1949</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Wonderland_%28Comics%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Wonderland (Comics)</rdfs:label>
    <ex:hasAnnotation>Wonderland (Comics) various various English Zenescope Entertainment Release Date May 2007 - July 2018 Media Type Comic book Wonderland was a continuity-heavy comic book franchise starring various female protagonists, who battled the forces of the Lovecraftian dimension of Wonderland . Published by Zenescope Entertainment, it spanned a little over a decade, from 2007 to 2018. It consisted of one main comic series (Wonderland), eleven mini-series, an annual series, one series of one-shots, and two individual one-shots. Wonderland was the largest and most popular spin-off from the "Grimm Fairy Tales" line of comic books. R'lyeh is mentionned in " Return to Wonderland " The Mythos are alluded to, but not explicitely, in " Alice in Wonderland " Lovecraft is involved in the narrative of " Call of Wonderland " and " The Madness of Wonderland " Series Return to Wonderland #0 – #6 Beyond Wonderland #0 – #6 Wonderland Annuals #2009-2012 (one shots) TBC TBC The House of Liddle TBC Escape From Wonderland #0 – #6 Tales from Wonderland (one shots collected in 3 volumes) Queen of Hearts Mad Hatter Alice The Experiment Cheshire Cat Red Queen Tweedle Dee &amp; Tweedle Dum Mad Hatter part 2 The Arrangement White Knight Red Rose Queen of Hearts Vs Mad Hatter Redemption Alice in Wonderland #1 – #6 Call of Wonderland #1– #4 Wonderland #1 – #50 Wonderland Finale (one shot) The Madness of Wonderland #1 – #4 Wonderland: Down the Rabbit Hole #1 – #5 Wonderland: Through the Looking Glass #1 – #5 Wonderland: Asylum #1 – #5 Clash of Queens #1 – #5 Birth of Madness (one shot) Revenge of Wonderland #1 – #6</ex:hasAnnotation>
    <ex:hasAuthorW>various</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>May 2007 - July 2018</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Miskatonic_Museum_%28Mythos_Pack%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Miskatonic Museum (Mythos Pack)</rdfs:label>
    <ex:hasAnnotation>The miskatonic museum is the first mythos pack in the dunwich legacy cycle for arkham horror: the card game . This expansion contains 60 cards, which include 29 player cards and 11 encounter cards . The cards grant you access to the museum and its many exhibitions even while the expansion's twenty-six player cards vie for your attention.</ex:hasAnnotation>
    <ex:hasAuthorW>MJ Newman</ex:hasAuthorW>
    <ex:hasAuthorW>Nate French</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>Living Card Game</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Arkham_Horror:_The_Card_Game"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dreams_of_Yith">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dreams of Yith</rdfs:label>
    <ex:hasAnnotation>Dreams of yid is the first mention of the fictional planet yith . The poem cycle is the first mention of the home planet of the great race of yith . The poem cycle was first published in the june 1934 issue of the fantasy fan .</ex:hasAnnotation>
    <ex:hasAuthorW>Duane W. Rimel H.P. Lovecraft</ex:hasAuthorW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Fantasy_Fan"/>
    <ex:wasPublishedOnW>July 1934</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Discovery_of_the_Ghooric_Zone">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Discovery of the Ghooric Zone</rdfs:label>
    <ex:hasAnnotation>" -- march 15, 2337" is a short story by richard a. lupoff . It was first published in the anthology chrysalis in 1977 . Story is intercut with sketches of life in 2337, 2237, 2137, 2037, and 1937 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Richard_A._Lupoff"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Chrysalis</ex:isPartOfSeriesW>
    <ex:wasPublishedOnW>August 1977</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shoggoth_Apocalypse">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Shoggoth Apocalypse</rdfs:label>
    <ex:hasAnnotation>"the glorious return of herbert west" is a short story by authors mark mclaughlin and michael sheehan, jr. it is followed up by the story " the glorious return of herbert west ".</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mark_McLaughlin"/>
    <ex:hasAuthorW>Michael Sheehan. Jr.</ex:hasAuthorW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
