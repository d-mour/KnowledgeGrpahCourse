    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Night in the Lonesome October</rdfs:label>
    <ex:hasAnnotation>280 is a cthulhu mythos novel by the late american roger zelazny . First published by avonova/william morrow in august 1993 . Nominated for the nebula award for best novel in 1994 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Roger_Zelazny"/>
    <ex:hasPageCountW>280</ex:hasPageCountW>
