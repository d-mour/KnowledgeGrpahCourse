    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Poe and Lovecraft</rdfs:label>
    <ex:hasAnnotation>Robert Bloch United States English Genre(s) Non-fiction Ambrosia #2 date August 1973 " " is a short non-fiction piece by Howard Phillips Lovecraft 's friend and contemporary, the late American Robert Bloch . It first saw print in issue #2 of the fanzine Ambrosia by Gulette Publishing in August 1973. History Ambrosia #2 (1973) H. P. Lovecraft: Four Decades of Criticism (1980, 1981) Out of My Head (1986)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_Bloch"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
