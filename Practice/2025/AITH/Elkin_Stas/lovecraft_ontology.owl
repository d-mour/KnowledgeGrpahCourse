    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Thing From Beyond The Living Door</rdfs:label>
    <ex:hasAnnotation>Historywas published in the collection horrors &amp; abominations: 24 tales of the cthulhu mythos in december 2018 . It was written by authors mark mclaughlin and michael sheehan, jr.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mark_McLaughlin"/>
