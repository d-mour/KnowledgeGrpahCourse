  <rdf:Description rdf:about="http://example.org/lovecraft#God_of_the_Red_Flux">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>God of the Red Flux</rdfs:label>
    <ex:hasAffiliationC>Worshipped by the Tree-Men of M'bwa</ex:hasAffiliationC>
    <ex:hasAnnotation>The tree-men of m'bwa is a fictional entity created by the late american author donald wandrei . It made its first appearance in his 1932 short story " the tree men of m'bwa "</ex:hasAnnotation>
    <ex:isLocatedAtC>The Central African rainforests</ex:isLocatedAtC>
