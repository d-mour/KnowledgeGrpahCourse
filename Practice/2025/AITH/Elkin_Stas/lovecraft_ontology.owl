    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Collection of Gibson Flynn</rdfs:label>
    <ex:hasAnnotation>The children of gla'aki is a short horror story by american pete rawlik . It was published in the thematic anthology the children of gla'aki in 2017 .</ex:hasAnnotation>
    <ex:hasAuthorW>Pete Rawlik</ex:hasAuthorW>
