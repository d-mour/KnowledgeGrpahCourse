  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Zllphyan">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Zllphyan</rdfs:label>
    <ex:hasAnnotation>Zllyphan are a malevolent race of manipulators, alien intelligences . They appear as giant energy spheres the size of a house . They are capable of surviving a 6.5 megaton nuke, though with grievous wounds .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Rifts"/>
    <ex:wasCreatedByC>Palladium Games</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Drawn_from_Life">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Drawn from Life</rdfs:label>
    <ex:hasAnnotation>Crypt of cthulhu is a short story by prolific british author, john glasby . It is set in lovecraft's fictional world of the cthulhu mythos . The narrator is writing a book about obscure contemporary artists .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#John_Glasby"/>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Short Fiction Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu"/>
    <ex:wasPublishedOnW>September 1989</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Silver_Key">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Silver Key</rdfs:label>
    <ex:hasAnnotation>Wtis a continuation of the dream-quest of unknown kadath . It was followed by a sequel, " through the gates of ", co-written with e. hoffmann price . Lovecraft's recurring character of randolph carter is the protagonist .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Fantasy short story</ex:hasGenreW>
    <ex:hasGenreW>weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Dream_Cycle"/>
    <ex:isPartOfSeriesW>Cthulhu Mythos</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#God_%28Abrahamic%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>God (Abrahamic)</rdfs:label>
    <ex:hasAnnotation>God is, according to the abrahamic religions, the creator and ruler as well as the sustainer of the universe . "god" is used in interjections by william dyer, ( hpl : " at the mountains of madness ") marinus bicknell willett, ( hpl : the case of charles dexter ward ), henry armitage and francis morgan, ( hpl : the dunwich horror ) the reanimated eric moreland clapham-</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Hebrew Bible</ex:madeFirstAppearanceOnC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Clithanus">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Clithanus</rdfs:label>
    <ex:hasAffiliationC>Roman-Catholic Church</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Mad Monk</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The mad monk is a character created by the late american author august derleth . Little is known about him other than that he was a holy man in what would become england around 400ad . He is known in the modern day through his writings the confessions of .</ex:hasAnnotation>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#August_Derleth"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Night_Fang">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Night Fang</rdfs:label>
    <ex:hasAlternativeNamesC>Lord Akame</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Nightmare Monster</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Ultraman taiga is a kaiju in the fictional universe of the ultraman taiga tv series by tsuburaya productions . Also known as lord akame nightmare monster outer space created by makoto kamiya &amp; sotarohayashi .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Ultraman Taiga</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Makoto Kamiya</ex:wasCreatedByC>
    <ex:wasCreatedByC>Sotaro Hayashi</ex:wasCreatedByC>
  </rdf:Description>
