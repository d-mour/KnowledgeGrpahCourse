    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>M'nthster</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAnnotation>Relatives Cthulhu (father) Great Old Ones First appearance EXP : "Treehouse of Horror XXIV" EXP : "Halloween of Horror" The Simpsons: Tapped Out is a Great Old One from the fictional universe of The Simpsons animated series. He is the son of Cthulhu , however, he was abandoned by his father as a baby, after being traded in for a pair of designer sunglasses. first appeared in the intro for the episode "Treehouse of Horror XXIV", when Bart skateboarded on one of his tentacles that bursted out of the ground, and he was later featured in the mobile game The Simpsons: Tapped Out , as an unlockable character during the "Cthulhu's Revenge 2019 Event".</ex:hasAnnotation>
    <ex:hasAppearanceC>Halloween of Horror The Simpsons: Tapped Out</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC>Treehouse of Horror XXIV</ex:madeFirstAppearanceOnC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shan">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Shan</rdfs:label>
    <ex:hasAlternativeNamesC>Insect from Shaggai</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The shans are an insectoid alien race which appears in the cthulhu mythos . They are parasitic and can phase into a human's brain, giving its host its memories while slowly taking over . Their primary means of communication between members of their own species is telepathy .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Insects_from_Shaggai"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
  </rdf:Description>
