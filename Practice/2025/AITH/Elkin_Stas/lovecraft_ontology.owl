    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Nathaire</rdfs:label>
    <ex:ceasedOnC>1281</ex:ceasedOnC>
    <ex:hasAnnotation>"the colossus of ylourgne" is a fictional character, the antagonist of clark ashton smith's story " the colossus of ylourgne " he is described as "thrice-infamous", being an "alchemist, astrologer and necromancer" he is noted for "his minikin stature, his deformity and ugliness"</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Colossus_of_Ylourgne"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
