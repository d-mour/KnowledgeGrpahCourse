    <ex:hasAlternativeNamesC>Lord of the Jinn</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Cthulhu invictus is a jinn from north african mythology . First used by chaosium in 2009 for the call of cthulhu roleplaying game .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Cthulhu_Invictus"/>
