    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Achtung! Cthulhu: Keeper's Guide to the Secret War</rdfs:label>
    <ex:hasAnnotation>Achtung! Cthulhu 288 is a supplement for the roleplaying game setting . It includes statistics for playing with both the call of cthulhu and savage worlds rule systems . In 2016, uhrwerk released a german- edition, titled achtung! Cthulhu: spielleiterbuch zum geheimen krieg .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
