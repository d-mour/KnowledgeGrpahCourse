  <rdf:Description rdf:about="http://example.org/lovecraft#Tsathoggua">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Tsathoggua</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Father of Night</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Sadogowah</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Sadoquae</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Seal of the Black Stars</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Sleeper of N'kai</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Sodagui</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Black Thing</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Tsadogwa</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Tsathoqquah</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Zhothaqquah</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The sleeper of n'kai is a fictional entity in the cthulhu mythos . He is described as an old one , a godlike being from the pantheon . He first appeared in smith's short story " the tale of satampra zeiros " .</ex:hasAnnotation>
    <ex:hasAppearanceC>The Mound At the Mountains of Madness The Man of Stone The Horror in the Museum Through the Gates of the Silver Key Winged Death Out of the Aeons The Shadow Out of Time The Testament of Athammaus The Door to Saturn The Seven Geases The Scroll of Morloc The Tsathoggua Cycle Tsathoggua</ex:hasAppearanceC>
    <ex:hasCharacterMateC rdf:resource="http://example.org/lovecraft#Shathak"/>
    <ex:isLocatedAtC rdf:resource="http://example.org/lovecraft#Nkai"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Tale_of_Satampra_Zeiros"/>
