    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Green Decay</rdfs:label>
    <ex:hasAnnotation>" : the history of nabulus the wonder-worker " is a short story by american author robert m. price . The story of a lonely hyperborean wizard who creates a body for a celestial being to be his companion . When he discovers that his apprentices have been defiling his mate, he unleashes</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
