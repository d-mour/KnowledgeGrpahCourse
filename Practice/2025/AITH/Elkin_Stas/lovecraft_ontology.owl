    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Phoenix</rdfs:label>
    <ex:hasAnnotation>The force is a child of the universe, the mutable and indestructible manifestation of the universal force of life . Occasionally it takes a host, most recently its favored host has been the human mutant, jean grey of the x-men .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Shambler_from_the_Stars">
