  <rdf:Description rdf:about="http://example.org/lovecraft#De_Marignys_Clock_%28machine%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#TechnologicalArtefacts"/>
    <rdfs:label>De Marigny's Clock (machine)</rdfs:label>
    <ex:hasAnnotation>De marigny's clock is an artefact of the elder gods which appears in brian lumley's series of cthulhu mythos novels and short stories . Inspired by a line written by h. p. lovecraft and e. hoffman price in the short story " through the gates of the silver key "</ex:hasAnnotation>
    <ex:hasFunctionA>Space-time transportation</ex:hasFunctionA>
    <ex:hasPlaceOfOriginA>http://example.org/lovecraft#Elysia</ex:hasPlaceOfOriginA>
    <ex:hasTypeA>Vehicle</ex:hasTypeA>
    <ex:isUsedByA rdf:resource="http://example.org/lovecraft#Henri-Laurent_de_Marigny"/>
    <ex:isUsedByA rdf:resource="http://example.org/lovecraft#Titus_Crow"/>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#Through_the_Gates_of_the_Silver_Key"/>
    <ex:wasCreatedByA>Unknown</ex:wasCreatedByA>
    <ex:wasCreatedByA>likely residents of Elysia</ex:wasCreatedByA>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Brotherhood_of_Sahb_Delanzar">
    <rdf:type rdf:resource="http://example.org/lovecraft#Cults"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdfs:label>Brotherhood of Sahb Delanzar</rdfs:label>
    <ex:hasAnnotation>The is a fictional cult which appeared in the marvel universe in 1986 . It was a mythos cult in zamora during the hyborian age . The cult had been kidnapping babies to sacrifice to shub-niggurath . Once they sacrificed 1000 young, he would return</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Invaders_of_Glaaki">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Invaders of Gla'aki</rdfs:label>
    <ex:hasAnnotation>The children of gla'aki is a short story by orrin grey . It was first published in the thematic anthology the children of gla'aki .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Orrin_Grey"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
