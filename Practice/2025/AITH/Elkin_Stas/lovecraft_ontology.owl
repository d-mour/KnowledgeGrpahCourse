    <rdfs:label>Essais - Correspondance - Poésie - Révisions</rdfs:label>
    <ex:hasAnnotation>682 is a french- collection of the works of howard phillips lovecraft . It was published by mnémos in a hardback format in september 2021 . It was also included in the multi-volume release intégrale that same month .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW rdf:resource="http://example.org/lovecraft#France"/>
    <ex:hasPageCountW>682</ex:hasPageCountW>
