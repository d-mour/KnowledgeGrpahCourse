    <ex:wasPublishedOnW>2021</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Island_M">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Island M</rdfs:label>
    <ex:hasAccessibilityL>Air</ex:hasAccessibilityL>
    <ex:hasAccessibilityL>Sea</ex:hasAccessibilityL>
    <ex:hasAlternativeNamesL>Magneto's Island</ex:hasAlternativeNamesL>
    <ex:hasAnnotation>Island first appeared in 1964 in issue 4 of the first volume of the x-men comic series . Island was a stronghold of the ancients, an evil race who ruled the earth . Island was raised to the surface by magneto, who turned it into a base for his brotherhood of evil mutants .</ex:hasAnnotation>
    <ex:hasNotableFeatureL>Buildings</ex:hasNotableFeatureL>
    <ex:hasNotableFeatureL>beach</ex:hasNotableFeatureL>
    <ex:hasNotableFeatureL>caverns</ex:hasNotableFeatureL>
    <ex:hasNotableFeatureL>jungle</ex:hasNotableFeatureL>
    <ex:hasTypeL>Island</ex:hasTypeL>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#Quoggoth"/>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#X-Men"/>
    <ex:isInhabitedByL>Evil Brotherhood of Mutants</ex:isInhabitedByL>
    <ex:isInhabitedByL>Magneto</ex:isInhabitedByL>
    <ex:isInhabitedByL>New Mutants</ex:isInhabitedByL>
    <ex:isInhabitedByL>the Ancients</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Earth"/>
    <ex:madeFirstAppearanceOnL>X-Men Vol 1 4</ex:madeFirstAppearanceOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Unnamable_%281988_film%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleFilmAndTelevisionAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Unnamable (1988 film)</rdfs:label>
    <ex:hasAnnotation>The unnamable is a 1988 horror film loosely based on h.p. Lovecraft's short story of the same name . The film was written, directed and co-produced by jean-paul ouellette . It was followed in 1993 by the sequel, the statement of randolph carter .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW>The Unnamable</ex:isBasedOnW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>June 1988</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mnar">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Mnar</rdfs:label>
    <ex:hasAnnotation>Behind the mythos is the land where the doomed city of sarnath was located . Originally inhabited by the amphibious thuum'ha who constructed the city of ib . These creatures were displaced and then rendered extinct in a deliberate genocide .</ex:hasAnnotation>
    <ex:hasAppearanceL>The Nameless City At the Mountains of Madness</ex:hasAppearanceL>
    <ex:hasNotableFeatureL rdf:resource="http://example.org/lovecraft#River_Ai"/>
    <ex:hasTypeL>Region</ex:hasTypeL>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#Thuumha"/>
    <ex:isInhabitedByL>Humans</ex:isInhabitedByL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Doom_That_Came_to_Sarnath"/>
    <ex:wasDestroyedOnL>000BC Circa 8</ex:wasDestroyedOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crypt_of_Cthulhu_Eastertide_1989">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crypt of Cthulhu Eastertide 1989</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Allen Koszowski English Cryptic Publications Release Date April 1989 52 Preceded by Candlemas 1989 Followed by Roodmas 1989 is the 63rd issue of the long-running Lovecraftian fanzine Crypt of Cthulhu . It was edited by Robert M. Price and published by Cryptic Publications in April 1989. Unlike most issues, the only fictional work in this edition was Fred Pelton 's previously-unpublished pseudo-factual work " The Sussex Manuscript ". Contents Editorial Shards by Robert M. Price " The Sussex Manuscript " by Fred Pelton Reviews by Stefan Dziemianowicz and Robert M. Price Letters by David M. Massaro, Glenn Lord, Donald R. Burleson , Robert Bloch , Ramsey Campbell , Wilum Pugmire , Robert H. Knox, Pierre Comtois , W. Paul Ganley, Darrell Schweitzer , Keith Frey, Stefan R. Dziemianowicz, Mike Ashley, Thomas Ligotti , Lenny Grotze, Steve Behrends , Richard L. Tierney , Jacob Bragadia, David F. Godwin, and C. L. Vunkowski</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>52</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>April 1989</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Well_of_Stars_and_Shadow">
    <rdf:type rdf:resource="http://example.org/lovecraft#CaitlinRKiernanWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Well of Stars and Shadow</rdfs:label>
    <ex:hasAnnotation>" bainbridge "is a short story by caitlin r. kiernan that features their recurring character, dancy flammarion . It was written at the end of october 2001 and published in november 2001 on gothic.net . The story is set during dancy's childhood in shrove wood in okaloosa county, florida .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
