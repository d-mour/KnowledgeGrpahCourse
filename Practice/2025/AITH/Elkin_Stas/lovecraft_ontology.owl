  <rdf:Description rdf:about="http://example.org/lovecraft#Innsmouth:_The_Stolen_Child">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Innsmouth: The Stolen Child</rdfs:label>
    <ex:hasAnnotation>Simon Birks Willi Roberts Cover Artist R. H. Stewart United Kingdom English Genre(s) Gamebook Blue Fox Comics Release Date March 2022 276 is a Cthulhu Mythos gamebook in the style of the Fighting Fantasy and Choose Your Own Adventure series which were wildly popular in the children’s/Young Adult demographic during the 1980s. Written by British Simon Birks , it features cover art by R. H. Stewart, illustrations by Willi Roberts, and was published by Blue Fox Comics in March 2022. Overview Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Simon_Birks"/>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Gamebook</ex:hasGenreW>
