    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Coins From Y'ha-nthlei</rdfs:label>
    <ex:hasAnnotation>A physician named . Cheshire writes stories on the subjects covered in the works of . H. p. lovecraft . He is killed by his horrified housekeeper after revealing his plans to "modify" more people using this type of prosthetic .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mark_McLaughlin"/>
