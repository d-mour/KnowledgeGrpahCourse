    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Lord of Pain</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as Lord of Pain Current location In a remote dimension within the Space-Time Continuum Great Old Ones First appearance Le Maître des Souffrances (RPG adventure) is a sadistic entity trapped by the Elder Gods in a remote dimension within the space-time continuum. He is described as being a tall reptilian monstrosity with vicious fangs and six limbs.</ex:hasAnnotation>
    <ex:isLocatedAtC>In a remote dimension within the Space-Time Continuum</ex:isLocatedAtC>
    <ex:madeFirstAppearanceOnC>Le Maître des Souffrances (RPG adventure)</ex:madeFirstAppearanceOnC>
  </rdf:Description>
