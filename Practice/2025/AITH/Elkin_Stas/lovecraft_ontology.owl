    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Jeffrey Thomas</rdfs:label>
    <ex:hasAnnotation>Thomas is the creator of punktown, a dystopian science fiction setting . Punktown has been linked to the cthulhu mythos through several short stories, and others which feature lovecraftian elements .</ex:hasAnnotation>
    <ex:hasFullNameR>Jeffrey Edwin Thomas</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Artist</ex:isConnectedToMythosR>
