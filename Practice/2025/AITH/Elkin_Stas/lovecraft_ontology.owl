    <rdfs:label>Trish Scarborough</rdfs:label>
    <ex:hasAffiliationC>The Bureau</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Spy</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Aka the spy is a character created by fantasy flight games . First introduced in the arkham horror second edition expansion box innsmouth horror . Has since appeared in other fantasy flight products .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Innsmouth Horror</ex:madeFirstAppearanceOnC>
