    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Work"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Spawn_of_the_Winds">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ServitorRaces"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Spawn of the Winds</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Ithaqua"/>
    <ex:hasAnnotation>Sociocultural Characteristics Ithaqua Ithaqua Real World Information First appearance EXP : " Born of the Winds " Created by Brian Lumley The are a fictional race created by Chaosium in 1994 for the Call of Cthulhu roleplaying game, which were based on creatures from Brian Lumley 's short story " Born of the Winds ". Background The are the offspring produced by the mating between Ithaqua and a human female. They appear human, until their true nature is revealed. Their true form is that of a huge monstrous humanoid, which they transform into by choice or when angered. It's a race with a violent temper and which is able to alter the weather, up to a 2 miles radius, producing lightning, blizzards, tornadoes, driving rain, and thunder.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Born_of_the_Winds"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Beyond_the_Threshold_%28Mansions_of_Madness%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Beyond the Threshold (Mansions of Madness)</rdfs:label>
    <ex:hasAnnotation>Beyond the Threshold Kara Centell-Dunk Nikki Valens Fantasy Flight Games Publication Date 2017 Mansions of Madness Beyond the Threshold is an expansion set for Fantasy Flight Games ' Cthulhu Mythos board game Mansions of Madness . Designed by Kara Centell-Dunk and Nikki Valens , it was published in early 2017. Overview Gallery Artwork Components</ex:hasAnnotation>
    <ex:wasPublishedOnW>2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Gary_Myers">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Gary Myers</rdfs:label>
    <ex:hasAnnotation>Full Name Gary Clayton Myers Connection to the Mythos Contributor Birth Date 15 August, 1952 Lynwood, California, USA United States Horror Fantasy Gary Clayton Myers (born 15 August 1952) is an American writer of fantasy and horror, as well as an occasional artist. He is a resident of Fullerton, California. His first book, The House of the Worm , was a collection of Cthulhu Mythos stories in the fantasy manner of H. P. Lovecraft and Lord Dunsany ; it was published by Arkham House in 1975. His second book, Dark Wisdom: New Tales of the Old Ones , was a collection of Cthulhu Mythos stories in a more contemporary horror mode; it was published by Mythos Books in 2007. Selected Works Author The House of the Worm (1975) Dark Wisdom: New Tales of the Old Ones (2007) " The House of the Worm " (1970) " Passing of a Dreamer " (1971) " Yohk the Necromancer " (1971) " The Return of Zhosph " (1972) " The Gods of Earth " (1975) " Xiurhn " (1975) " The Three Enchantments " (1975) " Hazuth-Kleg " (1975) " The Loot of Golthoth " (1975) " The Four Sealed Jars " (1975) " The Maker of Gods " (1975) "Horror Show" (1997) Artwork Dark Wisdom: New Tales of the Old Ones (2007) See Also Images by External Links at Wikipedia at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA http://example.org/lovecraft#California Lynwood</ex:hasBirthplaceR>
    <ex:hasFullNameR>Gary Clayton Myers</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Contributor</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1952 15 August</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Elemental">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Elemental</rdfs:label>
    <ex:hasAnnotation>Elementals were a popular part of the belief systems of demonology, alchemy and ritual magic in the renaissance era . They were incorporated into the cthulhu mythos by august derleth and other writers . They are living beings composed of one of the classical elements .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Delta_Green:_The_Way_it_Went_Down">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Delta Green: The Way it Went Down</rdfs:label>
    <ex:hasAnnotation>The way it went down is a collection of flash-fiction pieces by american dennis detwiller . The stories take place in the setting of delta green . Paperback, hardcover and digital editions were all released .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Dennis_Detwiller"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>January 2018</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Unspeakable_Possessor">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Unspeakable Possessor</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Hastur"/>
    <ex:hasAnnotation>Unspeakable possessors are a fictional species expanded upon by chaosium in 1995 for the call of cthulhu roleplaying game . They are a race created by the great old one hastur , made from humans who have made the unspeakable promise .</ex:hasAnnotation>
    <ex:hasAppearanceC>Call of Cthulhu</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Return_of_Hastur"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#August_Derleth"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#LovecraftsInspirationsAuthors">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Brad_Hollins">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
