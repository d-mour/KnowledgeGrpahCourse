  <rdf:Description rdf:about="http://example.org/lovecraft#Triple_God_of_Chaos">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Triple God of Chaos</rdfs:label>
    <ex:hasAnnotation>The is a supernatural being and Great Old One mentioned in the stories of Thongor of Lemuria by Lin Carter . One of its aspects is Yamath the Lord of the Flames. Another of its three aspects is Slidith , the Lord of Blood. The Triple God might be identifiable with Nyarlathotep the Crawling Chaos.</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Asaph_%28Asa%29_Phillips">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Asaph (Asa) Phillips</rdfs:label>
    <ex:diedOnR>29 August 1852</ex:diedOnR>
    <ex:hasAnnotation>Lovecraft’s maternal great-great-grandfather and wife of Esther Whipple, whom Asaph married on 16 August 1787.</ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1803</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cy%C3%A4egha">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Cyäegha</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Dark That Waits</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The five vaeyen is a deity characterized by its supreme nihilism and utter contempt for all things . The entity appears as a great, black-bodied, green eye surrounded by a mass of tentacles . Is served by toad-like monsters known as the nagäae (possibly a derivative of "nagae")</ex:hasAnnotation>
    <ex:isLocatedAtC>A cavern under the mountain Dunkelhügel</ex:isLocatedAtC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Darkness"/>
    <ex:madeFirstAppearanceOnC>My Name Is</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Eddy_C._Bertin"/>
  </rdf:Description>
