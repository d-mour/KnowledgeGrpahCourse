  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Zstylzhemgni">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Zstylzhemgni</rdfs:label>
    <ex:hasAlternativeNamesC>Matriarch of the Swarm</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Zystulzhemgni</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as Matriarch of the Swarm, Zystulzhemgni Relatives Ycnágnnisssz (parent) Tsathoggua (offspring) Ghisguth First appearance CIRCLE : Selected Letters of Clark Ashton Smith 189 Created by Clark Ashton Smith Zstylzhemghi is the offspring of Ycnágnnisssz , the wife of Ghisguth , and the mother of Tsathoggua . ( CIRCLE : Family tree of Azathoth ) She does not belong to any faction and is known as the Matriarch of Swarms. ( EXP : Call of Cthulhu: The Card Game ) Behind the Mythos The character first appeared in Smith's 1934 Family tree of Azathoth . Gallery</ex:hasAnnotation>
    <ex:hasCharacterMateC>Ghisguth</ex:hasCharacterMateC>
    <ex:madeFirstAppearanceOnC>Selected Letters of Clark Ashton Smith 189</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Prisoner_of_Carcosa_%26_More_Tales_of_the_Bizarre">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Prisoner of Carcosa &amp; More Tales of the Bizarre</rdfs:label>
    <ex:hasAnnotation>Mark McLaughlin English Release Date January 2020 132 (print edition) 130 (digital edition) is a collection of stories from authors Mark McLaughlin and Michael Sheehan, Jr. Overview Running to a total of 132 (130 as an ebook), was released in paperback (January 2020) and digital editions. Contents " Horrors Of The Trash Island: A Lovecraftian Eco-Disaster " "You Shall Have This Delicacy" " Yuletide Mementos: A Tale Of Lovecraftian Horror " "Tell Your Secrets To The Slime" "Diabolical Entities And How To Deal With Them" "Venus" " The Prisoner of Carcosa "</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mark_McLaughlin"/>
    <ex:hasPageCountW>132 130</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>January 2020</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Rifts">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Rifts</rdfs:label>
    <ex:hasAnnotation>Is a -spanning roleplaying game created by american kevin siembieda . First launched in 1990, it and its many supplements have remained in constant publication through palladium books ever since . The setting describes a number of entities which many consider lovecraftian in nature, including the splugorth and alien intelligences .</ex:hasAnnotation>
    <ex:wasPublishedOnW>August 1990</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Madness_of_Cthulhu:_Volume_Two">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Madness of Cthulhu: Volume Two</rdfs:label>
    <ex:hasAnnotation>S. T. Joshi , editor Cover Artist John Jude Palencar English Genre(s) Cthulhu Mythos Titan Books Release Date 2015 Preceded by The Madness of Cthulhu is an anthology of Cthulhu Mythos fiction edited by S. T. Joshi , published by Titan Books in 2015. It is a follow-up to 2014's The Madness of Cthulhu . Contents "Foreword" by Kim Newman "Introduction" by S. T. Joshi " 20,000 Years Under the Sea " by Kevin J. Anderson "Tsathoggua's Breath" by Brian Stableford "The Door Beneath" by Alan Dean Foster "Dead Man Walking" by William F. Nolan "A Crazy Mistake" by Nancy Kilpatrick " The Anatomy Lesson " by Cody Goodfellow "The Hollow Sky" by Jason C. Eckhardt "The Last Ones" by Mark Howard Jones "A Footnote in the Black Budget" by Jonathan Maberry "Deep Fracture" by Steve Rasnic Tem "The Dream Stones" by Donald Tyson "The Blood in My Mouth" by Laird Barron "On the Shores of Destruction" by Karen Haber "Object 00922UU" by Erik Bear and Greg Bear</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#S._T._Joshi"/>
    <ex:hasAuthorW>editor</ex:hasAuthorW>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Spawn_Of_Ghattambah">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Spawn Of Ghattambah</rdfs:label>
    <ex:hasAnnotation>The house of the ocelot &amp; more lovecraftian nightmares is a short horror story by mark mclaughlin . In an apocalyptic near-future, a pair of insectile creatures plot to make one of the last humans on earth a part of their twisted little family</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mark_McLaughlin"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>More Lovecraftian Nightmares</ex:isPublishedAsW>
    <ex:isPublishedAsW>The House of the Ocelot</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2019</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#H._P._Lovecraft:_A_Pupils_View">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>H. P. Lovecraft: A Pupil's View</rdfs:label>
    <ex:hasAnnotation>Zealia Bishop United States English (original) German Genre(s) Non-fiction Arkham House The Curse of Yig date 1953 " " is a short non-fiction work by the late American Zealia Bishop , a revision client of Howard Phillips Lovecraft . It was first published in the 1953 Arkham House collection The Curse of Yig , and has more recently been translated into German . History The Curse of Yig (1953) Lovecraft Remembered (1998) Namenlose Kulte (2006, German translation) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Zealia_Bishop"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Curse_of_Yig"/>
    <ex:wasPublishedOnW>1953</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Franklyn_Paragraphs">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RamseyCampbellWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Franklyn Paragraphs</rdfs:label>
    <ex:hasAnnotation>Demons by daylight is a short story by british author j. ramsey campbell . It tells the story of an aspiring writer who stumbles across an unliving cultist of eihort .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>Short Fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Demons_by_Daylight"/>
    <ex:wasPublishedOnW>1973</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bob_Kruger">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Bob Kruger</rdfs:label>
    <ex:hasAnnotation>Full Name Robert "Bob" Kruger Connection to the Mythos Editor Author Lovecraftian fiction Robert "Bob" Kruger is an editor and author who has had a hand in a small number of Cthulhu Mythos publications. These have been for the most part related to the Delta Green sub-setting of Chaosium 's Call of Cthulhu horror roleplaying game, although he has not been involved with the creation of any actual gaming content, confining his input to the editorial and fiction tie-in aspects of the franchise. Selected Works Editor Delta Green: Alien Intelligence (1998, with John Tynes ) Delta Green: Dark Theatres (2001, with John Tynes) Author "Identity Crisis" (1998) Gaming Material Mortal Coils (1998, editor) External Links Robert Kruger at the Internet Speculative Fiction Database at Goodreads at RPGGeek References</ex:hasAnnotation>
    <ex:hasFullNameR>Robert Bob Kruger</ex:hasFullNameR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Hyperborean">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Hyperborean</rdfs:label>
    <ex:hasAnnotation>Real World Information First appearance CIRCLE : " The Tale of Satampra Zeiros " Created by Clark Ashton Smith The Hyperboreans were a mythical race of human -like entities that dwelled far, far to the north, or perhaps in the south pole. They were thought to be from the the lost era of, or possibly preceding, Atlantis .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Tale_of_Satampra_Zeiros"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Old_God_%28Warcraft%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Old God (Warcraft)</rdfs:label>
    <ex:hasAnnotation>The old gods are eldritch parasitic horrors which were created by the void lords . They were hurled into the universe in the hope that some of them would smash into worlds containing sleeping titans . Despite their imprisonment, they have been working together, influencing the history of azeroth .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Stealing_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Stealing Cthulhu</rdfs:label>
    <ex:hasAnnotation>Graham Walmsley English CPI Anthony Rowe Release Date January 2011 178 is a roleplaying game aid written by Graham Walmsley and annotated by Gareth Ryder-Hanrahan , Kenneth Hite , and Jason Morningstar. It was published by CPI Anthony Rowe in January 2011. Overview deconstructs H. P. Lovecraft's works and creations in order to provide insight for gamesmasters into how to make roleplaying games more " Lovecraftian " in feel. It also contains the full rules for Cthulhu Dark , a rules-light roleplaying game also designed by Graham Walmsley. External Links Review of at RPG.net</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Graham_Walmsley"/>
    <ex:hasPageCountW>178</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>January 2011</ex:wasReleasedOnW>
  </rdf:Description>
