  <rdf:Description rdf:about="http://example.org/lovecraft#Roderick_Desmond">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Roderick Desmond</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Miskatonic_University"/>
    <ex:hasAnnotation>Writer Student Miskatonic University Human First appearance EXP : " The Freshman " Created by Philip José Farmer is a fictional character, the protagonist and title character of Philip Jose Farmer 's 1979 short story " The Freshman ". Desmond is a well-known writer of horror novels from Busiris, Illinois , who, despite being 60 years old, is enrolling as a freshman at Miskatonic University . By entering college, he hopes to escape the control of his domineering mother, but he worries that she will follow him even there.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Freshman"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Philip_Jos%C3%A9_Farmer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Brian_Stableford">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Brian Stableford</rdfs:label>
    <ex:diedOnR>24 February 2024</ex:diedOnR>
    <ex:hasAnnotation>Brian michael stadeford (25th july 1948 - 24 february 2024) was a prolific writer who wrote numerous stories set in the cthulhu mythos . He graduated from university with a degree in biology, before moving to sociology, a subject he would go on to lecture in, along with creative writing .</ex:hasAnnotation>
    <ex:hasBirthplaceR>United Kingdom Yorkshire Shipley</ex:hasBirthplaceR>
    <ex:hasFullNameR>Brian Michael Stableford</ex:hasFullNameR>
    <ex:hasNationalityR>United Kingdom</ex:hasNationalityR>
    <ex:hasPseudonymR>Brian Craig</ex:hasPseudonymR>
    <ex:hasWebsiteR>http://www.philsp.com/stableford/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Fiction Contributor</ex:isConnectedToMythosR>
    <ex:wasBornOnR>25 July 1948</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dweller_in_Darkness">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dweller in Darkness</rdfs:label>
    <ex:hasAnnotation>The story concerns mysterious goings-on at rick's lake, a remote body of water in north-central wisconsin . The "dweller in darkness" of the title turns out to be nyarlathotep . The only way to defeat nyarlathotep is to summon the fire elemental cthugha .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:isInLanguageW>Spanish</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>November 1944</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Klarkash-Ton_Cycle">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ClarkAshtonSmithWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Klarkash-Ton Cycle</rdfs:label>
    <ex:hasAnnotation>Clark Ashton Smith Cover Artist Steven Gilberts English Genre(s) Cthulhu Mythos Chaosium Release Date June 30, 2008 212 : Clark Ashton Smith's Cthulhu Mythos Fiction is a collection of Mythos -related stories by Clark Ashton Smith , edited by Robert M. Price and published by Chaosium in 2008. The title is a reference to Klarkash-Ton , a character H. P. Lovecraft invented as an homage to his friend and correspondent. Contents "Introduction to " (essay) by Robert M. Price " The Ghoul " (1934) "A Rendering from the Arabic" (variant of " The Return of the Sorcerer ") (1931) " The Hunters from Beyond " (1932) "The Vaults of Abomi" (variant of "The Vaults of Yoh-Vombis") (1932) " The Nameless Offspring " (1932) " Ubbo-Sathla " (1933) " The Werewolf of Averoigne " (1984) "The Eidolon of the Blind" (variant of " The Dweller in the Gulf ") (1933) " Vulthoom " (1935) " The Treader of the Dust " (1935) " The Infernal Star " (1989) "Story Intros (essay) by Robert M. Price</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasPageCountW>212</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2008 June 30</ex:wasReleasedOnW>
  </rdf:Description>
