    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Vulcan's Forge</rdfs:label>
    <ex:hasAnnotation>History was first published in the historical fiction anthology tales of cthulhu invictus by golden goblin press in 2015 . It was also included in the collection of meikle's own works into the black: tales of lovecraftian terror in 2019 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
