    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Bayt_al_Azif"/>
    <ex:wasReleasedOnW>September 2019</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Herbert_West_in_Love">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Herbert West in Love</rdfs:label>
    <ex:hasAnnotation>Molly Tanzer English Genre(s) Cthulhu Mythos Egaeus Press Rumbullion and Other Liminal Libations date October 28, 2013 "" is a short story by Molly Tanzer that first appeared in her collection Rumbullion and Other Liminal Libations (Egaeus Press, 2013). It was reprinted in the Herbert West -themed anthology Legacy of the Reanimator ( Chaosium , 2015). Synopsis It takes place at Miskatonic University , where med student Herbert West feuds with a professor Masheck Quinley and has a short-lived romance with divinity student Tristan Langbroek. Neither ends well.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Molly_Tanzer"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Other Liminal Libations</ex:isPublishedAsW>
    <ex:isPublishedAsW>Rumbullion</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2013 October 28</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Arthur_Machen">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsInspirationsAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosAdjacentAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Arthur Machen</rdfs:label>
    <ex:diedOnR>1947 December 15</ex:diedOnR>
    <ex:hasAnnotation>Arthur llewellyn jones was a leading welsh author of the 1890s . He was a major influence on the weird fiction of h.p. Lovecraft . His long story the great god pan made him famous and controversial in his lifetime .</ex:hasAnnotation>
    <ex:hasBirthplaceR>Wales Caerleon Monmouthshire</ex:hasBirthplaceR>
    <ex:hasFullNameR>Arthur Llewellyn Jones</ex:hasFullNameR>
    <ex:hasNationalityR>British</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Inspiration</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1863 March 3</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#On_the_Emergence_of_Cthulhu_and_Other_Observations">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>On the Emergence of 'Cthulhu' and Other Observations</rdfs:label>
    <ex:hasAnnotation>Steven J. Mariconda Cover Artist Jason C. Eckhardt United States English Genre(s) Non-fiction Necronomicon Press Release Date November 1995 72 is a short non-fiction work by American scholar and critic Steven J. Mariconda . It was published in chapbook format by Necronomicon Press in November 1995. Cover art was supplied by Jason C. Eckhardt .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Steven_J._Mariconda"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:hasPageCountW>72</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>November 1995</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shlangii">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Shlangii</rdfs:label>
    <ex:hasAnnotation>The are a fictional alien species featured in andy lane's novel . They are strange-looking creatures with a sac-shaped body supported by five spindly legs . Each leg has five joints, which are composed of two hinges aligned on different planes, thus allowing the legs to bend on any direction .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#All-Consuming_Fire"/>
    <ex:madeFirstAppearanceOnC>The Ribos Operation (mentioned)</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Robert Holmes</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#From_Beyond_%281986_film%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleFilmAndTelevisionAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>From Beyond (1986 film)</rdfs:label>
    <ex:hasAnnotation>From beyond is a 1986 low- horror movie from director stuart gordon . It is an adaptation of the h.p. Lovecraft short story of the same name . It stars jeffrey combs and barbara crampton in the lead roles .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>Italy</ex:hasCountryOfOriginW>
    <ex:hasCountryOfOriginW>USA</ex:hasCountryOfOriginW>
    <ex:hasWriterW>http://example.org/lovecraft#Dennis_Paoli http://example.org/lovecraft#Stuart_Gordon http://example.org/lovecraft#Brian_Yuzna</ex:hasWriterW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#From_Beyond"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Demons_of_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Demons of Cthulhu</rdfs:label>
    <ex:hasAnnotation>Two men plot to steal the rare and priceless book known as the necronomicon . Theophilius vorys needs the help of his colleague, marty, to accomplish the theft unnoticed . Marty double-crosses vorys and takes the grimoire home, reasoning that he can sell it himself and keep all the money .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_Silverberg"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Monster Parade #4</ex:isPublishedAsW>
    <ex:wasPublishedOnW>March 1959</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Camarilla_of_the_NGarai">
    <rdf:type rdf:resource="http://example.org/lovecraft#Cults"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DefunctOrganisationsFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdfs:label>Camarilla of the N'Garai</rdfs:label>
    <ex:hasAnnotation>The are a group of humans who pledged their service to the n'garai . It's members summoned demons and both extracted and bound souls . They tried to kill satana, the heroic rebel daughter of lucifer .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Wolverine">
    <rdf:type rdf:resource="http://example.org/lovecraft#AmateurPress"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Periodicals"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Wolverine</rdfs:label>
    <ex:hasAnnotation>Three of lovecraft's short stories first appeared in the journal . The publication also published a column called "the vivisector" edited by horace l. lawson and marjorie c. lawson .</ex:hasAnnotation>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dermods_Bane">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RobertEHowardWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dermod's Bane</rdfs:label>
    <ex:hasAnnotation>The story's narrator is named kirowan; whether he is the same character as the john kirowan who appears in several howard stories is open to interpretation . The story's theme of ancestral enmity is one that appears in several of howard's mythos tales .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Magazine of Horror</ex:isPublishedAsW>
    <ex:wasPublishedOnW>Fall 1967</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Huitloxopetl">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Huitloxopetl</rdfs:label>
    <ex:hasAnnotation>First appearance " " Created by Meade Frierson III is the false lure or trickster. He is described as an angel who lures dead souls into his realm (The False Haven). The souls believe they are lead to the afterlife, but they face a horrible truth, and that is a pit of utter darkness. His true form is a demon with four tentacles, horns, wings, goat-like legs, and a head. In the pit lies the unknown who hungers for souls.</ex:hasAnnotation>
    <ex:wasCreatedByC>Meade Frierson III</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crypt_of_Cthulhu_Eastertide_1988_1/2">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crypt of Cthulhu Eastertide 1988 1/2</rdfs:label>
    <ex:hasAnnotation>Cover Artist Allen Koszowski United States English Crypt of Cthulhu Cryptic Publications Release Date April 1988 64 Preceded by Candlemas 1988 Followed by Eastertide 1988 is the 54th issue of leading H. P. Lovecraft scholar Robert M. Price 's long-running fanzine Crypt of Cthulhu . Edited by Price and featuring cover art by Allen Koszowski , it ran to a total of 64 in an A5 format, it was published by Cryptic Publications in April 1988. This issue was a special memorial edition devoted to Lin Carter , who had died only two months previously. Contents Editorial Shards by Robert M. Price " Strange Manuscript Found in the Vermont Woods " by Lin Carter "The Secret in the Parchment" by Lin Carter "From the Archives of the Moon" by Lin Carter "Dead of Night" by Lin Carter "The Shadow from the Stars" by Lin Carter "How Ghuth Would Have Hunted the Silth" by Lin Carter " The Fishers from Outside " by Lin Carter "Papyrus of the Dark Wisdom" by Lin Carter and Clark Ashton Smith "The Slitherer from the Slime" by Lin Carter and H. P. Lowcraft "Lin Carter: June 9, 1930 - February 7, 1988" by uncredited References</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>64</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu"/>
    <ex:wasReleasedOnW>April 1988</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Othuyeg">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Othuyeg</rdfs:label>
    <ex:hasAlternativeNamesC>The Doom-Walker</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Doom-Walker First appearance EXP : " Demons in the Flesh " EXP : Solar Pons and the Cthulhu Mythos " EXP : " The Seven Cities of Gold " EXP : " People of the Monolith: Stone of Death " is an entity that appears as a great tentacled eye similar to Cyäegha , but much more similar to the monster featured in the horror movie The Crawling Eye . He currently dwells within the subsoil of Kansas, in the fabled Seven Cities of Gold .</ex:hasAnnotation>
    <ex:hasAppearanceC>People of the Monolith: Stone of Death</ex:hasAppearanceC>
    <ex:hasAppearanceC>Solar Pons</ex:hasAppearanceC>
    <ex:hasAppearanceC>The Seven Cities of Gold</ex:hasAppearanceC>
    <ex:hasAppearanceC>the Cthulhu Mythos</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC>Demons in the Flesh</ex:madeFirstAppearanceOnC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Two_Black_Bottles">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Two Black Bottles</rdfs:label>
    <ex:hasAnnotation>The narrator is called into the town of daalbergen after the death of his uncle, dominie johannes vanderhoof . The locals recount the strange behavior of the dominie and his sexton, which led them to suspect he was in league with unseen spirits . The narrator confronts foster in the church, where he is found catatonic and babbling about how the reverend isn't truly dead and will return for revenge .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Howard_Phillips_Lovecraft"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Wilfred_Blanch_Talman"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>August 1927</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhus_Ruf">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhus Ruf</rdfs:label>
    <ex:hasAnnotation>Cthulhu’s call was a fanzine with a focus on the call of cthulhu horror roleplaying game . Created as a replacement for a magazine with a similar remit published by traditional games manufacturer pegasus spiele . Remained in publication for four years, with the final issue, #10, seeing release in may 2016 .</ex:hasAnnotation>
    <ex:isInLanguageW>German</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Karl_Heinrich">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Karl Heinrich</rdfs:label>
    <ex:ceasedOnC>1917 August 20th</ex:ceasedOnC>
    <ex:hasAffiliationC>Imperial German Navy</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Graf von Altberg-Ehrenstein</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Ruthless and arrogant, and often resorted to capital punishment against his own men . Regarded himself as culturally and intellectually superior even to his own crewmates, many of whom he regarded as irrational, superstitious, and weak-willed .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Temple"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Miskatonic_Dreams">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Miskatonic Dreams</rdfs:label>
    <ex:hasAnnotation>Various English Hiraeth Publishing is an anthology of Lovecraftian fiction edited by H. David Blalock and released by independent publishing house Hiraeth Publishing. Both physical and digital editions were issued. Overview</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Crawling_Chaos">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Crawling Chaos</rdfs:label>
    <ex:hasAnnotation>"ex obslivione" is a short story by american writers h. p. lovecraft and winifred v. jackson . The tale was first published in the united co-operative in 1921 . As in their other collaboration, "the green meadow", the tale was credited to "elizabeth berkeley" (jackson) and "lewis theobald, jun" (lovecraft)</ex:hasAnnotation>
    <ex:hasAuthorW>Howard Phillips Lovecraft as Lewis Theobald. Jr.</ex:hasAuthorW>
    <ex:hasAuthorW>Winifred V. Jackson as Elizabeth Berkeley</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Worms_of_the_Earth">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RobertEHowardWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Worms of the Earth</rdfs:label>
    <ex:hasAnnotation>Behind the mythos is a short story by american author robert e. howard . It was first published in the november 1932 edition of pulp magazine weird tales . In 2012, it was given an ebook release as part of the cthulhu mythos megapack .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Short Fiction Horror Historical Fantasy</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>November 1932</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Winter_Wish_and_Other_Poems">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Winter Wish and Other Poems</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft Cover Artist Stephen Fabian English Whispers Press Release Date 1977 190 is a collection of poetry by the late American H. P. Lovecraft . Edited by Tom Collins and featuring cover art by Stephen Fabian, it was published in a limited run of 2,100 copies by Whispers Press in 1977 . References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasPageCountW>190</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1977</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#James_Allison_Cycle">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#StoryCycles"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>James Allison Cycle</rdfs:label>
    <ex:hasAnnotation>The is a series of linked short stories set across the ages . Most of the stories were written by robert e. howard . Two were fragments completed by other authors .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Fantasy</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#People_of_the_Monolith">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>People of the Monolith</rdfs:label>
    <ex:hasAnnotation>Crispin Burnham United States English P. Marsh Cthulhu Cultus date February 1997-May 1998 is a novella by the late American and editor Crispin Burnham . It was serialised in fanzine Cthulhu Cultus between February 1997 and May 1998; the issues in which it was published were not consecutive. Synopsis To be added.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Crispin_Burnham"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Cthulhu_Cultus"/>
    <ex:wasPublishedOnW>February 1997-May 1998</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dreams_From_the_Witch_House">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dreams From the Witch House</rdfs:label>
    <ex:hasAnnotation>Lynne Jamneck , editor Cover Artist Daniele Serra English Genre(s) Cthulhu Mythos Dark Regions Press Release Date 2015 354 : Female Voices of Lovecraftian Horror is a collection of Cthulhu Mythos stories written by women, and edited by Lynne Jamneck . It was published in 2015 by Dark Regions Press . Contents The anthology includes (with date of first publication): "Introduction" by Lynne Jamneck (2015) "Shadows of the Evening" by Joyce Carol Oates (1998) "The Woman in the Hill" by Tamsyn Muir (2015) "The Face of Jarry" by Cat Hellisen (2015) "Our Lady of Arsia Mons" by Caitlin R. Kiernan (2012) "The Body Electric" by Lucy Brady (2015) "The Child and the Night Gaunts" by Marly Youmans (2015) "All Our Salt-Bottled Hearts" by Sonya Taaffe (2015) "Every Hole in the Earth We Will Claim as Our Own" by Gemma Files (2015) "But Only Because I Love You" by Molly Tanzer (2015) "Cthulhu's Mother" by Deborah Walker (2015, as Kelda Crich) "All Gods Great and Small" by Karen Heuler (2015) "Dearest Daddy" by Lois H. Gresh (2015) "Eye of the Beholder" by Nancy Kilpatrick (2015) "Down at the Bottom of Everything" by E. R. Knightsbridge (2015) "Spore" by Amanda Downum (2015) "Pippa's Crayons" by Christine Morgan (2015) " The Wreck of the Charles Dexter Ward " by Elizabeth Bear and Sarah Monette (2015) "From the Cold Dark Sea" by Storm Constantine (2015) "Mnemeros" by R. A. Kaelin (2015) "The Wreck of the Charles Dexter Ward " is a variant of The Wreck of the "Charles Dexter Ward" , published in 2012.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lynne_Jamneck"/>
    <ex:hasAuthorW>editor</ex:hasAuthorW>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasPageCountW>354</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Olaus_Wormius">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Olaus Wormius</rdfs:label>
    <ex:ceasedOnC>31 August 1654</ex:ceasedOnC>
    <ex:hasAnnotation>Historian, natural historian, antiquarian human (13 may 1588 – 31 august 1654) was a 17th century scholar, who made significant contributions to medicine, natural history and literature . Lovecraft credits wormius with making the first translation of the necronomicon into latin, but dates this event to 1228--360 years before the historical wormius was .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Peltonville_Horror">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Peltonville Horror</rdfs:label>
    <ex:hasAnnotation>Is a lovecraftian short story by the late american richard a. lupoff . It was first published in the collection visions by mythos books in july 2009 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Richard_A._Lupoff"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Visions</ex:isPublishedAsW>
    <ex:wasPublishedOnW>July 2009</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#William_Briden">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>William Briden</rdfs:label>
    <ex:ceasedOnC>1925</ex:ceasedOnC>
    <ex:hasAnnotation>1925 Human First appearance HPL : " The Call of Cthulhu " Created by H. P. Lovecraft is a fictional character created by H. P. Lovecraft , who makes his only appearance in the 1928 short story " The Call of Cthulhu ". Overview Briden was a member of the Emma of Auburn, although his role is uncertain; he and Second Mate Gustaf Johansen are the only two men in the crew of 11 who managed to escape R'lyeh , however the crew's encounter with Cthulhu on the island rendered Briden insane. By the time the Alert was sighted by the Vigilant several weeks later, Briden had been dead for no less than a week.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Call_of_Cthulhu"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Howling_Terror_and_Other_Lovecraftian_Horror_Stories">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Howling Terror and Other Lovecraftian Horror Stories</rdfs:label>
    <ex:hasAnnotation>Tony Richards K. L. Turner Cover Artist K. L. Turner English Weird House Press Release Date November 2022 2022  is a collection of Lovecraftian fiction by British Tony Richards . Running to a total of 250 , it was edited by Joe Morey , features cover art and interior illustrations by K. L. Turner, and was published by Weird House Press in November 2022; both paperback and digital editions were released. Overview Contents "The Howling Terror" " The Death of Vanessa Fell " "The Darkness in The Harbour" " The Orphanage at Trellaree " "The Shadow Out Of London" Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Tony_Richards"/>
    <ex:hasPageCountW>2022</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>November 2022</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dunwich_Horror_%28Nash_Carver%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAudioAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dunwich Horror (Nash Carver)</rdfs:label>
    <ex:hasAnnotation>The Dunwich Horror Full story online here Nash Carver English Genre(s) Horror Nightscapes #7 date April 1998 " The Dunwich Horror " is a Cthulhu Mythos -inspired song by Nash Carver. Synopsis The work adapts H. P. Lovecraft 's story " The Dunwich Horror " into eight verses of irregular length. The accompanying music does not appear to have been released. Histor "The Dunwich Horror" was published in issue #7 of the E. P. Berglund -edited Lovecraftian ezine Nightscapes in April 1998.</ex:hasAnnotation>
    <ex:hasAuthorW>Nash Carver</ex:hasAuthorW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Nightscapes #7</ex:isPublishedAsW>
    <ex:wasPublishedOnW>April 1998</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Reading:_Three_Variants_on_a_Theme">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Reading: Three Variants on a Theme</rdfs:label>
    <ex:hasAnnotation>James Dorr English Deep Fried Horror Cthulhu Cheese Burger date January 2020 " " is a short Cthulhu Mythos story by American James Dorr . It was published in the Deadman's Tome anthology Deep Fried Horror Cthulhu Cheese Burger in January 2020. Synopsis A unnamed poet who has agreed to give a reading of his works to the Ladies Library Culture Committee must deal with a bad case of pre-performance jitters. This is followed by three branches of the story: in the first, he massacres his audience with an automatic weapon so that he doesn’t not have to perform and be judged; in the second, his stumbling reading accidentally mimics a ritual which summons the Great Old One Cthulhu ; the third features Cthulhu as the poet as he approaches the lectern, scared half to death at the prospect of the forthcoming recital.</ex:hasAnnotation>
    <ex:hasAuthorW>James Dorr</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Deep_Fried_Horror_Cthulhu_Cheese_Burger"/>
    <ex:wasPublishedOnW>January 2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#In_a_Sequesterd_Providence_Churchyard_Where_Once_Poe_Walkd">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>In a Sequester'd Providence Churchyard Where Once Poe Walk'd</rdfs:label>
    <ex:hasAnnotation>Full story online here H. P. Lovecraft United States English (original) French Maurice W. Moe Four Acrostic Sonnets on Edgar Allan Poe Date of writing 8 August 1936 date 1936 " " is a short poem by the late American H. P. Lovecraft . First published in Four Acrostic Sonnets on Edgar Allan Poe by Maurice W. Moe in 1936, it has since been reprinted many times, and has also been translated into French . Synopsis The thirteen lines in two verses describe the graveyard of the Cathedral of St. John in Providence , Rhode Island , and the tragic spirit of Edgar Allan Poe which wanders the plots. Behind the Mythos Written on 8 August 1936 in the graveyard of the Cathedral of St. John in Providence, Rhode Island, USA , "" was written as part of a contest held between Lovecraft, Robert H. Barlow , and Adolphe de Castro . History Four Acrostic Sonnets on Edgar Allan Poe (1936) Science-Fantasy Correspondent (1937) Weird Tales (1938) Beyond the Wall of Sleep (1943) Collected Poems (1963) The Man Who Called Himself Poe (1969) The World of H. P. Lovecraft (1971) Fungi from Yuggoth and Other Poems (1971, 2016) A Man Called Poe: Stories in the Vein of Edgar Allan Poe (1972) Etchings &amp; Odysseys (1984) Crypt of Cthulhu (1988) The Fantastic Poetry (1990) The Ancient Track (2001, 2013) Eldritch Tales: A Miscellany of the Macabre (2011) Essais - Correspondance - Poésie - Révisions (2021, French- translation) Intégrale (2021, French- translation) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:isPublishedAsW>Four Acrostic Sonnets on Edgar Allan Poe</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1936</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>8 August 1936</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Metallica">
    <rdf:type rdf:resource="http://example.org/lovecraft#ContentCreators"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Metallica</rdfs:label>
    <ex:hasAnnotation>Lars ulrich &amp; james hetfield united states metal is an american thrash metal band whose music has repeatedly referenced the cthulhu mythos . The band was reportedly turned on to the work of h.p. Lovecraft by bassist cliff burton . When guitarist kirk hammett joined the band in 1983, he and burton bonded over a mutual interest in the call of cthulhu roleplaying game .</ex:hasAnnotation>
    <ex:hasWebsiteR>https://www.metallica.com/</ex:hasWebsiteR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lu-Kthu_Cycle">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#StoryCycles"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lu-Kthu Cycle</rdfs:label>
    <ex:hasAnnotation>The James Ambuehl United States English The is a Cthulhu Mythos story cycle created by American , editor and poet James Ambuehl , with its earliest entry, "Sculpture", appearing in Etchings &amp; Odysseys #5 in October 1984. Several of the stories were compiled in the chapbook collection Correlated Contents in 1998. The cycle centres on the Outer God Lu-Kthu and the realm of Altuan , a prehistoric island-continent long forgotten in the modern age. Entries (possibly incomplete) "Sculpture" (1984) " The Stalker in the Snows " (1997) " The Terror of Toad Lake " (1997) "The Snake Farm" (1998) "The Deep-Lord Awakens" (1998) " Correlated Contents " (1998)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#James_Ambuehl"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Rising">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Rising</rdfs:label>
    <ex:hasAnnotation>Call of cthulhu is a horror fiction role-playing game based on h.p. Lovecraft's cthulhu mythos . The game is set during the 23rd century, as man has colonized the solar system . It's a world in which there is a world government, though its member states have autonomy .</ex:hasAnnotation>
    <ex:hasAuthorW>John Ossoway</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>Role-play</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Macabre_and_Blasphemous_Horror_of_Chocolate_Cake_Twinkles">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Macabre and Blasphemous Horror of Chocolate Cake Twinkles</rdfs:label>
    <ex:hasAnnotation>M. Kelly Peach English Deadman's Tome Deep Fried Horror Cthulhu Cheese Burger date January 2020 " " is a tongue-in-cheek Cthulhu Mythos story by American M. Kelly Peach. It was published in the Deadman's Tome anthology Deep Fried Horror Cthulhu Cheese Burger in January 2020. Synopsis The story describes the seductive pull of a new brand of cake bar on the market, and one man's struggle to remain abstinent. Eventually, however, their allure becomes too much, and he buys a pack, only to discover that there may be more involved in their manufacture than simple baking… Behind the Mythos A number of Cthulhu Mythos elements are name-dropped in the story, including Shoggoths , Hastur , Cthulhu , the Yellow Sign , the Silver Key , and Tsathoggua .</ex:hasAnnotation>
    <ex:hasAuthorW>M. Kelly Peach</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Deep_Fried_Horror_Cthulhu_Cheese_Burger"/>
    <ex:wasPublishedOnW>January 2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Conglomerate">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Conglomerate</rdfs:label>
    <ex:hasAnnotation>A crazed vandal kills himself after defacing a company's icon . Head of security colin james decides to look into the man's motives . He discovers that his city was once the site of a titanic battle .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Jeffrey_Thomas"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Midnight Shambler November 1996</ex:isPublishedAsW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Doors_to_Darkness">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Doors to Darkness</rdfs:label>
    <ex:hasAnnotation>144 is an adventure supplement for the call of cthulhu roleplaying game by chaosium . It contains five standalone scenarios designed to help ease new keepers into running games of call of cthulhu . All of the maps and handouts necessary to play are provided, as well as a set of ten pre-generated investigators .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>144</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2016</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#hasAlternativeNamesR">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>hasAlternativeNamesR</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ultimate_Gate">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MysticalArtefacts"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Ultimate Gate</rdfs:label>
    <ex:hasAnnotation>First appearance HPL : " Through the Gates of the Silver Key " Created by H. P. Lovecraft The is a gateway through beyond and outside all of space and time. It is guarded by 'Umr At-Tawil , as well as Yog-Sothoth , and can be accessed through the use of the Silver Key . Among other things, it allows one access to all of the possible lives one may live or have lived; for example, Randolph Carter was able to enter the mind and body of Zkauba , an alien mystic who existed along a divergent spatial and temporal continuity from Carter's own existence. ( HPL : " Through the Gates of the Silver Key ")</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#Through_the_Gates_of_the_Silver_Key"/>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Jade_Emperor">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ElderGods"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Jade Emperor</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Elder_God"/>
    <ex:hasAnnotation>The is part of the mythology of chinese traditional religion (aka, folk religion) he was first used by chaosium in 2005 for its call of cthulhu rpg as an elder god . He is at the head of the taoist court, the personification of yin and yang .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Secrets_of_Japan"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Cursed_Appeal_of_Knowledge">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Cursed Appeal of Knowledge</rdfs:label>
    <ex:hasAnnotation>Frank Forte English Asylum Press Beyond Lovecraft date September 2020  " " is a Lovecraftian short story by American Frank Forte . It was published in his collection Beyond Lovecraft by Asylum Press in September 2020. Synopsis In 1884, a curious young man makes his way to a mysterious and hidden library in search of greater truths. However, when he gets there, he finds nothing more than a wicked librarian intent on sacrificing him to appease a malevolent entity named Bogubruzz.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Frank_Forte"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Beyond_Lovecraft"/>
    <ex:wasPublishedOnW>September 2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bhutan">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Bhutan</rdfs:label>
    <ex:hasAnnotation>The kingdom of southasia is a mountainous landlocked country in south asia . It is bordered by china to the north and india to the south . It has appeared in the cthulhu mythos work of other authors .</ex:hasAnnotation>
    <ex:hasTypeL>Country</ex:hasTypeL>
    <ex:isLocatedAtL>South Asia</ex:isLocatedAtL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Malleus_Monstrorum">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Malleus Monstrorum</rdfs:label>
    <ex:hasAnnotation>The , which is a faux-latin play on the late medieval text malleus maleficarum, is a gaming supplement for call of cthulhu . First released in 2006, it was a revised and considerably updated development of 1998's creature companion . All editions of the book have been "monster manuals": collections of various monsters, deities, spirits, and other creatures .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mike_Mason"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Paul_Fricker"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Scott_David_Aniolowski"/>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2020 2006</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yohk_the_Necromancer">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Yohk the Necromancer</rdfs:label>
    <ex:hasAnnotation>Winter 1971 is a short story by american gary myers . It first appeared in the winter 1971 issue of the arkham collector . The narrator tells that in the land of vornai, there was a fat-bellied clerk called yohk . He was a sorcerer of no little accomplishment that arrived from the mists .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Gary_Myers"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Arkham_Collector"/>
    <ex:isPublishedAsW>Winter 1971</ex:isPublishedAsW>
    <ex:wasPublishedOnW>Winter 1971</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Spectral_Hunter">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ServitorRaces"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Spectral Hunter</rdfs:label>
    <ex:hasAnnotation>Real World Information First appearance EXP : Shadows of Yog-Sothoth Created by John Carnahan The Spectral Hunters are a race of invisible mutants created for the Call of Cthulhu role-playing game supplement Shadows of Yog-Sothoth . Description Spectral Hunters are humans who have willingly transformed themselves into shark-teethed red-eyed giants with the ability to levitate and become invisible at will. Each has an occult artifact that holds their soul, which will kill them when destroyed. Gallery</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Shadows_of_Yog-Sothoth"/>
    <ex:wasCreatedByC>John Carnahan</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bayt_al_Azif">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Bayt al Azif</rdfs:label>
    <ex:hasAnnotation>English irregular is a sporadically-released magazine dedicated to roleplaying in the cthulhu mythos . Since its inaugural issue in october 2018, a total of five issues have seen print, with the last being issued in march 2023 . Past contributors have included lisa padol , john scott ty</ex:hasAnnotation>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nioth-Korghai">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Nioth-Korghai</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Ubbo-Sathla"/>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#Ubbo-Sathla"/>
    <ex:hasAnnotation>The space vampires are a long-lived androgynous, yellow, fungoid, squid-like alien race . They come from the planet karthis , a water-world, and possessed a highly evolved civilisation millions of years ago . Some of the became vampiric (calling themselves "the ubbo-sathla") and these were outlawed by the nioth race .</ex:hasAnnotation>
    <ex:hasAppearanceC>The Star Vampires</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Tomb-Spawn"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Carsai_the_King">
    <rdf:type rdf:resource="http://example.org/lovecraft#Avatars"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Carsai the King</rdfs:label>
    <ex:hasAffiliationC>He's more of a leader than a worshipped one</ex:hasAffiliationC>
    <ex:hasAnnotation>Aucturn is the leader of the citadel of the black, a neutral zone between the old cults and the dominion of the black . He is suspected of being an avatar of the empty traveler, who is in turn an avatar of nyarlathotep . The ichor lords recognize the authority of and see him as the prophet of their worlds .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Encyclopedia_Cthulhiana/Contents_M-S">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Encyclopedia Cthulhiana/Contents M-S</rdfs:label>
    <ex:hasAnnotation>This page lists the contents from m-s of the chaosium reference book by daniel harms . It is based on the work "the encyclopedia cthulhiana" by daniel harms . Harms is the author of "the encyclopedia of cthulhu mythology"</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Epiphany_of_Dissolution">
    <rdf:type rdf:resource="http://example.org/lovecraft#BhyhlunSeries"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Epiphany of Dissolution</rdfs:label>
    <ex:hasAnnotation>History was first published in the online fanzine nightscapes in 1998 . It later appeared in the anthology the best of dark legacy, volume 2 in 2016 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ian_Davey"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>The Bh'Yhlun series</ex:isPartOfSeriesW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Nightscapes"/>
    <ex:wasPublishedOnW>January 1998</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Unbound_3">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Unbound 3</rdfs:label>
    <ex:hasAnnotation>Various English Permuted Press 257 Preceded by Cthulhu Unbound, Vol. 2 is an anthology of Lovecraftian fiction edited by David Conyers and Brian M. Sammons . Running to a total of 257 , it was published in a paperback format by March 2013 by Permuted Press . Overview Contents Unseen Empire by Cody Goodfellow Mirrorrorrim by D. L. Snell Nemesis Theory by Tim Curran The R'Lyeh Singularity by David Conyers and Brian M. Sammons References</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>257</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Sentinels">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RamseyCampbellWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Sentinels</rdfs:label>
    <ex:hasAnnotation>The story was first published in the 1973 arkham house collection demons by daylight . It has been translated into both french and german . It is set in the fictional severn valley .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Demons_by_Daylight"/>
    <ex:wasPublishedOnW>1973</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tales_of_the_Cthulhu_Mythos">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Tales of the Cthulhu Mythos</rdfs:label>
    <ex:hasAnnotation>Arkham house released a revised edition in 1990, edited by james turner . Dropped four of the six stories original to the 1969 edition, keeping only campbell and wilson's contributions . Added stories included one by lovecraft circle member fritz leiber , and pieces by joanna russ , karl edward wagner , philip josé farmer , and richard a. lupoff .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:wasReleasedOnW>1969</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#At_the_Mountains_of_Madness_%282010_ARTC_audio_drama%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAudioAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>At the Mountains of Madness (2010 ARTC audio drama)</rdfs:label>
    <ex:hasAnnotation>At the Mountains of Madness (2010 ARTC audio drama) Based on At the Mountains of Madness William Alan Ritch David Benedict The Ghosts Project, Paul Mercer and Davis Petterson Production Company The Atlanta Radio Theatre Company Release date 5 September 2010 United States English At the Mountains of Madness is an audio drama adaptation of the H. P. Lovecraft novella of the same name produced by the Atlanta Radio Theatre Company . The second production of the story by the ARTC, it was performed live on stage at Georgia's Dragon*Con on 5 September 2010.</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#At_the_Mountains_of_Madness"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>5 September 2010</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Anne_M._Pillsworth">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Anne M. Pillsworth</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Troy, New York, USA United States is a writer who lives in a suburb of Providence , Rhode Island . She has written two dark fantasy novels for young adults set in the universe of the Cthulhu Mythos . She also writes, with Ruthanna Emrys , the Reading the Weird (formerly The Lovecraft Reread) blog series for Tor.com. Selected Bibliography Redemption's Heir Series "Geldman's Pharmacy" (1999) Summoned (2014) The Madonna of the Abattoir (2014) Fathomless (2015) External Links at The Internet Speculative Fiction Database Reading the Weird at Tor.com References</ex:hasAnnotation>
    <ex:hasBirthplaceR>New York USA Troy</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
