    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Howling Fog</rdfs:label>
    <ex:hasAnnotation>Ruth Tillman English Cthulhu Confidential Genre(s) Roleplaying game Pelgrane Press 43 is a scenario supplement for Pelgrane Press 's Cthulhu Mythos roleplaying game Cthulhu Confidential , written by Ruth Tillman , one of the creators of the core game. Initially published solely as a digital download, it was later included in the omnibus collection Even Death Can Die . Overview</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ruth_Tillman"/>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
