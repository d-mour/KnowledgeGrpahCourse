    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Drums of Chaos</rdfs:label>
    <ex:hasAnnotation>Richard L. Tierney Cover Artist Dave Carson United States English Simon of Gitta Mythos Books Release Date October 2008 420 is a novel by Richard L. Tierney , first published by Mythos Books in 2008, with a second edition released by Pickman's Press in 2021. Part of Tierney's Simon of Gitta , it retells the Gospel story through the lens of the Cthulhu Mythos , with Jesus appearing as a half-human son of Yog-Sothoth . Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Richard_L._Tierney"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>420</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Simon_of_Gitta"/>
    <ex:wasReleasedOnW>October 2008</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Vampire">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
