    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Y'ha-nthlei</rdfs:label>
    <ex:hasAnnotation>Overview is a fictional city created by h. p. lovecraft for his novella the shadow over innsmouth . The city is located near devil reef , off the coast of innsmouth .</ex:hasAnnotation>
    <ex:hasAppearanceL rdf:resource="http://example.org/lovecraft#The_Testament_of_Cthulhu"/>
