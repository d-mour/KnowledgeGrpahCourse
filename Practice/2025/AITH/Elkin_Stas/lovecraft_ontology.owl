    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Los mitos de Cthulhu</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft Alberto Breccia Argentina Spanish (original) Italian Polish Genre(s) Horror is a collection of H. P. Lovecraft stories illustrated by Argentinian artist Alberto Breccia . First released in its original Spanish, it has since been translated into Italian ( I miti di Cthulhu ) and Polish ( Mity Cthulhu ). Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
