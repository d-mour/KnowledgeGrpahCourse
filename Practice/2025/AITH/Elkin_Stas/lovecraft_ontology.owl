  <rdf:Description rdf:about="http://example.org/lovecraft#Dagon_June_1990">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dagon June 1990</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Ruptured Often Hickman United Kingdom English Dagon Press Release Date June 1990 58 was the twenty-sixth and final issue of the Lovecraftian fanzine Dagon , billed as a "Humour Special". It was edited by the late British and occasional Carl T. Ford . Contents (incomplete) Editorial by Carl T. Ford "Crawling at You" by uncredited " The Dweller in the Pot (or The Pasta Out of Space Eaters) " by Frank Chimesleep Short "Scream for Jeeves (or, Cats, Rats and Bertie Wooster)" H. P. G. Wodehouse "The Red Brain's Trust" by Peter F. Jeffery "Howl of Hastur: Fantasy Role-Playing in the Worlds of August Derleth" by Stacy Clark "Self-Parody in Lovecraft's Revisions" by Will Murray "H. P. Lovecraft's Loathly Eldritch Band" by Allen Ashley "H. P. Hell" by Mark Morrison "Home on Benefit Street" by Donald R. Burleson "Poetic Justice" by Cathy Buburuz "The Moon Bog" by Allen Ashley Reviews Letters</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>58</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>June 1990</ex:wasReleasedOnW>
  </rdf:Description>
