  <rdf:Description rdf:about="http://example.org/lovecraft#Ancient_Exhumations">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Ancient Exhumations</rdfs:label>
    <ex:hasAnnotation>Stanley C. Sargent Various Cover Artist D. L. Hutchison English Mythos Books Release Date 1999 123 is a collection of horror stories by American Stanley C. Sargent . Edited by Peter Worthy and David Wynn, it featured cover art by D. L. Hutchison and interior work by Hutchison, Sargent, Worthy, Daniel Allen Ross, and Jeffrey Thomas . It was published by Mythos Books in 1999, and ran to a total of 123 . Contents 's Preface &amp; Acknowledgements by Stanley C. Sargent Preface by Robert M. Price Introduction by Peter Worthy " The Tale of Toad Loop " "Dark Demonize" "The Hoppwood Tenant" " When the Stars Are Ripe " "The Paladin of Worms" "Self-Correcting Mechanism" "The Rattle of Her Smile"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Stanley_C._Sargent"/>
    <ex:hasPageCountW>123</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1999</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Soames">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Soames</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Jermyn_family"/>
    <ex:hasAnnotation>England Butler Jermyn family Human First appearance HPL : " Facts Concerning the Late Arthur Jermyn and His Family " Created by H. P. Lovecraft is a butler who worked for Arthur Jermyn until Arthur took his own life by self-immolation in 1913. Described as a trustworthy man, provided a factual account of the details of Arthur's suicide. ( HPL : " Facts Concerning the Late Arthur Jermyn and His Family ")</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Facts Concerning the Late Arthur Jermyn</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>His Family</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crawling_Dead">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Crawling Dead</rdfs:label>
    <ex:hasAnnotation>The was a fleshy throbbing mass of living putrescence with a brain . Lived in the abandoned ruins of an atlantean city during the thurian age . Used a spell to lure king kull of valusia to its lair .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Evil_Dead">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosFilmAndTelevision"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#StoryCycles"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Evil Dead</rdfs:label>
    <ex:hasAnnotation>United states english is a multimedia comedy-horror franchise created by american filmmaker sam raimi . Launched with the 1981 low-budget horror film the , it has since expanded into five feature films, a live-action television series, numerous computer games, and an off-broadway musical . As of may 2024, two more spin-off films and an animated series are also in development .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1981</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dulwich_Horror_of_1927">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dulwich Horror of 1927</rdfs:label>
    <ex:hasAnnotation>Cthulhu mythos short story forms part of the author's william blake cycle . Narrator of the tale is a man with a deep interest in philosophy . The story also functions as an origin story for the character of jessica . She would go on to be the primary protagonist in his next novel .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#David_Hambling"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>The William Blake cycle</ex:isPartOfSeriesW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Shadows_from_Norwood"/>
    <ex:wasPublishedOnW>July 2013</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shub-Niggurath:_The_Black_Goat_of_the_Woods_with_a_Thousand_Young_%28LARP_supplement%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Shub-Niggurath: The Black Goat of the Woods with a Thousand Young (LARP supplement)</rdfs:label>
    <ex:hasAnnotation>Shub-Niggurath - The Black Goat of the Woods with a Thousand Young Khurt Khave First United Church of Cthulhu Publication Date February 2016 Lovecraftian horror Action-adventure Shub-Niggurath - The Black Goat of the Woods with a Thousand Young is a gaming aid designed primarily for the live-action roleplaying . Published by the First United Church of Cthulhu via CreateSpace in February 2016, it was created by Khurt Khave , the head priest of that organisation. Overview</ex:hasAnnotation>
    <ex:wasPublishedOnW>February 2016</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lagh_metal">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MysticalArtefacts"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Lagh metal</rdfs:label>
    <ex:hasAnnotation>" out of the aeons " is a fictional extraterrestrial substance featured in the story " out of the aeons ", written by h. p. lovecraft for hazel heald . It has been brought to the ancient continent of mu by alien creatures from yuggoth . The cylinder that contained the scroll of t'yog was made out of this substance, which defied all kinds of scientific analysis .</ex:hasAnnotation>
    <ex:hasPlaceOfOriginA>Outer space</ex:hasPlaceOfOriginA>
    <ex:hasTypeA>Advanced alien alloy</ex:hasTypeA>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#Out_of_the_Aeons"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Horsemen_of_Nyarlathotep">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Horsemen of Nyarlathotep</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Nyarlathotep"/>
    <ex:hasAlternativeNamesC>Four Horsemen of Nyarlathotep</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The four are a demonic quartet of supernatural beings who serve the messenger of the outer gods, nyarlathotep . They are supporting antagonists of fall of cthulhu , a supernatural horror comic book series published by boom! Studios in 2007 .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Fall_of_Cthulhu"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Write_Like_Hell:_Lovecraft_in_a_Time_of_Madness">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Write Like Hell: Lovecraft in a Time of Madness</rdfs:label>
    <ex:hasAnnotation>Various English Write Like Hell Sentinel Creatives Release Date December 2021 469 is an anthology of Lovecraftian fiction published by Sentinel Creatives. The fourth book in their Write Like Hell , it ran to a total of 469 and was issued in digital and downloadable audiobook formats only. Overview Contents A Word from the Creators, introduction by uncredited "The King in Binary" by Madison Kilian "In the Flat Field" by Scotty Milder "The Azimuth Pilot" by C. R. Tyroak "Kept in Shadow" by Mark Wheaton "The Knights of the Non-Euclidean Table" by Mitchell Lüthi "The Cats" by H. P. Lovecraft "The Gulf Breach" by Jack Faircloth "Zodiac Harvest" by Jennifer Jeanne McArdle "Chum" by Patrick Moody "The Roof of the World" by C. L. Werner " The City " by H. P. Lovecraft "The Obsession of Doctor Paulk" by Kenneth Bykerk "Where Spirits Tread" by Thomas Parrot "The Lovecraftian Bestiary" by Stephen Spinas "The Valley of the Kings" by Scott Miller "A Summoning of Saint Ann" by Justin Fillmore "Passing Through" by Erik Handy "The Eye of the Sahara" by Adam Gray " Memory " by H. P. Lovecraft "Savage Road • short fiction by David F. Gray "Esca" by Erica Schaef "Kit &amp; Howard" by Andre Uys "Down the Drain" by Donovan McDowell "Old Dogs" by Felix Flynn "The Key, The Gate—His Peacock Tongue" by James B. Pepe Gallery</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>469</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Write Like Hell</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>December 2021</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Something_in_the_Moonlight">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Something in the Moonlight</rdfs:label>
    <ex:hasAnnotation>The story follows the statement of newly-qualified psychiatric councillor charles winslow curtis, m.d., interspersed with notes from the journal of one of his patients, one uriah horby . The story is littered with references to the greater cthulhu mythos .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Short Fiction Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>December 1980</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Origin_of_Original_Sin">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Origin of Original Sin</rdfs:label>
    <ex:hasAnnotation>Ruth Sabath Rosenthal English James Ward Kirk Publishing Lovecraft after Dark date November 2015  " " is a Lovecraftian poem by American Ruth Sabath Rosenthal. It was published in the James Ward Kirk Publishing thematic anthology Lovecraft after Dark in November 2015. The poem is in essence a retelling of the Christian creation myth, featuring Lilith , Adam and the Serpent in the Garden of Eden.</ex:hasAnnotation>
    <ex:hasAuthorW>Ruth Sabath Rosenthal</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Lovecraft_after_Dark"/>
    <ex:wasPublishedOnW>November 2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cubicle_7_Entertainment">
    <rdf:type rdf:resource="http://example.org/lovecraft#Publishers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Cubicle 7 Entertainment</rdfs:label>
    <ex:hasAnnotation>Cubicle 7 are an irish publishing company specialising in roleplaying games . Their licence to produce call of cthulhu material expired in 2017 . Since then, the rights to all of their call of cthulhu sourcebooks have reverted to chaosium .</ex:hasAnnotation>
    <ex:hasWebsiteR>https://www.cubicle7games.com/</ex:hasWebsiteR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Achtung%21_Cthulhu_%28setting%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Achtung! Cthulhu (setting)</rdfs:label>
    <ex:hasAnnotation>Achtung! Cthulhu is a horror fiction role-playing game setting inspired by h. p. lovecraft's cthulhu mythos . It was originally designed to be compatible with both the sixth edition of call of cthulhu and the savage worlds game systems . Later it would be adapted to use modiphius's system-agnostic 2d20 ruleset . Achtung! Cthulhu has spawned numerous supplements, miniature</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Chris_Birch"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lynne_Hardy"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Historical Action</ex:hasGenreW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>role-playing game</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Brood_of_Bubastis">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Brood of Bubastis</rdfs:label>
    <ex:hasAnnotation>Horror short story by robert bloch set in the cthulhu mythos . Narrator travels to cornwall, england, to visit a friend who shares his interest in occultism . He discovers a cave with egyptian hieroglyphs, which he invites the narrator to see . He is horrified to find the mummified bodies of half-human, half-animal things .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_Bloch"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>March 1937</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_White_Sybil">
    <rdf:type rdf:resource="http://example.org/lovecraft#ClarkAshtonSmithWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The White Sybil</rdfs:label>
    <ex:hasAnnotation>A poet named tortha returns to his home city of cerngoth in the ice-covered mhu thulan . He discovers the legendary white sybil, who is rumored to descend from the northern mountains . Tortha is enchanted by her exotic beauty, but soon finds himself in an alien valley . The story is part of his hyperborea series .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Men of Avalon</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1934</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Twilight_People">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Twilight People</rdfs:label>
    <ex:hasAnnotation>Zofia, a woman working the graveyard shift at a care home in america's great basin, is on duty the night a comet is due to approach the earth . As the celestial traveller's presence begins to affect the atmosphere, the sky changes colour and the stars realign themselves . Several of the care home's residents reveal their true nature as followers of the old ones and celebrate their return .</ex:hasAnnotation>
    <ex:hasAuthorW>Christopher Pate</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 2</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 8</ex:isPublishedAsW>
    <ex:wasPublishedOnW>July 2023</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Le_cycle_dHastur">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Le cycle d'Hastur</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Silvain Cordurié France French Oriflam Release Date January 2000 378 is a French- collection of Lovecraftian fiction edited by Robert M. Price and published by Oriflam in January 2000. It is a translation of Chaosium 's Call of Cthulhu Fiction anthology The Hastur Cycle . Contents "La mythologie d'Hastur" introduction by Robert M. Price ("The Mythology of Hastur") "Haïta le berger" by Ambrose Bierce (" Haïta the Shepherd ") "Un habitant de Carcosa" by Ambrose Bierce (" An Inhabitant of Carcosa ") "Le réparateur de réputations" by Robert W. Chambers (" The Repairer of Reputations ") "Le signe jaune" by Robert W. Chambers (" The Yellow Sign ") "Le fleuve des songes nocturnes" by Karl Edward Wagner ("The River of Night's Dreaming") "Plus de lumière" by James Blish ("More Light") "Le roman du sceau noir" by Arthur Machen (" Novel of the Black Seal ") "Celui qui chuchotait dans les ténèbres" by H. P. Lovecraft (" The Whisperer in Darkness ") "Notes sur l'affaire Elizabeth Akeley" by Richard A. Lupoff (" Documents in the Case of Elizabeth Akeley ") "La mine sur Yuggoth" by Ramsey Campbell (" The Mine on Yuggoth ") "Atterrissage sur Yuggoth" by James Wade (" Planetfall on Yuggoth ") "Le retour d'Hastur" by August Derleth (" The Return of Hastur ") "Celui qui festoie de loin" by Joseph Payne Brennan ("The Feaster from Afar") "Litanie pour Hastur" by Lin Carter ("Litany to Hastur") "Histoire de Carcosa sur Hali" by Lin Carter ("Carcosa Story About Hali") "Le roi en jaune, une tragédie en vers" by Lin Carter and Robert M. Price ("King in Yellow: A Tragedy in Verse") Index by Alain Sprauel</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW rdf:resource="http://example.org/lovecraft#France"/>
    <ex:hasPageCountW>378</ex:hasPageCountW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:wasReleasedOnW>January 2000</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#New_Tales_of_the_Yellow_Sign">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>New Tales of the Yellow Sign</rdfs:label>
    <ex:hasAnnotation>Robin D. Laws Cover Artist Jerome Huguenin English Atomic Overmind Press Release Date August 2012 176 is a thematic collection of horror fiction by Canadian , editor and games designer Robin D. Laws . It was first published in August 2012 by Atomic Overmind Press; both paperback and digital editions were released. Overview Contents ""I Pray God May Curse the Writer": Robert W. Chambers and Robin D. Laws" foreword by Kenneth Hite "Full Bleed" "Gaps" "The Blood on the Wall in the Fortress" "A Boat Full of Popes" "Distressing Notification" "Pendulous" "The Dog" "Fuck You You're Not Getting Out of This Car"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robin_D._Laws"/>
    <ex:hasPageCountW>176</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>August 2012</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tith">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>T'ith</rdfs:label>
    <ex:hasAffiliationC>Elder Gods</ex:hasAffiliationC>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAnnotation>Great Old Ones Elder Gods First appearance EXP : Nightmare's Disciple Created by Joseph S. Pulver, Sr. is the offspring of the Great Old One Cthulhu and the Elder God Sk'tai .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Nightmares_Disciple"/>
    <ex:wasCreatedByC>Joseph S. Pulver. Sr.</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Chronicles_of_the_Cthulhu_Codex_3">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Chronicles of the Cthulhu Codex 3</rdfs:label>
    <ex:hasAnnotation>Chronicles of the Cthulhu Codex #3 Various Cover Artist Gregory Montejo English Fungoid Press Release Date January 1987 54 Preceded by January 1986 Followed by February 1987 Chronicles of the Cthulhu Codex #3 is an issue of the irregularly-scheduled fanzine Chronicles of the Cthulhu Codex . Edited by Pierre Comtois and featuring cover art by Gregory Montejo, it was published by Fungoid Press in January 1987. Contents "Living Mystery" by Ken Stone "To: H.P.L." by Ken Stone "Dunwich" by Ken Stone "The Vat" by David Daniel "That Noble Dust" by Henry J. Vester, III "The Winds of Yith" by William H. Pugmire "The Eyes of Darkness" by Edward P. Berglund "The King in Yellow" by Charles Vaughan</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>54</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>January 1987</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Xada-Hgla">
    <rdf:type rdf:resource="http://example.org/lovecraft#Avatars"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Xada-Hgla</rdfs:label>
    <ex:hasAffiliationC>Avatar of Azathoth</ex:hasAffiliationC>
    <ex:hasAnnotation>"the insects from shaggai" is an avatar of azathoth created by ramsey campbell . It's described as azathoth's "original form" in the short story . Its name comes from another tale, " the mine on yuggoth " .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Insects_from_Shaggai"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Adolphe_de_Castro">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsCoAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsCorrespondents"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Adolphe de Castro</rdfs:label>
    <ex:diedOnR>1959 March 4</ex:diedOnR>
    <ex:hasAnnotation>Adolphe danziger de castro was a jewish scholar, journalist, lawyer and author . He was born in dobrzy nad wis, congress, in 1859 . Two of his stories were revised by h. p. lovecraft for republication in weird tales .</ex:hasAnnotation>
    <ex:hasBirthplaceR>Congress Poland Dobrzyń nad Wisłą</ex:hasBirthplaceR>
    <ex:hasChildrenR>Beatrice Danziger (Dolan)</ex:hasChildrenR>
    <ex:hasChildrenR>Nathan Danziger (Nathan Dolan)</ex:hasChildrenR>
    <ex:hasPseudonymR>Gustav Adolf Danziger Adolph Danziger Adolphe Danziger</ex:hasPseudonymR>
    <ex:wasBornOnR>1859 November 6</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Events_at_Poroth_Farm">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Events at Poroth Farm</rdfs:label>
    <ex:hasAnnotation>The story follows a soon-to-be teacher who rents an outbuilding at the poroth family farm somewhere in new england for the duration of the summer . He unwittingly opens a tiny tear in the fabric of space-time which lets through a malevolent entity . This entity at first takes the form of a bizarre little creature the size of a large shrew, then inhabits one of the farm owner's cats before moving on to the owners themselves, killing the wife</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#T._E._D._Klein"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Short Fiction Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>December 1972</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Abijah_Hoadley">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Abijah Hoadley</rdfs:label>
    <ex:hasAnnotation>Reverend hoadley is a fictional character created by h. p. lovecraft for his short story " the dunwich horror ". He is mentioned briefly in the opening chapter of "the dunwich horror ", where it is mentioned that he delivered a sermon to the congregational church at dunwich village in 1747 . Soon after giving his oration, he disappeared .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Dunwich_Horror"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ambrose_Bierce">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsInspirationsAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosAdjacentAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Ambrose Bierce</rdfs:label>
    <ex:diedOnR>Unknown presumed to be 1914</ex:diedOnR>
    <ex:hasAnnotation>Full Name Ambrose Gwinnett Bierce Birth Date 24th June, 1842 Meigs County, Ohio Death Date Unknown, presumed to be 1914 United States Ambrose Gwinnett Bierce (June 24, 1842 – circa 1914) was an American short story writer, journalist, poet, and Civil War veteran. He notably wrote the short stories " Haïta the Shepherd " and " An Inhabitant of Carcosa ", which introduced the names of Hastur and Carcosa , which were later expanded upon by Robert W. Chambers , H. P. Lovecraft and August Derleth .</ex:hasAnnotation>
    <ex:hasBirthplaceR>Ohio Meigs County</ex:hasBirthplaceR>
    <ex:hasFullNameR>Ambrose Gwinnett Bierce</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:wasBornOnR>1842 24th June</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#How_to_Frame_a_Dying_Art">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>How to Frame a Dying Art</rdfs:label>
    <ex:hasAnnotation>Mike Lee English Genre(s) Weird fiction Lovecraftiana Vol 5, Issue 1 date 2020  " " is a Lovecraftian short story by Mike Lee . Synopsis A man visiting the unnamed capital of his homeland meets an artist who takes him on a tour of the less-seen quarters of the city. In one particularly seedy bar, the man bears witness to a terrifying scene whereby a seemingly-deceased dancer entertains with the "truth of the Worm". Horrified and disgusted, the man flees, but suspects that his turn to provide "entertainment" may come soon… History "" was published in Vol 5, Issue 1 of the Lovecraftiana zine.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mike_Lee"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 1</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 5</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Alone_Against_the_Wendigo">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Alone Against the Wendigo</rdfs:label>
    <ex:hasAnnotation>Solitaire adventure in canada's wilds was a solo-play adventure module released by chaosium for their seminal roleplaying game call of cthulhu . It was written by glenn rahman with cover art provided by dan day and david day, and interior art by tom sullivan . It centred around a small group of scientists and their quest to discover proof of the sasquatch in canada's northwest territories .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Glenn_Rahman"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>68</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>1985</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#De_Marignys_Clock_%28story%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#BrianLumleyWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>De Marigny's Clock (story)</rdfs:label>
    <ex:hasAnnotation>Occultist and psychic titus crow wakes up to find himself threatened by a pair of burglars, who demand to know where he keeps his money . The ruffians refuse to believe in crow's claim that there is no money in the house, and proceed to search for it amidst his collection of books and antiquities . For years, crow has been trying to make sense out of its functioning, but hasn't been able to open it .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>The Caller of the Black</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1971</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yhath">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Y'hath</rdfs:label>
    <ex:hasAnnotation>First appearance EXP : " Where Yidhra Walks " Created by Walter C. DeBill Jr. The vulturine "great winged in the sky" is mentioned in rituals to Yidhra as a servant of that god. Behind the Mythos was created by Walter C. DeBill, Jr.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Where_Yidhra_Walks"/>
    <ex:wasCreatedByC>Walter C. DeBill Jr.</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Glynn_Owen_Barrass">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Glynn Owen Barrass</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Editor Games designer Middlesbrough, England United Kingdom  is an English author, editor and games designer who specialises in weird fiction, and Cthulhu Mythos -related work in particular, although he has also released some cyberpunk and fantasy stories. Writing since 2006, Barrass frequently collaborates with Brian M. Sammons , particularly on editing projects, and has produced well over 180 stories in various genres. Selected Bibliography Editor Eldritch Chrome: Unquiet Tales of a Mythos-Haunted Future (2013, with Brian M. Sammons ) World War Cthulhu (2014, with Brian M. Sammons) Steampunk Cthulhu: Mythos Terror in the Age of Steam (2014, with Brian M. Sammons) The Children of Gla'aki (2017, with Brian M. Sammons) Summer of Lovecraft (2019, with Brian M. Sammons) Collections Arkham Nights: Tales of Mythos Noir (2016, with Ron Shiflet ) Short Stories " The Bride of the Beast " (2014) " Dark Cell " (2014, with Brian M. Sammons ) "Lords of Karma" (2016, with Juliana Quartaroli) " Causality Revelation " (2017) " Closure " (2017) " Moths to a Pallid Flame " (2018, with Ron Shiflet ) " Treacherous Memory " (2019) " Acceleratrix " (2021) Gaming Material Punktown (2018, with Mike Tresca and Brian M. Sammons ) Aspirations (2019, contributor) The Foulness Island Vanishings (2020) Eyes Like Red Balls of Flame (2020) A Time to Harvest (2021)</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#England Middlesbrough</ex:hasBirthplaceR>
    <ex:hasNationalityR>United Kingdom</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Games designer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Thoth-Amon">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Thoth-Amon</rdfs:label>
    <ex:hasAnnotation>Human First appearance CIRCLE : " The Phoenix on the Sword " Created by Robert E. Howard (also spelled ) is a character from the Conan cycle ( CIRCLE : " The Phoenix on the Sword " ) and Cthulhu Mythos stories. ( CIRCLE : " The Haunter of the Ring " ) He is a Stygian wizard and at one time possessed the Serpent Ring of Set (also called "The Ring of "). ( CIRCLE : " The God in the Bowl " )</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Phoenix on the Sword</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Alyda_Winthrop">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Alyda Winthrop</rdfs:label>
    <ex:hasAnnotation>Alyda is a character created by jean-paul ouellette for the 1988 film the unnamable and its 1993 sequel the unnamable ii . She is loosely based on the titular creature from h. p. lovecraft's original short story " the unnamable ".</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Unnamable_II:_The_Statement_of_Randolph_Carter"/>
    <ex:madeFirstAppearanceOnC>The Unnamable</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Jean-Paul Ouellette</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mist_Projector">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#TechnologicalArtefacts"/>
    <rdfs:label>Mist Projector</rdfs:label>
    <ex:hasAlternativeNamesA>Mi-Go Mist Projector</ex:hasAlternativeNamesA>
    <ex:hasAnnotation>The is a fictional artefact in the call of cthulhu mythos . It was created by chaosium for their call of cthulhu rpg . When fully charged, it can disperse the mist twenty times before stopping .</ex:hasAnnotation>
    <ex:hasFunctionA>Combat</ex:hasFunctionA>
    <ex:hasPlaceOfOriginA>http://example.org/lovecraft#Yuggoth</ex:hasPlaceOfOriginA>
    <ex:hasTypeA>Weapon</ex:hasTypeA>
    <ex:isUsedByA rdf:resource="http://example.org/lovecraft#Mi-Go"/>
    <ex:madeFirstAppearanceOnA>Call of Cthulhu</ex:madeFirstAppearanceOnA>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#Mi-Go"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Azi_Dahaka">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Azi Dahaka</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Great_Old_One"/>
    <ex:hasAlternativeNamesC>Serpent of a Thousand Skills</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Azi dahak is a demonic entity in ancient persian folklore . First used by chaosium in 2009 for the setting for their call of cthulhu game .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Cthulhu_Invictus"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tulushuggua">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Tulushuggua</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Watery Dweller Beneath</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Watery Dweller Beneath Great Old Ones First appearance " Sinkhole " Created by Michael LaBossiere is a mysterious subterranean horror, dwelling deep within the flooded caves of Florida, served by eel-like horrors called the Tulush .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Sinkhole"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Michael_LaBossiere"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Batman:_The_Doom_That_Came_to_Gotham">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Crossovers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Batman: The Doom That Came to Gotham</rdfs:label>
    <ex:hasAnnotation>The doom that came to gotham is a three-issue comic book miniseries published in 2000-2001 . It was written by mike mignola and richard pace, with art by troy nixey and dennis janke . The title combines h. p. lovecraft 's " the doom that came to sarnath " with batman's gotham city, the plot riddled with lovecraft references .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mike_Mignola"/>
    <ex:hasAuthorW>Richard Pace</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>November 2000 – January 2001</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Richard_L._Tierney">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Scholars"/>
    <rdfs:label>Richard L. Tierney</rdfs:label>
    <ex:diedOnR>1 February 2022</ex:diedOnR>
    <ex:hasAnnotation>Richard l. tierney was a scholar of h. p. lovecraft . He is best known for two series: one featuring a first century samaritan and the other focused on a time-travelling ally of alien forces . He was one of the first to challenge august derleth's interpretation of lovecraft .</ex:hasAnnotation>
    <ex:hasBirthplaceR>United States Iowa Spencer</ex:hasBirthplaceR>
    <ex:hasFullNameR>Richard Louis Tierney</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:wasBornOnR>1936 August 7</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Clark_Ashton_Smith_%28fictional%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Clark Ashton Smith (fictional)</rdfs:label>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#Klarkash-Ton"/>
    <ex:hasAnnotation>Clarkash-ton human has appeared as a fictional character in a number of works over the years, including those of h. p. lovecraft himself . Lovecraft wrote that clarkash-ton is a descendant of azathoth through tsathoggua and thus his distant cousin . Clarkash-ton was an artist known for his illustrations based on the necronomicon .</ex:hasAnnotation>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Wild_Hunt">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Wild Hunt</rdfs:label>
    <ex:hasAnnotation>Tyler Omichinski Chitin Proctor United Kingdom English Call of Cthulhu Genre(s) Horror Stygian Fox Release Date 2019 117 : A Race Across the North-Eastern U.S. to Confound an Ancient Imported Evil is a scenario sourcebook for Chaosium 's Call of Cthulhu roleplaying game. Overview Containing a complete scenario arc along with all necessary NPC statistics, was written by Tyler Omichinski and Chitin Proctor and published by third-party content provider Stygian Fox in 2019 . It runs to a total of 117 in length and was funded via a successful Kickstarter campaign which resulted in the release of softcover, hardcover and digital PDF editions . References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Chitin_Proctor"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Tyler_Omichinski"/>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>117</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2019</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shaggai_%28short_story%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Shaggai (short story)</rdfs:label>
    <ex:hasAnnotation>"shaggai" is a short story by cthulhu mythos author, lin carter . It was first published in the 1971 anthology dark things . The wizard eibon travels to other worlds by astral projection to find the entity .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
    <ex:hasGenreW>Fantasy</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Cthulhu Mythos</ex:isPartOfSeriesW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Dark_Things"/>
    <ex:wasPublishedOnW>1971</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Miskatonic_Missives,_Vol_I._No._1">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Miskatonic Missives, Vol I. No. 1</rdfs:label>
    <ex:hasAnnotation>First in a series of collectible books produced by the h.p. Lovecraft historical society . Edited by sean branney and andrew leman . Published by helios house press in a hardcover format in 2022</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>108</ex:hasPageCountW>
