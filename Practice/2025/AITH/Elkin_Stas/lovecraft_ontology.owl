  <rdf:Description rdf:about="http://example.org/lovecraft#The_Serpents_Egg">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Serpent's Egg</rdfs:label>
    <ex:hasAnnotation>"the serpents egg" is a short story by english writer jonathan green . It was first published in the digital anthology dreaming in darkness in june 2013 . The story is set in the catacombs beneath rural rural county durham, england .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Jonathan_Green"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Dreaming in Darkness</ex:isPublishedAsW>
    <ex:wasPublishedOnW>June 2013</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Lakeside_Cottages">
    <rdf:type rdf:resource="http://example.org/lovecraft#Crossovers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Lakeside Cottages</rdfs:label>
    <ex:hasAnnotation>Paranormal investigator thomas carnacki lends his assistance when two boys from brichester university come down with a strange malady . Unable to save the first boy, carnacki is forced to confront the inhabitant of the lake, gla'aki .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Children_of_Glaaki"/>
    <ex:wasPublishedOnW>2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Psuchawrl">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Psuchawrl</rdfs:label>
    <ex:hasAlternativeNamesC>The Elder One</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Elder One Jinni First appearance EXP : " Out of the Jar " Created by Charles R. Tanner is a character created by Charles R. Tanner for his 1941 Cthulhu Mythos short story " Out of the Jar ". Description One of the alien Jinn who came to the Earth in prehistory, cannot be killed by humans , but was instead imprisoned in a jar by King Solomon, and can only be freed by breaking the jar's seal. Their physical appearance is that of a 9 ft tall humanoid with an eyeless sea anemone-like face, a beaked grinning mouth, and a pronounced ridge running from the forehead to the nape of the neck. ( EXP : " Out of the Jar ") Gallery</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Out_of_the_Jar"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Charles_R._Tanner"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Calie_Liddle">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Calie Liddle</rdfs:label>
    <ex:hasAlternativeNamesC>White Queen</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Carroll ann liddle was created by raven gregory and daniel lester in 2007 . She is the primary protagonist of the wonderland saga, appearing as the protagonist in the majority of the story arcs and mini-series .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Grimm Fairy Tales: Return to Wonderland Vol 1 1</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Daniel Lester</ex:wasCreatedByC>
    <ex:wasCreatedByC>Raven Gregory</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Silvia_Moreno-Garcia">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Silvia Moreno-Garcia</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Editor Author Birth Date 25 April 1981 Baja California, Mexico Mexico Horror Speculative Fiction https://silviamoreno-garcia.com/ is a Mexican-Canadian author, editor and columnist who has edited several Mythos -related anthologies and is the publisher of weird fiction imprint Innsmouth Free Press . She regularly collaborates with Paula R. Stiles . Selected Bibliography Editor Historical Lovecraft (2011, with Paula R. Stiles ) Future Lovecraft (2011, with Paula R. Stiles) Innsmouth Magazine (2013- 2014) She Walks in Shadows (2015, with Paula R. Stiles) Short Fiction " The Sea, Like Broken Glass " (2014) External Links at The Internet Speculative Fiction Database</ex:hasAnnotation>
    <ex:hasBirthplaceR>Mexico Baja California</ex:hasBirthplaceR>
    <ex:hasNationalityR>Mexico</ex:hasNationalityR>
    <ex:hasWebsiteR>https://silviamoreno-garcia.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
    <ex:wasBornOnR>25 April 1981</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Desh">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Desh</rdfs:label>
    <ex:hasAnnotation>Real World Information First appearance " The Dark Wood " Created by Fred Behrendt The Greater and Lesser are an extradimensional species created for the Call of Cthulhu role-playing game. Description The are a beings categorised into two varieties: The Lesser , which resemble large silvery tadpoles with beady eyes and long limbs, and the Greater , which were fish-like with sharp teeth and large eyes. Both species were native to a parallel dimension, but were summoned to our reality through methods utilising a human brain. Despite appearing to move slowly, the were actually very fast and were able to leap through the air.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Dark Wood</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Fred_Behrendt"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Xirdneth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Xirdneth</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Lord of Unreality</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Demon of Deceit</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Maker of Illusion</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Maker of Illusion The Demon of Deceit Lord of Unreality Great Old Ones First appearance EXP : " The Star-Seed " Created by James Ambuehl is an illusion-making entity with no true form. It is unclear whether the entity is an Outer God , Other God , Great Old One or other supernatural entity.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Star-Seed"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#James_Ambuehl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_House_at_the_Edge_of_Time_and_Space">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The House at the Edge of Time and Space</rdfs:label>
    <ex:hasAnnotation>The shade of pierre girault is a short cthulhu mythos story by canadian author troy young . It forms the first part of the third book in his nyarlathotep cycle .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Troy_Young"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
