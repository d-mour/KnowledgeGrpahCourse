    <ex:wasBornOnR>1946</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#From_Cabinet_34,_Drawer_6">
    <rdf:type rdf:resource="http://example.org/lovecraft#CaitlinRKiernanWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>From Cabinet 34, Drawer 6</rdfs:label>
    <ex:hasAnnotation>The story was reprinted in kiernan's collections two worlds and in between (2011) and houses under the sea: mythos tales (2019) it revolves around the discovery of an impossible fossil, grendelonyx innsmouthensi . The discovered fossil bears a label "from naval dredgings, uss cormorant"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Weird Shadows Over Innsmout</ex:isPartOfSeriesW>
    <ex:isPublishedAsW>2005</ex:isPublishedAsW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dagon_and_Jill">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dagon and Jill</rdfs:label>
    <ex:hasAnnotation>Behind the mythos is a short parody story written by american writer, animator and producer john p. mccann . The story is written in the form of letters between a publisher and his client, who has recently sold a trio of books to the los angeles unified school system . The end times predicted by whateley - a six-hour long lightning storm - comes to pass .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#John_P._McCann"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Short Fiction Humour</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Necrotic Tissue Magazine #13 The Cthulhu Mythos Megapack</ex:isPartOfSeriesW>
    <ex:wasPublishedOnW>2011</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Fidus_Aranea">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Fidus Aranea</rdfs:label>
    <ex:hasAnnotation>A short story by american kevin l. o'brien was published in the lovecraftiana zine . It was published in vol 5, issue 3 of the zine in october 2020 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Kevin_L._OBrien"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 3</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 5</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Mephhibbanauth_Cycle:_The_Other,_Series_Two,_Book_1">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Meph'hibb'anauth Cycle: The Other, Series Two, Book 1</rdfs:label>
    <ex:hasAnnotation>The Meph'hibb'anauth Cycle: The Other, Two, Book 1 Troy Young English The Meph'hibb'anauth Cycle Release Date October 2022 312 The Meph'hibb'anauth Cycle: The Other, Two, Book 1 is a collection of Lovecraftian fiction by Canadian Troy Young , following on directly from his first story cycle, The Nyarlathotep Cycle . Running to a total of 312 , it was self-published in October 2022; both paperback and digital editions were released. Overview Contents "Prisoner 12" "The Hierarchy of Daemons" "The Torn Reality" "The Enigma Beneath The Fort" "The Div of Nightmares" "The Abduction of Philips Corners, Maryland" "The Malign Rite" Notes</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Troy_Young"/>
    <ex:hasPageCountW>312</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>The Meph'hibb'anauth Cycle</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>October 2022</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Sothis_Radiant">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Sothis Radiant</rdfs:label>
    <ex:hasAnnotation>A long-sealed observatory at miskatonic university holds the key to detecting a cosmic threat . It's the first story in which murray refers to the organization as a "section" rather than a "taskforce" characters include a former cees operative and a miskatonic dean .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Will_Murray"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Cryptic_Events_Evaluation_Section"/>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Miskatonic_University"/>
    <ex:wasPublishedOnW>November 1996</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Edgar_Allan_Poe">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsInspirationsAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Edgar Allan Poe</rdfs:label>
    <ex:diedOnR>1849 October 7</ex:diedOnR>
    <ex:hasAnnotation>Poe was the first well-known american writer to earn a living through writing alone . He is generally considered the inventor of the detective fiction genre . Lovecraft was famously inspired by poe's morbid literature .</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#Boston http://example.org/lovecraft#Massachusetts U.S.A.</ex:hasBirthplaceR>
    <ex:hasNationalityR>American</ex:hasNationalityR>
    <ex:isKnownForR>The Raven Annabel Lee The Narrative of Arthur Gordon Pym of Nantucket The Tell-tale Heart The Black Cat The Fall of the House of Usher The Murders in the Rue Morgue The Masque of the Red Death</ex:isKnownForR>
    <ex:wasBornOnR>1809 January 19</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Harry_Stubbs_%28series%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#StoryCycles"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Harry Stubbs (series)</rdfs:label>
    <ex:hasAnnotation>Harry is an ex-boxer and world war one veteran who is always struggling to stay afloat when he takes a job that results in him uncovering the secret nature of the universe . The series is focused more on the occultism surrounding the stories rather than the actual monsters .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#David_Hambling"/>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2018-2024</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Worlds_of_H._P._Lovecraft:_The_Music_of_Erich_Zann">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Worlds of H. P. Lovecraft: The Music of Erich Zann</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft (original story) Steven Philip Jones (adaptation) Aldin Baroza Cover Artist Aldin Baroza United States English The Worlds of H. P. Lovecraft Genre(s) Weird fiction Caliber Comics Release Date 1993 51 Preceded by The Worlds of H. P. Lovecraft: Dagon Followed by The Worlds of H. P. Lovecraft: The Picture in the House is a comic book adaptation of the Howard Phillips Lovecraft short story of the same name . Overview Adapted for the comic book format by Steven Philip Jones and featuring artwork by Aldin Baroza, The Music of Erich Zann was first published by Caliber Comics in 1993 as part of their Worlds of H. P. Lovecraft . It runs to a total of 51 and features a full-colour cover with black-and-white interior. Caliber later rereleased the story in H. P. Lovecraft's Worlds: Volume 2 , which included the complete first run of the . Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Steven_Philip_Jones"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:hasPageCountW>51</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>The Worlds of H. P. Lovecraft</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>1993</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Drawing_No._8">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Drawing No. 8</rdfs:label>
    <ex:hasAnnotation>" gathering forces" is a short story by american author jeffrey thomas . It was first published in the collection haunted worlds by hippocampus press in august 2017 . It describes an alien cult's efforts to summon an avatar of malevolent extra-dimensional god ugghiutu .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Jeffrey_Thomas"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Punktown"/>
    <ex:isPublishedAsW>Haunted Worlds</ex:isPublishedAsW>
    <ex:wasPublishedOnW>August 2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Thomas_Ligotti">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Thomas Ligotti</rdfs:label>
    <ex:hasAnnotation>Ligotti is a sufferer from chronic anxiety as well as the condition known as anhedonia, a reduced or absent ability to experience pleasure . His writing has been predominantly in the of weird horror fiction influenced by gothic horror . His influences in the horror include ambrose bierce , arthur machen , h. p. lovecraft and edgar allan poe .</ex:hasAnnotation>
    <ex:hasBirthplaceR>United States Michigan Detroit</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasYearsActiveR>1981-present</ex:hasYearsActiveR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Games designer</ex:isConnectedToMythosR>
    <ex:wasBornOnR>9 July 1953</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Black_Buddha">
    <rdf:type rdf:resource="http://example.org/lovecraft#Avatars"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Black Buddha</rdfs:label>
    <ex:hasAffiliationC>Venerated in the East by the Brotherhood of the Black Lotus</ex:hasAffiliationC>
    <ex:hasAnnotation>The is an avatar of nyarlathotep who manifests in the east . He is worshiped by a group of heretical buddhists, the brotherhood of the black lotus . He appears in persona 2: eternal punishment .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Xathagorra">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Xathagorra</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Azathoth"/>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Shub-Niggurath"/>
    <ex:hasAlternativeNamesC>The Avenger</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Spawn of Chaos</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The son of the outer god azathoth , has leathery wings, webbed feet, and an unknown number of tentacles. He is purple in colour. May be in the service of the outer god shub-niggurath .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Fleece_of_Yaggar"/>
    <ex:madeFirstAppearanceOnC>The Chaos Spawn</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Fred_C._Adams"/>
  </rdf:Description>
