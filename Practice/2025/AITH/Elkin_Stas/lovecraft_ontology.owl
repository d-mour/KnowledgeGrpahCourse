    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Beware Poorly Chosen Words</rdfs:label>
    <ex:hasAnnotation>Cthulhu mythos story was published in the thematic anthology in 2015 . It was retitled as "to the letter" in the ebook edition .</ex:hasAnnotation>
    <ex:hasAuthorW>Jeffrey Fowler</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
