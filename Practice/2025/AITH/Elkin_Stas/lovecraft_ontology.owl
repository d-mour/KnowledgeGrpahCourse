  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Afraid_of_Dobermans">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Afraid of Dobermans</rdfs:label>
    <ex:hasAnnotation>A man with a fear of doberman dogs hatches a plan to kill his neighbour . Years later, he decides to see what his neighbour has been doing . Only to discover that she is incarcerated in an asylum . Realising that if he had only gone through with his original plan the children would still be alive, his world is shattered .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Chad_Fifer"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Whispers_from_the_Abyss"/>
    <ex:wasPublishedOnW>November 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Watcher_from_the_Sky">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Watcher from the Sky</rdfs:label>
    <ex:hasAnnotation>Abel keane is a divinity student living in boston, who has some experience as a stage hypnotist and has taught himself psychic abilities, including telepathy . One night, he returns to his apartment to find a man clad in strange robes sleeping in his bed . He tries to learn something about the man, who responds mentally by calling keane by name and telling him to be patient . When he attempts to hypnotise phelan,</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Trail_of_Cthulhu"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>July 1945</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kadatheron">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Kadatheron</rdfs:label>
    <ex:hasAnnotation>Mnar city is a city in the land of mnar on the river ai in the dreamlands . It was built by the same wandering tribes that built the cities of thraa , ilarnek , and sarnath . It is a repository of lore written on brick cylinders pertaining to the city of ib and its nonhuman .</ex:hasAnnotation>
    <ex:hasAppearanceL>The Quest of Iranon The Dream-Quest of Unknown Kadath</ex:hasAppearanceL>
    <ex:hasNotableFeatureL rdf:resource="http://example.org/lovecraft#River_Ai"/>
    <ex:hasTypeL>City</ex:hasTypeL>
    <ex:isInhabitedByL>Humans</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Mnar"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Doom_That_Came_to_Sarnath"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Return_to_the_Mountains_of_Madness">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Return to the Mountains of Madness</rdfs:label>
    <ex:hasAnnotation>Historywas first published in the second issue of fanzine e'ch pi e in february 2007 . It also appeared in the collection of cartwright's own work of gods &amp; aliens in october 2011 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ran_Cartwright"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
