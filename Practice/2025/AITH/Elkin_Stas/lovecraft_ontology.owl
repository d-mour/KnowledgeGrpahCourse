    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Chronology Out of Time</rdfs:label>
    <ex:hasAnnotation>Dates in the Fiction of H. P. Lovecraft Peter Cannon United States English Genre(s) Non-fiction Necronomicon Press Release Date 1986 33 : Dates in the Fiction of H. P. Lovecraft is a reference work by American scholar Peter Cannon . Running to a total of 33 , it was published by Necronomicon Press in 1986 ; it is currently out of print. Overview References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Peter_Cannon"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:hasPageCountW>33</ex:hasPageCountW>
