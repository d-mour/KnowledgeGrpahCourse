  <rdf:Description rdf:about="http://example.org/lovecraft#The_Scales_of_Justice">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Scales of Justice</rdfs:label>
    <ex:hasAnnotation>Looking for darla: stories of mythos noir is a short story by american ron shiflet . It was published in his collection looking for darla: stories of mythos noir in september 2008 . Peasley enjoys collecting and stuffing exotic snakes . He receives mysterious notes which contain only the words " return the child "</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Looking_for_Darla:_Stories_of_Mythos_Noir"/>
    <ex:wasPublishedOnW>September 2008</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lamia">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SpeciesIncorporatedFromFolkloreMythAndReligion"/>
    <rdfs:label>Lamia</rdfs:label>
    <ex:hasAnnotation>A is a fantastic creature from greek mythology and later folklore . They are usually depicted as a seductive but often bestial woman . They have occasionally appeared in cthulhu mythos fiction .</ex:hasAnnotation>
    <ex:hasAppearanceC>The Dark Eidolon Averoigne</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Medusas_Coil"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_End_of_the_Story"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Hannes_Bok">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Hannes Bok</rdfs:label>
    <ex:diedOnR>11 April 1964</ex:diedOnR>
    <ex:hasAnnotation>Wayne francis woodard was an american speculative fiction artist and author, most well known for the distinctive style of his illustrations . His pen name is derived from the famous composer johann sebastian bach . Born in kansas city, missouri, bok started contributing art to fanzines in 1932 .</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Kansas City Missouri</ex:hasBirthplaceR>
    <ex:hasFullNameR>Wayne Francis Woodard</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Artist</ex:isConnectedToMythosR>
    <ex:wasBornOnR>2 July 1914</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cathuria">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Cathuria</rdfs:label>
    <ex:hasAccessibilityL>Basalt Pillars of the West (presumed)</ex:hasAccessibilityL>
    <ex:hasAlternativeNamesL>Land of Hope</ex:hasAlternativeNamesL>
    <ex:hasAnnotation>Unknown Also known as Land of Hope Country Ruling Powers King Dorieb Basalt Pillars of the West (presumed) Notable Features River Narg Humans (presumed) First appearance HPL : " The White Ship " Created by H. P. Lovecraft , the Land of Hope , is a fictional country created by the late American author Howard Phillips Lovecraft for his 1919 short story " The White Ship ". Overview A fabled land of otherworldly beauty that is thought to exist by many of those who live in the Dreamlands , is regarded as a legend and is said to lie beyond the Basalt Pillars of the West . Basil Elton sailed beyond the pillars aboard the White Ship in his search for but never found it. ( HPL : " The White Ship ")</ex:hasAnnotation>
    <ex:hasNotableFeatureL rdf:resource="http://example.org/lovecraft#River_Narg"/>
    <ex:hasTypeL>Country</ex:hasTypeL>
    <ex:isInhabitedByL>Humans (presumed)</ex:isInhabitedByL>
    <ex:isLocatedAtL>Unknown</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_White_Ship"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Audrey_Driscoll">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Audrey Driscoll</rdfs:label>
    <ex:hasAnnotation>Audrey driscoll has written several novels centered on the character of herbert west from h.p. Lovecraft 's herbert west--re-animator . Her first novel, the friendship of mortals, retells the story of west at miskatonic university, focusing on his relationship with his assistant . Books two and three, islands in the gulf: the journey and islands in the gulf: the treasure, take west to bellefleur island, on the west coast of north</ex:hasAnnotation>
    <ex:hasNationalityR>Canadian</ex:hasNationalityR>
    <ex:hasWebsiteR>https://audreydriscoll.com/</ex:hasWebsiteR>
    <ex:hasYearsActiveR>2014-</ex:hasYearsActiveR>
    <ex:isConnectedToMythosR>Writer</ex:isConnectedToMythosR>
    <ex:isKnownForR>Herbert West Series</ex:isKnownForR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Starry_Wisdom_Library">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Starry Wisdom Library</rdfs:label>
    <ex:hasAnnotation>The catalogue of the greatest occult book auction of all time is a thematic anthology of lovecraftian fiction from independent ps publishing . Running to a total of 176 books, it was edited by nate pedersen and released in a hardcover format in december 2014 . Cover art was supplied by andrew leman , with interior pieces from liv rainey-smith .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>176</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>December 2014</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Sassoon_Files">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Sassoon Files</rdfs:label>
    <ex:hasAnnotation>The call of cthulhu supplement is a supplement for the role-playing game by chaosium . It is compatible with the 7th edition of call of cthulhu and gumshoe role-playing games . The book is set in 1920's shanghai and focuses on victor sassoon and the factions that competed for influence and power during that period . In march 2019, it was reported by the that all physical run copies of the supplement had been destroyed by the chinese government</ex:hasAnnotation>
    <ex:hasAuthorW>Dan Bass</ex:hasAuthorW>
    <ex:hasAuthorW>Francis Acquarone</ex:hasAuthorW>
    <ex:hasAuthorW>George Sibly</ex:hasAuthorW>
    <ex:hasAuthorW>Jason Sheets</ex:hasAuthorW>
    <ex:hasAuthorW>Jesse Covner</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Masks_of_Nyarlathotep">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Masks of Nyarlathotep</rdfs:label>
    <ex:hasAnnotation>The 1984 horror adventure : perilous adventures to thwart the dark god is an expansion for chaosium’s seminal roleplaying game call of cthulhu . It was written by larry ditillio and lynn willis . Originally consisting of five scenarios, a sixth which had been cut from the first release was later added back in . In 2018 an all-new seventh scenario was included with a special edition set . The locations visited are new york, london, cairo,</ex:hasAnnotation>
    <ex:wasPublishedOnW>1984</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#W._H._Pugmire">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>W. H. Pugmire</rdfs:label>
    <ex:diedOnR>26 March 2019</ex:diedOnR>
    <ex:hasAnnotation>Wilum hopfrog pugmire was an american author and poet . Specialised in the horror and weird fiction genres . In march 2019, pugmire died at home from heart problems .</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Washington Seattle</ex:hasBirthplaceR>
    <ex:hasFullNameR>Wilum Hopfrog Pugmire</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>http://sesqua.net/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>3 May 1951</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Caleb_Cleveland">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Caleb Cleveland</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Artist United States https://calebisdrawing.com/illustration is an American artist and teacher who has provided artwork for Chaosium 's seminal horror roleplaying game Call of Cthulhu . Selected Works Cover Art Atomic-Age Cthulhu (2013) Secrets of Tibet (2013) A Time to Harvest (2021) Interior Art A Time to Harvest (2021)</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://calebisdrawing.com/illustration</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Artist</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Graham_McNeill">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Graham McNeill</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Birth Date 15 August 1971 Glasgow, Scotland British Sci-Fi Adventure Horror Mystery is a British author and games designer who has written several works set in the greater Cthulhu Mythos , including a trilogy of tie-in novels for Fantasy Flight Games ' Arkham Horror property. Career A former architect, McNeill later joined the Games Design Team for British wargames manufacturer Games Workshop , before becoming a writer for their publishing division The Black Library. His primary connection to this wiki is his Dark Waters novel trilogy, which he wrote for Fantasy Flight Games as part of their Arkham Horror Fiction line of Mythos -related literature. Selected Bibliography The Dark Waters Trilogy Ghouls of the Miskatonic Bones of the Yopasi Dweller in the Deep External Links at Wikipedia at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>Glasgow Scotland</ex:hasBirthplaceR>
    <ex:hasNationalityR>British</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>15 August 1971</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Annihilation_Score">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Annihilation Score</rdfs:label>
    <ex:hasAnnotation>The book is the first in the not to have bob howard as its narrator/protagonist . Instead, the story is told by mo's estranged wife, dominique "mo" o'brien . The book is set in 2013 after the events of the rhesus chart .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Charles_Stross"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasGenreW>spy thriller</ex:hasGenreW>
    <ex:hasGenreW>superhero</ex:hasGenreW>
    <ex:hasPageCountW>401</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Laundry_Files"/>
    <ex:wasReleasedOnW>July 2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecraftian_Proceedings">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Periodicals"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraftian Proceedings</rdfs:label>
    <ex:hasAnnotation>English Hippocampus Press Bi-annual 2013 is a non-fiction periodical published by Hippocampus Press . Overview From the 's website: A bi-annual publication containing essays from contemporary scholars on the works of Howard Phillips Lovecraft, these articles are compiled from presentations given at the Lovecraft-focussed convention NecronomiCon Providence (also bi-annual).</ex:hasAnnotation>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Labyrinth_%28Hellraiser%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Dimensions"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsOriginatingFromMythosInspiredWorks"/>
    <rdfs:label>The Labyrinth (Hellraiser)</rdfs:label>
    <ex:hasAnnotation>The labyrinth is a vast, complex maze filled with countless rooms and passageways . At its core lies leviathan, the entity controlling the cenobites and their god, leviathan . While sometimes called hell, its exact nature and relation to traditional religious concepts remain uncertain .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#wasBornOnR">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>wasBornOnR</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Cackle_of_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Cackle of Cthulhu</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Dave Seeley English Baen Release Date January 2018 265 is an anthology of humorous Lovecraftian fiction. Edited by Alex Shvartsman , who also contributed one of the stories, it was published by Baen in January 2018. Overview Contents Foreword by Alex Shvartsman "The Shunned Trailer" by Esther Friesner "The Captain in Yellow" by David Vaughan "My Little Old One™" by Jody Lynn Nye "Tales of a Fourth Grade Shoggoth" by Kevin Wetmore "Friday Night at Brazee's" by Mike Resnick "To Whatever" by Shaenon K. Garrity "The Doom That Came to Providence" by Brian Trent "Explaining Cthulhu to Grandma" by Alex Shvartsman "The Call of the Pancake Factory" by Ken Liu "The Innsmouth of the South" by Rachael K. Jones "WWRD" by Yvonne Navarro "In the Employee Manual of Madness" by G. Scott Huggins " Shoggoth's Old Peculiar " by Neil Gaiman "H.P. and Me" by Gini Koch "The Greatest Leader" by Aidan Doyle "But Someone's Got to Do It" by Konstantine Paradias "Call of the Uncopyrighted Intellectual Property" by Amanda Helms "Cthulhu, P.I." by Laura Resnick "A Stiff Bargain" by Matt Mikalatos "The Shadow Over My Dorm Room" by Laura Pearlman "The Tingling Madness" by Lucy A. Snyder "The Girl Who Loved Cthulhu" by Nick Mamatas</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>265</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>January 2018</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#KagNaru">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Kag'Naru</rdfs:label>
    <ex:hasAlternativeNamesC>Kag'Naru of the Air</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as of the Air Relatives M'nagalah (brother) Rh'Thulla (brother) First appearance ADJ : Challengers of the Unknown #83 Created by Gerry Conway is a fictional deity created by DC Comics for their comic series Challengers of the Unknown . Background is the sister of M'nagalah , who was shut off from the cosmos by the Golden Ones. was enlisted to corrupt the minds of men so that she and her kind could rule the universe again.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Challengers of the Unknown #83</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Gerry Conway</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#How_the_Gods_Bargain">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>How the Gods Bargain</rdfs:label>
    <ex:hasAnnotation>The madness of cthulhu was first published in the anthology the madness of cthulhu by titan books in october 2014 . A senior miskatonic university researcher whose name is given only as jerry relates the tale of how he lost his childhood girlfriend to genius freshman harley james . After a time exploring, jerry kills harley in a jealous rage; shortly afterwards, the building disappears .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Browning_Spencer"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Madness_of_Cthulhu"/>
    <ex:wasPublishedOnW>October 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_House_in_the_Woods">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The House in the Woods</rdfs:label>
    <ex:hasAnnotation>A reporter is on the run from a horror which he cannot remember . Picking up a young female hitchhiker on the road, he unwittingly travels back to the location of his prior trauma . As his memory begins to return, he realises that he has been tricked .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ran_Cartwright"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>December 1997</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Boston">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Boston</rdfs:label>
    <ex:hasAnnotation>The city was founded in 1630 by puritans who named it for their hometown in england . It played a central part in the american revolution, the massacre, the tea party and the battle of bunker hill . Lovecraft went to with donald wandrei in 1927, with samuel loveman in 1929, and with w. paul cook in 1931 .</ex:hasAnnotation>
    <ex:hasTypeL>City</ex:hasTypeL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Massachusetts"/>
    <ex:isLocatedAtL>USA</ex:isLocatedAtL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Chaosium">
    <rdf:type rdf:resource="http://example.org/lovecraft#Publishers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Chaosium</rdfs:label>
    <ex:hasAnnotation>Fiction is a publisher of tabletop role-playing games established by greg stafford in 1975 . Its first game was a wargame called white bear and red moon , which was later reworked to become dragon pass . Is the publisher of call of cthulhu , based on the stories of h.p. Lovecraft .</ex:hasAnnotation>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Character"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Work"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Call_of_Cthulhu,_End_Time">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Call of Cthulhu, End Time</rdfs:label>
    <ex:hasAnnotation>End time is a horror fiction role-playing game based on the cthulhu mythos . The game takes place in the world of the cthulhu mythos, though in the mid 22nd century . The game is published by chaosium and was released in 2001 .</ex:hasAnnotation>
    <ex:hasAuthorW>Dr. Michael C LaBossiere</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>Role-play</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Altuan">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Altuan</rdfs:label>
    <ex:hasAlternativeNamesL rdf:resource="http://example.org/lovecraft#Altuas"/>
    <ex:hasAlternativeNamesL rdf:resource="http://example.org/lovecraft#Shuggon"/>
    <ex:hasAlternativeNamesL>Altorn</ex:hasAlternativeNamesL>
    <ex:hasAnnotation>Altorn is an ancient island-continent created by american author james ambuehl as the primary setting for his lu-kthu cthulhu mythos story cycle . It was first referenced in the 1997 short story " the stalker in the snows " .</ex:hasAnnotation>
    <ex:hasTypeL>Island-continent</ex:hasTypeL>
    <ex:isInhabitedByL>Serpent People</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Earth"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Stalker_in_the_Snows"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#High_Seas_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>High Seas Cthulhu</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Steven Gilberts English Elder Signs Press Release Date September 2007 332 is an anthology of Lovecraftian fiction edited by William Jones and published through his Elder Signs Press label in September 2007. It ran to a total of 332 , was released in a paperback format, and featured cover art by prolific Mythos illustrator Steven Gilberts. Overview Contents "The Idol in His Hand" by Darrell Schweitzer "The Tip of the Iceberg" by John Shire "Passage to Oblivion" by Lee Clark Zumpe "Dark Blue" by Alan Dean Foster "The Isle of Dreams" by Charles P. Zaglanis "Ensnared" by Paul Melniczek "A Kind of Fear" by C. J. Henderson "La Armada Invencible" by Michael McBride "The Others" by Stewart Sternberg "Signals" by Stephen Mark Rainey "The Havenhome" by William Meikle "The Bedlamite" by Ferrel Moore "The Star of Istanbul" by Chris Donahue and Linda L. Donahue "High Seas" by Michael Penncavage "Those Who Came to Dagon" by John Shirley "Clown Fish" by Matthew Baugh "Ice" by Heather Hatch "The Wreck of the Ghost" by Tim Curran "The Stars, in Their Dreaming" by Gerard Houarner "Depth of Darkness" by William Jones</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>332</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>September 2007</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Coma_Berenices">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Stars"/>
    <rdfs:label>Coma Berenices</rdfs:label>
    <ex:hasAnnotation>Northern sky Constellation HPL : " Polaris " is a constellation in the northern sky, translated from the Latin as "Berenice's Hair". It was named after Queen Berenice II of Egypt who sacrificed her long hair as a votive offering. is mentioned in the short story " Polaris " by H. P. Lovecraft , where the unnamed narrator observes the constellation as it "shimmers weirdly far off in the mysterious east."</ex:hasAnnotation>
    <ex:hasAppearanceL rdf:resource="http://example.org/lovecraft#Polaris"/>
    <ex:hasTypeL>Constellation</ex:hasTypeL>
    <ex:isLocatedAtL>Northern sky</ex:isLocatedAtL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Alien_Intelligence">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Alien Intelligence</rdfs:label>
    <ex:hasAnnotation>Eldritch extra-dimensional beings from the fictional universe of the rifts pencil-and-paper roleplaying game by palladium . Which are theorized as being related in one form or another to the old ones . Which can possess sentient beings, creating monstrous or beautiful avatars which are as powerful as demigods .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Rifts"/>
    <ex:wasCreatedByC>Palladium Games</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Parenthesis_on_Lovecraft_as_Poet">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Parenthesis on Lovecraft as Poet</rdfs:label>
    <ex:hasAnnotation>Winfield Townley Scott United States English Genre(s) Non-fiction Ohio University Press H. P. Lovecraft: Four Decades of Criticism date 1980 " A Parenthesis of Lovecraft as Poet " is a short non-fiction piece by the late American writer Winfield Townley Scott . History H. P. Lovecraft: Four Decades of Criticism (1980) Lovecraft Remembered (1998)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Winfield_Townley_Scott"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft:_Four_Decades_of_Criticism"/>
    <ex:wasPublishedOnW>1980</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dweller">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Dweller</rdfs:label>
    <ex:hasAffiliationC>The Quintessons</ex:hasAffiliationC>
    <ex:hasAnnotation>The is a mechanical eldritch entity from the fictional universe of transformers by hasbro . The was one of the trans-organics, the first lifeforms ever created by the quintessons to be their slaves . When it proved to be far too destructive, it was sealed away in a hibernation chamber below the depths of the planet cybertron .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Dweller in the Depths</ex:madeFirstAppearanceOnC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Silent_Garden">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Silent Garden</rdfs:label>
    <ex:hasAnnotation>Carnacki: the lost cases is a short story by and artist jason c. eeckhardt . It is loosely connected to h.p. Lovecraft 's cthulhu mythos . Carnacki lends his assistance to an elderly woman whose garden has become overrun by a malignant presence .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Jason_C._Eckhardt"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Thomas_Carnacki"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Carnacki:_The_Lost_Cases"/>
    <ex:wasPublishedOnW>June 2016</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crystallizer_of_Dreams">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MysticalArtefacts"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Crystallizer of Dreams</rdfs:label>
    <ex:hasAnnotation>The crystallizers of dreams are fictional artefacts in the cthulhu mythos . They are described as being able to transport the consciousness of a person to another dimension . The dreamers can even interact with that world, bring back items to his or her own world, or even be killed in the dreams . The crystallizers require no magical source and automatically act on the closest person sleeping near them .</ex:hasAnnotation>
    <ex:hasFunctionA>Consciousness Projection</ex:hasFunctionA>
    <ex:hasTypeA>Data Storage</ex:hasTypeA>
    <ex:hasTypeA>Transmission</ex:hasTypeA>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_Render_of_the_Veils"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhus_Daughter">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu's Daughter</rdfs:label>
    <ex:hasAnnotation>History is a short mythos story by american rhiannon frater . It was published in the collection of frater's own works and other horror tales in november 2012 . Characters lulu , a young woman with a very singular heritage.</ex:hasAnnotation>
    <ex:hasAuthorW>Rhiannon Frater</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Other Horror Tales</ex:isPublishedAsW>
    <ex:wasPublishedOnW>November 2012</ex:wasPublishedOnW>
  </rdf:Description>
