    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Experiment … in Death</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft (original story) Bill Gaines &amp; Al Feldstein (adaptation) English Genre(s) Horror Weird Science Media type Comic Book date May 1950 " " is the third story featured in Weird Science #12 by EC Comics. It is an adaptation of H. P. Lovecraft ’s short story " Herbert West--Reanimator ".</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasAuthorW>Al Feldstein</ex:hasAuthorW>
