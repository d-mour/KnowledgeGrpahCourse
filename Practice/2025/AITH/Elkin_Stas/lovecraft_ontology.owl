    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Horror in the Burying-Ground</rdfs:label>
    <ex:hasAnnotation>Full story online here Howard Phillips Lovecraft and Hazel Heald United States English Cthulhu Mythos Genre(s) Horror short story Weird Tales ← Previous Next → " The Evil Clergyman " " The Hoard of the Wizard-Beast " 𝐓</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Hazel_Heald"/>
