    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Phocean</rdfs:label>
    <ex:hasAlternativeNamesC>Walking-Sticks</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Sociocultural Characteristics Also known as Walking-Sticks Phocea Physical Characteristics Average height 2.1 meters Real World Information First appearance Master of the Asteroid Created by Clark Ashton Smith Phoceans are a species of short-lived insectile aliens from the planetoid Phocea .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Master of the Asteroid</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
