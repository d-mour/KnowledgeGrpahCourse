  <rdf:Description rdf:about="http://example.org/lovecraft#Sheldon_Jaffery">
    <rdf:type rdf:resource="http://example.org/lovecraft#Critics"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Scholars"/>
    <rdfs:label>Sheldon Jaffery</rdfs:label>
    <ex:diedOnR>10 July 2003</ex:diedOnR>
    <ex:hasAnnotation>Full Name Sheldon Ronald Jaffery Connection to the Mythos Subject Bibliographer Birth Date 22 April 1934 Death Date 10 July 2003 United States Non-Fiction Sheldon Ronald Jaffery (22 April 1934-10 July 2003) was an American subject bibliographer, editor and scholar, as well as a qualified attorney. He wrote several non-fiction works on such topics as the publication history of Arkham House and a collectors guide to fantasy horror magazine Weird Tales , with the majority of his output relating in some way to pulp fiction periodicals. Selected Bibliography Non-Fiction The Arkham House Companion (1989) External Links at Wikipedia at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasFullNameR>Sheldon Ronald Jaffery</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Subject Bibliographer</ex:isConnectedToMythosR>
    <ex:wasBornOnR>22 April 1934</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ellen_Datlow">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Ellen Datlow</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Editor Birth Date 31 December 1949 New York City, USA United States https://ellendatlow.com/ (born 31 December 1949) is an award-winning American editor specialising in the horror, fantasy and science fiction genres. Amongst her many works are several anthologies of Lovecraftian and Cthulhu Mythos fiction. Selected Works Editor Lovecraft Unbound (2009) Lovecraft's Monsters (2014) External Links at Wikipedia at The Internet Speculative Fiction Database</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA http://example.org/lovecraft#New_York_City</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://ellendatlow.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
    <ex:wasBornOnR>31 December 1949</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhunicorn">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhunicorn</rdfs:label>
    <ex:hasAnnotation>A unicorn comes across the great old one cthulhu sunbathing on the briefly-risen isle of r'lyeh . The two fall in love and are married, having a child which bears the aspects of both parents .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Armand_Rosamilia"/>
    <ex:hasAuthorW>Katelynn Rosamilia</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Children's</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Ancient:_A_Keyport_Cthulhu_Tale"/>
    <ex:wasPublishedOnW>July 2012</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Church_of_All">
    <rdf:type rdf:resource="http://example.org/lovecraft#Cults"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdfs:label>Church of All</rdfs:label>
    <ex:hasAnnotation>The is a fictional organization in the cthulhutech pencil-and-paper roleplaying game by wildfire llc . It is a new age cult which is controlled by the esoteric order of dagon .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Journey_Into_Mystery_Vol_2_5">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Journey Into Mystery Vol 2 5</rdfs:label>
    <ex:hasAnnotation>Journey Into Mystery Vol 2 #5 Robert Bloch (original story) Ron Goulart (adaptation) United States English Marvel Comics Publication date March 27, 1973 Journey Into Mystery Vol 2 #5 is an issue of Marvel Comics ' long-running horror anthology series. It features an adaptation of Robert Bloch 's short story " The Shadow from the Steeple ", written by Ron Goulart and illustrated by Rich Buckler. External Links at the Marvel Database wiki</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_Bloch"/>
    <ex:hasAuthorW>Ron Goulart</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>1973 March 27</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#In_Memoriam:_Robert_Ervin_Howard">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>In Memoriam: Robert Ervin Howard</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft United States English Genre(s) Non-fiction Fantasy Magazine date September 1936 " " is a short non-fiction piece by the late American Howard Phillips Lovecraft , written shortly after his friend's suicide in June 1936. It consists of an overview of Robert E. Howard 's life and career. Poignantly, Lovecraft himself would pass less than a year later. History First published in the September 1936 edition of Fantasy Magazine , it has since been reprinted many times, including in several collections of Howard's works.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Fantasy Magazine</ex:isPublishedAsW>
    <ex:wasPublishedOnW>September 1936</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sweet_Despise">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Sweet Despise</rdfs:label>
    <ex:hasAnnotation>A supernatural killer known as the ghoul tracks down and butchers the immortal members of a cult for an unknown transgression . Confronting the leader of the cult, the ghoul dooms him to an eternity of torment . The events of take place across much of lovecraft country, and namechecks many well-known mythos elements .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Peter_A._Worthy"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Nightscapes #1</ex:isPublishedAsW>
    <ex:wasPublishedOnW>June 1997</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Literary_Composition">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Literary Composition</rdfs:label>
    <ex:hasAnnotation>The united amateur , 19, no. 3 was first published in january 1920 . Offers a brief guide on writing, as well as a series of bullet points on what to do and not to do in various aspects of the craft .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_United_Amateur"/>
    <ex:isPublishedAsW>19</ex:isPublishedAsW>
    <ex:isPublishedAsW>No. 3</ex:isPublishedAsW>
    <ex:wasPublishedOnW>January 1920</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Pale_Night">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Pale Night</rdfs:label>
    <ex:hasAnnotation>The , aka the Mother of Demons , is a Lovecraftian -like demonic entity from the fictional universe of the Dungeons &amp; Dragons pencil-and-paper roleplaying games by Wizards of the Coast. Background The is a member of the Obyrith a demonic race. She has an incorporeal form, appearing as a flowing white shroud that appears to have underneath it the shapely body of a female human. It's true form though is so hideous and terrifying, that its rejected by reality. Glimpse what's underneath the shroud and you risk madness and/or death.</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Hardboiled_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Hardboiled Cthulhu</rdfs:label>
    <ex:hasAnnotation>Various United States English Genre(s) Hardboiled crime Horror Elder Signs Press Release Date 15 July 2006 Media Type Print 332 : Two-Fisted Tales of Tentacled Terror is a thematically-linked anthology of Cthulhu Mythos stories. Overview Combining the grittiness of the hardboiled genre with the fantastical horror of the Cthulhu Mythos, contains a total of 22 stories. It was first published on July 15th 2006 by Elder Signs Press , was edited by James Ambuehl , who also contributed two pieces to the collection, and runs to 332 . Contents "Sleeping with the Fishes" by James Ambuehl "The Pisces Club" by James Ambuehl "A Change of Life" by William Jones "Ache" by David Witteveen "A Dangerous High" by E. P. Berglund "A Little Job in Arkham" by John Sunseri "Day of Iniquity" by Steven L. Shrewsbury "Eldritch-Fellas" by Tim Curran "Outside Looking In" by David Conyers " Pazuzu's Children " by Jeffrey Thomas "The Devil in You" by Eric J. Millar "The Mouth" by William Meikle "The Questioning of the Azathothian Priest" by C. J. Henderson "Some Thoughts on the Problem of Order" by Simon Bucher-Jones "The White Mountains" by Jonathan Sharp "Then Terror Came" by Patrick Thomas "The Prying Investigations of Edwin M. Lillibridge" by Robert M. Price "The Roaches in the Walls" by James Chambers " To Skin a Dead Man " by Cody Goodfellow " Unfinished Business "by Ron Shiflet " review at Tampa Bay Newspapers review at SF Site</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Hardboiled crime Horror</ex:hasGenreW>
    <ex:hasPageCountW>332</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>15 July 2006</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Thing_That_Walked_on_the_Wind">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Thing That Walked on the Wind</rdfs:label>
    <ex:hasAnnotation>The story was first published in strange tales of mystery and terror in 1933 . It has since entered the public domain, and has been reprinted many times . It is notable as featuring the first appearance of the great old one ithaqua .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Strange Tales of Mystery</ex:isPublishedAsW>
    <ex:isPublishedAsW>Terror</ex:isPublishedAsW>
    <ex:wasPublishedOnW>January 1933</ex:wasPublishedOnW>
  </rdf:Description>
