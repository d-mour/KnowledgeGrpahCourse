    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Mother of Toads</rdfs:label>
    <ex:hasAnnotation>The short story was first published in the july 1938 edition of pulp magazine weird tales . It features a toad-like antagonist akin in some respects to a deep one related human .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
