    <ex:isPublishedAsW>E'ch Pi El #2</ex:isPublishedAsW>
    <ex:wasPublishedOnW>February 2007</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Thurber">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Thurber</rdfs:label>
    <ex:hasAnnotation>"pickman's model" is a character created by lovecraft for his short story " pickman's model ", making his first appearance in print in the october 1927 edition of weird tales . Is the narrator of "pickman's model", who gets to know richard upton pickman while working on "a monograph about weird art" describes himself as "fairly 'hard-boiled'", as well as "middle-aged and decently sophisticated"</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Casefile:_Arkham-_Nightmare_on_the_Canvas"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Pickmans_Model"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Whisperer_in_Darkness">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Whisperer in Darkness</rdfs:label>
    <ex:hasAnnotation>"at the mountains of madness" is a horror novella by h.p. Lovecraft . It was first published in weird tales , august 1931 . Lovecraft makes numerous references to the cthulhu mythos .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
