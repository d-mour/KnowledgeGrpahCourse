  <rdf:Description rdf:about="http://example.org/lovecraft#Yaddithian">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Yaddithian</rdfs:label>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#Nug-Soth"/>
    <ex:hasAnnotation>The planet yaddith is home to an intelligent species of clawed, snouted creatures . The wizard zkauba is a member of this species . Although not named in the original story, the call of cthulhu rpg refers to them as yaddithians or denizens of yaddith .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Dreams_in_the_House_of_Weir"/>
    <ex:hasAppearanceC>Pathfinder Roleplaying Game Bestiary 6</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC>Through the Gates Of the Silver Key</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#E._Hoffmann_Price"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Howard_Phillips_Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#hasChild">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>hasChild</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:range rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
