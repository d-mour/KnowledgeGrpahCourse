  <rdf:Description rdf:about="http://example.org/lovecraft#Ursula_Downs">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Ursula Downs</rdfs:label>
    <ex:hasAffiliationC>Boston University</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Explorer</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Ursula is an archaeologist, mountaineer, and linguist . Features in fantasy flight games' range of cthulhu mythos -related games and fiction . First introduced as an investigator character for fantasy flight's second edition of lovecraftian board game arkham horror .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Arkham_Horror:_The_Card_Game"/>
