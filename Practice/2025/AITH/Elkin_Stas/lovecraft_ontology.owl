    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Academic Legacies</rdfs:label>
    <ex:hasAnnotation>Cthulhu mythos appears in time loopers crossroad press 2023is a novelette by c.t. Phipps in the cthulhu mythos genre . It was first published in time loopers in 2023 . Behind the mythosis a loose sequel to " from beyond " and " the shadow out of time "</ex:hasAnnotation>
    <ex:hasAuthorW>C.T. Phipps</ex:hasAuthorW>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
