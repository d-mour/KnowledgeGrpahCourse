    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Arkham Relic Hunt</rdfs:label>
    <ex:hasAnnotation>2020 competitive card game is a call of cthulhu -based card game from squamous studios, produced on licence from chaosium . Players take on the roles of cultists, with different achievements awarding varying levels of points . The player who has accumulated the most points by the end of the</ex:hasAnnotation>
    <ex:wasPublishedOnW>2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Apocolothoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Apocolothoth</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Moon God</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Moon God Current location The Dimension of Enno-Lunn Great Old Ones First appearance EXP : " Demon in the Flesh " Created by Crispin Burnham ( The Moon-God ) is a mysterious lunar entity that dwells in the Dimension of Enno-Lunn . Gallery</ex:hasAnnotation>
    <ex:isLocatedAtC>The Dimension of Enno-Lunn</ex:isLocatedAtC>
    <ex:madeFirstAppearanceOnC>Demon in the Flesh</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Crispin_Burnham"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sarah_Susan_Phillips">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Sarah Susan Phillips</rdfs:label>
    <ex:diedOnR>28 July 1851</ex:diedOnR>
    <ex:hasAnnotation>Lovecraft’s mother and the wife of Winfield Scott Lovecraft, whom she married on 12 June 1889.</ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1827</ex:wasBornOnR>
