  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Twilight_Beckons_%28Call_of_Cthulhu_LCG%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Twilight Beckons (Call of Cthulhu LCG)</rdfs:label>
    <ex:hasAnnotation>The Twilight Beckons Fantasy Flight Games Publication Date 2010 Living Card Game Call of Cthulhu: The Card Game The Twilight Beckons is an expansion pack for Fantasy Flight Games ' Call of Cthulhu: The Card Game . Overview The first Asylum Pack in The Rituals of the Order Cycle series of expansions, The Twilight Beckons is divided into the standard format of three duplicate sets of 20 unique cards for a total of 60, with the cards contained divided between the existing factions. First released in 2010, it was discontinued in 2015 with the demise of Call of Cthulhu: The Card Game . Contents Obsessive Detective (Character; The Agency) Holy Rosary (Support; The Agency) Evidence Locker (Support; The Agency) Bloodthirsty Star Spawn (Character; Cthulhu ) Underneath the Surface (Event; Cthulhu) Gaze of Ghatanothoa (Support; Cthulhu) Demented Phrenologist (Character; Hastur ) Germaphobia (Support; Hastur) Professional Counselor (Character; Miskatonic University ) Experiment Subject #613b (Character; Miskatonic University) Harvesting Mi-Go (Character; Shub-Niggurath ) Inter-dimensional Transporter (Support; Shub-Niggurath) Dr. Baker, Chief of Medicine (Character; Silver Twilight) Zealous Secretary (Character; Silver Twilight) Errand Boy (Character; Silver Twilight) Expulsion from the Order (Event; Silver Twilight) Small Time Magician (Character; Syndicate) Clover Club Bootlegger (Character; Syndicate) Intruder from Beyond (Character; Yog-Sothoth ) Prism of Many Views, Endless Visions (Support; Yog-Sothoth)</ex:hasAnnotation>
    <ex:wasPublishedOnW>2010</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Book_of_Iod">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Book of Iod</rdfs:label>
    <ex:hasAnnotation>The is a fictional book created by henry kuttner . It first appears in kuttner's short story " the bells of horror " (1939) it provided the title for a collection of kuttner's mythos -related fiction .</ex:hasAnnotation>
    <ex:hasAppearanceA rdf:resource="http://example.org/lovecraft#Dead_of_Night"/>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_Bells_of_Horror"/>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#Henry_Kuttner"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mrs._Dakhamunzu">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Mrs. Dakhamunzu</rdfs:label>
    <ex:hasAnnotation>A young man who makes his living by seducing rich old women for their money meets a singularly different mark: a princess of egyptica . She wishes for him to travel back to her realm and raise their unborn child together . Historywas first published in the collection the blasphemy in the canopic jar &amp; more tales of the cthulhu mythos in september 2016 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mark_McLaughlin"/>
    <ex:hasAuthorW>Michael Sheehan. Jr.</ex:hasAuthorW>
    <ex:hasGenreW>Fantasy</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Blasphemy_In_The_Canopic_Jar"/>
    <ex:isPublishedAsW>More Tales Of The Cthulhu</ex:isPublishedAsW>
    <ex:wasPublishedOnW>September 2016</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#October_Surprise">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>October Surprise</rdfs:label>
    <ex:hasAnnotation>A 300,000-year-old man named hawthorne, currently in charge of a covert government agency, uncovers a plot by a secret cabal to destroy a deep one city . Infiltrating the enemy group, hawthorne meets the physicist behind the scheme, one abigail dexter . However, there is more to dexter than meets the eye, and despite hawthorne's best efforts, the plan succeeds</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Kevin_L._OBrien"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Nightscapes"/>
    <ex:wasPublishedOnW>October 2006</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Queen_of_Spades">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Queen of Spades</rdfs:label>
    <ex:hasAnnotation>The is a character in the fictional grimm fairy tales universe, who first appeared in 2010 in tales of wonderland: the white knight . Created by raven gregory, troy brownfield, ralph tedesco, and joe brusha .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Tales from Wonderland: The White Knight</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Joe Brusha</ex:wasCreatedByC>
    <ex:wasCreatedByC>Ralph Tedesco</ex:wasCreatedByC>
    <ex:wasCreatedByC>Raven Gregory</ex:wasCreatedByC>
    <ex:wasCreatedByC>Troy Brownfield</ex:wasCreatedByC>
  </rdf:Description>
