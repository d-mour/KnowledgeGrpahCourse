    <ex:wasBornOnR>1803</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#H._P._Lovecrafts_Worlds:_Volume_1">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>H. P. Lovecraft's Worlds: Volume 1</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft (original story) Steven Philip Jones (adaptations) Octavio Cariello United States English The Worlds of H. P. Lovecraft Genre(s) Weird fiction Caliber Comics 112 is a collection of comic book adaptations of the works of H. P. Lovecraft . Overview Running to a total of 112 with a full-colour cover and black-and-white interiors, was released in softcover format by independent comic book Caliber Comics . It contains the complete Worlds of H. P. Lovecraft published under their Tome Press imprint, all written by Steven Philip Jones with artwork from Octavio Cariello . Contents contains the following adaptations: " The Lurking Fear " " Beyond the Wall of Sleep " " The Tomb " " The Alchemist " Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Steven_Philip_Jones"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:hasPageCountW>112</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>The Worlds of H. P. Lovecraft</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Avatars_of_the_Old_Ones">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Avatars of the Old Ones</rdfs:label>
    <ex:hasAnnotation>The young of the old ones is the second in a short series set in a futuristic punktown setting . It was first published in the chapbook avatars of the old ones by imelod in 1999 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Jeffrey_Thomas"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Avatars_of_the_Old_Ones"/>
    <ex:wasPublishedOnW>1999</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#I,_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>I, Cthulhu</rdfs:label>
    <ex:hasAnnotation>", or, what's a tentacle-faced thing like me doing in a sunken city like this?" Is a short story by neil gaiman . It purports to be the autobiography of cthulhu , dictated to a lackey named whateley . He reveals that he was born in "the dark mists of khhaa'yngnaih", an extradimensional world of swamps and towers .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Neil_Gaiman"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:wasPublishedOnW>1987</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Summanus">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Summanus</rdfs:label>
    <ex:hasAlternativeNamesC>Lord of Hell</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Monarch of Night</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Terror that Walketh in Darkness</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Based on the roman deity of the same name mentioned in the poet ovid's fasti . Incorporated into the greater cthulhu mythos by chaosium when they included it in the sourcebook for their call of cthulhu ( exp ) roleplaying game .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Malleus_Monstrorum"/>
    <ex:madeFirstAppearanceOnC>What Dark God</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Outer_God">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OuterGods"/>
    <rdfs:label>Outer God</rdfs:label>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#Court_of_Azathoth"/>
    <ex:hasAlternativeNamesC>Blind Ape of Truth</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Elder Myth</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>God of Dark Tapestry</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Other God ( HPL )</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Reality's Ultimate God</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Ultimate God ( HPL )</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Outer gods are a category of fictional entities of cosmic significance used in certain systemisations of the cthulhu mythos . They are located beyond the confines of earth and the solar system, exerting their influence from deep space or from beyond our dimension . The term "outer gods" does not appear in lovecraft's works, but was popularized by the role-playing game call of cthulhu .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Dream-Quest_of_Unknown_Kadath"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Other_Gods"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Nyarlathotep"/>
    <ex:wasCreatedByC>H. P. Lovecraft et al</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ilek-Vad">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Ilek-Vad</rdfs:label>
    <ex:hasAccessibilityL>Via the Dreamlands</ex:hasAccessibilityL>
    <ex:hasAnnotation>The city-state of is further than the moon and it floats in the aether . It is possible to access the city state by the cerenarian sea through tunnels .</ex:hasAnnotation>
    <ex:hasAppearanceL rdf:resource="http://example.org/lovecraft#Through_the_Gates_of_the_Silver_Key"/>
    <ex:isLocatedAtL>The Dreamlands</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Dream-Quest_of_Unknown_Kadath"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Silver_Key"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Rising_%28Heather_Graham%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Rising (Heather Graham)</rdfs:label>
    <ex:hasAnnotation>Cthulhu rising is a short story by american author heather graham . It was published in the anthology the madness of cthulhu: volume 1 by titan books . Rumours that the liner is haunted prompt owners to employ two groups to stay aboard the ship during her final voyage . The two groups fall for a ruse by the ship's owners, believing the crew have vanished along with several of their own number .</ex:hasAnnotation>
    <ex:hasAuthorW>Heather Graham</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>The Madness of Cthulhu: Volume 1</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Black_Helicopters">
    <rdf:type rdf:resource="http://example.org/lovecraft#CaitlinRKiernanWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Black Helicopters</rdfs:label>
    <ex:hasAnnotation>The story involves the conflicts among secret agencies in the occult world . It was first published as a chapbook in 2013, then released in a considerably expanded form . It may be considered either the first or second book in the tinfoil dossier trilogy .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
    <ex:hasPageCountW>206</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Tinfoil_Dossier"/>
    <ex:wasReleasedOnW>2018 May 1</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Alchemist%E2%80%99s_Daughter_%28A_Fragment%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#CaitlinRKiernanWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Alchemist’s Daughter (A Fragment)</rdfs:label>
    <ex:hasAnnotation>The Alchemist’s Daughter (A Fragment) Caitlin R. Kiernan Genre(s) Dreamlands Sirenia Digest date June 2009 "The Alchemist’s Daughter (A Fragment)" is a short story by Caitlin R. Kiernan that first appeared in the June 2009 issue of Sirenia Digest (#43). Synopsis Set in H. P. Lovecraft 's Dreamlands , it tells the story of Sala, alchemist of Ulthar , her relationship with her assistant Anissa, and her obsession with a dragon's egg. History The story's first print appearance was in Kiernan's collection Houses Under the Sea: Mythos Tales ( Subterranean Press , 2019).</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
    <ex:hasGenreW rdf:resource="http://example.org/lovecraft#Dreamlands"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Sirenia_Digest"/>
    <ex:wasPublishedOnW>June 2009</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mermaid">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ServitorRaces"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SpeciesIncorporatedFromFolkloreMythAndReligion"/>
    <rdfs:label>Mermaid</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Cthulhu"/>
    <ex:hasAnnotation>Sociocultural Characteristics The Dreamlands Marine Cthulhu Real World Information First appearance EXP : H. P. Lovecraft's Dreamlands Mermaids are a mythical species of aquatic beings with the head, arms and torso of a woman and the tail of a fish. In the Mythos Dr. Makoto Yamada believes that stories about Mermaids were inspired by the Sea-dwellers , as he likens their ability to swap minds with humans to traditional tales of Mermaids stealing the souls of men with their kisses. ( CIRCLE : " The Black Kiss ") Female Deep Ones have also been mistaken for Mermaids. ( AWD : " The Seal of R'lyeh ") In H. P. Lovecraft's Dreamlands , the Merfolk are hybrid creatures, the result of Deep Ones who found their way into the Dreamlands and mated with the native Gnorri . Like the Deep Ones themselves, the Merfolk are servants of Cthulhu .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#H._P._Lovecrafts_Dreamlands"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Disciples_of_Cthulhu_II">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Disciples of Cthulhu II</rdfs:label>
    <ex:hasAnnotation>Edward P. Berglund , editor Cover Artist Harry Fassl English Genre(s) Cthulhu Mythos Chaosium Release Date February 2003 219 : Blasphemous Tales of the Followers is a Cthulhu Mythos anthology edited by Edward P. Berglund and published by Chaosium in 2003. It serves as a sequel to Berglund's Disciples of Cthulhu (1976, DAW Books). The stories are original to the volume except for Scott David Aniolowski 's "The Idol," originally published in Tales Out of Innsmouth (Chaosium, 1999). Contents "Editor's Preface" by Edward P. Berglund "The Bookseller's Second Wife" by Walter C. DeBill, Jr. "Eldritch" by Brad Linaweaver and Fred Olen Ray "The Web" by Gary Myers "Passing Through" by Robert Weinberg "The Idol" by Scott David Aniolowski "Time in the Hourless House" by A. A. Attanasio "Special Order" by John Henry Campbell, Terry Lee Sanders and Henry Lee Forrest "Lujan's Trunk" by Donald R. Burleson "The San Francisco Treat" by C. J. Henderson "Acute Spiritual Fear" by Robert M. Price " The Eldridge Collection " by Will Murray "An Arkham Home Companion" by Brad Strickland "The Last Temptation of Ricky Perez" by Benjamin Adams</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Edward_P._Berglund"/>
    <ex:hasAuthorW>editor</ex:hasAuthorW>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasPageCountW>219</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>February 2003</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecrafts_Sensitivity">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraft's Sensitivity</rdfs:label>
    <ex:hasAnnotation>August Derleth United States English Genre(s) Non-fiction Arkham House Something About Cats and Other Pieces date 1949 " " is a short non-fiction piece by Howard Phillips Lovecraft 's friend, contemporary, and literary champion August Derleth. It was first published in the Arkham House collection Something About Cats and Other Pieces in 1949. History Something About Cats and Other Pieces (1949) Lovecraft Remembered (1998)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Something_About_Cats"/>
    <ex:isPublishedAsW>Other Pieces</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1949</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Stya-YgNalle">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>S'tya-Yg'Nalle</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Ithaqua"/>
    <ex:hasAlternativeNamesC>The Whiteness</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Whiteness Current location Likely in Ithaqua's domain Ithaqua First appearance " Whiteout " Created by Brian Lumley is an invisible being that can take form through snow and chill. He is a servant of the Great Old One Ithaqua .</ex:hasAnnotation>
    <ex:isLocatedAtC>Likely in Ithaqua's domain</ex:isLocatedAtC>
    <ex:madeFirstAppearanceOnC>Whiteout</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Brian_Barr">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Brian Barr</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author United States is an American author who has written several stories which take place in both the Cthulhu Mythos and the Yellow Mythos, settings intimately connected by virtue of their cosmic horror elements and the Great Old One Hastur . Amongst other publications, his work has appeared in Within Stranger Aeons: Lovecraft's Mythos in the 21st Century (2016). Selected Bibliography Short Stories " A Visage of Great Truths " " The Sacred House " " Venusian Hell " " Aldebaran Apocalypse " Collections 's King in Yellow (2019) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Horror_in_the_Burying-Ground">
