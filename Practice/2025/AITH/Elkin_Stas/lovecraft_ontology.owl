  <rdf:Description rdf:about="http://example.org/lovecraft#The_Monster-God_of_Mamurth">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Monster-God of Mamurth</rdfs:label>
    <ex:hasAnnotation>Full story online here Edmond Hamilton English (original) French German Italian Weird Tales date August 1926 𝐓 " " is a short story by the late American Edmond Hamilton , his first published fiction. It was featured in the August 1926 edition of pulp magazine Weird Tales and has been reprinted numerous times, as well as being translated into French, German, and Italian . The story is now in the public domain in the United States . Synopsis TBA Behind the Mythos Kenneth Sterling , who wrote the original draft of the science fiction short story " In the Walls of Eryx " before presenting his work to H. P. Lovecraft for revision, credits the concept of an invisible maze to "," although in Hamilton's story the maze exists in the Saharan Desert rather than on the surface of Venus . References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Edmond_Hamilton"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:isInLanguageW>Italian</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>August 1926</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yabou">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Yabou</rdfs:label>
    <ex:hasAnnotation>Relatives Tsathoggua (parent) Nush the Eternal (offspring) Clark Ashton Smith (distant descendant) First appearance HPL : " Selected Letters of H. P. Lovecraft " 4.617 Created by Howard Phillips Lovecraft is a mysterious entity only mentioned in H .P. Lovecraft 's letter to James F. Morton as a descendant of Tsathoggua , which in turn spawned another mysterious being entitled Nush the Eternal .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Selected Letters of H. P. Lovecraft 4.617</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crypt_of_Cthulhu_Lammas_1982">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crypt of Cthulhu Lammas 1982</rdfs:label>
    <ex:hasAnnotation>Crypt of cthulhu was the seventh issue of the long-running fanzine . Edited by price, who also supplied the cover art, ran to a total of 44 in an a5 format . Self-published in august 1982, it included interior art by price and rick bryant .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>44</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu"/>
