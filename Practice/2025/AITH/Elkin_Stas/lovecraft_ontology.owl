  <rdf:Description rdf:about="http://example.org/lovecraft#The_Worlds_of_H._P._Lovecraft:_The_Picture_in_the_House">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Worlds of H. P. Lovecraft: The Picture in the House</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft (original story) Steven Philip Jones (adaptation) Rob Davis United States English The Worlds of H. P. Lovecraft Genre(s) Weird fiction Caliber Comics Release Date 1993 32 Preceded by The Worlds of H. P. Lovecraft: The Music of Erich Zann Followed by The Worlds of H. P. Lovecraft: The Statement of Randolph Carter is a comic book format adaptation of the Howard Phillips Lovecraft short story of the same name . Overview Adapted for the comic book format by Steven Philip Jones and featuring artwork by Rob Davis, The Picture in the House was published by Caliber Comics in 1993. Running to a total of 32 , it features a full-colour cover with black-and-white interiors. Caliber later reissued the story in H. P. Lovecraft's Worlds: Volume 2 , an omnibus which included the complete first run of The Worlds of H. P. Lovecraft . Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Steven_Philip_Jones"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:hasPageCountW>32</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>The Worlds of H. P. Lovecraft</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>1993</ex:wasReleasedOnW>
  </rdf:Description>
