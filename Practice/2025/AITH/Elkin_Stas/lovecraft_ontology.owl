  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Four_OClock">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Four O'Clock</rdfs:label>
    <ex:hasAnnotation>Based on an idea suggested to her by . H. p. lovecraft . Written in 1922, it was published for the first time in the 1949 arkham house collection . Something about cats and other pieces was later reprinted .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Sonia_H._Greene"/>
