  <rdf:Description rdf:about="http://example.org/lovecraft#The_Novel_of_the_Black_Seal">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Novel of the Black Seal</rdfs:label>
    <ex:hasAnnotation>The three imposters; or, the transmutations is a horror story by arthur machen . Central elements from are echoed in lovecraft stories like " the call of cthulhu ", " the dunwich horror ", " the whisperer in darkness ", and " the lurking fear ". Central elements fromare echoed in lovecraft's " the whisperer in darkness " and howard's " people of the dark "</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Arthur_Machen"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>The Three Imposters</ex:isPublishedAsW>
    <ex:isPublishedAsW>The Transmutations</ex:isPublishedAsW>
    <ex:isPublishedAsW>or</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1895</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crypt_of_Cthulhu_Candlemas_1984">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crypt of Cthulhu Candlemas 1984</rdfs:label>
    <ex:hasAnnotation>Various Robert M. Price Cover Artist Stephen Fabian United States English Crypt of Cthulhu Release Date February 1984 64 Preceded by Yuletide 1983 Followed by Eastertide 1984 is the nineteenth issue of Robert M. Price 's long-running fanzine Crypt of Cthulhu . Self-Published in February 1984, it was edited by Price, who also provided interior artwork, featured cover art by Stephen Fabian, and ran to a total of 64 in an A5 format. This issue was a special largely devoted to the late British Mythos luminary Brian Lumley . Contents Editorial Shards by Robert M. Price "Brian Lumley—Reanimator" by Robert M. Price "Demoniacal" by David Sutton " The Kiss of Bugg-Shash " by Brian Lumley " The Statement of One John Gibson " by Brian Lumley An Interview with Brian Lumley "Sea Fret" by Brian Lumley "Mammoth Rider" by Brian Lumley "Advice to the Lovecraft-Lorn" by Donna Death Letters by R. Alain Everts, Patrice de G. Joubert, Paul R. Wilson, Donna Tod, Tore Stokka, Masaki Abe, Steve Behrends , William Fulwiler, Ronald Shearer, Robert Bloch , Dan Gobbett, Stephen R. Jennings, Ralph E. Vaughan, Laurence C. Bush, Richard L. Tierney , and Darrell Schweitzer Review by Scott Briggs</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>64</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu"/>
    <ex:wasReleasedOnW>February 1984</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Knarst">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>K'nar'st</rdfs:label>
    <ex:hasAlternativeNamesC>Spawn of the Forgotten</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as Spawn of the Forgotten First appearance EXP : " The Portal of " Created by Kevin Litner , the Spawn of the Forgotten , is an amphibious humanoid Great Old One with four, seven-clawed arms, and tentacles in place of legs. The head is leonine but bony and his mouth encases three long tongues. He lies trapped beneath the seafloor, inside a mysterious seamount called Nayghof.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Portal of K'nar'st</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Kevin Litner</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecraft_Country">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Lovecraft Country</rdfs:label>
    <ex:hasAlternativeNamesL>Arkham County</ex:hasAlternativeNamesL>
    <ex:hasAlternativeNamesL>Miskatonic County</ex:hasAlternativeNamesL>
    <ex:hasAlternativeNamesL>Miskatonic region</ex:hasAlternativeNamesL>
    <ex:hasAnnotation>New England, USA Also known as Arkham County Miskatonic County Miskatonic region Geographic region Created by H. P. Lovecraft refers to the fictional and fictionalised New England locales used by H. P. Lovecraft in many of his writings. The phrase was first used by Keith Herber when writing for Chaosium 's Call of Cthulhu roleplaying game, and has since become an accepted term when referring to Lovecraft's works. Notable Locations Lovecraft's Work Arkham Aylesbury Dunwich Innsmouth Kingsport Manuxet River Martin's Beach Miskatonic Valley Providence Dean's Corners Other Authors Billington's Wood ( August Derleth ) Falcon Point (August Derleth) Witches' Hollow (August Derleth) Gallery</ex:hasAnnotation>
    <ex:hasTypeL>Geographic region</ex:hasTypeL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#New_England"/>
    <ex:isLocatedAtL>USA</ex:isLocatedAtL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Colour_Out_of_Space">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Colour Out of Space</rdfs:label>
    <ex:hasAnnotation>The very old folk" is a short story written by american horror writer h. p. lovecraft in march 1927 . In the tale, an unnamed narrator pieces together the story of an area known by the locals as the "blasted heath" in the wild hills west of arkham . The narrator discovers that many years ago a meteorite crashed there, draining the life force from anything living nearby .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Science fiction</ex:hasGenreW>
    <ex:hasGenreW>horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Amazing_Stories"/>
    <ex:wasPublishedOnW>September 1927</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Vitas_Varnas">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Vitas Varnas</rdfs:label>
    <ex:hasAffiliationC>Lauri O'Malley</ex:hasAffiliationC>
    <ex:hasAffiliationC>Victor Sassoon</ex:hasAffiliationC>
    <ex:hasAnnotation>Vitas first appears in pax cthuliana and then in the call of cthulhu supplement the sassoon files . He is usually portrayed as an eccentric character that helps characters either with hints or assets . He first appears in pax cthuliana and then in the call of cthulhu supplement .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Miskatonic_University:_The_Restricted_Collection"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Sassoon_Files"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Pax_Cthuliana"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Fthaggua">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Fthaggua</rdfs:label>
    <ex:ceasedOnC>2339</ex:ceasedOnC>
    <ex:hasAffiliationC>Lesser Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The King Regent of the Fire Vampires</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Lord of Ktynga</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The king regent of the fire vampires is a fictional entity created by donald wandrei for his short story " the fire vampires " . It appears as a great flickering ball of cold blue flame . It dwells with the fire vampires within an enormous edifice upon the surface of the blue comet ktynga .</ex:hasAnnotation>
    <ex:hasAppearanceC>Elder Sign Force of Will</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Fire_Vampires"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Donald_Wandrei"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Incubus_of_Atlantis">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Incubus of Atlantis</rdfs:label>
    <ex:hasAnnotation>The sorcerer's apprentices: new tales in the tradition of clark ashton smith is a short story by american scholar and writer robert m. price . When klarkash-ton is employed by pharnabazus the king of atlantis to chronicle his nation's history, he stumbles across magical knowledge which allows him to astrally project his consciousness and inhabit the bodies of others . Abusing these newfound abilities by using them to engage in sexual congress with the wives of the</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Fantasy</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>The Sorcerer's Apprentices: New Tales in the Tradition of Clark Ashton Smith</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1998</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>1997</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Achtung%21_Cthulhu:_Operation_Falling_Crystal">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Achtung! Cthulhu: Operation Falling Crystal</rdfs:label>
    <ex:hasAnnotation>Brad Bell Cover Artist Michal E. Cross English Achtung! Cthulhu Genre(s) Roleplaying game Modiphius Entertainment Release Date 2020 is a scenario supplement for the Achtung! Cthulhu setting originally developed for Chaosium 's Call of Cthulhu horror roleplaying game. Written by Brad Bell and featuring cover art by Michal E. Cross, it was published as a digital download by third-party content provider Modiphius Entertainment in 2020 . Overview Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW>Brad Bell</ex:hasAuthorW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Achtung! Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2020</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Child_of_the_Green_God">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Child of the Green God</rdfs:label>
    <ex:hasAnnotation>Real World Information First appearance The Horror Under Warrendown Created by Ramsey Campbell The Children of the Green God are a fictional race created by Chaosium in 1994 for the Call of Cthulhu RPG , which was based on Ramsey Campbell 's The Horror Under Warrendown . Background The Children of the Green God are a race of degenerated mutated humans whose children have elongated ears, sharp rodent-like teeth, large eyes, and coarse hair covering their bodies. They shun the light and movement is via a hopping gait. Quick and agile, they usually flee when confronted, unless you threaten their lairs or encounter large groups of them.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Horror Under Warrendown</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Franklyn_Searight">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Franklyn Searight</rdfs:label>
    <ex:diedOnR>8 December 2020</ex:diedOnR>
    <ex:hasAnnotation>Full Name Ellsworth Connection to the Mythos Author Editor Birth Date 5 August 1935 Death Date 8 December 2020 United States Relatives Richard F. Searight (father) Ellsworth (5 August 1935 - 8 December 2020) was the son of Richard F. Searight , Weird Tales author and correspondent of H. P. Lovecraft and the grandson of silent movie actor Frank Searight. He is an accomplished Cthulhu Mythos author in his own right, having written several short Lovecraftian stories and two lengthy series of Mythos poetry. Although the elder Searight invented the evocative Eltdown Shards , and was occasionally employed by Lovecraft himself, he made no great effort to carry on the Cthulhu Mythos tradition. Franklyn however wrote numerous Mythos stories especially in a productive period in the 1970s. Selected Bibliography Editor Those Dreadful Eltdown Shards Author Lair of the Dreamer: A Cthulhu Mythos Omnibus (2007) Lovecraftian Covens (2015) " Interlude at the Bridge " (1980) " The Marsh House " (2001) " Cellar Dweller " (2019) Folks of Innsmouth (1997-2004) Lovecraftian Cliff Notes for Ech-Pi-El (1998-2001) " Miskatonic University - Pride of the Ivy League " (2006)</ex:hasAnnotation>
    <ex:hasFullNameR>Ellsworth Franklyn Searight</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasRelativeR rdf:resource="http://example.org/lovecraft#Richard_F._Searight"/>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
    <ex:wasBornOnR>5 August 1935</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Neil_Baker">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Neil Baker</rdfs:label>
    <ex:hasAnnotation>Horror is an author, editor and artist based in canada, although he grew up in england . In 2014 he founded the small press publishing house, april moon books . His work has been featured in anthologies including world war cthulhu .</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Chronicles_of_the_Cthulhu_Codex">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Chronicles of the Cthulhu Codex</rdfs:label>
    <ex:hasAnnotation>The first issue was released in january 1985 by fungoid press and under the editorship of pierre comtois . In 1989, henry j. vester, iii took the helm for issue #5, after which it briefly lapsed into hiatus . In 1994, vester returned along with . Ron hilger to produce issue #6, renaming it simply . The cthulhu codex .</ex:hasAnnotation>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Fomalhaut">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Stars"/>
    <rdfs:label>Fomalhaut</rdfs:label>
    <ex:hasAlternativeNamesL>Alpha Piscis Austrini</ex:hasAlternativeNamesL>
    <ex:hasAlternativeNamesL>Alpha PsA</ex:hasAlternativeNamesL>
    <ex:hasAlternativeNamesL>α Piscis Austrini</ex:hasAlternativeNamesL>
    <ex:hasAlternativeNamesL>α PsA</ex:hasAlternativeNamesL>
    <ex:hasAnnotation>It is the brightest star in the constellation piscis austrinus and one of the brightest stars in the sky . It is classified as a vega-like star that emits excess infrared radiation, indicating it is surrounded by a circumstellar disk . It is the third brightest star known to have a planetary system (as viewed from earth), after pollux and the sun .</ex:hasAnnotation>
    <ex:isInhabitedByL>Tcho-Tcho People (possibly)</ex:isInhabitedByL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Trail_of_Cthulhu"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Fisherman_of_Falcon_Point">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Fisherman of Falcon Point</rdfs:label>
    <ex:hasAnnotation>August Derleth United States English Genre(s) Fantasy short story The Shuttered Room And Other Pieces Media type Print (book) date 1959 is a short story first published in the Arkham House volume The Shuttered Room And Other Pieces (1959). it is one of the controversial " Posthumous Collaborations " by August Derleth , based on H. P. Lovecraft 's Commonplace Book entry. Everything other than the quote above was under Derleth's control. It may also be influenced by traditional mermaid /selkie legends.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Fantasy short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>The Shuttered Room And Other Pieces</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1959</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhi">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Cthulhi</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Cthulhu"/>
    <ex:hasAlternativeNamesC>Cosmic Octopi</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Star-Spawn of Cthulhu</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Xothians</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Xothians are a species that have a physical similarity with their leader, the great old one known as cthulhu . They are land-based, not aquatic, and built their cities on dry land before they were sunk by a cataclysm . Their physicality so malleable that they might to some small degree be called shapeshifters.</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Passing_of_Eric_Holm"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Collect_Call_of_Cathulhu"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Warder_of_Knowledge"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Through_the_Gates_of_the_Silver_Key"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#At_the_Mountains_of_Madness"/>
    <ex:madeFirstAppearanceOnC>The Call of Cthulhu (unnamed)</ex:madeFirstAppearanceOnC>
    <ex:usesLanguageC>R'lyehian</ex:usesLanguageC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
