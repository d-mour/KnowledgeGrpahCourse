  <rdf:Description rdf:about="http://example.org/lovecraft#By_the_Way,_Whatever_Happened_to_the_Dagons%3F">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>By the Way, Whatever Happened to the Dagons?</rdfs:label>
    <ex:hasAnnotation>By the way, whatever happened to the dagons? " Is a short cthulhu mythos story by american james ambuehl .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#James_Ambuehl"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Etienne-Laurent_de_Marigny">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Dreamers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Etienne-Laurent de Marigny</rdfs:label>
    <ex:hasAnnotation>Étienne-laurent de marigny is a fictional character invented by h. p. lovecraft and e. hoffman price . He first appears in the co-authored story " through the gates of the silver key ", where he is identified as a "distinguished creole student of mysteries and eastern antiquities" he is later referred to in other cthulhu mythos stories, including the works of brian lumley .</ex:hasAnnotation>
    <ex:hasAppearanceC>Out of the Aeons The Secret of Sebek</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Through_the_Gates_of_the_Silver_Key"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Evil">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Evil</rdfs:label>
    <ex:hasAnnotation>History was first published in the collection keyport cthulhu in november 2013 . It is the fifth part of the keyport cthulhu cycle by american author armand rosamilia .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Armand_Rosamilia"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Keyport_Cthulhu"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Keyport_Cthulhu"/>
    <ex:wasPublishedOnW>November 2013</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Plateau_of_Sarkis">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Plateau of Sarkis</rdfs:label>
    <ex:hasAnnotation>Dreamlands ( Lomar ) Plateau Humans First appearance HPL : " Polaris " Created by H. P. Lovecraft The is a plateau in the far northern kingdom of Lomar in the Dreamlands . The plateau is the site of the city of Olathoë , and is situated in a hollow between the mountains Noton and Kadiphonek . ( HPL : " Polaris ")</ex:hasAnnotation>
    <ex:hasTypeL>Plateau</ex:hasTypeL>
    <ex:isInhabitedByL>Humans</ex:isInhabitedByL>
    <ex:isLocatedAtL>Dreamlands ( Lomar )</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#Polaris"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Stygian_Fox">
    <rdf:type rdf:resource="http://example.org/lovecraft#Publishers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Stygian Fox</rdfs:label>
    <ex:hasAnnotation>Overview focuses primarily on releasing third-party content for established franchises . A large portion of this content is devoted to chaosium's call of cthulhu roleplaying game . Their publications appear to be financed through crowdfunding ventures .</ex:hasAnnotation>
    <ex:hasWebsiteR>https://stygian-fox.odoo.com/</ex:hasWebsiteR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Return_of_Zhosph">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Return of Zhosph</rdfs:label>
    <ex:hasAnnotation>Snurd is a man who studies the seven cryptical books of hsan . He lives in the city of zulan-thek where necromancy is forbidden . When the bodies of two people named klotlei and shek were dug up, he left zulan-thek to follow them . He discovered a vault where the sextons disposed of the bodies of malefactors from zulan-thek including klotlei and shek .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Gary_Myers"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>HPL</ex:isPublishedAsW>
    <ex:wasPublishedOnW>March 1972</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cassiopeia">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Stars"/>
    <rdfs:label>Cassiopeia</rdfs:label>
    <ex:hasAnnotation>Northern sky Constellation HPL : " Polaris " is a real-world constellation in the northern sky, named after the Greek mythological queen , the mother of Andromeda. In the Mythos is briefly mentioned in the short story " Polaris " by H. P. Lovecraft . The constellation is formed by five bright stars in the shape of a letter W.</ex:hasAnnotation>
    <ex:hasAppearanceL rdf:resource="http://example.org/lovecraft#Polaris"/>
    <ex:hasTypeL>Constellation</ex:hasTypeL>
    <ex:isLocatedAtL>Northern sky</ex:isLocatedAtL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Petr_%C5%A0tovik">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Petr Štovik</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Artist Czech Republic is a freelance Czech artist who has provided artwork for a number of roleplaying games, including Chaosium 's genre-defining Mythos game Call of Cthulhu . Selected Works Cover Artist Alone Against the Flames (2016) Alone Against the Dark (2018) See Also Images by</ex:hasAnnotation>
    <ex:hasNationalityR>Czech Republic</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Artist</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dead_But_Dreaming">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dead But Dreaming</rdfs:label>
    <ex:hasAnnotation>Various English DarkTales Publications Miskatonic River Press Release Date March 2002 Followed by 2 is an anthology of original Lovecraftian fiction edited by Kevin Ross and Keith Herber . First published by DarkTales Publications in March 2002, later editions were issued by Miskatonic River Press in June 2008 and July 2013. Overview Contents Pay No Attention to the Man Behind the Curtain ... introduction by Keith Herber Foreword: Into the Abyss by Kevin Ross "Epiphany: A Flying Tiger's Story" by Stephen Mark Rainey "The Aklo" by Loren McLeod "Bangkok Rules" by Craig Davidson "Why We Do It" by Darrell Schweitzer "The Disciple" by David Barr Kirtley "Salt Air" by Mike Minnis "Through the Cracks" by Walt Jarvis "The Unseen Battle" by Brian Scott Hiebert "Bayer's Tale" by Adam Niswander "The Call of Cthulhu: The Motion Picture" by Lisa Morton "Under an Invisible Shadow" by David Bain "The Thing Beyond the Stars" by Robin Morris "Fire Breathing" by Mehitobel Wilson "The Other Names" by Ramsey Campbell "Final Draft" by David Annandale</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>March 2002</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Poseidon">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdfs:label>Poseidon</rdfs:label>
    <ex:hasAlternativeNamesC>Neptune</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Neptune is the name of an ancient greek sea-god, later known as neptune by the ancient romans . In the expanded cthulhu mythos , is a powerful extragalactic entity, awed by 'ymnar .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Strange_High_House_in_the_Mist"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#hasTypeA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>hasTypeA</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Realm_of_Kings">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Realm of Kings</rdfs:label>
    <ex:hasAnnotation>Dan Abnett, Andy Lanning Mahmud Asrar, Leonardo Manco, Andrea Di Vito, Kevin Walker, Brad Walker, Pablo Raimondi, Victor Olazaba, Andrew Hennessy, Tim Seeley English Marvel Comics Release Date January 2010 - May 2010 Media Type Comic book The is a cosmic crossover event in Marvel Comics written by Dan Abnett and Andy Lanning. It covered the aftermath of the Kree-Shi'ar War (The War of Kings), which resulted in the creation of the Fault between the galaxies of the Local Group. Making its first appearance is the Cancerverse , one of the realities conquered by the Many-Angled Ones . It's the prelude to the Many-Angled One invasion of the prime reality . The event was covered in the one-shot issue of , the : Imperial Guard 5-part mini-series, the : Inhumans 5-part mini-series, issues #20-24 of the 2nd volume of Guardians of the Galaxy, and issues #31-35 of the 4th volume of Nova.</ex:hasAnnotation>
    <ex:hasAuthorW>Andy Lanning</ex:hasAuthorW>
    <ex:hasAuthorW>Dan Abnett</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>January 2010 - May 2010</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecraftiana_Vol_5,_Issue_1">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraftiana Vol 5, Issue 1</rdfs:label>
    <ex:hasAnnotation>Various Dean Wirth Majid M. Binghalib Cover Artist Seneca English Genre(s) Weird fiction Rogue Planet Press Release Date 2020  was edited by Gavin Chappell and published by Rogue Planet Press in 2020. Both physical and digital versions were released. It features a cover by Seneca and interior art by Dean Wirth (who also provided one of the stories) and Majid M. Binghalib. Contents " Lurkers " by David A. Riley " Every Star is Mad " by C. M. Fields " The Reliquary " by C. P. Webster " Unholy Cosmic Terror " by Cameron Walker " Bug of the Stars " by Evan Rodenhausen " Afterburn " by Carlton Herzog " The Vessel " by Henry Snider " How to Frame a Dying Art " by Mike Lee " The Blue Canoe " by Ben Scotti " The Terror of Emmett’s Cove " by Lee Clark Zumpe " The Dewey Mine Attack " by Dean Wirth " Shipping on the River " by Sergio Palumbo and Ivan Bertozzoni " The End of History " by Mathew Chabin</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2020</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sussex_Fragments">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Sussex Fragments</rdfs:label>
    <ex:hasAnnotation>England Genre(s) Occult Media Type 42 clay fragments Real World Information First appearance AWD : " The Seal of R'lyeh " Created by August Derleth The 42 clay fragments found by the Rev. Brooke Winters-Hall in 1912 in Eltdown, Sussex, England, are referred to as “The ” to distinguish them from the fragmentary writings found near Eltdown, U.S.A., by Doctors Dalton and Woodford in 1891, with which they share much, and which they may be an alternative version of (see The Eltdown Shards ). Behind the Mythos The name is used by August Derleth (some say after H. P. Lovecraft , some say as advertisement for Fred Pelton's " The Sussex Manuscript ", which Derleth originally intended to publish); Laurence J. Cornford signed the term to the version of the Eltdown Shards outlined in " The Challenge from Beyond ".</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_Seal_of_Rlyeh"/>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#August_Derleth"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Incessant_Drone">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Incessant Drone</rdfs:label>
    <ex:hasAnnotation>Historyis a short military horror story by british-born neil baker . It was published in the anthology return of the old ones: apocalyptic lovecraftian horror in 2017 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Neil_Baker"/>
    <ex:hasGenreW>Military horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Return of the Old Ones: Apocalyptic Lovecraftian Horror</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Pnath">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Pnath</rdfs:label>
    <ex:hasAlternativeNamesL>Vale of Pnath</ex:hasAlternativeNamesL>
    <ex:hasAnnotation>The vale of is a region or city briefly mentioned as having been conquered by the city of sarnath in " the doom that came to sarnath " by h. p. lovecraft . The vale of is a shunned area inhabited by the mysterious dholes .</ex:hasAnnotation>
    <ex:hasAppearanceL rdf:resource="http://example.org/lovecraft#The_Dream-Quest_of_Unknown_Kadath"/>
    <ex:hasTypeL>Region or City</ex:hasTypeL>
    <ex:isInhabitedByL>Dholes</ex:isInhabitedByL>
    <ex:isInhabitedByL>Humans</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Dreamlands"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Doom_That_Came_to_Sarnath"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tribute_Band">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Tribute Band</rdfs:label>
    <ex:hasAnnotation>Two young musicians on a road trip investigate the disappearance of one of their inspirations years earlier . They come into possession of the man's copy of the revelations of gla'aki . They are approached by his former compatriots, who trick the pair into enacting a ritual which frees the great old one from its tether .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#John_Goodrich"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Children_of_Glaaki"/>
    <ex:wasPublishedOnW>January 2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Ancestor">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Ancestor</rdfs:label>
    <ex:hasAnnotation>The story describes experiments in recovering hereditary memory by dr. ambrose perry, as recounted by his cousin . Perry's fanatical investigations lead him to sequester himself in his lab--and eventually to physically regress .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Survivor"/>
    <ex:isPublishedAsW>Others</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1957</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crane_Street">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Crane Street</rdfs:label>
    <ex:hasAnnotation>Arkham , Massachusetts Street Humans First appearance HPL : " Herbert West--Reanimator " Created by H. P. Lovecraft is a street in the fictional town of Arkham , Massachusetts and located near the campus of Miskatonic University . After a murderous rampage throughout Arkham, the reanimated corpse of Dr. Allan Halsey was captured in a house it had broken into on by bands of searchers led by police. ( HPL : " Herbert West--Reanimator ")</ex:hasAnnotation>
    <ex:hasTypeL>Street</ex:hasTypeL>
    <ex:isInhabitedByL>Humans</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Arkham"/>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Massachusetts"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#Herbert_West--Reanimator"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Chronicles_of_Thrang">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ArtefactsOriginatingFromMythosAdjacentWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>The Chronicles of Thrang</rdfs:label>
    <ex:hasAnnotation>Description is an obscure text translated into english from some prehuman tongue and the of the pre-sumerian ngarathoe . One source claims it as a non-human chronicle, but this is unclear . The writings detail the cosmic entities yidhra and ngyr-korath .</ex:hasAnnotation>
    <ex:wasCreatedByA>Walter C. DeBill Jr.</ex:wasCreatedByA>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Pickman%E2%80%99s_Other_Model_%281929%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#CaitlinRKiernanWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Pickman’s Other Model (1929)</rdfs:label>
    <ex:hasAnnotation>"pickman's other model" is a short story by caitlin r. kiernan . It serves as a sequel to lovecraft's "pickman's model" the narrator of the story is identified with the person to whom thurber tells his story . The narrator of the story, eliot blackman, has become obsessed with pickman .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Sirenia_Digest"/>
    <ex:wasPublishedOnW>March 2008</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Sea_Nymphs_Son">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Sea Nymph's Son</rdfs:label>
    <ex:hasAnnotation>"the kraken" is a short story by american robert m. price . It was published in the thematic anthology world war cthulhu in 2014 . Neither achilles nor his mother thetis appear to be human in this story .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>History</ex:hasGenreW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>War</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Antarctica">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Antarctica</rdfs:label>
    <ex:hasAccessibilityL>Air</ex:hasAccessibilityL>
    <ex:hasAccessibilityL>Sea</ex:hasAccessibilityL>
    <ex:hasAnnotation>The fabled plateau of leng is rumoured to be situated somewhere in the antarctic (although sources conflict on this) a ruined elder thing city is located there . At the mountains of madness heavily implies that a great old one inhabits the plain beyond the barrier mountains .</ex:hasAnnotation>
    <ex:hasTypeL>Continent</ex:hasTypeL>
    <ex:isLocatedAtL>Planet Earth</ex:isLocatedAtL>
    <ex:isLocatedAtL>Sol System</ex:isLocatedAtL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#hasAccessibilityL">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>hasAccessibilityL</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/lovecraft#Location"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Salem">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Salem</rdfs:label>
    <ex:hasAnnotation>Town is often cited as a model for h. p. lovecraft's fictional arkham . Lovecraft's fictional "witches" tend to be genuine practitioners of cosmic evil . Town was actually two communities at the time of the witch trials of 1692 .</ex:hasAnnotation>
    <ex:hasTypeL>Township</ex:hasTypeL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Massachusetts"/>
    <ex:isLocatedAtL>United States</ex:isLocatedAtL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Jubilex">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Jubilex</rdfs:label>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#Ooze"/>
    <ex:hasAlternativeNamesC>The Demon Lord of Poison</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Faceless Lord</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Demon Lord of Poison and Ooze The Faceless Lord The Abyss Qlippoth  (aka, the Lord of Sloth , the Faceless Lord ) is a Lovecraftian demonic entity from the fictional universe of the Pathfinder pencil-and-paper roleplaying game by Paizo Inc. Description is a massive pile of green ooze with numerous eyes and lines of jet black tar crossing its body. Background A Qlippoth Lord who became a demon lord by devouring demons, used to be a mindless being, but as it consumed demons it gradually gained an intellect.</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dark_Wisdom:_New_Tales_of_the_Old_Ones">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dark Wisdom: New Tales of the Old Ones</rdfs:label>
    <ex:hasAnnotation>Gary Myers Cover Artist Gary Myers United States English Mythos Books Release Date 2007 , also released as Dark Wisdom: Tales of the Old Ones , is a collection of Cthulhu Mythos works by American Gary Myers . First published in 2007 by Mythos Books , it received an ebook release in March 2013. Myers provided the cover art for both versions, and also an interior plate. Contents Introduction by Robert M. Price "The Web" "Slugs" "Mother of Serpents" "Fast Food" "Understudy" "The Big Picture" "Omega" "The Mask" "What Rough Beast" "The Nest" "From Inner Egypt" "Horror Show" Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Gary_Myers"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2007</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Oukranos">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Oukranos</rdfs:label>
    <ex:hasAlternativeNamesC>God of Oukranos</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as god of first appearance hpl : " the silver key ", " through the gates of the silver key " created by h. p. lovecraft is the name of a river in the earth's dreamlands .</ex:hasAnnotation>
    <ex:hasAppearanceC>The Silver Key Through the Gates of the Silver Key</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Dream-Quest_of_Unknown_Kadath"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Spawn_of_Madness_%28Call_of_Cthulhu_LCG%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Spawn of Madness (Call of Cthulhu LCG)</rdfs:label>
    <ex:hasAnnotation>Spawn of madness is an expansion pack for fantasy flight games' call of cthulhu: the card game . It contains three duplicate sets of 20 unique cards for a total of 60 . First released in 2010, it was discontinued in 2015 with the demise of call of cthulhu: the card game .</ex:hasAnnotation>
    <ex:wasPublishedOnW>2010</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Celepha%C3%AFs">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Celephaïs</rdfs:label>
    <ex:hasAnnotation>" poetry and the godsfrom beyond "is a fantasy story by american horror fiction writer h. p. lovecraft . First published in the may 1922 issue of the rainbow . Was next republished in 1970 by del rey books in a short story collection called the dream-quest of unknown kadath .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Fantasy short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Rainbow</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1922 May</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tales_of_Cthulhu_Invictus">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Tales of Cthulhu Invictus</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Alberto Guerra United States English Golden Goblin Press Release Date 2015 Media Type Ebook (Kindle) 132 : Nine Stories of Battling the Cthulhu Mythos in Ancient Rome is an anthology of historical horror stories. Overview A collection of stories involving Mythos encounters during the height of the Roman Empire, is published by Golden Goblin Press on license from Chaosium , and is set in their historical Call of Cthulhu offshoot Cthulhu Invictus . It was edited by Brian M. Sammons and runs to a total of 132 . Publication History First released in 2015 by Golden Goblin Press, was published in both print and digital editions. Contents " Vulcan's Forge " by William Meikle " Fecunditati Augustae " by Christine Morgan " A Plague of Wounds " by Konstantine Paradias " Tempus Edax Rerum " by Peter Rawlik " The Unrepentables " by Edward M. Erdelac " Magnum Innominandum " by Penelope Love " Lines in the Sand " by Tom Lynch " The Temple of Iald-T'qurhoth " by Lee Clark Zumpe " The Seven Thunders " by Robert M. Price</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>132</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sixty_Years_of_Arkham_House:_A_History_and_Bibliography">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Sixty Years of Arkham House: A History and Bibliography</rdfs:label>
    <ex:hasAnnotation>S. T. Joshi Cover Artist Allen Koszowski United States English Genre(s) Non-Fiction Arkham House Release Date 1999 Media Type Print 281 is a non-fiction work which compiles a bibliography of every single publication released by Arkham House from 1939 through to 1999, as well as those from the Mycroft &amp; Moran and Stanton &amp; Lee imprints. It is an update of the 1970 release Thirty Years of Arkham House, 1939-1969: A History and Bibliography . Publication History First released in 1999 by Arkham House in an edition of 3,500 copies, Sixty Years of Arkham House was edited by noted Lovecraft scholar S. T. Joshi with jacket illustration by Allen Koszowski .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#S._T._Joshi"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-Fiction</ex:hasGenreW>
    <ex:hasPageCountW>281</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1999</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yhoundeh">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Yhoundeh</rdfs:label>
    <ex:hasAlternativeNamesC>The Elk-Goddess</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The elk-goddess is a being created by the late american author clark ashton smith for his short story " the door to saturn " . Although given the epithet of "the elk-goddess", her true appearance is never given . However, in a letter to robert h. barlow dated 10 september 1934 smith stated it to be the offspring of the "androgynous animal archetype" zyhumé .</ex:hasAnnotation>
    <ex:hasCharacterMateC rdf:resource="http://example.org/lovecraft#Nyarlathotep"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Door_to_Saturn"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Nyarlathotep_Cycle:_The_God_of_a_Thousand_Forms">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Nyarlathotep Cycle: The God of a Thousand Forms</rdfs:label>
    <ex:hasAnnotation>The Nyarlathotep Cycle Robert M. Price , editor Call of Cthulhu Fiction Chaosium Release Date 1997 239 is an anthology of Nyarlathotep -related Cthulhu Mythos stories, edited by Robert M. Price and published by Chaosium in 1997 as part of its Cthulhu Cycle fiction . The book also includes stories and poetry believed to have influenced H. P. Lovecraft 's conception of the entity. Contents "Alhireth-Hotep the Prophet" by Lord Dunsany (1905) "The Sorrow of Search" by Lord Dunsany (1905) " Nyarlathotep " by H. P. Lovecraft (1920) "The Second Coming" (poem) by William Butler Yeats (1920) "Silence Falls on Mecca's Walls" (poem) by Robert E. Howard (1989) " Nyarlathotep " (poem) by H. P. Lovecraft (1931) " The Dreams in the Witch-House " by H. P. Lovecraft (1933) " The Haunter of the Dark " by H. P. Lovecraft (1936) " The Dweller in Darkness " by August Derleth (1944) "The Titan in the Crypt" by J. G. Warner (1963) " Fane of the Black Pharaoh " by Robert Bloch (1937) "Curse of the Black Pharaoh" by Lin Carter (1989) "The Curse of Nephren-Ka" by John Cockroft (1946) "The Temple of Nephren-Ka" by Philip J. Rahman &amp; Glenn A. Rahman (1977) "The Papyrus of Nephren-Ka" by Robert C. Culp (1975) "The Snout in the Alcove" by Gary Myers (1977) "The Contemplative Sphinx" (poem) by Richard Tierney (1989) "Ech-Pi-El's Ægypt" (poem) by Ann K. Schwader "The Elder Lords" (poem) by Ann K. Schwader "The Tomb of Nephren-Ka" (poem) by Ann K. Schwader "Lord of the Dead" (poem) by Ann K. Schwader "Dream-Gates" (poem) by Ann K. Schwader</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
    <ex:hasAuthorW>editor</ex:hasAuthorW>
    <ex:hasPageCountW>239</ex:hasPageCountW>
    <ex:isPartOfSeriesW>Call of Cthulhu Fiction</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>1997</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Creature_in_the_Fog">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Creature in the Fog</rdfs:label>
    <ex:hasAnnotation>"the creature from the fog" is a short horror story by american ron shiflet . It was first published in dark legacy #6 in april 2000, and again in nightscapes in august 2001 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>April 2000</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Seugathi">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Seugathi</rdfs:label>
    <ex:hasAffiliationC>Neothelids</ex:hasAffiliationC>
    <ex:hasAnnotation>Golarion neothelids are huge creatures, that resemble a cross between a worm and a caterpillar . A 's favorite food is the rational thoughts of the sane, but the siphoning of those thoughts drives them insane .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Denizens of the Darklands</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Inc</ex:wasCreatedByC>
    <ex:wasCreatedByC>Paizo</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#J_Vernon_Shea">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>J Vernon Shea</rdfs:label>
    <ex:diedOnR>1981</ex:diedOnR>
    <ex:hasAnnotation>Young weird fiction fan from Pittsburgh who began corresponding with Lovecraft in 1931.</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1912</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lucky_Chuck_Takes_the_Sunshine_Express">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lucky Chuck Takes the Sunshine Express</rdfs:label>
    <ex:hasAnnotation>Cthulhu mythos short story first published in the collection of lovecraftian fiction whispers from the abyss vol. 2: the horrors that are &amp; shall be in october 2015 . Story follows a man in a midlife crisis who accepts an invitation from a group posing as a social outreach organisation .</ex:hasAnnotation>
    <ex:hasAuthorW>John Palisano</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Shall Be</ex:isPublishedAsW>
    <ex:isPublishedAsW>Whispers from the Abyss Vol. 2: The Horrors That Are</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Black_Stone">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RobertEHowardWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Black Stone</rdfs:label>
    <ex:hasAnnotation>Weird tales is a short sci-fi/horror story by robert e. howard . It is notable for containing the first mention of the unaussprechlichen kulten . The story opens with an unnamed narrator being gripped with curiosity by a brief reference to in the nameless cults .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>November 1931</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kevin_Wetmore">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonFictionAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Scholars"/>
    <rdfs:label>Kevin Wetmore</rdfs:label>
    <ex:hasAnnotation>Author has written a number of stories set in the cthulhu mythos . Short fiction has appeared in anthologies such as whispers from the abyss vol. 2 (2015, 01publishing) and the call of poohthulhu (2022, april moon books)</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Connecticut New Haven</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://www.somethingwetmorethiswaycomes.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1 February 1969</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Space_Eldritch_II:_The_Haunted_Stars">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Space Eldritch II: The Haunted Stars</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Carter Reid English Cold Fusion Media Release Date November 2013 298 Preceded by Space Eldritch is an anthology of Lovecraftian fiction edited by Nathan Shumate and published by Cold Fusion Media in November 2013. Cover art was supplied by Carter Reid. Overview Contents "A Darklight Call'd on the Long Last Night of the Soul" by Michaelbrent Collings "Dead Waits Dreaming" by Larry Correia "The Implant" by Robert J Defendi "Plague Ship" by Steven L. Peck "From Within the Walls" by Steven Diamond " Space Opera: Episode Two—The Great Old One Strikes Back " by Michael R. Collings "The Queen in Shadow" by David J. West "The Humans in the Walls" by Eric James Stone "Seed" by D. J. Butler "Full Dark" by Nathan Shumate "Fall of the Runewrought" by Howard Tayler</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>298</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>November 2013</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Wake_Up_Call:_A_Tale_of_Eldritch_Horror_and_Real_Estate">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Wake Up Call: A Tale of Eldritch Horror and Real Estate</rdfs:label>
    <ex:hasAnnotation>Heath Kennings English Release Date April 2014 12 " " is a light-hearted Cthulhu Mythos story by Heath Kennings. Running to a total of 12 , it was published through Amazon's digital Kindle platform in April 2014. Overview Synopsis Upon waking from his aeons-long slumber, Great Cthulhu decides that the process of conquering the Earth is too time consuming and, in an age of strategic thermonuclear weapons, dangerous. Instead, he instructs his cultists to begin work on converting the island-city of R'lyeh into some kind of bizarre cosmic theme park, before deciding to go back to sleep for a little while longer.</ex:hasAnnotation>
    <ex:hasAuthorW>Heath Kennings</ex:hasAuthorW>
    <ex:hasPageCountW>12</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>April 2014</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Throne_of_Bones">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Throne of Bones</rdfs:label>
    <ex:hasAnnotation>Brian McNaughton Cover Artist Jamie Oberschlake English Terminal Fright Publications Wildside Press (reissues) Release Date 1997 is a World Fantasy Award-winning anthology by Brian McNaughton , first published in 1997 by Terminal Fright Publications. Overview It is a series of stories linked by their taking place in the same necro-metropolis (an inhabited large city of the dead) where humans coexist with monsters including a large population of Ghouls . Contents: " Ringard and Dendra " (1996) " " (1997) " The Vendren Worm " (1990) " Meryphillia " (1990) " Reunion in Cephalune " (1997) " The Art of Tiphytsorn Glocque " (1997) " A Scholar from Sythiphore " (1995) " Vendriel and Vendreela " (1988) " The Retrograde Necromancer " (1993) " The Return of Liron Wolfbaiter " (1997) Publication History First published in paperback by Terminal Fright Publishing in 1997, a hardcover version was released in April the following year. In October 2000, Wildside Press released a paperback edition with a recoloured cover; this version was reissued in hardcover in April 2021. Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_McNaughton"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1997</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dewey_Mine_Attack">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dewey Mine Attack</rdfs:label>
    <ex:hasAnnotation>Dean Wirth English Genre(s) Weird fiction Lovecraftiana Vol 5, Issue 1 date 2020 Next → " The Riddle of Jeremy Roman "  " " is a short story by Canadian Dean Wirth , published in Vol 5, Issue 1 of the Lovecraftiana zine in 2020. It is the first in a series of linked Lovecraftian short stories to be included in that . Synopsis When some of the men at a remote mining camp disturb the entities which lurk in the nearby darkness, the creatures visit a terrible revenge on the miners. Although three of the crew manage to escape, they are hunted across the country by the beings until only one, a man named Bryan Katz , starving and half-mad, stumbles into a settlement where he is promptly incarcerated in the Oregon Hospital for the Insane.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Dean_Wirth"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 1</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 5</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mythos_Haiku">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Mythos Haiku</rdfs:label>
    <ex:hasAnnotation>Full story online here David C. Kopaska-Merkel United States English Genre(s) Horror Nightscapes #11 date August 1999 " " is a collection of seven haiku by American , editor and artist David C. Kopaska-Merkel. Each poem concerns a different facet of the Cthulhu Mythos , although not all are obviously connected. History "" was published in the E. P. Berglund -edited online fanzine Nightscapes in August 1999.</ex:hasAnnotation>
    <ex:hasAuthorW>David C. Kopaska-Merkel</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Nightscapes #11</ex:isPublishedAsW>
    <ex:wasPublishedOnW>August 1999</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nestene_Consciousness">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Nestene Consciousness</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Great_Old_One"/>
    <ex:hasAnnotation>The is a hive mind race which is both a singular entity and a disembodied life force . It is the offspring of shub-niggurath , which spawned it on the planet polymos . The is able to exist in various places, various plaes, and various times .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Spearhead from Space</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Robert Holmes</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Vixni-Aldru">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Stars"/>
    <rdfs:label>Vix'ni-Aldru</rdfs:label>
    <ex:hasAnnotation>Black Hole Created by James Ambuehl The black hole Vix'ni-Aldri is home to the Outer God Haiogh-Yai , also known as the Outsider . Behind the Mythos Vix'ni-Aldri was first created by James Ambuehl as part of the Lu-Kthu Cycle .</ex:hasAnnotation>
    <ex:hasTypeL>Black Hole</ex:hasTypeL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bats_in_the_Belfry">
    <rdf:type rdf:resource="http://example.org/lovecraft#Crossovers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Bats in the Belfry</rdfs:label>
    <ex:hasAnnotation>Paranormal investigator thomas carnacki discovers a portal to the outer darkness located inside an ancient church . He is successful in closing it and beating back its guardian - the outer god yog-sototh, or perhaps one of its avatars . The ginger tomcat is a guardian of the portal disguised as a housecat .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Tails_of_Terror"/>
    <ex:wasPublishedOnW>2018</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Heavenly_Realms">
    <rdf:type rdf:resource="http://example.org/lovecraft#Dimensions"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Heavenly Realms</rdfs:label>
    <ex:hasAccessibilityL>(To humans) via Mount Semura</ex:hasAccessibilityL>
    <ex:hasAnnotation>The of the cthulhu mythos was created by chaosium for the call of cthulhu roleplaying game in 2005 . It's a dimension which is either adjacent to the dreamlands or completely separate from it . Living in the are the gods of ancient china and japan, the taoist immortals, and avatars of the mythos .</ex:hasAnnotation>
    <ex:hasTypeL>Alternate Dimension</ex:hasTypeL>
    <ex:isInhabitedByL>Taoist Immortals</ex:isInhabitedByL>
    <ex:isInhabitedByL>avatars</ex:isInhabitedByL>
    <ex:isInhabitedByL>devas</ex:isInhabitedByL>
    <ex:isInhabitedByL>gods</ex:isInhabitedByL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#Secrets_of_Japan"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Trap">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Trap</rdfs:label>
    <ex:hasAnnotation>The dreams in the witch-house is a short story by h.p. Lovecraft and h.s. Whitehead . It was first published in strange tales , march 1932 . The story features whitehead's recurring protagonist gerald canevin .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Henry_S._Whitehead"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Howard_Phillips_Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>Science Fiction short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dunwich_Horror_%28being%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Dunwich Horror (being)</rdfs:label>
    <ex:hasAlternativeNamesC>Cliffourd the Big Red God ( Mini Mythos )</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>John-Divine Wheatley ( Providence )</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Yog Whateley ( Dark Adventure Radio Theatre )</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Dunwich horror is the inhuman child of lavinia whateley and yog-sothoth . Created by h.p. Lovecraft for his eponymous short story . Fed on cattle growing up, draining them of blood before devouring them .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Demonbane"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Dunwich_Horror"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Rogue_Planet_Press">
    <rdf:type rdf:resource="http://example.org/lovecraft#Publishers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Rogue Planet Press</rdfs:label>
    <ex:hasAnnotation>Parent Company Horrified Press Current Status Active https://horrifiedpress.wordpress.com/rogue-planet-press/  is an imprint of Horrified Press . The imprint is the banner under which most of their parent company's Mythos works such as the anthology fanzine Lovecraftiana are published. The publishing schedule for this small press is irregular but at least one publication has been released each year for the last five years as of 2021. Selected Publications Periodicals Lovecraftiana (2016-present) Anthologies Swords Against Cthulhu (2015) Swords Against Cthulhu II: Hyperborean Nights (2017) Swords Against Cthulhu III: A New Dark Age (2018) The Best of Lovecraftiana (2023)</ex:hasAnnotation>
    <ex:hasWebsiteR>https://horrifiedpress.wordpress.com/rogue-planet-press/</ex:hasWebsiteR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Offspring_of_Nightmares">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Offspring of Nightmares</rdfs:label>
    <ex:hasAnnotation>Jeffrey Thomas Cover Artist Barandash Karandashich English Genre(s) Lovecraftian fiction Forma Street Press Release Date November 2022 66 is a chapbook collection of Lovecraftian fiction by prolific American Jeffrey Thomas , featuring cover art by Barandash Karandashich. Containing three stories and running to a total of 66 , it was published by Forma Street Press in November 2022; both digital and paperback editions were released . Overview Contents "Still Life with Extinct Animals" " Drunk on Dream " " He Shall Put on the Semblance of Man " References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Jeffrey_Thomas"/>
    <ex:hasGenreW>Lovecraftian fiction</ex:hasGenreW>
    <ex:hasPageCountW>66</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>November 2022</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Jeffrey_Thomas">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
