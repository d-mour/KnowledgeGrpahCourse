  <rdf:Description rdf:about="http://example.org/lovecraft#Hammerhead">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtinctSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Hammerhead</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Ogdru_Jahad"/>
    <ex:hasAlternativeNamesC>Unknown</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Hammerheads were a hostile species that rose during the apocalypse of the ogdru jahad . They are very large pseudo-hexapods with a bone-white exoskeleton .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>B.P.R.D.: Hell on Earth</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Mike_Mignola"/>
  </rdf:Description>
