    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dagon (2001 film)</rdfs:label>
    <ex:hasAnnotation>Dagon is a 2001 spanish film, loosely based on h.p. Lovecraft's the shadow over innsmouth . It premiered in spain on october 31 2001 and has a running time of 98 minutes .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>Spain</ex:hasCountryOfOriginW>
    <ex:hasWriterW>http://example.org/lovecraft#Dennis_Paoli http://example.org/lovecraft#H._P._Lovecraft</ex:hasWriterW>
