  <rdf:Description rdf:about="http://example.org/lovecraft#Copping_Squid_and_Other_Mythos_Tales">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Copping Squid and Other Mythos Tales</rdfs:label>
    <ex:hasAnnotation>Michael Shea Cover Artist Steven Gilberts United States English Genre(s) Horror Perilous Press Release Date May 2009 224 is a collection of Cthulhu Mythos stories by the late American Michael Shea . Overview Consisting of eight short stories and running to a total of 224 , was edited by leading Lovecraft scholar S. T. Joshi and published by Perilous Press in October 2009. Released as a hardcover volume, it featured cover art by Steven Gilberts. Contents Foreword by S. T. Joshi " Tsathoggua " " Dagoniad " " Copping Squid " " Nemo Me Impune Lacessit " " The Pool " " The Battery " " The Presentation " " Fat Face "</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Michael_Shea"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>224</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>May 2009</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Carl_Jacobi">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsCorrespondents"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Carl Jacobi</rdfs:label>
    <ex:diedOnR>1997 August 25</ex:diedOnR>
    <ex:hasAnnotation>Carl richard jacobi was a pulp fiction writer who contributed frequently to weird tales . His story " the aquarium " was later included in tales of the lovecraft mythos . He also wrote horror fiction for pulp outlets like thrilling, thrilling wonder stories, ghost stories, startling stories, and strange stories .</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Minnesota Minneapolis</ex:hasBirthplaceR>
    <ex:hasFullNameR>Carl Richard Jacobi</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasPseudonymR>Jackson Cole</ex:hasPseudonymR>
    <ex:hasPseudonymR>James K. Vermont</ex:hasPseudonymR>
    <ex:hasPseudonymR>King Marling</ex:hasPseudonymR>
    <ex:hasPseudonymR>Matthew South</ex:hasPseudonymR>
    <ex:hasPseudonymR>Philip Spayne</ex:hasPseudonymR>
    <ex:hasPseudonymR>Richard Carle</ex:hasPseudonymR>
    <ex:hasPseudonymR>Stephen Benedict</ex:hasPseudonymR>
    <ex:isKnownForR rdf:resource="http://example.org/lovecraft#The_Aquarium"/>
    <ex:isKnownForR>Mive</ex:isKnownForR>
    <ex:isKnownForR>The Unpleasantness at Carver House</ex:isKnownForR>
    <ex:wasBornOnR>1908 July 10</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dean_Wirth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Dean Wirth</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Artist Canadian  is a Canadian author and artist who has written a number of works inspired by H. P. Lovecraft 's writings, and has provided artwork for others. Several of these have been published in Lovecraftiana , a print and digital zine dedicated to the genre. Selected Works Short Fiction " The Dewey Mine Attack " (2020) " The Riddle of Jeremy Roman " (2020) " The Randy Oswald Story " 2020) " Nightjar " (2021) Interior Art Lovecraftiana Vol 5, Issue 1 (2020) Lovecraftiana Vol 5, Issue 2 (2020) Lovecraftiana Vol 5, Issue 4 (2021) Lovecraftiana Vol 8, Issue 2 (2023) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasNationalityR>Canadian</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Artist</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
