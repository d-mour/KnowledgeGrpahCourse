  <rdf:Description rdf:about="http://example.org/lovecraft#Robert_A._W._Lowndes">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#KalemClub"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Robert A. W. Lowndes</rdfs:label>
    <ex:diedOnR>14 July 1998</ex:diedOnR>
    <ex:hasAnnotation>Full Name Robert Augustine Ward "Doc" Lowndes Pseudonym(s) Jacques DeForest Erman S. D. Gottesman Carol Grey Carl Groener Henry Josephs Mallory Kent Paul Dennis Lavond John MacDougal Wilfred Owen Morley Richard Morrison Michael Sherman Peter Michael Sherman Lawrence Woods Connection to the Mythos Author Birth Date 4 September 1916 Death Date 14 July 1998 United States Horror Fantasy Robert Augustine Ward "Doc" Lowndes (4 September 1916-14 July 1998) was an American editor and author, and a correspondent of H. P. Lovecraft in the last year of the latter's life. An avid horror fan, he wrote a number of pieces both set in and inspired by the Cthulhu Mythos , and issue #61 of the Crypt of Cthulhu fanzine was dedicated to his works. Selected Works Short Fiction " The Abyss " (1941) " The Mantle of Graag " (1941) Poetry " Nyaghoggua " (1941) Non-Fiction " On H. P. Lovecraft's Views of Weird Fiction " (1989) External Links at Wikipedia at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasFullNameR>Robert Augustine Ward Doc Lowndes</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasPseudonymR>Carl Groener</ex:hasPseudonymR>
    <ex:hasPseudonymR>Carol Grey</ex:hasPseudonymR>
    <ex:hasPseudonymR>Henry Josephs</ex:hasPseudonymR>
    <ex:hasPseudonymR>Jacques DeForest Erman</ex:hasPseudonymR>
    <ex:hasPseudonymR>John MacDougal</ex:hasPseudonymR>
    <ex:hasPseudonymR>Lawrence Woods</ex:hasPseudonymR>
    <ex:hasPseudonymR>Mallory Kent</ex:hasPseudonymR>
    <ex:hasPseudonymR>Michael Sherman</ex:hasPseudonymR>
    <ex:hasPseudonymR>Paul Dennis Lavond</ex:hasPseudonymR>
    <ex:hasPseudonymR>Peter Michael Sherman</ex:hasPseudonymR>
    <ex:hasPseudonymR>Richard Morrison</ex:hasPseudonymR>
    <ex:hasPseudonymR>S. D. Gottesman</ex:hasPseudonymR>
    <ex:hasPseudonymR>Wilfred Owen Morley</ex:hasPseudonymR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>4 September 1916</ex:wasBornOnR>
  </rdf:Description>
