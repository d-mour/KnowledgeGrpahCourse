  <rdf:Description rdf:about="http://example.org/lovecraft#Niggurab">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Niggurab</rdfs:label>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#Shub-Niggurath"/>
    <ex:hasAlternativeNamesC>Nigguraab</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as Nigguraab Shub-Niggurath (speculated) First appearance Avengers #353 (invocation only) Created by Len Kaminski , or Nigguraab , is an entity created by Polish comic book creator Len Kaminski for his stint on long-running superhero series Avengers . It was first mentioned in issue #353 in September 1992 . Overview was one of the deities invoked by the supervillain Grim Reaper, who required power to create his Legion of the Undead, an army of zombie-villains with the sole purpose of destroying the Avengers ( EXP : Avengers #353) . It has been speculated that is merely another name for the Outer God Shub-Niggurath , rather than its own unique entity . See also at the Marvel Database wiki References</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Avengers #353</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Len Kaminski</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Boat_Trip">
