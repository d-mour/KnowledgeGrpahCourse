  <rdf:Description rdf:about="http://example.org/lovecraft#Peter_Rawlik">
    <rdf:type rdf:resource="http://example.org/lovecraft#Critics"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Peter Rawlik</rdfs:label>
    <ex:hasAnnotation>Author of several works set in the cthulhu mythos inspired by the works of h.p. Lovecraft . Rawlik has shown a particular affinity with the characters of herbert west and the peaslee family .</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Minot Air Force Base North Dakota</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasYearsActiveR>1997-present</ex:hasYearsActiveR>
