  <rdf:Description rdf:about="http://example.org/lovecraft#Gaspard_du_Nord">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Gaspard du Nord</rdfs:label>
    <ex:ceasedOnC>14th century</ex:ceasedOnC>
    <ex:hasAnnotation>13th century 14th century Sorcerer Human First appearance CIRCLE : " The Colossus of Ylourgne " Created by Clark Ashton Smith is a fictional character created by Clark Ashton Smith in the 1934 story " The Colossus of Ylourgne ". Part of Smith's Averoigne setting, du Nord is a "student of the proscribed sciences" in 13th century France who uses his magic to save the city of Vyônes from an attack by the necromancer Nathaire . After defeating Nathaire's Colossus, Smith writes, du Nord "lived in much honor to a ripe age, being the one sorcerer of that region who at no time incurred the disapprobation of the Church." Du Nord also produced a French translation of the Book of Eibon . ( CIRCLE : " The Coming of the White Worm ", EXP : " History and Chronology of The Book of Eibon ")</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Colossus_of_Ylourgne"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Jacob_Maitland">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
