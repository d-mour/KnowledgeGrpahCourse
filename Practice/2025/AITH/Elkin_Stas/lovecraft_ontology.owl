  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Pulse_Pounders">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleFilmAndTelevisionAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Pulse Pounders</rdfs:label>
    <ex:hasAnnotation>United states english is a 1988 horror anthology b-movie from american charles band . One of the segments is an adaptation of the h. p. lovecraft short story " the evil clergyman " .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Evil_Clergyman"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
