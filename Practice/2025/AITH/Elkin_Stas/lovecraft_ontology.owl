  <rdf:Description rdf:about="http://example.org/lovecraft#Teenage_Mutant_Ninja_Turtles">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Teenage Mutant Ninja Turtles</rdfs:label>
    <ex:hasAlternativeNamesC>Ninja Turtles</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The ninja turtles are a group of turtles that became anthropomorphic after being exposed to a substance known as mutagen . They first appeared in mirage studios' 1984 comic book series of the same name . The turtles have appeared in numerous other comics, animated series, movies and video games .</ex:hasAnnotation>
    <ex:hasAppearanceC>Men of Shadow Circle of Darkness In the Dark Infestation 2 Splinter No More The Darkness Within The Cosmic Ocean</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC>Teenage Mutant Ninja Turtles #1</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Kevin Eastman</ex:wasCreatedByC>
    <ex:wasCreatedByC>Peter Laird</ex:wasCreatedByC>
  </rdf:Description>
