    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Suppressed Memories</rdfs:label>
    <ex:hasAnnotation>Kara Centell-Dunk Nikki Valens Fantasy Flight Games Publication Date 2013, 2016 Mansions of Madness is an expansion pack for Fantasy Flight Games ' Mansions of Madness Cthulhu Mythos board game. Designed by Kara Centell-Dunk and Nikki Valens , it was first published in 2013 and re-issued in 2016. Overview</ex:hasAnnotation>
    <ex:wasPublishedOnW>2016 2013</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crypt_of_Cthulhu_Candlemas_1989">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crypt of Cthulhu Candlemas 1989</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Allen Koszowski English Cryptic Publications Release Date February 1989 72 Preceded by Yuletide 1988 1/2 Followed by Eastertide 1989 is the 62nd issue of the long-running Lovecraftian fanzine Crypt of Cthulhu . Edited by leading Lovecraft scholar Robert M. Price , it was published by Cryptic Publications in February 1989 and featured cover art from Allen Koszowski This issue is a special, being dedicated to the late American and friend of Lovecraft's, Robert A. W. Lowndes (although Lowndes was still alive at the time of publication). Contents Editorial Shards by Robert M. Price "Leapers" by Robert A. W. Lowndes "Settler's Wall" by Robert A. W. Lowndes "Forbidden Books" by Robert A. W. Lowndes "The Burowers Beneath" by Robert A. W. Lowndes "Two Letters from Lovecraft" by H. P. Lovecraft " Lowndes, Lovecraft and the Health Knowledge Years " by Mike Ashley "On Forbidden Knowledge" by Robert A. W. Lowndes " On H. P. Lovecraft's Views of Weird Fiction " by Robert A. W. Lowndes Reviews by Stefan Dziemianowicz Letters by Diana F. Goddesswinne, Richard L. Tierney , Kathy Corcoran, Andreas Stading, Thomas R. Hall, III, Mike Morrison, and Robert A. W. Lowndes</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>72</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>February 1989</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Where_Howls_the_Edgog">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Where Howls the Edgog</rdfs:label>
    <ex:hasAnnotation>The call of poohthulhu is a lovecraftian short story set in the world of a. a. milne's children's character winnie-the-pooh . Written by american pete rawlik, it was published in the anthology the call of poohthulhu by april moon books in may 2022 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Peter_Rawlik"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Call_of_Poohthulhu"/>
    <ex:wasPublishedOnW>May 2022</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Call_and_Response">
    <rdf:type rdf:resource="http://example.org/lovecraft#Crossovers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Call and Response</rdfs:label>
    <ex:hasAnnotation>"slaves for the slaughter sect" is a short story by scottish-born william meikle . It crosses over the arkham detective agency with meikle's own midnight eye files . It was written by meikle at the request of writer brian m. sammons .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Pulp Mystery</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Arkham_Detective_Agency"/>
    <ex:isPartOfSeriesW>Midnight Eye Files</ex:isPartOfSeriesW>
    <ex:wasPublishedOnW>November 2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#John_D._Haefele">
    <rdf:type rdf:resource="http://example.org/lovecraft#NonFictionAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Scholars"/>
    <rdfs:label>John D. Haefele</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Scholar https://allied-authors.org/our-members/john-haefele/ is an author and literary critic with a focus on the Cthulhu Mythos . His books include A Look Behind the Derleth Mythos and Lovecraft: The Great Tales . Selected Works Lest We Forget: August Derleth on the Subject of H. P. Lovecraft (2009) A Look Behind the Derleth Mythos (2013) Lovecraft: The Great Tales (2021)</ex:hasAnnotation>
    <ex:hasWebsiteR>https://allied-authors.org/our-members/john-haefele/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Scholar</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Eigenspace_X">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Eigenspace X</rdfs:label>
    <ex:hasAnnotation>Is a lovecraftian short story by english mike chinn . It was published in the thematic anthology pickman's gallery by ulthar press in 2018 .</ex:hasAnnotation>
    <ex:hasAuthorW>Mike Chinn</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Pickmans_Gallery"/>
    <ex:wasPublishedOnW>2018</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecraft_Mythos:_New_%26_Classic_Collection">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraft Mythos: New &amp; Classic Collection</rdfs:label>
    <ex:hasAnnotation>Various English Gothic Fantasy Flame Tree Press Release Date October 2022 480 is an anthology of both brand new and selected classic Lovecraftian works. Running to a total of 480 , it was published by Flame Tree Press in a hardcover format in October 2020 . Overview Contents Foreword by Ramsey Campbell " Haita the Shepherd " by Ambrose Bierce " Notebook Found in a Deserted House " by Robert Bloch "Cthulhu-Seltzer" by Hal Bodner "Offspring" by Traci Castleberry (as Evey Brett) " The Franklyn Paragraphs " by Ramsey Campbell " The Yellow Sign " by Robert W. Chambers "Foxfire Future" by Helen E. Davis " The Return of Hastur " by August W. Derleth "The Kith of the Elf-Folk" by Lord Dunsany "Grave Secrets" by J. G. Faherty "He Opens a Window" by Cody Goodfellow " The Fire of Asshurbanipal " by Robert E. Howard " Worms of the Earth " by Robert E. Howard "The Innsmouth of the South" by Rachael K. Jones "The Damage" by Scott R. Jones " Black Ships Seen South of Heaven " by Caitlin R. Kiernan "Always a Castle?" by Nancy Kilpatrick " The Hunt " by Henry Kuttner "Let It Stand" by N. R. Lambert "Up from Slavery" by Victor LaValle "Diary in the Snow" by Fritz Leiber " The Hounds of Tindalos " by Frank Belknap Long " Dagon " by H. P. Lovecraft " The History of the Necronomicon " by H. P. Lovecraft " Nyarlathotep " by H. P. Lovecraft " The Call of Cthulhu " by H. P. Lovecraft " The Colour Out of Space " by H. P. Lovecraft " The Curse of Yig " by Zealia Bishop and H. P. Lovecraft " Out of the Eons " by Hazel Heald and H. P. Lovecraft " The Great God Pan " by Arthur Machen "The Whisper of Stars" by Thana Niveau "My First Abomination" by John Possidente "By Any Other Name" by John Llewellyn Probert "A Gentleman from Mexico" by Mark Samuels " The Beast of Averoigne " by Clark Ashton Smith "Usurped" by William Browning Spencer "Entirely Surrounded by Water" by R. S. Stefoff "Shed a Tear for Asenath" by Jonathan Thomas "Cloaca Maxima" by Donald Tyson "Tracking the Black Book" by Douglas Wynne References</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>480</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Gothic Fantasy</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>October 2022</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Rodriguez">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Rodriguez</rdfs:label>
    <ex:ceasedOnC>1925</ex:ceasedOnC>
    <ex:hasAnnotation>1925 Portugal Human First appearance HPL : " The Call of Cthulhu " Created by H. P. Lovecraft is a fictional character created by H. P. Lovecraft , who makes his only appearance in the 1928 short story " The Call of Cthulhu ". Overview Parker was a member of the Emma of Auburn, although his role is uncertain. While investigating the island of R'lyeh with the other crew members, discovered Cthulhu 's mausoleum atop a monolith. When Donovan successfully opened the immense door, Cthulhu emerged, killing Donovan, Guerrera and Angstrom . 's fate isn't made explicit, but as he did not escape the island with Gustaf Johansen and William Briden , his death by Cthulhu may have simply gone unwritten, or he might have been swallowed with Cthulhu when R'lyeh re-submerged.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Call_of_Cthulhu"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Visions_from_Brichester">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RamseyCampbellWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Visions from Brichester</rdfs:label>
    <ex:hasAnnotation>Ramsey Campbell Randy Broecker Cover Artist Randy Broecker English PS Publishing Release Date August 2015 is a collection of Lovecraftian horror stories by veteran British Ramsey Campbell . Featuring cover and interior artwork by Randy Broecker, it was issued in a hardcover format by PS Publishing in August 2015; a paperback edition was released in May 2018 . Overview Contents " The Stone on the Island " " Before the Storm " " Cold Print " " The Franklyn Paragraphs " " A Madness from the Vaults " " Among the Pictures Are These " " The Tugging " " The Faces at Pine Dunes " " Blacked Out " "The Voice of the Beach" "The Horror Under Warrendown" "The Other Names" "The Correspondence of Cameron Thaddeus Nash" "The Last Revelation of Gla'aki" "The Successor" " The Franklyn Paragraphs " (first draft) "Mushrooms from Merseyside" "Two Poems by Edward Pickman Derby: Azathoth" "Two Poems by Edward Pickman Derby: Vision of a Shoggoth" "The Horror in the Crystal" (fragment) "Rusty Links" "Lovecraft in Retrospect" "On Four Lovecraft Tales" Afterword by Ramsey Campbell Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>August 2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#P._J._Roberts">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>P. J. Roberts</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Lovecraftian horror Years Active 1989-2002 is an author and poet who has written a number of works of Lovecraftian horror . These have mostly appeared in fanzines including EOD , Cthulhu Cultus , Imelod , and Mythos Collector . Roberts' non- Cthulhu Mythos works include the short novel The Dream-Time Warriors , serialised in the fanzine Alien Worlds from February to May 2001. Selected Bibliography Short Fiction "I Am Nyarlathotep!" (1991) "Hastur-the-Unspeakable" (1998) Poetry "Cthulhu's Messengers" (1998) "Shoggoths" (1998) "The Burrowers Beneath" (1998) External Links at the Internet Speculative Fiction Database</ex:hasAnnotation>
    <ex:hasYearsActiveR>1989-2002</ex:hasYearsActiveR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Night_Gallery">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleFilmAndTelevisionAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MediaAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Night Gallery</rdfs:label>
    <ex:hasAnnotation>United states english was a horror anthology tv series created by rod serling that aired for three seasons on nbc from december 16, 1970, to may 27, 1973 . Its episodes included adaptations of h. p. lovecraft short stories, along with segments that took a more light-hearted look at the cthulhu mythos .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW>Individual episodes are based on various Lovecraft stories</ex:isBasedOnW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1969 (pilot) November 8</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Statement_of_Randolph_Carter">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Statement of Randolph Carter</rdfs:label>
    <ex:hasAnnotation>The terrible old man" is a short story by h. p. lovecraft . It tells of a traumatic event in the life of randolph carter . It is the first story in which carter appears, and is part of lovecraft's dream cycle .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>thrill</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>1920 May</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Escape_from_Innsmouth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Escape from Innsmouth</rdfs:label>
    <ex:hasAnnotation>Kevin A. Ross et al United States English Call of Cthulhu Genre(s) Roleplaying game Chaosium Release Date 1992 is a scenario and setting supplement for Chaosium 's Call of Cthulhu roleplaying game first released in 1992. A second edition was released in 1997. Overview Written by Kevin A. Ross et al, the book contains background information on the shadowy, Deep One -haunted town of Innsmouth , the raid which resulted in the destruction of most of the town, and a selection of stand-alone player scenarios set within the town limits. External Links Review of at RPG.net Gallery</ex:hasAnnotation>
    <ex:hasAuthorW>Kevin A. Ross et al</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>1992</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Welcome_to_Miskatonic_University">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Welcome to Miskatonic University</rdfs:label>
    <ex:hasAnnotation>Various Yves Tourigny Cover Artist Michael Bukowski English Broken Eye Books Release Date July 2019 249 Followed by It Came from Miskatonic University is an anthology of Lovecraftian fiction edited by C. Dombrowski and Scott Gable . Running to a total of 249 , it was published through Gable's small press Broken Eye Books in July 2019; hardcover, paperback, and digital editions all received a release. Overview Contents "Some Muses Are Not Gentle" by Brandon O'Brien "Glory Night" by Bennett North "The Long Hour" by Kristi DeMeester "The Needle's Eye of Nothingness" by Elliot Cooper "Through Cryptic Caverns, the Shoggoths Come at Night" by Liz Schriftsteller "Official Inquiry Into the Waite-Gilman-Carter Antarctic Expedition" by K. G. McAbee "Wyrd Science" by Brenda Kezar "Something Beautiful" by Nate Southard "The Steeplechase" by Scott R. Jones "From the Inbox of Madness" by Gina Marie Guadagnino "Beyond the Surface" by Joseph S. Pulver, Sr. "Like Candles in a Passing Breeze" by Marcus Chan "A Lost Student's Handbook for Surviving the Abyss" by Gwendolyn Kiste "My Miskatonic: A Who's Who of Arkham" by Matthew M. Bartlett</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>249</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>July 2019</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#C._J._Henderson">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonFictionAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>C. J. Henderson</rdfs:label>
    <ex:diedOnR>4 July 2014</ex:diedOnR>
    <ex:hasAnnotation>Chris "c. J." Henderson (26 december 1951 - 4 july 2014) was an american writer of horror, science fiction, pulp crime, nonfiction and comic books . His contributions to the cthulhu mythos include the escapades of private detectives teddy london and frank nardi . Cited h. p. lovecraft as one of his favourite authors .</ex:hasAnnotation>
    <ex:hasFullNameR>Chris C. J. Henderson</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Writer</ex:isConnectedToMythosR>
    <ex:wasBornOnR>26 December 1951</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yag-Ath-Vermellus">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Yag-Ath-Vermellus</rdfs:label>
    <ex:hasAnnotation>Background (aka, the hungry one) is a ravenous god which seethes with hatred that is older than the universe, born into icy realms of ancient horrors . One of its keys encountered humans millions of years ago, creating the first vampire . Its offspring are tentacled balls of flesh with fanged mouths and some of them have those tentacles coming out of their face .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#My_Boat">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>My Boat</rdfs:label>
    <ex:hasAnnotation>The story ties in explicitly to h. p. lovecraft 's dreamlands stories . A writer, jim, is in a restaurant, telling his agent milty a story about two kids he knew in high school in 1952 . The two kids transform from awkward teenagers to heroic characters out of fantasy .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Joanna_Russ"/>
    <ex:isPublishedAsW>Science Fiction</ex:isPublishedAsW>
    <ex:isPublishedAsW>The Magazine of Fantasy</ex:isPublishedAsW>
    <ex:wasPublishedOnW>January 1976</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Donald_A_Wollheim">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Donald A Wollheim</rdfs:label>
    <ex:diedOnR>1990</ex:diedOnR>
    <ex:hasAnnotation>Editor of the Phantagraph and Fanciful Tales and prolific author and editor in the science fiction field.</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1914</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Metal_Monster">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Metal Monster</rdfs:label>
    <ex:hasAnnotation>A. merritt argosy all-story weekly date 1920 is an abraham merritt fantasy novel . It is a sequel to his earlier novel, featuring the character walter t. goodwin . The epic adventure starts with a foreword where merritt is assigned the duty to relay goodwin's tale to the world .</ex:hasAnnotation>
    <ex:hasAuthorW>A. Merritt</ex:hasAuthorW>
    <ex:isPublishedAsW>Argosy All-Story Weekly</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1920</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nyarlathotep_%282007_comic_book%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Nyarlathotep (2007 comic book)</rdfs:label>
    <ex:hasAnnotation>Nyarlathotep H. P. Lovecraft (original story) Rotomago (adaptation) Julien Noirel (adaptation) France French Akileos Release Date February 2007 Media Type Comic book Nyarlathotep is a French- comic book adaptation of the H. P. Lovecraft short story of the same name . Published by Akileos, it was developed for the comic book medium by Rotomago and Julian Noirel and released in February 2007.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasAuthorW>Julien Noirel</ex:hasAuthorW>
    <ex:hasAuthorW>Rotomago</ex:hasAuthorW>
    <ex:hasCountryOfOriginW rdf:resource="http://example.org/lovecraft#France"/>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:wasReleasedOnW>February 2007</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kaliri">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdfs:label>Kaliri</rdfs:label>
    <ex:hasAnnotation>Congo river basin Human First appearance " Facts Concerning the Late Arthur Jermyn and His Family " Created by H. P. Lovecraft The are a fictional Congo river basin tribe which appeared in H. P. Lovecraft 's short story " Facts concerning the Late Arthur Jermyn and His Family ". Overview A man named Mwanu was the tribal chief when Arthur Jermyn arrived on a mission to investigate his past. The name may be a reference to the Congolese surname "", whose meaning is unknown.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Facts Concerning the Late Arthur Jermyn</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>His Family</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Plateau_of_Leng">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Plateau of Leng</rdfs:label>
    <ex:hasAccessibilityL>Various</ex:hasAccessibilityL>
    <ex:hasAnnotation>Leng is a fictional created by h. p. lovecraft , a cold, arid plateau whose seems to vary entirely according to different accounts . It is inhabited by satyr -like degenerates known as the men of leng . It is also the dwelling place of the high priest not to be described in a prehistoric monastery .</ex:hasAnnotation>
    <ex:hasAppearanceL>The Hound Fungi from Yuggoth The Whisperer in Darkness At the Mountains of Madness The Horror in the Museum Through the Gates of the Silver Key Out of the Aeons The Dream-Quest of Unknown Kadath Passing of a Dreamer CthulhuTech Leng</ex:hasAppearanceL>
    <ex:hasNotableFeatureL>The Ruins of an Elder Thing City</ex:hasNotableFeatureL>
    <ex:hasTypeL>Dimensional Anomaly</ex:hasTypeL>
    <ex:isInhabitedByL>Elder Things (formerly) The Men of Leng The Spiders of Leng The High Priest Not to Be Described</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Earth"/>
    <ex:isLocatedAtL>The Dreamlands</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#Celepha%C3%AFs"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#wasWrittenOnW">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>wasWrittenOnW</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Uhluhtc">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Uhluhtc</rdfs:label>
    <ex:hasAnnotation>Cthulhu is the primary god worshipped by the antagonists in the den series of comics and graphics novels by richard corben . It is also the source of the locnar or loc-nar, the single most powerful magical artefact of neverwhere . The world of den is an amoral one where most of the characters shift in attributes, attitudes and even appearance.</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Joanna_Russ">
    <rdf:type rdf:resource="http://example.org/lovecraft#Critics"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Joanna Russ</rdfs:label>
    <ex:diedOnR>29 April 2011</ex:diedOnR>
    <ex:hasAnnotation>Author, critic and radical feminist born in new york city in 1937 and died in 2011 in arizona . She was an accomplished science fiction author and contributed work to the cthulhu mythos inspired by the works of the late howard phillips lovecraft .</ex:hasAnnotation>
    <ex:hasBirthplaceR>New York USA http://example.org/lovecraft#New_York_City</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Critic</ex:isConnectedToMythosR>
    <ex:wasBornOnR>22 February 1937</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Windows_to_the_Soul">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Windows to the Soul</rdfs:label>
    <ex:hasAnnotation>Tim Kane English Rogue Planet Press Lovecraftiana Vol 5, Issue 2 date July 2020  " " is a Lovecraftian short story by American Time Kane. It was published in Vol 5, Issue 2 of the Lovecraftiana zine by Rogue Planet Press in July 2020. Synopsis In a city in which the vacant-eyed homeless population is dramatically increasing, two men find themselves stranded late at night after an evening's carousing. As they attempt to navigate their way home, they encounter a grisly murder scene where the victim's eyes have been removed. Cutting through a construction site to try and regain the main drag, they enter a pool of blackness which consumes one of the men and leaves the other a slack-jawed wreck destined to live his life on the streets, his mind shattered by what he witnessed while the rest of the city slept.</ex:hasAnnotation>
    <ex:hasAuthorW>Tim Kane</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 2</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 5</ex:isPublishedAsW>
    <ex:wasPublishedOnW>July 2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Hound_Amulet">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MysticalArtefacts"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Hound Amulet</rdfs:label>
    <ex:hasAnnotation>Cursed amulet is the centerpiece of h. p. lovecraft 's short story " the hound " it was found by two graverobbers around the neck of a dead man . Skeleton was remarkably intact aside from the skull which was shattered prior to death by some unidentified animal .</ex:hasAnnotation>
    <ex:hasTypeA>Mystical Artefact</ex:hasTypeA>
    <ex:madeFirstAppearanceOnA>The Hound</ex:madeFirstAppearanceOnA>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Fire_Vampire">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ServitorRaces"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Fire Vampire</rdfs:label>
    <ex:hasAnnotation>Fire vampires of fthaggua are living extensions of the cosmic entity known as fthaggua . They appear as bluish electrical discharges resembling lightning . The victim will burst into flames during this process, with the fire vampires consuming their essence and memories using heat instead of internal metabolization .</ex:hasAnnotation>
    <ex:hasDistinctionC>Energy-based lifeform</ex:hasDistinctionC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Fire_Vampires"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Donald_Wandrei"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Watcher">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ServitorRaces"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Watcher</rdfs:label>
    <ex:hasAnnotation>Real World Information First appearance EXP : Dwellers in Shadow , Scenario: " in the Bayou" Created by Mark Eley The Watchers are giant leeches created for Chaosium 's Call of Cthulhu horror role-playing game. They made their first appearance in the 1996 scenario supplement Dwellers in Shadow . Description The Watchers are giant leeches with three tentacles below its mouth. They are employed by the Great Old Ones to guard important locations.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Dwellers in Shadow</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>Scenario: Watcher in the Bayou</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Mark Eley</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#GamingSupplements">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Work"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Moit_of_Shub-Niggurath">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Moit of Shub-Niggurath</rdfs:label>
    <ex:hasAnnotation>The are a fictional race created by paizo in 2011 for the pathfinder roleplaying game . The are spawn of the outer god, shub-niggurath . They start out as slugspawn, but can be killed or removed .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Wake of the Watcher</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Greg A. Vaughan</ex:wasCreatedByC>
    <ex:wasCreatedByC>James Jacobs</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Book_of_Thoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Book of Thoth</rdfs:label>
    <ex:hasAnnotation>The is an ancient egyptian text referenced by abdul alhazred in the necronomicon who claims it warns of the "price of a single glimpse" of what lies beyond the ultimate gate . The is a name given to many ancient egyptian texts supposed to have been written by thoth, the egyptian god of writing and knowledge . One book in particular is referred to in an ancient egyptian story from the ptolemaic period, and this was a spellbook similar to a more modern grimoire</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#Through_the_Gates_of_the_Silver_Key"/>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dream-Quest_of_Unknown_Kadath">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dream-Quest of Unknown Kadath</rdfs:label>
    <ex:hasAnnotation>The case of charles dexter ward is a novella by h. p. lovecraft (1890–1937) it is both the longest of the stories that make up his dream cycle . It is also the longest lovecraft work to feature protagonist randolph carter .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasGenreW>Fantasy novella</ex:hasGenreW>
    <ex:hasGenreW>weird fiction</ex:hasGenreW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Dream_Cycle"/>
    <ex:isPartOfSeriesW>Cthulhu Mythos</ex:isPartOfSeriesW>
    <ex:wasPublishedOnW>1943</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dreaming_in_Rlyeh">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dreaming in R'lyeh</rdfs:label>
    <ex:hasAnnotation>C. Brut C. Brut English Annual 2003 Final Publication 2005 was a short-lived magazine dedicate to Cthulhu Mythos works. It was edited by C. Brut and ran to three issues between 2003 and 2005; a fourth issue was announced, but never made it to the publication stage. Several of the more prominent up-and-coming Mythos authors of the time were published in Dreaming in R’lyeh , including Jeffrey Thomas , Stanley C. Sargent , Ran Cartwright , Lee Clark Zumpe , David Conyers and Brian M. Sammons . Issues Issue 1 Issue 2 Issue 3 Gallery</ex:hasAnnotation>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ngyr-Khorath">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OuterGods"/>
    <rdfs:label>Ngyr-Khorath</rdfs:label>
    <ex:hasAffiliationC>Cult of Ngyr-Khorath</ex:hasAffiliationC>
    <ex:hasAffiliationC>Outer Gods</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Gir-Chorath</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Moroka</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Dream-Death</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Great Shadow</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Mad God of the Void</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Ultimate Abomination</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>'ymnar is an entity featured in the so-called mlandoth cycle by walter c. debill jr. it has existed in the area now home to the solar system since before the sun and planets formed .</ex:hasAnnotation>
    <ex:hasAppearanceC>Barrett Horror</ex:hasAppearanceC>
    <ex:hasAppearanceC>Walter C. DeBill Jr.</ex:hasAppearanceC>
    <ex:isLocatedAtC>Deep Space</ex:isLocatedAtC>
    <ex:madeFirstAppearanceOnC>Walter C. DeBill Jr.</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Walter C. DeBill Jr.</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#George_Julian_Houtain">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>George Julian Houtain</rdfs:label>
    <ex:diedOnR>21 August 1945</ex:diedOnR>
    <ex:hasAnnotation>Connection to the Mythos Publisher of Home Brew Birth Date 26 November 1884 Brooklyn, New York, USA Death Date 21 August 1945 American E. Dorothy MacLaughlin (26 November 1884-21 August 1945 ) was an American amateur journalist and President of the National Amateur Press Association (1915-17) who established the Home Brew magazine with his wife E. Dorothy MacLaughlin. As the editor of The Zenith , Houtain met H. P. Lovecraft in July 1920 at a Boston amateur convention. He wrote the article "20 Webster Street: Lovecraft" for the January 1921 Issue before meeting Lovecraft in Boston again on February 22, 1921. He went on to establish Home Brew and was the first person to commission Lovecraft for a professional work of fiction ( Herbert West--Reanimator ). Selected Works Non-Fiction Works "20 Webster Street: Lovecraft" (1921) "Amateur Writings" (1921) References</ex:hasAnnotation>
    <ex:hasBirthplaceR>Brooklyn New York USA</ex:hasBirthplaceR>
    <ex:hasNationalityR>American</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Publisher of Home Brew</ex:isConnectedToMythosR>
    <ex:wasBornOnR>26 November 1884</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Michel_Mauvais">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Michel Mauvais</rdfs:label>
    <ex:hasAnnotation>Powers and Abilities Magic Offspring Charles le Sorcier (son) Alchemist Human First appearance HPL : " The Alchemist " Created by H. P. Lovecraft was a thirteenth-century French alchemist and black magician in the story " The Alchemist " by H. P. Lovecraft . Michel and his son Charles le Sorcier lived in a cottage on the estates of the Comte Henri de C-- . When Henri's young son Godfrey went missing, Michel was blamed due to his evil reputation and was murdered by the wrathful Henri based on nothing more than suspicion. Michel had been killed unjustly, for Godfrey was later found by family servants, alive and wandering in an unused part of the castle. In revenge for the slaying of his father, Charles le Sorcier cursed Henri's entire family line and killed him with lethal poison thrown in his face before escaping into the forest.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Alchemist"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nyarlathotep:_The_Man_With_No_Face">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Nyarlathotep: The Man With No Face</rdfs:label>
    <ex:hasAnnotation>The faceless man, an avatar of the outer god nyarlathotep, travels north america making converts by the townful and inciting terrible acts of violence . At the height of the phenomena, everything inexplicably stops, and the world quickly forgets the horrors . However, the movement has simply gone underground, and the faceless man still travels the world, leaving violence in his wake .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Sebastian_Greaves"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Cthulhu Mythos Anthology</ex:isPublishedAsW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yha-nthlei_Rising_and_Other_Tales_of_the_Deep_Ones">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Y'ha-nthlei Rising and Other Tales of the Deep Ones</rdfs:label>
    <ex:hasAnnotation>Ran Cartwright Cover Artist Steve Lines United States English Rainfall Books Release Date November 2006 37 is a collection of short Cthulhu Mythos works by American Ran Cartwright . Overview Containing two short stories and a novelette thematically linked through the Deep Ones created by H. P. Lovecraft , was first published by Rainfall Books in November 2006 with cover art provided by Steve Lines . It runs to a total of 37 . Contents " Innsmouth Harvest " " Y'ha-nthlei Rising " " Of Gods &amp; Aliens "</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ran_Cartwright"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>37</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>November 2006</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Professor_Mayfield">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Professor Mayfield</rdfs:label>
    <ex:hasAffiliationC>Massachusetts Institute of Technology</ex:hasAffiliationC>
    <ex:hasAnnotation>1800s Professor Massachusetts Institute of Technology Human First appearance " The Green Meadow " Created by H. P. Lovecraft Elizabeth Berkeley analysed samples of the metallic rock-like object that landed off the coast of Potowonket, Maine on Wednesday, August 27, 1913, at approximately 8:30 PM. Mayfield declared the object a meteorite.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Green_Meadow"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasCreatedByC>Elizabeth Berkeley</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nug_and_Yeb">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Nug and Yeb</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAffiliationC>Lesser Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Twin Blasphemies</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as the great old ones outer space relatives shub-niggurath ('mother') yog-sothoth ('father') wilbur whateley (half-brother) tsathoggua (yeb's spawn)</ex:hasAnnotation>
    <ex:hasAppearanceC>The Mound Out of the Aeons</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Last_Test"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#June_Skies">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>June Skies</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft English Genre(s) Non-fiction Donald M. Grant To Quebec and the Stars Date of writing June 1916 date 1976 " " is a short non-fiction work by the late American Howard Phillips Lovecraft . Although it was written in June 1916, it did not see until its inclusion in L. Sprague de Camp 's 1976 collection To Quebec and the Stars . It does not appear to have been republished in the years since . References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>To Quebec</ex:isPublishedAsW>
    <ex:isPublishedAsW>the Stars</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1976</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>June 1916</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Way_Things_Are,_the_Way_Things_Will_Be">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Way Things Are, the Way Things Will Be</rdfs:label>
    <ex:hasAnnotation>John Wolf English Deadman's Tome Deep Fried Horror Cthulhu Cheese Burger date January 2020  " " is a Lovecraftian short story by John Wolf. It was published in the Deadman's Tome anthology Deep Fried Horror Cthulhu Cheese Burger in January 2020. Synopsis The story tells of the employees of a small market store which harbours a dark secret: the waste chute in the warehouse blesses the town with prosperity, but must be fed and kept in the way in which it has always been. The arrival of a new manager with radical ideas on how to shake things up in the store forces the employees to take action to save their way of life.</ex:hasAnnotation>
    <ex:hasAuthorW>John Wolf</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Deep_Fried_Horror_Cthulhu_Cheese_Burger"/>
    <ex:wasPublishedOnW>January 2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bran_Mak_Morn">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RobertEHowardWorks"/>
    <rdfs:label>Bran Mak Morn</rdfs:label>
    <ex:hasAnnotation>Bran is a fictional barbarian hero created by robert e. howard . He is the last king of the cruithni picts . He is worshipped as the demigod the "dark one" by scottish and irish tribesmen of pictish descent .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Blessed_of_Shub-Niggurath">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ServitorRaces"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Blessed of Shub-Niggurath</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Shub-Niggurath"/>
    <ex:hasAlternativeNamesC>Goat-Faced People</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Goblins</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Gof'n hupadgh Shub-Niggurath</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Satyrs</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Spawn of Shub-Niggurath</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The young of the black goat or goblins are a fictional race from ramsey campbell's 1964 short story " the moon-lens ". They are servants and priests of shub-niggurath, resembling satyrs of myth . They were expanded on by chaosium in 1994 for their call of cthulhu role-playing game .</ex:hasAnnotation>
    <ex:hasAppearanceC>Call of Cthulhu</ex:hasAppearanceC>
    <ex:hasDistinctionC>Humanoids with goatish features</ex:hasDistinctionC>
    <ex:hasDistinctionC>hooved feets</ex:hasDistinctionC>
    <ex:hasDistinctionC>horns resplendent on their heads. Some are a mockery of humanity</ex:hasDistinctionC>
    <ex:hasDistinctionC>more beast than man</ex:hasDistinctionC>
    <ex:hasDistinctionC>with blood strong with the taint of faery</ex:hasDistinctionC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Moon-Lens"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Horn_of_Azoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Horn of Azoth</rdfs:label>
    <ex:hasAnnotation>Conan the barbarian: is a graphic novel set in robert e. howard's fictional hyboria . It was written by gerry conway and roy . Thomas, using their initial script for the movie conan the . Destroyer . It was pencilled by michael docherty and inked by tony dezuniga .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Roy_Thomas"/>
    <ex:hasAuthorW>Gerry Conway</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>April 1990</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#CrossroadPress">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Work"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Call_of_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Call of Cthulhu</rdfs:label>
    <ex:hasAnnotation>"the horror in clay" concerns a small bas-relief sculpture found among papers . "the horror in clay" concerns a small bas-relief sculpture found among papers . The story is written in a documentary style, with three independent narratives .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Cthulhu Mythos</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Duane_W_Rimel">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Duane W Rimel</rdfs:label>
    <ex:diedOnR>1996</ex:diedOnR>
    <ex:hasAnnotation>Weird fiction fan and late associate of Lovecraft, who revised some of his early tales.</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1915</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#BhYhlun">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Bh'Yhlun</rdfs:label>
    <ex:hasAnnotation>Bh'yhlun is a structure created by the old ones in ian davey 's bh'yhlun series of cthulhu mythos stories . It is a colossal tower which soars many miles into the sky, and across its visible surfaces can be seen the remains of sentient creatures . The interior of bh’yhlun is honeycombed with passageways and cells, and patrolled by servitor shoggoth s.</ex:hasAnnotation>
    <ex:hasOriginL>Creation of the Old Ones</ex:hasOriginL>
    <ex:hasTypeL>Living tower</ex:hasTypeL>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#Nyarlathotep"/>
    <ex:isInhabitedByL>Guardian Shoggoths</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#England"/>
    <ex:isLocatedAtL>The former site of London</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#Black_Letter_Day"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dagon:_War_of_Worlds_%28DART_production%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAudioAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dagon: War of Worlds (DART production)</rdfs:label>
    <ex:hasAnnotation>Dagon: War of Worlds Based on HPL : " Dagon " HPL : The Shadow Over Innsmouth Production Company The H. P. Lovecraft Historical Society Running time 77.35 United States English Dagon: War of Worlds is a Dark Adventure Radio Theatre production by the H. P. Lovecraft Historical Society . Taking Lovecraft's short story " Dagon " and the events of The Shadow Over Innsmouth , it expands upon the history of conflict between humankind and the Deep Ones . Overview As with all DART productions, Dagon: War of Worlds was released in compact disc and digital formats, with the former including a set of period-authentic props to enhance the immersive experience. These include: A U.S. Navy internal circular regarding an incident in the Pacific Ocean A page from the Portsmouth Daily Herald The prison records of a human/Deep One hybrid A classified government memorandum A teletype news bulletin (pre-orders only) Gallery</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#Dagon"/>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Shadow_Over_Innsmouth"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Payback_is_a_Bitch">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Payback is a Bitch</rdfs:label>
    <ex:hasAnnotation>Small-time hoodlum morris hodge, having had his illicit gambling winnings stolen, decides to enact revenge on the man he believes to be responsible . After murdering wendell hawthorne then burying him in a shallow grave, he comes to believe that the ghost of the dead man is haunting him . In an effort to reassure himself that what he is seeing is simply a combination of paranoia and a guilty conscience, he revisits the gravesite</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Looking_for_Darla:_Stories_of_Mythos_Noir"/>
    <ex:wasPublishedOnW>September 2008</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cult_of_Mhar">
    <rdf:type rdf:resource="http://example.org/lovecraft#Cults"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OrganisationsOriginatingFromMythosAdjacentWorks"/>
    <rdfs:label>Cult of Mhar</rdfs:label>
    <ex:hasAnnotation>Mhar's followers are rivals of rovagugs, as they see them as brutish and myopic . Its sacred colours are black and orange . Its symbol is a shattered triangular rune .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Arkham_Asylum">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Arkham Asylum</rdfs:label>
    <ex:hasAnnotation>Arkham sanitarium is a fictional institution in the cthulhu mythos inspired by the works of h. p. lovecraft . It is a sanatarium which exists for the treatment of the mentally ill . Some sources posit that the asylum is not as innocent as it likes to appear .</ex:hasAnnotation>
    <ex:hasPurposeL>Treatment of mental health illnesses</ex:hasPurposeL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Massachusetts"/>
    <ex:isLocatedAtL>The city of Arkham</ex:isLocatedAtL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nightscapes_October_2006">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Nightscapes October 2006</rdfs:label>
    <ex:hasAnnotation>Various English Edward P. Berglund Release Date October 2006 Preceded by May 2003 Followed by December 2006 was the sixteenth issue of online Lovecraftian fanzine Nightscapes . It was edited by the late American and Lovecraft scholar Edward P. Berglund . Contents In addition to the written content listed below, this issue also contains NSFW artwork by Simon Barber. Fiction "God of Vultures" by Carlos Orsi Martinho "Baal-Zabub" by Carlos Orsi Martinho " The One That Got Away " by Ron Shiflet "The Third Door" by Ron Shiflet "The Darkness on the Face of the Deep" by W. Adam Mandelbaum "By Those Ravelled Edges of the Sea" by Dave Dickinson "Lamentry" by Alan D. Peschke "Ambition's Appetite" by Kevin L. O'Brien "A Region Yet Unknown" by Kevin L. O'Brien " Eucred " by Kevin L. O'Brien "A Fidus Aranea" by Kevin L. O'Brien "Barbarians R Us" by Kevin L. O'Brien " October Surprise " by Kevin L. O'Brien "We Deliver" by Kevin L. O'Brien "No Torrent Like Greed" by C. J. Henderson and Kevin L. O'Brien "Let There Be Darkness" by Richard L. Tierney with Kevin L. O'Brien "The Statement of Richard Daniel Upton" by Tani Jantsang "Destiny" by Jerry Baker "Indestructible" by Adrian Kleinbergen Pseudo-Factual Material "The Thing in the Vault" by James Ambuehl "The History and Chronology of the Leabhar Mhéibhe " by Cebhin Ó Briain Non-Fiction "H. P. Lovecraft: An Abductee?" by T. Peter Park "Behind the Veil: An Essay Into the Origins of 'The Outsider'" by David B. Bennett "The Cthulhu Mythos Analyzed as Religion - A Comparison" by Tani Jantsang Parodies "Innsmouth Town" by Geordie Keefe "Cthulhu's Complaint" by Doyle Netzly Poetry " The Crawler " by James A. Gruetzmacher "When I Close My Eyes I See Best" by K. D. Payne "'Grey skies at dusk fall:'" by Phillip A. Ellis " Lovecraftian Cliff Notes for Ech-Pi-El's: The Shadow Out of Time " by Franklyn Searight " Miskatonic University - Pride of the Ivy League " by Franklyn Searight " The Ballad of Black Bart " by James Ambuehl " The Seed from the Stars " by James Ambuehl " Following in Pickman's Footsteps ... " by James Ambuehl Reviews By James Ambuehl , Matthew T. Carpenter , John Goodrich , and Edward P. Berglund External Links full issue online at the Nightscapes website</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>October 2006</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Pnakotus">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Pnakotus</rdfs:label>
    <ex:hasAnnotation>The city of was built millions of years ago by the great race of yith . It is known for its large library, which includes the pnakotic manuscripts . The great race collected information on all eras, both past and present .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Beneath_the_Beardmore">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Beneath the Beardmore</rdfs:label>
    <ex:hasAnnotation>Three adventurers on a trek to the south pole encounter a mysterious stranger . They discover it is in fact an alien creature disguised as a human . The stranger invites them into a vast chasm beneath the mountains . It shows them the opening assault by their forces against the shoggoths .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Michael_Shea"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#A_Mountain_Walked"/>
    <ex:wasPublishedOnW>March 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Vagrant">
    <rdf:type rdf:resource="http://example.org/lovecraft#AmateurPress"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Vagrant</rdfs:label>
    <ex:hasAnnotation>W. Paul Cook W. Paul Cook English 1915 Final Publication 1927 was an amateur press publication edited and published by W. Paul Cook from 1915-27. It was the first outlet for several of Lovecraft's stories, including "Dagon" , sometimes considered the first Cthulhu Mythos story, which appeared in the November 1919 issue, and "The Statement of Randolph Carter" , the first appearance of the recurring character Randolph Carter , which came out in May 1920. Other Lovecraft stories that appeared first in include the juvenilia "The Beast in the Cave" (June 1918), "The Tomb" (March 1922), and (with Winifred V. Jackson ) "The Green Meadow" (Spring 1927). External Links at The Internet Speculative Fiction Database References</ex:hasAnnotation>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Rise_of_Cthulhu:_Dark_Secrets">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Rise of Cthulhu: Dark Secrets</rdfs:label>
    <ex:hasAnnotation>Chuck D. Yager Dragon King Games Publication Date 2016 Competitive card game is an expansion set for the 2015 competitive card game Rise of Cthulhu . Overview Behind the Mythos Released after a successful Kickstarter campaign in 2016, was designed by Chuck D. Yager, features artwork by James Daly III, and was published by Dragon King Games. Contents 6 Artifact Cards 4 Monster Cards 4 Investigator Cards 2 Old One Cards 1 Player Aid Card 1 Wooden Investigator Token Rulesheet Gallery</ex:hasAnnotation>
    <ex:wasPublishedOnW>2016</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cahokia_%28story%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cahokia (story)</rdfs:label>
    <ex:hasAnnotation>"cahokia" is a short story by cody goodfellow . It first appeared in horrors beyond: tales of terrifying realities in 2005 . It was later reprinted in goodfellow's collection rapture of the deep and other lovecraftian tales .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Cody_Goodfellow"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Horrors Beyond: Tales of Terrifying Realities</ex:isPublishedAsW>
    <ex:wasPublishedOnW>April 2005</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Faun">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SpeciesIncorporatedFromFolkloreMythAndReligion"/>
    <rdfs:label>Faun</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Pan"/>
    <ex:hasAnnotation>Fauns are a liminal species originating from greek and roman mythology . In the mythos fauns and satyrs are associates of the god pan and the rest of the greek pantheon . In ancient arcadia, the sculptor kalos would often spend the nights in the woods of mount maenalus .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Poetry</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>the Gods</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Goatswood">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Goatswood</rdfs:label>
    <ex:hasAnnotation>Goatwood is an isolated town in the severn valley, surrounded by woods to the east of brichester . Residents are described as "revoltingly goatlike" and clad in "grotesquely voluminous" garments . Most prominent feature is the titular moon-lens: a metal pylon, 50 feet high, rose from the center of the square .</ex:hasAnnotation>
    <ex:hasNotableFeatureL rdf:resource="http://example.org/lovecraft#The_Moon-Lens"/>
    <ex:hasTypeL>Town</ex:hasTypeL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Severn_Valley"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Moon-Lens"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecraft_Comics_%28J._Scott_Vanlester%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraft Comics (J. Scott Vanlester)</rdfs:label>
    <ex:hasAnnotation>Lovecraft Comics J. Scott Vanlester H. P. Lovecraft J. Scott Vanlester United States English Release Date 2021-2023 Lovecraft Comics is a series of illustrated works by American artist and J. Scott Vanlester . Consisting of five comic book-format adaptations of H. P. Lovecraft stories, two illustrated encyclopaedias on the topic, and one original piece set in the Cthulhu Mythos (which has to date only had the first part released), they were all published between 2021 and 2023; both digital and print editions were released. Oddly, the books are numbered in a way which runs contrary to their release dates: for example, Lovecraft's The Beast in the Cave is labelled as being Book 1 in the series, although it was one of the most recent to be published. Works Lovecraft's The Doom That Came to Sarnath (May 2021) Illustrated Lovecraft Encyclopedia: A Guide to the Cthulhu Mythos (July 2022) The Call of Cthulhu (September 2022) Illustrated Lovecraft Encyclopedia Volume 2: From A Beast in the Cave through Azathoth (April 2023) Lovecraft's Zombie Volume 1 (April 2023) Lovecraft's The Beast in the Cave (July 2023) Lovecraft's The Tomb (October 2023) Lovecraft's The Alchemist (November 2023)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#J._Scott_Vanlester"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2021-2023</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecraftiana_Vol_2,_Issue_1">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Periodicals"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraftiana Vol 2, Issue 1</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Francisco Rico Torres English Rogue Planet Press Release Date April 2017 53  is an issue of the periodical Lovecraftiana , edited by Gavin Chappell and published by Rogue Planet Press in April 2017. Contents "Within the Fires of Rome" by William Gilmer "Nyarlathotep, Inc." by William McCormick "Fall of the Dark God" by Mike Adamson "In the Middle of All That Pretty Stuff" by Nicholas Manzolillo "The Crime of Henri DuCharme" by Jamie Murray "The Eyes of the Abyss" by Sandor Kovacs "The Terror in the Woods" by MJ McClymont "Cold Fires of Dead Candles" by Matthew Wilson</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>53</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>April 2017</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mummy">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Mummy</rdfs:label>
    <ex:hasAnnotation>The concept of undead or reanimated mummies is a common trope in fantasy and horror fiction . Mummification has been widely practiced by the ancient egyptians and incans, among other cultures . The greatest collection of mummies in america is located in the cabot museum's hall of mummies .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Blood_Brothers">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Blood Brothers</rdfs:label>
    <ex:hasAnnotation>Various Earl Geier Cover Artist Lee Gibbons United States English Call of Cthulhu Genre(s) Roleplaying game Chaosium Release Date 1990 144 is a scenario supplement for Chaosium 's Call of Cthulhu roleplaying game, however, it is designed to incorporate villains from classic horror movies as antagonists rather than the more traditional Cthulhu Mythos entities. Written by an ensemble team of games designers, it features cover art by Lee Gibbons , interior work by Earl Geier , runs to a total of 144 , and was published by Chaosium in 1990. An updated digital edition was later issued which is compatible with the most recent (January 2024) edition of Call of Cthulhu . Overview Contents "Uncle Timothy's Will" "Oath of Blood" "Nemesis Strikes!" "The Land That Time Ignored" "The Mummy's Bride" "The Dollmaker" "Ancient Midget Nazi Shamans" "Honymoon in Hell" "Dead On Arrival" "The Swarming" "Spawn of the Deep" "Trick or Treat" "Horror Planet" Contributors Keith Herber Sam Shirley Kevin Ross Gregory W. Detwiler Ben Monroe Scott Clegg Geoff Gillan Barbara Manui Chris Adams Marcus L. Rowland Tony Hickie Michael Szymanski Scott Aniolowski Fred Behrendt External Links at RPG.net at BoardGameGeek Review of (1) at RPG.net Review of (2) at RPG.net</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>144</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>1990</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Christian_Riley">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Christian Riley</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author San Diego, California, USA United States https://chrisrileyauthor.com/homepage/  is an American author who has written a number of speculative fiction pieces. Since moving into more mainstream fiction, he has begun using the name Chris Riley. Selected Bibliography Short Fiction " Ronnie and the River " (2019)</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA http://example.org/lovecraft#California San Diego</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://chrisrileyauthor.com/homepage/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Buopoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonSapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Buopoth</rdfs:label>
    <ex:hasAnnotation>Sociocultural Characteristics The Dreamlands Tropical forests Physical Characteristics Skin colour Felt-like, delicately-coloured Proboscis Real World Information First appearance HPL : The Dream-Quest of Unknown Kadath Created by Howard Phillips Lovecraft Buopoths are a species of extra-dimensional creature created by the late American author H. P. Lovecraft for his novella The Dream-Quest of Unknown Kadath . Description Buopoths are large herbivorous animals with a passing resemblance to terrestrial tapirs. Native to the otherworldly dimension known as the Dreamlands , their preferred is tropical forest, and they are generally peaceful creatures who much prefer to run and hide than confront any potential aggressor . The courtship and mating rituals of the Buopoths are vigorous and noisy, yet pleasing to the ear: for this reason, they are found to be mimicked in the song and dance of many Dreamlands cultures which are aware of the creatures . Gallery References</ex:hasAnnotation>
    <ex:hasDistinctionC>Proboscis</ex:hasDistinctionC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Dream-Quest_of_Unknown_Kadath"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Army_of_Darkness_Vs._Re-Animator">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Army of Darkness Vs. Re-Animator</rdfs:label>
    <ex:hasAnnotation>It appeared in 2005-2006 in issues #1-4 of the 1st volume of army of darkness by dynamicmite entertainment .</ex:hasAnnotation>
    <ex:hasAuthorW>James Kuhoric</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>Sept 2005 - Feb 2006</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Barren">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Barren</rdfs:label>
    <ex:hasAnnotation>" ancientcabal" is a short cthulhu mythos story by american armand rosamilia . It forms the second part of his keyport cthulhu story cycle . A man named bones , who is on the run from his former partners in crime, comes through keyport on his way .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Armand_Rosamilia"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Keyport_Cthulhu"/>
    <ex:wasPublishedOnW>July 2012</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Slaves_for_the_Slaughter_Sect">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Slaves for the Slaughter Sect</rdfs:label>
    <ex:hasAnnotation>"the nest of pain" is a short story by prolific mythos contributor robert m. price . It centres on the character of detective frank nardi, created by c. j. henderson for his arkham detective agency . A man named arlan hellison approaches nardi for help in investigating a series of disappearances in arkham . Despite finding the truth, nardi is double-crossed by hellison, who is secretly a cultist . The ritual</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror Mystery</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Arkham_Detective_Agency"/>
    <ex:wasPublishedOnW>November 2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Influence_of_Vathek_on_H._P._Lovecrafts_The_Dream-Quest_of_Unknown_Kadath">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Influence of Vathek on H. P. Lovecraft's The Dream-Quest of Unknown Kadath</rdfs:label>
    <ex:hasAnnotation>Peter Cannon United States English Genre(s) Non-fiction Ohio University Press H. P. Lovecraft: Four Decades of Criticism date 1980 " " is a short non-fiction work by H. P. Lovecraft scholar Peter Cannon . It was published in the S. T. Joshi -edited critical anthology H. P. Lovecraft: Four Decades of Criticism in 1980.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Peter_Cannon"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft:_Four_Decades_of_Criticism"/>
    <ex:wasPublishedOnW>1980</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Orgesh">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Orgesh</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Great_Old_One"/>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#The_Faceless_God"/>
    <ex:hasAnnotation>Also known as The Faceless God Golarion Great Old One First appearance EXP : Descent into Midnight Created by Wolfgang Baur (also known as the Faceless God ) is a Great Old One created by Paizo Inc for their Pathfinder roleplaying game in 2009. Background is a Great Old One that has a vaguely humanoid form consisting of a large distended belly, canine legs, and featureless face that has a maw full of shark teeth. Its hunger is endless, requiring a constant supply of sacrifices to placate the voracious god. Its origins lay in the Land of Black Blood, being the first of the Charda to be spawned from the black blood.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Descent into Midnight</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Wolfgang Baur</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crypt_of_Cthulhu_Candlemas_1983">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crypt of Cthulhu Candlemas 1983</rdfs:label>
    <ex:hasAnnotation>Crypt of cthulhu candlemas 1983 was the eleventh issue of robert m. price's long-running fanzine . It was edited by price, who also supplied the cover art . It ran to a total of 60 in an a5 format, and was published by miskatonic university press .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>60</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu"/>
    <ex:wasReleasedOnW>February 1983</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Azathoth_%28All-Consuming_Fire%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Azathoth (All-Consuming Fire)</rdfs:label>
    <ex:ceasedOnC>1906</ex:ceasedOnC>
    <ex:hasAffiliationC>Rakshassi</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Azazoth</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>"azazoth" is the name assumed by a giant slug-like alien creature . Originates from the crossover novel all-consuming fire , by andy lane . In the audio play adaptation by big finish, her name is changed to azazoth .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#All-Consuming_Fire"/>
    <ex:wasCreatedByC>Andy Lane</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Silence,_Please">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Silence, Please</rdfs:label>
    <ex:hasAnnotation>Three men descend into the caves beneath a great mountain in search of a rare egg as part of a sacrifice to the great old one tsathoggua . A stupid error causes them to lose their first prize and necessitates a retreat to the surface . But they quickly about-turn and make their way back below again .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ernesto_Canepa"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Sergio_Palumbo"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Swords_Against_Cthulhu_II:_Hyperborean_Nights"/>
    <ex:wasPublishedOnW>January 2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Elder_Thing">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Elder Thing</rdfs:label>
    <ex:hasAlternativeNamesC>Old Ones</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The First</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The elder things are a fictional alien species created by h. p. lovecraft . They were the first alien species to come to the earth about one billion years ago . They stood roughly six feet tall and had the appearance of a huge, oval-shaped barrel .</ex:hasAnnotation>
    <ex:hasAppearanceC>The Dreams in the Witch-House The Shadow Out of Time</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#At_the_Mountains_of_Madness"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Terror_of_the_Tides_%28Call_of_Cthulhu_LCG%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Terror of the Tides (Call of Cthulhu LCG)</rdfs:label>
    <ex:hasAnnotation>The Terror of the Tides Fantasy Flight Games Publication Date 2008 Living Card Game Call of Cthulhu: The Card Game The Terror of the Tides is an expansion pack for Fantasy Flight Games ' Call of Cthulhu: The Card Game . Overview The fourth Asylum Pack in the Summons of the Deep Cycle , The Terror of the Tides consists of three duplicates each of 20 unique cards for a total of 60, and focuses on expanding options in the Arcane Struggle sub-phase of the Story Phase . First released in 2008, it was discontinued with the demise of Call of Cthulhu: The Card Game . Contents Agency Groundskeeper (Character; The Agency) A Call for Help (Event; The Agency) Shortsighted Librarian (Character; Miskatonic University ) Pagan Hall, Science Department (Support; Miskatonic University) Arcane Grifter (Character; Syndicate) Midnight Alley, No Shelter from the Storm (Support; Syndicate) The Terror of the Tides (Character; Cthulhu ) Bite Marks (Support; Cthulhu) Stealthy Byakhee (Character; Hastur ) Coffee House (Support; Hastur) Shadow Sorceress (Character; Yog-Sothoth ) Path of Blood (Event; Yog-Sothoth) Dimensional Worm (Character; Shub-Niggurath ) Summoning Circle (Support; Shub-Niggurath) Descendant of Eibon , No Shelter from the Storm (Character; Neutral) Clever Zoog (Character; Neutral) Struggling Artist (Character; Neutral) Total Eclipse (Event; Neutral) Stealing the Glory (Event; Neutral) Fountain of Youth (Conspiracy; Neutral)</ex:hasAnnotation>
    <ex:wasPublishedOnW>2008</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nightmares_Disciple">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Nightmare's Disciple</rdfs:label>
    <ex:hasAnnotation>Joseph S. Pulver, Sr. United States English Genre(s) Horror Murder Mystery Chaosium Publication date June, 1999 is a Lovecraftian crime novel written by the late Joseph S. Pulver, Sr. and published by Chaosium in 1999. The story features Detective Christopher James Stewart pursuing a serial killer in Schenectady, New York , while following clues that indicate deep links to the Cthulhu Mythos . Synopsis To be added. Behind the Mythos has a similar setting to the Arkham Detective Agency stories that Pulver also wrote.</ex:hasAnnotation>
    <ex:hasAuthorW>Joseph S. Pulver. Sr.</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>Murder Mystery</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>1999 June</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Gobogeg">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Gobogeg</rdfs:label>
    <ex:hasAlternativeNamesC>The Twice-Invoked</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>the Moon-Ladder</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Twice-Invoked, the Moon-Ladder First appearance EXP : Cthulhu Wars board game HPL : At the Mountains of Madness (unnamed) Cthulhu Wars: Great Old One Pack Three Created by Sandy Petersen , the Twice-Invoked , also known as The Moon-Ladder in one the visions seen by Danforth ( HPL : At the Mountains of Madness ) is a powerful Great Old One that appears as a colossal pillar of amorphous alien flesh, with a cyclopean head or eye in the center. ( EXP : Cthulhu Wars: Great Old One Pack Three ) When summoned in, the deity immediately causes a powerful quake that can be felt throughout the entirety of a country or even continent that it is summoned in. To make matters worse, once it is summoned literally drags up the entire continent as it ascends upwards, consequently causing the entire world to cave-in on itself. ( EXP : Cthulhu Wars: Great Old One Pack Three ) Gallery Behind the Mythos It was Sandy Peterson who greatly expanded on the very vague mention of "moon-ladder" and other visions in H. P. Lovecraft 's writings. References</ex:hasAnnotation>
    <ex:hasAppearanceC>Cthulhu Wars: Great Old One Pack Three</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#At_the_Mountains_of_Madness"/>
    <ex:madeFirstAppearanceOnC>Cthulhu Wars board game</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Sandy_Petersen"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Half_Made_Thing">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Half Made Thing</rdfs:label>
    <ex:hasAnnotation>The dark rites of cthulhu was published in the thematic anthology the dark rites of cthulhu by april moon books in march 2014 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#T._E._Grau"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Dark_Rites_of_Cthulhu"/>
    <ex:wasPublishedOnW>March 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Wingate_Peaslee">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Wingate Peaslee</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Miskatonic_University"/>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Wilmarth_Foundation"/>
    <ex:hasAnnotation>Professor is a character created by howard phillips lovecraft for his novella the shadow out of time . He has since been expanded upon by several authors, perhaps most notably brian lumley in his titus crow series of mythos novels . In lumley's series, peaslee is now a member of the wilmarth foundation, an organisation dedicated to combating the forces of the cthulhu mythos on earth .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Burrowers_Beneath"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Clock_of_Dreams"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Shadow_Out_of_Time"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Arkham_Advertiser">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdfs:label>Arkham Advertiser</rdfs:label>
    <ex:hasAnnotation>The advertiser is a fictional newspaper created by the late american author howard phillips lovecraft . It does not play any appreciable role in lovecraft's works, but other contributors to the mythos have expanded upon it . Commissioned a series of thematic props, several of which are mock-ups of articles from the advertiser designed to complement the stories .</ex:hasAnnotation>
    <ex:hasPurposeO>New distribution</ex:hasPurposeO>
    <ex:hasTypeO>Newspaper publisher</ex:hasTypeO>
    <ex:wasCreatedBynO rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Gary_Sumpter">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Gary Sumpter</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Games Designer Author Horror is a games designer and occasional author perhaps best known for his work on Chaosium 's seminal horror roleplaying game Call of Cthulhu . His short fiction has appeared in anthologies such as Made in Goatswood (1995, Chaosium) and Return to Lovecraft Country (1997, Triad Entertainments) . Selected Bibliography Short Fiction "The Awakening" (1995) "The Hitch" (1997) Gaming Supplements King of Chicago (1994, contributor) In the Shadows (1995) Before the Fall (1998, contributor) Ramsey Campbell's Goatswood and Less Pleasant Places (2001) Terrors From Beyond (2009, contributor) External Links at the Internet Speculative Fiction Database at RPGGeek References</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Games Designer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Avaloth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Avaloth</rdfs:label>
    <ex:hasAlternativeNamesC>Destroyer of Worlds</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Ithaqua is an invisible creature with slender tentacles, strong enough to break every bone of a man's body, and drain its victims of blood . Created by richard f. searight for his short story " the sealed casket " also mentioned alongside cthulhu and tsathoggua in " the warder of knowledge "</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Sealed_Casket"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Richard_F._Searight"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Isle_of_Dark_Magic">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Isle of Dark Magic</rdfs:label>
    <ex:hasAnnotation>Father jason is a missionary priest stationed in the island of faikana . One day, a ship arrives bringing peter mace, a young recluse . Jason climbs the ladder to the second floor and sees what he assumes to be a naked woman . But is interrupted by the arrival of a drunken mace, who violently kicks him out .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Hugh_B._Cave"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>August 1934</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Knygathin_Zhaum">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Knygathin Zhaum</rdfs:label>
    <ex:hasAnnotation>Zhaum is a creature created by the late american author clark ashton smith for his hyperborean cycle series of fantasy tales . It is a descendant of the great old one, and is the only living entity left in commoriom at story’s conclusion . It reproduces by fission and thus created an azathothian strain among the hyperborean voormi .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Testament_of_Athammaus"/>
    <ex:madeFirstAppearanceOnC>Selected Letters of Clark Ashton Smith 189</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#ReKithnid">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Re'Kithnid</rdfs:label>
    <ex:hasAnnotation>The is a fictional book created by c.t. Phipps for his cthulhu armageddon horror action adventure series . It is a book of sorcery and mythology, depicting a conflict between the great old ones and the elder gods . It associates the god re with a hypothetical "good" brother of cthulhu called kithnid .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_Tower_of_Zhaal"/>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#C._T._Phipps"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Devourer_Below">
    <rdf:type rdf:resource="http://example.org/lovecraft#ArkhamHorrorFiction"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Devourer Below</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist John Coulthart United States English Arkham Horror Fiction Aconyte Release Date July 2021 320 is a collection of Cthulhu Mythos stories from Fantasy Flight Games ' Arkham Horror setting. Edited by Charlotte Llewelyn-Wells, it was published by Aconyte in July 2021 and features cover art from John Coulthart. Paperback, digital and audio editions were released. Overview Contents "Running the Night Whiskey" by Evan Dicken "Shadows Dawning" by Georgina Kamsika "The Hounds Below" by Josh Reynolds "Labyrinth" by Thomas Parrott "All My Friends Are Monsters" by Davide Mana "The Darkling Woods" by Cath Lauria "Professor Warren's Investiture" by David Annandale "Sins in the Blood" by Thomas Parrott</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>320</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Arkham_Horror_Fiction"/>
    <ex:wasReleasedOnW>July 2021</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Insidious_Doom">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Insidious Doom</rdfs:label>
    <ex:hasAnnotation>Frank Forte English Asylum Press Beyond Lovecraft date September 2020  " " is a Lovecraftian short story by American Frank Forte , first published in his collection Beyond Lovecraft by Asylum Press in September 2020. Synopsis Paranormal investigator Davian Cooper travels to the virtually-abandoned and slowly decaying town of Thurmond to investigate reports of supernatural activity. Booking a room in the town's sole remaining hotel, he listens to the owner's stories of strange happenings, and experiences several inexplicable occurrences himself. Cooper is eventually murdered by the innkeeper and his eldritch minion before the man sends his journals to the national press, which results in an influx of visitors and more victims for the town's strange practices.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Frank_Forte"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Beyond_Lovecraft"/>
    <ex:wasPublishedOnW>September 2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shimba">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Shimba</rdfs:label>
    <ex:hasAnnotation>First appearance EXP : " The Stairs in the Crypt " Created by Lin Carter is a fictional deity mentioned in the Cthulhu Mythos short story " The Stairs in the Crypt ", by Lin Carter . Description Nothing is known about , other than that it is a benevolent god of shepherds worshiped in monasteries in ancient Hyperborea . A remarkably agreeable deity, the monks of are allowed to indulge in hedonistic consumption of food and drink, and live in great comfort. ( EXP : " The Stairs in the Crypt ") It's unknown whether is a real entity within the context of the Mythos.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Stairs_in_the_Crypt"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Neptunian">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Neptunian</rdfs:label>
    <ex:hasAlternativeNamesC>Yakshian</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Neptunians , or yakshians, are an intelligent race from the planet neptune . One of many species whose brains or nervous systems can be preserved in the brain casts of the mi-go , a species of fungoid aliens . They are referenced in hpl : the whisperer in darkness .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Whisperer_in_Darkness"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yuth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Yuth</rdfs:label>
    <ex:hasAnnotation>North of the bimini islands, is a gargantuan city composed of thin cones hundreds of feet in height engraved with enigmatic runes . Many of the cones retain their sharp tips, and so remain a forest of hazards to those attempting to descend . Is an entirely alien city to humans, with much of it's geometry said to be painful to look at .</ex:hasAnnotation>
    <ex:hasTypeL>Ruined City</ex:hasTypeL>
    <ex:isLocatedAtL>North of the Bimini Islands</ex:isLocatedAtL>
    <ex:isLocatedAtL>the West Indies</ex:isLocatedAtL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Koth-Serapis">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdfs:label>Koth-Serapis</rdfs:label>
    <ex:hasAnnotation>Sorcerer was an evil magician of the hyperborean age . Penned the occult script which came to be known as the black rituals of when alive . Cursed the vanir warrior bane to live forever through multiple incarnations . However, in the 1930s, in the form of a texan man named james allison, met the sorcerer and defeated him, breaking the curse and earning his final rest .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Qyth-az">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Q'yth-az</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Crystalloid Intellect</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Created by scott david aniolowski was first used by chaosium for its call of cthulhu roleplaying game in 1994 . Background is a great old one that lives on mthura a lightless world .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>An Early Frost</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Scott_David_Aniolowski"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shterot">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Shterot</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Tenebrous One</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The tenebrous one is a colossal abomination that resembles a starfish . It has the ability to replicate when a part of its body is severed, creating duplicates of itself which can connect to and control other beings . First encountered by humans when it descended from the heavens in long ages past .</ex:hasAnnotation>
    <ex:isLocatedAtC>Scattered across Earth</ex:isLocatedAtC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Slidith">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Slidith</rdfs:label>
    <ex:hasAnnotation>First appearance EXP : The Wizard of Lemuria Created by Lin Carter , Lord of Blood ( EXP : The Wizard of Lemuria , Lin Carter ) is a Great Old One worshipped in ancient Lemuria , one of the three primal lords of Lemuria ( EXP : The Nyarlathotep Cycle: The God of a Thousand Forms , p.129) and an aspect of the Triple God of Chaos .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Wizard_of_Lemuria"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Verboten%21_Operation:_FAUST_%28RPG_Supplement%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Verboten! Operation: FAUST (RPG Supplement)</rdfs:label>
    <ex:hasAnnotation>Verboten! Operation: faust is a scenario supplement for chaosium 's call of cthulhu roleplaying game, written by irish games designer gareth ryder-hanrahan . It was written as a demonstration scenario for warpcon xii in 2002, a traditional games convention held in university college cork, ireland</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Gareth_Ryder-Hanrahan"/>
    <ex:hasCountryOfOriginW rdf:resource="http://example.org/lovecraft#Ireland"/>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2002</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Etepsed_Egnis">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Etepsed Egnis</rdfs:label>
    <ex:hasAnnotation>Short story is parody of cosmic horror stories like those of h.p. Lovecraft . Narrator, halizbuk, climbs into a small box through the curtained window . Finds a naked contortionist in the darkness licking them self clean .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#D._F._Lewis"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Dagon"/>
    <ex:isPartOfSeriesW>October-December 1989</ex:isPartOfSeriesW>
    <ex:isPublishedAsW>October 1989</ex:isPublishedAsW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Abyss_of_Yhe">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Abyss of Yhe</rdfs:label>
    <ex:hasAnnotation>The , also known as the land of yhe or simply yhe , is a fictional location created by the late american author h. p. lovecraft . Situated somewhere in the pacific ocean , it was first referenced in his novella the shadow out of time . Yhe is the location where the elder gods imprisoned ythogtha, the son of cthulhu .</ex:hasAnnotation>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#Ythogtha"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Shadow_Out_of_Time"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Uncollected_Prose_%26_Poetry_Volume_2">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Uncollected Prose &amp; Poetry Volume 2</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft Cover Artist Jason C. Eckhardt English Necronomicon Press Release Date July 1980 51 is an assorted collection of short works by the late American Howard Phillips Lovecraft . Running to a total of 51 , it was edited by noted Lovecraft scholars S. T. Joshi and Marc A. Michaud , and published by Necronomicon Press in July 1980 ; it has not been reissued . Contents Introduction by S. T. Joshi " Ibid " " The Trap " with Henry S. Whitehead " Collapsing Cosmoses " with R. H. Barlow " Ad Criticos: Liber Secundus " " Brotherhood " " Medusa: A Portrait " " The Feast " " Ave atque Vale " " Poesy " " Life for Humanity's Sake " " Vermont--A First Impression " " Preface to Old World Footprints " " The Old Brick Row " " In Memoriam: Henry St. Clair Whitehead " " Robert Ervin Howard: 1906-1936 " Bibliography by S. T. Joshi Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasPageCountW>51</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>July 1980</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Warren_Rice">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Warren Rice</rdfs:label>
    <ex:ceasedOnC>1931 ( Black Tallow )</ex:ceasedOnC>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Miskatonic_University"/>
    <ex:hasAnnotation>1931 ( EXP : " Black Tallow ") Relatives Raymond (distant nephew) ( EXP : " Black Tallow ") Professor of Classical Languages Miskatonic University Human First appearance HPL : " The Dunwich Horror " Created by H. P. Lovecraft Professor is the Professor of Classical Languages at Miskatonic University . He first appeared in " The Dunwich Horror " and also appears in Arkham Horror: The Card Game . Role In "The Dunwich Horror" , Henry Armitage and Francis Morgan made an expedition into the town of Dunwich and defeated the Dunwich Horror . Gallery Trivia 's distant nephew Raymond is the main character in the short story " Black Tallow " by Edward M. Erdelac . In the animated film Howard Lovecraft and the Kingdom of Madness , he is introduced by Armitage as , but the end credits give his name as "Hamish Rice" instead.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Dunwich_Horror"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Journey_Into_Mystery_Vol_2_1">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Journey Into Mystery Vol 2 1</rdfs:label>
    <ex:hasAnnotation>Journey Into Mystery Vol 2 #1 Robert E. Howard (original story) Roy Thomas (adaptation) United States English Marvel Comics Release Date July 25, 1972 Media Type Comic book Journey Into Mystery Vol 2 #1 is an issue of Marvel Comics ' long-running horror anthology series. It contains three short stories, the first of which was an adaptation of Robert E. Howard 's Cthulhu Mythos story " Dig Me No Grave ". This version was written by Roy Thomas and featured artwork by Gil Kane and Tom Palmer. External Links at the Marvel Database wiki</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Roy_Thomas"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1972 July 25</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Spawn_of_the_Maelstrom">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Spawn of the Maelstrom</rdfs:label>
    <ex:hasAnnotation>A londoner named bassett meets with his friend, jason warwick, who is obsessed with mysteries . Warwick tells bassett that he's going to the lofoten islands, norway, to investigate a local legend . When warwick returns, bassett notices several differences in his voice, mannerisms and movements . One night, when bassett is visiting hardie, they witness the latter's watchman being attacked by a man they recognize as warwick .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mark_Schorer"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Weird Tales September 1939</ex:isPublishedAsW>
    <ex:wasPublishedOnW>September 1939</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bedlam_in_Yellow">
    <rdf:type rdf:resource="http://example.org/lovecraft#Crossovers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Bedlam in Yellow</rdfs:label>
    <ex:hasAnnotation>Short story is connected to the cthulhu mythos through the play the king in yellow . Occult detective thomas carnacki is summoned to bethlem asylum to provide his unique brand of assistance . He discovers a former actor whose insanity has broken the walls of reality and given him a connection to the dread .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#In_the_Court_of_the_Yellow_King"/>
    <ex:wasPublishedOnW>September 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Harlot">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Harlot</rdfs:label>
    <ex:hasAnnotation>The is a character created by american comic book creator michael alan nelson for the boom! Studios mythos series fall of cthulhu . She made her debut appearance in the very first issue in 2007 .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Fall_of_Cthulhu_Volume_1:_The_Fugue"/>
    <ex:madeFirstAppearanceOnC>issue Harlot</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Michael_Alan_Nelson"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Harrison_Peel">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Harrison Peel</rdfs:label>
    <ex:hasAnnotation>Australia National Security Agency contractor Army Intelligence officer (formerly) Humans First appearance EXP : "Stomach Acid" Created by David Conyers Brian M. Sammons Major is a fictional Army Intelligence officer created by David Conyers and Brian M. Sammons for their 2006 short story "Stomach Acid." The character has since been expanded on, primarily by Conyers, but on some occasions by and with other authors, including Sammons, C. J. Henderson , John Goodrich , David Kernot , and John Sunseri . Overview Peel is a former Australian Army Intelligence officer in the employ of America 's National Security Agency as an independent contractor. As well as more mundane human opponents, his missions regularly bring him into conflict with the forces of the Cthulhu Mythos , including such entities as Shoggoths and the Dark Young of Shub-Niggurath . Selected Appearances Collections Cthulhu Reloaded (2021) Cthulhu Resurgent (2021) Cthulhu Remorseless (2021) Short Fiction Note: unless otherwise stated, all stories are by David Conyers "Stomach Acid" (2006, David Conyers and Brian M. Sammons ) "Not What One Does" (2007, C. J. Henderson and John Sunseri) "The Masked Messenger" (2011, David Conyers and John Goodrich ) "The Road to Afghanistan" (2013) "The R'Lyeh Singularity" (2013, David Conyers and Brian M. Sammons) "The Weaponized Puzzle" (2013) "Driven Underground" (2013) "The Eye of Infinity" (2014) "War Gods of Men" (2014) " The Bullet and the Flesh " (2014, David Conyers and David Kernot ) "The Elder Codex" (2014) "The Temporal Deception" (2015, David Conyers and C. J. Henderson) "Tears in Yellow" (2021) "Weapons Grade" (2021) "The Gravity Museum" (2021) "Invisible Demons" (2021, David Conyers and Brian M. Sammons) "The Mouth of Jupiter" (2021) "Supersymmetry Blues" (2021) "Broken Singularity" (2023) External Links series at the Internet Speculative Fiction Database References</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Stomach Acid</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Brian_M._Sammons"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#David_Conyers"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sanctum_of_Twilight">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Sanctum of Twilight</rdfs:label>
    <ex:hasAnnotation>Kara Centell-Dunk Grace Holdinghaus Fantasy Flight Games Publication Date 2018 Mansions of Madness is an expansion set for the Cthulhu Mythos board game Mansions of Madness . Designed by Kara Centell-Dunk and Grace Holdinghaus , it was published by Fantasy Flight Games in 2018. Overview Gallery Artwork Components</ex:hasAnnotation>
    <ex:wasPublishedOnW>2018</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Innsmouth_Nightmares">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Innsmouth Nightmares</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Ben Baldwin English PS Publishing Release Date July 2015 313 is an anthology of Cthulhu Mythos fiction edited by Lois H. Gresh . It was issued in hardcover format by PS Publishing in July 2015. Overview Contents " The Cats of River Street (1925) " by Caitlín R. Kiernan "Windows Underwater" by John Shirley "Cold Blood" by Lavie Tidhar "Fear Sun" by Laird Barron "Thicker Than Water" by Paul Kane "Strange Currents" by Tim Lebbon "Mourning People" by Nancy Kilpatrick "The Barnacle Daughter" by Richard Gavin "Between the Pilings" by Steve Rasnic Tem "The Imps of Innsmouth" by Wilum H. Pugmire "The Open Mouth of Charybdis" by John Langan "Water's Edge" by Tim Waggoner "Dark Waters" by William F. Nolan "A Girl's Life" by Lisa Morton "The Sea Witch" by James A. Moore "Brood" by Jason V. Brock "Gone to Doggerland" by Jonathan Thomas "The Scent of the Hammer and the Feather" by Joseph Pulver, Sr. "Baubles" by Nancy Holder "The Waves Beckon" by Donald Tyson "Some Kind of Mistake" by S. T. Joshi</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>313</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>July 2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Memory_%28Josh_Maybrook%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Memory (Josh Maybrook)</rdfs:label>
    <ex:hasAnnotation>Memory (Josh Maybrook) Josh Maybrook English Rogue Planet Press Lovecraftiana Vol 5, Issue 2 date July 2020  " Memory " is a Lovecraftian poem by American Josh Maybrook . It was published in Vol 5, Issue 2 of Lovecraftiana by Rogue Planet Press in July 2020. Synopsis The fourteen lines describe a haunting sound almost heard, which appears to emanate from the very cosmos itself, as well as the narrator's inkling that they may not be wholly of the Earth. Behind the Mythos The description of the cosmic music and "ghostly choir" may be a reference to the Outer God Azathoth .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Josh_Maybrook"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 2</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 5</ex:isPublishedAsW>
    <ex:wasPublishedOnW>July 2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Commoriom_Vengeance">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Commoriom Vengeance</rdfs:label>
    <ex:hasAnnotation>Full story online here Ron Shiflet United States English Dark Legacy #2 date October 1998 " " is a poem by American Ron Shiflet . Synopsis A man whose child has been murdered by the Voormis travels to Mount Voormithadreth to exact his revenge: the head of one of his son's killers. History "" was first published in Dark Legacy #2 in October 1998, although it had previously appeared on the Eldritch Dark website.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Dark Legacy #2</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 1998</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Hear_the_Squidman_Speak">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Hear the Squidman Speak</rdfs:label>
    <ex:hasAnnotation>The story is told as an interview between a man incarcerated in a lunatic asylum for killing a former movie star and a second, unknown party . Although the man first denies the murder, he confesses at the conclusion . Historywas published in the e. p. berglund -edited online zine nightscapes #9 in september 1998 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mike_Minnis"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Nightscapes #9</ex:isPublishedAsW>
    <ex:wasPublishedOnW>September 1998</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Orthrus">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Orthrus</rdfs:label>
    <ex:hasAnnotation>Relatives Parents: Echidna (mother), Typhon (father) Siblings: Angerboda , Chimaera , Ladon , Cerberus , Lernean Hydra , Teumessian Fox , and the Snakes of Many Colors is a monster of Greek mythology. In the Marvel fictional universe it is mentioned as being one of the offspring of Echidna but it has not yet made an appearance in Marvel Comics . Background is a descendant of the Elder God Set . It is the offspring of Set's granddaughter Echidna who mated with Typhon, one of the Titans. As a two-headed dog, is somewhat analogous to Cerberus .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Harry_Bates_III">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Harry Bates III</rdfs:label>
    <ex:diedOnR>1981</ex:diedOnR>
    <ex:hasAnnotation>Editor of Strange Tales and Astounding Stories. Lovecraft repeatedly submitted stories to him, but all were rejected because they did not contain a sufficiency of “action”.</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1900</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Gods_of_Bal-Sagoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RobertEHowardWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Gods of Bal-Sagoth</rdfs:label>
    <ex:hasAnnotation>Wt, also known as "the blonde goddess of bal-sagoth" is a short story by robert e. howard . It was first published on weird tales in october 1931 . The story is set on the island of the gods, the "oldest land in the world"</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Michael_LaBossiere">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Michael LaBossiere</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Games designer Maine, USA United States https://shadowsofmaine.wordpress.com/ Dr. Michael C. LaBossiere previously worked, while at college, as a professional game designer for Chaosium and other roleplaying game companies. He is currently Professor of Philosophy at Florida Agricultural &amp; Mechanical University. He primarily wrote game modules and still offers a large number of free adventure modules for Call of Cthulhu RPG on his gaming Shadows of Maine . Selected Bibliography End Time (2003) Raising Up (2004) Once Men (2008) Sinkhole</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA http://example.org/lovecraft#Maine</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://shadowsofmaine.wordpress.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Games designer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Million_Favoured_One">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Million Favoured One</rdfs:label>
    <ex:hasAnnotation>Real World Information First appearance HPL : " The Whisperer in Darkness " Created by H. P. Lovecraft The Million Favoured Ones are a mysterious group first mentioned in " The Whisperer in Darkness " and expanded upon in the Call of Cthulhu role-playing game. Description The Million Favoured Ones are not a true species, but in fact a catch-all term for any entity who has been granted a new, more powerful form by Nyarlathotep as a reward for their patronage. The Million Favoured Ones include individuals such as the Lurker in the Star Pool and the Horsemen of Nyarlathotep .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Whisperer_in_Darkness"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bayt_al_Azif,_Issue_4,_March_2022">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Bayt al Azif, Issue 4, March 2022</rdfs:label>
    <ex:hasAnnotation>Bayt Al Azif Issue 4 Various English Bayt al Azif Genre(s) Roleplaying games Release Date March 2022 104 Preceded by Issue 3 Followed by Issue 5 Bayt al Azif Issue 4 is the fourth issue of sporadic Cthulhu Mythos roleplaying magazine Bayt al Azif . Running to a total of 104 , it was published in March 2022; paperback, hardcover, and digital formats were all released. Overview</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasGenreW>Roleplaying games</ex:hasGenreW>
    <ex:hasPageCountW>104</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Bayt_al_Azif"/>
    <ex:wasReleasedOnW>March 2022</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nug-Soth_%28alphabet%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Nug-Soth (alphabet)</rdfs:label>
    <ex:hasAnnotation>In Colin Wilson 's work on the Necronomicon , "Ye Alphabet of Nug-Soth " is the name of an alphabet that was created as some kind of esoteric scripture, to serve the purpose of the Mad Arab Abdul Alhazred for his great work, the Necronomicon . It is also used on talismans to help its user to travel through time and space. Behind the Mythos In the "Necronomicon" by George Hay and Colin Wilson , published 1978, various Lovecraft works and names from those works are namechecked and put into different contexts, as with the use of the name of an alien race for an alphabet, without any direct connection to imply that this might be the alphabet used by that alien species. One can infer such a thing, but such a statement or inference is not present in the 1978 work.</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dandridge_Cycle">
    <rdf:type rdf:resource="http://example.org/lovecraft#CaitlinRKiernanWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#StoryCycles"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dandridge Cycle</rdfs:label>
    <ex:hasAnnotation>Caitlin R. Kiernan English is a series of interconnected short stories by Caitlin R. Kiernan concerning a mysterious house on the California coast and the strange sacrifice held captive beneath it. Stories " A Redress for Andromeda " (2000) " Nor the Demons Down Under the Sea " (2002) " Study for The Witch House " (2013) " Andromeda Among the Stones " (2003)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Naomi_OBannion">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Naomi O'Bannion</rdfs:label>
    <ex:hasAffiliationC>The Syndicate</ex:hasAffiliationC>
    <ex:hasAnnotation>Arkham , Massachusetts Relatives Danny O'Bannion (father) Criminal The Syndicate Human Created by Fantasy Flight Games is a character created by Fantasy Flight Games for their Arkham Horror Files line of Cthulhu Mythos -related releases. She has appeared in both Call of Cthulhu: The Card Game and Arkham Horror: The Card Game . Overview A beautiful young woman, Naomi works for her father Danny 's criminal organisation The Syndicate in the Arkham of 1928, seeming to spending much of her time in the Clover Club, a shady speakeasy. Although generally seen as an antagonistic character, she has been known to assist others in their battles against the forces of the Cthulhu Mythos.</ex:hasAnnotation>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Fantasy_Flight_Games"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Thing_on_the_Doorstep">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Thing on the Doorstep</rdfs:label>
    <ex:hasAnnotation>Short story is part of the cthulhu mythos genre of horror fiction . It was written in august 1933, and first published in the january 1937 issue of weird tales . Lovecraft scholar robert m. price has suggested that the wizard is based on arthur edward waite .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Cthulhu Mythos</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Black_Forbidden_Things">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Black Forbidden Things</rdfs:label>
    <ex:hasAnnotation>The volume features literary criticism from leading lovecraft scholars like price, s. t. joshi , will murray , and david e. schultz . The title comes from a passage in lovecraft's " the haunter of the dark ": "they were the black, forbidden things which most sane people have never even heard of"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
    <ex:hasAuthorW>editor</ex:hasAuthorW>
    <ex:hasGenreW>Literary Criticism</ex:hasGenreW>
    <ex:hasPageCountW>204</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1992</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Earl_Geier">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Earl Geier</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Artist Birth Date 27 June 1953 United States Horror Science Fiction Fantasy https://baldegografix.wixsite.com/baldegografix is an American artist best known for his comic book and gaming material. He has contributed work for a wide range of publications, including extensive imagery for Chaosium 's Call of Cthulhu roleplaying game. Selected Works Cover Art Tales of Sesqua Valley (1997) Interior Art Blood Brothers (1990) King of Chicago (1994) In the Shadows (1995) Made in Goatswood (1995) Ye Booke of Monstres II (1995) Utatti Asfet (1996) Aspirations (2019) See Also Images by External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://baldegografix.wixsite.com/baldegografix</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Artist</ex:isConnectedToMythosR>
    <ex:wasBornOnR>27 June 1953</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Horror_at_Innsmouth_High">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Horror at Innsmouth High</rdfs:label>
    <ex:hasAnnotation>Joan d'Arc English Genre(s) Lovecraftian horror Rogue Planet Press Publication date Unknown " " is a short Cthulhu Mythos story by Joan d'Arc, first published in Gavin Chappell 's cosmic horror fanzine Lovecraftiana (unknown year, Rogue Planet Press ). Synopsis When a young female reporter heads to the town of Innsmouth to investigate a rash of unexplained pregnancies at the local high school, she falls foul of a cult dedicated to the Great Old One Cthulhu . After a horrific ordeal at the hands of the sinister group and its unearthly leader, her sanity begins to unravel, and she finds herself cursed with child… Publication History Lovecraftiana (unknown year, Rogue Planet Press ) The Best of Lovecraftiana (2023, Rogue Planet Press)</ex:hasAnnotation>
    <ex:hasAuthorW>Joan d'Arc</ex:hasAuthorW>
    <ex:hasGenreW>Lovecraftian horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>Unknown</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Enter_the_Cobweb_Queen">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Enter the Cobweb Queen</rdfs:label>
    <ex:hasAnnotation>"end the cobweb queen" is a short story by occultist adrian cole . It forms part of his nick nightmare series of hardboiled/ mythos stories . The story is set in a parallel dimension to modern-day nyc .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Adrian_Cole"/>
    <ex:hasGenreW>Fantasy</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Weirdbook Annual 2</ex:isPublishedAsW>
    <ex:wasPublishedOnW>February 2019</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Pantha">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Pantha</rdfs:label>
    <ex:hasAlternativeNamesC>Sekhmet</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Vampirella is a hero in the fictional dynamite universe, who was created in 1974 by carl wessler . Was originally an alien shapeshifter from the planet drakulon, the same world as vampirella . Was later retconned into an ancient cursed egyptian shapeshifter .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Prophecy"/>
    <ex:madeFirstAppearanceOnC>Vampirella Vol 1 30</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Carl Wessler</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#And_Here_There_Be_--_Demons%21">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>And Here There Be -- Demons!</rdfs:label>
    <ex:hasAnnotation>And here there be -- demons! Is a story featured in issue #308 of the 1st volume of the incredible hulk written by bill mantlo . The story is set in an alien world conquered by the demonic offspring of chthon , the n'garai</ex:hasAnnotation>
    <ex:hasAuthorW>Bill Mantlo</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>June 1985</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Starstone">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ArtefactsOriginatingFromMythosAdjacentWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MysticalArtefacts"/>
    <rdfs:label>Starstone</rdfs:label>
    <ex:hasAnnotation>The is a fictional item in the marvel universe which first appeared in 1973 in issue #7 of the marvel premiere series of comics . It was a football sized oval gem that was cold to the touch, as if it had been touched by the frigid cold of space . Within it was a strange shadow and those who touched it felt a chill of terror down their spines.</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Stephen_King">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Stephen King</rdfs:label>
    <ex:hasAnnotation>Stephen king is a world-renowned author, best known for his horror and fantasy work . He has made several contributions to the expanded cthulhu mythos . He has stated on multiple occasions that h. p. lovecraft is one of his greatest influences .</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Portland http://example.org/lovecraft#Maine</ex:hasBirthplaceR>
    <ex:hasFullNameR>Stephen Edwin King</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasPseudonymR>Richard Bachman John Swithen Beryl Evans</ex:hasPseudonymR>
    <ex:hasWebsiteR>https://stephenking.com/</ex:hasWebsiteR>
    <ex:hasYearsActiveR>1967-present</ex:hasYearsActiveR>
    <ex:isConnectedToMythosR>Mythos Contributor</ex:isConnectedToMythosR>
    <ex:wasBornOnR>21 September 1947</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Strange_Remnants">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Strange Remnants</rdfs:label>
    <ex:hasAnnotation>Nikki Valens Fantasy Flight Games Publication Date 2015 Board game Eldritch Horror is a supplement for the Eldritch Horror Cthulhu Mythos board game. Designed by Nikki Valens and featuring artwork by Clark Huggins, Stephen Somers, and Matthew Starbuck, it was published by Fantasy Flight Games in 2015 . Overview External Links "Syzygy Begins" At the Fantasy Flight Games website Gallery References</ex:hasAnnotation>
    <ex:wasPublishedOnW>2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Tomb-Spawn">
    <rdf:type rdf:resource="http://example.org/lovecraft#ClarkAshtonSmithWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ZothiqueStoryCycle"/>
    <rdfs:label>The Tomb-Spawn</rdfs:label>
    <ex:hasAnnotation>Historywas first published in the may 1934 edition of weird tales . It has since been reprinted in a multitude of periodicals and anthologies .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Fantasy</ex:hasGenreW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>May 1934</ex:wasPublishedOnW>
