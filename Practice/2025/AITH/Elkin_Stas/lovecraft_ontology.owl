    <rdfs:label>Albert A. Sandusky</rdfs:label>
    <ex:diedOnR>unknown</ex:diedOnR>
    <ex:hasAnnotation>Amateur journalist whose use of slang captivated Lovecraft. Lovecraft met him frequently during trips to the Boston area.</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
