    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Caligo Accedendum Tournament</rdfs:label>
    <ex:hasAnnotation>An adventure for cthulhu dark ages is a scenario supplement for chaosium's call of cthulhu roleplaying game . It contains three stand-alone adventures along with all of the necessary handouts and a set of pre-generated investigators . The scenarios were first used for demonstration games at traditional gaming convention gen con 2004 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Michael_Patty"/>
    <ex:hasAuthorW>Bob Geis</ex:hasAuthorW>
    <ex:hasAuthorW>Deanne P. Goodwin</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>90</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>February 2004</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ripples_from_Carcosa">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Ripples from Carcosa</rdfs:label>
    <ex:hasAnnotation>United States English Call of Cthulhu Chaosium Release Date July 31, 2014 130 is a collection of three scenarios for Chaosium 's Call of Cthulhu role-playing game, written by Oscar Rios and set in three distinct time periods: the Roman Empire setting of Cthulhu Invictus , Cthulhu Dark Ages and the near future. Each scenario draws upon the stories of Robert W. Chambers and others concerning The King in Yellow and the Great Old One Hastur . Originally published as part of the Miskatonic University Library Association monograph (a precursor to the community content programs now common in the world of tabletop role-playing games, and which was retired in 2022), was republished by Chaosium in 2014, edited and developed by Mike Mason .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>130</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2014 July 31</ex:wasReleasedOnW>
  </rdf:Description>
