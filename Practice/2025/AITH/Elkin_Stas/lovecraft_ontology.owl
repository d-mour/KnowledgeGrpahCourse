    <rdfs:label>Ascend</rdfs:label>
    <ex:hasAnnotation>Mark A. Mihalko United States English Wildside Press Weirdbook Annual 2 Media type Softcover Print Digital PDF date February 2019 " " is a Cthulhu Mythos poem by American Mark A. Mihalko . Synopsis The seven verses of "" describe the awakening of the Great Old Ones . History "" was published in the Wildside Press anthology Weirdbook Annual 2 in 2019.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mark_A._Mihalko"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
