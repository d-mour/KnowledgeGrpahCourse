    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Path of the Serpent</rdfs:label>
    <ex:hasAnnotation>Kara Centell-Dunk Amudha Venugopalan Fantasy Flight Games Publication Date 2019 Mansions of Madness is an expansion set for Fantasy Flight Games ' Cthulhu Mythos board game Mansions of Madness . Designed by Kara Centell-Dunk and Amudha Venugopalan with artwork by Cristi Balanescu, it was published in late 2019. Overview Gallery</ex:hasAnnotation>
    <ex:wasPublishedOnW>2019</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Scritch_Scratch">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Scritch Scratch</rdfs:label>
    <ex:hasAnnotation>Roleplaying game chaosium 40 is a stand-alone scenario for the call of cthulhu horror roleplaying game . Written by lynne hardy, it was published as a free digital download by chaosium in 2018 . A black-and-white softcover edition was also made available through print-on-demand manufacturer lulu .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lynne_Hardy"/>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>40</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Elder_Key_%28Stone_Tablet%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Elder Key (Stone Tablet)</rdfs:label>
    <ex:hasAlternativeNamesA>Elder Keys</ex:hasAlternativeNamesA>
    <ex:hasAlternativeNamesA>Elder Records</ex:hasAlternativeNamesA>
    <ex:hasAlternativeNamesA>Tablets of the Gods</ex:hasAlternativeNamesA>
    <ex:hasAnnotation>The elder keys , a.k.a. The tablets of the gods or the elder records, are fictional artefacts in the cthulhu mythos . They are described as stone tablets that hold tremendous power . One of these incantations brought our world into this universe from the plane of the elder gods .</ex:hasAnnotation>
    <ex:hasFunctionA>Tablet</ex:hasFunctionA>
    <ex:hasTypeA>Data Storage</ex:hasTypeA>
    <ex:hasTypeA>Transmission</ex:hasTypeA>
    <ex:isUsedByA rdf:resource="http://example.org/lovecraft#Ubbo-Sathla"/>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#Ubbo-Sathla"/>
    <ex:wasCreatedByA>Elder Gods</ex:wasCreatedByA>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sybarites">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Sybarites</rdfs:label>
    <ex:hasAnnotation>Doug Rinaldi English James Ward Kirk Publishing Lovecraft after Dark date November 2015  " ", also titled as " , or, Enmity of Perverse Existence " is a Lovecraftian short story by Doug Rinaldi. It was published in the James Ward Kirk Publishing thematic anthology Lovecraft after Dark in November 2015. Synopsis A man searching for his missing daughter finds her enslaved by a cult who operate a den of debauchery beneath a hollowed-out mountain. The object of their worship is a colossal creature which appears to feed on their acts of depravity, and in attempting a rescue, the man interrupts these rituals of obeisance. Although he is unable to save his daughter, his actions result in the death of the cult members; he then sets the creature's lair - a great pool of methanol - alight, and waits for the flames to consume him.</ex:hasAnnotation>
    <ex:hasAuthorW>Doug Rinaldi</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Lovecraft_after_Dark"/>
    <ex:wasPublishedOnW>November 2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Through_the_Gates_of_the_Silver_Key">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Through the Gates of the Silver Key</rdfs:label>
    <ex:hasAnnotation>Lovecraft and price co-wrote " winged death " between october 1932 and april 1933 . It is a sequel to lovecraft's " the silver key ", and part of a sequence of stories focusing on randolph carter . The story was first published in the july 1934 issue of weird tales .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#E._Hoffmann_Price"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Howard_Phillips_Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Fantasy</ex:hasGenreW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Dream_Cycle"/>
    <ex:isPartOfSeriesW>Cthulhu Mythos</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tails_of_Terror">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Tails of Terror</rdfs:label>
    <ex:hasAnnotation>Various English Golden Goblin Press Release Date 2018 : Stories of Cat-Themed Horror is a thematic anthology of Lovecraftian fiction edited by Brian M. Sammons . It was published by Golden Goblin Press in 2018; both paperback and digital editions were released. Overview Contents "Brown Jenkin’s Reckoning" by Edward M. Erdelac "Derpyfoot" by Christine Morgan "The Cat in the Pall" by Pete Rawlik "Ghost Story" by Brian M. Sammons "Palest of Humans" by Don Webb " Bats in the Belfry " by William Meikle "Satisfaction Brought Him Back" by Glynn Owen Barrass "The Bastet Society" by Sam Stone "The Veil of Dreams" by Stephen Mark Rainey "The Quest of Pumpkin the Brave" by Oscar Rios "The Cats of the Rue d’Auseil" by Neil Baker "The Knowledge of the Lost Master" by Andi Newton "The Ruins of an Endless City" by Lee Clark Zumpe "A Glint in the Eyes" by D.A. Madigan "A Field Guide to Wanderlust" Joseph S. Pulver, Sr. "In the End there is a Drain" by Tim Waggoner</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2018</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Juk-Shabb">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Juk-Shabb</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>God of Yekub</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as God of Yekub Great Old Ones First appearance CIRCLE : " The Challenge from Beyond " (unnamed) Created by C. L. Moore A. Merritt H. P. Lovecraft Robert E. Howard Frank Belknap Long , God of Yekub , appears as a huge shining ball of sentient energy. Background is a Great Old One which communicates by changing color and using telepathy. The being is a powerful psionic and has extensive knowledge of magic. Among the Great Old Ones, it is one of the least malevolent. Gallery</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Challenge_from_Beyond"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#C._L._Moore"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Frank_Belknap_Long"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
    <ex:wasCreatedByC>A. Merritt</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lara_Turner">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Lara Turner</rdfs:label>
    <ex:hasAnnotation>Pseudonym(s) EddlyT Ed Turner Edward Turner Lara Paige Turner Connection to the Mythos Traditional games designer Roleplaying games is a games designer who has worked on numerous games and supplements, many of which utilise the Fate system-agnostic roleplaying system. She has written a handful of Cthulhu Mythos -related games, and has published roleplaying material for franchises such as Doctor Who online. Selected Works Core Games Fate of Cthulhu (2019) Supplements The Rise of Azathoth (2021) The Rise of Hastur (2021) External Links at RPGGeek</ex:hasAnnotation>
    <ex:hasPseudonymR>Ed Turner</ex:hasPseudonymR>
    <ex:hasPseudonymR>EddlyT</ex:hasPseudonymR>
    <ex:hasPseudonymR>Edward Turner</ex:hasPseudonymR>
    <ex:hasPseudonymR>Lara Paige Turner</ex:hasPseudonymR>
    <ex:isConnectedToMythosR>Traditional games designer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Alice_in_Wonderland">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Pastiches"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Alice in Wonderland</rdfs:label>
    <ex:hasAnnotation>Raven Gregory Robert Gill English Zenescope Entertainment Release Date January 2012 - May 2012 Media Type Comic book is a pastiche of the novel "" by Lewis Carroll. This derivative work was a six-issue comic book mini-series written by Raven Gregory in 2012 published by Zenescope Entertainment. Synopsis The story of a girl who was sacrificed to Wonderland , the realm of madness. A journey which resulted in Alice Liddle ending up a broken woman. Her determination to survive ended up saving mankind.</ex:hasAnnotation>
    <ex:hasAuthorW>Raven Gregory</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>January 2012 - May 2012</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dust_1947">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dust 1947</rdfs:label>
    <ex:hasAnnotation>The game is set during an alternate world war ii during the mid 20th century . It originally was mainly a dieselpunk-style wargame with some horror elements (for example, zombies) recently the cthulhu mythos has been added to the setting .</ex:hasAnnotation>
    <ex:hasAuthorW>Paolo Parente</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>Sci-Fi</ex:hasGenreW>
    <ex:hasGenreW>miniature wargaming</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kathulos_of_Atlantis">
    <rdf:type rdf:resource="http://example.org/lovecraft#Avatars"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Kathulos of Atlantis</rdfs:label>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#Skull-Face"/>
    <ex:hasAlternativeNamesC>Kathulos of Egypt</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Son of the Ocean</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Master</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Scorpion</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>A revived dark sorcerer from atlantis who becomes the head and high-priest of a worldwide secret cult centered in northern africa . He is also known to his followers as the scorpion , son of the ocean , skull-face , or more commonly the master . Some sources identify kathulos as a human avatar of cthulhu .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Dig_Me_No_Grave"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Skull-Face"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kieran_Dacey_Boylan">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Kieran Dacey Boylan</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Poet Sydney, Australia Australia  is an Australian poet who has written a number of works of Lovecraftian horror which focus heavily on the existential horror aspect of the genre. These have been seen in publications such as the Rogue Planet Press zine Lovecraftiana , amongst others. Selected Works Poetry " A Vision " (2020) " Strangeness of the Night " (2020) " Horror Fiction " (2020) " Alive " (2020) " Obsidian Eyes " (2020) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#Australia Sydney</ex:hasBirthplaceR>
    <ex:hasNationalityR>http://example.org/lovecraft#Australia</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Poet</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Rat_God">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Rat God</rdfs:label>
    <ex:hasAnnotation>The story concerns a strange community who worships a giant preternatural . It was published by dark horse comics in 2015 . The story is set in the vicinity of arkham , massachusetts, and concerns a strange community .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Richard_Corben"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror-fantasy</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Elder_Sister-like_One">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Elder Sister-like One</rdfs:label>
    <ex:hasAnnotation>The manga is written and illustrated by iida pochi . The series was originally published in the magazine dengeki g's comic until 2019 . The manga has been collected into six trade paperback volumes .</ex:hasAnnotation>
    <ex:hasAuthorW>Iida Pochi</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>Japanese</ex:isInLanguageW>
    <ex:wasReleasedOnW>2016 – present March 30</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Thirty_Years_of_Arkham_House,_1939-1969:_A_History_and_Bibliography">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Thirty Years of Arkham House, 1939-1969: A History and Bibliography</rdfs:label>
    <ex:hasAnnotation>August Derleth Cover Artist Frank Utpatel United States English Genre(s) Non-Fiction Arkham House Release Date 1970 Media Type Hardback Print 99 is a non-fiction work comprising a complete bibliography and review of every publication issued by Arkham House from its formation in 1939 through to 1969, and includes all releases from the Mycroft &amp; Moran and Stanton &amp; Lee imprints. This was expended upon and followed by Sixty Years of Arkham House: A History and Bibliography by S. T. Joshi covering up to and including 1999. Publication History Edited by Lovecraft 's friend and contemporary August Derleth , Thirty Years of Arkham House was released in 1970 by Arkham House in a run of 2,137 copies and ran to 99 . The dust jacket was designed by Lovecraft's former correspondent and long-time Mythos artist, Frank Utpatel .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-Fiction</ex:hasGenreW>
    <ex:hasPageCountW>99</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1970</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Under_the_Pyramids_%28Eldritch_Horror%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Under the Pyramids (Eldritch Horror)</rdfs:label>
    <ex:hasAnnotation>Under the Pyramids Nikki Valens Fantasy Flight Games Publication Date 2015 Board game Eldritch Horror Under the Pyramids is an expansion set for the Eldritch Horror Cthulhu Mythos roleplaying game. Designed by Nikki Valens , it was published by Fantasy Flight Games in 2015 . Overview External Links "Abhoth Awakens": Under the Pyramids preview at the Fantasy Flight Games website Gallery References</ex:hasAnnotation>
    <ex:wasPublishedOnW>2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tim_Mendees">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Tim Mendees</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Editor Podcaster Macclesfield, England , United Kingdom British Cosmic horror Weird fiction https://timmendeeswriter.wordpress.com/ is a British author, editor, podcaster, and DJ who specialises is weird fiction and cosmic horror. His short fiction has appeared in zines including Lovecraftiana - where his short story " The Dappled Egg " was voted by the fanbase for inclusion in a Best of… anthology - and collections such as Occult Detective Magazine Mythos Special ; he also co-hosts two podcasts which specialises in the weird fiction . In addition to these accomplishments, he is the co-founder of the Innsmouth Literary Festival , a "one day festival celebrating weird and cosmic fiction." Mendees has cited Algernon Blackwood , William Hope Hodgson , Ramsey Campbell , and Stephen King as among his literary influences . Selected Works Editor The Musketeers vs. Cthulhu in the Court of King Louis (2022) Eldritch Investigations: Lovecraftian Tales of Occult Detection (2023) Novels The Hollowhills Cycle : Burning Reflection (2020) Boiling Shadow (2021) Blasted Soul (2024) Short Fiction "Transmissions from Voormithadreth" (2022) " The Dappled Egg " (unknown year) Podcasts The Innsmouth Book Club Strange Shadows: The Clark Ashton Smith Podcast External Links at the Internet Speculative Fiction Database at Goodreads References</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#England United Kingdom Macclesfield</ex:hasBirthplaceR>
    <ex:hasNationalityR>British</ex:hasNationalityR>
    <ex:hasWebsiteR>https://timmendeeswriter.wordpress.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Podcaster</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Scott_David_Aniolowski">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Scott David Aniolowski</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Game Designer Editor Author United States is an American author, editor and games designer who has worked on a wealth of Cthulhu Mythos gaming material and fiction over a career spanning decades, as well as a number of prose works set in and around the genre. Overview One of the longest-published authors for Chaosium 's Call of Cthulhu horror roleplaying game, Aniolowski has also edited a number of horror anthologies and even written his own short works, most of which are centred around the Cthulhu Mythos inspired by H. P. Lovecraft . Selected Bibliography Editor Made in Goatswood (1995) Return to Lovecraft Country (1997) Singers of Strange Songs: A Celebration of Brian Lumley (1997) Horror for the Holidays (2011) Short Fiction "An Early Frost" (1994) "I Dream of Wires" (1995) "The Idol" (1999) "First Nation" (2011) Poetry "Y'golonac" (1996) Gaming Supplements Terror from the Stars (1986) Cthulhu Classics (1989) At Your Door (1990) Lurking Fears (1990, with Michael Szymanski ) Blood Brothers (1990, contributor) Tales of the Miskatonic Valley (1991, contributor) Blood Brothers 2 (1992, contributor) Courting Madness (1992, contributor) Ye Booke of Monstres (1994) Ye Booke of Monstres II (1995) The Creature Companion (1998) Malleus Monstrorum (2006, 2020, second edition with Mike Mason and Paul Fricker ) Island of Ignorance: The Third Cthulhu Companion (2013, contributor) Tales of the Sleepless City (2013, contributor) Cold Warning (2017) The Creature Companion The Keeper's Companion (unknown edition) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Game Designer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shuma-Goraths_Ego_Maze">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsOriginatingFromMythosAdjacentWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Shuma-Gorath's Ego Maze</rdfs:label>
    <ex:hasAccessibilityL>Via dark magic (portal)</ex:hasAccessibilityL>
    <ex:hasAnnotation>Undead celestial ghosts first appeared in secret avengers vol 1 #33 in 2012 . It has appeared in two issues of the same volume, #33-34 . The undead celestials plan to spread undeath throughout the cosmos .</ex:hasAnnotation>
    <ex:isInhabitedByL>Ghosts</ex:isInhabitedByL>
    <ex:isInhabitedByL>Undead Celestial</ex:isInhabitedByL>
    <ex:madeFirstAppearanceOnL>Secret Avengers Vol 1 33</ex:madeFirstAppearanceOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Snake_Clan">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Snake Clan</rdfs:label>
    <ex:hasAnnotation>Real World Information First appearance Spider-Man Annual Vol 1 2001 Created by Juan Roman Cano, Fiona Avery The is a fictional race in Marvel Comics created in 2001 by Juan Roman Cano and Fiona Avery. Making their first appearance in the 2001 issue of the 1st volume of Spider-Man Annual . Background The are the offspring of Tartessus , daughter of the Elder God Set . Depicted as a primitive humanoid race they live in the jungles of Peru, using spears and blowguns and tattooing their heads with the image of an open mouthed snake head. They are long-time rivals of the Spider Clan, and had a hostile encounter with Spider-Man.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Spider-Man Annual Vol 1 2001</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Fiona Avery</ex:wasCreatedByC>
    <ex:wasCreatedByC>Juan Roman Cano</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Man_Who_Went_Too_Far">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Man Who Went Too Far</rdfs:label>
    <ex:hasAnnotation>First published in june 1904 in pall mall magazine, it has been extensively reprinted in the years since . Tells of a man who wishes to know all the secrets of nature and is often able to hear beautiful sounds of pipes . Eventually developed into his 1905 novel the angel of pain .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#E._F._Benson"/>
    <ex:hasCountryOfOriginW rdf:resource="http://example.org/lovecraft#England"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Pall Mall Magazine</ex:isPublishedAsW>
    <ex:wasPublishedOnW>June 1904</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#De_Marignys_Clock_%28Ran_Cartwright%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>De Marigny's Clock (Ran Cartwright)</rdfs:label>
    <ex:hasAnnotation>" de marigny's clock " is a short cthulhu mythos story by american ran cartwright . The story covers the last few days of missing writer joseph ward . Over the course of several nights, he gradually begins to detect the return of an ancient clock - in actuality a gate between worlds .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ran_Cartwright"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Dark Legacy #4</ex:isPublishedAsW>
    <ex:wasPublishedOnW>March 1999</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tales_from_Arkham_Sanitarium">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Tales from Arkham Sanitarium</rdfs:label>
    <ex:hasAnnotation>Editor: Brian M. Sammons Cover Artist Vincent Chong English Genre(s) Horror, Cthulhu Mythos Dark Regions Press Release Date October 2022 208 is an anthology of Lovecraftian fiction edited by Brian M. Sammons and published by Dark Regions Press in October 2022. As the book's title suggests, these stories involve Arkham Sanitarium and depict madness induced by the characters' interactions — either directly or indirectly — with horrors based on or inspired by those of H.P.Lovecraft . Description Contents "The Crying Man" by Tim Waggoner "Cosmic Microwave Background Radiation" by William Meikle "Malformed Articulation" by W. H. Pugmire "Bit by Bit" by Don Webb "Let me Talk to Sarah" by Christine Morgan "The Hunger" by Peter Rawlik "The Colors Of A Rainbow To One Born Blind" by Edward M. Erdelac "The River and the Room" by Joseph S. Pulver, Sr. "Veteran of the Future Wars" by Orrin Grey "Folie et déraison" by Nick Mamatas "Red Hook" by Glynn Owen Barrass "Clicks" by Stephen Mark Rainey "...&amp; My Shoes Keep Walking Back To You" by Edward Morris "Forbidden Fruit" by Cody Goodfellow "Stained Glass" by Jeffrey Thomas</ex:hasAnnotation>
    <ex:hasAuthorW>Editor: Brian M. Sammons</ex:hasAuthorW>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>208</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>October 2022</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Ghulistan_Affair">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Ghulistan Affair</rdfs:label>
    <ex:hasAnnotation>Sam Inabinet English Ulthar Press Pickman's Gallery date 2018 " " is a short Cthulhu Mythos story by Sam Inabinet, first published in the Ulthar Press anthology Pickman's Gallery in 2018. Synopsis The story is for the most part a conversation between two men, implied to be special agents in the employ of the British government, on the state of affairs regarding the various non-human humanoid creatures which inhabit a vague geographical region incorporating India to Central Asia. In particular, their discourse revolves around an ill-fated expedition to an area known as the Land of Ghouls , and their ultimate realisation that one of the few survivors was, most likely, a ghoul himself. The story concludes with what appears to be noises of an attack on their safe house, and the implication that ghoul footsoldiers have come to wipe out all those who know of their existence. Behind the Mythos One of the names mentioned by the men in connection with their topic is Swami Chandraputra , although both confess to having been an able to find anyone with knowledge on who that may be.</ex:hasAnnotation>
    <ex:hasAuthorW>Sam Inabinet</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Pickmans_Gallery"/>
    <ex:wasPublishedOnW>2018</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Michael_Reaves">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Michael Reaves</rdfs:label>
    <ex:hasAnnotation>James reaves was an american author who wrote a number of works set in the cthulhu mythos . He contributed stories to the anthologies the children of cthulhu and shadows over baker street . He also developed the animated series conan and the young warriors .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Strange_Terror_From_Beyond">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Strange Terror From Beyond</rdfs:label>
    <ex:hasAnnotation>" from beyond " is a short story by american and artist frank forte . It was published in his collection beyond lovecraft by asylum press in september 2020 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Frank_Forte"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Beyond_Lovecraft"/>
    <ex:wasPublishedOnW>September 2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Forrest_J_Ackerman">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Forrest J Ackerman</rdfs:label>
    <ex:diedOnR>4 December 2008</ex:diedOnR>
    <ex:hasAnnotation>Forrest james ackerman was an american magazine editor, science fiction writer and literary agent who lived and worked in los angeles . He was a principal founder of science fiction fandom and the concept of a modern organised fandom . He was also the world's most passionate collector (unverifiable claim) of genre books and film memorabilia .</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Los Angeles! California</ex:hasBirthplaceR>
    <ex:hasFullNameR>Forrest James Ackerman</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:wasBornOnR>24 November 1916</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Xoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Stars"/>
    <rdfs:label>Xoth</rdfs:label>
    <ex:hasAnnotation>Cthulhu mated with idh-yaa to beget ghatanothoa , ythogtha , and zoth-ommog . Is also the native home of ycnágnnissz and zstylzhemghi . Was the temporary home of the latter's "husband", ghisguth .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#Selected_Letters_of_Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Wakes">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Wakes</rdfs:label>
    <ex:hasAnnotation>Full story online here Michael Fantina United States English Genre(s) Horror Nightscapes #11 date August 1999 " " is a short Cthulhu Mythos poem by American Michael Fantina . Synopsis As it’s title might suggest, the fifteen lines of "" describe the moment when the Great Old One Cthulhu awakens. History "" was published in the E. P. Berglund -edited online Mythos fanzine Nightscapes in August 1999.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Michael_Fantina"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Nightscapes #11</ex:isPublishedAsW>
    <ex:wasPublishedOnW>August 1999</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Shard">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsOriginatingFromMythosAdjacentWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>The Shard</rdfs:label>
    <ex:hasAnnotation>Created by steven moffat was a created by bbc in 2013 for doctor who . Background was a skyscraper which was located in early 21st century london . From which a group led by miss kizlet was using it as their headquarters .</ex:hasAnnotation>
    <ex:hasTypeL>Building</ex:hasTypeL>
    <ex:isInhabitedByL>Great Intelligence Humans Spoonheads</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Earth"/>
    <ex:isLocatedAtL>London</ex:isLocatedAtL>
    <ex:isLocatedAtL>UK</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL>The Bells of Saint John</ex:madeFirstAppearanceOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Patriarch_Michael">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdfs:label>Patriarch Michael</rdfs:label>
    <ex:ceasedOnC>1059AD</ex:ceasedOnC>
    <ex:hasAffiliationC>Eastern Orthodox Church</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Michael Keroularios</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Michael was patriarch of constantinople from 1043 to 1059 . Conflict with pope leo ix over ritual, theology, and church hierarchy led to the great schism of 1054 .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#History_of_the_Necronomicon"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ycn%C3%A1gnnisssz">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OuterGods"/>
    <rdfs:label>Ycnágnnisssz</rdfs:label>
    <ex:hasAffiliationC>Outer Gods</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>or Ubbo-Sathla</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>possibly Abhoth</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Ycnàgnnissz is a hyperborean name for one of the progenitors of the gods ( azathoth being the other) it is a fissionary being and is probably either abhoth or ubbo-sathla . However these two names are also hyperborean, so it may be a different entity .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Selected Letters of Clark Ashton Smith 189</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cotton_Mather">
    <rdf:type rdf:resource="http://example.org/lovecraft#AlterEgosCharactersIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Cotton Mather</rdfs:label>
    <ex:diedOnR>13 February 1728</ex:diedOnR>
    <ex:hasAnnotation>Mather was a puritan minister perhaps best known for his involvement in the salem witch trials of the late 17th century . He has intersected with various aspects of this wiki, both in the real life and as a fictional character . In one of his books, mather wrote about the birth of a mysterious creature known as "the thing with the blemished eye"</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA http://example.org/lovecraft#Boston http://example.org/lovecraft#Massachusetts</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:wasBornOnR>12 February 1663</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shadows_Over_Baker_Street">
    <rdf:type rdf:resource="http://example.org/lovecraft#Crossovers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Shadows Over Baker Street</rdfs:label>
    <ex:hasAnnotation>464 is a thematic anthology in which the stories blend the cases of arthur conan doyle's master detective sherlock holmes with elements of the cthulhu mythos . Unlike in doyle's original stories, where the supernatural is only used as red herring plot devices, here it is all too real . It was first published in september 2003 by ballantine books' science fiction/fantasy imprint del rey books .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasGenreW>Detective</ex:hasGenreW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>464</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>September 2003</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Pnidleethon">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Planets"/>
    <rdfs:label>Pnidleethon</rdfs:label>
    <ex:hasAnnotation>A fictional planet first mentioned by clark ashton smith in his story fragment "the infernal star" and later expanded upon by john w. patterson in " priestess of nycrama " . It is a planer which orbits the binary star system comprised of yamil zacra and yuzh . Every night, the planet is scoured by enormous flocks of red-eyed, bat-winged creatures called pnumbrals, whose purpose is to "elim</ex:hasAnnotation>
    <ex:hasAppearanceL rdf:resource="http://example.org/lovecraft#Priestess_of_Nycrama"/>
    <ex:hasTypeL>Planetary body</ex:hasTypeL>
    <ex:madeFirstAppearanceOnL>The Infernal Star</ex:madeFirstAppearanceOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Pacific_Ocean">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Pacific Ocean</rdfs:label>
    <ex:hasAnnotation>The pacific, the largest ocean on earth, lies between north america, south america, asia, australia, and antarctica . The sunken city of r'lyeh is located beneath the waves of the .</ex:hasAnnotation>
    <ex:hasAppearanceL rdf:resource="http://example.org/lovecraft#The_Call_of_Cthulhu"/>
    <ex:hasTypeL>Ocean</ex:hasTypeL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#Dagon"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sundered">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Sundered</rdfs:label>
    <ex:hasAnnotation>Metroidvania roguelike is an indie video game developed by thunder lotus games . The game rigidly follows the topics of the cthulhu mythos . The story takes place in the ruins of the eschaton civilization .</ex:hasAnnotation>
    <ex:wasPublishedOnW>28 July 2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Music_of_Mi-Go">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Music of Mi-Go</rdfs:label>
    <ex:hasAnnotation>Full story online here Chad Hensley United States English Nightscapes #3 date March 1992 " " is a short Cthulhu Mythos poem by American Chad Hensley . Synopsis The poem's seventeen lines describe a fateful encounter with the alien Mi-Go . History The Silver Web #8 (1992) Cthulhu Codex Lammas 1997 (1997) Nightscapes #3 (1997)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Chad_Hensley"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Nightscapes #3</ex:isPublishedAsW>
    <ex:wasPublishedOnW>March 1992</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#New_York_State">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>New York State</rdfs:label>
    <ex:hasAnnotation>H. p. lovecraft lived in and wrote repeatedly about new york city . But he also had a connection to the expansive, largely rural area to the north and west of the city, known as upstate new york . Lovecraft visited the near-upstate towns of yonkers and tarrytown in september 1925, as well as the long island villages of jamaica, mineola, hempstead .</ex:hasAnnotation>
    <ex:hasAppearanceL>Beyond the Wall of Sleep The Lurking Fear The Man of Stone The Diary of Alonzo Typer</ex:hasAppearanceL>
    <ex:hasTypeL>State</ex:hasTypeL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#United_States_of_America"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dennis_Detwiller">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Dennis Detwiller</rdfs:label>
    <ex:hasAnnotation>(born 12 juillet 1972) is an american traditional and video games creator, author, editor, and occasional artist . Co-created the award-winning delta green roleplaying setting with adam scott glancy and pagan founder john scott tynes . Detwiller has since mostly left the traditional games industry and now works as video games designer .</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://arcdream.com/home/</ex:hasWebsiteR>
    <ex:hasYearsActiveR>1991-present</ex:hasYearsActiveR>
    <ex:isConnectedToMythosR>Games Designer</ex:isConnectedToMythosR>
    <ex:wasBornOnR>12 July 1972</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Mysteries_of_Mesoamerica">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Mysteries of Mesoamerica</rdfs:label>
    <ex:hasAnnotation>Various Blair Reynolds Cover Artist Blair Reynolds English Call of Cthulhu Genre(s) Roleplaying game Pagan Publishing Release Date 2008 216 is a setting and scenario sourcebook for Chaosium 's Call of Cthulhu horror roleplaying game. It was published by third-party content provider Pagan Publishing under licence in 2008 . Overview The book provides information "describing the cultures that dominated the New World before the arrival of Columbus" as well as "modern states of the region including revolutionary Mexico and Banana Republics like Honduras." Also included is material on significant historical figures, mythology and religion, and weaponry . Scenarios "The Well of Sacrifice" ( John H. Crowe III , set in 1914) "The Mehirs in the Grotto" ( Brian Appleton , set in 1923) "The Heretics" (John H. Crowe III, set in 1925) "The Temple of the Toad" (Brian Appleton, set in 1927) Design Team Development and editing: Brian Appleton , John H. Crowe III , and Blair Reynolds Written by: Brian Appleton, John H. Crowe III, Blair Reynolds, and Clint Staples Cover art, illustration, graphic design, photography, and layout: Blair Reynolds Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>216</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2008</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#When_Old_Gods_Awaken">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>When Old Gods Awaken</rdfs:label>
    <ex:hasAnnotation>Full story online here Ron Shiflet United States English Publication date July 1998 " " is a Cthulhu Mythos poem by American Ron Shiflet . Synopsis The four verses comprise a cautionary piece on what will happen when the Great Old Ones , Cthulhu and Hastur in particular, awaken from their slumber. Publication History First published in the July 1998 edition of online fanzine Nightscapes , "" also appeared in the short-lived publication The Ancient Track in October of the same year.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>July 1998</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dwellers_Under_the_Tombs">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RobertEHowardWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dwellers Under the Tombs</rdfs:label>
    <ex:hasAnnotation>Story appears to be a sequel to howard's cthulhu mythos story " the children of the night " first published in 1931 . Story features characters--or at least names--that first appeared in howard's story "the children of the night"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Lost Fantasies 4</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1967</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Alex_S._Johnson">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Alex S. Johnson</rdfs:label>
    <ex:hasAnnotation>Horror is an author, poet and editor who has produced a handful of works inspired by howard phillips lovecraft and the cthulhu mythos . These have appeared in collections such as james ward kirk publishing's 2015 anthology lovecraft after dark and gavin chappell's quarterly zine lovecraftiana . In 2024, horror was also involved</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Gentleman_from_Mexico">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Gentleman from Mexico</rdfs:label>
    <ex:hasAnnotation>A literary agent meets a man in mexico who acts, speaks, and writes exactly like h. p. lovecraft . Felipe lópez has "an olive complexion and "the features of a mestizo," and is "about forty years old" lópez insists that he is merely a lunatic under the delusion that he is lovecraft .</ex:hasAnnotation>
    <ex:hasAuthorW>Mark Samuels</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Summer Chills: Tales of Vacation Horror</ex:isPublishedAsW>
    <ex:wasPublishedOnW>June 2007</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Margaret_Brundage">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Margaret Brundage</rdfs:label>
    <ex:diedOnR>9 April 1976</ex:diedOnR>
    <ex:hasAnnotation>Full Name Margaret Hedda Brundage (née Johnson) Connection to the Mythos Artist Birth Date 9 December 1900 Chicago, Illinois, USA Death Date 9 April 1976 United States 𝐓 Margaret Hedda Brundage (née Johnson , 9 December 1900-9 April 1976) was an American artist best known for her controversial Weird Tales images, a situation exacerbated by the fact that the artist was a woman. She illustrated many of the most memorable covers for the pulp magazine in the later years of its glory days during the 1930s. Brundage began working for Farnsworth Wright in 1932, when Wright hired her to provide cover art for Oriental Stories , a companion magazine to Weird Tales which proved unsuccessful. Her work on Oriental Stories was so well-received by Wright that he hired her to provide the covers for the far more popular Weird Tales , which she did between 1932 and 1945, although her most prolific years were between 1933 and 1938. External Links at Wikipedia at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Chicago Illinois</ex:hasBirthplaceR>
    <ex:hasFullNameR>Margaret Hedda Brundage (née Johnson)</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Artist</ex:isConnectedToMythosR>
    <ex:wasBornOnR>9 December 1900</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Spot_%28Howard_Lovecraft%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Avatars"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Spot (Howard Lovecraft)</rdfs:label>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#Cthulhu"/>
    <ex:hasAlternativeNamesC>Thu Thu Hmong</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Spot is a character who appears in arcana studio's howard lovecraft series of children's comics . He made his first appearance in the graphic novel howard lovecraft and the frozen kingdom .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Howard Lovecraft</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>the Frozen Kingdom</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Bruce_Brown"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Ring_of_Set">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Ring of Set</rdfs:label>
    <ex:hasAnnotation>Simon of gitta is a short story written by british author richard l. tierney . It was the first of his simon of gitta tales to be published . The story involves the ex-gladiator's attempt to retrieve a cursed magic item . The ring was once owned by the sorcerer thoth-amon .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Richard_L._Tierney"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasGenreW>Sorcery</ex:hasGenreW>
    <ex:hasGenreW>Swords</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Simon_of_Gitta"/>
    <ex:isPublishedAsW>Swords Against Darkness</ex:isPublishedAsW>
    <ex:wasPublishedOnW>February 1977</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>1960</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Rheinhart_Kleiner">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#KalemClub"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsCorrespondents"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsInspirationsAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Rheinhart Kleiner</rdfs:label>
    <ex:diedOnR>1949</ex:diedOnR>
    <ex:hasAnnotation>Randolph st. john was an early correspondent of lovecraft . He inspired lovecraft to write poetry as well as being the sternest critic of lovecraft's racial and atheist philosophy . Their correspondence was collected in letters to ,</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasPseudonymR>Randolph St John</ex:hasPseudonymR>
    <ex:isConnectedToMythosR>Correspondent of Lovecraft</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1892</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bones">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Bones</rdfs:label>
    <ex:hasAffiliationC>Black Death motorcycle gang</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Bobby Anderson</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Barren is a character created by author armand rosamilia for his keyport cthulhu series of mythos stories . Has a tremendous capacity for violence, but has also displayed great compassion when dealing with those in need . Possesses a seemingly supernatural ability to judge the character of others, although he believes it only works on around 25% of those he meets .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Barren"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Armand_Rosamilia"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#John_Four">
    <rdf:type rdf:resource="http://example.org/lovecraft#CaitlinRKiernanWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>John Four</rdfs:label>
    <ex:hasAnnotation>The story is set after the return of the great old ones, in a temple in the last city of humanity . The title is a reference to the fourth chapter of the gospel of john . It later appeared in kiernan's collection houses under the sea: mythos tales .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Sirenia_Digest"/>
    <ex:wasPublishedOnW>September 2010</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#O_Fortunate_Floridian:_H._P._Lovecrafts_Letters_to_Robert_H._Barlow">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>O Fortunate Floridian: H. P. Lovecraft's Letters to Robert H. Barlow</rdfs:label>
    <ex:hasAnnotation>O fortunate floridian: h. p. lovecraft's letters to r. h. barlow is a non-fiction work edited by lovecraft scholars s. t. joshi and david e. schultz . Published by university of tampa press in 2007 . Runs to a total of 465 pages .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:hasPageCountW>465</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2007</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Edward_P._Berglund">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Edward P. Berglund</rdfs:label>
    <ex:diedOnR>June 2019</ex:diedOnR>
    <ex:hasAnnotation>Full Name Edward Paul Berglund Pseudonym(s) Pierre de Hammais E. P. Berglund Connection to the Mythos Editor Author Birth Date 28 October 1942 Vallejo, California, USA Death Date June 2019 United States Horror Science Fiction Fantasy http://www.epberglund.com/RGttCM/contents.htm Edward Paul Berglund (28 October 1942 - June 2019) was an American editor, author, paralegal and former US Marine. Working in the horror, science fiction and fantasy genres, he worked on a plethora of anthologies and zines, and specialised in editing non-professional Cthulhu Mythos stories. He edited the seminal Mythos anthology The Disciples of Cthulhu (DAW Books, 1976). Selected Bibliography Editor Beyond the Dark Gateway (1973) The Disciples of Cthulhu (1976) The Disciples of Cthulhu II: Blasphemous Tales of the Followers (2003) Nightscapes (1997-2006) Author Collections Shards of Darkness (2000) " Feast with a Few Strangers " (1974) " Wings in the Night " (1975) "The Towers" (1976) "The Sand Castle" (1981) "Memories" (2000) "The Flautists" (2001) "Cat's-Paw" (2004) "A Dangerous High" (2006) Non-Fiction Reader's Guide to the Cthulhu Mythos (1973) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA http://example.org/lovecraft#California Vallejo</ex:hasBirthplaceR>
    <ex:hasFullNameR>Edward Paul Berglund</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasPseudonymR>E. P. Berglund</ex:hasPseudonymR>
    <ex:hasPseudonymR>Pierre de Hammais</ex:hasPseudonymR>
    <ex:hasWebsiteR>http://www.epberglund.com/RGttCM/contents.htm</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
    <ex:wasBornOnR>28 October 1942</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#On_The_Thing_in_the_Woods_by_Harper_Williams">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>On The Thing in the Woods by Harper Williams</rdfs:label>
    <ex:hasAnnotation>On The Thing in the Woods by Harper Collins H. P. Lovecraft United States English Night Shade Books The Ancient Track: The Complete Poetical Works of H. P. Lovecraft Date of writing 29 November 1924 date July 2001 " On The Thing in the Woods by Harper Collins " is a poem by the late American H. P. Lovecraft . Although dated 29 November 1924, it remained unpublished until decades after his death, when it made its first appearance in the 2001 Night Shade Books anthology The Ancient Track: The Complete Poetical Works of H. P. Lovecraft . Overview The poem is a commentary on the 1913 children’s novel The Thing in the Woods , a story concerning lycanthropy in rural Pennsylvania, by Margery Williams; when published in America, the book had been issued under the pseudonym Harper Collins. It has been speculated to have been an influence on Lovecraft's 1929 short story "The Dunwich Horror" , which may be supported by his writing of this piece. References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Ancient_Track:_The_Complete_Poetical_Works_of_H._P._Lovecraft"/>
    <ex:wasPublishedOnW>July 2001</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>29 November 1924</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lucy_Fry">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Lucy Fry</rdfs:label>
    <ex:diedOnR>17 June 1884</ex:diedOnR>
    <ex:hasAnnotation>Sister of Richard Fry and wife of Benoni Phillips, whom she married in 1811. She gave birth to &lt;i&gt;11&lt;/i&gt; children: Almyra, Eliza L., Susan, Olney, Harley F., Mary Ann, Asaph, Jeremiah Benoni, Esther W., James W., and Lucy E.</ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1794</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Jar_of_Aten-Hor">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Jar of Aten-Hor</rdfs:label>
    <ex:hasAnnotation>Beth stanton is an enthusiastic and dedicated anthropologist whose area of expertise is ancient egypt . As her sanity degenerates under the urn's hold, she commits ritual suicide under the approving gaze of nathanial hotep .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Kat_Rocha"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Whispers_from_the_Abyss"/>
    <ex:wasPublishedOnW>November 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Episode_in_an_Arkham_Pool_Hall">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Episode in an Arkham Pool Hall</rdfs:label>
    <ex:hasAnnotation>A man having a drink in an arkham pool hall witnesses two former professionals hustling an academic-looking man . The professor is not all he appears to be, and after a brief bout of spellcasting, his opponents lie dead . " The professor ", an unnamed wizard and possible occultist, issues a dire prophecy concerning the imminent return of the great old ones .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#James_Ambuehl"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror Black Comedy</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasWrittenOnW>2006</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Thrall_of_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ServitorRaces"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Thrall of Cthulhu</rdfs:label>
    <ex:hasAnnotation>Real World Information First appearance EXP : " The Fairground Horror " EXP : The Great Old Ones ( Call of Cthulhu supplement) Created by Brian Lumley The Thralls of Cthulhu are mutated cultists created by Brian Lumley for his short story " The Fairground Horror " and later expanded upon by Chaosium for their Call of Cthulhu horror role-playing game. Description The Thralls of Cthulhu are worshippers of the Great Old One Cthulhu that have been mutated into bloated grey-skinned forms through a ritual. Behind the Mythos The Thralls were first incorporated into Call of Cthulhu by Doug Lyons in the 1989 supplement The Great Old Ones . References</ex:hasAnnotation>
    <ex:hasAppearanceC>The Great Old Ones</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Fairground_Horror"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Curse_of_the_Golden_Skull">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RobertEHowardWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Curse of the Golden Skull</rdfs:label>
    <ex:hasAnnotation>Kull of atlantis first appeared in the spring 1967 issue of the howard collector . The story is notable for the first mention of a cosmic adversary by marvel comics . The story is about a sorcerer who curses "all men living and dead"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
    <ex:hasGenreW>Sorcery</ex:hasGenreW>
    <ex:hasGenreW>Sword</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Kull of Atlantis</ex:isPartOfSeriesW>
    <ex:isPublishedAsW>The Howard Collector</ex:isPublishedAsW>
    <ex:wasPublishedOnW>Spring 1967</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Leviathan_%28Supernatural%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Leviathan (Supernatural)</rdfs:label>
    <ex:hasAnnotation>The leviathans are a shapeshifting race that sees other lifeforms as inferior, to be destroyed or treated as a food source . In their true forms, they are perceived by humans as balls of black goo with powerful jaws . In the show's mythology, they predate the angels and are virtually indestructible .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Cultus_Issue_15">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Periodicals"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Cultus Issue 15</rdfs:label>
    <ex:hasAnnotation>Cthulhu Cultus #15 Various Cover Artist Tani Jantsang United States English P. Marsh Release Date February 1999 62 Preceded by Cthulhu Cultus #14 Followed by Cthulhu Cultus #16 Cthulhu Cultus #15 is an issue of sporadic American fanzine Cthulhu Cultus , edited by Tani Jantsang and James Ambuehl and published by P. Marsh in February 1999. Contents "Into the Night" R. D. Bookout "Briny Bill" by Tracy Ambuehl "Death-Walker" by Tracy Ambuehl "The Corporal's Curse" by Brian Nutter "Slithering Doom" by Tracy Ambuehl "The Killing of Cthulhu" by James Ambuehl "The Lake" by James Ambuehl "The Bowels of the Earth" by Becca Borgne and Lee Clark "Forbidden Rock" by P. J. Roberts "Todger's Town" by D. F. Lewis "Shub-Niggurath's Song" by Tracy Ambuehl "The Isle of Chor-Tal" by Ron Shiflet "The Ninth Planet" by Lee Clark "The Image from Hubble" by Lee Clark "The Watery Horror" by Peter F. Guenther "Tentacle Dreams" by Ron Shiflet " The Summoning of Tsathoggua " by Ron Shiflet " The Scuttler in the Dark " by R. S. Cartwright "Atlach-Nacha" by James Ambuehl "The Maleficent Seven (or, Cthulhu and the Indians)" by Todd H. C. Fischer "And No One Heard" by Rob Morris</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>62</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>February 1999</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Innsmouth_Legacy">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#StoryCycles"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Innsmouth Legacy</rdfs:label>
    <ex:hasAnnotation>The is a cthulhu mythos fiction series by ruthanna emrys . It focuses on the survivors of the government raids on innsmouth depicted in h. p. lovecraft's the shadow over innsmouth . Worship of the mythos entities is a religion known as aeonism .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ruthanna_Emrys"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2014</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Flame_of_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Flame of Cthulhu</rdfs:label>
    <ex:hasAnnotation>Josh Brown English James Ward Kirk Publishing Lovecraft after Dark date November 2015 " " is a Cthulhu Mythos poem by American Josh Brown . It was published in the anthology Lovecraft after Dark by James Ward Kirk Publishing in November 2015. Synopsis The 26 lines describe the coupling of the Great Old One Cthulhu and its monstrous mate Idh-yaa in graphic detail.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Josh_Brown"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Lovecraft_after_Dark"/>
    <ex:wasPublishedOnW>November 2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Azathoth_Cycle">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Azathoth Cycle</rdfs:label>
    <ex:hasAnnotation>Various United States English Genre(s) Horror Chaosium Release Date March 1995 234 In 1995, Chaosium published : Tales of the Blind Idiot God , a Cthulhu Mythos anthology focusing on works referring to or inspired by the entity Azathoth . Edited by Lovecraft scholar Robert M. Price , the book includes an introduction by Price tracing the roots and development of the Blind Idiot God. Contents "Azathoth (Derby)" by Edward Pickman Derby "Azathoth in Arkham" by Peter Cannon "The Revenge of Azathoth" by Peter Cannon "The Pit of the Shoggoths" by Stephen M. Rainey " Hydra " by Henry Kuttner "The Madness Out of Time" by Lin Carter " The Insects from Shaggai " by Ramsey Campbell "The Sect of the Idiot" by Thomas Ligotti "The Throne of Achamoth" by Richard L. Tierney &amp; Robert M. Price "The Last Night of the Earth" by Gary Myers "The Daemon-Sultan" by Donald R. Burleson "Idiot Savant" by C. J. Henderson "The Space of Madness" by Stephen Studach "The Nameless Tower" by John Glasby "The Plague Jar" by Allen Mackey "The Old Ones’ Promise of Eternal Life" by Robert M. Price</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>234</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>March 1995</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sadu-Hem">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Sadu-Hem</rdfs:label>
    <ex:ceasedOnC>20th Century</ex:ceasedOnC>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Ogdru_Jahad"/>
    <ex:hasAnnotation>Ogdru jahad was the first ogdru hem to be encountered in hellboy . He was later destroyed mostly, when abe sapien speared rasputin to death and liz sherman set the cavendish hall on fire .</ex:hasAnnotation>
    <ex:hasCharacterMateC>None</ex:hasCharacterMateC>
    <ex:madeFirstAppearanceOnC>Hellboy: Seed of Destruction</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Mike_Mignola"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tower_of_Shadows">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Tower of Shadows</rdfs:label>
    <ex:hasAnnotation>"creatures on the loosese" was a bi-monthly comic book anthology series which ran for six years between 1969 and 1975 . It initially printed stand-alone horror stories, but after rebranding moved on to primarily fantasy works, and several stories appeared in its pages over the years . "thongor : warrior of lost lemuria!" Appeared in issue #22 .</ex:hasAnnotation>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
