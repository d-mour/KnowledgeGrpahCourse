    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Priestess of Nycrama</rdfs:label>
    <ex:hasAnnotation>The story was first published in the december 1999 edition of edward berglund's online fanzine nightscapes . It has since been independently published as a digital chapbook through amazon's digital platform, with the release having two different covers .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#John_W._Patterson"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Nightscapes_December_1999"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Army_of_Darkness:_From_the_Ashes">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Army of Darkness: From the Ashes</rdfs:label>
    <ex:hasAnnotation>Arc was a 4-issue story arc in issues #1-4 of the 2nd volume of army of darkness . Written by james kuhoric and published in 2007 by dynamicmite entertainment .</ex:hasAnnotation>
    <ex:hasAuthorW>James Kuhoric</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>Aug 2007 - Nov 2007</ex:wasReleasedOnW>
