    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dark Gods</rdfs:label>
    <ex:hasAnnotation>Collection of lovecraftian novellas by t. e. d. klein . Originally published by viking in 1985 . Three of the stories are set in new york city .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#T._E._D._Klein"/>
