  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Haunted_Palace">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleFilmAndTelevisionAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Haunted Palace</rdfs:label>
    <ex:hasAnnotation>Based on The Case of Charles Dexter Ward Roger Corman Roger Corman H. P. Lovecraft (original story) Charles Beaumont (screenplay) Vincent Price Lon Chaney Jr. Debra Paget Ronald Stein Floyd Crosby Ronald Sinclair Production Company Alta Vista Productions American International Pictures Release date 28 August 1963 Running time 87 minutes United States English Box office $1,200,000 (US/Canada) is a 1963 American horror film Vincent Price and Lon Chaney Jr. Synopsis Charles Dexter Ward arrives at a small village to visit the house he inherited from his ancestor who died there 100 years ago. Behind the Mythos Directed by Roger Corman in 1963, produced by Alta Vista Productions, and distributed by American International Pictures, was marketed as part of Corman's series of films based on the works of Edgar Allan Poe despite the fact that it was (loosely) based on The Case of Charles Dexter Ward by H. P. Lovecraft .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasWriterW>H. P. Lovecraft (original story) Charles Beaumont (screenplay)</ex:hasWriterW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Case_of_Charles_Dexter_Ward"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>28 August 1963</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Shadow_Over_Innsmouth_%28ARTC_audio_drama%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAudioAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Shadow Over Innsmouth (ARTC audio drama)</rdfs:label>
    <ex:hasAnnotation>The Shadow Over Innsmouth (ARTC audio drama) Based on The Shadow Over Innsmouth Thomas E. Fuller Henry Howard Production Company Atlanta Radio Theatre Company United States English The Shadow Over Innsmouth is an audio drama adaptation of the H. P. Lovecraft short story of the same name produced by the Atlanta Radio Theatre Company . It was performed live on stage at Dragon*Con in 1992. Both compact disc and digital versions are available through the ARTC website.</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Shadow_Over_Innsmouth"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
