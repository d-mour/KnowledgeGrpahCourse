  <rdf:Description rdf:about="http://example.org/lovecraft#Cthylla">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Cthylla</rdfs:label>
    <ex:hasAffiliationC>Cthulhi Yuggs</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Kraken</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Secret Daughter</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Secret One</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Created by brian lumley, also known as the kraken or the secret one . Is the daughter of cthulhu and his androgynous mate idh-yaa . Destined to give birth to him once again if he is destroyed in the distant future . Is guarded by countless yuggya and deep ones .</ex:hasAnnotation>
    <ex:hasAppearanceC>In His Daughter's Darkling Womb ( Tina L. Jens )</ex:hasAppearanceC>
    <ex:hasAppearanceC>In the Hall of the Yellow King ( Peter Rawlik )</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Transition_of_Titus_Crow"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Josh_Finney">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Josh Finney</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Artist United States is an American author, artist and comic book creator currently living in San Diego, California. He has written at least one Mythos -related story, and provided cover art for the anthology in which it appeared. Selected Works Short Fiction " Death Wore Greasepaint " (2013) Comic Books Casefile: Arkham- Nightmare on the Canvas (2016) Casefile: Arkham- Her Blood Runs Cold (2018) Cover Art Whispers from the Abyss (2013) See Also Images by</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Artist</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mount_Noton">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Mount Noton</rdfs:label>
    <ex:hasAnnotation>Dreamlands ( Lomar ) Mountain First appearance HPL : " Polaris " Created by H. P. Lovecraft is a mountain in the far northern kingdom of Lomar in the Dreamlands . Between this mountain and Mount Kadiphonek is the Plateau of Sarkis , the site of the city of Olathoë . From behind is a narrow pass that leads to Olathoë and is guarded by the Watchtower of Thapnen . ( HPL : " Polaris ")</ex:hasAnnotation>
    <ex:hasTypeL>Mountain</ex:hasTypeL>
    <ex:isLocatedAtL>Dreamlands ( Lomar )</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#Polaris"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Swords_Against_Cthulhu_III:_A_New_Dark_Age">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Swords Against Cthulhu III: A New Dark Age</rdfs:label>
    <ex:hasAnnotation>Various English Rogue Planet Press Release Date 2018 208 is a thematic anthology of Lovecraftian fiction edited by Gavin Chappell and published by Rogue Planet Press in 2018. Both physical and digital editions were released. Overview Contents (incomplete) " When He Arrived " by Norbert Gora " The Savage Sword of Google " by Elizabeth Davis " Demons in the Shell " by Thomas V. Powers</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>208</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2018</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#H._P._Lovecrafts_Haunt_of_Horror">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>H. P. Lovecraft's Haunt of Horror</rdfs:label>
    <ex:hasAnnotation>Comic book is a 3-part miniseries adapted for the comic book format . It was published by marvel's adult-only imprint, max comics . Each issue is 3 stories, none of which occur in the mainstream marvel prime reality (earth-616)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Richard_Corben"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>August 2008 - October 2008</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Loot_of_Golthoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Loot of Golthoth</rdfs:label>
    <ex:hasAnnotation>Gary Myers United States English Arkham House The Arkham Collector Summer 1970 date 1970 , also published under the title "The Feast in the House of the Worm", is a short story written by American Gary Myers , and first published in the Arkham House periodical The Arkham Collector in 1970. Synopsis TBH . History The Arkham Collector (1970) The Arkham Collector Volume 1 (1971) New Worlds for Old (1971) The House of the Worm (1975) La furia di Cthulhu (1987, French- anthology) The of the Worm: Excursions Beyond the Wall of Sleep (2013)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Gary_Myers"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>The Arkham Collector Summer 1970</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1970</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Ithaqua_Cycle">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Ithaqua Cycle</rdfs:label>
    <ex:hasAnnotation>Various Dave Carson Cover Artist H. E. Fassl United States English Call of Cthulhu Fiction Genre(s) Horror Chaosium Release Date July 1998 256 : The Wind-Walker of the Icy Wastes is a thematic Cthulhu Mythos anthology. Overview As its title suggests, contains stories centred around the Great Old One Ithaqua created by August Derleth , which was inspired by Algernon Blackwood 's short story " The Wendigo ", also included. Edited by noted Lovecraft scholar Robert M. Price , who also provided an introduction for each of the stories, it was published by Chaosium and runs to 256 , with the first edition released in 1998 and a second edition in 2006. Cover art was supplied by H. E. Fassl with an interior plate by Dave Carson . Contents artwork by Dave Carson Introduction: "Ghost Riders in the Sky" by Robert M. Price " The Wendigo " by Algernon Blackwood "The Thing from Outside" by George Allan England " The Thing That Walked on the Wind " by August Derleth " The Snow-Thing " by August Derleth (variant of "Ithaqua") " Beyond the Threshold " by August Derleth " Born of the Winds " by Brian Lumley " Spawn of the North " by George C. Diezel, II and Gordon Linzner " They Only Come Out at Night " by Randy Medoff " Footsteps in the Sky " by Pierre Comtois " Jendick's Swamp " by Joseph Payne Brennan " The Wind Has Teeth " by Scott H. Urban and G. Warlock Vance " Stalker of the Wild Wind " by Stephen M. Rainey " The of the Wind " by Pierre Comtois " Wrath of the Wind-Walker " by James Ambuehl Gallery</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>256</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu Fiction</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>July 1998</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#At_the_Mountains_of_Murkiness">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Pastiches"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>At the Mountains of Murkiness</rdfs:label>
    <ex:hasAnnotation>" , or, from lovecraft to leacock " is a short story by the late british arthur c. clarke . It was first published in the march 1940 edition of fanzine the satellite . Tells of how his group stumbled across the ancient civilisation of the elder ones, existing quietly for millennia beneath mount morgue . But soon realise that the elder ones wish to destroy the human race .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Arthur_C._Clarke"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>The Satellite</ex:isPublishedAsW>
    <ex:wasPublishedOnW>March 1940</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Wendell_Trepan">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Wendell Trepan</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Miskatonic_University"/>
    <ex:hasAnnotation>Student Miskatonic University Human First appearance EXP : " The Freshman " Created by Philip José Farmer is a fictional character who appears in Philip José Farmer 's short story " The Freshman ". He is an upperclassman at Miskatonic University and chairperson of the rushing committee for the Lam Kha Alif fraternity, Farmer provides a description of Trepan: Trepan has minor magical abilities--for example, the ability to temporarily relax magical protections on books. He claims to be the descendant of "the Cornish witch, Rachel Trepan ". She is said to be from "Tredannick Wollas near Poldhu Bay"; the body of water is real, the village is a fictional one that appears in the Sherlock Holmes story "The Adventure of the Devil's Foot". References</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Freshman"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Philip_Jos%C3%A9_Farmer"/>
  </rdf:Description>
