    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>An Index to the Selected Letters of H. P. Lovecraft</rdfs:label>
    <ex:hasAnnotation>50 is a non-fiction work by leading h. p. lovecraft scholar s. t. joshi . Written as an accompaniment to the selected letters of h. p. lovecraft . A second edition was issued in 1991. it is currently out of print .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#S._T._Joshi"/>
