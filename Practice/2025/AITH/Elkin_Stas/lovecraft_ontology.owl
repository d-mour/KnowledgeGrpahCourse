    <ex:wasPublishedOnW>May 2012</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Byatis">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Byatis</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Berkeley Toad</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The God of Forgetfulness</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Serpent-Bearded</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The berkeley toad or the serpent-bearded appears as a gigantic, multicolored toad with a single eye, claws similar to a crabs and a beard of tentacles . It has been associated with " yig " and " han ", as among the "gods of divination" an 18th-century document relates that a statue of the creature .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Beard_of_Byatis"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Room_in_the_Castle"/>
    <ex:isLocatedAtC rdf:resource="http://example.org/lovecraft#England"/>
    <ex:isLocatedAtC>Trapped beneath the Severn Valley</ex:isLocatedAtC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Shambler_from_the_Stars"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Robert_Bloch"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Celestial_Toymaker">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Celestial Toymaker</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Great_Old_One"/>
    <ex:hasAlternativeNamesC>The Guardian of Dreams The Mandarin The Crystal Guardian The Cosmic Puppetmaster</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The is a great old one created by the bbc in 1966 for doctor who . He is a mischievous spirit who got bored with games . He would ensnare sentient beings, forcing them to play for their freedom in his games .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Celestial Toymaker</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Brian Hayles</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Lurker_at_the_Threshold_%28Arkham_Horror_Expansion%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#ArkhamHorror"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Lurker at the Threshold (Arkham Horror Expansion)</rdfs:label>
    <ex:hasAnnotation>The Lurker at the Threshold Unknown United States English Arkham Horror Genre(s) Horror, Action Adventure Fantasy Flight Games Media Type Board Game, Role-playing Game The Lurker at the Threshold was a small box expansion pack for Arkham Horror Second Edition , Fantasy Flight Games ' board game of Lovecraftian adventure. Overview As a small-box set, The Lurker at the Threshold was a cards-only expansion, featuring 56 Investigator cards including new Items and Spells, and 110 Ancient One cards whose special effects were intended to spin games of Arkham Horror in different directions from the core set. In addition, this pack saw the introduction of the Relationship and Dark Pact mechanics to Arkham Horror. As its name might suggest, the Relationship mechanic allowed players to develop interpersonal relationships with one another, further enhancing the role-play aspect of the game, while the Dark Pact rules allowed players to make beneficial, but potentially highly costly, deals with the Lurker at the Threshold. Included Characters Heralds The Lurker at the Threshold</ex:hasAnnotation>
    <ex:hasAuthorW>Unknown</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Action Adventure</ex:hasGenreW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Arkham_Horror"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Satha">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Satha</rdfs:label>
    <ex:hasAlternativeNamesC>Satha the Great Serpent</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Satha the Old One</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Mighty Crawling One</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as the mighty crawling one the great serpent the old one . Created by robert e. howard . First appeared in the stories " the scarlet citadel " (1933) and the " the valley of the worm " (1934), conan and james allison stories respectively .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Scarlet_Citadel"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
  </rdf:Description>
