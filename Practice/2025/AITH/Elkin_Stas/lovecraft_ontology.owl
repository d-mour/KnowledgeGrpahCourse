  <rdf:Description rdf:about="http://example.org/lovecraft#Seven_Serpents_Waiting">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Seven Serpents Waiting</rdfs:label>
    <ex:hasAnnotation>Wendell willis has fled his home following the events detailed in " when in leng... ", seeking sanctuary in the swamps with his old friend tobias jackson . When willis discovers that jackson knows the secrets of serpent stealth, he kills his former friend and enacts the ritual . What he does not realise is that jackson has laid a trap for any who might try to steal his secrets . The story finds willis held captive in his magic circle, safe from the serpent-followers</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Imelod #17</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2000</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Michael_Marrak">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Michael Marrak</rdfs:label>
    <ex:hasAnnotation>Birth Date 5 November 1965 Weikersheim, Baden-Württemberg, Germany Germany Horror Science Fiction Notable Works EXP : Imagon (2002) http://www.michaelmarrak.de/  (born 5 November 1965) is a award-winning German science fiction and horror writer, editor, artist and video game creator, perhaps most relevant to this wiki for his 2002 Lovecraftian novel Imagon . Marrak has cited English-language authors Iain Banks and Philip José Farmer as two of his literary inspirations . Selected Works Author Imagon (2002) Artwork Imagon (2002, 2005) See Also Images by External Links at Wikipedia (English) at Wikipedia (German) at the Internet Speculative Fiction Database at Goodreads References</ex:hasAnnotation>
    <ex:hasBirthplaceR>Germany Baden-Württemberg Weikersheim</ex:hasBirthplaceR>
    <ex:hasNationalityR>Germany</ex:hasNationalityR>
    <ex:hasWebsiteR>http://www.michaelmarrak.de/</ex:hasWebsiteR>
    <ex:isKnownForR>Imagon (2002)</ex:isKnownForR>
    <ex:wasBornOnR>5 November 1965</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Robert_Bloch">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsCorrespondents"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Robert Bloch</rdfs:label>
    <ex:diedOnR>1994 23 September</ex:diedOnR>
    <ex:hasAnnotation>Robert a.bloch was a prolific american writer . He wrote hundreds of short stories and over twenty novels . He was the son of a bank cashier and his wife of german-jewish descent .</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Chicago Illinois</ex:hasBirthplaceR>
    <ex:hasFullNameR>Robert Albert Bloch</ex:hasFullNameR>
    <ex:hasNationalityR>American</ex:hasNationalityR>
    <ex:hasPseudonymR>Tarleton Fiske Will Folke Nathan Hindin E.K. Jarvis Floyd Scriltch Wilson Kane John Sheldon Collier Young</ex:hasPseudonymR>
    <ex:hasSpouseR>Marion Ruth Holcombe Eleanor Zalisko Alexander</ex:hasSpouseR>
    <ex:wasBornOnR>1917 5 April</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Last_Witch-House">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Last Witch-House</rdfs:label>
    <ex:hasAnnotation>The witch traps her unwitting husband in the prison of her soul as a punishment for his dismissal of their love . The man's attempts to break free of his confinement result in the irrevocable damage of her being . The two die together, locked together for eternity .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mark_McLaughlin"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Correlated_Contents">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Correlated Contents</rdfs:label>
    <ex:hasAnnotation>The story is part of a story cycle by american author and editor james ambuehl . It was first published in an anthology of stories by ambuehl, also called .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#James_Ambuehl"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>The Lu-Kthu Cycle</ex:isPartOfSeriesW>
    <ex:wasPublishedOnW>July 2000</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>1998</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kevin_J._Anderson">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Kevin J. Anderson</rdfs:label>
    <ex:hasAnnotation>Full Name Kevin James Anderson Connection to the Mythos Author Birth Date 27 March 1962 Racine, Wisconsin, USA United States https://wordfire.com/ Kevin James Anderson (born 27 March 1962) is a prolific American science fiction author and editor who wrote the Cthulhu Mythos story " 20,000 Years Under the Sea ", featuring Jules Verne's character Captain Nemo as reimagined in Anderson's novel Captain Nemo: The Fantastic History of a Dark Genius . With a long and varied career, Anderson has contributed stories in the form of novels, short tales and comic books to a large number of science fiction franchises, including The X-Files , Dune , Star Wars , The War of the Worlds , Star Trek , Titan A.E. , Superman , StarCraft , and Predator. Selected Works Short Fiction " 20,000 Years Under the Sea " (2015) Trivia In 1997, Anderson was a guest speaker at the cosmic horror-oriented convention NecronomiCon . External Links at Wikipedia at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Wisconsin Racine</ex:hasBirthplaceR>
    <ex:hasFullNameR>Kevin James Anderson</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://wordfire.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>27 March 1962</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lurker_in_the_Star_Pool">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Lurker in the Star Pool</rdfs:label>
    <ex:hasAnnotation>First appearance " The Star Pools " Created by A. A. Attanasio The is one of the Million Favoured Ones , beings granted a new form by Nyarlathotep . Description The is a massive translucent blob full of a red gas with multiple heads resembling sharks and squids as well as gangly limbs and bat-like wings. It dwells in the Star Pools, a collection of thousands of green ponds in Haiti.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Star Pools</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#A._A._Attanasio"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Fhtagn">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Fhtagn</rdfs:label>
    <ex:hasAnnotation>The are extradimensional eldritch entities which are able to bend the laws of physics and feed on evil . Their vocalizations are painful to humans, though if you have an evil soul you can withstand them . Their home dimension has not been seen yet, but it likes the bottom of the ocean, an area that is pitch dark, extremely cold, and with a high pressure .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Ben Reilly: Scarlet Spider Vol 1 #9</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Peter David</ex:wasCreatedByC>
    <ex:wasCreatedByC>William Sliney</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Richard_Corben">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Richard Corben</rdfs:label>
    <ex:diedOnR>2 December 2020</ex:diedOnR>
    <ex:hasAnnotation>Richard corben (1940-2020) was an american artist, writer, publisher, and animator . Corben is perhaps most well known for his work in the heavy metal magazine, including the saga of den, which features a cthulhu-like deity called uhluhtc .</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Missouri Anderson</ex:hasBirthplaceR>
    <ex:hasFullNameR>Richard Vance Corben</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Comic book creator</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1 October 1940</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Portents_and_Omens">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Portents and Omens</rdfs:label>
    <ex:hasAnnotation>John M. McCormick English Rogue Planet Press Lovecraftiana Lovecraftiana Vol 5, Issue 3 date October 2020 " " is a short Cthulhu Mythos story by John M. McCormick. It was published in Vol 5, Issue 3 of the Lovecraftiana zine by Rogue Planet Press in October 2020. Synopsis A man out foraging in the wooded hills of West Virginia accidentally disturbs a nest of yellowjackets, which causes him to fall down a steep incline. As he lies dying, he is approached by a mysterious stranger who offers him insights into life, death, and the nature of the universe. Before the stranger departs, leaving the man to his fate, he imparts the knowledge that "he that slumbers in the great halls of R'lyeh is beginning to stir once more".</ex:hasAnnotation>
    <ex:hasAuthorW>John M. McCormick</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 3</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Lovecraftiana Vol 5</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Alone_Against_the_Dark">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Alone Against the Dark</rdfs:label>
    <ex:hasAnnotation>102 : defying the triumph of the ice is a solo-play adventure module for chaosium's horror roleplay game call of cthulhu . Includes a party of five pregenerated characters with which to play, along with a selection of player aids . As the core rules for call of cthulhu are available for free on chaosium's website, all a player need bring is paper, pencil and dice .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mike_Mason"/>
    <ex:hasAuthorW>Matthew J. Costello</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>102</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>April 2018</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Child_of_Abhoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonSapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ServitorRaces"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Child of Abhoth</rdfs:label>
    <ex:hasAlternativeNamesC>Spawn of Abhoth</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The children of abhoth are the creatures which sloughed off the outer god 's bulk . They are complex life forms, although some do not appear to be "finished", with vestigial limbs and half-formed bodies . They range in looks from prehistoric creatures to singular body parts, weird humanoids, monstrous mutants, amorphous blobs of living flesh .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Ye_Booke_of_Monstres_II"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Seven_Geases"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Tower_of_Madness">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Tower of Madness</rdfs:label>
    <ex:hasAnnotation>Historywas first published in the small-press horror magazine cthulhu cultus #8 in 1997 . It is a very short cthulhu mythos pastiche by american james ambuehl .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#James_Ambuehl"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Cthulhu Cultus #8</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1997</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#hasSpouse">
