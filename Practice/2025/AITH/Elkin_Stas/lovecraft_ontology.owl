    <ex:wasReleasedOnW>September 2024</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bodhisattva">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Bodhisattva</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Botsu"/>
    <ex:hasAnnotation>Botsu are part of the buddhist cosmology, and were first used by chaosium in 2005 for the call of cthulhu role-playing game . They are entities who have refrained from reaching full enlightenment, so they can assist other mortals in becoming enlightened . Each of them has its own particular promise or concern on which it focuses its energies .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Secrets_of_Japan"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Call_of_Poohthulhu">
