    <ex:wasReleasedOnW>2005</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mril_Thorion">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OuterGods"/>
    <rdfs:label>Mril Thorion</rdfs:label>
    <ex:hasAffiliationC>Mlandoth</ex:hasAffiliationC>
    <ex:hasAnnotation>Mlandoth Outer God First appearance EXP : "Where Yidhra Walks" Created by CIRCLE : Clark Ashton Smith (reference) EXP : Walter C. DeBill, Jr. (expanded on) is an Outer God who, along with Mlandoth , serve as Yin and Yang. ( EXP : "Where Yidhra Walks") Behind the Mythos Mlandoth and were created by Walter C. DeBill Jr. , but were suggested years earlier by Clark Ashton Smith .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Where_Yidhra_Walks"/>
