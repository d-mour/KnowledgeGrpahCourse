    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Alfredo: A Tragedy</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft United States English Arkham House The Dark Brotherhood and Other Pieces date 1966 " " is a poem by the late cosmic horror Howard Phillips Lovecraft . History "" was first published nearly 30 years years after Lovecraft’s death in the collection The Dark Brotherhood and Other Pieces in 1966, a volume edited by his friend and contemporary August Derleth through his Arkham House label. It has since been reprinted several times.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Dark_Brotherhood"/>
    <ex:isPublishedAsW>Other Pieces</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1966</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Alone_Against_the_Flames">
