    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Il Segno Giallo</rdfs:label>
    <ex:hasAnnotation>"light a candle, curse the darknessecho of a distant scream" is a short story by david dunwoody . It is part of the anthology arkham detective agency created by c.j. Henderson . Behind the mythoswas written by david dunwoody at a request by brian m. sammons for a story based around pi frank nardi .</ex:hasAnnotation>
    <ex:hasAuthorW>David Dunwoody</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Arkham_Detective_Agency"/>
    <ex:wasPublishedOnW>November 2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Douglas_Wynne">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Douglas Wynne</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author United States Notable Works SPECTRA Files Years Active 2012- https://monstersandmiracles.wordpress.com/ is a United States-based author and musician who has written five novels, including the SPECTRA Files series, a trilogy of contemporary Cthulhu Mythos thrillers as well as a prequel book. A graduate of Boston 's Berklee College of Music, he lives in Massachusetts . Selected Bibliography SPECTRA Files Red Equinox (2015) Black January (2016) Cthulhu Blues (2017) Smoke and Dagger (2019) Collections Something in the Water and Other Stories (2022) Short Fiction "Rattled" (2015) External Link Summary Bibliography at the Internet Speculative Fiction Database</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://monstersandmiracles.wordpress.com/</ex:hasWebsiteR>
    <ex:hasYearsActiveR>2012-</ex:hasYearsActiveR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isKnownForR>SPECTRA Files</ex:isKnownForR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dothur">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Dothur</rdfs:label>
    <ex:hasAnnotation>Dreamlands Region or City Humans First appearance HPL : " The Doom That Came to Sarnath " Created by H. P. Lovecraft is a region or city briefly mentioned in " The Doom That Came to Sarnath " by H. P. Lovecraft . produced oil used as fuel for torchlight in the palaces of Sarnath .</ex:hasAnnotation>
    <ex:hasTypeL>Region or City</ex:hasTypeL>
    <ex:isInhabitedByL>Humans</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Dreamlands"/>
