    <ex:wasPublishedOnW>November 1995</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#His_Own_Most_Fantastic_Creation:_Howard_Phillips_Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>His Own Most Fantastic Creation: Howard Phillips Lovecraft</rdfs:label>
    <ex:hasAnnotation>Winfield Townley Scott United States English Genre(s) Non-fiction Arkham House Marginalia date 1944 " , Gent. ", which has also been published as "", is a short non-fiction work by the late American writer Winfield Townley Scott , which first appeared in the collection Marginalia in 1944. History Marginalia (1944) Lovecraft Remembered (1998)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Winfield_Townley_Scott"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Marginalia"/>
    <ex:wasPublishedOnW>1944</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Jervas_Hyde">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Jervas Hyde</rdfs:label>
    <ex:hasAnnotation>Relatives Geoffrey Hyde (ancestor) Jervas Dudley (descendant) Human First appearance HPL : " The Tomb " Created by H. P. Lovecraft was a member of the Hyde family of Boston , a line that was founded by Sir Geoffrey Hyde after emigrating from Sussex to Boston in 1640. One night while hosting a party marked by great extravagance and hedonism, a bolt of lightning struck the Hyde mansion during a thunderstorm and set it ablaze. The edifice was completely destroyed and Jervas, the only casualty, was burned to such an extent that nothing remained that was fit for burial in the family vault. Unable to rest in peace without proper burial, the spirit of was reincarnated a century later as Jervas Dudley , who had discovered the abandoned burial vault and became obsessed with unlocking its mysteries. This psychic fixation eventually resulted in his confinement to an asylum , but in the end he was promised that upon his death he would be laid to rest in the vault in the space that had been reserved for .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Tomb"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nightmare_in_Norway">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Nightmare in Norway</rdfs:label>
    <ex:hasAnnotation>Call of cthulhu scenario sourcebook was created by games workshop in the years before they limited their catalogue to their own products . It was written by games workshop with cover art by lee gibbons, interior art by tony ackland, and ran to a total of 36 pages .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Marcus_L._Rowland"/>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>36</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>1985</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nicole_Marsh">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Nicole Marsh</rdfs:label>
    <ex:hasAnnotation>Harrison Marsh Human First appearance " Ancient " Created by Armand Rosamilia is a minor recurrent character in the Keyport Cthulhu series of Mythos stories by Armand Rosamilia . Overview Nicole is the young wife of Harrison Marsh , a descendant of the Keyport branch of the Marsh family . When she and her husband travelled to Keyport to settle old Jeb Marsh 's estate, Nicole was kidnapped and used as a sacrifice to awaken the Great Old One Cthulhu . However, the being found her to be unworthy, and although she was not killed in the process, the encounter left her in a catatonic state. Appearances " Ancient " (2012) " Cabal " (2012) " Evil " (2013) Trivia Nicole is sometimes referred to as Nichole; however, she is most often referred to in the former manner.</ex:hasAnnotation>
    <ex:hasCharacterMateC rdf:resource="http://example.org/lovecraft#Harrison_Marsh"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Ancient"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Armand_Rosamilia"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Geoffrey_Hyde">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Geoffrey Hyde</rdfs:label>
    <ex:hasAnnotation>Relatives Jervas Dudley (descendant) Human First appearance HPL : " The Tomb " Created by H. P. Lovecraft Sir was an Englishman who emigrated from Sussex to Boston in 1640 and died there only a few years later. He and his descendants were buried in the hillside vault discovered by Jervas Dudley in the short story " The Tomb " by H. P. Lovecraft . In the story, Jervas learns that his maternal ancestry is linked to the Hyde family, making Jervas the last remaining member of that supposedly extinct line.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Tomb"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Yellow_King_%28Role-Playing_Game%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Yellow King (Role-Playing Game)</rdfs:label>
    <ex:hasAnnotation>The yellow king is a table top role-playing game published by pelgrane press . It is based entirely on the robert w. chambers anthology the king in yellow . It is heavily influenced by the cthulhu mythos interpretation of that work and the alien world version of carcosa .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Spawn_of_the_Maelstrom_%28being%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Spawn of the Maelstrom (being)</rdfs:label>
    <ex:hasAnnotation>The spawn of the maelstrom is a fictional monster created by august derleth and mark schorer for their short story " spawn of the maelstrom " . As a shapeshifter, it can assume the form of any animal, as well as mimic the appearance of an individual human . It emerged from a maelstrom near the uninhabited island of vömma, which is part of the norwegian lofoten islands . Only by consuming the life force of</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Spawn_of_the_Maelstrom"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Mark_Schorer"/>
  </rdf:Description>
