  <rdf:Description rdf:about="http://example.org/lovecraft#Tekeli-li%21_%28zine%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Tekeli-li! (zine)</rdfs:label>
    <ex:hasAnnotation>Tekeli-li! Was a short-lived horror zine which ran for four issues between march 1991 and january 1992 . Named for the cry emitted by the shoggoth in h.p. Lovecraft's at the mountains of madness</ex:hasAnnotation>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Broken_Sleep">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Broken Sleep</rdfs:label>
    <ex:hasAnnotation>The story explores the dreams of a young man locked in a juvenile prison . It becomes impossible for tre to know what is dream and what is reality . The story was reprinted in goodfellow's collection rapture of the deep and other lovecraftian tales .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Cody_Goodfellow"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Black_Wings_IV"/>
    <ex:wasPublishedOnW>February 2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Works">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Work"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Essays_Lovecraftian">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Essays Lovecraftian</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Richard Huber United States English Genre(s) Non-fiction T-K Graphics Release Date 1976 114 is a collection of non-fiction works compiled and edited by and critic Darrell Schweitzer . Overview Containing fifteen pieces (including one by H. P. Lovecraft himself), runs to a total of 114 . It was edited and compiled by Darrell Schweitzer, published in 1976 by T-K Graphics, and featured artwork supplied by Richard Huber. Contents "Story-Writing: A Letter from HPL", by H. P. Lovecraft "The First Lewis Theobald", by R. Boerem "The Four Faces of the Outsider", by Dirk W. Mosig "When the Stars Are Right", by Richard L. Tierney " A Literary Copernicus ", by Fritz Leiber "Notes on an Entity", by Robert Bloch "The (Bastard) Children of Hastur: An Irreverent Inquiry into the Ancestry and Progeny of the Hasturs", by Marion Zimmer Bradley "The Untravelled Roads 'Round Arkham", by Bill Wallace "Lovecraft and Lord Dunsany", by Darrell Schweitzer "Character Gullibility in Weird Fiction, or Isn't Yuggoth Somewhere in Upstate New York", by Darrell Schweitzer "Some Thoughts on Lovecraft", by Arthur Jean Cox " The Derleth Mythos ", by Richard L. Tierney "Genesis of the Cthulhu Mythos", by George T. Wetzel "Lovecraft's Ladies", by Ben P. Indick "H. P. Lovecraft and Pseudomathematics", by Robert Weinberg</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:hasPageCountW>114</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1976</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Quumyagga">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Quumyagga</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Groth-Golka"/>
    <ex:hasAnnotation>The first and oldest member of the shantak , it is the leader of all the shantaks who serve groth-golka . It is considered the prototype of the race and one of the lesser old ones .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Descent_into_the_Abyss"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Horror_in_the_Gallery"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Boris_Hurtta">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Boris Hurtta</rdfs:label>
    <ex:hasAnnotation>Finnish author who is one of main early contributors to finnish cthulhu mythos together with s. albert kivinen and others . Edited an anthology of lovecraftian &amp; cthulhu mythos stories written by finnish authors named kultainen naamio (the golden mask) published in 1993 . Wrote many mythos stories for the science-fiction magazine portti and others .</ex:hasAnnotation>
    <ex:hasNationalityR>Finnish</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Writer Editor</ex:isConnectedToMythosR>
    <ex:wasBornOnR>8th December 1945</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Brotherhood_of_the_Skin">
    <rdf:type rdf:resource="http://example.org/lovecraft#Cults"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdfs:label>Brotherhood of the Skin</rdfs:label>
    <ex:hasAlternativeNamesO>Brothers of the Skin</ex:hasAlternativeNamesO>
    <ex:hasAnnotation>The brothers of the skin are a secret society of fanatical malicious killers . They first appeared in the horror on the orient express supplement for the roleplaying game . The cult revolves around the skinless one in light of sedefkar's scrolls .</ex:hasAnnotation>
    <ex:hasNotableMemberO rdf:resource="http://example.org/lovecraft#Hound_of_Tindalos"/>
    <ex:hasNotableMemberO>Arturo Faccia</ex:hasNotableMemberO>
    <ex:hasNotableMemberO>Baba Yaga</ex:hasNotableMemberO>
    <ex:hasNotableMemberO>Count Drogo</ex:hasNotableMemberO>
    <ex:hasNotableMemberO>European branch cultists</ex:hasNotableMemberO>
    <ex:hasNotableMemberO>Mehmet Makryat</ex:hasNotableMemberO>
    <ex:hasNotableMemberO>Milanese branch cultists</ex:hasNotableMemberO>
    <ex:hasNotableMemberO>Skin Beasts</ex:hasNotableMemberO>
    <ex:hasNotableMemberO>The Duc des Esseintes</ex:hasNotableMemberO>
    <ex:hasPurposeO>Kill any who hinders their quest to Sedefkar Simulacrum.</ex:hasPurposeO>
    <ex:hasPurposeO>Obtain Sedefkar Simulacrum</ex:hasPurposeO>
    <ex:hasPurposeO>piece it together.</ex:hasPurposeO>
    <ex:hasTypeO>Cult</ex:hasTypeO>
    <ex:isLocatedAtO>Red Mosque in Istanbul</ex:isLocatedAtO>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Song_of_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Song of Cthulhu</rdfs:label>
    <ex:hasAnnotation>Various English Genre(s) Horror Fantasy Chaosium English Release date July 2001 Media Type Print : Tales of the Spheres Beyond Sound is an anthology of Cthulhu Mythos short stories. Overview First published by Chaosium in July 2001, was edited by Mythos contributor Stephen Mark Rainey . It is a collection of thematically-linked stories centred around the use of music in dealings with Mythos entities in the manner of the titular character from " The Music of Erich Zann " (which is included as the first story). Contents " The Music of Erich Zann " by H. P. Lovecraft "The Dark Beauty of Unheard Horrors" by Thomas Ligotti "In the Rue d'Auseil" by Fred Chappell " The Plain of Sound " by Ramsey Campbell "The Last Show at Verdi's Supper Club" by Stephen Mark Rainey "Water Music for the Tillers of Soil" by Tom Piccirilli "Shallow Fathoms" by M. Christian "How Nyarlathotep Rocked Our World" by Gregory Nicoll "Listen" by James Robert Smith "Mud" by Brian McNaughton "Paedomorphosis" by Caitlin R. Kiernan "Intruders" by Hugh B. Cave "Chant" by Robert Weinberg "Ghoul's Tale" by Robert M. Price "The Next Big Thing" by Rob Suggs "The Flautists" by Edward P. Berglund "Fall From Grace" by D. F. Lewis "Drums" by William R. Trotter "The Enchanting of Lila Woods" by E. A. Lustig "Yog-Sothoth, Superstar" by Thomas F. Monteleone</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasGenreW>Horror Fantasy</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecrafts_dunkle_Idole">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecrafts dunkle Idole</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Babbarammdass Germany German H. P. Lovecraft's Bibliothek des Schreckens Blitz Release Date March 1999 171 , which translates to English as Lovecraft's Dark Idols , is a German- collection of works which inspired the late American H. P. Lovecraft . Edited by Frank Festa and published by Blitz in March 1999, it was the first in the long running H. P. Lovecraft's Bibliothek des Schreckens of Lovecraftian German translations. Contents Introduction by Frank Festa "Das Haus im Sturm" by M. P. Shiel ("The House of Sounds") "Der Abdruck der Hand" by Maurice Level "Das Totenlächeln" by F. Marion Crawford ("The Dead Smile") "Fischkopf" by Irvin S. Cobb ("Fishhead") "Die Schatten an der Wand" by Mary E. Wilkins Freeman ("The Shadows on the Wall") "Die Marter der Hoffnung" by Villiers de l'Isle-Adam ("La torture par l'espérance") "Halpin Fraysers Tod" by Ambrose Bierce ("The Death of Halpin Frayser") "Als ich eine Blume war" by Lafcadio Hearn ("When I Was a Flower") "El Vomito" by Lafcadio Hearn ("El Vómito") "Die Pest" by Lafcadio Hearn ("MDCCCLIII") "Tote Liebe" by Lafcadio Hearn ("A Dead Love") "Eine blass erinnerte Geschichte" by R. H. Barlow ("A Dim-Remembered Story") "Das Tote Tal" by Ralph Adams Cram ("The Dead Valley")</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>Germany</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>171</ex:hasPageCountW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#H._P._Lovecrafts_Bibliothek_des_Schreckens"/>
    <ex:wasReleasedOnW>March 1999</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mount_Kadiphonek">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Mount Kadiphonek</rdfs:label>
    <ex:hasAnnotation>Dreamlands ( Lomar ) Mountain First appearance HPL : " Polaris " Created by H. P. Lovecraft is a mountain in the far northern kingdom of Lomar in the Dreamlands . Between this mountain and Mount Noton is the Plateau of Sarkis , the site of the city of Olathoë . ( HPL : " Polaris ")</ex:hasAnnotation>
    <ex:hasTypeL>Mountain</ex:hasTypeL>
    <ex:isLocatedAtL>Dreamlands ( Lomar )</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#Polaris"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cassilda">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Cassilda</rdfs:label>
    <ex:hasAnnotation>The queen of carcosa is a character created by the late american author robert w. chambers for his 1895 short story " the repairer of reputations" her concept was later taken by paizo, inc. and incorporated into their pathfinder roleplaying game, a universe which takes many inspirations from cthulhu mythos .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Repairer_of_Reputations"/>
    <ex:wasCreatedByC>Jim Groves</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nctosa_and_Nctolhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Nctosa and Nctolhu</rdfs:label>
    <ex:hasAlternativeNamesC>The Twin Spawn of Cthulhu</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Twin Spawn of Cthulhu Current location The Great Red Spot of Jupiter Relatives Cthulhu (Father) Kassogtha (Mother) First appearance EXP : " Nightmare's Disciple " Created by Joseph S. Pulver, Sr. are the twin daughters of Cthulhu , hence they are called the Twin spawn of Cthulhu . They are currently imprisoned in the Great Red Spot of the planet Jupiter . They both appear as colossal shelled beings, with eight segmented limbs, and six long arms ending with claws, vaguely resembling their half-sister, Cthylla . Gallery</ex:hasAnnotation>
    <ex:isLocatedAtC>The Great Red Spot of Jupiter</ex:isLocatedAtC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Nightmares_Disciple"/>
    <ex:wasCreatedByC>Joseph S. Pulver. Sr.</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Henry_C._Imbert">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Henry C. Imbert</rdfs:label>
    <ex:hasAnnotation>Dr. , f.r.s., f. a. g. s., is a renowned american ethnologist . Two years prior to the events of the novel, imbert helped the police identify the toxin in a poisoned arrow used to kill an old woman . The supposed "statue" of chaugnar faugn revealed itself as the actual living god and killed a watchman in the manhattan museum of fine arts .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Horror_from_the_Hills"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Frank_Belknap_Long"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yundu">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Planets"/>
    <rdfs:label>Yundu</rdfs:label>
    <ex:hasAnnotation>The Dreamlands Planetary body Wenelians Phosphorescent Monsters (unconfirmed) First appearance EXP : H. P. Lovecraft's Dreamlands Created by Phil Frances is an extra-dimensional world developed for Chaosium 's Call of Cthulhu roleplaying game. Description Located somewhere in the depths of space in the plane of existence dubbed the Dreamlands , is the home planet of the bizarre flying creatures known as Wenelian s and, possibly, their flying steeds the Phosphorescent Monster s. Behind the Mythos was created by Phil Frances for the Call of Cthulhu roleplaying game supplement H. P. Lovecraft's Dreamlands , whose first edition was released in 1986.</ex:hasAnnotation>
    <ex:hasTypeL>Planetary body</ex:hasTypeL>
    <ex:isInhabitedByL>Phosphorescent Monsters</ex:isInhabitedByL>
    <ex:isInhabitedByL>Wenelians</ex:isInhabitedByL>
    <ex:isLocatedAtL>The Dreamlands</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#H._P._Lovecrafts_Dreamlands"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Greg_Stolze">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Greg Stolze</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Games designer Birth Date 1970 United States United States http://gregstolze.com/  (1970 - present) is an American author and games designer who has worked on such Mythos -related projects as Arc Dream Publishing 's Delta Green roleplaying game spin-off. Although his fiction focuses primarily on roleplaying game tie-ins, he has also written a number of stand-alone pieces inspired by the works of H. P. Lovecraft . Selected Bibliography " Iden-Inshi " (2013) " I Saw the Light " (2015) External Links author profile at The Internet Speculative Fiction Database at Wikipedia</ex:hasAnnotation>
    <ex:hasBirthplaceR>United States</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>http://gregstolze.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Games designer</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1970</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Hastur">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Hastur</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The King in Yellow Lord Hastur The Unspeakable One H'aaztre Him Who Is Not to be Named Kaiwan Assatur The Feaster from Afar The Lord of Interstellar Spaces The Peacock King Zukala-Koth Johannes Van Der Berg Hastur the Unspeakable The Unspeakable Fenric Dweller in the Depths Thing in the Lake Him that Slept Beneath Great Prince of the Old Ones Hasuta ( Haiyore! Nyaruko-san ) Old Entity Hastorr ( Yu-Gi-Oh! )</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The unspeakable is a fictional deity in the cthulhu mythos . Was created by ambrose bierce in his short story " hata the shepherd " . Only mentioned in one of lovecraft's stories, the whisperer in darkness .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Isle_of_Dark_Magic"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_King_in_Yellow"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Return_of_Hastur"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Whisperer_in_Darkness"/>
    <ex:hasAppearanceC>The Hastur Cycle Haiyore! Nyaruko-san The Bride of the Yellow King</ex:hasAppearanceC>
    <ex:hasCharacterMateC rdf:resource="http://example.org/lovecraft#Shub-Niggurath"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Ha%C3%AFta_the_Shepherd"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Ambrose_Bierce"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Seed_of_the_Star-God">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Seed of the Star-God</rdfs:label>
    <ex:hasAnnotation>"the seed of the star–god" is a short story by richard l. tierney . It first appeared as the cover story for the lammas 1984 issue of crypt of cthulhu (#24) simon learns that his beloved helen is dead and that her father is preparing to sacrifice her sister to manifest the sinister fertility goddess shub-niggurath .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Richard_L._Tierney"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu"/>
    <ex:wasPublishedOnW>August 1984</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#H._P._Lovecraft:_A_Life">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>H. P. Lovecraft: A Life</rdfs:label>
    <ex:hasAnnotation>S. T. Joshi United States English Genre(s) Biography Necronomicon Press Hippocampus Press Release Date 1996 is a non-fiction work by Lovecraft scholar and critic S. T. Joshi . Overview A comprehensive biographical account of the life of the late American H. P. Lovecraft , Joshi has stated that it is his most significant achievement in a long career of study. Publication History First released in 1996 by Necronomicon Press who reissued in in a slightly modified format in 2004, it received a significant expansion through Hippocampus Press in 2010 as I Am Providence: The Life and Times of H. P. Lovecraft , which necessitated splitting the contents into two volumes.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#S._T._Joshi"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Biography</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1996</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Made_in_Goatswood_%28story%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RamseyCampbellWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Made in Goatswood (story)</rdfs:label>
    <ex:hasAnnotation>Made in Goatswood Ramsey Campbell English Genre(s) Weird fiction Arkham House Demons by Daylight date 1973 "Made in Goatswood" is a short story by Ramsey Campbell that appeared in his 1975 collection Demons by Daylight . It is set in part in Goatswood , the Severn Valley town that was first encountered in Campbell's " The Moon-Lens ". Synopsis The plot involves Terry Aldrich, a young man from Brichester who travels to neighbouring Goatswood to buy a set of garden gnomes for his girlfriend Kim, thinking they will "bring her garden closer to nature". The Goatswood gnomes turn out to be animate--and malevolent.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Demons_by_Daylight"/>
    <ex:wasPublishedOnW>1973</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Pickman_Inspired_Dream">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Pickman Inspired Dream</rdfs:label>
    <ex:hasAnnotation>Full story online here Ron Shiflet United States English Publication date July 1997 " " is a Cthulhu Mythos poem by American Ron Shiflet . Synopsis The piece recounts the events of a gruesome dream and the work of art which caused it: a painting by Richard Upton Pickman . Publication History "" was first published in Imelod #7 in July 1997, and in the online fanzine Nightscapes the following month.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>July 1997</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Far_Below">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Far Below</rdfs:label>
    <ex:hasAnnotation>A man relates the history of a covert war waged in the new york subway tunnels between an elite division of law enforcement and the flesh-eating ghouls . The conclusion of the story reveals that the man, and all those who work in the division, is slowly devolving into one of the creatures due to a supernatural aura . The story was loosely adapted as an episode of the anthology tv series monsters, which aired in 1990 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_Barbour_Johnson"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>June-July 1939</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Achtung%21_Cthulhu:_Terrors_of_the_Secret_War">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Achtung! Cthulhu: Terrors of the Secret War</rdfs:label>
    <ex:hasAnnotation>Achtung! Cthulhu is an award-winning bestiary supplement for both the savage worlds and call of cthulhu roleplaying games . Written by dave blewer, lynne hardy, jesse hawkins, joshua o'connor, and . Reuben saunders . Both print and digital editions were released by modiphius entertainment</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lynne_Hardy"/>
    <ex:hasAuthorW>Dave Blewer</ex:hasAuthorW>
    <ex:hasAuthorW>Jesse Hawkins</ex:hasAuthorW>
    <ex:hasAuthorW>Joshua O'Connor</ex:hasAuthorW>
    <ex:hasAuthorW>Reuben Saunders</ex:hasAuthorW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Achtung! Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2014</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mazmezz">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Mazmezz</rdfs:label>
    <ex:hasAnnotation>is a Lovecraftian -like demonic entity from the fictional universe of the Pathfinder pencil-and-paper roleplaying game by Paizo Inc. Background (aka, the Lord of Vermin, the Creeping Queen) is a Qlippoth Lord whom became a demon. One of the ancient qlippoth which roamed the Abyss prior to the creation of the physical universes. It's form is that of a writhing hairy mass with a horrid tangle of pincers, claws, spinnerets, and insectoid legs.</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sedmelluq">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Sedmelluq</rdfs:label>
    <ex:hasAlternativeNamesC>Ishmagon</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Great Manipulator</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Great Manipulator Ishmagon First appearance Imagon Created by Michael Marrak is a colossal glowing worm with a star-shaped mouth dwelling somewhere in Antarctica . It is worshipped by the extraterrestrial Mi-Go .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Imagon"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Michael_Marrak"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Khephren">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdfs:label>Khephren</rdfs:label>
    <ex:ceasedOnC>Circa 2532 BC</ex:ceasedOnC>
    <ex:hasAnnotation>Pharaoh of ancient egypt in the 4th dynasty was incorporated into the cthulhu mythos . He is not to be confused with khephnes, a fictional egyptian possessed by a yithian . He is credited with building the second pyramid and the great sphinx .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Shadow_Out_of_Time"/>
    <ex:hasCharacterMateC>Nitocris</ex:hasCharacterMateC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Imprisoned_with_the_Pharaohs"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cheshire_Cat">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Cheshire Cat</rdfs:label>
    <ex:hasAnnotation>The was created by lewis carroll in 1865, first appearing in alice's adventures in wonderland . In 2008, it first appeared in zenescope entertainment's grimm fairy tales fictional universe, in the issue #0 of the 1st volume of grimm fairy tales: return to wonderland .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Demonbane"/>
    <ex:madeFirstAppearanceOnC>ADJ Alice's Adventures in Wonderland</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>Grimm Fairy Tales: Return to Wonderland Vol 1 2</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Lewis Carroll</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Beside_Myself">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Beside Myself</rdfs:label>
    <ex:hasAnnotation>A down-on-his-luck security guard accidentally summons a doppelgänger one night while drunk . As things get worse, the man realises the creature intends to kill him . He manages to uncover the spell he needs in the unausperechlichen kulten .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Looking_for_Darla:_Stories_of_Mythos_Noir"/>
    <ex:wasPublishedOnW>September 2008</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ripples_in_the_Ether">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Ripples in the Ether</rdfs:label>
    <ex:hasAnnotation>Professor challenger is a short story by british-born william meikle . It stars the character of professor challenger created by arthur conan doyle . Despite containing no direct references to either the works of h. p. lovecraft or the greater cthulhu mythos,'s inclusion in the collection home from the sea: tales of lovecraftian terror indicates the 's belief that the story is in the same spirit as these works'</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Professor Challenger</ex:isPartOfSeriesW>
    <ex:isPublishedAsW>The Alchemy Press Book of Pulp Heroes</ex:isPublishedAsW>
    <ex:wasPublishedOnW>August 2012</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Disinterment">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Disinterment</rdfs:label>
    <ex:hasAnnotation>The story tells of a leprosy sufferer, who, instead of living with the debilitating condition, opts for death and resurrection at the hands of a witch doctor . It was first published in the january 1937 edition of pulp magazine weird tales .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Duane_W._Rimel"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Howard_Phillips_Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Arkham_Police_Department">
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisations"/>
    <rdfs:label>Arkham Police Department</rdfs:label>
    <ex:hasAnnotation>Arkham detective agency is the law enforcement division for the city of arkham . Featured in many cthulhu mythos stories over the years . Fantasy flight games have featured the department several times .</ex:hasAnnotation>
    <ex:hasPurposeO>Regional law enforcement</ex:hasPurposeO>
    <ex:hasTypeO>Government service department</ex:hasTypeO>
    <ex:isLocatedAtO rdf:resource="http://example.org/lovecraft#Arkham"/>
    <ex:isLocatedAtO rdf:resource="http://example.org/lovecraft#Massachusetts"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Book_of_Chaos,_The_Oversized_Deluxe">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Book of Chaos, The Oversized Deluxe</rdfs:label>
    <ex:hasAnnotation>200 is a collection of short graphic novels written by mathieu lauffray and xavier dorison, with lauffray also suppling the artwork . Originally released individually in may 2017 by humanoids in partnership with comixology, this volume collects all four books from the in a hardcover</ex:hasAnnotation>
    <ex:hasAuthorW>Matheiu Lauffray</ex:hasAuthorW>
    <ex:hasAuthorW>Xavier Dorison</ex:hasAuthorW>
    <ex:hasPageCountW>200</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Book_of_Chaos"/>
    <ex:wasReleasedOnW>March 2017</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecrafts_The_Beast_in_the_Cave">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraft's The Beast in the Cave</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft J. Scott Vanlester United States English Lovecraft Comics Release Date July 2023 57 is a comic book-format adaptation of the H. P. Lovecraft short story from which it takes its name by American artist and J. Scott Vanlester . Part of his Lovecraft Comics , it was independently published in July 2023; both paperback and digital editions were released. The artwork is rendered in black and white with a preference for line drawings, and done in a highly minimalist style. Overview</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>57</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Lovecraft Comics</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>July 2023</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Paul_Fricker">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Paul Fricker</rdfs:label>
    <ex:hasAnnotation>Call of cthulhu 7th edition co-written and designed by paul fricker . He is also the co-host of two lovecraftian podcasts, the good friends of jackson elias and mason and fricker's eldritch stories . Fricker's first exposure to lovecraft was reading pickman's model as a young teen .</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#England U.K.</ex:hasBirthplaceR>
    <ex:hasNationalityR>United Kingdom</ex:hasNationalityR>
    <ex:hasWebsiteR>https://paulfricker.substack.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Games designer</ex:isConnectedToMythosR>
    <ex:isKnownForR>Call of Cthulhu 7th edition</ex:isKnownForR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Alos">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Alos</rdfs:label>
    <ex:hasAnnotation>Dreamlands ( Olathoë ) Army commander Human First appearance HPL : " Polaris " Created by H. P. Lovecraft is a fictional character created by the late American author H. P. Lovecraft for his 1920 short story " Polaris ". Overview is the commander of the army of the city of Olathoë in the Dreamlands . He was considered the last hope for the kingdom of Lomar against the invading hordes of the Inutos . was described by the unnamed narrator of " Polaris " as not only a friend but "a true man and patriot".</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Polaris"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#James_Allison">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>James Allison</rdfs:label>
    <ex:ceasedOnC>Exact date unknown likely mid-late 1930s</ex:ceasedOnC>
    <ex:hasAlternativeNamesC>Bane</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Bragi</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Bran</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Hialmar</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Horsa</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Hunwulf</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Niord</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Tyr</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as Bane Bragi Bran Hialmar Horsa Hunwulf Niord Tyr Exact date unknown, likely mid-late 1930s Human Created by Robert E. Howard is a fictional character created by Robert E. Howard as the protagonist for a story cycle titled after him. Overview A Texan man living contemporarily to Robert E. Howard, has an extensive recollection of his past lives, some of which he narrates over the course of seven stories. In " Black Eons ", a fragment completed by Robert M. Price , Allison discovers the reason for his anomalous memories and breaks the curse of reincarnation which was placed upon him by evil sorcerer Koth-Serapis during the Hyperborean age . Appearances There follows a list of Allison's appearances by the year in which they were published. " The Valley of the Worm " (1934) " The Garden of Fear " (1934) "Marchers of Valhalla" (1972) "The Tower of Time" (1975) "Brachan the Kelt" (1981) " Black Eons " (1985) "The Guardian of the Idol" (2003) Trivia As may be suggested by the image on this page, Allison's story was adapted by Marvel Comics for their Supernatural Thrillers #3 in January 1973.</ex:hasAnnotation>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yidhra">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OuterGods"/>
    <rdfs:label>Yidhra</rdfs:label>
    <ex:hasAlternativeNamesC>Madam Yee</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Dream-Witch</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Life-Giver</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Lover</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Mother</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Shrouder</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Yee-Tho-Rah</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Yolanda Prentiss</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Yolanda prentiss is a semi-human reptilian creature which casts a glamour to appear as a beautiful, cultured young woman . She has the power to fuse humans and animals into new forms, which she employs as her servitors . At least one iteration of yolanda was destroyed by a human named wilhelm kramer at the same time he murdered his family, who were malformed descendants of .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Where_Yidhra_Walks"/>
    <ex:hasAppearanceC>Predator</ex:hasAppearanceC>
    <ex:hasAppearanceC>What Lurks Among The Dunes</ex:hasAppearanceC>
    <ex:hasCharacterMateC rdf:resource="http://example.org/lovecraft#Yig"/>
    <ex:madeFirstAppearanceOnC>Predator</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Walter C. DeBill Jr.</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kadath">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Kadath</rdfs:label>
    <ex:hasAccessibilityL>In dreams</ex:hasAccessibilityL>
    <ex:hasAccessibilityL>but perhaps mundane travel</ex:hasAccessibilityL>
    <ex:hasAccessibilityL>transcendental states</ex:hasAccessibilityL>
    <ex:hasAnnotation>" in the cold waste " is a mountain crowned by an onyx castle, and the home of the dream-gods of earth . It is mentioned in several of lovecraft's stories, including both the dream cycle series and more "science fictional" pieces . It is most often referred to as " in the cold waste ", a unknown to humans and other mortal races .</ex:hasAnnotation>
    <ex:hasAppearanceL rdf:resource="http://example.org/lovecraft#The_Dream-Quest_of_Unknown_Kadath"/>
    <ex:hasAppearanceL>The Dunwich Horror The Mound Medusa's Coil At the Mountains of Madness</ex:hasAppearanceL>
    <ex:isInhabitedByL>The Great Ones</ex:isInhabitedByL>
    <ex:isLocatedAtL>Ambiguous</ex:isLocatedAtL>
    <ex:isLocatedAtL>perhaps Antarctica or The Dreamlands</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Other_Gods"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crypt_of_Cthulhu_Hallowmas_1983">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crypt of Cthulhu Hallowmas 1983</rdfs:label>
    <ex:hasAnnotation>Crypt of cthulhu is the seventeenth issue of robert m. price's long-running fanzine . Edited by leading h. p. lovecraft scholar price, who also provided the cover art . Ran to a total of 56 in an a5 format and was self published in november 1983 .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>56</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu"/>
    <ex:wasReleasedOnW>November 1983</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dark_Things">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dark Things</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Herb Arnold Gary Gore United States English Japanese Genre(s) Horror Arkham House Release Date 1971 Media Type Hardback Print 330 is an anthology of short horror fiction edited by August Derleth , published by Arkham House in 1971 and running to a total of 330 . It has not been re-released since its initial run, but a Japanese translation has been issued. All of the stories contained within were new to this collection. Contents "The Funny Farm", by Robert Bloch "The Eyes of Mme. Dupree", by P. H. Booth "'The Peril That Lurks Among Ruins'", by Joseph Payne Brennan "Napier Court", by Ramsey Campbell " Shaggai ", by Lin Carter " The Dweller in the Tomb ", by Lin Carter "The House by the Tarn", by Basil Copper "The Knocker at the Portico", by Basil Copper "Lord of the Depths", by David Drake "Omega", by Alice R. Hill "The House in the Oaks", by Robert E. Howard and August Derleth "The Singleton Barrier", by Carl Jacobi "The Case of the Double Husband", by Margery Lawrence " Innsmouth Clay ", by H. P. Lovecraft and August Derleth "The Conch Shell", by Brian Lumley " Rising With Surtsey ", by Brian Lumley "Company in the Orchard", by Francis May "'Beyondaril'", by John Metcalfe "The Manterfield Inheritance", by Charles Partington "The Storm King", by Emil Petaja "The Elevator", by James Wade "Appointment with Fire", by H. Russell Wakefield "The Rings of the Papaloi", by Donald J. Walsh, Jr. "Requiem for Earth", by Donald Wandrei</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>330</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>Japanese</ex:isInLanguageW>
    <ex:wasReleasedOnW>1971</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Jupiter_%28god%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Jupiter (god)</rdfs:label>
    <ex:hasAffiliationC>Greco-Roman pantheon</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Jove</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Zeus</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Jupiter Also known as Jove Zeus Greek and Roman Mythology Powers and Abilities Lighting, thunder, storm Relatives Saturn (father) Offspring The majority of the Greco-Roman pantheon Juno Leader of the Greco-Roman pantheon Greco-Roman pantheon First appearance " Poetry and the Gods " Created by H. P. Lovecraft (based on beliefs from the Ancient Classical Period) Jupiter , also known as Jove and Zeus , was an important Greco-Roman god, who appeared in several of the works of H. P. Lovecraft , such as the story " Poetry and the Gods ".</ex:hasAnnotation>
    <ex:hasCharacterMateC>Juno</ex:hasCharacterMateC>
    <ex:madeFirstAppearanceOnC>Poetry</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>the Gods</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
