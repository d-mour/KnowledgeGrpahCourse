    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cult of the Spider Queen</rdfs:label>
    <ex:hasAnnotation>Aconyte books release date december 7, 2021 is a standalone novel . It was adapted into an audio production with an entire cast of voice actors . It is the fifth volume of the arkham horror fiction series .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Arkham_Horror_Fiction"/>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
