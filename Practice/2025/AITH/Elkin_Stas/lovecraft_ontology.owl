    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Ave Atque Vale</rdfs:label>
    <ex:hasAnnotation>Edward H. Cole United States English Genre(s) Non-fiction SSR Publications Howard Phillips Lovecraft: Memoirs, Critiques &amp; Bibliographies date 1955 " " is a short non-fiction piece by Edward H. Cole, written for the pioneering American Howard Phillips Lovecraft . History Howard Phillips Lovecraft: Memoirs, Critiques &amp; Bibliographies (1955) Commentaries (1995) Lovecraft Remembered (1998)</ex:hasAnnotation>
    <ex:hasAuthorW>Edward H. Cole</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
