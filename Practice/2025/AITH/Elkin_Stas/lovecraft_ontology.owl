  <rdf:Description rdf:about="http://example.org/lovecraft#The_Shadow_of_Azathoth_Is_Your_Galaxy">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Shadow of Azathoth Is Your Galaxy</rdfs:label>
    <ex:hasAnnotation>D. B. Spitzer United States English Wildside Press Weirdbook Annual 2 date February 2019 " " is a poem by American podcaster D. B. Spitzer . Synopsis Reading like a religious text, "" is a combination of history, prophecy and prayer to Azathoth . History "" was published in February 2019 in the Wildside Press anthology Weirdbook Annual 2 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#D._B._Spitzer"/>
