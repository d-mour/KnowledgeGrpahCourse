    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Ravenous Dusk</rdfs:label>
    <ex:hasAnnotation>Preceded by radiant dawn is a 2003 novel by cody goodfellow . It is a sequel to radiant dawn (2000) . Goodfellow has described the books as "a two-part modern epic"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Cody_Goodfellow"/>
