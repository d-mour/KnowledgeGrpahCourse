    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Character"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Prime_Reality_%28Marvel%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Dimensions"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsOriginatingFromMythosInspiredWorks"/>
    <rdfs:label>Prime Reality (Marvel)</rdfs:label>
    <ex:hasAnnotation>Prime reality (aka, earth-616) is a fictional universe created by marvel comics . It is the setting for most of the comic series published by marvel comics . It has been the stage of two cosmic horror stories, the infinity gauntlet event in 1991 and the chaos war event in 2010 .</ex:hasAnnotation>
    <ex:hasNotableFeatureL>Billions of galaxies</ex:hasNotableFeatureL>
    <ex:hasTypeL rdf:resource="http://example.org/lovecraft#Dimension"/>
    <ex:isInhabitedByL>infinite lifeforms</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Marvel_Multiverse"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nightscapes_April_1998">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Nightscapes April 1998</rdfs:label>
    <ex:hasAnnotation>Various English Edward P. Berglund Release Date April 1998 Preceded by January 1998 Followed by July 1998 is the seventh issue of the long-running online fanzine Nightscapes . It was edited by the late American and Lovecraft scholar Edward P. Berglund . Contents As well as the written material listed below, this edition featured artwork from Adrian Kleinbergen, Stanley C. Sargent , Rebecca Kemp and D. L. Hutchinson, although one of Kemp's images has since been removed at the artist's request. Fiction "Black Sun" by G. W. Thomas "The Blood Dimmed Tide" by Kevin Eric Sheridan " The Return of Rhan-Tegoth " by Laurence J. Cornford "Cold Waste" by Ken Silver "Nefast" by James Kracht " Genuine Article " by J. B. Lee " The Dark Man's Assassin " by Ron Shiflet Pseudo-Factual Materials " The Black Litany of Nug and Yeb " by Joseph S. Pulver, Sr. " The Exorcism of Iagsat " by Joseph S. Pulver, Sr. " The Black Rite of Yaddith " by Joseph S. Pulver, Sr. Non-Fiction "Artists of the Cthulhu Mythos: Stanley C. Sargent" by G. W. Thomas Games "The Wheel of Fortune" by Daniel R. Lackey and Scott Josephus ( Call of Cthulhu scenario) Poetry " Folks of Innsmouth: Book Store Owner " by Franklyn Searight " Yuggoth on the Rim " by Alan Peschke " Ei'lor " by James Gruetzmacher " At Night I Dream ... " by Ron Shiflet " The Dunwich Horror " by Nash Carver " Cthulhu's Dark Spawn " by Ron Shiflet "The Olden Flame" by Justin Scott Van Kleeck Reviews By Edward P. Berglund External Links full issue online at the Nightscapes website</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>April 1998</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Drinen">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Drinen</rdfs:label>
    <ex:hasAnnotation>City First appearance HPL : " The Quest of Iranon " Created by H. P. Lovecraft is a city to the East of Oonai somewhere near the ancient lands of Lomar and Mnar ( HPL : " The Quest of Iranon "). This location as with the others mentioned in Iranon 's story may be in the ancient prehistory of Earth , or in the Dreamlands -- or in both (at different times).</ex:hasAnnotation>
    <ex:hasTypeL>City</ex:hasTypeL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Quest_of_Iranon"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Book_of_Yig">
    <rdf:type rdf:resource="http://example.org/lovecraft#CrossroadPress"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Book of Yig</rdfs:label>
    <ex:hasAnnotation>Revelations of the Serpent: A Cthulhu Mythos Anthology Various English Crossroad Press Release Date April 2021 250 : Revelations of the Serpent: A Cthulhu Mythos Anthology is a thematic anthology of Lovecraftian fiction edited by David Hambling and Peter Rawlik . Running to a total of 250 , it was published by Crossroad Press in April 2021; both paperback and digital editions were released. It is part of the Books of Cthulhu series. The book is dedicated to British Brian Stableford . Overview Contents "The Snake in the Garden" by David Hambling "Andrew Doran and the Journey to the Serpent Temple" by Matthew Davenport "Still Life With Death" by Mark Howard Jones "Revelations" by Peter Rawlik "Coda: The Return" by David Hambling</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>250</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>April 2021</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Poppy_Z._Brite">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Poppy Z. Brite</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Birth Date 25 May 1967 Bowling Green, Kentucky, USA United States http://www.poppyzbrite.com/ William Joseph "Billy" Martin (born May 25, 1967 as Melissa Ann Brite), formerly known as , is an American writer who has written extensively in the gothic horror genre. His work has been included in collections of Lovecraftian fiction, including Cthulhu 2000 , Shadows Over Baker Street , and The Children of Cthulhu . Selected Bibliography Short Fiction "His Mouth Will Taste of Wormwood" (1990) External Links at Wikipedia at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Bowling Green Kentucky</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>http://www.poppyzbrite.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>25 May 1967</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Splugorth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Splugorth</rdfs:label>
    <ex:hasAnnotation>The are a malevolent sadistic race of alien intelligences whose manipulative reach spreads across holdings in numerous dimensions . They are known for employing interdimensional trading ports, one of the largest being on the island continent of atlantis on a post-apocalyptic future earth . Though not a united race, they will present a united front against those who threaten the race or its general interests .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Rifts"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Five_Minutes_or_Less">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Five Minutes or Less</rdfs:label>
    <ex:hasAnnotation>A man, unhappy with his life, his wife and his children, one day answers the door to a mysterious stranger . The stranger offers him the chance of a place in the coming new order, a society ruled by beings such as shub-niggurath and azathoth .</ex:hasAnnotation>
    <ex:hasAuthorW>Michael Hudson</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Shall Be</ex:isPublishedAsW>
    <ex:isPublishedAsW>Whispers from the Abyss Vol. 2: The Horrors That Are</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Caitlin_R._Kiernan">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Caitlin R. Kiernan</rdfs:label>
    <ex:hasAnnotation>Caitln rebekah kiernan is an irish-born american author of weird fiction . They have published over 10 novels in the science fiction and dark fantasy genres . They are a two-time recipient of both the world fantasy and bram stoker awards .</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#Ireland Dublin</ex:hasBirthplaceR>
    <ex:hasFullNameR>Caitlín Rebekah Kiernan</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasPseudonymR>Ivy Devlin</ex:hasPseudonymR>
    <ex:hasPseudonymR>Kathleen Tierney</ex:hasPseudonymR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>26 May 1964</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Pickman_Revival">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Pickman Revival</rdfs:label>
    <ex:hasAnnotation>Cthulhu mythos short story was published in thematic anthology pickman's gallery by ulthar press in 2018 . It features several nods to the cthulhu mythos in addition to the paintings on display .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Steven_M._Vance"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Pickmans_Gallery"/>
    <ex:wasPublishedOnW>2018</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dylath-Leen_%28short_story%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#BrianLumleyWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dylath-Leen (short story)</rdfs:label>
    <ex:hasAnnotation>"dylath-leen" is a dreamlands short story by brian lumley . It was later incorporated as part of lumley's novel the clock of dreams . The story is set in the dreamlands city of dylath-leen . Enderby has visited the city three times in his life .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Wilbur_Akeley">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Wilbur Akeley</rdfs:label>
    <ex:ceasedOnC>1924</ex:ceasedOnC>
    <ex:hasAnnotation>Akeley is a fictional character created by august derleth for his short story " the gable window ", one of his " posthumous collaborations " with h. p. lovecraft . He is depicted as a scholar of occult lore who installs a dimensional portal in his house in lovecraft country . Derleth describes him as "a student of archeology and anthropology" after graduating from miskatonic university, he spends three years in</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Gable_Window"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#August_Derleth"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_13_Gates_of_the_Necronomicon">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The 13 Gates of the Necronomicon</rdfs:label>
    <ex:hasAnnotation>Donald Tyson English Llewellyn Publications Release Date July 2010 : A Workbook of Magic is a book by Canadian and esotericist Donald Tyson which purports to be a "how-to" guide to performing practical ritual magic using elements derived from the works of H. P. Lovecraft . First published in July 2010 by Llewellyn Publications, both paperback and digital editions were released . Overview References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Donald_Tyson"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>July 2010</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Henrik_Sandbeck_Harksen">
    <rdf:type rdf:resource="http://example.org/lovecraft#Critics"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Henrik Sandbeck Harksen</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Editor Author Critic Horror https://hharksenproductions.wordpress.com/ is a Danish author, editor, independent publisher, and occasional critic who works in the horror , and specialises in Lovecraftian and Cthulhu Mythos fiction. His publishing label, H. Harksen Productions, has released at least two collections of Lovecraftian horror, and he has written a handful of fiction and non-fiction pieces on the . Harksen is also a member of the H. P. Lovecraft and Esoteric Order of Dagon Amateur Press Associations . Selected Bibliography Editor Eldritch Horrors: Dark Tales (2009) Urban Cthulhu: Nightmare Cities (2012) Fiction "Just an Accountant" (2011) Non-Fiction "Metaphysics in "The Music of Erich Zann"" (2005) "A Spectre Is Haunting Chicago: The Lovecraft-Leiberian Connection" (2008) External Links at the Internet Speculative Fiction Database at Goodreads References</ex:hasAnnotation>
    <ex:hasWebsiteR>https://hharksenproductions.wordpress.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Critic</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Night_Before_Christmas">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Storybooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Night Before Christmas</rdfs:label>
    <ex:hasAnnotation>A C Is for Cthulhu Holiday Tale Jason Ciaramella Joshua Janes Cover Artist Joshua Janes United States English C is for Cthulhu Genre(s) Children's ComixTribe Release Date October 18, 2022 26 : A C Is for Cthulhu Holiday Tale is a children's book based on H. P. Lovecraft 's Cthulhu Mythos . Overview Telling the story of a Christmas where Howard Lovecraft is visited by Cthulhu in a Santa suit and many of his friends, is aimed at younger readers, but contains more adult text than earlier books in the , such as a quote in R'lyehian . consists of 26 digitally-rendered images by artist Joshua Janes, was written by Jason Ciaramella , and was published by ComixTribe in 2022. Both board book and digital editions were issued. Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Jason_Ciaramella"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Children's</ex:hasGenreW>
    <ex:hasPageCountW>26</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#C_is_for_Cthulhu"/>
    <ex:wasReleasedOnW>2022 October 18</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Max_D._Stanton">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Max D. Stanton</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author United States Weird fiction is an American author based in Philadelphia. He has written a handful of short fiction pieces set in and around H. P. Lovecraft 's Cthulhu Mythos ; these have been featured in anthologies such as Pickman's Gallery (2018) and Corporate Cthulhu (2018). A collection of his own works, A Season of Loathsome Miracles , was released by Trepidatio Publishing in 2020. Selected Bibliography Short Fiction " Pigman " (2018) " Pickman's Model " (2018) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Continuity_of_the_Fungi_from_Yuggoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Continuity of the Fungi from Yuggoth</rdfs:label>
    <ex:hasAnnotation>R. Boerem English Genre(s) Non-fiction Ohio University Press H. P. Lovecraft: Four Decades of Criticism date 1980 " " is a short non-fiction piece by R. Boerem . It was published in the S. T. Joshi -edited collection H. P. Lovecraft: Four Decades of Criticism by Ohio University Press in 1980.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#R._Boerem"/>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft:_Four_Decades_of_Criticism"/>
    <ex:wasPublishedOnW>1980</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Jealous_God">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Jealous God</rdfs:label>
    <ex:hasAnnotation>Disgraced rockabilly star billy ray wildman meets a strange old man in the forest . In return, he is granted a second chance in the music industry on the condition that he forsake all other gods . Later, when he remembers his promise to his devoutly christian mother on her deathbed, he makes the decision to end his most recent concert with a gospel song . The story was published in his collection looking for darla: stories of mythos noir by</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Looking_for_Darla:_Stories_of_Mythos_Noir"/>
    <ex:wasPublishedOnW>September 2008</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#hasHalfBrotherR">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>hasHalfBrotherR</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
