    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Character"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Charles_Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Charles Lovecraft</rdfs:label>
    <ex:hasAnnotation>Full Name Charles Danny Lovecraft Pseudonym(s) Danny Lovecraft C. D. Whateley Connection to the Mythos Writer Birth Date 9 May 1955 Sydney, New South Wales, Australia Australian https://www.preapress.com/index.php?page=1 Charles Danny Lovecraft is an Australian poet, editor and non-fiction writer who works in the fantasy, supernatural and weird fiction genres. He is also the founder of P'rea Press, a small press publisher of poetry in these genres. He has cited Howard Phillips Lovecraft as one of his inspirations. Selected Bibliography Poems " The Stars Are Always Right " (2019)</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#Australia New South Wales Sydney</ex:hasBirthplaceR>
    <ex:hasFullNameR>Charles Danny Lovecraft</ex:hasFullNameR>
    <ex:hasNationalityR>Australian</ex:hasNationalityR>
    <ex:hasPseudonymR>C. D. Whateley</ex:hasPseudonymR>
    <ex:hasPseudonymR>Danny Lovecraft</ex:hasPseudonymR>
    <ex:hasWebsiteR>https://www.preapress.com/index.phppage=1</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Writer</ex:isConnectedToMythosR>
    <ex:wasBornOnR>9 May 1955</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Josh_Brown">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Josh Brown</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Poet United States United States https://ninjamindcontrol.wordpress.com/ is an American author, poet, artist, and one-time comic book creator who has written a handful of works set in the greater Cthulhu Mythos begun with the writings of Howard Phillips Lovecraft . His works have been included in collections such as Lovecraft after Dark (2015, James Ward Kirk Publishing). Selected Works Poetry " Flame of Cthulhu " (2015) " My Pet Cthulhu " (2018) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>United States</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://ninjamindcontrol.wordpress.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Poet</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Butler_Hospital">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Butler Hospital</rdfs:label>
    <ex:hasAnnotation>Providence , Rhode Island Mental health facility 1844 is a psychiatric hospital in Providence , Rhode Island , where both of H. P. Lovecraft 's parents -- Winfield Scott Lovecraft and Sarah Susan Phillips Lovecraft -- were committed and later died. Founded in 1844 as Providence's first mental health hospital, Butler since 1972 has been affiliated with the Brown University medical school's department of psychiatry. References</ex:hasAnnotation>
    <ex:hasOriginL>1844</ex:hasOriginL>
    <ex:hasTypeL>Mental health facility</ex:hasTypeL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Rhode_Island"/>
    <ex:isLocatedAtL>Providence</ex:isLocatedAtL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Take_Your_Daughters_to_Work">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Take Your Daughters to Work</rdfs:label>
    <ex:hasAnnotation>The book of cthulhu ii was first published in issue #6 of the subterranean press magazine subterranean in january 2007 . It is a short story about an industrial facility dedicated to raising submerged city from beneath the depths .</ex:hasAnnotation>
    <ex:hasAuthorW>Livia Llewellyn</ex:hasAuthorW>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Book_of_Cthulhu_II"/>
    <ex:wasPublishedOnW>January 2007</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Temple_of_Chthon">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsOriginatingFromMythosAdjacentWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Temple of Chthon</rdfs:label>
    <ex:hasAccessibilityL>Entrance on island</ex:hasAccessibilityL>
    <ex:hasAnnotation>The (aka, the temple of the darkhold) is located on the chthonic island . It's a massive temple with eldritch statuary and wall sculptures . Deep under the temple is a nether region, between the material world and chthon 's reality .</ex:hasAnnotation>
    <ex:hasNotableFeatureL>Statues</ex:hasNotableFeatureL>
    <ex:hasNotableFeatureL>wall sculptures</ex:hasNotableFeatureL>
    <ex:hasTypeL>Building complex</ex:hasTypeL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Earth"/>
    <ex:madeFirstAppearanceOnL>Carnage Vol 2 13</ex:madeFirstAppearanceOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Frederick_J._Mayer">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Frederick J. Mayer</rdfs:label>
    <ex:hasAnnotation>Pseudonym(s) F. J. Mayer Connection to the Mythos Writer Poet Artist Horror is a poet, author and artist who has written a number of works set within the greater Cthulhu Mythos established by H. P. Lovecraft and many others. Selected Bibliography Poems " The Book of Eibon/Le Livre D'eibon " (2019)</ex:hasAnnotation>
    <ex:hasPseudonymR>F. J. Mayer</ex:hasPseudonymR>
    <ex:isConnectedToMythosR>Artist</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Poet</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Writer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Coatlicue">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Coatlicue</rdfs:label>
    <ex:hasAlternativeNamesC>The Serpent Skirted One</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The serpent skirted one is a deity from the h.p. Lovecraft -inspired cthulhu mythos . She is said to be humanoid in form with a reptilian nature . Her head is actually a pair of serpents which face each other . She wears a skirt created from living snakes .</ex:hasAnnotation>
    <ex:hasCharacterMateC rdf:resource="http://example.org/lovecraft#Yig"/>
    <ex:madeFirstAppearanceOnC>The Rattle of Her Smile</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Stanley_C._Sargent"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Fall_of_Cthulhu_Volume_5:_Apocalypse">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Fall of Cthulhu Volume 5: Apocalypse</rdfs:label>
    <ex:hasAnnotation>Apocalypse is the conclusion of the main story arc of fall of cthulhu . A prequel of sorts, nemesis , was later released, along with two spin-off series focusing on the character of lucifer .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Michael_Alan_Nelson"/>
    <ex:hasPageCountW>98</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>March 2010</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nath-Horthath">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Nath-Horthath</rdfs:label>
    <ex:hasAffiliationC>Great Ones (a.k.a. Gods of Earth)</ex:hasAffiliationC>
    <ex:hasAnnotation>Great Ones (a.k.a. Gods of Earth) First appearance HPL : " Celephaïs " EXP : " The Gods of Earth " Created by H. P. Lovecraft Nat-Horthath is known as one of the chief gods of Celephaïs . It is the only Great One named by H. P. Lovecraft .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Gods_of_Earth"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Celepha%C3%AFs"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_%28Gunship%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu (Gunship)</rdfs:label>
    <ex:hasAnnotation>Cthulhu Gunship Corin Hardy English Genre(s) Synthwave Fangoria Presents: Hollydoom date January 2019  Cthulhu is a music video composed by the British synthwave band Gunship, with the help of Corin Hardy and first released on the album Fangoria Presents: Hollydoom in January 2019 . The track contains no lyrics aside from an intro monologue. External Links " Cthulhu " at YouTube References</ex:hasAnnotation>
    <ex:hasAuthorW>Corin Hardy</ex:hasAuthorW>
    <ex:hasAuthorW>Gunship</ex:hasAuthorW>
    <ex:hasGenreW>Synthwave</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Fangoria Presents: Hollydoom</ex:isPublishedAsW>
    <ex:wasPublishedOnW>January 2019</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#LocationsIncorporatedFromFolkloreMythAndReligion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Location"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Spoonhead">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Spoonhead</rdfs:label>
    <ex:hasAnnotation>The spoonheads were created by the bbc in 2013 for doctor who . They were roughly humanoid in shape though metallic, with a spoon-shaped head . Back of the head was an upload panel which virtualized people into incorporeal forms .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Bells of Saint John</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>The Great Intelligence</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Happyology">
    <rdf:type rdf:resource="http://example.org/lovecraft#Cults"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OrganisationsOriginatingFromMythosInspiredWorks"/>
    <rdfs:label>Happyology</rdfs:label>
    <ex:hasAnnotation>is a Lovecraftian-like cult in the fictional universe of Marvel by Marvel Comics . Background In the rebooted Marvel Comics, is a cult which was founded by McTavish on the Internet, dedicated to the undergod Uluath . They took a private yacht to the Pacific Ocean to awaken their deity, with a ritual ceremony. Uluath was awakened and the City Below the Seas rose to the surface, but he was defeated and sent back into slumber by one of Kid Kaiju's creations.</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#John_Dee">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>John Dee</rdfs:label>
    <ex:ceasedOnC>1608 1609</ex:ceasedOnC>
    <ex:hasAffiliationC>The Crown of the British Empire</ex:hasAffiliationC>
    <ex:hasAnnotation>Dee was a real-world astronomer, astrologer, occultist and alchemist incorporated into the cthulhu mythos by frank belknap long for his short story " the space-eaters " (1928) and by h. p. lovecraft for his short story " the dunwich horror " (1929) . He was inducted into the service of the crown when queen elizabeth took the throne in 1558, acting as her</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Dunwich_Horror"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Space-Eaters"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Frank_Belknap_Long"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Howard_Phillips_Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Russells_Guide_to_Interdimensional_Entities">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Russell's Guide to Interdimensional Entities</rdfs:label>
    <ex:hasAnnotation>Russell's guide is a kind of "field guide" to the creatures of the cthulhu mythos . It includes information on these beings, such as descriptions, behaviour and how to summon them .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#B._A._Lee"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>96</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>August 2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#My_Favorite_Character">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>My Favorite Character</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft United States English The Blue Pencil Club of Brooklyn The Brooklynite date January 1926 " My Favourite Character " is a poem by the late American Howard Phillips Lovecraft . It was first published on the front cover of the January 1926 edition of The Brooklynite , and has been reprinted several times . History The Brooklynite (1926) Something About Cats and Other Pieces (1949) Collected Poems (1963) The World of H. P. Lovecraft (1971) Fungi from Yuggoth and Other Poems (1971) The Ancient Track: The Complete Poetical Works of H. P. Lovecraft (2001, 2013) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>The Brooklynite</ex:isPublishedAsW>
    <ex:wasPublishedOnW>January 1926</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Vorlon">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Vorlon</rdfs:label>
    <ex:hasAnnotation>Vorlons are a race of partly translucent, bioluminescent radially symmetrical multi-tentacled creatures . They are connected to each other telepathically and have a telepathic connection to their own vessels . The vorlons possess miles-long planet killer starships that can shatter worlds with lightning-like streams of particles .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Babylon 5: The Gathering</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#J._Michael_Straczynski"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#On_the_Literary_Influences_Which_Shaped_Lovecrafts_Works">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>On the Literary Influences Which Shaped Lovecraft's Works</rdfs:label>
    <ex:hasAnnotation>J. Vernon Shea United States English Genre(s) Non-fiction Ohio University Press H. P. Lovecraft: Four Decades of Criticism date 1980 " " is a short non-fiction piece by American and scholar J. Vernon Shea . Overview Running to around 40 pages in length, "" was published in the S. T. Joshi -edited collection H. P. Lovecraft: Four Decades of Criticism by Ohio University Press in 1980.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#J._Vernon_Shea"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft:_Four_Decades_of_Criticism"/>
    <ex:wasPublishedOnW>1980</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#EarthNativeSpecies">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Character"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Charles_Dexter_Ward">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Charles Dexter Ward</rdfs:label>
    <ex:ceasedOnC>1928</ex:ceasedOnC>
    <ex:hasAnnotation>Ward is a young man from a prominent rhode island family, in 1902--making him 26 in 1928 . He develops an obsession with his great-great-great-great-grandfather, a reputed wizard who is ward's physical double . He eventually uses this knowledge to physically resurrect curwen .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Case_of_Charles_Dexter_Ward"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#My_Little_Sister_Wants_You_to_Suffer">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>My Little Sister Wants You to Suffer</rdfs:label>
    <ex:hasAnnotation>Paul Fricker Lucy Fricker Sarah Huynh John Sumrow English Call of Cthulhu Genre(s) Roleplaying game DriveThruRPG Release Date December 2022 37 is a stand-alone scenario supplement for Chaosium 's Call of Cthulhu horror roleplaying game. Written by Paul Fricker and featuring artwork by Lucy Fricker, Sarah Huynh, and John Sumrow, it was published through DriveThruRPG's Miskatonic Repository initiative in December 2022; both softcover and digital editions were made available . Overview References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Paul_Fricker"/>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>37</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>December 2022</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sarkomand">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Sarkomand</rdfs:label>
    <ex:hasAnnotation>The city is located in the northern dreamlands, in a valley by the plateau of leng . It is beside the sea, but the rocks are jagged; human ships do not go there . In modern times its stones and pillars are broken, and overgrown with weeds .</ex:hasAnnotation>
    <ex:hasTypeL>Abandoned City</ex:hasTypeL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Dream-Quest_of_Unknown_Kadath"/>
    <ex:wasDestroyedOnL>000 000 BC Circa 1</ex:wasDestroyedOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_House_of_Nodens">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The House of Nodens</rdfs:label>
    <ex:hasAnnotation>The story alternates, through flashbacks, between two separate but linked tales which take place in connecticut, new england . In 1975, a group of outcasts in their early teens calling themselves the cemetery league discover a strange clearing in the woods . The evil which hibernates within the land begins to awaken and insinuate itself into the minds of some of the boys . Forty years later, a small police task force attempt to apprehend the serial killer known as the</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Sam_Gafford"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>252</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>July 2017</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Fosterling_of_the_Old_One">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Fosterling of the Old One</rdfs:label>
    <ex:hasAnnotation>Fosterlings of the old ones are mutants born to humans whom have mated with a great old one or an outer god . In a special ceremony, the entity projects dreams that reach the pregnant woman's womb altering the unborn fetus dna . The resulting offspring, a fosterling, lives for years as a normal human until the day it mutates .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Faces_at_Pine_Dunes"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Tale_of_Satampra_Zeiros">
    <rdf:type rdf:resource="http://example.org/lovecraft#ClarkAshtonSmithWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Tale of Satampra Zeiros</rdfs:label>
    <ex:hasAnnotation>A pair of down-on-their-luck thieves in ancient hyperborea decide that the best way to get their finances back on track is to raid the long-abandoned city of commoriom . Upon their arrival, they investigate an ancient temple to tsathoggua, and invite the wrath of one of the temple's guardians . Although one of the adventurers manages to escape with merely the loss of a hand, the other is not so lucky</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Hyperborean_Cycle"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>November 1931</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bugg-Shash">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Bugg-Shash</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>He Who Comes in the Dark</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Black One</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Filler of Space</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Black One The Filler of Space He Who Comes in the Dark Great Old Ones First appearance ADJ : " Demoniacal " EXP : " The Kiss of " Created by David Sutton is a gelatinous creature with numerous human-like eyes and mouths covering its body. It attacks its prey by wrapping around them and drowning them in slime, often multiple people at once. Once the victims are dead they can be controlled, like puppets, to perform tasks where there is light, 's only weakness. Gallery</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Kiss_of_Bugg-Shash"/>
    <ex:madeFirstAppearanceOnC>Demoniacal</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>David Sutton</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tsunth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Tsunth</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Zushakon"/>
    <ex:hasAnnotation>Zushakon Hidden One First appearance EXP : " The Descent into the Abyss " Created by Lin Carter is a fictional being created by Lin Carter for his short story " The Descent into the Abyss ", where it is described as "the veiled leader of the Hidden Ones who serve Zulchequon ".</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Descent_into_the_Abyss"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Basatan">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Basatan</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Master of the Crabs</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>"the master of crabs" is a sea god of zothique . There is a magic ring associated with him that gives its owner the powers to control sea winds and creatures . Behind the mythos was created by clark ashton smith for the non-mythos zothique tale " the master of crabs "</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Master of Crabs</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nyarlathoteps_Half-Brother">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Nyarlathotep's Half-Brother</rdfs:label>
    <ex:hasAnnotation>Powers and Abilities Fear inducement Relatives Nyarlathotep First appearance EXP : "In 'Ygiroth" Created by Walter C. DeBill, Jr. is a fictional cosmic being created by Walter C. DeBill, Jr. for his short story "In 'Ygiroth". Description Little is known about this entity, which is described as Nyarlathotep 's "half-brother and other face", possibly indicating that it might be an aspect of Nyarlathotep himself, as opposed to a literal relative. It is also described as "a ravenous and by no means sane entity", and has the power to spread fear "like a poisonous vapor", causing all in its proximity to panic in sheer uncontrollable terror. ( EXP : "In 'Ygiroth") Behind the Mythos Since Nyarlathotep's only known parent is Azathoth ( HPL : Selected Letters of H. P. Lovecraft ), which reproduces asexually by fission ( CIRCLE : " The Family Tree of the Gods "), the idea that he could have a "half-brother" seems unusual, although it opens up the possibility that Azathoth might be able to reproduce sexually as well, and that either Nyarlathotep or his Half-Brother (or both) were born from such a union.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>In 'Ygiroth</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Walter C. DeBill. Jr.</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Brother_of_Chaugnar_Faugn">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Brother of Chaugnar Faugn</rdfs:label>
    <ex:hasAnnotation>Real World Information First appearance CIRCLE : The Horror from the Hills Created by Frank Belknap Long The Brothers of Chaugnar Faugn are the servants of the Great Old One Chaugnar Faugn . Description The Brothers of Chaugnar Faugn appear as bloated elephantine beings similar to their master. They can remain still so that they appear as statues. Gallery</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Horror_from_the_Hills"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Frank_Belknap_Long"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Charlie_Kane">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Charlie Kane</rdfs:label>
    <ex:hasAffiliationC>Arkham City Government</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Politician</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The politician is a fictional character created by fantasy flight games for inclusion in their arkham horror files line . He has since made appearances in their other product lines, including eldritch horror and the arkham horror premium figures line (all exp) he is visibly based on charles foster kane from citizen kane .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Kingsport Horror Deluxe Expansion</ex:madeFirstAppearanceOnC>
