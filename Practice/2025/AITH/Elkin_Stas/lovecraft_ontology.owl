  <rdf:Description rdf:about="http://example.org/lovecraft#The_Eater_of_Hours">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Eater of Hours</rdfs:label>
    <ex:hasAnnotation>Behind the mythosis a short story by noted american and literary critic darrell schweitzer . It was first published in inhuman magazine #4 in the summer of 2009 . The story is set in lovecraft's fictional cthulhu mythos .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Darrell_Schweitzer"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
