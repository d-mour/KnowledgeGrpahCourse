    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dulwich Horror of 1927 (chapbook)</rdfs:label>
    <ex:hasAnnotation>The Dulwich Horror of 1927 David Hambling English Genre(s) Horror Weird fiction The Dulwich Horror of 1927 is a Lovecraftian chapbook release by British David Hambling . Overview Issued as a digital release, The Dulwich Horror of 1927 contains the short story from which it takes its name . A later release includes the bonus Lovecraftian short story " A Question of Blood ", and run to a total of 89 pages. Contents " The Dulwich Horror of 1927 " " A Question of Blood " (later release only)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#David_Hambling"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#hasGrandDaughterR">
