  <rdf:Description rdf:about="http://example.org/lovecraft#Minion_of_Othuum">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Minion of Othuum</rdfs:label>
    <ex:hasAnnotation>The minions of othuum are creatures created by brian lumley for his short story " rising with surtsey " and later used by chaosium for the call of cthulhu role-playing game . They appear as miniature versions of their master othuum, and inhabit the depths of the ocean . They have the ability to swap minds with people, but only when their master is</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Rising_with_Surtsey"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#H._P._Lovecrafts_At_The_Mountains_of_Madness">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>H. P. Lovecraft's At The Mountains of Madness</rdfs:label>
    <ex:hasAnnotation>Gou Tanabe Gou Tanabe Japanese Kadokawa Corporation (original) Dark Horse Comics (English translation) Release Date 2016 Media Type Manga is a two volume manga written and illustrated by Japanese horror manga creator Gou Tanabe , and published by Kadokawa Corporation in 2016. An English translation was published in 2019 by Dark Horse Comics. It is an adaptation of " At the Mountains of Madness " by Howard Phillips Lovecraft .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Gou_Tanabe"/>
    <ex:isInLanguageW>Japanese</ex:isInLanguageW>
    <ex:wasReleasedOnW>2016</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#In_a_Lonely_Place">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>In a Lonely Place</rdfs:label>
    <ex:hasAnnotation>Karl Edward Wagner Cover Artist Barclay Shaw English Genre(s) Horror Warner Books Release Date March 1983 265  is a collection of weird stories by Karl Edward Wagner , some of which have Lovecraftian themes. It was first published by Warner Books in 1983; a new edition was released by Valancourt Books in 2023 Contents "In the Pines" (1973) "Where the Summer Ends" (1980) " Sticks " (1974) "The Fourth Seal" (1975) ".220 Swift" (1980) "The River of Night's Dreaming" (1981) "Beyond Any Measure" (1982)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Karl_Edward_Wagner"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>265</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>March 1983</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#New_Jersey">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>New Jersey</rdfs:label>
    <ex:hasAnnotation>United states east coast state is a state in the mid-atlantic region of the united states . It has been repeatedly used as setting for cthulhu mythos stories . Lovecraft visited repeatedly when he lived in new york city . In " the call of cthulhu," lovecraft was inspired by a house in elizabeth .</ex:hasAnnotation>
    <ex:hasTypeL>State</ex:hasTypeL>
    <ex:isLocatedAtL>United States East Coast</ex:isLocatedAtL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Robert_Barbour_Johnson">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Robert Barbour Johnson</rdfs:label>
    <ex:diedOnR>1987</ex:diedOnR>
    <ex:hasAnnotation>Connection to the Mythos Author Birth Date 1907 Hopkinsville, Kentucky, USA Death Date 1987 United States Weird fiction 𝐓 was an American author and artist. A number of his stories first saw print in pulp magazine Weird Tales and one of these, "Lead Soldiers", prompted H. P. Lovecraft to write him a letter in appreciation of the piece. After Lovecraft's death, Johnson wrote his most famous work, " Far Below ", which draws clear inspiration from " Pickman's Model ", and includes a reference to a fictionalised version of Lovecraft as an homage. Selected Bibliography " Far Below " (1939)</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Kentucky Hopkinsville</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1907</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Hellhound">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Hellhound</rdfs:label>
    <ex:hasAlternativeNamesC>Imp</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The is a fictional demon in the prime reality of the . Marvel universe of comics . Created in 1992 by chris cooper, first appearing in issue #2 of the 1st volume of darkhold: pages from the book of sins .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>1992</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>Darkhold: Pages from the Book of Sins Vol 1 2</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Chris Cooper</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Henri-Laurent_de_Marigny">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Dreamers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Henri-Laurent de Marigny</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Titus_Crow"/>
    <ex:hasAffiliationC>The Elder Gods</ex:hasAffiliationC>
    <ex:hasAffiliationC>The Wilmarth Foundation</ex:hasAffiliationC>
    <ex:hasAnnotation>De marigny is a fictional character created by brian lumley as a companion for titus crow . He is a time-travelling adventurer engaged in a long war with the cthulhu cycle deities . Lumley presents him as the son of a character featured by h. p. lovecraft and e. hoffmann price in " through the gates of the silver key "</ex:hasAnnotation>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Servant_of_Glaaki">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ServitorRaces"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Servant of Glaaki</rdfs:label>
    <ex:hasAnnotation>Real World Information First appearance EXP : " The Inhabitant of the Lake " Created by Ramsey Campbell The Servants of Glaaki are creatures created by the Great Old One Glaaki . Description The Servants of Glaaki are zombie -like beings that result from living victims who have been infected by Glaaki's toxic spikes. For the first 65 years, they retain their human appearance, and are still capable of independent thought and action when not receiving direct orders from Glaaki. After this period, however, they experience something known as the "Green Decay", which transforms them into undead creatures that can't withstand sunlight. ( EXP : " The Inhabitant of the Lake ")</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Inhabitant_of_the_Lake"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Upas_tree">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonSapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SpeciesIncorporatedFromFolkloreMythAndReligion"/>
    <rdfs:label>Upas tree</rdfs:label>
    <ex:hasAnnotation>The ( antiaris toxicaria ) is an indonesian and australian tree . It also grows in africa. In folklore it was believed to poison its surroundings and said to be fatal to approach.</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dominion_of_the_Black">
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OrganisationsOriginatingFromMythosInspiredWorks"/>
    <rdfs:label>Dominion of the Black</rdfs:label>
    <ex:hasAnnotation>The dominion of black is a sinister intergalactic organization controlled by lovecraftian-like entities in the fictional universe of pathfinder . It's rumored that their ultimate goal is the extermination of all life in the cosmos and/or replacement with something else in another reality . Their forces include monstrous servitor races and are equipped with interstellar starships with faster-than-light capability .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#From_Between">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>From Between</rdfs:label>
    <ex:hasAnnotation>Home from the sea: tales of lovecraftian terror was published in 2017 . The story is very similar to another of meikle's works, " carnacki: the larkhill barrow "</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Home_From_The_Sea:_Tales_of_Lovecraftian_Terror"/>
    <ex:wasPublishedOnW>April 2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Inquisitor">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Inquisitor</rdfs:label>
    <ex:hasAnnotation>Story was first published in the anthology historical lovecraft: tales of horror through time in april 2011 . It was later included in the collections of meikle's own works samurai and other stories (2014) and home from the sea: tales of lovecraftian terror (2017) .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Historical Lovecraft: Tales of Horror Through Time</ex:isPublishedAsW>
    <ex:wasPublishedOnW>April 2011</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mondrago_Family">
    <rdf:type rdf:resource="http://example.org/lovecraft#Cults"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdfs:label>Mondrago Family</rdfs:label>
    <ex:hasAffiliationO rdf:resource="http://example.org/lovecraft#Ghattambah"/>
    <ex:hasAnnotation>The is a bloodline created by mark mclaughlin and michael sheehan, jr. for their cthulhu mythos stories . The mondragos have been cultists of the insect-god for untold centuries . In the modern age the - extremely wealthy - family maintain a chapel to ghattambah in their expansive mansion .</ex:hasAnnotation>
    <ex:hasPurposeO>The worship of Ghattambah</ex:hasPurposeO>
    <ex:hasTypeO>Familial cult</ex:hasTypeO>
    <ex:isLocatedAtO>Belgium</ex:isLocatedAtO>
    <ex:isLocatedAtO>North America</ex:isLocatedAtO>
    <ex:wasCreatedBynO rdf:resource="http://example.org/lovecraft#Mark_McLaughlin"/>
    <ex:wasCreatedBynO>Michael Sheehan. Jr.</ex:wasCreatedBynO>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Old_God_%28Vampirella%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Old God (Vampirella)</rdfs:label>
    <ex:hasAnnotation>The old gods are demonic entities in the fictional universe of vampirella by dynamicmite entertainment . They are the gods of fear, gods of sorrow, gods of hate, and gods of hunger . All of whom are eager to return to the universe to throw it back into primal savagery and death .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Aku-Shin_Kage">
    <rdf:type rdf:resource="http://example.org/lovecraft#Avatars"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Aku-Shin Kage</rdfs:label>
    <ex:hasAffiliationC>Revered in Japan</ex:hasAffiliationC>
    <ex:hasAnnotation>It is believed that the warlord oda nobunaga was one of his human incarnations known as the "dark warlord", and also known precisely as "ghost of nobunaga" in more modern times, due to a long and close affinity with oda in life, can take on the human form of the ghost of nobunaga, appearing age forty . In his usual form, he appears dressed in a full suit of blackened samurai o-yoroi armor,</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Secrets_of_Japan"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shadows_Over_Filmland">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Shadows Over Filmland</rdfs:label>
    <ex:hasAnnotation>Kenneth Hite Robin D. Laws Jérôme Huguenin Cover Artist Jérôme Huguenin English Trail of Cthulhu Genre(s) Roleplaying game Pelgrane Press Release Date 2009 38 is a scenario supplement for the Trail of Cthulhu horror roleplaying game. Written by Kenneth Hite and Robin D. Laws and featuring artwork from Jérôme Huguenin, it was published by Pelgrane Press in 2009 ; both print and digital editions were released. Overview Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Kenneth_Hite"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robin_D._Laws"/>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>38</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Trail_of_Cthulhu"/>
    <ex:wasReleasedOnW>2009</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#J_C_Henneberger">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>J C Henneberger</rdfs:label>
    <ex:diedOnR>1969</ex:diedOnR>
    <ex:hasAnnotation>Founder of College Humor (1922f.) and the original publisher of Weird Tales.</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1890</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Thing_on_the_Doorstep_and_Other_Weird_Stories">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Thing on the Doorstep and Other Weird Stories</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft English Genre(s) Horror Penguin Classics Release Date 2 October 2001 Media Type Print Preceded by The Call of Cthulhu and Other Weird Stories Followed by The Dreams in the Witch House and Other Weird Stories is an anthology of short works by American Howard Phillips Lovecraft . Overview First released in 2001 by Penguin Classics and edited by H. P. Lovecraft scholar S. T. Joshi , is Penguin's second collection of Lovecraft's work. Like it’s predecessor, The Call of Cthulhu and Other Weird Stories , the versions of the stories contained within are for the most part the revised editions published earlier by Arkham House , and also edited by Joshi. The exception is At the Mountains of Madness , which is presented in a newly-edited "definitive edition" with an introduction by China Miéville. Contents " The Tomb " " Beyond the Wall of Sleep " " The White Ship " " The Temple " " The Quest of Iranon " " The Music of Erich Zann " " Imprisoned with the Pharaohs " aka "Under the Pyramids" " Pickman's Model " " The Case of Charles Dexter Ward " " The Dunwich Horror " At the Mountains of Madness " The Thing on the Doorstep " Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2 October 2001</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Shadow_Out_of_Time">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Shadow Out of Time</rdfs:label>
    <ex:hasAnnotation>" till a' the seas " with r.h. barlow is a novella by american horror fiction writer h.p. Lovecraft . The story is told through the eyes of nathaniel wingate peaslee, an american living in the first decade of the 20th century, who is "possessed" by a yithian . He fears he is losing his mind when he unaccountably sees strange vistas of other worlds</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>Science Fiction novella</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Cthulhu Mythos</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#John_B._Ford">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>John B. Ford</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Editor Birth Date 1963 United Kingdom http://www.rainfallsite.com/FiendishFord.html is an English author and editor who has worked on many Cthulhu Mythos publications. He was a frequent collaborator with Steve Lines , with whom he ran Rainfall Books , before Lines' death in early 2021. Selected Bibliography Editor Lovecraft's Disciples (2005-2020) E'ch Pi El (2006-2018) Tales of the Cthulhu Mythos: Cthulhu's Creatures (2007)</ex:hasAnnotation>
    <ex:hasNationalityR>United Kingdom</ex:hasNationalityR>
    <ex:hasWebsiteR>http://www.rainfallsite.com/FiendishFord.html</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1963</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Seeds_from_the_Blasted_Heath">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Seeds from the Blasted Heath</rdfs:label>
    <ex:hasAnnotation>Short story was published in the zine lovecraftiana vol 8, issue 2 in 2023 . Narrator is returning home to kentucky via the back country west of arkham . He stops off at a roadside stall selling the most incredible tomato plants . On his way home, he notices a pungent odour coming from the tomatoes .</ex:hasAnnotation>
    <ex:hasAuthorW>Brian Barnett</ex:hasAuthorW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 2</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 8</ex:isPublishedAsW>
    <ex:wasPublishedOnW>July 2023</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Slimy_Ones">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Slimy Ones</rdfs:label>
    <ex:hasAnnotation>A lonely man who has spent most recent years trying to warn the world of the dangers posed by humanoid fishmen . As his transformation completes, he ambles off to find his lost kin . Characters include michael "fishboy" jarvis , an outsider who believes he has important knowledge which must be shared with the world .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mark_McLaughlin"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Worlds_of_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Worlds of Cthulhu</rdfs:label>
    <ex:hasAnnotation>240 is a collection of short stories--some in the cthulhu mythos and some not--edited by robert m. price . It is a follow-up to price's collections tales of the lovecraft mythos and the new lovecraft circle . The dust jacket illustration is by gahan wilson and the endpaper illustrations are by tim kirk .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>240</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>October 2012</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Werewolf_by_Night_Vol_2">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Werewolf by Night Vol 2</rdfs:label>
    <ex:hasAnnotation>Paul Jenkins Leonardo Marco English Marvel Comics Release Date Feb 1998 - Jul 1998 Media Type Comic book is a 6-part mini-series written by Paul Jenkins. Synopsis Werewolf by Night confronts the Wolf Lord Varcolac , one of the spawn of the Elder God , Chthon .</ex:hasAnnotation>
    <ex:hasAuthorW>Paul Jenkins</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>Feb 1998 - Jul 1998</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Secret_in_the_Tomb">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Secret in the Tomb</rdfs:label>
    <ex:hasAnnotation>First published in 1935 issue of horror magazine weird tales . Narrator follows psychic calling to the tomb of the family patriarch . Escapes the tomb before having it razed to the ground and buried .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_Bloch"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>May 1935</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dagon_%28fanzine%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dagon (fanzine)</rdfs:label>
    <ex:hasAnnotation>Dagon was a fanzine which was released between 1983 and 1990 . Edited by the late carl t. ford, it ran for a total of 27 issues . Rumours of a relaunch were rumoured but never came to pass .</ex:hasAnnotation>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Many-Angled_One">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Many-Angled One</rdfs:label>
    <ex:hasAlternativeNamesC>Chthonic Deities</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Chthonic Entities</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Elder Gods</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Great Old Ones</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Lloigor</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Nameless Ones</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Old Ones</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Outsiders</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Undying Ones</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The many-angled ones are a race of extradimensional entities from the expanded cthulhu mythos . They exist in a space that contains more dimensions than our universe therefore they appear to humans as "many angled" the goal of the many-angled ones is to impose on the multiverse a rigid geometrical order thereby making everything run like clockwork .</ex:hasAnnotation>
    <ex:hasAppearanceC>The Thanos Imperative The Laundry Files</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC>2000 AD Vol 1 536</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Grant_Morrison"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Redneck_Eldritch">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Redneck Eldritch</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Carter Reid English Cold Fusion Media Release Date April 2016 311 is an anthology of Lovecraftian fiction edited by Nathan Shumate and published by Cold Fusion Media in April 2016. Cover art was supplied by Carter Reid, and both print and digital editions were released. Overview Contents "A Hole in the World" by Ian Welke "Recording Devices" by D. J. Butler "Mine of the Damned Gods" by Sarah E. Seeley "Blood" by Steve Diamond "Ostler Wallow" by Nathan Shumate "Nightmare Fuel" by David Dunwoody "The Swimming Hole" by Theric Jepson "It Came from the Woods" by Jason A. Anderson "Lake Town" by Garrett Calcaterra "Taxed" by Scott William Taylor "The Gears Turn Below" by S. M. Williams "Slicker" by Robert J Defendi "A Brown and Dismal Horror" by Jaleta Clegg "The People of the Other Book" by Robert Masterson "The Diddley Bow Horror" by Brad R. Torgersen "At the Highways of Madness" David J. West</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>311</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>April 2016</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Martins_Beach_Creature">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Martin's Beach Creature</rdfs:label>
    <ex:hasAnnotation>The horror at martin's beach is a fictional monster invented by h. p. lovecraft and sonia greene in the short story " the horror at martin's beach " . The unnamed sea monster was killed in 1922 by captain james p. orne, who later exhibited the creature's body at the beach . However, the creature turned out to have been just an infant, and its presumed parent surfaced months later to extract revenge upon the captain and numerous other people</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Horror_at_Martins_Beach"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasCreatedByC>Sonia Greene</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Last_Test">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Last Test</rdfs:label>
    <ex:hasAnnotation>Wtis a short story by h. p. lovecraft and adolphe de castro that appeared under de castro's name in the november 1928 issue of weird tales . It is notable as the first story in writing order to mention the cthulhu mythos entity shub-niggurath .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Adolphe_de_Castro"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Howard_Phillips_Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Cthulhu Mythos</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bainbridge">
    <rdf:type rdf:resource="http://example.org/lovecraft#CaitlinRKiernanWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Bainbridge</rdfs:label>
    <ex:hasAnnotation>"highway 97" is a short story by caitlin r. kiernan that features their recurring character . It was written in december 2005/january 2006, and was published for the first time in alabaster . The story belongs in continuity after "highway 97," which was the opening scene of " .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Dancy_Flammarion"/>
    <ex:isPartOfSeriesW>Alabaster</ex:isPartOfSeriesW>
    <ex:wasPublishedOnW>August 2006</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>December 2005 January 2006</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Fairground_Horror">
    <rdf:type rdf:resource="http://example.org/lovecraft#BrianLumleyWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Fairground Horror</rdfs:label>
    <ex:hasAnnotation>Two brothers run a house of horrors at a travelling funfair . One brother seems to take the horrors far too seriously . The story was written in 1972 and first published in 1976 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Disciples_of_Cthulhu"/>
    <ex:wasPublishedOnW>October 1976</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>1972</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mike_Mignola">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Mike Mignola</rdfs:label>
    <ex:hasAnnotation>Mike mignola is an american comic book creator, artist and novelist . He is perhaps best known for being the creator of hellboy . The comic book features direct references to the cthulhu mythos .</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA http://example.org/lovecraft#California Berkeley</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://www.artofmikemignola.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Artist</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Comic book creator</ex:isConnectedToMythosR>
    <ex:wasBornOnR>16 September 1960</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Esoteric_Order_of_Dagon">
    <rdf:type rdf:resource="http://example.org/lovecraft#Cults"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdfs:label>Esoteric Order of Dagon</rdfs:label>
    <ex:hasAffiliationO rdf:resource="http://example.org/lovecraft#Dagon"/>
    <ex:hasAnnotation>Innsmouth dagon is a cult which features prominently in many cthulhu mythos works, especially those involving innsmouth and the deep ones . The order was founded by captain obed marsh in innsmouth using the practices learned from the inhabitants of a polynesian island . In 1846 during one of these sacrifices captain marsh and several members of the order were arrested, though no formal charges were made .</ex:hasAnnotation>
    <ex:hasNotableMemberO>Captain Obed Marsh</ex:hasNotableMemberO>
    <ex:hasTypeO>Cult</ex:hasTypeO>
    <ex:isLocatedAtO rdf:resource="http://example.org/lovecraft#Innsmouth"/>
    <ex:wasCreatedBynO rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#hasFatherR">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>hasFatherR</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:range rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Celaeno_Fragments">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Celaeno Fragments</rdfs:label>
    <ex:hasAnnotation>The fragments are a fictional series of occult writings created by august derleth for his series the trail of cthulhu . They were submitted to miskatonic university by their doctor laban shrewsbury at some point during 1915 . The doctor wrote the fragments from memory after a series of visits to the great library of celaeno .</ex:hasAnnotation>
    <ex:hasAppearanceA rdf:resource="http://example.org/lovecraft#The_Watcher_from_the_Sky"/>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_House_on_Curwen_Street"/>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#August_Derleth"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Innsmouth_Tales_-_2000">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Innsmouth Tales - 2000</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Ran Cartwright United States English H'chtelegoth Press Release Date 2000 is an anthology of short Cthulhu Mythos works. Overview Edited by Mythos authors Ron Shiflet and Ran Cartwright , Innsmouth Tales is a collection of fourteen stories and poems centring around H. P. Lovecraft 's iconic town of Innsmouth . It was published by H'chtelegoth Press in 2000. Contents An Introduction by Ran Cartwright "The Call of the Deep" (2000) poem by Phillip A. Ellis " On a Beach Near Innsmouth " (1999) poem by Ron Shiflet " Rough Night in Innsmouth " (1999) short story by Ron Shiflet "Innsmouth Wood" (2000) short story by Mike Minnis " The Slime Girls " (1998) short fiction by James Ambuehl " Innsmouth Harvest " (1997) short story by Ran Cartwright "The Bends" (2000) short story by Peter A. Worthy "Memories" (2000) short story by Edward P. Berglund "Just a Tad Beyond Innsmouth" (1997) short story by Stanley C. Sargent "Fleas of the Dragon" (1999) short story by C. J. Henderson "Devil Reef" (2000) poem by Phillip A. Ellis " The Folks One Meets in Innsmouth " (1997) poem by Ron Shiflet " Folks of Innsmouth: Dagon Hall Custodian " (1997) poem by Franklyn Searight " Lovecraftian Cliff Notes for Ech-Pi-El's: The Shadow Over Innsmouth " (2000) poem by Franklyn Searight</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2000</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ythogtha">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Ythogtha</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Thing in the Pit The Abomination in the Abyss</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as the abomination in the abyss . Created by lin carter for his xothic legend cycle .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Thing_in_the_Pit"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Out_of_the_Ages"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bnazic_Desert">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Bnazic Desert</rdfs:label>
    <ex:hasAnnotation>Dreamlands Desert Humans First appearance HPL : " The Doom That Came to Sarnath " HPL : " The Quest of Iranon " Created by H. P. Lovecraft The is a desert region in the Dreamlands . The heels of camels from the desert were considered a delicacy in Sarnath . ( HPL : " The Doom That Came to Sarnath ")</ex:hasAnnotation>
    <ex:hasAppearanceL rdf:resource="http://example.org/lovecraft#The_Quest_of_Iranon"/>
    <ex:hasTypeL>Desert</ex:hasTypeL>
    <ex:isInhabitedByL>Humans</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Dreamlands"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Doom_That_Came_to_Sarnath"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#John_Milwarp">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>John Milwarp</rdfs:label>
    <ex:hasAnnotation>Powers and Abilities Knowledge of His Own Past Lives Akashic Record Access Human First appearance " The Chain of Aforgomon " Created by Clark Ashton Smith is a vanished protagonist in the short story " The Chain of Aforgomon " by Clark Ashton Smith . Milwarp obtains and uses the mystical drug souvara , after which he accesses his past lives and the akashic record. In the process he is consigned to a strange and tormented death, as well as being erased from memory, and possibly history itself.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Chain_of_Aforgomon"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#David_Hopewell">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>David Hopewell</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Poet Weird fiction is an author and poet who has written a number of pieces inspired by the works of Howard Phillips Lovecraft and the greater Cthulhu Mythos . These have been included in publications such as Rogue Planet Press zine Lovecraftiana . Selected Works Short Fiction " The Shadow Resurrection " (2020, with Lee Clark Zumpe ) Poetry " Lovecraft " (2006) External Links at The Internet Speculative Fiction Database</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Poet</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shoggoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ServitorRaces"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Shoggoth</rdfs:label>
    <ex:hasAffiliationC>Deep Ones</ex:hasAffiliationC>
    <ex:hasAffiliationC>Elder Things</ex:hasAffiliationC>
    <ex:hasAnnotation>A is a sentient blob of gelatinous flesh, something like a giant amoeba . It can kill its enemies by enveloping them and generating enough suction-force to decapitate their victims . They were genetically engineered by the elder things as a race of servant-tools .</ex:hasAnnotation>
    <ex:hasAppearanceC>000 Years Under the Sea Starry Wisdom Pathfinder RPG Bestiary</ex:hasAppearanceC>
    <ex:hasAppearanceC>The Shadow Over Innsmouth The Thing on the Doorstep Fungi from Yuggoth The Warder of Knowledge Through the Alien Angle Beneath the Moors The Burrowers Beneath Discovery of the Ghooric Zone The Return of the Deep Ones A Colder War A Fatal Exception Has Occurred at... Shoggoths in Bloom The Fillmore Shoggoth 20</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#At_the_Mountains_of_Madness"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Signalman">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>The Signalman</rdfs:label>
    <ex:ceasedOnC>2018 January 18</ex:ceasedOnC>
    <ex:hasAffiliationC>Albany</ex:hasAffiliationC>
    <ex:hasAnnotation>Cynical and burnt-out alcoholic is a senior agent of the shadowy organization known as albany . He is introduced as one of the main characters in agents of dreamland (2017), plays a minor but pivotal role in black helicopters (2018), and is again a prominent onstage figure in the tindalos asset (2020) his career with albany begins in 1981, by 2011, with the supernatural assassin ellison nicodemo, who is also his lover .</ex:hasAnnotation>
    <ex:hasAppearanceC>Black Helicopters (2018)</ex:hasAppearanceC>
    <ex:hasAppearanceC>The Tindalos Asset (2020)</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC>Agents of Dreamland (2017)</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Creak_in_the_Floor">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Creak in the Floor</rdfs:label>
    <ex:hasAnnotation>Cthulhu mythos is a short story by rhode islander, victoria dallpe . It was published in the anthology pickman's gallery by ulthar press in 2018 .</ex:hasAnnotation>
    <ex:hasAuthorW>Victoria Dalpe</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Pickmans_Gallery"/>
    <ex:wasPublishedOnW>2018</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecraftian_Cliff_Notes_for_Ech-Pi-El">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraftian Cliff Notes for Ech-Pi-El</rdfs:label>
    <ex:hasAnnotation>Franklyn Searight United States English Genre(s) Horror Publication date 1998-2001 is a poetry series by the late American Franklyn Searight . Overview Published between 1998 and 2001, each of the poems in consists of a brief rundown of the plot of one of Lovecraft 's short stories. The majority of these pieces were published in periodicals, with the E. P. Berglund -edited online fanzine Nightscapes hosting nearly half of them. Poems "'s: The Rats in the Walls" (1998) "The Statement of Randolph Carter: 's" (1999) "'s: Cool Air" (1999) "'s: The Thing on the Doorstep" (1999) "Lovecraftian Cliffs Notes for Ech-Pi-El's: In the Vault" (1999) "Lovecraftian Cliffs Notes for Ech-Pi-El's: The Music of Erich Zann" (1999) "'s: The Colour Out of Space" (1999) "'s: The Horror at Red Hook" (2000) "'s: The Shadow Over Innsmouth" (2000) "'s: The Dunwich Horror" (2000) "'s Call of Cthulhu" (2000) "'s Dagon" (2000) "Lovecraftian Cliff Notes (2000) "Lovecraftian Cliffs Notes for Hch-Pi-El's: Arthur Jermyn" (2001) "Lovecraftian Cliffs Notes for Hch-Pi-El's: The Shunned House" (2001) "'s: The Nameless City" (2001)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Franklyn_Searight"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>1998-2001</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#X-Men:_Black_Sun">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>X-Men: Black Sun</rdfs:label>
    <ex:hasAnnotation>Chris Claremont, Len Wein, Roy Thomas, Louise Simonson Thomas Derenick, Sean Parsons, Mark McKenna, Karl Waller, John Stanisci, Alitha Martinez, Pablo Raimondi, Jason Martin English Marvel Comics Release Date Nov 2000 Media Type Comic book is a 5-part miniseries written by multiple authors. Synopsis The sorcerer Belasco and the N'Garai attempt to invade and conquer Earth with several possessed X-Men as their weapons. The rest of the X-Men fight to prevent the worldwide invasion and to save their possessed teammates.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Roy_Thomas"/>
    <ex:hasAuthorW>Chris Claremont</ex:hasAuthorW>
    <ex:hasAuthorW>Len Wein</ex:hasAuthorW>
    <ex:hasAuthorW>Louise Simonson</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>Nov 2000</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Chronicles_of_the_Cthulhu_Codex_1">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Chronicles of the Cthulhu Codex 1</rdfs:label>
    <ex:hasAnnotation>Chronicles of the Cthulhu Codex #1 Various Cover Artist C. George Porter English Fungoid Press Release Date January 1985 60 Followed by January 1986 Chronicles of the Cthulhu Codex #1 is the inaugural issue of the long-running but sporadically-released fanzine Chronicles of the Cthulhu Codex . Running to a total of 50 it was edited by Pierre Comtois , features cover art by C. George Porter, and was published by Fungoid Press in January 1985. Contents "Zzzzzzzz!" by P. R. McBride "The Painting" by Sam Gafford "Synaptic Emissions" by R. J. Zimmerman "The Insolent Hubris of Chüngar-Shan" by Henry J. Vester, III "Arc Tangent" by Paul Bastienne "The Ring" by Henry J. Vester, III</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>60</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>January 1985</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Gorgo">
    <rdf:type rdf:resource="http://example.org/lovecraft#MediaAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Gorgo</rdfs:label>
    <ex:hasAnnotation>Is a 1961 british kaiju film directed by eugène lourié . Its premise of a giant sea creature turning out to be an infant, recalls the plot of h. p. lovecraft and sonia greene's " the horror at martin's beach " .</ex:hasAnnotation>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1961 March 29</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Avalon:_The_County_of_Somerset">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Avalon: The County of Somerset</rdfs:label>
    <ex:hasAnnotation>Paul Wade-Williams English Cubicle 7 Entertainment Release Date 2010 Media Type Print Digital (PDF) 128 is a sourcebook produced by Cubicle 7 Entertainment for the Call of Cthulhu roleplaying game. Overview Written by Paul Wade-Williams and running to 128 , Avalon contains a potted history of Somerset - including both mundane and Mythos elements - a travel guide of sorts, a selection of notable characters, and three complete, stand-alone scenarios. Scenarios "Blood and Water" "Strange Little Girl" "St. Swithun's Hole" Publication History was published in 2010 by third-party content provider Cubicle 7 Entertainment as part of their hugely popular Cthulhu Britannica series. Released in both print and digital PDF versions, it is currently out of print.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Paul_Wade-Williams"/>
    <ex:hasPageCountW>128</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2010</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Edward_Stasheff">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Edward Stasheff</rdfs:label>
    <ex:hasAnnotation>Full Name Edward J. Stasheff Connection to the Mythos Editor http://edward.stasheff.com/ is an American IT developer and editor. He has worked on an least two anthologies of Cthulhu Mythos -related fiction, both of which have been issued through independent publisher Pickman's Press . Selected Works Corporate Cthulhu: Lovecraftian Tales of Bureaucratic Nightmare (2018) The Averoigne Legacy: Tribute Tales in the World of Clark Ashton Smith (2019) External Links at The Internet Speculative Fiction Database</ex:hasAnnotation>
    <ex:hasFullNameR>Edward J. Stasheff</ex:hasFullNameR>
    <ex:hasWebsiteR>http://edward.stasheff.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Beyond_Re-Animator">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosFilmAndTelevision"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Beyond Re-Animator</rdfs:label>
    <ex:hasAnnotation>$3 million is a 2003 low- horror film inspired by characters from " herbert west--reanimator " directed by brian yuzna and screen icon jeffrey combs . It is the third instalment in the re-animator series which began in 1985 .</ex:hasAnnotation>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#Herbert_West--Reanimator"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>4 April 2003</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Pulp_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Pulp Cthulhu</rdfs:label>
    <ex:hasAnnotation>Mike Mason et al United States English Call of Cthulhu Chaosium Release Date December 2016 272 is a supplementary sourcebook for Chaosium 's Call of Cthulhu roleplaying game. Written by Mike Mason et al, it runs to a total of 272 , and was published in December 2016. Both hardcover and digital editions were released. Overview Gallery</ex:hasAnnotation>
    <ex:hasAuthorW>Mike Mason et al</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>272</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>December 2016</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Anatomy_Lesson">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Anatomy Lesson</rdfs:label>
    <ex:hasAnnotation>Historywas first published in the anthology the madness of cthulhu: volume two in october 2015 . It was also included in the collection of goodfellow's own works rapture of the deep and other lovecraftian tales .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Cody_Goodfellow"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Madness_of_Cthulhu:_Volume_Two"/>
    <ex:wasPublishedOnW>October 2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Typhonian_Beast">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Typhonian Beast</rdfs:label>
    <ex:hasAnnotation>Sociocultural Characteristics The Dreamlands Real World Information Created by Chaosium Typhonian Beasts are a species of monstrous jackals created by Chaosiumfor their Call of Cthulhu role-playing game. Description The Typhonian Beasts are a species of black-furred jackals that dwell in the Dreamlands . Gallery</ex:hasAnnotation>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Chaosium"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Francis_Morgan">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Francis Morgan</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Miskatonic_University"/>
    <ex:hasAffiliationC>Professor Henry Armitage</ex:hasAffiliationC>
    <ex:hasAffiliationC>Professor Warren Rice</ex:hasAffiliationC>
    <ex:hasAnnotation>Professor is a fictional character created by h. p. lovecraft for his short story " the dunwich horror " . He is a professor of medicine and comparative anatomy (or archaeology) at miskatonic university .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Dunwich_Horror"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dweller_in_the_Tomb">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dweller in the Tomb</rdfs:label>
    <ex:hasAnnotation>The story consists of several entries from the diary of professor harold hadley copeland . He is the last surviving member of his 1913 expedition to find the tomb of the wizard zanthu . The story is part of carter's xothic legend cycle .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Dark_Things"/>
    <ex:wasPublishedOnW>1971</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#H._P._Lovecrafts_The_Call_of_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>H. P. Lovecraft's The Call of Cthulhu</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft's Call of Cthulhu Gou Tanabe Gou Tanabe Japanese Kadokawa Corporation Release Date 2019 Media Type Manga is a manga written and illustrated by Gou Tanabe , which was published by Kadokawa Corporation in 2019. It is an adaptation of " The Call of Cthulhu " by H. P. Lovecraft . Having just finished its monthly run in the Comic Beam manga magazine, it is not yet available in a graphic novel format, nor has it been translated by a in the English-speaking world.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Gou_Tanabe"/>
    <ex:isInLanguageW>Japanese</ex:isInLanguageW>
    <ex:wasReleasedOnW>2019</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Abbith">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Planets"/>
    <rdfs:label>Abbith</rdfs:label>
    <ex:hasAlternativeNamesL>The World of Seven Suns</ex:hasAlternativeNamesL>
    <ex:hasAnnotation>The world of seven suns is a fictional planet that revolves around seven stars beyond xoth . It is inhabited by metallic brains , wise with the ultimate secrets of the universe . A place called cytharion of the seven suns is mentioned by lovecraft in " the crawling chaos " .</ex:hasAnnotation>
    <ex:isInhabitedByL>Metallic Brains</ex:isInhabitedByL>
    <ex:isLocatedAtL>A seven-star system in the vicinity of Xoth</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL>The Horror in the Gallery (named)</ex:madeFirstAppearanceOnL>
    <ex:madeFirstAppearanceOnL>The Whisperer in Darkness (unnamed)</ex:madeFirstAppearanceOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Curse_%281987_film%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleFilmAndTelevisionAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Curse (1987 film)</rdfs:label>
    <ex:hasAnnotation>The curse is a film based on the plot of h.p. Lovecraft 's " the colour out of space " claude akins, cooper huckabee, will wheaton, malcolm daare and amy wheaton star in the film . Lovecraft scholar charles p. mitchell referred to the film as faithful to the author's original work, but claimed that "the last twenty minutes of the film virtually ruin the entire film"</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasWriterW>David Chaskin</ex:hasWriterW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Colour_Out_of_Space"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1987 September 11</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Lurker_at_the_Threshold">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Lurker at the Threshold</rdfs:label>
    <ex:hasAnnotation>"billington's wood" focuses on an english man who reclaims an ancestral property . He learns the disquieting history of his ancestors richard and alijah billington . After a series of mysterious deaths, he disappears, and is said to have been "eat up by what he had call'd out ye sky"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>1945</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Out_of_the_Aeons">
    <rdf:type rdf:resource="http://example.org/lovecraft#AveroigneCycle"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Out of the Aeons</rdfs:label>
    <ex:hasAnnotation>Short story focuses on a museum that displays an ancient mummy recovered from a sunken island . The mummy garners a reputation as a possible link to an ancient tale of k'naa, from the black book by von junzt . The narrator begins to notice more and more suspicious foreigners coming to the museum . Soon, several attempts are made to steal the mummy .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Hazel_Heald"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Howard_Phillips_Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Cthulhu Mythos</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu:_Weirdbook_Annual_2">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu: Weirdbook Annual 2</rdfs:label>
    <ex:hasAnnotation>Various United States English Genre(s) Horror Wildside Press Release Date February 2019 Media Type Print Ebook 148 , also published as The Third Cthulhu Megapack , is an anthology of Lovecraftian works from a variety of different authors. Overview Containing a total of 23 poems and short stories, the Weirdbook Annual 2 was edited by Doug Draa , published by Wildside Press and released in February 2019. The print version was issued as the Cthulhu: Weirdbook Annual #2 , whilst the ebook version was titled the Weirdbook Annual #2: The Third Cthulhu Megapack . Both versions run to 148 , although the stories are presented in differing order. Contents "From the Editor's Tower" introduction by Doug Draa " The Shining Trapezohedron " by Robert M. Price " A Noble Endeavor " by Lucy A. Snyder " Dolmen of the Moon " by Deuce Richardson " Ancient Astronauts " by Cynthia Ward " Lovecraftian Limerick " by Andrew J. Wilson " The Thing in the Pond " by John R. Fultz " Enter the Cobweb Queen " by Adrian Cole " Tricks No Treats " by Paul Dale Anderson " Ronnie and the River " by Christian Riley " Cellar Dweller " by Franklyn Searight " Yellow Labelled VHS Tape " by R. C. Mulhare " Tuama " by L. F. Falconer " Mercy Holds No Measure " by Kenneth Bykerk " Treacherous Memory " by Glynn Owen Barrass " The Hutchison Boy " by Darrell Schweitzer " A Wizard's Daughter " by Ann K. Schwader " The Shadow of Azathoth Is Your Galaxy " by D. B. Spitzer " Ascend " by Mark A. Mihalko " The Solace of the Farther Moon " by Allan Rozinski " The Stars Are Always Right " by Charles Lovecraft " Daemonic Nathicana " by K. A. Opperman " Asenath " by Ashley Dioses " The Book of Eibon/Le Livre D'eibon " by Frederick J. Mayer Gallery</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>148</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>February 2019</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Michael_Sheehan,_Jr.">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Michael Sheehan, Jr.</rdfs:label>
    <ex:hasAnnotation>Michael Sheehan, Jr. Connection to the Mythos Author Horror Michael Sheehan, Jr. is an author who, in collaboration with Mark McLaughlin , has written numerous Cthulhu Mythos works, many of which have been collected in a series of digital anthologies. Selected Bibliography Note: unless otherwise noted, all of the following entries have been collaborative works with Mark McLaughlin. Collections The Abominations of Nephren-Ka &amp; Three More Tales of the Cthulhu Mythos (2015) The Horror In The Water Tower &amp; Five More Tales Of The Cthulhu Mythos (2016) The Blasphemy in the Canopic Jar &amp; More Tales Of The Cthulhu Mythos (2016) Shoggoth Apocalypse &amp; More Tales Of The Cthulhu Mythos (2017) The Creature in the Waxworks: Tales of Weird &amp; Lovecraftian Horror (2017) The Relic In The Egyptian Gallery &amp; More Tales Of The Cthulhu Mythos (2017) The Testament Of Cthulhu: Tales Of Weird Fantasy &amp; Horror (2018) Stainless Steel Sarcophagus: Tales Of Lovecraftian Fantasy &amp; Horror (2018) Horrors &amp; Abominations: 24 Tales of the Cthulhu Mythos (2018) Nightmares &amp; Tentacles: 13 Tales Of The Cthulhu Mythos (2019) The House of the Ocelot &amp; More Lovecraftian Nightmares (2019) City Of Living Shadows &amp; More Lovecraftian Tales (2019) The Prisoner of Carcosa &amp; More Tales Of The Bizarre (2020) Short Fiction " The Ambassador from Ulthar " (2019) " The Prisoner of Carcosa " " Horrors of the Trash Island " " Yuletide Mementos " " Coins From Y'ha-nthlei " " The Power Of Azalareon " " That Tantalizing Taste You Will Never Forget " " The Sea-Spider " " The Lurker From The Kelp Forest " " The Horror in the Water Tower " " The Testament of Cthulhu " " The Gateway to Carcosa " " Casino Carcosa " " Sea-Green Gown With Gold Buttons " " The Nightmare In Delapore Tower " " The Curse Of The Tillinghasts " " The Creature In The Waxworks " " The Abominations Of Nephren-Ka " " The Thing From Beyond The Living Door " " The Colossus In The Catacombs " " The Blasphemy In The Canopic Jar " " This Pulsing Mass That Serves As My Heart " " The Final Door " " Mrs. Dakhamunzu " " The Relic In The Egyptian Gallery " " Deathless Bride Of The Crawling Chaos " " Shoggoth Apocalypse "</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecraft_Criticism:_A_Study">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraft Criticism: A Study</rdfs:label>
    <ex:hasAnnotation>S. T. Joshi United States English Genre(s) Non-fiction Ohio University Press H. P. Lovecraft: Four Decades of Criticism date 1980 " " is a short non-fiction work by leading H. P. Lovecraft scholar S. T. Joshi . Overview Running to only a handful of pages, "" was published in the non-fiction collection H. P. Lovecraft: Four Decades of Criticism by Ohio University Press in 1980.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#S._T._Joshi"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft:_Four_Decades_of_Criticism"/>
    <ex:wasPublishedOnW>1980</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tales_of_Yog-Sothoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#CrossroadPress"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Tales of Yog-Sothoth</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Steve Smith English Crossroad Press Release Date April 2021 326 is a thematic anthology of Lovecraftian fiction edited by American C. T. Phipps . Running to a total of 326 in total, it was published by Macabre Ink in April 2021; paperback, digital, and audiobook editions were all released. It is part of the Books of Cthulhu series. Overview Contents Foreword by C. T. Phipps "The True Name of God" by C. T. Phipps "The Haunter of the Wheel" by David J.West "The Ghost Door" by David Hambling "The Forever Gate" Matthew Davenport "The Dun WHAT? Horror" by David Niall Wilson "The Final Gate" by C. T. Phipps</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>326</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>April 2021</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ian_Davey">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Ian Davey</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Horror Post-apocalypse Notable Works The Bh'Yhlun series is an author who has written a handful of short Cthulhu Mythos stories, including the Bh'Yhlun series of post-apocalyptic horror. These have appeared in publications such as Al-Azif and Urban Cthulhu: Nightmare Cities , and the online Mythos zine Nightscapes . Selected Bibliography " Black Letter Day " (1997) " An Incarceration in Bh'Yhlun " (1997) " Francesci's Cult of the Necronomicon: An Interlude " (1998) " The Epiphany of Dissolution " (1998) " In the Shadow of Bh'Yhlun " (2012) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isKnownForR>The Bh'Yhlun series</ex:isKnownForR>
  </rdf:Description>
