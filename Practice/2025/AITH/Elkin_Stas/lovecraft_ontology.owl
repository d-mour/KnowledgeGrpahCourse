  <rdf:Description rdf:about="http://example.org/lovecraft#H._David_Blalock">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>H. David Blalock</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Editor Author Birth Date 16 September 1953 San Antonio, Texas, USA United States http://www.thrankeep.com/ (born 16 September 1953) is an American author, editor, and occasional screenwriter whose favoured genres are science fiction, fantasy and horror. He has edited a number of Lovecraftian anthologies which have been published through houses such as Hiraeth Publishing and Alban Lake Publishing, and has contributed at least one short story to the Lovecraftian genre. Blalock has cited his primary inspirations as science fiction and horror writers of the early- to mid- 20th century . Selected Works Editor The Mad Visions of al-Hazred (2017) Miskatonic Dreams (unknown year) The Idolaters of Cthulhu (unknown year) Short Fiction "The Shed" (unknown year) External Links at the Internet Speculative Fiction Database at Goodreads at IMDB References</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA San Antonio Texas</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>http://www.thrankeep.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
    <ex:wasBornOnR>16 September 1953</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Indrid_Cold">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Indrid Cold</rdfs:label>
    <ex:hasAnnotation>'s real nature has not been confirmed, but it is heavily implied that he is an extraterrestrial creature from the cthulhu mythos in the disguise of a human . 's appearance has not been confirmed, but it is heavily implied that he is an extraterrestrial creature from the cthulhu mythos in the disguise of a human . Behind the mythos is infamous in conspiracy theory circles for being connected to sightings of unidentified flying objects</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Yoth_Protocols"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#In_the_Depths_of_Rlyeh">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>In the Depths of R'lyeh</rdfs:label>
    <ex:hasAnnotation>The other: encounters with the cthulhu mythos book 3 date 2021 . It constitutes the twentieth and final episode of his nyarlathotep cycle . It is written by canadian troy young .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Troy_Young"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Nyarlathotep_Cycle"/>
