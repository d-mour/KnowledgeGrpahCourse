  <rdf:Description rdf:about="http://example.org/lovecraft#RobertEHowardWorks">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Character"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Unnamable_II:_The_Statement_of_Randolph_Carter">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleFilmAndTelevisionAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Unnamable II: The Statement of Randolph Carter</rdfs:label>
    <ex:hasAnnotation>The statement of randolph carter is a 1992 horror film and the sequel to the 1988 film the unnamable . It is a loose adaptation of the short story " the statement of randolph carter ", although it also incorporates elements from elsewhere in the cthulhu mythos . The film stars mark kinsey stephenson and charles king as randolph carter and howard damon, respectively .</ex:hasAnnotation>
    <ex:hasWriterW>Jean-Paul Ouellette</ex:hasWriterW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Statement_of_Randolph_Carter"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>21 October 1992</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#John_Linwood_Grant">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>John Linwood Grant</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Yorkshire, England, United Kingdom United Kingdom http://greydogtales.com/blog/ http://johnlinwoodgrant.me.uk/blog/ is a British author of fantasy, science fiction and weird fiction who has written a handful of pieces set in the Cthulhu Mythos begun with the works of Howard Phillips Lovecraft . These have been published in anthologies such as N (2021, Stygian Fox ) and The Call of Poohthulhu (2022, April Moon Books ). Selected Bibliography Short Fiction " The Yuggoth Club " (2021) " The Celery at the Threshold " (2022) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#England United Kingdom Yorkshire</ex:hasBirthplaceR>
    <ex:hasNationalityR>United Kingdom</ex:hasNationalityR>
    <ex:hasWebsiteR>http://greydogtales.com/blog/</ex:hasWebsiteR>
    <ex:hasWebsiteR>http://johnlinwoodgrant.me.uk/blog/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#New_Tales_of_the_Miskatonic_Valley:_Further_Adventures_in_Lovecraft_Country">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>New Tales of the Miskatonic Valley: Further Adventures in Lovecraft Country</rdfs:label>
    <ex:hasAnnotation>The latest volume reprints the scenarios from the original new tales of the miskatonic valley . Includes a seventh scenario, "a mother's love," by seth skorkowsky .</ex:hasAnnotation>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#PatHarriganWorks">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Work"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#With_Eyes_That_See">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>With Eyes That See</rdfs:label>
    <ex:hasAnnotation>Megan summers tries to take her own life over a bad breakup . A strange artefact grants her a glimpse of how she might gain a degree of magical power . She uses these abilities to make the people she believes have hurt her pay .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#J._B._Lee"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Nightscapes"/>
    <ex:wasPublishedOnW>August 1999</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#H._P._Lovecraft_and_Lovecraft_Criticism:_An_Annotated_Bibliography">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>H. P. Lovecraft and Lovecraft Criticism: An Annotated Bibliography</rdfs:label>
    <ex:hasAnnotation>Wildside Press cover S. T. Joshi United States English Genre(s) Non-fiction Kent State University Press (first release) Wildside Press (reissue) Release Date April 1980 473 is a non-fiction work by scholar and critic S. T. Joshi . Overview Described as "a definitive annotated bibliography to works by and about H. P. Lovecraft ", runs to a total of 473 and was first published by Kent State University Press in April 1980. A reprint was issued by Wildside Press in July 2007.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#S._T._Joshi"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:hasPageCountW>473</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>April 1980</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nightscapes_January_1998">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Nightscapes January 1998</rdfs:label>
    <ex:hasAnnotation>Various English Edward P. Berglund Release Date January 1998 Preceded by December 1997 Followed by April 1998 is the sixth issue of the long-running online fanzine Nightscapes . It was edited by the late American and scholar Edward P. Berglund . Contents Fiction "Lament" by Walter C. DeBill, Jr. " The Tale of Toad Loop " by Stanley C. Sargent "The Story of Quinton Applewithe" by Forrest Lancaster " The Becoming " by Ron Shiflet " Not One the Same " by J. B. Lee " Catch of the Day " by Andy Nunez "The Snake-God of Shonhi" by James Ambuehl "Small Ghost" by Michael Minnis " The Epiphany of Dissolution " by Ian Davey " Dr. Dexter " by Lew Cabos Non-Fiction "The Outsider" by Aaron Vanek (script) "My Necronomicon" by Aaron Vanek (script) "My Necronomicon" by Aaron Vanek (treatment) Poetry " Folks of Innsmouth: Miss Tilton -- Curator " by Franklyn Searight "Moon Depths" by James Gruetzmacher " Forbidden Knowledge " by Ron Shiflet " Feast of Eihort " by James Gruetzmacher Reviews By Peter A. Worthy and James Ambuehl External Links full issue online at the Nightscapes website</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>January 1998</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#RealWorldPeople">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dorm_Mate_Out_of_Dunwich">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dorm Mate Out of Dunwich</rdfs:label>
    <ex:hasAnnotation>Published in january 2020 in the deadman's tome anthology deep fried horror cthulhu cheese burger . It is a reimagining of h. p. lovecraft 's " the dunwich horror " .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#R._C._Mulhare"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Deep_Fried_Horror_Cthulhu_Cheese_Burger"/>
    <ex:wasPublishedOnW>January 2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Darkest_Part_of_the_Woods">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RamseyCampbellWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Darkest Part of the Woods</rdfs:label>
    <ex:hasAnnotation>Ramsey Campbell English PS Publishing Release Date April 2002 is a 2003 novel by Ramsey Campbell in which he returns to the Severn Valley setting of his first Lovecraft pastiches. It was first published in April 2002 by PS Publishing . Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>April 2002</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#H._P._Lovecrafts_Book_of_Horror">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>H. P. Lovecraft's Book of Horror</rdfs:label>
    <ex:hasAnnotation>Various Dave Carson English Genre(s) Horror Release Date November 1993 , also published under the title The World's Greatest Horror Stories , is an anthology of short horror fiction works which Lovecraft regarded as notable in their field. Edited by Dave Carson and Stephen Jones , it was first published by Barnes &amp; Noble Books in 1993 and featured interior artwork from Carson. Contents " Supernatural Horror in Literature " by H. P. Lovecraft "The Signalman" by Charles Dickens "The House and the Brain" by Edward Bulwer-Lytton "The Body Snatcher" by Robert Louis Stevenson "The Spider" by Hanns Heinz Ewers "The Foot of the Mummy" by Théophile Gautier "The Horla" by Guy de Maupassant "The Fall of the House of Usher" by Edgar Allan Poe "The Damned Thing" by Ambrose Bierce "The Upper Berth" by F. Marion Crawford " The Yellow Sign " by Robert W. Chambers "The Shadows on the Wall" by Mary E. Wilkins Freeman "The Dead Valley" Ralph Adams Cram "Fishhead" by Irvin S. Cobb "Lukundoo" by Edward Lucas White "The Double Shadow" by Clark Ashton Smith "The Mark of the Beast" by Rudyard Kipling " Negotium Perambulans " by E. F. Benson "Mrs. Lunt" by Hugh Walpole " The Hog " by William Hope Hodgson " The Great God Pan " by Arthur Machen " Count Magnus " by M. R. James " Lovecraft and the 'Literature of Cosmic Fear' " by Stephen Jones Gallery</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>November 1993</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Soaked_Shells">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Soaked Shells</rdfs:label>
    <ex:hasAnnotation>Phil McClorey Jeff McComsey English Genre(s) Cthulhu Mythos Arcana Comics Release Date November 2010 " " is a short Cthulhu Mythos comic book story written by Phil McClorey and illustrated by Jeff McComsey. It was published in the Arcana Comics horror anthology Velvet Rope in November 2010. Synopsis When jaded big game hunter John Ford hears of bizarre humanoid creatures inhabiting the Amazon river basin, he sets out to add another trophy to his collection. Upon reaching the home territory of the creatures, he is dragged into the water by an aggressive fishman , where he witnesses the sleeping god Dagon , Lord of the Deep. On his return home, Ford begins to develop gills and bulging eyes , and commits suicide rather than face the physical and mental changes his brief contact with Dagon tells him will soon be inflicted upon him.</ex:hasAnnotation>
    <ex:hasAuthorW>Phil McClorey</ex:hasAuthorW>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>November 2010</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Horror_at_Oakdeene">
    <rdf:type rdf:resource="http://example.org/lovecraft#BrianLumleyWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Horror at Oakdeene</rdfs:label>
    <ex:hasAnnotation>Written in 1970, it first appeared as the title story of lumley's second arkham house collection, and others (1977) it was translated into french as "l'horreur dans l'asile" in l'avant-poste des grands anciens (néo, 1986)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Others</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1977</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>1970</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Cats_of_Ulthar_Card_Game">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Cats of Ulthar Card Game</rdfs:label>
    <ex:hasAnnotation>Based on the short story " the cats of ulthar " by h. p. lovecraft . Designed by trenton payne with artwork supplied by dave youkovich .</ex:hasAnnotation>
    <ex:wasPublishedOnW>2019</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#hasNotableMemberO">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>hasNotableMemberO</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdfs:range rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Alfred_Clarendon">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Alfred Clarendon</rdfs:label>
    <ex:hasAnnotation>Alfred clarendon is a fictional character created by h. p. lovecraft and adolphe de castro . He is a famous physician, "one of the greatest biologists and physicians" of the 1890s . He travels throughout the world to study diseases, including to north africa and china .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Last_Test"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Adolphe_de_Castro"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Khosatral_Khel">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Khosatral Khel</rdfs:label>
    <ex:hasAnnotation>Background was a being that originated from the abyss and darkness, and entered the physical universe . For millennia it traveled across the world as humans ineffectually attacked him . It eventually found the primitives living on the island of dagonia and brought them civilization .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#MythosInspiredAuthors">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nation_of_Disease:_The_Rise_%26_Fall_of_a_Canadian_Legend">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Nation of Disease: The Rise &amp; Fall of a Canadian Legend</rdfs:label>
    <ex:hasAnnotation>The story follows the career of a band as the two main members grow more and more obsessed with the occult . As their mania grows, their behaviour becomes increasingly erratic, culminating in one killing the other in the middle of a particularly deranged concert . Published in the lovecraftian anthology whispers from the abyss in 2013 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Jonathan_Sharp"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Whispers_from_the_Abyss"/>
    <ex:wasPublishedOnW>2013</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kull_the_Conqueror%21_The_Sea_King">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Kull the Conqueror! The Sea King</rdfs:label>
    <ex:hasAnnotation>Charles Dixon Mark Schultz, Val Semeiks Cover Artist Joe Jusko English Marvel Comics Release Date January 1987 Media Type Comic book " " is a story in issue #132 of the first volume of Savage Sword of Conan . Written by Charles Dixon, it was published by Marvel Comics in November 1986 . Synopsis King Kull of Valusia battles a group of Fishmen (one of Marvel's analogues to H. P. Lovecraft 's Deep Ones ) in service to the undead sorcerer Ohris Dehjmal in the Western Ocean. After Kull repels their attacks, the Fishmen renounce their worship of Dehjmal and throw his living head to an enormous sea creature . References</ex:hasAnnotation>
    <ex:hasAuthorW>Charles Dixon</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>January 1987</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ztoggua">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Z'toggua</rdfs:label>
    <ex:hasAnnotation>First appearance " " Created by R. S. Cartwright is a Great Old One worshipped by the Deep Ones . He is described as an obese humanoid bat with a gaping mouth on his belly and is explicitly not Zothaqquah nor Tsathoggua . Trivia is referenced by name in the Thunder Lotus produced game Sundered when the player chooses to corrupt their double jump skill; the double jump is given a new name ('s Wings) and new feature that morphs Eshe (the player character) into a bat-like creature. Gallery</ex:hasAnnotation>
    <ex:wasCreatedByC>R. S. Cartwright</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Matthew_Carpenter">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Matthew Carpenter</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Editor Author Lovecraftian fiction is an editor and occasional author who has produced several works centred on Lovecraftian fiction and the Cthulhu Mythos . His editorial work has been published through the Lovecraft eZine Press and Ulthar Press , while his fiction has been included in the now-defunct fanzine Lovecraft's Disciples . In addition to his book work, Carpenter is also a regular panellist on the Lovecraft eZine Sunday podcast. Selected Works Editor A Lonely and Curious Country (2015) Lovecraftian Tales: Volume 1 (2017) Pickman's Gallery (2018) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Kraken_%28poem%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Kraken (poem)</rdfs:label>
    <ex:hasAnnotation>"the kraken" is a poem by alfred lord tennyson . It has been cited as a major influence on h. p. lovecraft 's story "the call of cthulhu" the kraken was a giant sea creature that was believed to live off the coast of norway .</ex:hasAnnotation>
    <ex:hasAuthorW>Alfred Lord Tennyson</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>Great Britain</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Chiefly Lyrical</ex:isPublishedAsW>
    <ex:isPublishedAsW>Poems</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1830</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Illithid">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Illithid</rdfs:label>
    <ex:hasAnnotation>The illithids (aka mind flayers) are an aberrant race from the fictional universe of the d&amp;d pencil-and-paper roleplaying game . They are cephalopod humanoids with two arms, two legs, and a bulbous head with a hideous mouth surrounded by fourth tentacles . They feed on brains, using the tentacles which rips out the victim's brain .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Black_Recalled">
    <rdf:type rdf:resource="http://example.org/lovecraft#BrianLumleyWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Black Recalled</rdfs:label>
    <ex:hasAnnotation>" name and number " is a cthulhu mythos story by brian lumley . The story is a sequel to lumley's " the caller of the black " (1971) the story is set eight years after the destruction of blowne house .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Titus_Crow"/>
    <ex:isPublishedAsW>World Fantasy Convention 1983: Sixty Years of Weird Tales</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1983</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#hasAppearanceA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>hasAppearanceA</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdfs:range rdf:resource="http://example.org/lovecraft#Location"/>
    <rdfs:range rdf:resource="http://example.org/lovecraft#Work"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dreaming_in_Rlyeh_Issue_3">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dreaming in R'lyeh Issue 3</rdfs:label>
    <ex:hasAnnotation>Various English C. Brut Release Date January 2005 Preceded by Dreaming in R'lyeh Issue 2 was the third and final issue of short-lived Lovecraftian fanzine Dreaming in R'lyeh . Edited by C. Brut, it was independently published in January 2005. Contents "The Daguerreian" by Christopher Kugler "Omne Anima Triste Post Coitum" Cass Baron "Dark Heresy" by Christopher Cevasco "Impossible Object" by David Conyers "The Locked Door" by Brian M. Sammons "Selling a Toe" by R. Blanca "Only the Bones Remain" by Thomas Mavroudis</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>January 2005</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Entity_%28Yu-Gi-Oh%21%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Crossovers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Entity (Yu-Gi-Oh!)</rdfs:label>
    <ex:hasAnnotation>Entity is an extra deck series, released for the japanese trading card game yu-gi-oh! The monsters in this series are based on entities from the cthulhu mythos . The goal of this deck is to summon outer entity azathot .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Aleister_Crowley">
    <rdf:type rdf:resource="http://example.org/lovecraft#AlterEgosCharactersIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPeople"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Aleister Crowley</rdfs:label>
    <ex:diedOnR>1 December 1947</ex:diedOnR>
    <ex:hasAnnotation>Edward alexander crowley was an english author, occultist, artist, and practicing magician . He is perhaps best known for the proliferation of works he produced in the esotericism and occult literature genres . He was for a time a member of the hermetic order of the golden dawn, the organisation which was the (loose) inspiration for the order of the silver twilight .</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#England Royal Leamington Spa Warwickshire</ex:hasBirthplaceR>
    <ex:hasFullNameR>Edward Alexander Crowley</ex:hasFullNameR>
    <ex:hasNationalityR>English</ex:hasNationalityR>
    <ex:wasBornOnR>12 October 1875</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lam">
    <rdf:type rdf:resource="http://example.org/lovecraft#Avatars"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdfs:label>Lam</rdfs:label>
    <ex:hasAlternativeNamesC>The Grey</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as the magical revival created by kenneth grant is an alien entity, similar to grey aliens, dwelling in the dark side of the planet mars . It is an extraterrestrial intelligence which the occultist aleister crowley came into contact with in 1919 . He is said by some to be the lama of</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Magical Revival</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Kenneth_Grant"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#isRealPersonMateOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>isRealPersonMateOf</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:range rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <owl:inverseOf rdf:resource="http://example.org/lovecraft#hasRealPersonMateR"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cassandra_Hack">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Cassandra Hack</rdfs:label>
    <ex:hasAnnotation>Cassie hack is a horror victim whose mother was a serial killer . She later returned as a "slasher", an undead serial killer . She would end up battling the army of darkness, side by side with ash williams .</ex:hasAnnotation>
    <ex:hasAppearanceC>Army of Darkness Vs. Hack</ex:hasAppearanceC>
    <ex:hasAppearanceC>Slash</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC>Hack</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>Slash: Euthanized</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Tim Seeley</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Echoes_in_Porcelain">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Echoes in Porcelain</rdfs:label>
    <ex:hasAnnotation>Konstantine paradias's short story was first featured on the bizarrocast podcast in september 2013 . It was included in the lovecraftian anthology whispers from the abyss vol. 2: the horrors that are &amp; shall be in october 2015 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Konstantine_Paradias"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Bizarrocast episode 33</ex:isPublishedAsW>
    <ex:wasPublishedOnW>September 2013</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Claus_Schmidt">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Claus Schmidt</rdfs:label>
    <ex:hasAnnotation>Professor is one of the main characters from the novella ire of the void written by richard lee byers . Schmidt was a rising star in the field of theoretical physics in his native germany, and had been a protégé of albert einstein at one point in his career . He looked into inexplicable disappearances worldwide, and found that one of the largest concentrations of these was in the town of arkham . Schmidt was befriended by an elderly lecturer in astronomy from miskat</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Ire_of_the_Void"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Richard_Lee_Byers"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Harley_Warren">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Harley Warren</rdfs:label>
    <ex:ceasedOnC>Early 20th century</ex:ceasedOnC>
    <ex:hasAnnotation>Early 20th century Early 20th century Human First appearance HPL : " The Statement of Randolph Carter " HPL : " The Silver Key " (unnamed) " Through the Gates of the Silver Key " Created by H. P. Lovecraft is a major character in the Dream Cycle series, he's a friend of Randolph Carter . He was a fictional counterpart of H. P. Lovecraft 's real life close friend Samuel Loveman . He was mentioned several times in the Dream Cycle series, but it was revealed that he in " The Statement of Randolph Carter ". He is also made reference to in " The Silver Key ". In " Through the Gates of the Silver Key ", by Lovecraft and E. Hoffman Price, he is called "the South Carolina mystic whose studies in the primal Naacal language of the Himalayan priests had led to such outrageous conclusions".</ex:hasAnnotation>
    <ex:hasAppearanceC>The Silver Key Through the Gates of the Silver Key</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Statement_of_Randolph_Carter"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Sea,_Like_Broken_Glass">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Sea, Like Broken Glass</rdfs:label>
    <ex:hasAnnotation>Silvia Moreno-Garcia English Genre(s) Weird fiction 01Publishing Whispers from the Abyss date November 2014  " ", alternatively titled " The Sea, Like Glass Unbroken " is a Lovecraftian short story by Mexican-Canadian Silvia Moreno-Garcia . Synopsis A young woman in a coastal village has been promised as bride to an unspecified entity from beneath the waves. However, when she is seemingly rejected in favour of another, she takes her own life in an attempt to see her inhuman love one last time. History "" was published in the anthology of H. P. Lovecraft -inspired fiction Whispers from the Abyss by 01Publishing in November 2014. Trivia Despite containing no direct references to Lovecraft's work or the greater Cthulhu Mythos , the description of the small town and it’s inhabitants, and the vague references to an oceanic entity recall the titular setting for The Shadow Over Innsmouth .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Silvia_Moreno-Garcia"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Whispers_from_the_Abyss"/>
    <ex:wasPublishedOnW>November 2014</ex:wasPublishedOnW>
  </rdf:Description>
