    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Other:_Encounters_with_the_Cthulhu_Mythos_Book_3"/>
    <ex:wasPublishedOnW>2021</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Henry_Armitage">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Henry Armitage</rdfs:label>
    <ex:ceasedOnC>Uncertain possibly either 1939 or 1946</ex:ceasedOnC>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Miskatonic_University"/>
    <ex:hasAnnotation>Armitage was the head librarian at miskatonic university who retired around 1936 due to failing health . He became interested in the occult in 1882 after hearing of a strange meteorite that fell near arkham . In one account, he was killed in 1939 by a fire in the library when he tried to save miskatonic's rare book collection .</ex:hasAnnotation>
    <ex:hasAppearanceC>The Terror from the Depths The Horror in the Gallery Feeders from Within The House of Azathoth Changing of the Guard</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Dunwich_Horror"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Samuel_Nightingale">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Samuel Nightingale</rdfs:label>
    <ex:ceasedOnC>November 1926</ex:ceasedOnC>
    <ex:hasAffiliationC>The Silver Twilight Lodge</ex:hasAffiliationC>
    <ex:hasAnnotation>Nightingale is a character who appeared in the 2013 novel feeders from within . It was his first and only appearance, having during the story’s finale . He worked for businessman/bootlegger phillip avery as his second-in-command and enforcer .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Feeders_from_Within"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Peter_J._Evans"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lucy_A._Snyder">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Lucy A. Snyder</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Birth Date 1971 Charleston, South Carolina, USA United States https://www.lucysnyder.com/  is an American author and editor who works in a wide variety of genres, including science fiction, horror, humour, fantasy and non-fiction. Selected Bibliography Short Fiction " The Gentleman Caller " (2017) " A Noble Endeavor " (2018)</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Charleston South Carolina</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://www.lucysnyder.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1971</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Elenor_Gaskin">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Elenor Gaskin</rdfs:label>
    <ex:diedOnR>13 October 1890</ex:diedOnR>
    <ex:hasAnnotation>Wife of John Full Lovecraft, whom she married on 8 June 1833. She gave birth to six children: Rhoda Ellen, Joshua John, Sidney Joseph, William, Josephine Ann, and Silas.</ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1806</ex:wasBornOnR>
  </rdf:Description>
