    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Creative works such as literary pieces, articles, games, comics, and other media.</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#isAuthorOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>isAuthorOf</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
