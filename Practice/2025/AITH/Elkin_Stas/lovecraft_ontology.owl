    <ex:hasAnnotation>E. A. Adkins United States English Genre(s) Non-fiction SSR Publications Howard Phillips Lovecraft: Memoirs, Critiques &amp; Bibliographies date 1955 " " is a very short non-fiction piece by E. A. Adkins. History Howard Phillips Lovecraft: Memoirs, Critiques &amp; Bibliographies (1955) Commentaries (1955)</ex:hasAnnotation>
    <ex:hasAuthorW>E. A. Adkins</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Bibliographies</ex:isPublishedAsW>
    <ex:isPublishedAsW>Critiques</ex:isPublishedAsW>
    <ex:isPublishedAsW>Howard Phillips Lovecraft: Memoirs</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1955</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ooze">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Ooze</rdfs:label>
    <ex:hasAnnotation>Historywas the first story in the debut issue of weird tales , march 1923 . It has since been reprinted in several publications, including more than one weird tales anthology .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Anthony_M._Rud"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
