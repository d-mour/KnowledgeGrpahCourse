    <ex:isPublishedAsW>Fire</ex:isPublishedAsW>
    <ex:isPublishedAsW>Water</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Graeae">
    <rdf:type rdf:resource="http://example.org/lovecraft#Avatars"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Graeae</rdfs:label>
    <ex:hasAffiliationC>Olympians (Greek Gods)</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Grey Ones of Hellas</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Grey Sisters</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Phorcides</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as phorcides, grey sisters, grey ones of hellas . The are granddaughters of the elder god set .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Frank_Pabodie">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Frank Pabodie</rdfs:label>
    <ex:hasAnnotation>Frank h. pabodie is a fictional character created by h. p. lovecraft . He makes his first appearance in the 1936 novel at the mountains of madness . He is a member of miskatonic university's engineering department .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#At_the_Mountains_of_Madness"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Black_Noon">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Black Noon</rdfs:label>
    <ex:hasAnnotation>"exit into eternity: tales of the bizarre and supernatural" is an unfinished novella by the late american c.m. Eddy, jr. the novella was based on the real-life search for the legendary location known as the dark swamp . The story features eddy's fictional town of fenham which is also used in some of his other stories .</ex:hasAnnotation>
    <ex:hasAuthorW>C. M. Eddy. Jr.</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Exit into Eternity: Tales of the Bizarre</ex:isPublishedAsW>
    <ex:isPublishedAsW>Supernatural</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1973</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Tomb_and_Other_Tales">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Tomb and Other Tales</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft English (original) Portuguese Release Date 1969 is a collection of short fiction by the late American Howard Phillips Lovecraft . First published by Panther in 1969, it has since been reissued several times with a variety of different covers, and has also been translated into Portuguese . Overview Contents " The Tomb " " The Festival " " Imprisoned with the Pharaohs " " He " " The Horror at Red Hook " " The Strange High House in the Mist " " In the Walls of Eryx " " The Evil Clergyman " " The Beast in the Cave " " The Alchemist " " Poetry and the Gods " with Anna Helen Crofts " The Street " " The Transition of Juan Romero " " Azathoth " " The Descendant " " The Book " " The Thing in the Moonlight " with Jack Chapman Miske Complete Chronology Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>Portuguese</ex:isInLanguageW>
    <ex:wasReleasedOnW>1969</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Island_Of_Doctor_Munroe">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Island Of Doctor Munroe</rdfs:label>
    <ex:hasAnnotation>"carnacki: " is a short story by british-born william meikle . It is part of the carnacki established by william hope hodgson . The premise of the story is that of ancient malevolence lurking just out of sight of humanity .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Carnacki</ex:isPartOfSeriesW>
    <ex:isPublishedAsW>Steampunk Cthulhu</ex:isPublishedAsW>
    <ex:wasPublishedOnW>June 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Spawn_of_Tindalos">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Spawn of Tindalos</rdfs:label>
    <ex:hasAnnotation>Full story online here James Gruetzmacher Ron Shiflet English Edward P. Berglund Nightscapes December 1997 date December 1997 " " is a Cthulhu Mythos poem by authors James Gruetzmacher and Ron Shiflet . It was published in the long-running online fanzine Nightscapes in December 1997 . Synopsis The seven four-line verses describe how two people use rare narcotics to open a gateway between dimensions. There, they witness the coming forth of a group of horrific abominations, and are driven insane as a result of what they have witnessed.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#James_Gruetzmacher"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Nightscapes_December_1997"/>
    <ex:wasPublishedOnW>December 1997</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ammi_Pierce">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Ammi Pierce</rdfs:label>
    <ex:hasAnnotation>Farmer Human First appearance HPL : " The Colour Out of Space " Created by H. P. Lovecraft is one of the main characters in the H. P. Lovecraft short story " The Colour Out of Space ", where he functions as the primary storyteller. Overview Although described by the locals as crazy by the time the narrator visits him, is in fact a seemingly well-adjusted man, although he has clearly suffered some degree of mental scarring from his experiences with the Gardners. At the time of the narrator's visit, he is looking forward to the completion of the reservoir which will cover up the blasted heath left by the coming of the meteorite, although he swears that he will never drink from Arkham 's new water supply.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Colour_Out_of_Space"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Winifred_V._Jackson">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsCoAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Winifred V. Jackson</rdfs:label>
    <ex:diedOnR>1959</ex:diedOnR>
    <ex:hasAnnotation>Horace wheeler jordan (divorced 1924) was a collaborator with lovecraft on the short stories " the green meadow " and " the crawling chaos " she was romantically involved with the african-american poet and critic william stanley braithwaite .</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#Maine</ex:hasBirthplaceR>
    <ex:hasFullNameR>http://example.org/lovecraft#Winifred_Virginia_Jackson</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasPseudonymR>Elizabeth Berkley</ex:hasPseudonymR>
    <ex:wasBornOnR>1876</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Song_of_Yste">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Song of Yste</rdfs:label>
    <ex:hasAnnotation>Original unknown Translation(s) Greek Latin Arabic Real World Information First appearance CIRCLE : " The Abyss " Created by Robert A. W. Lowndes The is a book described as being of "pre-glacial" origin. A bloodline of occultists named the Dirkas - who claimed to be able to trace their ancestry to a similar time as the - translated it "from its legendary form into the three great languages of the dawn cultures, then into the Greek, Latin, Arabic and finally, Elizabethan English". Known Contents The contains information and an anecdote on the Adumbrali , a dangerous and seemingly malevolent extra-dimensional species. Quotes Behind the Mythos The was created by Robert A. Lowndes for his short story " The Abyss " and later expanded upon by Lin Carter and Laurence J. Cornford . It was used again in " The Mantle of Graag " by Frederik Pohl, Dirk Wylie, and Lowndes himself.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_Abyss"/>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#Robert_A._W._Lowndes"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nightjar">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Nightjar</rdfs:label>
    <ex:hasAnnotation>Dean Wirth English Rogue Planet Press Lovecraftiana Vol 5, Issue 4 date 2021  " " is a short Lovecraftian story by Dean Wirth first published in Vol 5, Issue 4 of the Lovecraftiana zine in 2021. Synopsis Told through a series of letter and newspaper articles, the story tells of how a serial killer in the 1800s stumbles across a book, The Book of Soul Carriers, Transference and Invasives , and uses it to cheat death, inhabiting various bodies across the centuries while continuing his gruesome work. At an execution in 1957, when he attempts to vacate his borrowed body, a flock of ethereal nightjars mob the execution party and prevent him from leaving. Despite this, the final letter tells of how the killer's discorporated soul has found a new home, and now plans to go about his business as usual. Trivia One of the letters mentions how the book was actually one in a series of nine, hinting at the possibility that more evil souls may roam the ether in search of victims.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Dean_Wirth"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 4</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 5</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2021</ex:wasPublishedOnW>
  </rdf:Description>
