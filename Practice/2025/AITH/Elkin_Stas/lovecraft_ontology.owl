    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Picnic at the Mountains of Madness</rdfs:label>
    <ex:hasAnnotation>40 is a children’s picture book written by neil baker and illustrated by maya sugihara . It was published by april moon books in 2015, both physical and digital editions receiving a release .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Neil_Baker"/>
    <ex:hasPageCountW>40</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>September 2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Rhode_Island_on_Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Rhode Island on Lovecraft</rdfs:label>
    <ex:hasAnnotation>Various Betty Wells Halladay United States English Genre(s) Non-fiction Grant-Hadley Release Date 1945 (first edition) 1946 (second edition) 26 is a short collection of scholarly work regarding the late American Howard Phillips Lovecraft . Edited by Donald M. Grant and Thomas P. Hadley, who published it under the label Grant-Hadley in 1945, it ran to just 26 and featured interior artwork by Betty Wells Halladay. A second edition was issued in 1946. Contents Foreword by Donald M. Grant and Thomas P. Hadley " Lovecraft as a Poet " by Winfield Townley Scott " Lovecraft and Benefit Street " by Dorothy C. Walter " Howard Phillips Lovecraft " by Mrs. Clifford Eddy " Miscellaneous Impressions of H.P.L. " by Marian F. Barner " A Glimpse of H. P. L. " by Mary V. Dana Gallery</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:hasPageCountW>26</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1945 1946</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecraft_and_the_Cosmic_Quality_in_Fiction">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraft and the Cosmic Quality in Fiction</rdfs:label>
    <ex:hasAnnotation>Richard L. Tierney United States English Genre(s) Non-fiction The Diversifier #14 date May 1976 " " is a short non-fiction piece by the late American and scholar Richard L. Tierney . Overview First published in The Diversifier #14 in May 1976, "" was also included in the S. T. Joshi -edited anthology H. P. Lovecraft: Four Decades of Criticism in 1980 and 1981.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Richard_L._Tierney"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>The Diversifier #14</ex:isPublishedAsW>
    <ex:wasPublishedOnW>May 1976</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Katha-Hem">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Katha-Hem</rdfs:label>
    <ex:ceasedOnC>21st Century</ex:ceasedOnC>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Ogdru_Jahad"/>
    <ex:hasAlternativeNamesC>Unknown</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>History was the third ogdru hem to be released on the earth . He was summoned by the black flame out of the ether and began to rampage across the midwestern united states .</ex:hasAnnotation>
    <ex:hasAppearanceC>B.P.R.D.: The Black Flame</ex:hasAppearanceC>
    <ex:hasCharacterMateC>None</ex:hasCharacterMateC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Mike_Mignola"/>
  </rdf:Description>
