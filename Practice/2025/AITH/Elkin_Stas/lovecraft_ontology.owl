    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Murderer of Thomas Fell</rdfs:label>
    <ex:hasAnnotation>Will Hindmarch Jérôme Huguenin Cover Artist Jérôme Huguenin English Trail of Cthulhu Genre(s) Roleplaying game Pelgrane Press Release Date 2008 28 is a scenario supplement for the Trail of Cthulhu horror roleplaying game. Written by Will Hindmarch and featuring artwork from Jérôme Huguenin, it was published by Pelgrane Press in 2008 as part of the "Free RPG Day" initiative . Overview References</ex:hasAnnotation>
    <ex:hasAuthorW>Will Hindmarch</ex:hasAuthorW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
