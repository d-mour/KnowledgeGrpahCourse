  <rdf:Description rdf:about="http://example.org/lovecraft#In_Ulthar">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>In Ulthar</rdfs:label>
    <ex:hasAnnotation>Full story online here Alan Peschke English Edward P. Berglund Nightscapes September 1997 date September 1997 " " is a Cthulhu Mythos poem by Alan Peschke . It was published in the September 1997 edition of Edward P. Berglund 's online fanzine Nightscapes . Synopsis The twenty-two lines describe in brief the extra-dimensional city of Ulthar , and it’s fabled denizens, the cats who must not be harmed.</ex:hasAnnotation>
    <ex:hasAuthorW>Alan Peschke</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Nightscapes_September_1997"/>
    <ex:wasPublishedOnW>September 1997</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Michael_Fisher">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
