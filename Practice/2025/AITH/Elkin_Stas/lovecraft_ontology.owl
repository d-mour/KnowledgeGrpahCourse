    <ex:wasPublishedOnW>1949</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>November 1918</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Matthew_Sanderson">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Matthew Sanderson</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Games designer Podcaster United Kingdom Flub is a British roleplaying games designer and podcaster whose works tend to have a heavy focus on Lovecraftian horror . He has been involved with a number of works for Chaosium 's Call of Cthulhu franchise, Pelgrane Press 's Trail of Cthulhu , and White Wolf Publishing's World of Darkness setting. Sanderson is also one of the founders of BlasphemousTomes.com, a podcast focusing on Lovecraftian fiction in general and the Call of Cthulhu roleplaying game in particular. The podcast also offers a biannual fanzine for Patreons, with each issue featuring a full-length, licensed, scenario for Call of Cthulhu . Selected Works Gaming Supplements Mythos Expeditions (2014, scenario contributor) Pulp Cthulhu (2016, contributor) The Two-Headed Serpent (2017) The Grand Grimoire of Cthulhu Mythos Magic (2017, with Mike Mason ) Fear's Sharp Little Needles (2017, scenario contributor) Dead Light &amp; Other Dark Turns (2020, scenario contributor) Keeper Tips (2021, contributor) External Links at RPGGeek BlasphemousTomes website</ex:hasAnnotation>
    <ex:hasNationalityR>United Kingdom</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Games designer</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Podcaster</ex:isConnectedToMythosR>
  </rdf:Description>
