    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Helen_V._Sully">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Helen V. Sully</rdfs:label>
    <ex:diedOnR>1997</ex:diedOnR>
    <ex:hasAnnotation>Friend of Clark Ashton Smith who visited Lovecraft in Providence in 1933, then saw Donald Wandrei and others in New York.</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1904</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Feast_of_Death">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Feast of Death</rdfs:label>
    <ex:hasAnnotation>A group of british prisoners of war are transferred from turkish hands to a german labour camp in the taurus mountains . There the camp commandant, an accomplished occultist, is using the detainees as slave labour to dig his way into a hillside . But the entity awakens before the commandant is ready, and only a single survivor escapes the ensuing carnage .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lee_Clark_Zumpe"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>War</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>August 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Danger_Girl">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdfs:label>Danger Girl</rdfs:label>
    <ex:hasAnnotation>J. scott campbell was established by deuce who was convinced to come out of retirement to establish the world's first all-female espionage network . The organization consists of female agents whose skills, talents, and achievements are those of super spies like james bond and adventures like indiana jones .</ex:hasAnnotation>
    <ex:hasNotableMemberO>Abbey Chase</ex:hasNotableMemberO>
    <ex:hasNotableMemberO>Sonya Savage</ex:hasNotableMemberO>
    <ex:hasNotableMemberO>Sydney Savage</ex:hasNotableMemberO>
    <ex:hasTypeO>secret organization</ex:hasTypeO>
    <ex:wasCreatedBynO>Andy Hartnell</ex:wasCreatedBynO>
    <ex:wasCreatedBynO>J. Scott Campbell</ex:wasCreatedBynO>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#For_the_Greater_Good_%28Call_of_Cthulhu_LCG%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>For the Greater Good (Call of Cthulhu LCG)</rdfs:label>
    <ex:hasAnnotation>For the greater good is a deluxe expansion for fantasy flight games' call of cthulhu: the card game . It focuses on one particular faction (in this case the agency) with the majority of cards being specific to that faction . Also included are the usual handful of new cards for the other factions and non-specific cards usable by any faction . It contains a total of 165 cards, 55 unique cards in duplicate sets of three .</ex:hasAnnotation>
    <ex:wasPublishedOnW>2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Anna_Helen_Crofts">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsCoAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Anna Helen Crofts</rdfs:label>
    <ex:diedOnR>1975 13 April</ex:diedOnR>
    <ex:hasAnnotation>Joseph b. mccuan (22 december 1889 - 13 april 1975) was a writer, poet and teacher . She is best known for her collaboration with h. p. lovecraft on " poetry and the gods " there was false speculation for a time that crofts may have been a pseudonym for winifred v. jackson .</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#Massachusetts North Adams</ex:hasBirthplaceR>
    <ex:hasFullNameR>Anastasia Helen Crofts McCuan</ex:hasFullNameR>
    <ex:hasNationalityR>American</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Collaborated with Lovecraft</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1889 22 December</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bouda">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SpeciesIncorporatedFromFolkloreMythAndReligion"/>
    <rdfs:label>Bouda</rdfs:label>
    <ex:hasAlternativeNamesC>Boda</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The are race of shapeshifters who at will are able to change from human forms to hyenas . In their beast form, they look exactly like hyenas, except larger and heavier . Have worked for a number of deities, but are aligned and loyal to none .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Cthulhu_Invictus"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sarah_Saltiel">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Sarah Saltiel</rdfs:label>
    <ex:hasAnnotation>Sarah "sam" saltiel is a non-binary american artist, author and games designer originally from new york city . Their gaming credits include a handful of works for the pelgrane press yellow mythos roleplaying game the yellow king .</ex:hasAnnotation>
    <ex:hasBirthplaceR>New York USA http://example.org/lovecraft#New_York_City</ex:hasBirthplaceR>
    <ex:hasFullNameR>Sarah Sam Saltiel</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://www.sarahsamsaltiel.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Games designer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Child_of_Tsathoggua">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ServitorRaces"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Child of Tsathoggua</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Tsathoggua"/>
    <ex:hasAlternativeNamesC>Scion of Tsathoggua</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The children of tsathoggua are a race of extraterrestrial toad-things . They were brought to earth by their creator, tsathoggua . They live in the temples and caverns where their creator is worshiped . Some of them were worshipped by early man .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Thing_on_the_Roof"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#J._Todd_Kingrea"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Errol_Undercliffe">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Errol Undercliffe</rdfs:label>
    <ex:ceasedOnC>Unknown presumed to be 1967</ex:ceasedOnC>
    <ex:hasAnnotation>Undercliffe disappeared in 1967 after looking into the death of roland franklyn . Campbell created the character for his 1973 short story " the franklyn paragraphs "</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Franklyn_Paragraphs"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Evil_Dead_2:_Cradle_of_the_Damned">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Evil Dead 2: Cradle of the Damned</rdfs:label>
    <ex:hasAnnotation>Frank Hannah Chris Summers English Space Goat Publications Release Date Jan 2016 - April 2016 Media Type Comic book Cradle of the Damned is a 3-issue mini-series, written by Frank Hannah and illustrated by Chris Summers, and set in the world of Sam Raimi 's Evil Dead franchise. It was published in 2016 by Space Goat Publications. Synopsis After escaping Hell and battling demons for months, Annie and simulacrum Ash are pulled into the Mirror Dimension , home of the banished Dark Ones .</ex:hasAnnotation>
    <ex:hasAuthorW>Frank Hannah</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>Jan 2016 - April 2016</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Gateways_to_Terror">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Gateways to Terror</rdfs:label>
    <ex:hasAnnotation>Three evenings of nightmare is an introductory scenario book for chaosium 's 7th edition of their horror roleplaying game call of cthulhu . It contains a trio of stand-alone adventures - each of which come complete with four pre-generated character and all necessary handouts .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Leigh_Carr"/>
    <ex:hasAuthorW>Jon Hook</ex:hasAuthorW>
    <ex:hasAuthorW>Todd Gardiner</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>88</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2020</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Joachim_Feery">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Joachim Feery</rdfs:label>
    <ex:ceasedOnC>1934</ex:ceasedOnC>
    <ex:hasAnnotation>Feery is a fictional scholar of the occult, created by brian lumley . He appears as the author of limited-edition commentaries on books of eldritch knowledge . Lumley's occultists find feery to be a valuable resource .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#An_Item_of_Supporting_Evidence"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Child_of_the_Sphinx">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ServitorRaces"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Child of the Sphinx</rdfs:label>
    <ex:hasAnnotation>The children of the sphinx are a fictional race created by chaosium for its call of cthulhu rpg . They were based on lovecraft's " imprisoned with the pharaohs " they come in a variety of forms, human-animal composites with an animal head on a human body .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Imprisoned_with_the_Pharaohs"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Harry_Houdini"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Howard_Phillips_Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Oorn_%28Mad_Moon_of_Dreams%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Oorn (Mad Moon of Dreams)</rdfs:label>
    <ex:hasAnnotation>Oorn is a creature created by british author brian lumley for his 1987 cthulhu mythos novel mad moon of dreams . It is described as a huge tentacled mollusc-like being with appendages which are capable of spraying digestive acids . It is worshipped by both the men of leng and the moon-beasts .</ex:hasAnnotation>
    <ex:hasCharacterMateC rdf:resource="http://example.org/lovecraft#Mnomquah"/>
    <ex:madeFirstAppearanceOnC>Mad Moon of Dreams</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Taran-Ish">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Taran-Ish</rdfs:label>
    <ex:hasAffiliationC>Lobon Tamash Zo-Kalar</ex:hasAffiliationC>
    <ex:hasAnnotation>Lobon tamash was a high priest of the city of sarnath in the land of mnar . Created by h. p. lovecraft was a high priest of the city of sarnath .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Doom_That_Came_to_Sarnath"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yoo-Hoo,_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Yoo-Hoo, Cthulhu</rdfs:label>
    <ex:hasAnnotation>Jeffrey Thomas English 2 AM Publications 2 AM Winter 1989 date December 1989 " " is a humorous Cthulhu Mythos poem by American Jeffrey Thomas . It was first published in the December 1989 edition of the Gretta M. Anderson-edited zine 2 AM . Synopsis In twenty-six lines the narrator describes the lengths he would go to when trying to avoid a telephone call from the Great Old One Cthulhu . History Since its first appearance in 2 AM, "" has also been included in the 2005 collection of Thomas's own works Unholy Dimensions .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Jeffrey_Thomas"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>2 AM Winter 1989</ex:isPublishedAsW>
    <ex:wasPublishedOnW>December 1989</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Vessel">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Vessel</rdfs:label>
    <ex:hasAnnotation>The dark rites of cthulhu is a short story by british author, sam stone . It was first published in the collection of his own work, cthulhu and other monsters, by telos publishing in april 2017 .</ex:hasAnnotation>
    <ex:hasAuthorW>Sam Stone</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Dark_Rites_of_Cthulhu"/>
    <ex:wasPublishedOnW>March 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Uchi_no_Meido_ha_Futeikei">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Uchi no Meido ha Futeikei</rdfs:label>
    <ex:hasAnnotation>My maid is a formless entity is a light novel series, published by the php institute . First volume was released in 2010; second volume was released in 2013 . Plot involves a boy receiving a new maid, who is a shoggoth named tekeli .</ex:hasAnnotation>
    <ex:hasAuthorW>Tassou Shizukawa</ex:hasAuthorW>
    <ex:isInLanguageW>Japanese</ex:isInLanguageW>
    <ex:wasReleasedOnW>June 2010 (Volume 1) May 2013 (Volume 2)</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yamata_no_Orochi">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Yamata no Orochi</rdfs:label>
    <ex:hasAlternativeNamesC>Eight-Forked Serpent of Koshi</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Orochi</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Damballah is a titanic dragon/serpent of japanese mythology . First mentioned as having existed in the fictional marvel universe . Has not yet appeared in any comic book so far .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Scarlet_Citadel">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Scarlet Citadel</rdfs:label>
    <ex:hasAnnotation>Roy Thomas Frank Brunner English Marvel Comics Release Date June 1978 Media Type Comic book is a story in issue #30 of the 1st volume of the Savage Sword of Conan , an adaptation of Robert E. Howard 's story of the same name. Synopsis King Conan of Aquilonia finds himself in the citadel of Pelias a sorcerer in Koth where among the dangers he faces Satha the Old One .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Roy_Thomas"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>June 1978</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mr._Arkham">
    <rdf:type rdf:resource="http://example.org/lovecraft#Avatars"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Mr. Arkham</rdfs:label>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#Nyarlathotep"/>
    <ex:hasAnnotation>Also known as nyarlathotep boarding house proprietor made his debut appearance in the very first issue in march 2007 . Created by american comic book creator michael alan nelson for the boom! Studios mythos series fall of cthulhu .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Fall_of_Cthulhu_Volume_1:_The_Fugue"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Michael_Alan_Nelson"/>
  </rdf:Description>
