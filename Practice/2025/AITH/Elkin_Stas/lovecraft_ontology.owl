    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>To Clear the Earth</rdfs:label>
    <ex:hasAnnotation>Will murray's "furnace of yeb" first appeared in the 1996 anthology . It's a story about a secret government organization . It's a sequel/prequel to "black fire," which was published in 1995 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Will_Murray"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
