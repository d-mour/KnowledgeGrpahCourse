    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>November 2003</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#On_H._P._Lovecrafts_Views_of_Weird_Fiction">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>On H. P. Lovecraft's Views of Weird Fiction</rdfs:label>
    <ex:hasAnnotation>Robert A. W. Lowndes English Cryptic Publications Crypt of Cthulhu Candlemas 1989 date February 1989 " " is a short non-fiction piece by the late American and friend of H. P. Lovecraft , Robert A. W. Lowndes . It was published in the Candlemas 1989 issue of Robert M. Price 's long-running fanzine Crypt of Cthulhu in February of that year.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_A._W._Lowndes"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu_Candlemas_1989"/>
    <ex:wasPublishedOnW>February 1989</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Sealed_Casket">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Sealed Casket</rdfs:label>
    <ex:hasAnnotation>Wesson clark inherits a relic called the coffer of alû-tor from his friend, martucci . He locks himself in his study and opens the seal, only to find a draft of cold air . The invisible being's tentacles coil around his body, intensifying the smell . The story is notable for introducing the eltdown shards, although they are only mentioned in the opening quote, which the original omitted altogether .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Richard_F._Searight"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>March 1935</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Lovecraft_eZine_Presents_Making_the_Cut">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Lovecraft eZine Presents Making the Cut</rdfs:label>
    <ex:hasAnnotation>Various Various Cover Artist Mike Dominic English Release Date March 2012 74 is a collection of nine Lovecraftian short stories, all of which were first published in The Lovecraft eZine and received an honourable mention in Ellen Datlow 's The Best Horror of the Year Volume 5 . It was edited by Mike Davis and released in Marsh 2014. Overview Contents Preface by Mike Davis Introduction by Rick Lai "The Dead of Winter" by Jay Caselberg "A Thousand Smokes" by W. H. Pugmire "Drive, She Said" by Tracie McBride "The Strange Case of Crazy Joe Gallo" by Jeffrey Thomas "In the House of the Hummingbirds" by Silvia Moreno-Garcia "Wind Walker" by Neil John Buchanan "A Catechism for Aspiring Amnesiacs" by Nicole Cushing " Eliza " by Joshua Reynolds "Tark Left Santiago" by Joseph S. Pulver, Sr.</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>74</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>March 2012</ex:wasReleasedOnW>
  </rdf:Description>
