    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Delta Green: Need to Know</rdfs:label>
    <ex:hasAnnotation>Shane Ivey Bret Kramer United States English Delta Green: The Role-Playing Game Genre(s) Roleplaying game Arc Dream Publishing Release Date 27 April 2016 53 was the first release for Arc Dream Publishing 's stand-alone roleplaying game Delta Green: The Role-Playing Game . Overview Written by Shane Ivey and Bret Kramer and running to 53 , was published by Arc Dream Publishing on 27 April 2016 in digital format and 1 August the same year in print. It contains a set of basic rules, six pre-generated agents and a short scenario to allow a quick start to games of Delta Green .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Bret_Kramer"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Shane_Ivey"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
