    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu? Gesundheit!</rdfs:label>
    <ex:hasAnnotation>"cthulhu? Gesundheit!" Is the third story featured in issue #19 of the simpsons' treehouse of horror series by bongo comics . The story begins with principal skinner punishing bart and his friend milhouse by forcing them to catalogue all the books in the school's abandoned old library .</ex:hasAnnotation>
    <ex:hasAuthorW>Len Wein</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
