    <rdfs:label>Tick Tock</rdfs:label>
    <ex:hasAnnotation>Return of the old ones: apocalyptic lovecraftian horror was published in 2017 . 'history' is a short story by prolific american author don webb .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Don_Webb"/>
