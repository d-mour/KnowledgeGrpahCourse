    <rdfs:label>The Colour that Came to Chiswick</rdfs:label>
    <ex:hasAnnotation>Gaslight arcanum: uncanny tales of sherlock holmes was published in 2011 . Contains no explicit references to the works of h.p. Lovecraft or the greater cthulhu mythos .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
