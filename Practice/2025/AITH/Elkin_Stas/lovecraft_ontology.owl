    <ex:hasAffiliationC>Great Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Karakal  Karakal of Flames</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as karakal or karakal of flames ? A great one dwelling on kadath , may possibly be the same being as karakal or karakal of flames .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Mike_Minnis"/>
