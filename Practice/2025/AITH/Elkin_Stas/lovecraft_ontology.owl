  <rdf:Description rdf:about="http://example.org/lovecraft#Shubra_Cabra">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Pastiches"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Shubra Cabra</rdfs:label>
    <ex:hasAnnotation>is a short story by Dennis E. Power in which the supernatural anti-hero El Head battles Shub-Niggurath and a posse of supernatural carnivorous black goats with glowing yellow eyes. It is available to read online here . Behind the Mythos is a deliberately confused version of the Mythos entity Shub-Niggurath , and El Head is itself a pastiche character on the edge of the Wold Newton shared universe, in which "crossovers" between for example pulp heroes or Sherlock Holmes and elements of other stories, in this case Lovecraft works, are a common staple. These stories are pastiche, in that they do not attempt to do more than emulate the original format or tone of stories from the original authors, and sometimes in their effort to do so the works verge on parody, intentional or not.</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Extraordinary_Lineage_of_Ethan_McKay">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Extraordinary Lineage of Ethan McKay</rdfs:label>
    <ex:hasAnnotation>The story was published in the anthology deep fried horror cthulhu cheese burger . It is a short lovecraftian story by english author james carlson .</ex:hasAnnotation>
    <ex:hasAuthorW>James Carlson</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Deep_Fried_Horror_Cthulhu_Cheese_Burger"/>
    <ex:wasPublishedOnW>January 2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Pabodie_Expedition">
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisations"/>
    <rdfs:label>Pabodie Expedition</rdfs:label>
    <ex:hasAffiliationO rdf:resource="http://example.org/lovecraft#Miskatonic_University"/>
    <ex:hasAffiliationO>The Nathaniel Derby Pickman Foundation</ex:hasAffiliationO>
    <ex:hasAnnotation>The was a fictional scientific survey mission to antarctica, undertaken in 1930-31 . Primary objective was to research the continent's geological history . Also expected to discover fossil evidence of antarctica's previous inhabitants .</ex:hasAnnotation>
    <ex:hasPurposeO>Geological Survey</ex:hasPurposeO>
    <ex:wasCreatedBynO rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
