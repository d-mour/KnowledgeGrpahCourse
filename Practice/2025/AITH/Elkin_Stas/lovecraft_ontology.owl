  <rdf:Description rdf:about="http://example.org/lovecraft#The_Parkland_Experiments">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Parkland Experiments</rdfs:label>
    <ex:hasAnnotation>Inmates at the parkland correctional facility become unwilling test subjects of the crazed doctor . As the procedures progress, the subjects find themselves increasingly obsessed with a very specific rhythm . The inmates involuntarily enact a ritual involving the beats but something goes wrong, and barnard is transformed into something grotesque and inhuman .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Shadows_of_an_Inner_Darkness"/>
    <ex:wasPublishedOnW>2019</ex:wasPublishedOnW>
  </rdf:Description>
