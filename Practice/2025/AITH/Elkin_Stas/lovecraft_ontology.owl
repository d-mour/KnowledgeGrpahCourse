    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Allan Rozinski</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Horror  is a poet who has written a number of works in the horror . Selected Bibliography Poems " The Solace of the Farther Moon " (2019)</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
