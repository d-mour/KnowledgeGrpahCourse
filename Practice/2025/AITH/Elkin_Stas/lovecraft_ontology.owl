  <rdf:Description rdf:about="http://example.org/lovecraft#Mark_Schorer">
    <rdf:type rdf:resource="http://example.org/lovecraft#Critics"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Scholars"/>
    <rdfs:label>Mark Schorer</rdfs:label>
    <ex:diedOnR>11 August 1977</ex:diedOnR>
    <ex:hasAnnotation>Connection to the Mythos Author Birth Date 17 May 1908 Sauk City, Wisconsin, USA Death Date 11 August 1977 Oakland, California, USA United States 𝐓 (17 May 1908-11 August 1977) was an American author, critic and scholar. A lifelong friend of Lovecraft 's contemporary and literary champion August Derleth , the two wrote several stories together, including a handful set in the greater Cthulhu Mythos . Their collaborations were published in magazines such as Weird Tales and Strange Stories , and collected in the Arkham House book Colonel Markesan and Less Pleasant People in 1966. Selected Bibliography " The Lair of the Star-Spawn " (1932 with August Derleth ) " Spawn of the Maelstrom " (1939, with August Derleth) " The Horror from the Depths " (1940, with August Derleth)</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Wisconsin Sauk City</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>17 May 1908</ex:wasBornOnR>
  </rdf:Description>
