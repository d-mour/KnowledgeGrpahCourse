    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>De Horrore Cosmico</rdfs:label>
    <ex:hasAnnotation>166 is a scenario supplement book for chaosium 's call of cthulhu roleplaying game . It contains six stand-alone adventures set in the cthulhu invictus time period of the game . Each scenario is based upon a different story by howard phillips lovecraft .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
