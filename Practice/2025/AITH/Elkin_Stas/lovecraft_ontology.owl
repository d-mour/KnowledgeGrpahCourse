    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Raising Up</rdfs:label>
    <ex:hasAnnotation>48 is a scenario supplement for chaosium 's call of cthulhu roleplaying game . It contains a complete campaign in five short scenarios, and contains the maps necessary to run each .</ex:hasAnnotation>
    <ex:hasAuthorW>Dr. Michael C. LaBossiere</ex:hasAuthorW>
