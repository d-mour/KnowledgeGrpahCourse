    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lurking Fears</rdfs:label>
    <ex:hasAnnotation>Scott David Aniolowski Michael Szymanski Cover Artist Rodell D. Sanford, Jr. English Call of Cthulhu Genre(s) Roleplaying game Triad Entertainments Release Date 1990 is a third-party scenario supplement for Chaosium 's Call of Cthulhu horror roleplaying game. Written by Scott David Aniolowski and Michael Szymanski , it was published by Triad Entertainments in 1990. Artwork was supplied by Rodell D. Sanford, Jr. Overview References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Michael_Szymanski"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Scott_David_Aniolowski"/>
