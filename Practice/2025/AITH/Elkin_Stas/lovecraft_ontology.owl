    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Titus_Crow"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Magna_Mater">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Magna Mater</rdfs:label>
    <ex:hasAnnotation>Edward Morris United States English Genre(s) Horror Dark Regions Press World War Cthulhu date August 2014 " " is a short story by American Edward Morris . Synopsis The story of a dark priestess making sacrifice to Tsathoggua . History "" was published in the Dark Regions Press anthology World War Cthulhu in 2014.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Edward_Morris"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#World_War_Cthulhu"/>
    <ex:wasPublishedOnW>August 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Collect_Call_of_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Collect Call of Cthulhu</rdfs:label>
    <ex:hasAnnotation>Full story online here Keith Allen Daniels English Edward P. Berglund Nightscapes July 1998 date July 1998 " " is a humorous Cthulhu Mythos poem by American and editor Keith Allen Daniels. It was published in the Edward P. Berglund -edited online fanzine Nightscapes in July 1998 . Synopsis The two five-line verses describe how one night a man and his wife receive a telephone call from the Great Old One Cthulhu , telling them that come the morning he will arise and destroy the Earth.</ex:hasAnnotation>
    <ex:hasAuthorW>Keith Allen Daniels</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Nightscapes_July_1998"/>
    <ex:wasPublishedOnW>July 1998</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bothon">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Bothon</rdfs:label>
    <ex:hasAnnotation>The bruise is a short story by h. s. whitehead written in 1930 . It was first published in the august 1946 issue of amazing stories . Some sources regard it as a collaboration between whitehead and h. p. lovecraft .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Henry_S._Whitehead"/>
    <ex:hasCountryOfOriginW>USA</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Science fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Amazing_Stories"/>
    <ex:wasPublishedOnW>1946</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>1930</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecraftiana_Vol_6,_Issue_3">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Periodicals"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraftiana Vol 6, Issue 3</rdfs:label>
    <ex:hasAnnotation>Various Mike T. Lyddon Cover Artist Mike T. Lyddon English Rogue Planet Press Release Date October 2021 134 is an issue of the Rogue Planet Press periodical Lovecraftiana . Edited by Gavin Chappell , it was published in October 2021 and featured cover and interior art by Mike T. Lyddon. Both print and digital editions were released. Contents "Our Little Earth Babe" by Benjamin DeHaan "A World of Silence" by Steven J. Alvarez "Black Veins" by Carlton Herzog "The Good Prince of Yron" by Gary Budgen "Heart of the Highlands" by Will Shadbolt "The Show Must Go On" by Scott Arbuckle "Mushrooms from Ceres" by Harris Coverley "Fond Regards––N" by J. L. Royce "The Hidden Door" by Brittany Groves "Hours with the Dead" by Lee Clark Zumpe "Bus Ride Into Dreamlands" by Danny Nicholas "The Matter of Traphiam" by Chris Sebastian "Treasure Hunt" by Greg Fewer " Sinbad and the Great Old Ones (Part Three) " by Gavin Chappell</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>134</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>October 2021</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Unnamable_%28creature%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>The Unnamable (creature)</rdfs:label>
    <ex:hasAnnotation>The unnamable thing attacked randolph carter and joel manton in a graveyard in the 1920s . Carter didn't catch sight of the entity, and could only describe it as being of "titanic size but undetermined nature" while the origin of the monster is not known, carter is aware of local legends dating back to the 17th century, when cotton mather documented the birth of a monstrous child .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Unnamable</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#John_Raymond_Legrasse">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>John Raymond Legrasse</rdfs:label>
    <ex:hasAnnotation>Inspector is a fictional character created by the late american author h. p. lovecraft for his 1928 short story " the call of cthulhu " inspector is the new orleans police inspector who led the raid on a band of bayou savages on november 1, 1907 . He later approached professor angell and the american archaeological society for help in identifying the cult .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Call_of_Cthulhu"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#In_the_Moons_of_Borea">
    <rdf:type rdf:resource="http://example.org/lovecraft#BrianLumleyWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>In the Moons of Borea</rdfs:label>
    <ex:hasAnnotation>Titus crow is a cthulhu mythos novel by brian lumley . It is the fifth in a series of books by the author . First published in 1979 by jove publishing .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Action Adventure</ex:hasGenreW>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Titus_Crow"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shabbith-Ka">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OuterGods"/>
    <rdfs:label>Shabbith-Ka</rdfs:label>
    <ex:hasAnnotation>First appearance Malleus Monstrorum Created by Jeff Moeller is an Outer God . ( EXP : " What Goes Around, Just Comes Around ", ; Malleus Monstrorum )</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Malleus_Monstrorum"/>
    <ex:wasCreatedByC>Jeff Moeller</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dog_Handlers_Tale">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dog Handler's Tale</rdfs:label>
    <ex:hasAnnotation>The madness of cthulhu: volume 1 is a bittersweet short story by canadian donald tyson . It was published in the s. t. joshi -edited anthology the madness of cthulhu: volume 1 by titan books in october 2014 . Told as the written account of one of the work team on the ill-fated pabodie expedition to the antarctic .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Donald_Tyson"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>The Madness of Cthulhu: Volume 1</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ernest_A_Edkins">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Ernest A Edkins</rdfs:label>
    <ex:diedOnR>1946</ex:diedOnR>
    <ex:hasAnnotation>Longtime amateur journalist with whom Lovecraft began corresponding in 1932. Lovecraft persuaded him to rejoin the amateur journalism movement, and Edkins subsequently edited several issues of the journal Causerie.</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1867</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Basalt_Pillars_of_the_West">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Basalt Pillars of the West</rdfs:label>
    <ex:hasAnnotation>Pillars of gargantuan size made of basalt that rise from the ocean in the dreamlands . The pillars form the gate of a monstrous cataract whose waters spill over the edge . The pillars are shrouded in mist so that none may see beyond them .</ex:hasAnnotation>
    <ex:hasAppearanceL rdf:resource="http://example.org/lovecraft#The_Dream-Quest_of_Unknown_Kadath"/>
    <ex:hasTypeL>Gate</ex:hasTypeL>
    <ex:isLocatedAtL>The Dreamlands</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_White_Ship"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Fall_of_Cthulhu_Volume_4:_Godwar">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Fall of Cthulhu Volume 4: Godwar</rdfs:label>
    <ex:hasAnnotation>Godwar is a limited-run instalment of fall of cthulhu . Written by michael alan nelson and featuring artwork by mat santolouco . Individual issues were published between july and october 2008 . The omnibus collection was released in april 2009 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Michael_Alan_Nelson"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>98</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Fall_of_Cthulhu"/>
    <ex:wasReleasedOnW>April 2009</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Reanimated_corpse">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Reanimated corpse</rdfs:label>
    <ex:hasAnnotation>Reanimated corpses are featured throughout various stories in the cthulhu mythos . Some are biological experiments, such as the work of herbert west . Others such as the so-named " the thing on the doorstep " seem to be by-products of both magic and will .</ex:hasAnnotation>
    <ex:hasAppearanceC>Herbert West--Reanimator In the Vault The Thing on the Doorstep The Case of Charles Dexter Ward The Return of the Sorcerer The Lady in Gray The Horror from the Bridge The Kiss of Bugg-Shash The Tale of the Reanimator</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Yellow_Sign"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Wee_Weird:_The_Call_of_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Storybooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Wee Weird: The Call of Cthulhu</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft (original story) Two Literate Blackbirds (adaptation) Two Literate Blackbirds English Genre(s) Children's CreateSpace Independent Publishing Platform Release Date March 11, 2017 32 is a children's book, independently published using CreateSpace in 2017. It was written and illustrated by "Two Literate Blackbirds", as an adaptation of H. P. Lovecraft 's " The Call of Cthulhu ". Overview</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasAuthorW>Two Literate Blackbirds</ex:hasAuthorW>
    <ex:hasGenreW>Children's</ex:hasGenreW>
    <ex:hasPageCountW>32</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2017 March 11</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Avengers">
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OrganisationsOriginatingFromMythosAdjacentWorks"/>
    <rdfs:label>Avengers</rdfs:label>
    <ex:hasAnnotation>The are a fictional team of superheroes in the mainstream prime reality of the marvel universe by marvel comics . They are a team that has had a long history of conflict with a demonic entity known as the 'old one'</ex:hasAnnotation>
    <ex:hasNotableMemberO>Captain America</ex:hasNotableMemberO>
    <ex:hasNotableMemberO>Iron Man</ex:hasNotableMemberO>
    <ex:hasNotableMemberO>Thor</ex:hasNotableMemberO>
    <ex:hasTypeO>team</ex:hasTypeO>
    <ex:wasCreatedBynO>Jack Kirby</ex:wasCreatedBynO>
    <ex:wasCreatedBynO>Stan Lee</ex:wasCreatedBynO>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#HashtagDreaming">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>HashtagDreaming</rdfs:label>
    <ex:hasAnnotation>William Meikle English Genre(s) Weird fiction Home From The Sea: Tales of Lovecraftian Terror date April 2017 " ", stylised as " #Dreaming " is a short Cthulhu Mythos story by British William Meikle . Synopsis The user @greatcthulhu grows in popularity on the social media platform Twitter. The more attention it receives, the more those who follow it feel the urge to promote its message, and are gifted with dreams of a god who sleeps beneath the waves. As it’s popularity increases, so the time to the gods' awakening begins to count down… Characters Darren , a regular internet user. History "#Dreaming" was published in the collection of Meikle's own works Home From the Sea: Tales of Lovecraftian Terror in April 2017.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Home_From_The_Sea:_Tales_of_Lovecraftian_Terror"/>
    <ex:wasPublishedOnW>April 2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Reeling_Back">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Reeling Back</rdfs:label>
    <ex:hasAnnotation>" bonanzathose folk below" is a short story by american and games designer tom lynch . It forms a part of the arkham detective agency created by c.j. Henderson .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Tom_Lynch"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Arkham_Detective_Agency"/>
    <ex:wasPublishedOnW>November 2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Disciples_of_Deaths_Shadow">
    <rdf:type rdf:resource="http://example.org/lovecraft#Cults"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdfs:label>Disciples of Death's Shadow</rdfs:label>
    <ex:hasAffiliationO rdf:resource="http://example.org/lovecraft#Blood_Brigade"/>
    <ex:hasAffiliationO rdf:resource="http://example.org/lovecraft#Nyarlathotep"/>
    <ex:hasAnnotation>The disciples of death's shadows is an organization which is secretly devoted to the outer god nyarlathotep . Its members believe they are fighting a religious war against the infidels, citing the various entities and monsters as "angels of god"</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Haemophore">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonSapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Haemophore</rdfs:label>
    <ex:hasAnnotation>Haemophores are a fictional species created by chaosium for the role-playing game call of cthulhu . They are small toad-like creatures with rotund bodies, webbed hands and feet, a w-shaped mouth concealing needle-like teeth . Haemophores feed exclusively on blood, gorging themselves until they're so bloated that they cannot walk anymore .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#H._P._Lovecrafts_Dreamlands"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Jason_Ciaramella">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Jason Ciaramella</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author United States Comic book Childrens is an American comic book writer who has also penned a number of children's books. The most relevant of his output as far as this wiki is concerned are a series of educational books designed for very young children. Selected Works C is for Cthulhu (2016) Sweet Dreams Cthulhu (2017) Counting, Colors and Cthulhu (2021) The Night Before Christmas (2022)</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nightscapes_September_1998">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Nightscapes September 1998</rdfs:label>
    <ex:hasAnnotation>This is the ninth issue of the long-running but sporadically released online fanzine nightscapes . It was edited by the late american and lovecraft scholar edward p. berglund . This issue included artwork of nyarlathotep and shudde-m'ell by stanley c. sargent and james a. gruetzmacher .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>September 1998</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Wentworths_Day">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Wentworth's Day</rdfs:label>
    <ex:hasAnnotation>The story is narrated by a salesman delivering stoves in the country north of dunwich . He is forced to take refuge in the home of amos stark, which is all of a piece . Stark made out a will that left his whole estate to genie wentworth, his daughter .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Survivor"/>
    <ex:isPartOfSeriesW>Others</ex:isPartOfSeriesW>
    <ex:isPublishedAsW>1957</ex:isPublishedAsW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Zarr_%28planet%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Planets"/>
    <rdfs:label>Zarr (planet)</rdfs:label>
    <ex:hasAnnotation>Zarr Xentilx galaxy Planetary body Zathog The Zarr First appearance EXP : The Winds of Zarr Created by Richard L. Tierney Zarr is a planet created by the late American author Richard L. Tierney for his novel The Winds of Zarr . Overview An ancient planet in the Xentilx galaxy, a body of stars adjacent to our own, Zarr is home to the warlike Zarr , a technologically-advanced species who sit at the centre of a galaxy-spanning empire and serve the malevolent Zathog . At the centre of the planet Zathog makes his lair, a Great Old One who fled there after the war with the Elder Gods . It has since struck a pact with the Zarr, and gifts them with the power to travel through space and time in exchange for their aid against its ancient enemies.</ex:hasAnnotation>
    <ex:hasTypeL>Planetary body</ex:hasTypeL>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#Zathog"/>
    <ex:isInhabitedByL>The Zarr</ex:isInhabitedByL>
    <ex:isLocatedAtL>Xentilx galaxy</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL>The Winds of Zarr</ex:madeFirstAppearanceOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Alfred_Galpin">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsCoAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsCorrespondents"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Alfred Galpin</rdfs:label>
    <ex:diedOnR>5 March 1983</ex:diedOnR>
    <ex:hasAnnotation>Galpin was born in appleton, wisconsin, in 1901 and died in montecatini . He was a writer, academic and musical composer . He was a long-time friend and correspondent of h. p. lovecraft .</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Appleton Wisconsin</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Friend</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>correspondent of H. P. Lovecraft</ex:isConnectedToMythosR>
    <ex:wasBornOnR>8 November 1901</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Elder_Sign_%28Innsmouth%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MysticalArtefacts"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Elder Sign (Innsmouth)</rdfs:label>
    <ex:hasAnnotation>Innsmouth's elder sign is the first existing version of the arcane symbol . Function zadok allen is the only character to give a description of it .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Shining_Trapezohedron_%28Robert_M._Price%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Shining Trapezohedron (Robert M. Price)</rdfs:label>
    <ex:hasAnnotation>"the shining trapezohedron" is a short story by and editor robert m. price . Inspired by h.p. Lovecraft 's short story " the haunter of the dark " a small-town preacher from massachusetts wins a place in a miskatonic university archaeological expedition to egypt . Once there, he is lured into the desert where he encounters the black pharaoh, and becomes a herald of nyarlathotep .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Lovecrafts_Disciples"/>
    <ex:wasPublishedOnW>October 2018</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Trunembra">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OuterGods"/>
    <rdfs:label>Tru'nembra</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Azathoth"/>
    <ex:hasAlternativeNamesC>The Angel of Music</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Flautist of Azathoth</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The flautist of azathoth is an outer god who resides eternally in the court of azathoth . He is made entirely out of visible noise and is seemingly unintelligent, just like his master . When summoned, it brings along the maddening symphony it uses to keep its master asleep, bringing insanity to those unfortunate enough to hear its blaring chaos .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Music_of_Erich_Zann"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#hasSonR">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>hasSonR</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:range rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <owl:inverseOf rdf:resource="http://example.org/lovecraft#hasParent"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mike_Minnis">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Mike Minnis</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Artist Horror is an author who has contributed several short fiction pieces to the ever-expanding Cthulhu Mythos based on the works of H. P. Lovecraft . He has also provided a small number of cover art pieces for various related publications. Selected Work Fiction " Knuckerhole " (1997) " The Prodigies of Monkfield Cabot " (1997) " I Walk the World's Black Rim " (1997) " Small Ghost " (1998) " The Butcher of Vyones " (1998) " Maastricht Chalk " (1998) " Hear the Squidman Speak " (1998) " Innsmouth Wood " (2000) " Revelations in a Public Restroom " (2000) " The Tallow Works " (2000) " The Girl Who Walked in Circles " (2001) " Salt Air " (2002) " A Funeral for Mr. Mittens " (2002) Artwork Al-Azif (1998)</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Artist</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tales_of_Cthulhu_Invictus:_Britannia">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Tales of Cthulhu Invictus: Britannia</rdfs:label>
    <ex:hasAnnotation>Various English Golden Goblin Press Release Date 2020 is a Cthulhu Mythos anthology edited by Brian M. Sammons and Oscar Rios and published by Golden Goblin Press in 2020. It is a tie-in collection for Chaosium 's Cthulhu Invictus line of historical Call of Cthulhu supplements, for which Golden Goblin produce licensed content. Overview Contents "Green Water" by Andi Newton "The Hounds of the Dawn" by William Meikle "Matched Pairs" by Josh Reynolds "The Ruins at Raven’s Rock" by Glynn Owen Barrass "Knockers Down Below" by Konstantine Paradias "The Isle of The White Lady" by Edward M. Erdelac "A Layer of Ash" by Oscar Rios "The Island of the Gathoga" by Pete Rawlik "Mothers of Flesh and Fire" by John Linwood Grant "Bill of Goods" by William Adcock "Their Vulgar Pedigree" by Lee Clark Zumpe "Blood of the Woods" by Morgan Llewellyn "Wrath of the Kelpie" by Francesca McMahon Gallery</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2020</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Whispers_from_the_Abyss_Vol._2:_The_Horrors_That_Are_%26_Shall_Be">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Whispers from the Abyss Vol. 2: The Horrors That Are &amp; Shall Be</rdfs:label>
    <ex:hasAnnotation>Whispers from the abyss vol. 2 is an anthology of weird fiction inspired by the works of howard phillips lovecraft . Edited by kat rocha, it was first published as an ebook in october 2015 . In march of the following year, it received a paperback release .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>October 2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Howard_Phillips_Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Howard Phillips Lovecraft</rdfs:label>
    <ex:diedOnR>16 April 1877</ex:diedOnR>
    <ex:hasAnnotation>The only child of Winfield Scott Lovecraft and Sarah Susan Phillips, Howard was born, raised in, and died in Providence, Rhode Island. “I Am Providence” is carved on his tombstone.</ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1806</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Gurla-ya">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Gur'la-ya</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Lurker in Doom-laden Shadows</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as Lurker in Doom-laden Shadows Great Old Ones First appearance EXP : " The Skull of Gur-la'ya " Created by Jerry Baker , Lurker in Doom-laden Shadows , is a great humanoid shadow-thing with two red glowing eyes able to transform its victims skulls into green glowing stones carved with odd symbols. Gallery</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Skull of Gur-la'ya</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Jerry Baker</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthaat">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Cthaat</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Dark Water God</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Dark Water God Great Old Ones First appearance EXP : " The Plague of St. James Infirmary " Created by Ken Asamatsu , The Dark Water God , is a formless Elemental mass of shape-shifting water.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Plague_of_St._James_Infirmary"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Ken_Asamatsu"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Everett_McNeil">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Everett McNeil</rdfs:label>
    <ex:diedOnR>1929</ex:diedOnR>
    <ex:hasAnnotation>Prolific author of historical and adventure novels for boys; member of the Kalem Club.</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1862</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cybil">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Cybil</rdfs:label>
    <ex:hasAnnotation>The character was created in 2009 by mike raicht . First appeared in issue #22 of the 2nd volume of army of darkness by dynamite .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Army of Darkness Vol 2 22</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Mike Raicht</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Death_Watch">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Death Watch</rdfs:label>
    <ex:hasAnnotation>Weird tales is a short story by the late american author hugh b. cave . It is about a man whose wife is devastated by the loss of her brother . He creates a radio set to plead with the dark gods of the cosmos .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Hugh_B._Cave"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>June 1939</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#7th_Edition_Cthulhu_Invictus_Screen">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>7th Edition Cthulhu Invictus Screen</rdfs:label>
    <ex:hasAnnotation>The Golden Goblin Press Roleplaying game Call of Cthulhu The is a gaming aid for Chaosium 's Call of Cthulhu Mythos roleplaying game. Overview Behind the Mythos The is published by licensed third-party content provider Golden Goblin Press . It measures 25.5" x 11" when fully extended. Trivia Although the Mythos entities portrayed in the first three art panels are hard to identify, the final image appears to show The King in Yellow . Gallery</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dungeons_%26_Dragons">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dungeons &amp; Dragons</rdfs:label>
    <ex:hasAnnotation>Fantasy roleplaying is a tabletop fantasy roleplaying game co-created by gary gygax and dave arneson in 1974 . The brand is now owned by wizards of the coast, a division of hasbro . The central trope of the game occurs in a surprising number of lovecraft stories .</ex:hasAnnotation>
    <ex:wasPublishedOnW>1974</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Andrew_Peregrine">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Andrew Peregrine</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Games designer Author Roleplaying games Horror is a games designer and occasional author who has produced a number of works related to H. P. Lovecraft 's Cthulhu Mythos . His fictional output has appeared in anthologies such as Apotheosis: Stories of Human Survival After the Rise of the Elder Gods (2015, Simian Publishing), while his gaming credits include work on the Judge Dredd , Doctor Who , and My Little Pony roleplaying games, as well as Chaosium 's Call of Cthulhu line. Selected Bibliography Short Fiction " The Smiling People " (2015) Gaming Supplements Regency Cthulhu (2015, with Lynne Hardy ) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Games designer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Gyaa-Hua">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Gyaa-Hua</rdfs:label>
    <ex:hasAlternativeNamesC>Gyaa-Hau</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The are ape-like creatures noted for their remarkable strength . Created by h.p. Lovecraft and h.s. Whitehead for their short story " bothon "</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Red_Offering"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Bothon"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Henry_S._Whitehead"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Isaac_C._Hill">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Isaac C. Hill</rdfs:label>
    <ex:diedOnR>1932</ex:diedOnR>
    <ex:hasAnnotation>Lovecraft’s paternal uncle and husband of Emily Jane Lovecraft. He was principal of the Pelham (New York) High School.</ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1849</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Arc_Dream_Publishing">
    <rdf:type rdf:resource="http://example.org/lovecraft#Publishers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Arc Dream Publishing</rdfs:label>
    <ex:hasAnnotation>2002 Dennis Detwiller Shane Ivey United States Chelsea, Alabama Distribution Method Cubicle 7 Entertainment https://arcdream.com/home/ is an American small press publisher which produces a number of Lovecraftian publications, including gaming materials, periodicals, and anthologies. Overview by Dennis Detwiller and Shane Ivey in 2002, Arc Dream is primarily focused on the release of roleplaying game-related material, including works such as the magazine The Unspeakable Oath , along with Delta Green -related fiction. Their distribution is currently handled by Cubicle 7 Entertainment . Selected Publications Periodicals The Unspeakable Oath Fiction Tales from Failed Anatomies (2014) Delta Green: The Way it Went Down (2018, Dennis Detwiller ) Games Delta Green (2016) Delta Green (1997) Other The Cthulhu Mythos Encyclopedia (2008, 2018) External Links at the Internet Speculative Fiction Database</ex:hasAnnotation>
    <ex:hasWebsiteR>https://arcdream.com/home/</ex:hasWebsiteR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Seekers_of_Knowledge_%28Call_of_Cthulhu_LCG%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Seekers of Knowledge (Call of Cthulhu LCG)</rdfs:label>
    <ex:hasAnnotation>Seekers of knowledge is a deluxe expansion for fantasy flight games' call of cthulhu: the card game . Released in 2011 and containing 165 cards (55 sets of three duplicates) majority of the cards in seekers of knowledge relate to the miskatonic university faction .</ex:hasAnnotation>
    <ex:wasPublishedOnW>2011</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecraft:_Disturbing_the_Universe">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraft: Disturbing the Universe</rdfs:label>
    <ex:hasAnnotation>Donald R. Burleson English Genre(s) Non-fiction University Press of Kentucky Release Date 1990 is a non-fiction book by scholar Donald R. Burleson , first published in October 1990 by the University Press of Kentucky, who reissued it in November 2009 and May 2021. Contents Pre-lude: The Manner of Reading "The Statement of Randolph Carter" "The Terrible Old Man” "The Cats of Ulthar" "The Nameless City" "The Outsider" "The Music of Erich Zann" "The Call of Cthulhu" "Pickman’s Model" "The Strange High House in the Mist" "The Colour Out of Space" "The Dunwich Horror" "The Shadow over Innsmouth" "The Haunter of the Dark" Deconstructing Lovecraft: An Open "Conclusion" Bibliography Index</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Donald_R._Burleson"/>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1990</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Al-Azif_%28fanzine%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Al-Azif (fanzine)</rdfs:label>
    <ex:hasAnnotation>Al-azif was a short-lived cthulhu mythos -focused periodical . Edited by peter a. worthy who also provided the interior illustrations . Published by yhtill press for a total of four issues between january and december 1998 .</ex:hasAnnotation>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
