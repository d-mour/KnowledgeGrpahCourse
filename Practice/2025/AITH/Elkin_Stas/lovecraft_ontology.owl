    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Children of Cthulhu</rdfs:label>
    <ex:hasAnnotation>: chilling new tales inspired by h. p. lovecraft is an anthology of horror stories . Edited by benjamin adams and john pelan, it was published by delray/ballantine in 2002 . The cover image is by dave mckean, a british illustrator best known for the covers of neil gaiman's sandman comic book .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Benjamin_Adams"/>
