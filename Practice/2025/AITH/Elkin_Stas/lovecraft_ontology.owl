  <rdf:Description rdf:about="http://example.org/lovecraft#Sho-Gath">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Sho-Gath</rdfs:label>
    <ex:hasAlternativeNamesC>The God in the Box The Big Black Thing</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The God in the Box The Big Black Thing First appearance The God-Box Created by August Derleth is a cosmic entity created by August Derleth in his 1945 short story " The God-Box ". It is depicted as a dark smoky column, with red malevolent eyes and a grotesque face, imprisoned inside a vintage box.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The God-Box</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#August_Derleth"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Great_Race_of_Yith">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Great Race of Yith</rdfs:label>
    <ex:hasAnnotation>The (also known as yithians) are a fictional species of sapient extraterrestrial entities, created by h. p. lovecraft for his novella the shadow out of time . They are often depicted as large cone-shaped invertebrates, the form of a prehistoric earth species whose bodies the yithians projected their minds into . In this incarnation, they built a flourishing civilization about two hundred million years before the present day .</ex:hasAnnotation>
    <ex:hasAppearanceC>The Challenge from Beyond The Transition of Titus Crow Haiyore! Nyaruko-san</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Shadow_Out_of_Time"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Daniel_Cain">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Daniel Cain</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Herbert_West"/>
    <ex:hasAnnotation>Daniel "dan" cain is a character created by h. p. lovecraft for his 1922 short story " herbert west--reanimator " he was first given the name in stuart gordon 's 1985 low-budget film re-animator . He was instrumental in defeating an uprising of animated corpses, although he lost his fiancé in the process . After a successful procedure, he discards his former love for a new girlfriend .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Herbert_West--Reanimator"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shadow_Transit">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Shadow Transit</rdfs:label>
    <ex:hasAnnotation>Is a lovecraftian short story by ferrett steinmetz . 'lizzie' is a young girl gifted - or cursed - with a mind which can communicate with an inhuman being .</ex:hasAnnotation>
    <ex:hasAuthorW>Ferrett Steinmetz</ex:hasAuthorW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Damien_Angelica_Walters">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Damien Angelica Walters</rdfs:label>
    <ex:hasAnnotation>Pseudonym(s) Damien Walters Grintalis Damien Walters Connection to the Mythos Author United States United States Horror https://damienangelicawalters.com/ is an award-winning American author and editor based in Maryland who has written a number of Lovecraftian and Cthulhu Mythos short stories. These have appeared in anthologies such as Autumn Cthulhu (2016, Lovecraft eZine Press ), Through a Mythos Darkly (2017, PS Publishing ), and The Leaves of a Necronomicon (2022, Chaosium ). Selected Bibliography Short Fiction "In the Spaces Where You First Lived" (2016) "Kai Monstrai Ateik (When the Monsters Come)" (2017) "Sewn into Pieces, Stitched into Place" (2022) External Links at the Internet Speculative Fiction Database at Goodreads References</ex:hasAnnotation>
    <ex:hasBirthplaceR>United States</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasPseudonymR>Damien Walters</ex:hasPseudonymR>
    <ex:hasPseudonymR>Damien Walters Grintalis</ex:hasPseudonymR>
    <ex:hasWebsiteR>https://damienangelicawalters.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
