    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Theft of Thirty-Nine Girdles</rdfs:label>
    <ex:hasAnnotation>" history "is a short story by the late american and lovecraft contemporary clark ashton smith . It forms part of his hyperborean cycle, and is loosely connected to the cthulhu mythos .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
