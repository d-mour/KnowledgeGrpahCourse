    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Asenath Waite</rdfs:label>
    <ex:hasAnnotation>Asenath is a character created by . H. p. lovecraft for his short story " the thing on the doorstep " she was in 1905 to . Ephraim waite and an unnamed mother who "always went veiled" she was the only known female student at miskatonic university .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Thing_on_the_Doorstep"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Horace_L._Lawson">
