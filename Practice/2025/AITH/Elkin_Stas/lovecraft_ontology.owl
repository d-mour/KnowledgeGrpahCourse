  <rdf:Description rdf:about="http://example.org/lovecraft#The_Book_of_Chaos,_Vol._1:_Ante_Genesem">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Book of Chaos, Vol. 1: Ante Genesem</rdfs:label>
    <ex:hasAnnotation>The book of chaos is a short graphic novel written by mathieu lauffray and xavier dorison . It was released digitally in may 2017 by humanoids in partnership with comixology . The story was continued in a second volume, infernum in terra, later that month .</ex:hasAnnotation>
    <ex:hasAuthorW>Mathieu Lauffray</ex:hasAuthorW>
    <ex:hasAuthorW>Xavier Dorison</ex:hasAuthorW>
    <ex:hasPageCountW>51</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Book_of_Chaos"/>
    <ex:wasReleasedOnW>May 2017</ex:wasReleasedOnW>
  </rdf:Description>
