  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Xotli">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Xotli</rdfs:label>
    <ex:hasAlternativeNamesC>The Demon from Betond</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Lord of Terror</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The lord of terror is a lovecraftian extra-dimensional entity from the fictional universe of marvel by marvel comics . It first appeared in the 1968 novel conan of the isles , by l. sprague de camp and lin carter .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Conan of the Isles</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#L._Sprague_de_Camp"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dweller_Beneath">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Dweller Beneath</rdfs:label>
    <ex:hasAnnotation>The is an insane lovecraftian-like entity in the fictional universe of the rifts pencil-and-paper roleplaying game by palladium . It is an eldritch entity with an insane plan which is to consume all life, not just in the cosmos but throughout the megaverse . Only one individual in the empire knows the dark truth, the kreeghor emperor .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Rifts"/>
    <ex:wasCreatedByC>Palladium Games</ex:wasCreatedByC>
  </rdf:Description>
