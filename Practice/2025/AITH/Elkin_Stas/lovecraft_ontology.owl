    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Nyarlathotep Cycle</rdfs:label>
    <ex:hasAnnotation>The cycle is a series of twenty short stories collected in three books . The stories are collected in both physical and digital formats between 2020 and 2021 . It is not to be confused with the short story anthology of the same name .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Troy_Young"/>
