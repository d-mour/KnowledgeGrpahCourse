  <rdf:Description rdf:about="http://example.org/lovecraft#The_Tomb">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Tomb</rdfs:label>
    <ex:hasAnnotation>Lovecraft drew inspiration for the original 1917 version from a visit to the grave of a distant relative, simon smith . Lovecraft leaves the geographical setting for the tale ambiguous, and the hyde family holding could be anywhere in new england . One night, several years later, he falls asleep beside the mausoleum, and awakes suddenly in the late afternoon .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#King_in_Yellow_%28entity%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Avatars"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>King in Yellow (entity)</rdfs:label>
    <ex:hasAnnotation>The king in yellow is a character created by robert chambers for his horror fantasy story cycle the king in yellow . He is the titular personage of the fictional cursed stage play of the same name . The most favoured interpretation, popularised by the role-playing game call of cthulhu, presents him as an avatar of hastur .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Cthulhu"/>
    <ex:hasAppearanceC>I</ex:hasAppearanceC>
    <ex:hasAppearanceC>More Light</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_King_in_Yellow"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Robert_W._Chambers"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecraft_Annual_No._6">
