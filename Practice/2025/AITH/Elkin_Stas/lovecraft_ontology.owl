    <ex:wasPublishedOnW>1949</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>1922</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#To_Samuel_Loveman,_Esquire,_on_His_Poetry_and_Drama,_Writ_in_the_Elizabethan_Style">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>To Samuel Loveman, Esquire, on His Poetry and Drama, Writ in the Elizabethan Style</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft United States English The Ancient Track: The Complete Poetical Works of H. P. Lovecraft Date of writing December 1915 date 2001 " " is a poem by the late American Howard Phillips Lovecraft , written for his close friend and fellow Kalem Club member Samuel Loveman . Although written in December 1915, it did not see print until long after Lovecraft’s death in 1937, and has to date only appeared in the 2001 collection The Ancient Track: The Complete Poetical Works of H. P. Lovecraft .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Ancient_Track:_The_Complete_Poetical_Works_of_H._P._Lovecraft"/>
    <ex:wasPublishedOnW>2001</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>December 1915</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Arkham_Tales_November_2009">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Periodicals"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Arkham Tales November 2009</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Christophe Dessaigne English Cold Fusion Media Empire Release Date November 2009 100 Preceded by Arkham Tales May 2009 was the fifth and final issue of Arkham Tales: A Magazine of Weird Fiction , a short-lived quarterly magazine edited by Nathan Shumate . It featured cover art by Christophe Dessaigne. Contents Editorial: The End of a Strange Aeon by Nathan Shumate " The Caverns of al-Shog Qaleth " by Robert J. Santa "Queen Anne's Corpse" by Doug Goodman "The Patience Rose" by Anne M. Pillsworth "Jacasser's Gold" by Lawrence Barker "Book-Learnin'" by Sunder Cameron Addams "The Galvanic" by James S. Dorr "Caleb is Dead" by Maggie Flynn "The Simple Account of Sergeant Shea, Immediately Prior to the End of the World" by J. C. Tabler Contributor Notes</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>100</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>November 2009</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Quest_of_Iranon">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Quest of Iranon</rdfs:label>
    <ex:hasAnnotation>The story is about a golden-haired youth who wanders into the city of teloth . He tells tales of the great city of aira, where he was prince . When a boy named romnod suggests leaving teloth, he takes him up on the offer .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>The Galleon</ex:isPublishedAsW>
    <ex:wasPublishedOnW>August 1935 July</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Deadite">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Deadite</rdfs:label>
    <ex:hasAlternativeNamesC>Fake Shemp</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>the Army of Darkness</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>the Dead</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>the Evil Dead</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Deadites are demonic spirits and zombies which are controlled by the necronomicon . Their animating spirits are from the deadlands , a shadowy dimension that is a mirror image of the real world . They are connected to each other via a hive mind .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Evil Dead</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Sam_Raimi"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sea-dweller">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Sea-dweller</rdfs:label>
    <ex:hasAnnotation>Sea-dwellers are vaguely seal-like creatures with a long sinuous undulating neck and an inhuman head . They have scaly skin and veined gills, and are almost entirely white . Their language sounds like cackling laughter and grunts, befitting their carnivorous nature .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Black_Kiss"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Henry_Kuttner"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Robert_Bloch"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Keziah_Mason">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Keziah Mason</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Brown_Jenkin"/>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Nyarlathotep"/>
    <ex:hasAlternativeNamesC>Nahab</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as nahab is a fictional character created by h. p. lovecraft for his short story " the dreams in the witch-house ". She is depicted as being a witch who studied the secrets of interdimensional travel . She has an animal familiar; the rat-creature brown jenkin, which she trusts to carry messages between her and the black man .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Dreams_in_the_Witch-House"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lust_Universe">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lust Universe</rdfs:label>
    <ex:hasAnnotation>Lust is a series of psychological horror adventure games with elements of erotica . First game in the series, lust for darkness, was crowdfunded on kickstarter in 2017 . Most recently, a third game in the series, lust of god, was announced in 2023 .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Minh_Thi_Phan">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Minh Thi Phan</rdfs:label>
    <ex:hasAnnotation>Phan thi minh is an investigator from the cthulhu mythos . Created by fantasy flight games for inclusion in their -related games and fiction . Appeared in two different biographies, one in innsmouth horror and the other in eldritch horror .</ex:hasAnnotation>
    <ex:hasAppearanceC>Eldritch Horror Mansions of Madness Arkham Horror: The Card Game</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC>Innsmouth Horror Deluxe Expansion</ex:madeFirstAppearanceOnC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Psychic_Investigator">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Psychic Investigator</rdfs:label>
    <ex:hasAnnotation>A team of paranormal investigators look into historic and ongoing reports of spooks in an abandoned area of the english town edgebottom named grudge end . Soon one of the teams goes missing, and reports to apathetic local law enforcement go largely ignored . The remaining team is at a loss on how to proceed until the others miraculously reappear, relating a fantastical tale .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#David_A._Riley"/>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Lovecraftiana"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Rokol">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Rokol</rdfs:label>
    <ex:hasAnnotation>Dreamlands Region or City Humans First appearance HPL : " The Doom That Came to Sarnath " Created by H. P. Lovecraft is a region or city that presumably was part of the empire of Sarnath . On the thousand year anniversary of Sarnath's conquest of the city of Ib , among the many who attended the celebration were princes of . ( HPL : " The Doom That Came to Sarnath ")</ex:hasAnnotation>
    <ex:hasTypeL>Region or City</ex:hasTypeL>
    <ex:isInhabitedByL>Humans</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Dreamlands"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Doom_That_Came_to_Sarnath"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Azathoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OuterGods"/>
    <rdfs:label>Azathoth</rdfs:label>
    <ex:ceasedOnC>Immortal</ex:ceasedOnC>
    <ex:hasAffiliationC>EXP )</ex:hasAffiliationC>
    <ex:hasAffiliationC>Great Old Ones ( AWD</ex:hasAffiliationC>
    <ex:hasAffiliationC>Other Gods ( HPL )</ex:hasAffiliationC>
    <ex:hasAffiliationC>Outer Gods ( EXP )</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Creator of All Things Blind Dreamer King-of-All Primordial Demiurge Chaos-Sultan Achamoth Vach-Viraj</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Blind Idiot God Nuclear Chaos Daemon Sultan Abyssal Idiot Lord of All Him in the Gulf The Deep Dark The Cold One Sleeping Chaos Supreme Lord</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as the blind idiot god nuclear chaos daemon sultan abyssal idiot lord of all him in the gulf the deep dark the cold one sleeping chaos supreme lord and creator of all things ( exp : " awakening ") primordial demiurge chaos-sultan achamoth ( exp : " the strange doom of enos harker ") primordial immortal outside reality powers and abilities</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
    <ex:hasAppearanceC>Ramsey Campbell A Madness from the Vaults</ex:hasAppearanceC>
    <ex:hasAppearanceC>The Dreams in the Witch House The Thing on the Doorstep The Haunter of the Dark Fungi from Yuggoth The Lurker at the Threshold The Azathoth Cycle The Insects from Shaggai</ex:hasAppearanceC>
    <ex:hasCharacterMateC>Unknown</ex:hasCharacterMateC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Dream-Quest_of_Unknown_Kadath"/>
