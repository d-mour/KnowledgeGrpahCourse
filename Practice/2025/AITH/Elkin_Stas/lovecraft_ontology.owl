    <ex:hasGenreW>Bestiary</ex:hasGenreW>
    <ex:hasPageCountW>130</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>December 2015</ex:wasReleasedOnW>
  </rdf:Description>
