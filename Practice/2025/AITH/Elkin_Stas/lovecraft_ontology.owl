    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#The_Inhabitant_of_the_Lake"/>
    <ex:hasAlternativeNamesC>Auld Glaikit )</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Ohnyare-kowa</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as the inhabitant of the lake ( exp : " the inhabitant of the lake " ) ohnyare-kowa ( exp : " beneath cayuga's churning waves " ) auld glaikit ( exp : " mirror fishing " )</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Lakeside_Cottages"/>
