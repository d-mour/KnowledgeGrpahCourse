    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#God-Machine">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>God-Machine</rdfs:label>
    <ex:hasAnnotation>The is an eldritch entity, which has created the idea of technology, giving human a reasons to create parts of it . To deal with issues at the human level, it created the angels, beings which operate at the human level .</ex:hasAnnotation>
  </rdf:Description>
