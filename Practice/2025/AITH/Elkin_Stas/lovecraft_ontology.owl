  <rdf:Description rdf:about="http://example.org/lovecraft#Wenelian">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Wenelian</rdfs:label>
    <ex:hasAffiliationC>The Phosphorescent Monsters</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Dream Pirate-Things</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The wenelians are a bizarre-looking species of extra-dimensional creatures . They are capable of body-morphing and float in the air like flying snakes . Their heads somewhat resemble those of a seahorse, with eyes on stalks .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Ye_Booke_of_Monstres_II"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#H._P._Lovecrafts_Dreamlands"/>
    <ex:wasCreatedByC>Phil Frances</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Synchronicity_or_Something">
    <rdf:type rdf:resource="http://example.org/lovecraft#BrianLumleyWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Synchronicity or Something</rdfs:label>
    <ex:hasAnnotation>Brian Lumley English Genre(s) Cthulhu Mythos Dagon Press June 1988 "" is a Cthulhu Mythos story by Brian Lumley , first published as a chapbook by Dagon Press in 1988. Synopsis A cynical private detective investigates a series of disappearances at fantasy roleplaying game conventions. History Following its initial by Dagon Press, "" was reprinted in Lumley's collections In His Own Write: Brian Lumley: Necroscribe ( Necronomicon Press , 1997) and Haggopian and Other Stories ( Subterranean Press , 2008).</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>June 1988</ex:isPublishedAsW>
  </rdf:Description>
