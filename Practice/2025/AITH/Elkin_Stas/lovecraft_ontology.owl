    <rdfs:label>Ex Astoria</rdfs:label>
    <ex:hasAnnotation>Ex Astoris Ruth Tillman Cover Artist Jerome Huguenin English Cthulhu Confidential Genre(s) Roleplaying game Pelgrane Press is a scenario supplement for Pelgrane Press 's Cthulhu Mythos roleplaying game Cthulhu Confidential . Written by Ruth Tillman , one of the designers of the original game, it was first published as a digital download, and later collected in the omnibus volume Even Death Can Die . Overview</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ruth_Tillman"/>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
