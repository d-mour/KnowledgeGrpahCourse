  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mycroft_%26_Moran">
    <rdf:type rdf:resource="http://example.org/lovecraft#DefunctRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Publishers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Mycroft &amp; Moran</rdfs:label>
    <ex:hasAnnotation>Parent Company Arkham House Current Status Retired 1945 United States Sauk City, Wisconsin, US Detective Fiction was an imprint of Arkham House , created to publish weird detective stories and August Derleth 's Solar Pons series in particular. It was named after two characters from the Sherlock Holmes stories of Sir Arthur Conan Doyle, and the imprint's logo featured a deerstalker hat, one of Holmes' iconic accessories. was retired by Arkham House in 1982, but was briefly revived in 1998 when it was licensed to George A. Vanderburg's Battered Silicon Dispatch Box publishing house which specialises in detective fiction, with a focus on Sherlock Holmes works.</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Thirteen_Ways_of_Looking_at_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Thirteen Ways of Looking at Cthulhu</rdfs:label>
    <ex:hasAnnotation>Full story online here Mark Francis English Genre(s) Horror Crypt of Cthulhu #105 date August 2000 " " is a Mythos poem by Mark Francis. Overview As it’s title might suggest, the piece consists of thirteen verses, with each verse offering a vignette showcasing a different aspect of Lovecraft ’s work. History "" was first published in Crypt of Cthulhu #105 in August 2000, and appeared in the online Mythos zine Nightscapes exactly a year later.</ex:hasAnnotation>
    <ex:hasAuthorW>Mark Francis</ex:hasAuthorW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Crypt of Cthulhu #105</ex:isPublishedAsW>
    <ex:wasPublishedOnW>August 2000</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Cultus_Issue_16">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Periodicals"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Cultus Issue 16</rdfs:label>
    <ex:hasAnnotation>Cthulhu Cultus #16 Various Cover Artist Tani Jantsang United States English P. Marsh Release Date December 1999 56 Preceded by Cthulhu Cultus #15 Followed by Cthulhu Cultus #17 Cthulhu Cultus #16 is an issue of sporadic American fanzine Cthulhu Cultus , edited by Tani Jantsang and James Ambuehl and published by P. Marsh in December 1999. Contents "Catch of the Day" by Andy Nunez "Me and Ed..." by James Ambuehl "The Songs of Madness" by G. W. Thomas "The Obelisk" by Ron Shiflet "The Plague" by Richard Bookout "The Bubbling Death" by Les Hernandez "The Only Way to Win Is..." by J. W. Kelley " Folks of Innsmouth: Baseball Player " by Franklyn Searight</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>56</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>December 1999</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Icthultu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Icthultu</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAnnotation>Is an extra-dimensional entity from the fictional universe of the justice league animated series by dc comics . Created by dwayne mcduffie &amp; butch lukic . Originally intended to use cthulhu but were under the impression that the character wasn't in the public domain .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Terror Beyond</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Butch Lukic</ex:wasCreatedByC>
    <ex:wasCreatedByC>Dwayne McDuffie</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Horse_of_the_Invisible">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Horse of the Invisible</rdfs:label>
    <ex:hasAnnotation>Real World Information First appearance ADJ : "The " Created by William Hope Hodgson The Horses of the Invisible are beings created by William Hope Hodgson for his 1910 Thomas Carnacki short story "The ", and subsequently expanded on by Chaosium for the Call of Cthulhu role-playing game. Description The Horses of the Invisible are, as suggested by their name, extra-dimensional creatures that resemble horses but are usually invisible and immaterial. Their manifestations are often mistaken for vengeful spirits as they are attracted to places where pain and suffering have occurred.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Horse of the Invisible</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#William_Hope_Hodgson"/>
  </rdf:Description>
