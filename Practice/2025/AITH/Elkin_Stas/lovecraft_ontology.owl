    <ex:wasPublishedOnW>August 1932</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#What_Dark_God%3F">
    <rdf:type rdf:resource="http://example.org/lovecraft#BrianLumleyWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>What Dark God?</rdfs:label>
    <ex:hasAnnotation>"what dark god? " Is a two-page short story by brian lumley . It was retroactively incorporated into the cthulhu mythos by chaosium when they included the creature summanus in their malleus monstrorum sourcebook .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:isPublishedAsW>Nameless Places</ex:isPublishedAsW>
