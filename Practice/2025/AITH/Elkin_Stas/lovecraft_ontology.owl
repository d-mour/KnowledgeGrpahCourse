    <rdfs:label>Achtung! Cthulhu: Under the Gun</rdfs:label>
    <ex:hasAnnotation>Achtung: cthulhu: under the gun is a short stand-alone scenario for the lovecraftian roleplaying game achtung! Cthulhu . Written by graeme davis and featuring artwork by michael cross, it was published in</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Graeme_Davis"/>
