    <rdfs:label>The Gardens of Lucullus</rdfs:label>
    <ex:hasAnnotation>Simon of gitta is a cthulhu mythos and sword &amp; sorcery adventure . It was published by the sidecar preservation society in 2001 . A sequel, heir of darkness, was written by rahman, with a plot outline approved by tierney .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Glenn_Rahman"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Richard_L._Tierney"/>
