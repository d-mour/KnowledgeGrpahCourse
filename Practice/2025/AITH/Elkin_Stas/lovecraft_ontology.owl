    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Work"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ulthar">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Ulthar</rdfs:label>
    <ex:hasAccessibilityL>Via Earth's Dreamlands</ex:hasAccessibilityL>
    <ex:hasAnnotation>A village in the dreamlands of earth . Its people are known for their simplicity, superstitious nature and reverence of cats . It was forbidden for any citizen of the land to harm or kill a cat after the visit of mysterious dark people .</ex:hasAnnotation>
    <ex:hasAppearanceL>The Other Gods The Dream-Quest of Unknown Kadath The Silver Key Through the Gates of the Silver Key</ex:hasAppearanceL>
    <ex:hasTypeL>City</ex:hasTypeL>
    <ex:isInhabitedByL>Cats</ex:isInhabitedByL>
    <ex:isInhabitedByL>Humans</ex:isInhabitedByL>
    <ex:isLocatedAtL>The Dreamlands</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Cats_of_Ulthar"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cult_of_the_Sand_Bat">
    <rdf:type rdf:resource="http://example.org/lovecraft#Cults"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdfs:label>Cult of the Sand Bat</rdfs:label>
    <ex:hasAnnotation>A racially organized sect for the worship of the father of all bats, an avatar of nyarlathotep feared in australia since ancient times by aboriginals . There are several hundred cultists of the sand bat throughout australia . The most part, sectarians are recruited from the slums of sydney and melbourne .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Susan_Paine">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Susan Paine</rdfs:label>
    <ex:diedOnR>1873</ex:diedOnR>
    <ex:hasAnnotation>Wife of Jeremiah E. Phillips, to whom she gave four children.</ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1839</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Horror_from_the_Middle_Span">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Horror from the Middle Span</rdfs:label>
    <ex:hasAnnotation>" the dunwich horror " is a short story by august derleth based on the notes of h. p. lovecraft . It was first published in 1964 in the anthology travellers by night by derleth's own publishing house, arkham house . It was later included in the collection of posthumous collaborations between lovecraft and derleth the watchers out of time and others .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror Mystery Short Fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Others</ex:isPartOfSeriesW>
    <ex:isPartOfSeriesW>Travellers by Night The Watchers Out of Time</ex:isPartOfSeriesW>
    <ex:wasPublishedOnW>1964</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Xothra">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Xothra</rdfs:label>
    <ex:hasAlternativeNamesC>The Hidden Devourer</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Ravenous</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Hidden Devourer The Ravenous First appearance " Predator " Created by Walter C. DeBill Jr. is a lesser Great Old One . It was once worshipped in ancient Mongolia (under which it may lie). A "lurker in the desert" and servant of Yidhra .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Predator</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Walter C. DeBill Jr.</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Ballad_of_Bass_Rock">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Ballad of Bass Rock</rdfs:label>
    <ex:hasAnnotation>14 is a stand-alone adventure module sourcebook for chaosium ’s call of cthulhu roleplaying game . It contains material which was originally intended to be in cubicle 7 entertainment 's shadows over scotland book, but was cut due to space issues .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Stuart_Boon"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>14</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2012</ex:wasReleasedOnW>
