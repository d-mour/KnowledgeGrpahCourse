    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Dr. Pelletier</rdfs:label>
    <ex:hasAnnotation>Gerald canevin is a recurring character in the gerald canevin series of supernatural stories by henry s. whitehead . Created by whitehead is a recurring character in the gerald canevin series of supernatural stories by whitehead . Created by whitehead is a recurring character in the gerald canevin series of supernatural stories by whitehead .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Cassius"/>
    <ex:hasAppearanceC>Scar-Tissue</ex:hasAppearanceC>
    <ex:hasAppearanceC>Seven Turns in a Hangman's Rope</ex:hasAppearanceC>
    <ex:hasAppearanceC>The Black Beast</ex:hasAppearanceC>
