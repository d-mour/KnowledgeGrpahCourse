  <rdf:Description rdf:about="http://example.org/lovecraft#David_Lee_Ingersoll">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>David Lee Ingersoll</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Artist Birth Date 1964 Anchorage, Alaska, USA United States Horror http://www.oz-squad.com/royal-historians-of-oz/david-lee-ingersoll/ (born 1964) is an American artist who has created numerous images for Cthulhu Mythos publications. Overview Ingersoll has worked as an artist for since the late 1980s. Although he has created his own strips and drawn for others, he is primarily involved in providing cover and interior work for small-press publications and roleplaying game supplements, including for Chaosium 's Call of Cthulhu roleplaying game and it’s associated literature. Selected Works Gaming Supplements Secrets of Kenya (2008) The Eldritch New England Holiday Collection (2021) The Big Book of Cults (2005) Secrets of Kenya (2008) Terrors From Beyond (2009) Atomic-Age Cthulhu (2013) The Eldritch New England Holiday Collection (2021) See also Images by External Links David Ingersoll at the Internet Speculative Fiction Database David Lee Ingersol l at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Alaska Anchorage</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>http://www.oz-squad.com/royal-historians-of-oz/david-lee-ingersoll/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Artist</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1964</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Radiant_Dawn">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Radiant Dawn</rdfs:label>
    <ex:hasAnnotation>Followed by ravenous dusk is the first novel by cody goodfellow . It is the sequel to his short story " in the shadow of swords " . The novel is about a secret war between a renegade special forces team and a new age cult .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Cody_Goodfellow"/>
    <ex:hasPageCountW>320 pages</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2000</ex:wasReleasedOnW>
  </rdf:Description>
