  <rdf:Description rdf:about="http://example.org/lovecraft#Chronike_von_Nath">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Chronike von Nath</rdfs:label>
    <ex:hasAlternativeNamesA>Chronicle of Nath</ex:hasAlternativeNamesA>
    <ex:hasAnnotation>Chronicle of nath is a fictional tome that first appeared in " the tree on the hill " by duane w. rimel and h. p. lovecraft . The germanic form of the title first occurs in rimel's " music of the stars " (1943) the text was translated in 1781 by james .</ex:hasAnnotation>
    <ex:hasAppearanceA rdf:resource="http://example.org/lovecraft#Music_of_the_Stars"/>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_Tree_on_the_Hill"/>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#Duane_W._Rimel"/>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Randy_Oswald_Story">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Randy Oswald Story</rdfs:label>
    <ex:hasAnnotation>" the dewey mine attack " is a lovecraftian short story by and artist dean wirth . It was published in vol 5, issue 3 of the lovecraftiana zine in october 2020 . Characters include a journalist specialising in crime and the paranormal .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Dean_Wirth"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 3</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 5</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Chutes_and_Ladders">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Chutes and Ladders</rdfs:label>
    <ex:hasAnnotation>Chris Claremont Brent Anderson, Bob Wiacek English Marvel Comics Release Date August 1982 Media Type Comic book is a story in issue #160 of the 1st volume of the Uncanny X-Men , written by Chris Claremont. Synopsis The sorcerer Belasco kidnaps young Illyana Rasputina to the agenda of his masters, the N'Garai .</ex:hasAnnotation>
    <ex:hasAuthorW>Chris Claremont</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>August 1982</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yog-Sapha">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Yog-Sapha</rdfs:label>
    <ex:hasAlternativeNamesC>The Dweller of the Depths</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Lord of the Things Which Dwell Beneath the Surface</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Dweller of the Depths The Lord of the Things Which Dwell Beneath the Surface First appearance "The Thing in the Abyss" Created by Llewellyn M. Cabos is a fictional entity created by the late American author Llewellyn M. Cabos for his 1979 short story "The Thing in the Abyss." Overview A creature of darkness and depths, cannot harm others in light. It is believed to originate from crimson Haddath, and is cousin of Shudde-M'ell . It has been speculated to be another form of Zuchequon or Nyogtha .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Thing in the Abyss</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Llewellyn_M._Cabos"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dream_World_of_H._P._Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dream World of H. P. Lovecraft</rdfs:label>
    <ex:hasAnnotation>Donald Tyson Cover Artist Marc Sasso English Genre(s) Non-fiction Llewellyn Publications Release Date November 2010 336 : His Life, His Demons, His Universe is a non-fiction work by Canadian Donald Tyson . First published in November 2010 by Llewellyn Publications, both paperback and digital editions were released. Overview Reception Leading Lovecraft scholar S. T. Joshi described the book as "a thought-provoking and intellectually stimulating book. Its fusion of sound biographical knowledge and critical insight makes it a must-read for Lovecraftians." References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Donald_Tyson"/>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:hasPageCountW>336</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>November 2010</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Horror_at_Red_Hook">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Horror at Red Hook</rdfs:label>
    <ex:hasAnnotation>Lovecraft referred to the area's immigrant population by referring to red hook as "a maze of hybrid squalor" the story was also inspired by the apartment that lovecraft lived in, which is actually located on clinton street in brooklyn heights .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Medusas_Coil">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Medusa's Coil</rdfs:label>
    <ex:hasAnnotation>The story was first published in weird tales magazine in january 1939, two years after lovecraft's death . Due to its casual, overt and relentless racism, this story is most unlikely to see reprint .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Howard_Phillips_Lovecraft"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Zealia_Bishop"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasWrittenOnW>May 1930</ex:wasWrittenOnW>
  </rdf:Description>
