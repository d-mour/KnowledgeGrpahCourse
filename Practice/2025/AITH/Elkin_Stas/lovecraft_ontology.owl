  <rdf:Description rdf:about="http://example.org/lovecraft#Ghoulmaster">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Ghoulmaster</rdfs:label>
    <ex:hasAnnotation>Miskatonic university is a short horror story by american brian mcnaughton . It first appeared in the anthology miskatonic university (daw books, 1996) .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_McNaughton"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Miskatonic_University"/>
    <ex:wasPublishedOnW>November 1996</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Brides_of_Innsmouth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Brides of Innsmouth</rdfs:label>
    <ex:hasAnnotation>Jennifer M. Oaks English 38 is a short chapbook collection consisting of a pair of companion stories written by Jennifer M. Oaks and set in the greater Cthulhu Mythos . Running to a total of 38 , it was independently published solely in a digital format. Overview Contents " The Innsmouth Covenant " " The Diary of Hannah Greeley "</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Jennifer_M._Oaks"/>
    <ex:hasPageCountW>38</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Michael_Bukowski">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Michael Bukowski</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Artist United States https://lastchanceillustration.wordpress.com/ is an American freelance artist. One of his personal projects is to illustrate all of the monsters and gods in the works of H. P. Lovecraft . Selected Works Interior Artwork Walk on the Weird Side (2017) Cover Art Welcome to Miskatonic University (2019) It Came from Miskatonic University (2020) See Also Images by</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://lastchanceillustration.wordpress.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Artist</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shadows_of_Pnath">
    <rdf:type rdf:resource="http://example.org/lovecraft#ArkhamHorrorFiction"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Shadows of Pnath</rdfs:label>
    <ex:hasAnnotation>Countess alessandra zorzi is an infamous cat burglar from a family of con men and grifters . She is now tracking down artifacts and volumes she stole for nefarious occultists in order to restore them to the "right" hands of miskatonic university . Her protege, pepper kelly, is kidnapped by her former lover, the comte, who has his own plan for the tome that may shake the foundations</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Josh_Reynolds"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>306</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Arkham_Horror_Fiction"/>
    <ex:wasReleasedOnW>2023 March 23rd</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Pale_Brown_Thing">
    <rdf:type rdf:resource="http://example.org/lovecraft#FritzLeiberWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Pale Brown Thing</rdfs:label>
    <ex:hasAnnotation>is an earlier shorter version of the Fritz Leiber novella Our Lady of Darkness . Along with the change in title and slight alterations to the spelling of certain coined words, the shorter version does not include some of the digressions and character anecdotes of the longer novella. The title is a reference to the paramental entity the hero nicknames " Taffy " in the longer version.</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Al-Azif,_January-February_1998">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Al-Azif, January-February 1998</rdfs:label>
    <ex:hasAnnotation>Al-azif, january-february 1998 was the inaugural issue of the sporadically-released fanzine al-azif . Edited by peter a. worthy and featuring cover art by stanley c. sargent . Ran to a total of 84 and was published by yhtill press in an a5 format .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>84</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Al-Azif</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>January 1998</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Keyport_Cthulhu_%28story_cycle%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#StoryCycles"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Keyport Cthulhu (story cycle)</rdfs:label>
    <ex:hasAnnotation>Keyport cthulhu is an expanded mythos story cycle created by american armand rosamilia . It has amassed a total of three volumes of stories as of october 2022 . The first volume contains the first five stories, along with a prequel story set in the 1920s .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Armand_Rosamilia"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kingsport_Horror_Deluxe_Expansion_%28Arkham_Horror%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#ArkhamHorror"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Kingsport Horror Deluxe Expansion (Arkham Horror)</rdfs:label>
    <ex:hasAnnotation>Kingsport horror deluxe expansion was the fourth supplement released for fantasy flight games' second edition of arkham horror . It introduced the guardian mechanic to games of arkham horror, representing entities willing to lend their assistance against the awakening ancient ones . The most major change however, was the inclusion of an additional game board which allowed players to travel from arkham to new locations in kingsport .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Kevin_Wilson"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Richard_Launius"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Action Adventure</ex:hasGenreW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Arkham_Horror"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nymph">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SpeciesIncorporatedFromFolkloreMythAndReligion"/>
    <rdfs:label>Nymph</rdfs:label>
    <ex:hasAnnotation>Beautiful, youthful, and divine, they are the offspring of gods, and often the lovers of gods and mortals . Several types of nymphs exist, each associated with a specific aspect of nature: freshwater naiads , oceanic nereids .</ex:hasAnnotation>
    <ex:hasAppearanceC>Laeta</ex:hasAppearanceC>
    <ex:hasAppearanceC>To Pan</ex:hasAppearanceC>
    <ex:hasAppearanceC>To the Old Pagan Religion</ex:hasAppearanceC>
    <ex:hasAppearanceC>a Lament</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_White_People"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Wilbur_Whateleys_journal">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Wilbur Whateley's journal</rdfs:label>
    <ex:hasAnnotation>is a diary belonging to Wilbur Whateley , recovered after his death and along with the contents of his library, were transported to Miskatonic University to be studied. It was encrypted with a highly complex formula, possibly handed down by ancient researchers of the occult ( HPL : The Dunwich Horror ).</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tales_from_Failed_Anatomies">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Tales from Failed Anatomies</rdfs:label>
    <ex:hasAnnotation>Dennis Detwiller English Delta Green Arc Dream Publishing Release Date May 2014 284 is a collection of Lovecraftian fiction by Dennis Detwiller which take place in the Delta Green roleplaying game setting. Running to a total of 284 , it was published by Arc Dream Publishing in May 2014; both paperback and digital editions were released. Overview Contents Introduction by John Scott Tynes "Foreword: The Alien Thoughts That Obtruded on the Consciousness of Agent Ted Gallatin, 35, as He Lay Slowly Dying in a Stairwell in Valley Center" by Robin D. Laws "Intelligences" "The File" "Night and Water" "Dead, Death, Dying" "Punching" "The Secrets No One Knows" "Coming Home" "The Thing In the Pit" "Contingencies" "Drowning in Sand" "Philosophy" "Witch Hunt" "After Math" "Afterword: The Alien Thoughts That Continued To Course Through Ted Gallatin's Brain Subsequent to His Clinical Death" by Robin D. Laws</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Dennis_Detwiller"/>
    <ex:hasPageCountW>284</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Delta Green</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>May 2014</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecraft_Country_%28TV_series%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MediaAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraft Country (TV series)</rdfs:label>
    <ex:hasAnnotation>Lovecraft explores issues of american racism through the lens of the cthulhu mythos . It was adapted from matt ruff's 2016 novel of the same name . The series premiered on hbo on august 16, 2020 .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#Lovecraft_Country"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>16 August 2020</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Burrower_Beneath">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Burrower Beneath</rdfs:label>
    <ex:hasAnnotation>The sorcerer eibon relates the story of how, in his youth, he sought the secret to eternal life despite the warnings of his elders . On the trail of koth-serapis, an evil wizard said to have already learned and employed the secret, he travels first to lemuria and consults with the spectre of sharajsha .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Fantasy</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Fungi #16</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1997</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Deep_Down_Under:_Volume_3">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Deep Down Under: Volume 3</rdfs:label>
    <ex:hasAnnotation>Various Michael Cunliffe J. Scherpenhuizen Cover Artist Steve Santiago Australia English IFWG Publishing Release Date June 2021 248 Preceded by Cthulhu Deep Down Under: Volume 2 is an anthology of Lovecraftian fiction edited by Steve Proposch , Christopher Sequeira , and Bryce Stevens . Running to a total of 248 , it was released by IFWG Publishing in June 2021; both paperback and digital editions were issued. Overview Contents Introduction by Cat Rambo "All The Long Way Down" by Alf Simpson "Farewell To Elephant" by Cat Sparks "The Third Party Doctrine" by Steve Proposch "Come His Children" by Alan Baxter "The Depiction" by Julie Ditrich "The Key To Eternity" by Steven Paulsen "They Are Impatient" by Maurice Xanthos "Dead " by Steve Kilbey "Supersymmetry Blues" by David Conyers "Afterword: I'm Looking Right At You, H. P. Lovecraft" by Jack Dann References</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW rdf:resource="http://example.org/lovecraft#Australia"/>
    <ex:hasPageCountW>248</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>June 2021</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nathaniel_Wingate_Peaslee">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Nathaniel Wingate Peaslee</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Miskatonic_University"/>
    <ex:hasAnnotation>Peaslee is a professor of political economy at miskatonic university . He is also the protagonist of his horror sci-fi novella, the shadow out of time . The years of peaslee's amnesia correspond to the timespan of lovecraft's adolescent nervous system .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Shadow_Out_of_Time"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tidal_Forces">
    <rdf:type rdf:resource="http://example.org/lovecraft#CaitlinRKiernanWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Tidal Forces</rdfs:label>
    <ex:hasAnnotation>Caitlin R. Kiernan English Genre(s) Cthulhu Mythos Sirenia Digest date June 2011 "" is a short story by Caitlin R. Kiernan that originally appeared in the June 2011 issue of Sirenia Digest (#55). Synopsis "" is the story of a woman who, after being struck by a mysterious shadow, develops a growing hole in her abdomen--a hole that seems to be a portal to Azathoth . History The story was republished in the anthology Eclipse Four: New Science Fiction and Fantasy (Night Shade Books, 2011), and in The Best Science Fiction and Fantasy of the Year Volume Six (Night Shade Books, 2012). It also appeared in Kiernan's collections The Ape's Wife and Other Stories ( Subterranean Press , 2013), Beneath an Oil-Dark Sea: The Best of Caitlín R. Kiernan (Volume Two) (Subterranean Press, 2015), Houses Under the Sea: Mythos Tales ( Subterranean Press , 2018), and The Very Best of Caitlín R. Kiernan (Tachyon Publications, 2019). References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Sirenia_Digest"/>
    <ex:wasPublishedOnW>June 2011</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Wood">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Wood</rdfs:label>
    <ex:hasAnnotation>Full story online here H. P. Lovecraft United States English (original) French German Popular Fiction Publishing Co. Weird Tales date September 1938 𝐓 " " is a short fantasy poem by the late American H. P. Lovecraft . First published posthumously in the September 1938 edition of pulp magazine Weird Tales , it has since been reprinted numerous times, and has been translated into both German and French . Synopsis The five four-line verses describe the destruction of an ancient woodland, the rise of a magnificent city of crystal and ivory, and the subsequent return of the primal forest after a careless word spoken by a drunken reveller in a magical tongue. History Weird Tales (1938) Beyond the Wall of Sleep (1943) Collected Poems (1963) The World of H. P. Lovecraft (1971) Fungi from Yuggoth and Other Poems (1971) Writings in the Tryout (1977) The Fantastic Poetry (1990) Fantasia (1990) The Ancient Track (2001, 2013) Eldritch Tales: A Miscellany of the Macabre (2011, 2020) Songs of Giants (2019) Essais - Correspondance - Poésie - Révisions (2021, French- translation) Intégrale (2021, French- translation) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>September 1938</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Arkham_Sampler_Spring_1948">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Periodicals"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Arkham Sampler Spring 1948</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Ronald Clyne United States English The Arkham Sampler Arkham House Release Date Spring 1948 100 Followed by Summer 1948 was the first issue of the short-running magazine The Arkham Sampler . Edited by August Derleth and featuring cover art by Ronald Clyne, it ran to a total of 100 . Contents "Damsel with a Dulcimer" by Malcolm Ferguson "Hellenic Sequel" by Clark Ashton Smith "A Group of Letters" by H. P. Lovecraft "The Blindness of Orion" by Clark Ashton Smith "West Legends" by Robert Hunt "The Wind in the Lilacs" by Stephen Grendon "Unhappy Ending" by Leah Bodine Drake "Fantasy on the March" by Fritz Leiber, Jr. "On the Cthulhu Mythos" by George T. Wetzel "On "The Lurker at the Threshold"" by August Derleth "From a Letter" by Clark Ashton Smith " A Memoir of Lovecraft " by Rheinhart Kleiner The Dream Quest of Unknown Kadath (Part 2 of 4) by H. P. Lovecraft "Ghosts in Great Britain" by August Derleth "The Macabre in Pictures" by August Derleth "Top-Notch Science-Fiction" by John Haley "Deliver Us From Evil" by Robert Bloch Reviews by August Derleth, John Haley, Robert Bloch, and uncredited contributors External Links full issue online at the Internet Archive</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>100</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Arkham_Sampler"/>
    <ex:wasReleasedOnW>Spring 1948</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Literature_of_Rome">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Literature of Rome</rdfs:label>
    <ex:hasAnnotation>Full story online here H. P. Lovecraft United States English (original) French Genre(s) Non-fiction To Quebec and the Stars Date of writing November 1918 date 1976 " " is a work of literary criticism by the late American Howard Phillips Lovecraft . Written in November 1918, it remained unpublished until after Lovecraft’s death in 1937, first seeing print in the 1976 collection To Quebec and the Stars . Synopsis As stated by its title, "" offers a brief analysis of the literary output of Ancient Rome, beginning with its origins in Hellenic Greece. As was somewhat common in Lovecraft's writings, it displays a distinct racial bias when discussing the matter of heritage, commenting that: History To Quebec and the Stars (1976) Howard Phillips Lovecraft 1 (1991) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:isPublishedAsW>To Quebec</ex:isPublishedAsW>
    <ex:isPublishedAsW>the Stars</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1976</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>November 1918</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Comte_Robert_de_C--">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Comte Robert de C--</rdfs:label>
    <ex:hasAnnotation>Comte Robert de C-- Relatives Comte Godfrey de C-- (father) Comte Antoine de C-- (descendant) Offspring Comte Louis de C-- (son) Nobleman Human First appearance HPL : " The Alchemist " Created by H. P. Lovecraft Comte Robert de C-- (no surname given) was a French count in the story " The Alchemist " by H. P. Lovecraft . He was the son of Comte Godfrey , the father of Louis , and an ancestor of Comte Antoine . Like other members of his line, Robert was killed at the age of 32, a victim of the curse put on his family by Charles le Sorcier . He had been out walking in a field and was confronted by Charles who forced lethal poison down Robert's throat, leaving him there to die. Behind the Mythos In the comic book adaptation from The Worlds of H. P. Lovecraft series, the C-- stands for Chabrillane.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Alchemist"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sylvia_Smoltz">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Sylvia Smoltz</rdfs:label>
    <ex:hasAffiliationC>The Esoteric Order of Dagon</ex:hasAffiliationC>
    <ex:hasAnnotation>Unnamed husband Realtor The Esoteric Order of Dagon Human First appearance " Ancient " (2012, EXP ) Created by Armand Rosamilia is a minor recurrent character created by American author Armand Rosamilia for his Keyport Cthulhu series of Mythos tales. Description A woman in her later middle years, Sylvia is somewhat overweight and wears too much makeup, perhaps in an effort to disguise her deformities: as a member of the Keyport , New Jersey branch of the Esoteric Order of Dagon , it is more than possible that she is in fact a Deep One hybrid. Sylvia works as Keyport's town realtor, and her unnamed husband is a prominent lawyer. Appearances " Ancient " (2012) " Evil " (2013)</ex:hasAnnotation>
    <ex:hasCharacterMateC>Unnamed husband</ex:hasCharacterMateC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Ancient"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Armand_Rosamilia"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#H._P._Lovecrafts_The_Hound_and_Other_Stories">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>H. P. Lovecraft's The Hound and Other Stories</rdfs:label>
    <ex:hasAnnotation>Gou Tanabe Gou Tanabe Japanese 1st: Kadokawa Corporation English: Dark Horse Comics Release Date 2014 Media Type Manga H.P. Lovecraft's The Hound and Other Stories is a manga written and illustrated by Gou Tanabe which was published by Kadokawa Corporation in 2014. An English translation was published in 2017 by Dark Horse Comics. It is an adaptation of three stories by Howard Phillips Lovecraft . Stories " The Temple " " The Hound " " The Nameless City "</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Gou_Tanabe"/>
    <ex:isInLanguageW>Japanese</ex:isInLanguageW>
    <ex:wasReleasedOnW>2014</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Secret_of_the_Sahara">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Secret of the Sahara</rdfs:label>
    <ex:hasAnnotation>"secrets of the sahara" is a lovecraftian short story by the late american richard a. lupoff . It was first published in the mammoth book of new jules verne adventures by carroll &amp; graf in 2005 . The entities detected frozen in time during the expedition's preliminary scans could be interpreted as elder things and cthulhi .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Richard_A._Lupoff"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>The Mammoth Book of New Jules Verne Adventures</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2005</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mr._Cannyharme_%28character%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Mr. Cannyharme (character)</rdfs:label>
    <ex:hasAffiliationC>The Sons of Holland</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Mr. Canning</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Mr. Cunningham</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Mr. Van Haarme</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Mr. cannyharme, also known as mr. cunningham, mr. van haarme, or mr. canning, is an antagonistic character created by the late american author michael shea . In his true form, he resembles an enormous hound with oversized jaws and sexual organs .</ex:hasAnnotation>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Michael_Shea"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Eddy_C._Bertin">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Eddy C. Bertin</rdfs:label>
    <ex:diedOnR>19 May 2018</ex:diedOnR>
    <ex:hasAnnotation>Full Name Eddy Charly Bertin Pseudonym(s) Edith Brendall Dorian Greysun Connection to the Mythos Author Birth Date 26 December 1944 Hamburg, Germany Death Date 19 May 2018 Crete, Greece Belgium Science Fiction Horror Children’s Fiction (26 December 1944 - 19 May 2018) was a Belgian author and occasional artist who worked in the genres of science fiction, horror and children’s fiction. He wrote a number of works set in the fictional Cthulhu Mythos inspired by the works of H. P. Lovecraft and many others. These have appeared in anthologies such as The Disciples of Cthulhu (1976 DAW Books) and Tales Out of Dunwich (2005, Hippocampus Press ). Selected Bibliography Short Fiction "Darkness, My Name Is" (1976) "Dunwich Dreams, Dunwich Screams" (2005) External Links at Wikipedia (English) at Wikipedia (Dutch) at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>Germany Hamburg</ex:hasBirthplaceR>
    <ex:hasFullNameR>Eddy Charly Bertin</ex:hasFullNameR>
    <ex:hasNationalityR>Belgium</ex:hasNationalityR>
    <ex:hasPseudonymR>Dorian Greysun</ex:hasPseudonymR>
    <ex:hasPseudonymR>Edith Brendall</ex:hasPseudonymR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>26 December 1944</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tony_Richards">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Tony Richards</rdfs:label>
    <ex:hasAnnotation>Pseudonym(s) Richard Faust Connection to the Mythos Author Birth Date 3 June 1956 Greenford, Middlesex, England United Kingdom Horror Fantasy Crime  (born 3 June 1956) is a British short story writer and novelist whose works fall primarily into the horror and supernatural genres. He has authored a number of Lovecraftian works, including the Weird House Press collection The Howling Terror and Other Lovecraftian Horror Stories ; in addition to these, he has penned three ongoing literary series, including Raine's Landing and The Birchiam Chronicles . He is both a Bram Stoker and British Fantasy Award nominee. Richards counts Ray Bradbury, Fritz Leiber , Harlan Ellison, and Poppy Z. Brite amongst his literary influences . Selected Bibliography Collections The Howling Terror and Other Lovecraftian Horror Stories (2022) Short Fiction "The Howling Terror" (2022) " The Death of Vanessa Fell " (2022) "The Darkness in The Harbour" (2022) " The Orphanage at Trellaree " (2022) "The Shadow Out Of London" (2022) External Links at Wikipedia at the Internet Speculative Fiction Database at Goodreads References</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#England Greenford Middlesex</ex:hasBirthplaceR>
    <ex:hasNationalityR>United Kingdom</ex:hasNationalityR>
    <ex:hasPseudonymR>Richard Faust</ex:hasPseudonymR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>3 June 1956</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu:_Le_mythe_-_Livre_II">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu: Le mythe - Livre II</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft Cover Artist Loïc Muzy France French Bragelonne Release Date October 2015 456 Preceded by Cthulhu: Le mythe Followed by Cthulhu: Le mythe - Livre III ( Cthulhu: The Myth - Book II ) is a French- translation of the works of H. P. Lovecraft . Running to a total of 456 , it was published by Bragelonne in a paperback format in October 2015, and features both cover and interior art by Loïc Muzy . Contents "Azathoth" (" Azathoth ") "Histoire du Necronomicon" (" History of the Necronomicon ") "Nyarlathotep" (" Nyarlathotep ") "Dagon" (" Dagon ") "De l'au-delà" (" From Beyond ") "Le molosse" (" The Hound ") "La musique d'Erich Zann" (" The Music of Erich Zann ") "Par-delà le mur du sommeil" (" Beyond the Wall of Sleep ") "Le temple" (" The Temple ") "La peur qui rôde" (" The Lurking Fear ") "La couleur venue d'ailleurs" (" The Colour Out of Space ") "L'ombre immémoriale" ( The Shadow Out of Time ) "Les montagnes de la démence" ( At the Mountains of Madness ) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW rdf:resource="http://example.org/lovecraft#France"/>
    <ex:hasPageCountW>456</ex:hasPageCountW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:wasReleasedOnW>October 2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Weak">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Weak</rdfs:label>
    <ex:hasAnnotation>A set of alternative lyrics written to be sung to skunk anansie's 1996 single "." The poem consists of six short verses which namecheck a number of entities and locations associated with the cthulhu mythos .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Peter_A._Worthy"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>December 1997</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#In_the_Vault">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>In the Vault</rdfs:label>
    <ex:hasAnnotation>"the descendant" is a horror short story by american horror fiction writer . Inspiration was based on a suggestion made in august 1925 by charles w. smith, editor of the amateur press journal tryout . The story was rejected by weird tales in november 1925; editor farnsworth wright feared "its extreme gruesomeness would not pass the indiana censorship"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Chamber_of_Darkness_Vol_1_5">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Chamber of Darkness Vol 1 5</rdfs:label>
    <ex:hasAnnotation>Chamber of Darkness Vol 1 #5 United States English Marvel Comics Release Date June 1970 Media Type Comic book Chamber of Darkness Vol 1 #5 is an issue of Marvel Comics ' horror anthology series. It features an adaptation of H. P. Lovecraft 's " The Music of Erich Zann " (titled "The Music From Beyond"), written by Roy Thomas and illustrated by Johnny Craig. External Links at the Marvel Database wiki</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>June 1970</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kickstarter">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Kickstarter</rdfs:label>
    <ex:hasAnnotation>The story is written as an online campaign in which members of dunwich 's whateley family are attempting to raise funds to awaken great cthulhu . Only $37 had been raised of the $400,000 goal, with eleven days still to go . Included in the collection of byers' own works the hep cats of ulthar and other lovecraftian tales in may 2018 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Richard_Lee_Byers"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Shall Be</ex:isPublishedAsW>
    <ex:isPublishedAsW>Whispers from the Abyss Vol. 2: The Horrors That Are</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Arwassa">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Arwassa</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Silent Shouter of the Hill</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as the silent shouter of the hill , is a fictional entity created by robert m. price for his short story " saucers from yaddith " appears in the mobile game tower of saviors .</ex:hasAnnotation>
    <ex:isLocatedAtC>Europe</ex:isLocatedAtC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Saucers_from_Yaddith"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Feaster_from_Afar">
    <rdf:type rdf:resource="http://example.org/lovecraft#Avatars"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Feaster from Afar</rdfs:label>
    <ex:hasAffiliationC>Avatar of Hastur</ex:hasAffiliationC>
    <ex:hasAnnotation>The is an avatar of hastur the unspeakable created by joseph payne brennan for his short story " the "</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Feaster_from_Afar"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Joseph_Payne_Brennan"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Corporate_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Corporate Cthulhu</rdfs:label>
    <ex:hasAnnotation>Twenty Tales of Bureaucratic Nightmare Edward Stasheff , editor Cover Artist Steven Gilberts English Genre(s) Cthulhu Mythos Pickman's Press Release Date February 12, 2018 420 : Twenty Tales of Bureaucratic Nightmare is an anthology edited by Edward Stasheff , and published by Pickman's Press in 2018. It features Cthulhu Mythos stories with a business setting, mostly original to this volume. Contents "Introduction: The Invisible Tentacle" by Nicholas Nacario "Death Pledge" by Jeff Deck "Welcome to the R'lyeh Corporation" by James Pratt "Shadow Charts" by Marcus Johnston "Casual Friday" by Todd H. C. Fischer "The God Beneath the Church" by David Tallerman "Refusal" by DJ Tyrer "Dagon-Tec" by Adam Millard "Estoteric Insurance, Inc." by Evan Dicken and Adrian Ludens "Career Zombie" by John Taloni "Boedromion Noumenia" by Andrew Scott "Incorporation" by Max D. Stanton "The Loponine Exploitation" by John M. Campbell "Festival Preparations" by Justin Bailey "Maryanne's Equations" by Harry Pauff "Wholesome Labor" by Sam Rent "Like a Good Neighbor" by Wile E. Young "Tindalos, Inc." by Charlie Allison "Clean Up Aisle Four" by Josh Storey "Forced Labor" by Peter Rawlik "The Shadows Lengthen in the Close" by Ethan Gibney "It Came from I.T." by Gordon Linzner "Retraction" by Marie Michaels "Facilities Management at Dagocorp HQ" by L Chan "No Doves Come from Raven Eggs" by Mark Oxbrow "Apotheosis" by Darren Todd</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Edward_Stasheff"/>
    <ex:hasAuthorW>editor</ex:hasAuthorW>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasPageCountW>420</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2018 February 12</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Shimmer_%28Annihilation%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>The Shimmer (Annihilation)</rdfs:label>
    <ex:hasAnnotation>The shimmer is a mysterious and ever-changing phenomenon . It is referred to as "area x" in the southern reach trilogy . It is characterized by its iridescent, shimmering appearance, hence its name .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#John_Tynes">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>John Tynes</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Games Designer Birth Date 1971 Memphis, Tennessee, USA American https://www.johntynes.com/ John Scott Tynes (born 1971 in Memphis, Tennessee, USA) is an American games designer, author, and editor who previously worked on traditional games, but has since moved on to the digital medium. He is most well known for being the co-creator of the Delta Green Mythos setting and his work on Chaosium 's Call of Cthulhu roleplaying game and it’s associated licenses; his company, Tynes Cowan Corporation, has a specialist imprint named Pagan Publishing specifically for Cthulhu Mythos-related releases. Tynes also has a long-standing professional relationship with fellow games designer Dennis Detwiller . Selected Works Editor The Unspeakable Oath (1990-2001) Delta Green: Alien Intelligence (1998, with Robert Kruger ) Delta Green: Dark Theatres (2001, with Robert Kruger) Author Delta Green: The Rules of Engagement (2000) "The Dark Above" (1998) "The Corn King" (2001) "Things to Do in Kingsport When You're Dreaming" (2002) Games The Hills Rise Wild! (2000, with Jesper Myrfors ) Delta Green: The Role-Playing Game (2016, with Dennis Detwiller and Adam Scott Glancy ) Devil's Children (1993, editor and graphic design) The Resurrected Volume One: Grace Under Pressure (1993, with Jeff Barber ) The Resurrected Volume Two: Of Keys &amp; Gates (1994, with Chris Klepac and John H. Crowe, III ) Walker in the Wastes (1994, editor and graphic design) Coming Full Circle (1995, editor, cover design, and technical illustration) Delta Green (1997, with Dennis Detwiller and Adam Scott Glancy ) Mortal Coils (1998, contributor and graphic design) Delta Green: Countdown (1999, with Dennis Detwiller and Adam Scott Glancy) The Resurrected III: Out of the Vault (2002, contributor) External Links John Scott Tynes at Wikipedia at the Internet Speculative Fiction Database John Scott Tynes at Goodreads John Scott Tynes at BoardGameGeek</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Tennessee Memphis</ex:hasBirthplaceR>
    <ex:hasNationalityR>American</ex:hasNationalityR>
    <ex:hasWebsiteR>https://www.johntynes.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Games Designer</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1971</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Revelations_from_Yuggoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Revelations from Yuggoth</rdfs:label>
    <ex:hasAnnotation>Shawn Ramsey Shawn Ramsey English November 1987 Final Publication February 1989 was a short-lived weird fiction fanzine edited by author and poet Shawn Ramsey and published by Cryptic Publications . Overview Publishing a wide range of work including poetry, short fiction (from both new and established authors, as well as some classic pieces), original artwork and non-fiction articles, ran for a total of three issues between November 1987 and February 1989. Issues November 1987 May 1988 February 1989 Gallery</ex:hasAnnotation>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Book_of_Chaos">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#StoryCycles"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Book of Chaos</rdfs:label>
    <ex:hasAnnotation>Comixology is a of short graphic novels written by mathieu lauffray and xavier dorison, with lauffray also suppling the artwork . They were originally released digitally in may 2017 by humanoids in partnership with comixology . A hardcover edition containing all four books also received a release .</ex:hasAnnotation>
    <ex:hasAuthorW>Matheiu Lauffray</ex:hasAuthorW>
    <ex:hasAuthorW>Xavier Dorison</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dappled_Egg">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dappled Egg</rdfs:label>
    <ex:hasAnnotation>The short story was first published in the zine lovecraftiana (year unknown, rogue planet press) it is about a young couple who run a pet store specialising in reptiles . The egg hatches a bizarre creature which forms an immediate bond with claudia . She then gives herself to it and sacrifices i to assuage its dark appetites .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Tim_Mendees"/>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Lovecraftian horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Lovecraftiana"/>
    <ex:wasPublishedOnW>Unknown</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mother_Hydra">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Mother Hydra</rdfs:label>
    <ex:hasAffiliationC>Lesser Old Ones</ex:hasAffiliationC>
    <ex:hasAnnotation>Hydra is a creature who, alongside her consort father dagon , is said to rule over the race known as the deep ones . There is debate as to whether or not they are lesser great old ones or mere grotesquely mutated deep ones .</ex:hasAnnotation>
    <ex:hasCharacterMateC>Father Dagon</ex:hasCharacterMateC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Shadow_Over_Innsmouth"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Ballad_of_Black_Tom">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Ballad of Black Tom</rdfs:label>
    <ex:hasAnnotation>Novella was published by tor books on february 16, 2016 . It won the 2016 shirley jackson award and the 2017 british fantasy award for best novella . The novella was included in the tor omnibus reimagining lovecraft .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Victor_LaValle"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>February 2016</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Something_in_Wood">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Something in Wood</rdfs:label>
    <ex:hasAnnotation>Jason wecter is an art critic/collector of weird and macabre artwork . To balance his collection, he wishes to obtain something made of wood . A friend of wecter, named pinckney, locates a wooden bas-relief of an octopoid creature at a second-hand shop in portland, maine . Pinckney notices an inexplicable change in wecter's art reviews, which now unleash harsh criticism on artists that he had</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>March 1948</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Frog_Monster">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Frog Monster</rdfs:label>
    <ex:hasAffiliationC>Ogdru Jahad Ogdru Hem</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Unknown</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Frog monsters are recurring antagonists in the hellboy-universe, who are inspired by the cthulhu mythos race of the deep ones . The creatures were first met by hellboy, abe sapien and liz sherman in cavendish hall in the 1990's, where four humans were turned into these creatures .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Hellboy: Seed of Destruction</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Mike_Mignola"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Ghost-Eater">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Ghost-Eater</rdfs:label>
    <ex:hasAnnotation>The ghost eater is a horror short story by c.m. Eddy, jr. and h. p. lovecraft . It was published in the april 1924 issue of weird tales . The narrator sets out on journey from mayfair to glendale, maine, on foot . He soon becomes exhausted from the afternoon heat and falls asleep .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasAuthorW>C. M. Eddy. Jr.</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#H._P._Lovecrafts_The_Beast_in_the_Cave">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleFilmAndTelevisionAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>H. P. Lovecraft's The Beast in the Cave</rdfs:label>
    <ex:hasAnnotation>Based on HPL : " The Beast in the Cave " Cameron McCasland H. P. Lovecraft (original story) Larry Underwood (screenplay) Release date 2016 English H.P. Lovecraft's The Beast in the Cave is a 2016 short film directed by Cameron McCasland and screenwritten by Larry Underwood. As its title might suggest, it is based on the short story " The Beast in the Cave " by H. P. Lovecraft . It was nominated for the H. P. Lovecraft Festival Award at both the Providence and Portland H. P. Lovecraft Film Festivals .</ex:hasAnnotation>
    <ex:hasWriterW>http://example.org/lovecraft#H._P._Lovecraft Larry Underwood</ex:hasWriterW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Beast_in_the_Cave"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2016</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mother_of_Pus">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OuterGods"/>
    <rdfs:label>Mother of Pus</rdfs:label>
    <ex:hasAffiliationC>Outer Gods</ex:hasAffiliationC>
    <ex:hasAnnotation>Relatives Shub-Niggurath (parent) Outer Gods First appearance EXP : Dead Reckonings Created by Richard Watts The is a fictional entity created by games designer Richard Watts for the Call of Cthulhu scenario "Behold the Mother", an adventure which was included in the 1998 supplement Dead Reckonings . Description A minor Outer God composed of eyes, slime, tentacles and mouths, the was spawned from the mating of Shub-Niggurath and a human. When summoned, she seeks refuge in pools of foul water.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Dead_Reckonings"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Richard_Watts"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Jonathan_Green">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Jonathan Green</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Editor United Kingdom United Kingdom Years Active 1993-present http://jonathangreenauthor.blogspot.com/ is an English author, editor, game book designer, and former teacher. His writing credits include tie-in works for franchises such as Sonic the Hedgehog Star Wars and Doctor Who , novels for the Games Workshop properties Warhammer and Warhammer 40,000 , and his own steampunk series Pax Britannia . In addition to this he has written seven books in the popular Fighting Fantasy series, and a number of non-fiction works on topics ranging from the history of Fighting Fantasy to the stories behind Christmas traditions. Selected Works Editor Shakespeare vs. Cthulhu (2016) Author " The Serpent's Egg " (2013) External Links at Wikipedia at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>United Kingdom</ex:hasBirthplaceR>
    <ex:hasNationalityR>United Kingdom</ex:hasNationalityR>
    <ex:hasWebsiteR>http://jonathangreenauthor.blogspot.com/</ex:hasWebsiteR>
    <ex:hasYearsActiveR>1993-present</ex:hasYearsActiveR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Aucturn">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Aucturn</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Great_Old_One"/>
    <ex:hasAnnotation>Great old one created by paizo for the pathfinder role-playing game in 2007 . It is in paizo's starfinder roleplaying game that was fully developed . Most of the planet's lifeforms are vicious and monstrous, which include shoggoths and gugs .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Entombed with the Pharaohs</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Michael Kortes</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dark_Light">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dark Light</rdfs:label>
    <ex:hasAnnotation>Carnacki: the lost casesis a short story by american and scholar robert m. price . It is loosely connected to the cthulhu mythos . The drug used by the parliamentarian to travel between dimensions was the black lotus .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Carnacki:_The_Lost_Cases"/>
    <ex:wasPublishedOnW>June 2016</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Iron-Bound_Books_of_Shuma-Gorath">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Iron-Bound Books of Shuma-Gorath</rdfs:label>
    <ex:hasAnnotation>First appeared in print in " the curse of the golden skull " by robert e. howard which was published in 1967 . First mentioned in marvel comics in 1974 in conan the barbarian vol 1 37 . First mentioned in conan: adventures in an age undreamed of role-playing game by modiphius entertainment .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_Curse_of_the_Golden_Skull"/>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Necronomnomnom:_Recipes_and_Rites_from_the_Lore_of_H._P._Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Necronomnomnom: Recipes and Rites from the Lore of H. P. Lovecraft</rdfs:label>
    <ex:hasAnnotation>The necronomnomnomnom is a humorous horror fiction recipe book based on h.p. Lovecraft's cthulhu mythos . The book is published by the countryman press, copyrighted by red duke games, llc . The recipes are presented in the format of either a spell, a play, or a fictionalized account .</ex:hasAnnotation>
    <ex:hasAuthorW>Mike Slater</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>cookbook</ex:hasGenreW>
    <ex:hasGenreW>parody</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Historical_Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Historical Lovecraft</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Paco Rico Torres United States English Genre(s) Weird fiction Historical Innsmouth Free Press Release Date April 2011 275  : Tales of Horror Through Time , edited by Silvia Moreno-Garcia and Paula R. Stiles , is a short story anthology using as its central theme stories about and inspired by the Mythos from throughout recorded history. Overview Containing 26 short stories and running to a total of 275 , was published by Innsmouth Free Press in April 2011. Both physical and digital editions were made available. Contents Introduction by Silvia Moreno-Garcia and Paula R. Stiles "The God Lurking in Stone" by Andrew Dombalagian "The Seeder from the Stars" by Julio Toro San Martin "Deus ex Machina" by Nathaniel Katz "If Only to Taste Her Again" by E. Catherine Tobler " Shadows of the Darkest Jade " by Sarah Hans "The Chronicle of Aliyat Son of Aliyat" by Alter S. Reiss "Silently, Without Cease" by Daniel Mills "The Good Bishop Pays the Price" by Martha Hubbard "The Saga of Hilde Ansgardóttir" by Jesse Bullington "An Interrupted Sacrifice" by Mae Empson "Pralaya: The Disaster" by Y. W. Purnomosidhi "The City of Ropes" by Albert Tucher " Inquisitor " by William Meikle "The Far Deep" by Josh Reynolds "City of Witches" by Regina Allen "Ahuizotl" by Nelly Geraldine García-Rosas "An Idol for Emiko" by Travis Heermann "The Infernal History of the Ivybridge Twins" by Molly Tanzer "Black Leaves" by Mason Ian Bundschuh "The Second Theft of Alhazred's Manuscript" by Bradley H. Sinor " Ngiri's Catch " by Aaron Polson "What Hides and What Returns" by Bryan Thao Worra " Black Hill " by Orrin Grey "Amundsen's Last Run" by Nathalie Boisard-Beudin "Red Star, Yellow Sign" by Leigh Kimmel "Found in a Trunk from Extremadura" by Meddy Ligner</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Historical</ex:hasGenreW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:hasPageCountW>275</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>April 2011</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Shunned_House">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Shunned House</rdfs:label>
    <ex:hasAnnotation>Wtis a novelette by h. p. lovecraft in the horror fiction genre . Written on october 16–19, 1924, it was first published as a booklet in 1928 . Inspiration of the title is based on a house in providence, ri, built around 1763 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror novelette</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nemesis_of_Flame">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Nemesis of Flame</rdfs:label>
    <ex:hasAnnotation>The is a fictional entity featured in the short story " the last test " (1928), by adolphe de castro and h. p. lovecraft . The might take its name from the algernon blackwood story "the nemesis of fire", published in his 1908 collection john silence, physician extraordinary . In the story, the entity is identified by silence as a fire elemental employed in ancient egypt to guard the tomb of a mummy .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Last_Test"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Adolphe_de_Castro"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Summoning_the_Dream-Sender">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Summoning the Dream-Sender</rdfs:label>
    <ex:hasAnnotation>Full story online here Ron Shiflet United States English Publication date March 1999 " " is a very short Cthulhu Mythos poem by American Ron Shiflet . Synopsis The narrator reads a passage from a musty old book and summons a dread creature which then consumes him. Publication History "" was published in both Dark Legacy #4 and Nightscapes in March 1999.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>March 1999</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Unspace">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsOriginatingFromMythosAdjacentWorks"/>
    <rdfs:label>Unspace</rdfs:label>
    <ex:hasAlternativeNamesL>Infraspace</ex:hasAlternativeNamesL>
    <ex:hasAlternativeNamesL>Overspace</ex:hasAlternativeNamesL>
    <ex:hasAlternativeNamesL>Subspace</ex:hasAlternativeNamesL>
    <ex:hasAlternativeNamesL>The bleed</ex:hasAlternativeNamesL>
    <ex:hasAlternativeNamesL>The warp dimension</ex:hasAlternativeNamesL>
    <ex:hasAlternativeNamesL>Transwarp space</ex:hasAlternativeNamesL>
    <ex:hasAlternativeNamesL>Underspace</ex:hasAlternativeNamesL>
    <ex:hasAnnotation>Background is a realm of kaleidoscopic madness and anti-matter, a timeless non-space that exists beyond all reality . The only beings who live in are the elder gods , a race of ancient evil entities of indescribable power . Despite being trapped in , the elder gods were able to influence the minds of sensitive beings in the material universe .</ex:hasAnnotation>
    <ex:hasAppearanceL rdf:resource="http://example.org/lovecraft#Infestation_2"/>
    <ex:hasTypeL>Extra-dimensional void</ex:hasTypeL>
    <ex:isInhabitedByL>The Elder Gods</ex:isInhabitedByL>
    <ex:isLocatedAtL>Beyond time</ex:isLocatedAtL>
    <ex:isLocatedAtL>space</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL>Transformers: Generation 1</ex:madeFirstAppearanceOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Skoptsy">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Skoptsy</rdfs:label>
    <ex:hasAnnotation>Two mob enforcers are dispatched to a remote farmhouse in the north of england with instructions to kill its occupants . What they encounter is a cult who practice self-mutilation led by a deathless old man with a tentacled abomination embedded within his torso .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Jonathan_Sharp"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Shall Be</ex:isPublishedAsW>
    <ex:isPublishedAsW>Whispers from the Abyss Vol. 2: The Horrors That Are</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#This_Pulsing_Mass_That_Serves_As_My_Heart">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>This Pulsing Mass That Serves As My Heart</rdfs:label>
    <ex:hasAnnotation>Mark McLaughlin Michael Sheehan, Jr. English Genre(s) Horror Horrors &amp; Abominations: 24 Tales of the Cthulhu Mythos date December 2018 " " is a short story by authors Mark McLaughlin and Michael Sheehan, Jr. Synopsis A man starts dating a beautiful woman who he meets at work, but soon discovers that she is in fact an immortal being who was "modified" many centuries ago by Nyarlathotep and can now only survive by the consumption of human meat. Characters Pete Ramsey , an average Joe working a boring office job. Angela Road , a once-human creature born in ancient Egypt. History "" was published in the collection Horrors &amp; Abominations: 24 Tales of the Cthulhu Mythos in December 2018.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mark_McLaughlin"/>
    <ex:hasAuthorW>Michael Sheehan. Jr.</ex:hasAuthorW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Abominations: 24 Tales of the Cthulhu Mythos</ex:isPublishedAsW>
    <ex:isPublishedAsW>Horrors</ex:isPublishedAsW>
    <ex:wasPublishedOnW>December 2018</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Teloe">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Teloe</rdfs:label>
    <ex:hasAlternativeNamesL>Teloe of the Golden Rivers</ex:hasAlternativeNamesL>
    <ex:hasAnnotation>Outer space (speculative) Also known as of the Golden Rivers Realm Benevolent deities , favored mortals First appearance HPL : " The Crawling Chaos " Created by H. P. Lovecraft is a mystical realm located somewhere "beyond the Milky Way and the Arinurian Streams ", mentioned in the story " The Crawling Chaos " by H. P. Lovecraft . is described as a beautiful paradise inhabited by benevolent deities and favored mortals, with cities of amber and chalcedony, ivory bridges, and rivers of liquid gold bearing pleasure barges bound for the realm of Cytharion . and Cytharion were part of an apocalyptic vision of the future experienced by the unnamed narrator of the story under the influence of opium, so their literal existence may or may not be taken for granted in the context of the Mythos .</ex:hasAnnotation>
    <ex:hasTypeL>Realm</ex:hasTypeL>
    <ex:isInhabitedByL>Benevolent deities</ex:isInhabitedByL>
    <ex:isInhabitedByL>favored mortals</ex:isInhabitedByL>
    <ex:isLocatedAtL>Outer space (speculative)</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Crawling_Chaos"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Umr_At-Tawil">
    <rdf:type rdf:resource="http://example.org/lovecraft#Avatars"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>'Umr At-Tawil</rdfs:label>
    <ex:hasAffiliationC>Outer Gods</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Guide</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Most Ancient One</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Prolonged of Life</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Umr at-tawil ( ) is an entity who stands beside the ultimate gate, meeting any who traverse the first gate via the silver key . He appears as a heavily cloaked, vaguely humanoid figure, with no organs or features discernible beneath his garb . In the cthulhu mythos this being is described in " through the gates of the silver key " by h. p. lovecraft and e. hoffmann price .</ex:hasAnnotation>
    <ex:isLocatedAtC>The Ultimate Gate</ex:isLocatedAtC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Through_the_Gates_of_the_Silver_Key"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#E._Hoffmann_Price"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Howard_Phillips_Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Bride_of_the_Yellow_King">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Bride of the Yellow King</rdfs:label>
    <ex:hasAnnotation>The other: encounters with the cthulhu mythos is book 3 in the nyarlathotep cycle . It is the fifth instalment of the series and is set in 2021 . It is a rogue mission to confront the fears of her past . She is aided in her escape by a group of silent mi-go . They pass her an artefact containing an enormous amount of energy .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Troy_Young"/>
    <ex:hasCountryOfOriginW>Canada</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Nyarlathotep_Cycle"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Other:_Encounters_with_the_Cthulhu_Mythos_Book_3"/>
    <ex:wasPublishedOnW>2021</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Belasco">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Belasco</rdfs:label>
    <ex:hasAnnotation>A 13th century sorcerer from florence, italy who contacted the elder gods and made a pact with them . Kidnapped dante's beloved, took her to pangea, and raped her to produce a new race of demons . When she died giving birth, an enraged dante attacked him and during the fighting he ended up placed in suspended animation .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Horse_Latitudes"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#X-Men:_Black_Sun"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#X-Men:_Soul_Killer"/>
    <ex:hasAppearanceC>Chutes</ex:hasAppearanceC>
    <ex:hasAppearanceC>Ladders</ex:hasAppearanceC>
    <ex:hasAppearanceC>Magik (Illyana</ex:hasAppearanceC>
    <ex:hasAppearanceC>Storm Limited Series)</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC>Ka-Zar the Savage Vol 1 11</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Bruce Jones</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Donovan">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Donovan</rdfs:label>
    <ex:ceasedOnC>1925</ex:ceasedOnC>
    <ex:hasAnnotation>Overview is a fictional character created by h. p. lovecraft . He makes his only appearance in the 1928 short story " the call of cthulhu " overview was a member of the schooner emma of auburn .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Call_of_Cthulhu"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Thing_in_the_Vault">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Thing in the Vault</rdfs:label>
    <ex:hasAnnotation>Shadows from norwood is a short story by british author david hambling . It was published in the 2013 collection of his own works shadows from norwood . Containing no direct references to either the works of h.p. Lovecraft or the cthulhu mythos .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#David_Hambling"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Shadows_from_Norwood"/>
    <ex:wasPublishedOnW>July 2013</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kate_Winthrop">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Kate Winthrop</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Miskatonic_University"/>
    <ex:hasAlternativeNamesC>The Scientist</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The scientist is a character created by fantasy flight games for the second edition of cthulhu mythos board game arkham horror . She is a researcher in the physics department at miskatonic university during the late 1920s . Since then she has devoted her time to creating a weapon with which to combat the creatures she now know lurk just out of sight .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Arkham_Horror_Second_Edition_Core_Set"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cold_Air">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cold Air</rdfs:label>
    <ex:hasAnnotation>A tongue-in-cheek cthulhu mythos short story by sean hoade . When burial plot salesman phil howard is seduced by beautiful cultist jane doe, she attempts to cast a carnal ritual to summon the essence of her dark god into the man's body .</ex:hasAnnotation>
    <ex:hasAuthorW>Sean Hoade</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Necronomicum: The Magazine of Weird Erotica</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Swedish_Cults">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Swedish Cults</rdfs:label>
    <ex:hasAnnotation>Svenska kulter ) Anders Fager English, translated from Swedish Genre(s) Cthulhu Mythos Valancourt Books English Release date September 6, 2022 232 is collection of Cthulhu Mythos stories by Anders Fager , originally published in Swedish as Svenska kulter (Wahlström &amp; Widstrand, 2009). The English- version was published by Valancourt Books in 2022. "The Furies from Boras," "Fragment I," and "Grandma's Journey" were translated into English by Henning Koch, and revised by James D. Jenkins and Anders Fager. The other stories were translated by Ian Lemke. Contents "The Furies from Boras" "Fragment I" "Grandma's Journey" "Fragment II" "The Broken Man's Wish" "Fragment III" "Happy Forever on Östermalm" "Fragment IV" "Miss Witt's Great Work"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Anders_Fager"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasPageCountW>232</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>translated from Swedish</ex:isInLanguageW>
  </rdf:Description>
