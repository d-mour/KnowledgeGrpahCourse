    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Doug Draa</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Editor Ohio, USA United States Horror http://uncledougsbunkerofhorror.blogspot.com/ Douglas "Doug" Draa is an American editor and occasional author who has worked extensively for Wildside Press , particularly on their Weirdbook / Megapack lines. Selected Bibliography Editor The Fall of Cthulhu (2015) The Fall of Cthulhu Volume II (2015) Weirdbook Annual 2 (2019) The Third Cthulhu Mythos Megapack (2019) External Links at the Internet Speculative Fiction Database</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Ohio</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>http://uncledougsbunkerofhorror.blogspot.com/</ex:hasWebsiteR>
