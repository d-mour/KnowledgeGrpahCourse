  <rdf:Description rdf:about="http://example.org/lovecraft#Crom_Cruach">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Crom Cruach</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>(possibly Pan</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Crom</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Khnum</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Nyarlathotep)</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Bloody Crooked One</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Horned Ram</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Lord of the Wood</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>A god from irish mythology, an inspiration for robert e. howard's fictional god crom . Created by brian mcnaughton in his novel downward to darkness . Described as a giant worm or dragon-like creature .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Downward_to_Darkness"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Brian_McNaughton"/>
