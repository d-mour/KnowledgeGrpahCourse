  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shadow_of_the_Unnamable">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleFilmAndTelevisionAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Shadow of the Unnamable</rdfs:label>
    <ex:hasAnnotation>Based on " The Unnamable " Sascha Renninger H. P. Lovecraft (original story) Sascha Renninger (screenplay) Release date 17 September 2011 Running time 16 minutes Germany English is a 2011 short fantasy-horror movie screenwritten and directed by Sascha Renninger, and running to a total of 16 minutes. It is a reasonably faithful adaptation of the H. P. Lovecraft short story " The Unnamable ", centred around the recurring semi-autobiographical character of Randolph Carter . Gallery</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>Germany</ex:hasCountryOfOriginW>
    <ex:hasWriterW>http://example.org/lovecraft#H._P._Lovecraft Sascha Renninger</ex:hasWriterW>
    <ex:isBasedOnW>The Unnamable</ex:isBasedOnW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>17 September 2011</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Folks_One_Meets_in_Innsmouth">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Folks One Meets in Innsmouth</rdfs:label>
    <ex:hasAnnotation>Full story online here Ron Shiflet United States English Publication date September 1997 " " is a poem by American Ron Shiflet . Synopsis The work is a brief commentary on the citizens of the degenerate New England town of Innsmouth . Publication History "" was first published in the online fanzine Nightscapes in September 1997. It later appeared in the collection Innsmouth Tales - 2000 , which Shiflet co-edited with Ran Cartwright . Trivia Ron Shiflet dedicated this work to Franklyn Searight , whose series of poems Folks of Innsmouth was the clear inspiration behind it (both Searight and Folks of Innsmouth are in fact mentioned in the piece).</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>September 1997</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#isPublishedAsW">
