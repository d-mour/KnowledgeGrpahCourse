    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Organisation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Black_Lotus">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Black Lotus</rdfs:label>
    <ex:hasAnnotation>Sociocultural Characteristics Xuthal Real World Information First appearance CIRCLE : " The Slithering Shadow " CIRCLE : "" Created by Robert E. Howard The is a fictional plant created by the late American author Robert E. Howard for his 1933 short story "The Slithering Shadow." Description A mysterious plant with hallucinogenic and esoteric properties, the was notably cultivated in ancient Xuthal ( CIRCLE : " The Slithering Shadow ", Robert E. Howard ), and prior to that in Acheron and Stygia ( EXP : "Dreams of the ", Lin Carter ). According to at least one source, it is still grown by the Tcho-Tcho People on the Plateau of Sung ( EXP : " Dope War of the Black Tong ", Robert M. Price ).</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Slithering_Shadow"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Howard_Lovecraft_%26_the_Squid_Kids">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Howard Lovecraft &amp; the Squid Kids</rdfs:label>
    <ex:hasAnnotation>Bruce Brown Sean Patrick O'Reilly English Howard Lovecraft Arcana Studio Publication date May 2016 " " is a children's Cthulhu Mythos comic book story, written by Bruce Brown and Sean Patrick O'Reilly, with artwork by Chris Uminga. It was published by Arcana Studio in May 2016. Overview Synopsis Howard Lovecraft , Spot , and the Squid Kids play in the snow and learn a valuable lesson about listening to your elders when one of the youngsters attempt to chase a small creature into a cave inhabited by a dangerous Shoggoth . Behind the Mythos "" was published in a short anthology collection for 2016's Free Comic Book Day.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Bruce_Brown"/>
    <ex:hasAuthorW>Sean Patrick O'Reilly</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Howard Lovecraft</ex:isPartOfSeriesW>
    <ex:wasPublishedOnW>May 2016</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tricks_No_Treats">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Tricks No Treats</rdfs:label>
    <ex:hasAnnotation>Paul Dale Anderson United States English Genre(s) Horror Wildside Press Weirdbook Annual 2 date February 2019 " " is a short story by the late American Paul Dale Anderson . Synopsis A patient in a lunatic asylum relates the tale of how he travelled to Arkham , Massachusetts on Halloween night with the hope of finding a mystic portal which would allow him to talk to his dead wife. However, the portal spews forth a gaggle of immature Shoggoths which pursue him through the city streets and rob him of his sanity. History "" was published posthumously in the Wildside Press collection Weirdbook Annual 2 in February 2019.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Paul_Dale_Anderson"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Weirdbook Annual 2</ex:isPublishedAsW>
    <ex:wasPublishedOnW>February 2019</ex:wasPublishedOnW>
  </rdf:Description>
