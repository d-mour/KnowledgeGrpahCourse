  <rdf:Description rdf:about="http://example.org/lovecraft#Daoth-Yhol">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Daoth-Yhol</rdfs:label>
    <ex:hasAnnotation>First appearance " The Arctic Stone " Created by Ross F. Bagby is an enigmatic figure created by Ross F. Bagdy in his short story, " The Arctic Stone ". Older than R'lyeh , it has lived on Earth long before Zagguwa arrived and the Ubbo-Sathla sloughed, and it is considered to be Cthulhu 's deadly enemy. It can be summoned by an elliptical grey stone, which was stolen by a shaman from a dark tower run by three-toed eyeless creatures. This stone was eventually inherited by his great-grandson, the shaman of an Inuit tribe in the West Greenland coast that worshipped Cthulhu, whom kept it in a box out of fear and regarded it as an object of taboo. ( EXP : " The Arctic Stone ")</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Arctic_Stone"/>
    <ex:wasCreatedByC>Ross F. Bagby</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Raandaii-Bnk">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Raandaii-B'nk</rdfs:label>
    <ex:hasAlternativeNamesC>The Father of All Sharks</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Father of All Sharks Current location The Bermuda Triangle First appearance " From the Deep and Beyond " Created by Gregory Nicoll is the god of the Raandeese , and it is said he created sharks in his own image. There is an undersea temple within the Bermuda Triangle, known as the "Cathedral of ". Gallery</ex:hasAnnotation>
    <ex:isLocatedAtC>The Bermuda Triangle</ex:isLocatedAtC>
    <ex:madeFirstAppearanceOnC>Beyond</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>From the Deep</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Gregory_Nicoll"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Other:_Encounters_with_the_Cthulhu_Mythos_Book_2">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Other: Encounters with the Cthulhu Mythos Book 2</rdfs:label>
    <ex:hasAnnotation>The other: encounters with the cthulhu mythos book 3 is the second book in the nyarlathotep cycle by canadian troy young . It picks up with harjit singh of the department of extraordinary phenomena recruiting a new field agent, firefighter malcolm mayweather . It details mayweather's struggle with the reality of the cthulhu mythos and the negative effects - both physical and psychological - that exposure to it has upon him</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Troy_Young"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>327</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Nyarlathotep_Cycle"/>
    <ex:wasReleasedOnW>2020</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Christine_Morgan">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Christine Morgan</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Birth Date 20 March 1967 La Mirada, California, USA American https://christinemariemorgan.wordpress.com/ is an American short fiction author, novelist, games designer and editor. Her work includes several stories set in the greater Cthulhu Mythos inspired by the works of H. P. Lovecraft and others. Selected Bibliography Short Fiction " The Mindhouse " (2014) " The Ithiliad " (2014) "Fecunditati Augustae" (2015) " Thought He Was a Goner " (2015) "Professor Patriot and the Doom That Came to Niceville" (2015) "Brickwalk Mollies" (2016) " The Keeper of Memory " (2017) " The Very Black Goat " (2022) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA http://example.org/lovecraft#California La Mirada</ex:hasBirthplaceR>
    <ex:hasNationalityR>American</ex:hasNationalityR>
    <ex:hasWebsiteR>https://christinemariemorgan.wordpress.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>20 March 1967</ex:wasBornOnR>
  </rdf:Description>
