    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>November Skies</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft English Genre(s) Non-fiction Donald M. Grant To Quebec and the Stars Date of writing November 1915 date 1976 " " is a short non-fiction work by the late American Howard Phillips Lovecraft . Although it was written in November 1915, it did not see until its inclusion in L. Sprague de Camp 's 1976 collection To Quebec and the Stars . It does not appear to have been republished in the years since . References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
