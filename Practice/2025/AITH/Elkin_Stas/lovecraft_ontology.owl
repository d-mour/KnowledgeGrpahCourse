    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Potential</rdfs:label>
    <ex:hasAnnotation>The short story was published by arkham house in 1973 . It is set in the expanded cthulhu mythos .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
    <ex:hasGenreW>Horror Short Fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Demons_by_Daylight"/>
    <ex:wasPublishedOnW>1973</ex:wasPublishedOnW>
