    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dagon (Armand Rosamilia)</rdfs:label>
    <ex:hasAnnotation>"dagon" is a short cthulhu mythos story by american armand rosamilia . It forms the fourth part in his keyport cthulhu story cycle . Characters include tina, the highly-religious daughter of a church minister .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Armand_Rosamilia"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
