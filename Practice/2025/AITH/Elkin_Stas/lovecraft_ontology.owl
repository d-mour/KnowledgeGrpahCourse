  <rdf:Description rdf:about="http://example.org/lovecraft#A_Dreamer_and_a_Visionary:_H._P._Lovecraft_in_His_Time">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Dreamer and a Visionary: H. P. Lovecraft in His Time</rdfs:label>
    <ex:hasAnnotation>S. T. Joshi Cover Artist Salvator Rosa English Liverpool Science Fiction Texts and Studies Genre(s) Non-fiction Liverpool University Press Release Date April 2001 is a biography of Lovecraft by prominent scholar and critic S. T. Joshi . Overview was published in April 2001 by Liverpool University Press as part of their Liverpool Science Fiction Texts and Studies . It is a condensed version of Joshi's 1996 biography H. P. Lovecraft: A Life .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#S._T._Joshi"/>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
