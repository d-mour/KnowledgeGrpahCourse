    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>In the Walls of Eryx</rdfs:label>
    <ex:hasAnnotation>H. p. lovecraft and kenneth sterling wrote the story in january 1936 . It was first published in weird tales magazine in october 1939 . After lovecraft's death, it was resubmitted and finally published .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Howard_Phillips_Lovecraft"/>
