  <rdf:Description rdf:about="http://example.org/lovecraft#Carolyn_Fern">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Carolyn Fern</rdfs:label>
    <ex:hasAffiliationC>Rhode Island Hospital Butler Hospital The Lemarchand Institute</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Psychiatrist</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The psychologist is a character created by chaosium for their board game . She is also known as the psychiatrist allopathic psychiatrist at the lemarchand institute . The name of the lemarchand institute is a possible nod to the hellraiser franchise .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Arkham_Horror"/>
