    <rdfs:label>Whatever Happened to Alicia Thorne?</rdfs:label>
    <ex:hasAnnotation>Whatever happened to alicia thorne? Is a short scenario supplement for chaosium 's call of cthulhu horror roleplaying game . Written by stephanie mcalea , chitin proctor , and sean f. smith . Published by third-party content provider .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Chitin_Proctor"/>
