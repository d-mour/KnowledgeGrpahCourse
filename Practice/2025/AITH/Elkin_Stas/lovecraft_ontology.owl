  <rdf:Description rdf:about="http://example.org/lovecraft#Tales_from_the_Miskatonic_University_Library">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Tales from the Miskatonic University Library</rdfs:label>
    <ex:hasAnnotation>Darrell Schweitzer and John Ashmead, editors Cover Artist J. K. Potter English Genre(s) Cthulhu Mythos PS Publishing Release Date February 2017 219 is an anthology of Cthulhu Mythos stories with a special focus on Miskatonic University 's library and its forbidden tomes . It was edited by Darrell Schweitzer and John Ashmead, and published by PS Publishing in 2017. Contents "Introduction" (essay) by John Ashmead "Another Introduction" (essay) by Darrell Schweitzer "Slowly Ticking Time Bomb" by Don Webb "The Third Movement" by Adrian Cole "To Be in Ulthar on a Summer Afternoon" by Dirk Flinthart "Interlibrary Loan" by Harry Turtledove "A Trillion Young" by Will Murray "The Paradox Collection" by A. C. Wise "The Way to a Man's Heart" by Marilyn "Mattie" Brahen "The White Door" by Douglas Wynne "One Small Change" by P. D. Cacek "Recall Notice" by Alex Shvartsman "The Children's Collection" by James Van Pelt "Not in the Card Catalog" by Darrell Schweitzer "The Bonfire of the Blasphemie" by Robert M. Price</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Darrell_Schweitzer"/>
    <ex:hasAuthorW>John Ashmead</ex:hasAuthorW>
    <ex:hasAuthorW>editors</ex:hasAuthorW>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasPageCountW>219</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>February 2017</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Creature_In_The_Waxworks">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Creature In The Waxworks</rdfs:label>
    <ex:hasAnnotation>Horror horrors &amp; abominations: 24 tales of the cthulhu mythos is a short story by mark mclaughlin and michael sheehan, jr. . A man living adjacent to a waxwork museum befriends an alien mi-go living in the building's basement . The creature transfers its brain into the body of the museum's owner and he chops up the mi-go's own body .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mark_McLaughlin"/>
    <ex:hasAuthorW>Michael Sheehan. Jr.</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Abominations: 24 Tales of the Cthulhu Mythos</ex:isPublishedAsW>
    <ex:isPublishedAsW>Horrors</ex:isPublishedAsW>
    <ex:wasPublishedOnW>December 2018</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yuggoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Planets"/>
    <rdfs:label>Yuggoth</rdfs:label>
    <ex:hasAnnotation>Mi-go is a race of fungoid, crustacean-like extraterrestrials . It is a major stopping-off point for the great old ones on their way to earth . Has its own mini-solar system including zaman, nithon, and the binary planet thog and thok .</ex:hasAnnotation>
    <ex:hasAppearanceL>Medusa's Coil The Horror in the Museum Through the Gates of the Silver Key Out of the Aeons The Haunter of the Dark The Isle of Dark Magic The Secret of Kralitz</ex:hasAppearanceL>
    <ex:hasTypeL>Planet</ex:hasTypeL>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#Glaaki"/>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#Hziulquoigmnzhah"/>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#Mi-Go"/>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#Rhan-Tegoth"/>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#Tsathoggua"/>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#Zstylzhemgni"/>
    <ex:isInhabitedByL>Ghizghuth</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Solar_System"/>
    <ex:madeFirstAppearanceOnL>Fungi from Yuggoth The Whisperer in Darkness</ex:madeFirstAppearanceOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Low_Red_Moon">
