  <rdf:Description rdf:about="http://example.org/lovecraft#Pax_Cthuliana">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Pax Cthuliana</rdfs:label>
    <ex:hasAnnotation>Pax cthulhiana is a stand-alone scenario involving the awakening of great cthulhu himself . Released alongside the supplement are a set of handouts available for free, and a soundtrack of specially created music to accompany gaming sessions .</ex:hasAnnotation>
    <ex:hasAuthorW>Even V. Røssland</ex:hasAuthorW>
    <ex:hasAuthorW>Jarle Haktorson</ex:hasAuthorW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>72</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2017</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#England">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>England</rdfs:label>
    <ex:hasAnnotation>Lovecraft was a strong admirer of english culture, with several english writers being strong influences on his work . Appears occasionally in lovecraft's fiction, notably in " the rats in the walls " and " arthur jermyn "</ex:hasAnnotation>
    <ex:hasAppearanceL rdf:resource="http://example.org/lovecraft#The_Rats_in_the_Walls"/>
    <ex:hasAppearanceL>Facts Concerning the Late Arthur Jermyn</ex:hasAppearanceL>
    <ex:hasAppearanceL>His Family</ex:hasAppearanceL>
    <ex:hasAppearanceL>The Hound</ex:hasAppearanceL>
    <ex:hasTypeL>Country</ex:hasTypeL>
