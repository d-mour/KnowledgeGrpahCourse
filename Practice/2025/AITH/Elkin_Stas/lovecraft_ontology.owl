    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Alone Against the Flames</rdfs:label>
    <ex:hasAnnotation>Gavin Inglis Gavin Inglis Cover Artist Petr Štovik United States English Call of Cthulhu Genre(s) Horror Chaosium Release Date August 2016 Media Type Print Digital (PDF) 48 is a solo-play introductory adventure for Chaosium 's Call of Cthulhu horror roleplaying game. Overview Designed in a similar way to the Fighting Fantasy and Choose Your Own Adventure books popular in the 1980's, is intended to teach new players the basics of Call of Cthulhu whilst giving a taste of the games' atmosphere. As both the core rules and are available as free downloads on the Chaosium website, all players need supply is a pencil, paper and dice. Publication History was first released in August 2016 and is available in both print and free digital (PDF) versions. Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Gavin_Inglis"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>48</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>August 2016</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Challenger_to_Great_Old_Ones">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Challenger to Great Old Ones</rdfs:label>
    <ex:hasAnnotation>Manga originally ran from 1988 to 1993 in the monthly comic nora magazine . Collected into 5 volumes in 2014, which were later translated into english . English translation was heavily criticized for being rough and hard to follow .</ex:hasAnnotation>
    <ex:hasAuthorW>Kentarou Yano</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>Japanese</ex:isInLanguageW>
    <ex:wasReleasedOnW>September 1988 - August 1993</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Even_Death_Can_Die">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Even Death Can Die</rdfs:label>
    <ex:hasAnnotation>Pelgrane press 368 is a scenario supplement for the roleplaying game cthulhu confidential . It was written by robin d. laws , chris spivey , and ruth tillman . Of the nine scenarios, six had been previously released as digital downloads .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Chris_Spivey"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robin_D._Laws"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ruth_Tillman"/>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>368</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Cthulhu_Confidential"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crypt_of_Cthulhu_Eastertide_1990">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crypt of Cthulhu Eastertide 1990</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Daryl Hutchinson United States English Crypt of Cthulhu Cryptic Publications Release Date April 1990 76 Preceded by Candlemas 1990 Followed by Roodmas 1990 was the 71st issue of Robert M. Price 's long-running Lovecraftian fanzine Crypt of Cthulhu . Edited by Price and featuring cover art by Daryl Hutchinson , it ran to 76 in an A5 format and was published by Cryptic Publications in April 1990 . The issue was subtitled The Brooding City: Stories of Cyclopean Horror , and was devoted to the Lovecraftian fiction of British John S. Glasby . Contents Editorial Shards by Robert M. Price "The Shadow over Redforde" by John S. Glasby "The Brooding City" by John S. Glasby "The Dweller Beyond the Gate" by John S. Glasby "A Shadow from the Aeons" by John S. Glasby "The Kh'yrog Tablets" by John S. Glasby Reviews by Robert M. Price and Stefan Dziemianowicz Letters by Allen Koszowski , Albert Roger, Donald R. Burleson, Ph.D , Jeff Leach, James Ambuehl , Michael Cisco , D. Shawn Small, Richard L. Tierney , Paul F. Lilienkamp, Simon MacCulloch, Bruce W. Timm, Robert Bloch , Thomas Ligotti , and L. Sprague de Camp References</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>76</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu"/>
    <ex:wasReleasedOnW>April 1990</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#David_E._Schultz">
    <rdf:type rdf:resource="http://example.org/lovecraft#Critics"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Scholars"/>
    <rdfs:label>David E. Schultz</rdfs:label>
    <ex:hasAnnotation>Non-fiction (born 30 october 1952) has been a lovecraft scholar for several decades . His contributions include a critique of spurious quotes attributed to h. p. lovecraft . He has also co-edited scholarly compilations of lovecraft's letters and other nonfiction compositions .</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Wisconsin Milwaukee</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Scholar</ex:isConnectedToMythosR>
    <ex:wasBornOnR>30 October 1952</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#My_Family">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>My Family</rdfs:label>
    <ex:hasAnnotation>Matt Spencer English Rogue Planet Press Lovecraftiana Vol 5, Issue 4 date 2021  " " is a short Lovecraftian story by Matt Spencer, first published in Vol 5, Issue 4 of the Lovecraftiana zine. Synopsis Two, men, one whose daughter has run away and the other recently bereaved, travel to a remote much-feared mountain village in search of the missing girl. There it is revealed that the girl, like her mother before her, is a member of a hostile eldritch race. The two are taken by the beings; one is soon released as a result of the tattooed ward which he bears, while the other is not so fortunate.</ex:hasAnnotation>
    <ex:hasAuthorW>Matt Spencer</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 4</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 5</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2021</ex:wasPublishedOnW>
  </rdf:Description>
