  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dagon_and_Other_Macabre_Tales">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dagon and Other Macabre Tales</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft United States English Genre(s) Horror Arkham House Release Date 1965 is a collection of works by the late American H. P. Lovecraft . Publication History First issued in a limited run of 3,471 by Arkham House in 1965, has since been reprinted many times by several different publishing houses, and has also been translated into French. Contents Introduction by August Derleth (later replaced by introductions by S. T. Joshi and T. E. D. Klein ) " Dagon " " The Tomb " " Polaris " " Beyond the Wall of Sleep " " The Doom That Came to Sarnath " " The White Ship " " Arthur Jermyn " " The Cats of Ulthar " " Celephaïs " " From Beyond " " The Temple " " The Tree " " The Moon-Bog " " The Nameless City " " The Other Gods " " The Quest of Iranon " " Herbert West--Reanimator " " The Hound " " Hypnos " " The Lurking Fear " " The Festival " " The Unnamable " " Imprisoned with the Pharaohs " " He " " The Horror at Red Hook " " The Strange High House in the Mist " " In the Walls of Eryx " " The Evil Clergyman " " The Beast in the Cave " " The Alchemist " " Poetry and the Gods " " The Street " " The Transition of Juan Romero " " Azathoth " " The Descendant " " The Book " " The Thing in the Moonlight " " Supernatural Horror in Literature " Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1965</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dreams_of_the_Docent">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dreams of the Docent</rdfs:label>
    <ex:hasAnnotation>Tales of the talisman was first published in the july 2015 edition of tales of the talisman (hadrosaur productions) it was later voted by the fanbase to be included in the anthology the best of lovecraftiana (2023, rogue planet press) the narrator experiences nightmares of the " blind and mindless daemon sultan at the very heart of ultimate chaos"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lee_Clark_Zumpe"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Tales of the Talisman</ex:isPublishedAsW>
    <ex:wasPublishedOnW>July 2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Howard_Phillips_Lovecraft:_Dreamer_on_the_Nightside">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Howard Phillips Lovecraft: Dreamer on the Nightside</rdfs:label>
    <ex:hasAnnotation>Dreamer on the nightside is a biography written by lovecraft 's friend and contemporary, frank belknap long . The book was first published by arkham house in 1975 . It has also been translated into italian, german and greek .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Frank_Belknap_Long"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:hasPageCountW>237</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:isInLanguageW>Greek</ex:isInLanguageW>
    <ex:isInLanguageW>Italian</ex:isInLanguageW>
    <ex:wasReleasedOnW>1975</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecraft_in_Brooklyn_%28song%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Audio"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraft in Brooklyn (song)</rdfs:label>
    <ex:hasAnnotation>"lovecraft in brooklyn" is a song on the mountain goats' 2008 album heretic pride . The song refers to h. p. lovecraft's time in new york city . The lyrics are filled with images of urban decay and paranoia, punctuated with the song's title as a refrain .</ex:hasAnnotation>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Heretic Pride</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2008</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Catskill_Mountains">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Catskill Mountains</rdfs:label>
    <ex:hasAnnotation>Southeastern New York State , USA Mountains Joe Slater Peter Slader First appearance HPL : " Beyond the Wall of Sleep " The , also known as the Catskills , are a range of mountains in southeastern New York State , and are a subrange of the larger Appalachian Mountains. Lovecraft's Fiction Joe Slater lived in a backwoods community of generational hill dwellers in the Catskills before he was confined to a mental hospital for his killing of Peter Slader . ( HPL : " Beyond the Wall of Sleep ")</ex:hasAnnotation>
    <ex:hasTypeL>Mountains</ex:hasTypeL>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#Joe_Slater"/>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#Peter_Slader"/>
    <ex:isLocatedAtL>Southeastern New York State</ex:isLocatedAtL>
    <ex:isLocatedAtL>USA</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#Beyond_the_Wall_of_Sleep"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Pierre_Comtois">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonFictionAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Pierre Comtois</rdfs:label>
    <ex:hasAnnotation>Pseudonym(s) Pierre V. Comtois P. R. McBride Connection to the Mythos Author Editor Lowell, Massachusetts, United States United States http://www.pierrevcomtois.com/ is an American editor and author in the fields of horror, science fiction, fantasy and non-fiction. He has written a number of pieces set within the Cthulhu Mythos inspired by the works of H. P. Lovecraft and others. Selected Bibliography Editor Chronicles of the Cthulhu Codex (1985-2000) Short Fiction "Zzzzzzzz!" (1985) " Footsteps in the Sky " (1986) "What the Sea Gives Up" (1987) "Dreams of Yig" (1989) " The Country of the Wind " (1994) "The King in Yellow" (1994) "The Pallid Masque" (1996) "Take Care of What You Seek" (1996) "The Deep Cellars" (2002) " Goat-Mother " (2004) "The Old Ones' Signs" (2006) "Question of Meaning" (2013) "The Secret Name (2015) "High and Dry" (2015) "The Legacy of Acheron" (2015) "Aqua Salaria" (2015) "Second Death" (2015) "Final Plea" (2015) "Masks of the Puppet Lords" (2015) External Links at the Internet Speculative Fiction Datatbase</ex:hasAnnotation>
    <ex:hasBirthplaceR>United States http://example.org/lovecraft#Massachusetts Lowell</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasPseudonymR>P. R. McBride</ex:hasPseudonymR>
    <ex:hasPseudonymR>Pierre V. Comtois</ex:hasPseudonymR>
    <ex:hasWebsiteR>http://www.pierrevcomtois.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Goatswood_Gnome">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Goatswood Gnome</rdfs:label>
    <ex:hasAlternativeNamesC>Garden Gnome</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Garden Grim</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Little Folk</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Night Comers</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Red Caps</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Goatswood gnomes are fictional creatures created by ramsey campbell in the story " made in goatswood ", and later used by chaosium for the call of cthulhu role-playing game . Some believe the dark mother with a thousand young, shub-niggurath, or her children imbue life into these vessels . The awakening of these small, stone monsters may be linked to the cycles of the moon, and they may be able to function only at specific times</ex:hasAnnotation>
    <ex:hasDistinctionC>Loathsome things</ex:hasDistinctionC>
    <ex:hasDistinctionC>crooked noses</ex:hasDistinctionC>
    <ex:hasDistinctionC>mocking smiles</ex:hasDistinctionC>
    <ex:hasDistinctionC>pointed teeths</ex:hasDistinctionC>
    <ex:hasDistinctionC>wearing beards</ex:hasDistinctionC>
    <ex:hasDistinctionC>with hideous eyes</ex:hasDistinctionC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Made_in_Goatswood"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Name_and_Number">
    <rdf:type rdf:resource="http://example.org/lovecraft#BrianLumleyWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Name and Number</rdfs:label>
    <ex:hasAnnotation>"de marigny's clockthe black recalled" is a cthulhu mythos story by brian lumley . It first appeared in the july 1982 issue of the anglo-italian fanzine kadath . Written in 1981, it features the occult investigator titus crow .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Titus_Crow"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Kadath"/>
    <ex:wasPublishedOnW>July 1982</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>1981</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Rise_of_Cthulhu_%28Dragon_King_Games%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Rise of Cthulhu (Dragon King Games)</rdfs:label>
    <ex:hasAnnotation>Rise of Cthulhu (Dragon King Games) Chuck D. Yager Dragon King Games Publication Date 2015 Competitive card game Rise of Cthulhu is a quick-play competitive card game based on the Cthulhu Mythos . Overview Behind the Mythos Released after a successful Kickstarter campaign in 2015, Rise of Cthulhu is a competitive card game for 2 players with a projected play time of around 30 minutes. It was designed by Chuck D. Yager, features artwork from James Daly III, and was published by Dragon King Games. An expansion set, Rise of Cthulhu: Dark Secrets was released in 2016. Gallery</ex:hasAnnotation>
    <ex:wasPublishedOnW>2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Parchments_of_Pnom">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Parchments of Pnom</rdfs:label>
    <ex:hasAnnotation>The were created by clark ashton smith for his hyperborean cycle series of weird fantasy stories . They have also been incorporated into the cthulhu mythos . Smith used the to more definitively integrate his own pantheon of gods with that created by h. p. lovecraft .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_Coming_of_the_White_Worm"/>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nkai">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>N'kai</rdfs:label>
    <ex:hasAnnotation>Colossal underground cavern located beneath the subterranean nation of k'n-yan in h. p. lovecraft 's cthulhu mythos . Known to be the current residence of the great old one tsathoggua and its guardians, the formless spawn .</ex:hasAnnotation>
    <ex:hasAppearanceL>HPL The Whisperer in Darkness</ex:hasAppearanceL>
    <ex:hasNotableFeatureL>Barren Plains</ex:hasNotableFeatureL>
    <ex:hasTypeL>Subterranean Cavern</ex:hasTypeL>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#Formless_Spawn"/>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#Tsathoggua"/>
    <ex:isLocatedAtL>Beneath K'n-yan</ex:isLocatedAtL>
    <ex:isLocatedAtL>Oklahoma</ex:isLocatedAtL>
    <ex:isLocatedAtL>United States</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Mound"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Malcolm_Mayweather">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Malcolm Mayweather</rdfs:label>
    <ex:ceasedOnC>in the South Pacific 2021</ex:ceasedOnC>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Department_of_Extraordinary_Phenomena"/>
    <ex:hasAnnotation>Mayweather is a character created by canadian author troy young . Created for his nyarlathotep cycle series of cthulhu mythos stories . Was exposed to radiation in a temple to nyarlathotep which caused him to develop a highly-aggressive form of cancer . A relationship had begun to form between him and junior agent charlene hines; this was cut short with the death of both parties .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Rat_King"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Troy_Young"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Eliza">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Eliza</rdfs:label>
    <ex:hasAnnotation>Josh Reynolds English The Lovecraft eZine #10 date January 2012 " " is a short Cthulhu Mythos story by American Josh Reynolds . It was first published in The Lovecraft eZine #10 in January 2012. Synopsis In the last surviving city on Earth , Pnakotus , Whateley has been created using genetic material gathered from Whateley, Marsh and Jermyn stock as a weapon to be used against the forces of the Cthulhu Mythos which run rampant through the outside world. When escapes her captivity, the ruler of Pnakotus uses every means at her disposal to bring the girl back under her control, including deploying the time- and dimension-hopping Tind'losi . However, is stronger then even her creator suspected: breaching the mystical barriers set up to protect the city, she is brought into the fold of the vast, watching entities which now call Earth their own… History The Lovecraft eZine #10 (2012) The Lovecraft eZine Presents Making the Cut (2014) Apotheosis: Stories of Human Survival After the Rise of the Elder Gods (2015)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Josh_Reynolds"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>The Lovecraft eZine #10</ex:isPublishedAsW>
    <ex:wasPublishedOnW>January 2012</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Amon-Gorloth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Amon-Gorloth</rdfs:label>
    <ex:hasAlternativeNamesC>Creator of the Nile</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Universe's Equilibrium</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as creator of the nile universe's equilibrium current location buried under the ground in the sahara desert powers and abilities reality warping . Fictional deity created by david calvo for the call of cthulhu scenario "les yeux d'amon"</ex:hasAnnotation>
    <ex:isLocatedAtC>Buried under the Sahara Desert</ex:isLocatedAtC>
    <ex:madeFirstAppearanceOnC>Les Yeux d'Amon</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>David Calvo</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Barren_%28chapbook%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Barren (chapbook)</rdfs:label>
    <ex:hasAnnotation>Barren Armand Rosamilia United States English Keyport Cthulhu Genre(s) Weird fiction Rymfire Press Release Date July 2012 29 Barren is a Cthulhu Mythos chapbook by American Armand Rosamilia . Overview Containing only the Keyport Cthulhu story " Barren ", the book runs to a total of 29 including notes. It was released solely as a digital download on Amazon's Kindle platform by Rymfire Press in July 2012. Although Barren is no longer available as an individual book, the story is contained in the collection Keyport Cthulhu , again only through Amazon Kindle.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Armand_Rosamilia"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:hasPageCountW>29</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Keyport_Cthulhu"/>
    <ex:wasReleasedOnW>July 2012</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Byakhee">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonSapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ServitorRaces"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Byakhee</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Hastur"/>
    <ex:hasAlternativeNamesC>Servants of He Not To Be Named</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Star Lizards</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Void Steeds</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Winged Things</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>August derleth are fictional creatures in the cthulhu mythos . They are predators who are known to travel in the vacuum of interstellar space . Believed to serve hastur the unspeakable and may be summoned to partake in rituals .</ex:hasAnnotation>
    <ex:hasAppearanceC>The Watcher from the Sky The Gorge Beyond Salapunco The Keeper of the Key The Acolyte of the Flame S. Petersen's Field Guide to Cthulhu Monsters Pathfinder Feeders from Within</ex:hasAppearanceC>
    <ex:hasDistinctionC>Claws</ex:hasDistinctionC>
    <ex:hasDistinctionC>Leathery wings</ex:hasDistinctionC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Festival"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_House_on_Curwen_Street"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#HorrorScopes">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>HorrorScopes</rdfs:label>
    <ex:hasAnnotation>Unknown English Oscillate Wildly Press The Asylum Diaries: Arkham date May 2019 " " is a short parody piece by an uncredited writer which makes reference to the Cthulhu Mythos . It appeared in the first issue of the short-lived horror periodical The Asylum Diaries , published by Oscillate Wildly Press in May 2019. Synopsis The piece is written in the style of a newspaper horoscope, with all of the entries being short, mysterious, and for the most part sinister. Two of the entries, Gemini and Cancer, mention Nyarlathotep and C'thulu respectively.</ex:hasAnnotation>
    <ex:hasAuthorW>Unknown</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Asylum_Diaries:_Arkham"/>
    <ex:wasPublishedOnW>May 2019</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Three_Deaths_of_Conan">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Three Deaths of Conan</rdfs:label>
    <ex:hasAnnotation>Gary Kwapisz Chuck Dixon Neil Hansen Timothy Truman Gary Kwapisz Flint Henry English Marvel Comics Release Date August 1990 Media Type Comic book '' is a story in issue #176 of the 1st volume of Savage Sword of Conan written by Chuck Dixon and Gary Kwapisz. Synopsis Conan of Cimmeria finds himself in the stronghold of a witch-man in Koth who shows him three possible futures, in one of which he ends up as a thrall of Dagon .</ex:hasAnnotation>
    <ex:hasAuthorW>Chuck Dixon</ex:hasAuthorW>
    <ex:hasAuthorW>Gary Kwapisz</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>August 1990</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Rlyeh_Text">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>R'lyeh Text</rdfs:label>
    <ex:hasAnnotation>The is a fictional grimoire created by august derleth . It first appeared in his short story " the return of hastur " . It was later featured in many other works of the expanded cthulhu mythos .</ex:hasAnnotation>
    <ex:hasAppearanceA rdf:resource="http://example.org/lovecraft#The_Whippoorwills_in_the_Hills"/>
    <ex:hasAppearanceA>Behind the Mask The Strange Doom of Enos Harker Lord of the Worms Down in Limbo The Advent of Uvhash Demonbane Fate</ex:hasAppearanceA>
    <ex:hasAppearanceA>Grand Order When the Dweller Awakes Shadow Hearts</ex:hasAppearanceA>
    <ex:hasAppearanceA>Zero Fate</ex:hasAppearanceA>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_Return_of_Hastur"/>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#August_Derleth"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Potowonket,_Maine">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Potowonket, Maine</rdfs:label>
    <ex:hasAnnotation>Winifred v. jackson is a fictional town created by lovecraft and winifred v. jackson as the setting for their short story " the green meadow " a meteorite landed in the waters off its coast on august 27, 1913 . The meteorite contained a journal, written in ancient greek, that related the astonishing tale of a man adrift in the cosmos .</ex:hasAnnotation>
    <ex:hasTypeL>Township</ex:hasTypeL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Maine"/>
    <ex:isLocatedAtL>United States</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Green_Meadow"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Case_of_Howard_Phillips_Lovecraft_of_Providence,_R._I.">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Case of Howard Phillips Lovecraft of Providence, R. I.</rdfs:label>
    <ex:hasAnnotation>The Case of Howard Phillips Lovecraft of Providence, R. I. Winfield Townley Scott United States English Genre(s) Non-fiction The Providence Journal date 1943 " The Case of Howard Phillips Lovecraft of Providence, R. I. " is a short non-fiction piece by the late American critic Winfield Townley Scott , first published in the newspaper The Providence Journal - for which Scott acted as literary editor - in 1943. It was published under the byline of W. T. Scott. History The Providence Journal (1943) Sword &amp; Fantasy #11 (2013)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Winfield_Townley_Scott"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>The Providence Journal</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1943</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#At_the_Mountains_of_Madness">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>At the Mountains of Madness</rdfs:label>
    <ex:hasAnnotation>The shadow over innsmouth is a novella by american horror writer h. p. lovecraft . It was originally serialized in the february, march, and april 1936 issues of astounding stories . The story is written in the first-person perspective by the geologist william dyer .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>novel</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Cthulhu Mythos</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Jason_C._Eckhardt">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Jason C. Eckhardt</rdfs:label>
    <ex:hasAnnotation>Eckhardt was a member of the informal group who referred to themselves as the " providence pals ", like-minded lovecraft devotees who shared their enthusiasm from the late 1970s through to the 1990s . He has created many images for cthulhu mythos and lovecraftian publications, the majority of which have been through indie publisher necronomicon press .</ex:hasAnnotation>
    <ex:hasWebsiteR>http://www.eck-art.net/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Artist</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>25 December 1958</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Howard_Wandrei">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Howard Wandrei</rdfs:label>
    <ex:diedOnR>1956</ex:diedOnR>
    <ex:hasAnnotation>Younger brother of Donald Wandrei, premier weird artist and prolific author of weird fiction, science fiction, and detective stories; correspondent of Lovecraft.</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1909</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tenoka">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Tenoka</rdfs:label>
    <ex:hasAccessibilityL>Road</ex:hasAccessibilityL>
    <ex:hasAnnotation>A small town and it’s surrounding environs created by american author ron shiflet as a setting for several of his mythos works . It appears to consist primarily of remote backwoods populated by insular countryfolk and seldom visited by outsiders .</ex:hasAnnotation>
    <ex:hasNotableFeatureL>Big Moccasin River</ex:hasNotableFeatureL>
    <ex:hasNotableFeatureL>Deaconsville</ex:hasNotableFeatureL>
    <ex:hasTypeL>Township</ex:hasTypeL>
    <ex:hasTypeL>surrounding area</ex:hasTypeL>
    <ex:isLocatedAtL>East Texas</ex:isLocatedAtL>
    <ex:isLocatedAtL>USA</ex:isLocatedAtL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#An_Index_to_the_Selected_Letters_of_H._P._Lovecraft">
