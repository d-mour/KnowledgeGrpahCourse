    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Dark Ages</rdfs:label>
    <ex:hasAnnotation>Call of cthulhu is a horror fiction role-playing game based on h.p. Lovecraft's cthulhu mythos set during the 10th century ad . The game is published by chaosium and was published in 2003 . It was based on an earlier iteration of the game setting called cthulhu 1000ad by stephane gesbert .</ex:hasAnnotation>
    <ex:hasAuthorW>Stephane Gesbert</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>Role-play</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
  </rdf:Description>
