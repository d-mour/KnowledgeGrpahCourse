    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Threshold</rdfs:label>
    <ex:hasAnnotation>321 followed by low red moon is a novel by caitlin r. kiernan . It introduces characters whose stories continue in low red moon (2003) and alabaster (2006) . It won the 2001 international horror guild award for best novel .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
    <ex:hasPageCountW>321</ex:hasPageCountW>
