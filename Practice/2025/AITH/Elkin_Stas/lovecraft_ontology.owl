  <rdf:Description rdf:about="http://example.org/lovecraft#Donald_R._Burleson">
    <rdf:type rdf:resource="http://example.org/lovecraft#Critics"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonFictionAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Donald R. Burleson</rdfs:label>
    <ex:hasAnnotation>Donald richard burleson is a fiction writer, literary critic, professional mathematician, and ufo researcher . His fiction has appeared in such collections as the new lovecraft circle , the azathoth cycle , the cthulhu cycle . His nonfiction books about ufos include the golden age of ufos, and the fall of j.r. oppenheimer .</ex:hasAnnotation>
    <ex:hasFullNameR>Donald Richard Burleson</ex:hasFullNameR>
    <ex:hasNationalityR>American</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Critic</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1941 December 31</ex:wasBornOnR>
  </rdf:Description>
