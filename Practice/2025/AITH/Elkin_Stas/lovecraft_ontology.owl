  <rdf:Description rdf:about="http://example.org/lovecraft#Mysteries_of_the_Worm_%28disambiguation%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Disambiguations"/>
    <rdfs:label>Mysteries of the Worm (disambiguation)</rdfs:label>
    <ex:hasAnnotation>Mysteries of the Worm may refer to: De Vermis Mysteriis , the fictional Cthulhu Mythos book created by author Robert Bloch . Mysteries of the Worm: Early Tales of the Cthulhu Mythos , a Chaosium Press collection of the Cthulhu Mythos works of Robert Bloch.</ex:hasAnnotation>
  </rdf:Description>
