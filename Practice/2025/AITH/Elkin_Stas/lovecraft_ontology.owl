  <rdf:Description rdf:about="http://example.org/lovecraft#Howard_Phillips_Lovecraft:_Memoirs,_Critiques_%26_Bibliographies">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Howard Phillips Lovecraft: Memoirs, Critiques &amp; Bibliographies</rdfs:label>
    <ex:hasAnnotation>Various United States English Genre(s) Non-fiction SSR Publications Release Date 1955 83 is a short collection of non-fiction pieces from a selection of H. P. Lovecraft scholars. Overview Consisting of eight works and running to a total of 83 , was edited by H. P. Lovecraft scholar George T. Wetzel and published by SSR Publications in 1955. It was reprinted in a truncated form as Commentaries later that same year. Contents " Idiosyncracies of HPL " by E. A. Adkins " A Few Memories " by James F. Morton " Ave Atque Vale " by Edward H. Cole " The Cthulhu Mythos: A Study " by George Wetzel " The Lord of R'yleh " by Matthew H. Onderdonk " HPL: The History " by Lin Carter " Amateur Press Works " by George Wetzel " Professional Works and Miscellany " by Robert E. Brineyy</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:hasPageCountW>83</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1955</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tulzscha">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OuterGods"/>
    <rdfs:label>Tulzscha</rdfs:label>
    <ex:hasAffiliationC>Outer Gods</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Green Flame</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The green flame is a fictional entity created by the late american author howard phillips lovecraft for his short story " the festival " . The name was applied retrospectively by chaosium in their malleus monstrorum monster manual supplement for the call of cthulhu roleplaying game .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Malleus_Monstrorum"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Festival"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Colour_Out_of_Space_%28DART_production%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAudioAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Colour Out of Space (DART production)</rdfs:label>
    <ex:hasAnnotation>The colour out of space is an audio adaptation of the short story of the same name by the h. p. lovecraft historical society . It is available as both a jewel-case compact disc and a digital download . As with all dark adventure radio theatre productions it is presented in the style of a 1930s radio broadcast .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Colour_Out_of_Space"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Daniel_Harms">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Scholars"/>
    <rdfs:label>Daniel Harms</rdfs:label>
    <ex:hasAnnotation>Harms is best known for the books the encyclopedia cthulhiana: a guide to lovecraftian horror and the necronomicon files . His work has appeared in publications such as the journal for the academic study of magic, abraxas, fortean times, and paranoia . He was the originator of the shadow over usenet , a detailed online discussion of the works of h. p. lovecraft .</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://danharms.wordpress.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Games designer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dead_but_Dreaming_2">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dead but Dreaming 2</rdfs:label>
    <ex:hasAnnotation>Various English Miskatonic River Press Release Date June 2011 298 Preceded by Dead But Dreaming is an anthology of Lovecraftian fiction edited by Kevin Ross and published by Miskatonic River Press in June 2011. It ran to a total of 298 . Overview Contents Foreword by Kevin Ross "The Call" by Rick Hautala "The Unfinished Basement" by William Meikle "Taggers" by Walt Jarvis "Plush Cthulhu" by Don Webb "Class Reunion" by Darrell Schweitzer "First Nation" by Scott David Aniolowski "Your Ivory Hollow" by W. H. Pugmire "The Spell of the Eastern Sea" by Michael Tice "Dark Heart" by Kevin Ross "Transmission" by T. E. Grau "N Is for Neville" by John Goodrich "The Timucuan Portal" by Daniel W. Powell "No Healing Prayers" by Joseph S. Pulver, Sr. "The Dissipation Club" by Adrian Tchaikovsky "Lure" by David Annandale "Christmas Carrion" by Donald R. Burleson "The Depopulation Syndrome" by Erik T. Johnson " Uncle Sid's Collection " by Cody Goodfellow "Father's Day" by Brian Sammons "Innsmouth Idyll" by Darrell Schweitzer "The Hour of Our Triumph" by Will Murray "Here Be Monsters" by Pete Rawlik Gallery</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>298</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>June 2011</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tentacles">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Tentacles</rdfs:label>
    <ex:hasAnnotation>A computer user discovers a "brotherhood" dedicated to returning the great old one hnarqu to life through the use of a computer virus . Hapless band of university students struggle to defeat the brotherhood's plan .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Peter_F._Guenther"/>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Nightscapes #3</ex:isPublishedAsW>
    <ex:wasPublishedOnW>September 1997</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mrs._Updike">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Mrs. Updike</rdfs:label>
    <ex:ceasedOnC>Early 20th century</ex:ceasedOnC>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Crawford_Tillinghast"/>
    <ex:hasAnnotation>Early 20th century Providence, Rhode Island Housekeeper Crawford Tillinghast Human First appearance HPL : " From Beyond " Created by H. P. Lovecraft was a housekeeper employed by the scientist Crawford Tillinghast . She was killed and her body disintegrated (along with the servant Gregory ) by a malevolent alien entity that was summoned as a result of Crawford's experiments involving the opening of dimensional gates. ( HPL : " From Beyond ")</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#From_Beyond"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Arkham_Sampler_Autumn_1949">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Periodicals"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Arkham Sampler Autumn 1949</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Ronald Clyne United States English The Arkham Sampler Arkham House Release Date Autumn 1949 128 Preceded by Summer 1949 Followed by Winter 1949 is the seventh issue of short-lived magazine The Arkham Sampler . Edited by H. P. Lovecraft ’s friend and contemporary August Derleth and featuring cover art by Ronald Clyne, it ran to a total of 128 and was published by Arkham House . Contents "The Triumph of Death" by H. Russell Wakefield "Calenture" by Clark Ashton Smith "Footnote to Dunne" by Anthony Boucher "Holiday" by Ray Bradbury "Pour Chercher du Nouveau" by Clark Ashton Smith "Journey to the World Underground" (Part 2 of 2) by Ludvig Holberg "The Death of Lovers" by Baudelaire "Escape" by Thomas H. Carter "Sidney Sime of Worplesdon" by Martin Gardner "Nightmare" by Erasmus Darwin "The Song of the Pewee" by Stephen Grendon "A Little Anthology" by Malcolm Ferguson "Abracadabra" by Leah Bodine Drake "The Rape of Things to Come" by Robert Bloch "Perhaps the Future" by John Haley "Nelson Bond's New Stories" by August Derleth "Anthropology and Fiction" by Everett F. Bleiler "A Contrasting Duo" by Fritz Leiber, Jr. "A Selected Shelf of Fantasy" by August Derleth "Two Views of the Future" by Frank Belknap Long Reviews by Robert Bloch, John Haley, August Derleth, Everett F. Bleiler, Fritz Leiber, Jr., Frank Belknap Long, and uncredited contributors External Links full issue online at the Internet Archive</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>128</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Arkham_Sampler"/>
    <ex:wasReleasedOnW>Autumn 1949</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#God_Does_Damn_the_Mind">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>God Does Damn the Mind</rdfs:label>
    <ex:hasAnnotation>Marc E. Fitch English 01Publishing Whispers from the Abyss Vol. 2: The Horrors That Are &amp; Shall Be date October 2015  " " is a short story by Marc E. Fitch, first published in the anthology of Lovecraftian fiction Whispers from the Abyss Vol. 2: The Horrors That Are &amp; Shall Be by 01Publishing in October 2015. Synopsis An orderly in a hospital psych ward notices one of his colleagues whispering into the ears of several patients shortly before their inexplicable deaths. Confronting the woman outside of work, he is overcome by an inhuman rage and murders her; at the moment of her death something dark passes between them, and the orderly heads out into the larger world to carry on the work of this malevolent entity.</ex:hasAnnotation>
    <ex:hasAuthorW>Marc E. Fitch</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Shall Be</ex:isPublishedAsW>
    <ex:isPublishedAsW>Whispers from the Abyss Vol. 2: The Horrors That Are</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Little_People_%28The_Transition_of_Titus_Crow%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Little People (The Transition of Titus Crow)</rdfs:label>
    <ex:hasAnnotation>Little People Sociocultural Characteristics Elysia Real World Information First appearance EXP : The Transition of Titus Crow Created by Brian Lumley The Little People are a fictional alien species created by Brian Lumley for his novel The Transition of Titus Crow . Description The Little People are one of the friendly species that Titus Crow meets in the extradimensional realm of Elysia . They are small, delicate, insect-like creatures with two pairs of multicolored wings and soft fur. ( EXP : The Transition of Titus Crow )</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Transition_of_Titus_Crow"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Where_the_Deep_Ones_Are">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Storybooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Where the Deep Ones Are</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft (original story) Kenneth Hite (adaptation) Andy Hopp English Genre(s) Children's Atlas Games Release Date August 2008 32 is a children's book, published by Atlas Games in 2008. It was written by Kenneth Hite and features illustrations by Andy Hopp. Part of the Mini Mythos series, the book is both an adaptation of H. P. Lovecraft 's The Shadow Over Innsmouth and a parody of Maurice Sendak's Where the Wild Things Are . Overview</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Kenneth_Hite"/>
    <ex:hasGenreW>Children's</ex:hasGenreW>
    <ex:hasPageCountW>32</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>August 2008</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Daemonic_Nathicana">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Daemonic Nathicana</rdfs:label>
    <ex:hasAnnotation>K. A. Opperman United States English Wildside Press Weirdbook Annual 2 date February 2019 " " is a Cthulhu Mythos poem by American writer K. A. Opperman which takes its cue from H. P. Lovecraft 's poem " Nathicana " (unknown date). History "" was published in the Wildside Press anthology Weirdbook Annual 2 , edited by Doug Draa , in February 2019.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#K._A._Opperman"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Weirdbook Annual 2</ex:isPublishedAsW>
    <ex:wasPublishedOnW>February 2019</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Chad_Fifer">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosAdjacentWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Chad Fifer</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author United States  is a Los Angeles-based author, scriptwriter and podcaster who has written a number of short stories inspired by the works of H. P. Lovecraft and the Cthulhu Mythos , and he has adapted Lovecraft's short story " The Hound " for the comic book format, published in Lovecraft Anthology: Volume II . Online, he has co-hosted the H. P. Lovecraft Literary Podcast since 2009. Selected Bibliography Short Fiction " Afraid of Dobermans " (2014) " The Baby Downstairs " (2015) Comic Books Lovecraft Anthology: Volume II (2012, adaptation of " The Hound ") External Links at The Internet Speculative Fiction Database</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Satampra_Zeiros">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Satampra Zeiros</rdfs:label>
    <ex:hasAnnotation>Zeiros is a life-long thief, was good at his profession, although he stated to have never stolen from anyone who was not a robber themselves in some shape or form . He was described as a largish man, and later in life was missing his right hand, the result of a near-fatal encounter with a formless spawn of tsathoggua . He loved a woman named vixeela, a former temple girl who</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Theft_of_Thirty-Nine_Girdles"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Tale_of_Satampra_Zeiros"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Mad_Visions_of_al-Hazred">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Mad Visions of al-Hazred</rdfs:label>
    <ex:hasAnnotation>Various English Alban Lake Publishing Release Date November 2017 226 is an anthology of Lovecraftian fiction edited by H. David Blalock and published by Alban Lake Publishing in November 2017. Both paperback and digital editions were released. Overview</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>226</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>November 2017</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Waite_Phillips">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Waite Phillips</rdfs:label>
    <ex:diedOnR>28 January 1899</ex:diedOnR>
    <ex:hasAnnotation></ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1836</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#B%C3%AAte_Noire">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Bête Noire</rdfs:label>
    <ex:hasAnnotation>Greg Francis English Rogue Planet Press Lovecraftiana Vol 5, Issue 3 date October 2020 " Bête Noir " is a very short Cthulhu Mythos poem by Greg Francis. It was published in Vol 5, Issue 3 of the Lovecraftiana zine by Rogue Planet Press in October 2020. Synopsis The six lines describe in brief a date-rape scenario intended to allow a juvenile Shoggoth to be smuggled through customs inside the unsuspecting victim's womb. For what purpose, or why it is necessary to go to such lengths given the nature of a Shoggoth, is not explained, but is likely to accentuate the horror aspect of the piece. Trivia The poem's title is French for "black beast".</ex:hasAnnotation>
    <ex:hasAuthorW>Greg Francis</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 3</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 5</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Inside_Uncle_Sid">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Inside Uncle Sid</rdfs:label>
    <ex:hasAnnotation>"uncle sid's collection" by cody goodfellow originally appeared in dead but dreaming 2 . The story is told from the point of view of a young woman who lives with her uncle . Sid is a compulsive hoarder who attracts a group of misfits .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Cody_Goodfellow"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Dead_but_Dreaming_2"/>
    <ex:wasPublishedOnW>2011 June 15</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Deconstruction">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Deconstruction</rdfs:label>
    <ex:hasAnnotation>Cthulhu mythos is a very short story by british harris coverley . It was published in the lammas eve edition of rogue planet press zine lovecraftiana . Of particular irony is that great cthulhu chooses that moment to awaken and begin his reconquest of the globe .</ex:hasAnnotation>
    <ex:hasAuthorW>Harris Coverley</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 2</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 5</ex:isPublishedAsW>
    <ex:wasPublishedOnW>July 2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Old_One_%28Palladium%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Old One (Palladium)</rdfs:label>
    <ex:hasAnnotation>The old ones are eldritch titans in the fictional universe of palladium's rifts megaverse . They are the personifications of chaos and evil . The old ones are not omnipotent, but their powers vastly exceed those of most cosmic and mystical races .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dark_Boatman">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dark Boatman</rdfs:label>
    <ex:hasAnnotation>A man named dexter inherits his eccentric uncle's sprawling cornish mansion . Along with a friend, he uncovers a terrible family secret stretching back thousands of years . Behind the mythos first published in spectral tales no. 2 in december 1989 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#John_Glasby"/>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror Mystery Short Fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>September 2012</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Newburyport">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Newburyport</rdfs:label>
    <ex:hasAccessibilityL>Train line from Arkham Bus from Arkham via Innsmouth</ex:hasAccessibilityL>
    <ex:hasAnnotation>Innsmouth is a town in essex county, massachusetts created by h. p. lovecraft . The town is bordered by the lower green and parker river beyond which is the sea . The coastal highway to rowley and ipswich passes through plu island and a desolate patch of land exposed to the sand by deforestation in 1846 .</ex:hasAnnotation>
    <ex:hasAppearanceL rdf:resource="http://example.org/lovecraft#The_Shadow_Over_Innsmouth"/>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Massachusetts"/>
    <ex:isLocatedAtL>Essex County</ex:isLocatedAtL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Winged_One_%28disambiguation%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Disambiguations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Winged One (disambiguation)</rdfs:label>
    <ex:hasAnnotation>"black winged ones" are bat-winged creatures summoned to the rites of the cthulhu cult . The byakhee are also described as "black-winged bat-like creatures" the term was used by h.p. Lovecraft and taken up by fred pelton .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Rise_of_Thalhulla">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Rise of Thalhulla</rdfs:label>
    <ex:hasAnnotation>Horror writer william travels to a remote spanish island after being drawn there by an image of an incredible painting . At the island's only hotel, he finally manages to examine the painting, and is stunned by the level of detail . Over dinner, the hotel's owner informs him of the island's history, of how the people once worshipped the star-born thalhulla . He is put through a horrific procedure by the woman and her daughter where he is turned into a semi-</ex:hasAnnotation>
    <ex:hasAuthorW>Joshua Robinson</ex:hasAuthorW>
    <ex:hasGenreW>Lovecraftian fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 2</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 8</ex:isPublishedAsW>
    <ex:wasPublishedOnW>July 2023</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bob_Eggleton">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Bob Eggleton</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Artist Birth Date 13 September 1960 United States United States (born 1960) is an American artist known for his science fiction and fantasy illustrations, and has provided the cover art for numerous Cthulhu Mythos anthologies. A fan of giant monsters in general, Eggleton's work often features dragons, dinosaurs, or other similar creatures. In addition to the Cthulhu Mythos, he has illustrated books and comics for the Godzilla franchise, and created the cover art for dozens of novels and collections by authors such as Brian Lumley , Alan Dean Foster , Edgar Rice Burroughs , Robert A. Heinlein, James H. Schmitz, and many others. See also Images by External Links at Wikipedia at the Internet Speculative Fiction Database</ex:hasAnnotation>
    <ex:hasBirthplaceR>United States</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Artist</ex:isConnectedToMythosR>
    <ex:wasBornOnR>13 September 1960</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Hart_Crane">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Hart Crane</rdfs:label>
    <ex:diedOnR>1932</ex:diedOnR>
    <ex:hasAnnotation>Eminent American poet who met Lovecraft sporadically in Cleveland (1922) and New York (1924–1926, 1930). Lovecraft admired his work, especially The Bridge (1930), on which Lovecraft saw him at work in 1924. He died by suicide. [Modern American Poetry includes a biography of Crane and several of his works.]</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1899</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#C._M._Eddy,_Jr.">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsCoAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsCorrespondents"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>C. M. Eddy, Jr.</rdfs:label>
    <ex:diedOnR>21 November 1967</ex:diedOnR>
    <ex:hasAnnotation>C. m. eddy, jr. was a writer of weird fiction best remembered for his friendship with h. p. lovecraft . He is best known for co-writing " the loved dead ", a story of energy vampirism and necrophilia co-written by lovecraft . He also wrote " ashes ", " the ghost-eater " and " deaf, dumb, and blind " all of which were published in weird tales and credited sole</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA http://example.org/lovecraft#Rhode_Island Providence</ex:hasBirthplaceR>
    <ex:hasFullNameR>Clifford Martin Eddy. Jr.</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Friend</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>collaborator of H. P. Lovecraft</ex:isConnectedToMythosR>
    <ex:wasBornOnR>18 January 1896</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ghatanothoa">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Ghatanothoa</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Dark God The Daemon-God The Devil-God The Thing on the Mount G'tanta Tanotah Than-Tha Gatan Ktan-Tah</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The monster first appears in the 1935 story " out of the aeons ", ghostwritten by h. p. lovecraft for hazel heald . The monster is described as a "hellish god or patron daemon" brought to earth in prehistoric times by aliens from yuggoth . When humans arose after the aliens' departure, they too worshipped the monster out of fear of its frightful power .</ex:hasAnnotation>
    <ex:hasAppearanceC>The Return of the Lloigor The Thing in the Pit</ex:hasAppearanceC>
    <ex:isLocatedAtC>Mount Yaddith-Gho</ex:isLocatedAtC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Out_of_the_Aeons"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Hazel_Heald"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Madonna_of_the_Abattoir">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Madonna of the Abattoir</rdfs:label>
    <ex:hasAnnotation>Summoned fathomless is a short story by anne m. pillsworth . It is a prequel to pillsworth's summoned . The story features redemption and patience orne, who are acolytes of nyarlathotep .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Anne_M._Pillsworth"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Redemption's Heir</ex:isPartOfSeriesW>
    <ex:wasPublishedOnW>2014 May 6</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Rlim_Shaikorth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Rlim Shaikorth</rdfs:label>
    <ex:ceasedOnC>Hyperborean Age</ex:ceasedOnC>
    <ex:hasAffiliationC>Great Old Ones Lesser Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The White Worm</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The white worm is a character created by . Clark ashton smith for his short story " the coming of the white . Worm " first came to earth during the hyperborean age and roamed the coastline on . Yikilth . Destroyed by the mage evagh, who caught it during a period of rest and was able to inflict a mortal wound on the creature .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Coming_of_the_White_Worm"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Father-of-All-Sharks">
    <rdf:type rdf:resource="http://example.org/lovecraft#Avatars"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Father-of-All-Sharks</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Cthulhu"/>
    <ex:hasAnnotation>The is an avatar of cthulhu created by bruce l. priddy for the 2006 edition of malleus monstrorum . The creature manifests as a colossal glowing white shark resembling the ancient extinct megalodon, but twice the size . The deep ones know the correct rituals required to summon the , but are wary of doing so .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Malleus Monstrorum (2006)</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Bruce L. Priddy</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Extrico_Tabula">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Extrico Tabula</rdfs:label>
    <ex:hasAnnotation>Oscar Rios United States English Call of Cthulhu Chaosium Release Date September 2008 Media Type Softcover Print Digital (PDF) 78 : The Second Cthulhu Invictus Companion is a sourcebook for Chaosium 's Call of Cthulhu offshoot Cthulhu Invictus . Overview From the 's website: Publication History Written by Oscar Rios , was first published in September 2008 and has since gone out of print. However, a digital PDF is still available from Chaosium's website. Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Oscar_Rios"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>78</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>September 2008</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Samuel_E._Loveman">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Samuel E. Loveman</rdfs:label>
    <ex:diedOnR>1976</ex:diedOnR>
    <ex:hasAnnotation>Poet, bookseller, member of the Kalem Club, and longtime friend of Lovecraft, Clark Ashton Smith, and Donald Wandrei as well as of Ambrose Bierce, Hart Crane, and George Sterling. Author of The Hermaphrodite (1926) and other works.</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1887</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ye_Booke_of_Monstres">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Ye Booke of Monstres</rdfs:label>
    <ex:hasAnnotation>Scott David Aniolowski Rodell Sanford, John T. Snyder, and Allen Koszowski Cover Artist Charlie Krank United States English Call of Cthulhu Genre(s) Horror Chaosium Release Date 1994 62 , New Nightmares for Call of Cthulhu is a monster manual supplement for the Call of Cthulhu horror roleplaying game. It was published by Chaosium in 1994 . Overview Beings Included Adumbrali Aforgomon Ancient Ones Bloated Woman Bugg-Shash Byatis Cats from Saturn Chaugnar Faugn, Brothers of Crawling Ones Cynothoglys Dark Demon Dwellers in the Depths Faceless God Feaster from Afar Fosterlings of the Old Ones Ghroth Goatswood Gnomes Goblins Gol-goroth Hagarg Ryonis Haunter of the Dark Hydra Hyperboreans Iod Juk-Shabb Karakal Keeper of the Moon-Lens Leng, Men from L'gy'hx, Inhabitants of Lloigor Lobon Madam Yi Messenger of the Old Ones Million Favoured Ones M'nagalah Nath-Horthath Nioth-Korghai Ny'ghan Grii Q'yth-az Rlim Shaikorth Saaitii Seekers Shugoran Shugoran, Children of Spawn of the Green Abyss Spectral Hunters Sphinx, Children of Summanus Tamash Tawil At'Umr Thing Hanging in the Void Travelers Tru'nembra Voormis Vorvadoss Vulthoom Wendigo Worm that Walks Xada-Hgla Yaddith, Denizens of Yekub, Inhabitants of Yidhra Yog-Sothoth, Sons of Ythogtha Yuggs Zo-Kalar Zu-che-quon Zy'tl Q'ae See also II , the second volume. Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Scott_David_Aniolowski"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>62</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>1994</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nightscapes_June_1997">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Nightscapes June 1997</rdfs:label>
    <ex:hasAnnotation>The inaugural issue of long-running fanzine nightscapes . Edited by the late american and scholar edward p. berglund . Featured pictures of bronze sculptures of cthulhu and nyarlathotep by joel harlow .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>June 1997</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nira">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ElderGods"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Nira</rdfs:label>
    <ex:hasAnnotation>Created by Llewellyn M. Cabos is an Elder God (probably goddess) and consort to Nodens . and Nodens are in a constant war with Rokon and the serpent folk of Zandanua .</ex:hasAnnotation>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Llewellyn_M._Cabos"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Haon-Dor">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Haon-Dor</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Atlach-Nacha"/>
    <ex:hasAffiliationC>Serpent People</ex:hasAffiliationC>
    <ex:hasAnnotation>Hyperborea is a fictional character created by clark ashton smith for his short story " the seven geases " . He currently lives as a recluse in a labyrinthine palace of stone deep inside mount voormithadreth . He speaks in an unknown language, but has the power to make himself understood by any listener .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Descent_into_the_Abyss"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Seven_Geases"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#S._Petersens_Field_Guide_to_Creatures_of_the_Dreamlands">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>S. Petersen's Field Guide to Creatures of the Dreamlands</rdfs:label>
    <ex:hasAnnotation>Creatures of the dreamlands is a sourcebook for chaosium's call of cthulhu roleplaying game . Features full-colour illustrations, size comparisons, monster habitats, behaviours and recognition guides, along with maps of the dreamlands .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lynn_Willis"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Sandy_Petersen"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>64</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1989</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Christmas_Greeting_to_Mrs._Phillips_Gamwell%E2%80%941925">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Christmas Greeting to Mrs. Phillips Gamwell—1925</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft United States English Arkham House Beyond the Wall of Sleep Date of writing 1925 date 1943 " Christmas Greetings to Mrs. Phillips Gamwell-1925 " is a poem by the late American Howard Phillips Lovecraft . Written in 1925, it did not see until 1943 when it appeared in the Arkham House collection Beyond the Wall of Sleep , six years after Lovecraft's death . History Beyond the Wall of Sleep (1943) Collected Poems (1963) The World of H. P. Lovecraft (1971) Fungi from Yuggoth and Other Poems (1971) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Beyond_the_Wall_of_Sleep"/>
    <ex:wasPublishedOnW>1943</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>1925</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#John_W._Patterson">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>John W. Patterson</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Weird fiction is an author who has written at least two short stories connected to the works of H. P. Lovecraft and the Cthulhu Mythos . These have been published in Edward P. Berglund 's online fanzine Nightscapes , the Clark Ashton Smith tribute site Eldritch Dark, as well as independently through Amazon's digital Kindle platform. Selected Works Short Fiction " Priestess of Nycrama " (1999) " Nexus of Vortices " (2002) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mark_Harrigan">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Mark Harrigan</rdfs:label>
    <ex:hasAlternativeNamesC>The Soldier</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as the soldier harrisburg, pennsylvania powers and abilities military training occult knowledge relatives unnamed brother sophie (wife, deceased) harrigan is a character created by fantasy flight games who has appeared in several of their cthulhu mythos -related products .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Arkham_Horror:_The_Card_Game"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Eldritch_Horror"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Feeders_from_Within"/>
    <ex:hasCharacterMateC>Sophie</ex:hasCharacterMateC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Dunwich_Horror_Deluxe_Expansion"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Fantasy_Flight_Games"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Anadhan">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Anadhan</rdfs:label>
    <ex:hasAnnotation>Kieran Judge English Rogue Planet Press Lovecraftiana Vol 5, Issue 3 date October 2020  " " is a Lovecraftian short story by Kieran Judge. It was first published in Vol 5, Issue 3 of the Lovecraftiana zine in October 2020. Synopsis A man begins to have nightmares about a dark city, a future version of his own in which mankind is enslaved and consumed by bizarre monstrosities. Soon the dreams begin to bleed into reality, and he realises that the enslavers have followed him into his world in an attempt to make him keep his silence. Coming to the conclusion that everyone he knows has been assimilated by these beings and that he cannot escape their clutches, he throws himself from the window of a high-rise building.</ex:hasAnnotation>
    <ex:hasAuthorW>Kieran Judge</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 3</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 5</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Note_on_the_Cthulhu_Mythos">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Note on the Cthulhu Mythos</rdfs:label>
    <ex:hasAnnotation>The trail of cthulhu is a non-fiction essay by august derleth . It is an appendix to his 1962 collection, the trail of cthulhu . Derleth lays down his interpretation of the mythology created by his late friend lovecraft .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Trail_of_Cthulhu"/>
    <ex:wasPublishedOnW>1962</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Quyagen">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Quyagen</rdfs:label>
    <ex:hasAlternativeNamesC>He Who Dwells Beneath Our Feet</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Eye of Z'ylsm</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>E. p. berglund is the god of yagothoggua . It used the eye of zysl'm against the great race of yith until it was imprisoned under the temple at yagothoggua .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Thing in the Library</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Crispin_Burnham"/>
    <ex:wasCreatedByC>E. P. Berglund</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#At_First_Sight">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RamseyCampbellWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>At First Sight</rdfs:label>
    <ex:hasAnnotation>The story was first published in the 1973 arkham house collection demons by daylight . It has been translated into both french (1979) and german (1998) . Set in the fictional town of brichester, a locale created by campbell for many of his cthulhu mythos stories .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Demons_by_Daylight"/>
    <ex:wasPublishedOnW>1973</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Vhuzompha">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Vhuzompha</rdfs:label>
    <ex:hasAnnotation>First appearance EXP : " The Deep-Lord Awakens " Created by James Ambuehl is a Great Old One who shares the seas with its sibling Y'lla .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Deep-Lord Awakens</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#James_Ambuehl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Shadow_Over_Innsmouth_%28Lovecraft_Illustrated%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Shadow Over Innsmouth (Lovecraft Illustrated)</rdfs:label>
    <ex:hasAnnotation>The Shadow Over Innsmouth Pete Von Sholly Cover Artist Pete Von Sholly English Lovecraft Illustrated PS Publishing Release Date February 2015 144 Preceded by The Shadow Out of Time Followed by At the Mountains of Madness The Shadow Over Innsmouth is a short anthology edited by S. T. Joshi and released by PS Publishing in hardcover format in February 2015. It contains H. P. Lovecraft 's novella The Shadow Over Innsmouth - complete with illustrations - as well as two stories believed to have influenced its writing, and two non-fiction works regarding the piece. Overview Contents Introduction by S. T. Joshi Foreword by Brian Yuzna The Shadow Over Innsmouth by H. P. Lovecraft "The Shadow Over the Shadow" by Pete Von Sholly "The Harbor-Master" by Robert W. Chambers "Fishhead" by Irvin S. Cobb "Fish Schticks" by Robert M. Price</ex:hasAnnotation>
    <ex:hasPageCountW>144</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Lovecraft Illustrated</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>February 2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Professor_Chambers">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Professor Chambers</rdfs:label>
    <ex:ceasedOnC>19</ex:ceasedOnC>
    <ex:hasAffiliationC>Harvard University</ex:hasAffiliationC>
    <ex:hasAnnotation>19?? Professor Harvard University Human First appearance The Green Meadow Created by H. P. Lovecraft , Elizabeth Berkeley is a fictional character invented by H. P. Lovecraft and Elizabeth Berkeley in their story " The Green Meadow ." Chambers analyzes the book inside the metallic rock-like object that landed off the coast of Potowonket , Maine , in the story. While studying the volume, the professor renders several pages of the book practically illegible.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Green_Meadow"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasCreatedByC>Elizabeth Berkeley</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Letitia_Edgecombe">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Letitia Edgecombe</rdfs:label>
    <ex:diedOnR>17 June 1884</ex:diedOnR>
    <ex:hasAnnotation>Lovecraft’s paternal great-great-grandmother. Lovecraft claims that she gave birth to at least six of Thomas Lovecraft’s children, among them Lovecraft’s paternal great-grandfather, Joseph S. Lovecraft.</ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1794</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sorrow_Road">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Sorrow Road</rdfs:label>
    <ex:hasAnnotation>The story was published in the thematic anthology return of the old ones: apocalyptic lovecraftian horror by dark regions press in 2017 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Tim_Waggoner"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Return of the Old Ones: Apocalyptic Lovecraftian Horror</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Book">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Book</rdfs:label>
    <ex:hasAnnotation>"the tree on the hill" is an unfinished short story by h. p. lovecraft . It was first published in the journal leaves in 1938, after lovecraft's death . It has been posthumously completed by martin warnes as "the black tome of alsophocus"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Book_of_Eibon/Le_Livre_Deibon">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Book of Eibon/Le Livre D'eibon</rdfs:label>
    <ex:hasAnnotation>Frederick J. Mayer English/French Wildside Press Weirdbook Annual 2 date February 2019 " , trans. by Frederick J. Mayer " is a short Cthulhu Mythos poem by Frederick J. Mayer . Synopsis The four verses purport to be a translation of occult grimoire The Book of Eibon into English, although some lines appear to remain in French. History "" was published in the Doug Draa -edited anthology Weirdbook Annual 2 by Wildside Press in February 2019.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Frederick_J._Mayer"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:isPublishedAsW>Weirdbook Annual 2</ex:isPublishedAsW>
    <ex:wasPublishedOnW>February 2019</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dead_Light_%28Call_of_Cthulhu%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dead Light (Call of Cthulhu)</rdfs:label>
    <ex:hasAnnotation>36 dead light: surviving one night outside of arkham is a survival horror adventure supplement for chaosium 's call of cthulhu roleplaying game . It is a stand-alone scenario which can alternatively be slotted into a longer campaign . Although designed for 7th edition, it includes an appendix containing basic conversion rules to allow it to be played with earlier editions .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Alan_Bligh"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>36</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2013</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Yoth_Protocols">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Yoth Protocols</rdfs:label>
    <ex:hasAnnotation>A government agent and the enigmatic indrid cold descend into the darkness of k'n-yan . There, they discover the survivors of a soviet special forces team who have accidentally unleashed a deadly contagion . They also discover the denizens of the cavern beneath k'n-yan, yoth .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Josh_Reynolds"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>August 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Black_Wings_VI">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Black Wings VI</rdfs:label>
    <ex:hasAnnotation>New tales of lovecraftian horror is edited by s. t. joshi and published by ps publishing . It is the final volume in the black wings of h. p. lovecraft -influenced fiction . The anthology includes three poems on lovecraftian themes .</ex:hasAnnotation>
    <ex:hasAuthorW>S. T. Joshi (editor)</ex:hasAuthorW>
    <ex:hasGenreW>Lovecraftian Horror</ex:hasGenreW>
    <ex:hasPageCountW>326</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Black_Wings"/>
    <ex:wasReleasedOnW>November 2017</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Arkham_Detective_Collection_Volume_2">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Arkham Detective Collection Volume 2</rdfs:label>
    <ex:hasAnnotation>Byron Craft English Release Date June 2022 344 Preceded by The Arkham Detective Collection Volume 1 is a collection of Arkham Detective stories by American Byron Craft . Containing three novellas and a bonus story, it was independently published in June 2022; both paperback and digital versions were released. Overview Contents Death on the Arkham Express (2019) Who Stole the Necronomicon? (2020) Arkham After Dark The Comatose Man Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Byron_Craft"/>
    <ex:hasPageCountW>344</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>June 2022</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Seed_from_the_Stars">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Seed from the Stars</rdfs:label>
    <ex:hasAnnotation>Historyis a cthulhu mythos poem by american james ambuehl . Consists of ten eight-line verses, and functions as something of a prequel to ambuehl's 1996 short story " the star-seed "</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#James_Ambuehl"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Nightscapes #16</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2006</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Changeling">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Changeling</rdfs:label>
    <ex:hasAnnotation>Full story online here Ron Shiflet United States English Publication date October 1997 " " is a short Mythos poem by American Ron Shiflet . Synopsis A ghoul -child which has replaced a human baby matures and decides that the townsfolk he has been placed with are not worth his time. As a result, he returns to his own people. Publication History "" was first published in the October 1997 edition of Nightscapes , and later appeared in Cthulhu Cultus #10 in February 1998.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>October 1997</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dope_War_of_the_Black_Tong">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dope War of the Black Tong</rdfs:label>
    <ex:hasAnnotation>The disciples of cthulhu: second revised edition is a short story by american robert m. price . It continues the anton zarnak created by . Lin carter , for whom price acted as literary executor . The two, with the aid of zarnak's . Capable manservant akbar singh, track down the cult and put a stop to their nefarious scheme .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Anton_Zarnak"/>
    <ex:isPublishedAsW>The Disciples of Cthulhu: Second Revised Edition</ex:isPublishedAsW>
    <ex:wasPublishedOnW>February 1996</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#To_Mistress_Sophia_Simple,_Queen_of_the_Cinema">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>To Mistress Sophia Simple, Queen of the Cinema</rdfs:label>
    <ex:hasAnnotation>Full story online here H. P. Lovecraft United States English The United Amateur Date of writing August 1917 date November 1919 " " is a poem by the late American Howard Phillips Lovecraft . Written in August 1917 , it was first published in The United Amateur in November 1919 under the pseudonym L. Theobald, Jun . Synopsis The quartet of four-line verses offer a barbed tribute to actress Sophia Simple, who Lovecraft appears to have thought possessed a magnificent charm, yet believed to be somewhat lacking in other departments. History (Note: this list has been primarily compiled from the poem's entry in at Internet Speculative Fiction Database ) The United Amateur (1919) Beyond the Wall of Sleep (1943) Collected Poems (1963) The World of H. P. Lovecraft 1971) Fungi from Yuggoth and Other Poems (1971) A Winter Wish and Other Poems (1977) The Ancient Track: The Complete Poetical Works of H. P. Lovecraft (2001, 2013) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_United_Amateur"/>
    <ex:wasPublishedOnW>November 1919</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>August 1917</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dark_Dreamer">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dark Dreamer</rdfs:label>
    <ex:hasAnnotation>Full story online here Chad Hensley United States English Nightscapes #3 date September 1997 " " is a short Cthulhu Mythos poem by American Chad Hensley . Synopsis The three verses describe in brief the sunken city of R'lyeh and its sleeping master Cthulhu . History Dagger of the Mind #2 (1991) Mythos Tales &amp; Others (1996) Tales of Lovecraftian Horror #4 (1996) Nightscapes (1997) Dark Legacy (2005) Beyond the Cosmic Veil (2015) Eldritch Tales V2n6 (2019)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Chad_Hensley"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Nightscapes #3</ex:isPublishedAsW>
    <ex:wasPublishedOnW>September 1997</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dhole_Ant-Lion">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonSapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Dhole Ant-Lion</rdfs:label>
    <ex:hasAnnotation>Dhole ant-lions are a fictional species created by marc laidlaw and gary myers for their short story "the summons of nuguth-yug" the name comes from the role-playing game call of cthulhu . Similar to real ant-lions, these monsters dwell in funnel-shaped pits some miles across .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Summons of Nuguth-Yug</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Gary_Myers"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Marc_Laidlaw"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bayt_al_Azif,_Issue_1,_October_2018">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Bayt al Azif, Issue 1, October 2018</rdfs:label>
    <ex:hasAnnotation>Bayt al Azif Issue 1 Various English Genre(s) Roleplaying games Release Date October 2018 80 Followed by Bayt al Azif , Issue 2, September 2019 Bayt al Azif Issue 1 is the inaugural issue of sporadic Cthulhu Mythos roleplaying magazine Bayt al Azif . Running to a total of 80 , it was published in October 2018; paperback, hardcover, and digital formats were all released. Overview</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasGenreW>Roleplaying games</ex:hasGenreW>
    <ex:hasPageCountW>80</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>October 2018</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Gol-goroth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Gol-goroth</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>God of the Black Stone</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Golgor</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Forgotten Old One</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Golgor is a fictional deity created by robert e. howard for his cthulhu mythos stories . He is first mentioned in howard's " the children of the night ", where professor kirowan refers to "nameless and ghastly gods and entities as cthulhu , yog sothoth , tsathoggua , and the like" it is a dark god of bal-sagoth</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Gods_of_Bal-Sagoth"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Children_of_the_Night"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Gyaa-yothn">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonSapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Gyaa-yothn</rdfs:label>
    <ex:hasAffiliationC>The K'n-yanians</ex:hasAffiliationC>
    <ex:hasAnnotation>The (singular: gyaa-yoth) are a species created by h. p. lovecraft for the novella the mound . They are unnatural hybrids created by the men of the k'n-yan city of tsath to act as horse-like mounts and perform physical labour . Though carnivorous, they're considered to be harmless .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Mound"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kaalut">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OuterGods"/>
    <rdfs:label>Kaalut</rdfs:label>
    <ex:hasAlternativeNamesC>The Ravenous One</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>A gigantic insectoid larva-like horror, dwelling in the nebulous realm of k'gil'mnon . 's powers vary but the most prominent are mind manipulation, telepathy, omniscience, invulnerability, immortality and possibly reality warping .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Genuine_Article"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#J._B._Lee"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Secret_Cave_or_John_Lees_Adventure">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Secret Cave or John Lees Adventure</rdfs:label>
    <ex:hasAnnotation>The secret cave, or john lees adventure, is a short story by the late american . Written in 1898 when he was only eight years old, it forms part of his juvenilia . Written in 1898 when he was only eight years old, it forms part of his juvenilia .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Shuttered_Room"/>
    <ex:isPublishedAsW>Other Pieces</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1959</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Die_Offenbarungen_des_Glaaki">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RamseyCampbellWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Die Offenbarungen des Glaaki</rdfs:label>
    <ex:hasAnnotation>Ramsey Campbell Giorgio Grecu Cover Artist Giorgio Grecu Germany German H. P. Lovecraft's Bibliothek des Schreckens Genre(s) Horror Festa Release Date June 2014 Media Type Hardcover 313 is a collection of German- translations of works by Ramsey Campbell , mostly those from The Inhabitant of the Lake and Less Welcome Tenants . Overview Containing nine short stories and running to a total of 313 , (which translates as The Revelations of Glaaki ) was published in June 2014 by Festa as part of their H. P. Lovecraft's Bibliothek des Schreckens ( H. P. Lovecraft's Library of Horrors ) . Cover and interior artwork was supplied by Giorgio Grecu. Contents "Die Kammer im Schloss" (" The Room in the Castle ") "Das Grauen von der Brücke" (" The Horror from the Bridge ") "Der die Schleier zerreißt" (" The Render of the Veils ") "Die Insekten aus Shaggai" (" The Insects from Shaggai ") "Der Bewohner des Sees" (" The Inhabitant of the Lake ") "Die Mine auf Yuggoth" (" The Mine on Yuggoth ") "Das Dunkel naht" (" Blacked Out ") "Das Lied des Strandes" (" The Voice of the Beach ") "Ein unheimlicher Drang" (" The Tugging ")</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
    <ex:hasCountryOfOriginW>Germany</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>313</ex:hasPageCountW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#H._P._Lovecrafts_Bibliothek_des_Schreckens"/>
    <ex:wasReleasedOnW>June 2014</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ishiti">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Ishiti</rdfs:label>
    <ex:hasAlternativeNamesC>Snake Goddess of Set</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Snake goddess of set is a fictional character from marvel comics . She made her first appearance in issue #134 of the 1st volume of the conan the barbarian comic book series . In her serpentine form, she had the body of a giant snake with a humanoid head .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Conan the Barbarian Vol 1 #134</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Bruce Jones</ex:wasCreatedByC>
    <ex:wasCreatedByC>Gil Kane</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#CthulhuTech">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>CthulhuTech</rdfs:label>
    <ex:hasAnnotation>The game takes place in the world of the cthulhu mythos in the 21st century . The setting combines the horror and paranormal of the mythos with science fiction . The game is published by sandstorm productions and was first released in 2007 .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>Sci-Fi</ex:hasGenreW>
    <ex:hasGenreW>Super Heroes</ex:hasGenreW>
    <ex:hasGenreW>role-playing game</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Legions_of_Carcosa">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Legions of Carcosa</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Janio Garcia English The Yellow King Genre(s) Roleplaying game Pelgrane Press 200 : The Yellow King Roleplaying Game Bestiary is a sourcebook for Pelgrane Press 's Yellow Mythos roleplaying game The Yellow King . Written by Robin D. Laws , John Harness, Daniel Kwan, Kira Magrann, Monica Valentinelli, and Sarah Saltiel , it was published in both print and digital editions. Overview introduces a host of new monsters for use in games of The Yellow King , along with new Shock and Injury cards to enhance combat-focused scenarios.</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>200</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>The Yellow King</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Cultists">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Cultists</rdfs:label>
    <ex:hasAnnotation>Ron Shiflet United States English Tenoka Press In Lovecraft's Shadow date March 2007 " " is a Cthulhu Mythos poem by American Ron Shiflet . It was published in the first (and only) issue of In Lovecraft's Shadow , a Lovecraftian fanzine which Shiflet also edited. Synopsis Consisting of two verses in fourteen lines, the poem describes how a group of Arkham cultists summon forth an ancient god. To their horror, they realise too late that they are to be its next sacrifice…</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#In_Lovecrafts_Shadow"/>
    <ex:wasPublishedOnW>March 2007</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Rat_Person">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Rat Person</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Ygolonac"/>
    <ex:hasAlternativeNamesC>Boucher</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Devolved human</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Scampering Creatures from Warrens</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The rat people are a race of rat-like quadrupeds created for the call of cthulhu role-playing game . They were tangentially inspired by the short story" the rats in the walls " by h. p. lovecraft . They were created by ed gore in his call of cthulhu adventure warren in the 1989 gaming supplement collection, cthulhu classics .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Shadows_of_Yog-Sothoth"/>
    <ex:madeFirstAppearanceOnC>The Rats in the Walls (disputed)</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Ed Gore</ex:wasCreatedByC>
    <ex:wasCreatedByC>H. P. Lovecraft (disputed)</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Manly_Wade_Wellman">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Manly Wade Wellman</rdfs:label>
    <ex:diedOnR>5 April 1986</ex:diedOnR>
    <ex:hasAnnotation>Pseudonym(s) Gabriel Barclay Levi Crow Gans T. Field Hampton Wells Wade Wells Connection to the Mythos Author Birth Date 21 May 1903 Kamundongo, Portuguese West Africa Death Date 5 April 1986 United States 𝐓 (21 May 1903 – 5 April 1986) was a prolific pulp fiction writer, noted for his science fiction and fantasy writing for Weird Tales and other outlets. His Cthulhu Mythos homage " The Terrible Parchment ", which featured the Necronomicon trying to make itself real through the power of collective belief, was published in the August 1937 issue of Weird Tales , and dedicated "to the memory of H. P. Lovecraft , with all admiration". Wellman created the recurring characters Judge Pursuivant and John Thunstone, both psychic detectives, and the backwoods minstrel John the Balladeer. Wellman's literary executor was the writer and editor Karl Edward Wagner . Selected Bibliography " The Terrible Parchment " (1937)</ex:hasAnnotation>
    <ex:hasBirthplaceR>Kamundongo Portuguese West Africa</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasPseudonymR>Gabriel Barclay</ex:hasPseudonymR>
    <ex:hasPseudonymR>Gans T. Field</ex:hasPseudonymR>
    <ex:hasPseudonymR>Hampton Wells</ex:hasPseudonymR>
    <ex:hasPseudonymR>Levi Crow</ex:hasPseudonymR>
    <ex:hasPseudonymR>Wade Wells</ex:hasPseudonymR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>21 May 1903</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Hutchison_Boy">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Hutchison Boy</rdfs:label>
    <ex:hasAnnotation>The dragons of the night is a short story by american author darrell schweitzer . In the end of days, a family is befriended by a strange boy named caleb who is actually a deep one hybrid . When the creatures of the ocean call to them, he believes he can take the family's son, jackie, with him, but jackie is unable to breathe beneath the waves and drowns .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Darrell_Schweitzer"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>The Dragons of the Night</ex:isPublishedAsW>
    <ex:wasPublishedOnW>May 2016</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Readers_Guide_to_the_Cthulhu_Mythos">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Reader's Guide to the Cthulhu Mythos</rdfs:label>
    <ex:hasAnnotation>The book attempts to list all cthulhu mythos fiction then published . It includes separate listings for nonfiction, poetry, and parody . The second edition incorporates berglund's material from biblioteca: h. p. lovecraft .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Edward_P._Berglund"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_Weinberg"/>
    <ex:hasGenreW>Nonfiction</ex:hasGenreW>
    <ex:hasPageCountW>88</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1973</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Curse_of_Yig_%28collection%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Curse of Yig (collection)</rdfs:label>
    <ex:hasAnnotation>The curse of yig is a collection of works by the late american and h.p. Lovecraft 's collaborator zealia bishop . Contains all three stories which were revised for publication by lovecraft, as well as two biographies (one on lovecraft and one on august derleth) interior artwork by virgil finlay . Released in 1953 in a limited hardback run, in this instance 1,200 copies .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Zealia_Bishop"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>175</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1953</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#David_Kernot">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>David Kernot</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Australia Australian Science Fiction Fantasy Horror https://www.davidkernot.com/ is an award-winning Australian author and occasional editor whose works fall into the science fiction, fantasy and horror genres. He has written a number of stories set in the Cthulhu Mythos inspired by the works of H. P. Lovecraft ; these have appeared in anthologies such as World War Cthulhu (2014, Dark Regions Press ). Selected Bibliography Editor Extreme Planets (2013, with David Conyers and Jeff Harris) Author " The Bullet and the Flesh " (2014, with David Conyers ) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#Australia</ex:hasBirthplaceR>
    <ex:hasNationalityR>Australian</ex:hasNationalityR>
    <ex:hasWebsiteR>https://www.davidkernot.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Marcus_L._Rowland">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Marcus L. Rowland</rdfs:label>
    <ex:hasAnnotation>Former lab technician turned prolific roleplaying games designer from the united kingdom . In 1985 began to write complete modules for several of these, including chaosium's call of cthulhu . He ended any association with game publishers in 1989, and no longer contributes to chaosium supplements .</ex:hasAnnotation>
    <ex:hasBirthplaceR>London UK Hampstead</ex:hasBirthplaceR>
    <ex:hasNationalityR>United Kingdom</ex:hasNationalityR>
    <ex:hasWebsiteR>https://www.forgottenfutures.co.uk/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Games Designer</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1953</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#An_Inner_Darkness">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>An Inner Darkness</rdfs:label>
    <ex:hasAnnotation>Golden goblin press roleplaying game call of cthulhu is a thematic scenario supplement for chaosium 's mythos roleplaying game . Contains six stand-alone scenarios focusing on the darkness of the human soul . "when this lousy war is over" by brian m. sammons : aftermath of wartime service in massachusetts .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dig_Me_No_Grave">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RobertEHowardWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dig Me No Grave</rdfs:label>
    <ex:hasAnnotation>The short story is part of a series of stories by american fantasy and horror writer robert e. howard set in the h. p. lovecraft 's cthulhu mythos . It was also published as "john grimlan's debt" in 1937 issue of weird tales . Story was adapted by roy thomas and gil kane in marvel 's horror comic journey into mystery .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Cthulhu Mythos</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Vasili_Oukranikov">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Vasili Oukranikov</rdfs:label>
    <ex:ceasedOnC>c. 1864</ex:ceasedOnC>
    <ex:hasAnnotation>Oukranikov was a werewolf in life, and in death is a ghost who haunts the devil's woods between mayfair and glendale in maine . The character, a russian immigrant, is described as "a tall, thin, handsome chap with shiny yellow hair and a wonderful manner" when transformed, he takes on "the gaunt form of a great gray wolf"</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Ghost-Eater"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasCreatedByC>C. M. Eddy. Jr.</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#William_C._Marchese">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>William C. Marchese</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Editor Artist https://www.wcmarchese.com/ is an editor and occasional artist who has worked on a number of Lovecraftian and Cthulhu Mythos publications, usually in partnership with Jesse Dedman through the Deadman's Tome independent publishing label. Selected Bibliography Editor Cthulhu Christmas Special and Other Lovecraftian Yuletide Tales (2017, with Jesse Dedman ) Artist Cthulhu Christmas Special and Other Lovecraftian Yuletide Tales (2017, with Jesse Dedman ) See Also Images by External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasWebsiteR>https://www.wcmarchese.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Artist</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Eibon_Saith:_The_Apophthegmata_of_Eibon">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Eibon Saith: The Apophthegmata of Eibon</rdfs:label>
    <ex:hasAnnotation>Full story online here Robert M. Price United States English Genre(s) Weird fiction Nightscapes date September 1997 " " is a short pseudo-factual work by American and editor Robert M. Price . Synopsis The piece comprises a collection of twenty quotes from the sorcerer Eibon of Mhu Thulan . History "" was first published in the September 1997 edition of online fanzine Nightscapes . It later appeared in the anthology The Book of Eibon , edited by Price himself, in 1997.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Nightscapes"/>
    <ex:wasPublishedOnW>September 1997</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Creature_Companion">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Creature Companion</rdfs:label>
    <ex:hasAnnotation>Scott David Aniolowski United States English Call of Cthulhu Genre(s) Roleplaying game Chaosium Release Date 1998 112 : A Core Game Book for Keepers is a gamebook supplement for Chaosium 's Call of Cthulhu horror roleplaying game. Written by prolific American games designer Scott David Aniolowski , it was published in a paperback format in 1998. Overview Running to a total of 112 , combines the contents of two earlier "monster manual"-style gamebooks, Ye Booke of Monstres (1994) and Ye Booke of Monstres II (1995), with a selection of new entities and additional background material. was later developed into another sourcebook, Malleus Monstrorum , a greatly expanded version of the original, released in 2006 and again in 2020.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Scott_David_Aniolowski"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>112</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>1998</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Montesi_Formula">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Montesi Formula</rdfs:label>
    <ex:hasAnnotation>Roger Stern Dan Green , Terry Austin English Marvel Comics Release Date August, 1983 - December, 1983 Media Type Comic book is a 4-part story arc that wraps up several vampire related storylines, in Doctor Strange Vol. 2 #59 (August, 1983) to #62 (December, 1983), written by Roger Stern , Dan Green , Terry Austin Synopsis The Sorcerer Supreme Doctor Strange and his allies use a spell from the Darkhold to put an end to the vampire threat. Notes In the mainstream Marvel Universe , the Darkhold is the black magic book containing the magical knowledge of the Elder God Chthon . Abdul Alhazred derived the Necronomicon from the Darkhold (though another non-exclusive origin has been theorized for both books and others ). During the Pre-Cataclysmic Age , using the Darkhold, the first Darkholders (followers of Thulsa Doom ), possibly with Lilith , created the first Vampire by transforming their wounded fellow Varnae .</ex:hasAnnotation>
    <ex:hasAuthorW>Roger Stern</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1983 http://example.org/lovecraft#August 1983 - December</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Opener_of_the_Way">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Opener of the Way</rdfs:label>
    <ex:hasAnnotation>Robert Bloch Cover Artist Ronald Clyne United States English Arkham House Release Date 1945 Media Type Print 309 is an anthology of fantasy and horror shorts by Robert Bloch . Overview Published by Arkham House in 1945, was released as a limited edition in a run of 2,065 copies. Panther Books issued a British hardcover release in 1974, and in 1991, it was translated for release in Italian. Contents "By Way of Introduction" "The Cloak" "Beetles" "The Fiddler's Fee" " The Mannikin " "The Strange Flight of Richard Clayton" "Yours Truly, Jack the Ripper" " The Seal of the Satyr " " The Dark Demon " " The Faceless God " "The House of the Hatchet" " " "Return to the Sabbath" "The Mandarin's Canaries" "Waxworks" " The Feast in the Abbey " " Slave of the Flames " " The Shambler from the Stars " "Mother of Serpents" " The Secret of Sebek " " The Eyes of the Mummy " "One Way to Mars"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_Bloch"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>309</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1945</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Eater_of_Souls">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Eater of Souls</rdfs:label>
    <ex:hasAnnotation>Sindara of bel yarnak sets off to face a creature whose calls have been dragging his people to their deaths in the gray gulf of yarnak . He calls on the god vorvadoss for help but gets nothing but a cryptic message . He reaches the gray gulf of yarnak and faces the eater of souls in battle . After another message from vorvadoss he realises that he has to merge with the creature and sacrifice himself .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Henry_Kuttner"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>January 1937</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Thing_on_the_Doorstep_%28Simon_Birks%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Thing on the Doorstep (Simon Birks)</rdfs:label>
    <ex:hasAnnotation>The Thing on the Doorstep H. P. Lovecraft (original story) Simon Birks (adaptation) Willi Roberts United Kingdom English Blue Fox Comics Release Date 2022 The Thing on the Doorstep is a comic book format adaptation of H. P. Lovecraft 's short story of the same name , written for the format by Simon Birks , and featuring artwork by Willi Roberts. It was released in 2022 in a three-issue miniseries by Blue Fox Comics; both paperback and digital editions were issued. Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Simon_Birks"/>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2022</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Enchanted_Fruit">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RamseyCampbellWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Enchanted Fruit</rdfs:label>
    <ex:hasAnnotation>Ramsey Campbell United Kingdom English Genre(s) Horror Appears in Demons by Daylight 1975 " " is a short story by Ramsey Campbell that appears in his 1975 collection Demons by Daylight . It takes place in Campbell's Severn Valley setting, with scenes in Brichester and in the woods near Goatswood . Synopsis The plot involves Derek, a Brichester librarian, who retreat from "the daily press of Brichester, the false harsh rainbow of packed cars", into the woods near Goatswood. At first he finds them enticing--"Each corridor of trees seemed made to be explored, each green shadow promised mystery"--and later forbidding; "A screen of leaves seemed secretive; parted, it revealed only vistas of dim branches." In the forest, he finds a tree whose "rich trunk, dark yet warm, stood alone on a mound of autumn built high from the edge of the glade;" he eats the fruit of this tree, "large as apples, soft and shaped as peaches", to his immediate delight and eventual regret.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Demons_by_Daylight"/>
    <ex:isPublishedAsW>1975</ex:isPublishedAsW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Psychopompos">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Psychopompos</rdfs:label>
    <ex:hasAnnotation>": a tale in rhyme" is a narrative poem by h. p. lovecraft . It tells of the reclusive sieur deblois, and his equally secretive wife . The narrator seems to doubt the veracity of these rumours, reminding themselves that people who tell them aren't particularly trustworthy .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Vagrant"/>
    <ex:wasPublishedOnW>1919</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Watchtower_of_Thapnen">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Watchtower of Thapnen</rdfs:label>
    <ex:hasAnnotation>Dreamlands ( Olathoë ) Tower First appearance HPL : " Polaris " Created by H. P. Lovecraft The is a tower in the Lomarian city of Olathoë in the Dreamlands . The purpose of the tower is to guard the narrow pass that comes up from behind Mount Noton , providing a defense against potential invaders that would use the pass to launch a surprise attack against Olathoë. In such a case, a signal fire would be lit at the top of the tower to warn the soldiers and thereby save the city from immediate disaster. ( HPL : " Polaris ")</ex:hasAnnotation>
    <ex:hasTypeL>Tower</ex:hasTypeL>
    <ex:isLocatedAtL>Dreamlands ( Olathoë )</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#Polaris"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Outsider_and_Others">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Outsider and Others</rdfs:label>
    <ex:hasAnnotation>H. p. lovecraft: outsider, published in 1939, is the first ever collection of his fiction . The collection included lovecraft's classic essay " supernatural horror in literature " . The book was issued in an edition of 1,268 copies, which sold out by 1944 . The collection has never been reprinted .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>553</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1939</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Stephen_Mark_Rainey">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Stephen Mark Rainey</rdfs:label>
    <ex:hasAnnotation>Author and editor of numerous novels and short stories set in the fictional cthulhu mythos of h. p. lovecraft . Many of his early works were published in robert m. price's crypt of cthulhu and other magazines under price's cryptic publications label . Many of his lovecraftian stories are set in or around the fictional community of aiken mill, a rural community in southwest virginia .</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>http://www.stephenmarkrainey.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Writer</ex:isConnectedToMythosR>
    <ex:wasBornOnR>2 May 1959</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#M._Wayne_Miller">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>M. Wayne Miller</rdfs:label>
    <ex:hasAnnotation>Pseudonym(s) Wayne M Connection to the Mythos Illustrator Horror Weird Fiction Science Fiction http://www.mwaynemiller.com/ is an artist and illustrator who has created many images for the expanded Cthulhu Mythos inspired by H. P. Lovecraft . Overview Primarily focussing on the horror, science fiction and weird fiction genres, has provided both cover and interior artwork for a wide variety of publications including periodicals, anthologies, full-length fiction and game modules. He has stated that he works mostly with the digital medium, transferring initial paper artwork onto computer to perform the painting. Selected Works Cover Art Arkham Nights: Tales of Mythos Noir (2016) by Glynn Owen Barrass and Ron Shiflet The Derelict (2016, artist) by Sandy Petersen with Mike Mason Arkham Detective Agency: A Lovecraftian-Noir Tribute to C. J. Henderson (2017) Dead Light &amp; Other Dark Turns (2020) Alone Against the Tide (2020) by Nicholas Johnson Interior Art Utatti Asfet (1996) Atomic-Age Cthulhu (2013) by various The Derelict (2016, artist) by Sandy Petersen with Mike Mason Return of the Old Ones (2017) by various External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasPseudonymR>Wayne M</ex:hasPseudonymR>
    <ex:hasWebsiteR>http://www.mwaynemiller.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Illustrator</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Festival">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Festival</rdfs:label>
    <ex:hasAnnotation>The story is considered to be one of his first of his cthulhu mythos stories . It was inspired by lovecraft's first trip to marblehead , massachusetts, in december 1922 . The idea of "pre-aryan" survivals was the basis of arthur machen's " the novel of the black seal "</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>January 1925</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Nyarlathotep_Event">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Nyarlathotep Event</rdfs:label>
    <ex:hasAnnotation>The book of cthulhu ii is a short story by jonathan wood . It was published in the anthology the book of cthulhu by night shade press .</ex:hasAnnotation>
    <ex:hasAuthorW>Jonathan Wood</ex:hasAuthorW>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Book_of_Cthulhu_II"/>
    <ex:wasPublishedOnW>October 2012</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nunn-Jahad">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Nunn-Jahad</rdfs:label>
    <ex:ceasedOnC>21st Century</ex:ceasedOnC>
    <ex:hasAffiliationC>The other Ogdru Jahad</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#Godzilla"/>
    <ex:hasAlternativeNamesC>Behemoth</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Child of Thunder</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Dragon</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Ogdru jahad is one of the seven gods of chaos in the fictional universe of hellboy by dark horse comics . Overview was created alongside his six siblings during the begining of time, made out of mud and fire by the watchers . The dragons were defeated and imprisoned in a crystal prison in the heart of the cosmos .</ex:hasAnnotation>
    <ex:hasAppearanceC>B.P.R.D.: Hell on Earth</ex:hasAppearanceC>
    <ex:hasCharacterMateC>None</ex:hasCharacterMateC>
    <ex:madeFirstAppearanceOnC>Hellboy: Seed of Destruction</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Mike_Mignola"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bast">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ElderGods"/>
    <rdfs:label>Bast</rdfs:label>
    <ex:hasAffiliationC>Elder Gods</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Bastet</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Bubastis</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Goddess of Cats</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Pasht</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Bubastis is the egyptian goddess of cats and in legend the daughter of isis . She appears as a female human with a cat's head or regular cat in egyptian mythology . The additional 'et' ending is added merely to emphasize the t in her name which is female .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Brood_of_Bubastis"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Suicide_in_the_Study"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Robert_Bloch"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Deadfall_in_the_Parking_Lot">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Deadfall in the Parking Lot</rdfs:label>
    <ex:hasAnnotation>Cthulhu mythos is a short story by french author fransis erdman . It was first published in lovecraftiana vol 5, issue 4 in 2021 . Despite being included in a magazine dedicated to lovecraft -inspired fiction, appears to draw more on stephen king's pet sematary .</ex:hasAnnotation>
    <ex:hasAuthorW>Francis Erdman</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 4</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 5</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2021</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Erich_Zann">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Erich Zann</rdfs:label>
    <ex:hasAnnotation>Zann is a german musician who, at the end of his life, lived in a tenement in an unspecified french city . He is completely mute and earns his living by playing the viol as part of a small theater orchestra . Despite his reclusive and eccentric attitude, the narrator is able to befriend him and asks him to play some of his pieces .</ex:hasAnnotation>
    <ex:hasAppearanceC>Demonbane When the Dweller Awakes</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Music_of_Erich_Zann"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crypt_of_Cthulhu_Yuletide_1981">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crypt of Cthulhu Yuletide 1981</rdfs:label>
    <ex:hasAnnotation>Various Robert M. Price Cover Artist Robert M. Price United States English Crypt of Cthulhu Release Date December 1981 32 Preceded by Hallowmas 1981 Followed by Candlemas 1982 was the second issue of Robert M. Price 's long-running Lovecraftian fanzine Crypt of Cthulhu . Edited by Price, it ran to a total of 32 in an A5 format and was self-published in December 1981. Price also provided artwork for the issue, the cover of which depicts a battle between Cthulhu and Godzilla . Contents Editorial Shards by Robert M. Price "What Was the "Corpse-Eating Cult of Leng"?" by Robert M. Price "Lovecraft the Name-Dropper" by Charles Garofalo "The Statement of Lin Carter" by Robert M. Price "A Fun Guy from Yuggoth: The Occult Relevance of Lovecraft" by Ronald Shearer Reviews by C. J. Henderson Letters by L. Sprague de Camp , Gerry de la Ree, Brian Lumley , John Warwick Montgomery, and uncredited contributors</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>32</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu"/>
    <ex:wasReleasedOnW>December 1981</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Masks_of_Nyarlathotep_%28Eldritch_Horror%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Masks of Nyarlathotep (Eldritch Horror)</rdfs:label>
    <ex:hasAnnotation>Masks of Nyarlathotep Dane Beltrami Tim Uren Nikki Valens Fantasy Flight Games Publication Date Late 2018 Board game Eldritch Horror Masks of Nyarlathotep is a large-box expansion for Fantasy Flight Games ' Cthulhu Mythos board game Eldritch Horror . Based on the Chaosium Call of Cthulhu supplement from which it takes its name , it was designed by Dane Beltrami, Tim Uren, and Nikki Valens , and released in late 2018. Overview Gallery External Links Masks of Nyarlathotep launch announcement at Fantasy Flight Games</ex:hasAnnotation>
    <ex:wasPublishedOnW>Late 2018</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Starry_Wisdom_%28anthology%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Starry Wisdom (anthology)</rdfs:label>
    <ex:hasAnnotation>The starry wisdom: a tribute to h.p. Lovecraft is an anthology of lovecraftian writing . Edited by d.m. Mitchell, it was published by creation books in 1995 . In 2012, elektron books released the sequel, the starry wisdom .</ex:hasAnnotation>
    <ex:hasAuthorW>D. M. Mitchell</ex:hasAuthorW>
    <ex:hasAuthorW>editor</ex:hasAuthorW>
    <ex:hasPageCountW>177</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>February 1995</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yule-Thoughts_in_Kingsport">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Yule-Thoughts in Kingsport</rdfs:label>
    <ex:hasAnnotation>Full story online here Ann K. Schwader English Yith Press Eldritch Tales Summer 1992 date July 1992 " " is a Cthulhu Mythos poem by American poet Ann K. Schwader . It was first published in the Summer 1992 issue of long-running weird fiction magazine Eldritch Tales . Synopsis The fourteen lines describe the narrator's horror at the supernatural elements which lurk just below the surface of their small town, Kingsport . It makes reference to Cthulhu Mythos stories such as H. P. Lovecraft 's " The Festival ". History Since its first appearance, "" has also appeared in the Keith Allen Daniels-edited anthology The Three Sonneteers (June 2000, Anamnesis Press), the collection of Schwader's own works The Worms Remember (2001, Hive Press), and the E. P. Berglund -edited online zine Nightscapes ( December 2006 ).</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ann_K._Schwader"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Eldritch Tales Summer 1992</ex:isPublishedAsW>
    <ex:wasPublishedOnW>July 1992</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#hasOriginA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>hasOriginA</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdfs:range rdf:resource="http://example.org/lovecraft#Location"/>
