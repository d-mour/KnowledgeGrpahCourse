    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Bride of the Beast</rdfs:label>
    <ex:hasAnnotation>The dark rites of cthulhu was published in the anthology the dark rites of cthulhu in march 2014 . Is a short story by american author glynn owen barrass .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Glynn_Owen_Barrass"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
