  <rdf:Description rdf:about="http://example.org/lovecraft#The_Street">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Street</rdfs:label>
    <ex:hasAnnotation>The wolverine is a short story by american horror fiction writer h.p. Lovecraft . The story traces the history of the eponymous street in a new england city, presumably boston . After world war i and the october revolution, the area becomes home to a community of russian immigrants .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Wolverine"/>
    <ex:wasPublishedOnW>December 1920</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Red_Offering">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Red Offering</rdfs:label>
    <ex:hasAnnotation>"the offering" is a short story in the xothic legend cycle . It was first published in 1982 in the magazine crypt of cthulhu . Story purports to be part of the translation of the zanthu tablets .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Xothic_Legend_Cycle"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu_Lammas_1982"/>
    <ex:wasPublishedOnW>August 1982</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Australia">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Australia</rdfs:label>
    <ex:hasAnnotation>Southern hemisphere continent/nation is a nation and a continent in the southern hemisphere . It features in the fiction of h. p. lovecraft (most notably in the story " the shadow out of time" "the call of cthulhu" appears more incidentally in " the call of cthulhu " (1928)</ex:hasAnnotation>
    <ex:hasTypeL>Continent</ex:hasTypeL>
    <ex:hasTypeL>Nation</ex:hasTypeL>
    <ex:isLocatedAtL>Southern Hemisphere</ex:isLocatedAtL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Death_Song_of_Kulan_Gath">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Death Song of Kulan Gath</rdfs:label>
    <ex:hasAnnotation>Kurt Busiek George Perez, Al Vey, Scott Hanna English Marvel Comics Release Date May 2000-July 2000 Media Type Comic book is a 3-part story arc in issues #28-30 of the 3rd volume of The Avengers written by Kurt Busiek. Synopsis The Hyborian sorcerer Kulan Gath attempts to ascend to godhood and in the process destroy the Earth.</ex:hasAnnotation>
    <ex:hasAuthorW>Kurt Busiek</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>May 2000-July 2000</ex:wasReleasedOnW>
  </rdf:Description>
