  <rdf:Description rdf:about="http://example.org/lovecraft#Mirror_Dimension">
    <rdf:type rdf:resource="http://example.org/lovecraft#Dimensions"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsOriginatingFromMythosInspiredWorks"/>
    <rdfs:label>Mirror Dimension</rdfs:label>
    <ex:hasAccessibilityL>(To humans) mystical portals</ex:hasAccessibilityL>
    <ex:hasAccessibilityL>reflective surfaces</ex:hasAccessibilityL>
    <ex:hasAnnotation>The is a fictional dimension in the evil dead universe . It was later retconned as first appearing in the 1987 movie evil dead ii . The spirits of slain demons and deadites live in this dimension .</ex:hasAnnotation>
    <ex:hasNotableFeatureL>constantly changing landscape</ex:hasNotableFeatureL>
    <ex:hasTypeL>Alternate Dimension</ex:hasTypeL>
    <ex:isInhabitedByL>Dark Ones</ex:isInhabitedByL>
    <ex:isInhabitedByL>Deadites</ex:isInhabitedByL>
    <ex:isInhabitedByL>Human Souls (consumed or killed by evil)</ex:isInhabitedByL>
    <ex:madeFirstAppearanceOnL>Evil Dead II</ex:madeFirstAppearanceOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Miskatonic_University:_The_Restricted_Collection">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Miskatonic University: The Restricted Collection</rdfs:label>
    <ex:hasAnnotation>Reiner Knizia Chaosium Publication Date 2019 Competitive card game is a Cthulhu Mythos competitive card game created by prolific German Reiner Knizia and published by Chaosium in 2019. Overview The game involves 2-5 players taking on the role of different faculty members and attempting to gather occult knowledge for Dr. Henry Armitage from Miskatonic University 's restricted archives. To represent this, the players must collect card sets to score points, while avoiding collecting duplicates. The player with the highest score after 5 rounds is declared the winner. Behind the Mythos To fit with the theme of mystical grimoires and the university library, the box is designed to look like an occult volume; opening the front cover reveals the storage area for all playing pieces.</ex:hasAnnotation>
    <ex:wasPublishedOnW>2019</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#HPLovecraftWorks">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Work"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Robert_H_Barlow">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Robert H Barlow</rdfs:label>
    <ex:diedOnR>1951</ex:diedOnR>
    <ex:hasAnnotation>Author and collector. As a teenager he corresponded with Lovecraft and acted as his host during two long visits to Florida in the summers of 1934 and 1935. In the 1930s he wrote several works of weird and fantasy fiction, some in collaboration with Lovecraft. Lovecraft appointed him his literary executor. He assisted August Derleth and Donald Wandrei in preparing the early Lovecraft volumes for Arkham House. In the 1940s he went to Mexico and became a distinguished anthropologist. He died by suicide.</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1918</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Lovecraft_Investigations">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAudioAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Lovecraft Investigations</rdfs:label>
    <ex:hasAnnotation>Premise follows two podcasters, . Matt heawood and kennedy fisher, co-hosts of the true-crime podcast . Mystery machine . Each series revolves around the events of a particular h. p. lovecraft story, with the events, characters, and locations updated to reflect a modern setting .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasWriterW>Julian Simpson</ex:hasWriterW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Case_of_Charles_Dexter_Ward"/>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Haunter_of_the_Dark"/>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Shadow_Over_Innsmouth"/>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Whisperer_in_Darkness"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>January 2019 - October 2023</ex:wasReleasedOnW>
  </rdf:Description>
