  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dead_Light_%26_Other_Dark_Turns">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dead Light &amp; Other Dark Turns</rdfs:label>
    <ex:hasAnnotation>88 : two unsettling encounters on the road is an adventure sourcebook for chaosium 's call of cthulhu roleplaying game . Contains two ready-play scenarios, six pre-generated characters, a set of player handouts, and plot seed ideas .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>88</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
