  <rdf:Description rdf:about="http://example.org/lovecraft#Mercy_Holds_No_Measure">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Mercy Holds No Measure</rdfs:label>
    <ex:hasAnnotation>Kenneth Bykerk United States English Genre(s) Horror Wildside Press Weirdbook Annual 2 date February 2019  " " is a short story by Kenneth Bykerk . Synopsis A hardworking drifter during the early years of the colonisation of North America stumbles across an exposed vein of pure gold. However, his excavations uncover more than precious metal, and a subterranean abomination ensnares him for its own entertainment. Characters Samuel Delrosa , a restless spirit trying to find a line of work which suits him. History "" was published in the collection Weirdbook Annual 2 by Wildside Press in 2019.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Kenneth_Bykerk"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Weirdbook Annual 2</ex:isPublishedAsW>
    <ex:wasPublishedOnW>February 2019</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nemesis">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Nemesis</rdfs:label>
    <ex:hasAnnotation>Full story online here H. P. Lovecraft United States English French The Vagrant date June 1918 𝐓 " " is a poem by the late American Howard Phillips Lovecraft . First published in The Vagrant in June 1918, it has since been reprinted many times, including in pulp magazine Weird Tales , numerous collections of Lovecraft's poetry, and has also been translated into French.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Vagrant"/>
    <ex:wasPublishedOnW>June 1918</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Pascal_Godbout">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Pascal Godbout</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Traditional games designer Roleplaying games Notable Works EXP : The Rise of Tsathoggua is a games designer who has written a handful of supplements for the Fate of Cthulhu roleplaying game, based on the system-agnostic Fate ruleset. To date, these have been published entirely through small-press publisher Evil Hat Productions . He may be related to Thalia Godbout, who has provided artwork for the two Fate of Cthulhu publications authored by Pascal , although this is currently unconfirmed. Selected Bibliography Fate of Cthulhu Supplements The Ascellan Conspiracy (2023) The Rise of Tsathoggua (2024) External Links designer profile at RPGGeek References</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Traditional games designer</ex:isConnectedToMythosR>
    <ex:isKnownForR rdf:resource="http://example.org/lovecraft#The_Rise_of_Tsathoggua"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nightscapes_May_2003">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Nightscapes May 2003</rdfs:label>
    <ex:hasAnnotation>This is the fifteenth issue of the sporadically-released online fanzine nightscapes . It was edited by the late american and lovecraft scholar edward p. berglund . This issue also featured artwork by garth hill, nicole abrahamson, paul carrick , daryl hutchinson, and toren "macbin" atkinson .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>May 2003</ex:wasReleasedOnW>
  </rdf:Description>
