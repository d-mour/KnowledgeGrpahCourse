    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Miskatonic Nightmares</rdfs:label>
    <ex:hasAnnotation>Various English Alban Lake Publishing Release Date October 2016 185 is a thematic anthology of Lovecraftian fiction edited by Herika R. Raymer and published by Alban Lake Publishing in October 2016. Both digital and print versions were released. Overview</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>185</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>October 2016</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Voormi">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Voormi</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Tsathoggua"/>
    <ex:hasAnnotation>The (plural: voormis) are a fictional race of cave-dwelling humanoids who worship tsathoggua . They are described as three-toed, umber-colored, fur-covered humanoids though they are carefully differentiated from their traditional enemies . They reside in the continent of hyperborea, which will be known in the future as mhu thulan .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Scroll_of_Morloc"/>
    <ex:hasAppearanceC>Trail of Tsathoggua</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Seven_Geases"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Annals_of_the_South_Part_Two">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Annals of the South Part Two</rdfs:label>
    <ex:hasAnnotation>The story was published in the anthology swords against cthulhu ii: hyperborean nights by rogue planet press in january 2017 . The title refers to the name of a fictional book, and not to its position in a series .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#John_C._Adams"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Swords_Against_Cthulhu_II:_Hyperborean_Nights"/>
    <ex:wasPublishedOnW>January 2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#H._P._Lovecraft:_Tales">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>H. P. Lovecraft: Tales</rdfs:label>
    <ex:hasAnnotation>H. p. lovecraft's fiction is collected in a 2005 volume by the library of america . Lovecraft was not the first writer of weird fiction to be included in the canon . Previous volumes had been dedicated to hawthorne and eap .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasAuthorW>Peter Straub</ex:hasAuthorW>
    <ex:hasAuthorW>editor</ex:hasAuthorW>
    <ex:hasPageCountW>838</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2005</ex:wasReleasedOnW>
  </rdf:Description>
