  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mythos:_Lovecrafts_Worlds">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Mythos: Lovecraft's Worlds</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft (original stories) Brandon Barrows (adaptations) Hugo Petrus United States English Genre(s) Weird fiction Caliber Comics Release Date 2016 106 is a collection of comic book adaptations of the works of Howard Phillips Lovecraft . Overview Containing a selection of short story adaptations, runs to a total of 106 . The stories were adapted by Brandon Barrows, feature artwork by Hugo Petrus, and were published by Caliber Comics in a softcover format in October 2016. The cover is in full colour whilst the interiors are black and white. Contents " Pickman's Model " " The Strange High House in the Mist " " The Beast in the Cave " " The Cats of Ulthar " " Cool Air " " The White Ship " " The Curse of Yig " " Ibid " Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brandon_Barrows"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:hasPageCountW>106</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2016</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crypt_of_Cthulhu_Eastertide_1982">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crypt of Cthulhu Eastertide 1982</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Jason C. Eckhardt United States English Crypt of Cthulhu Release Date April 1982 44 Preceded by Candlemas 1982 Followed by Roodmas 1982 was the fourth issue of Robert M. Price 's long-running Lovecraftian fanzine Crypt of Cthulhu . Edited by Price, it featured cover art by Jason C. Eckhardt , ran to a total of 44 in an A5 format, and was self-published in April 1982. Interior artwork was provided by Price, Richard Abate, and Darrell Schweitzer . This edition was billed as a " Special Lovecraft and modern science issue ". Contents Editorial Shards by Robert M. Price " Lovecraft's Other Planets " by S. T. Joshi "Living on Borrowed Time: A Biologist Looks at "M. Valdemar" and "Cool Air"" by Bert Atsma "The Cosmology of Azathoth: Modern Physics and the Idiot Chaos" by Nevil Kingston-Brown "Lovecraft, Mathematics, and the Outer Spheres" by Donald R. Burleson "Seneca Lapham on Scientific Paradigm Revolutions" by Robert M. Price "The Mischief Out of Time" by Robert M. Price "Fun Guys from Yuggoth: Son of Cthulhu" by Jason C. Eckhardt Reviews by C. J. Henderson and Robert M. Price Letters by Robert Bloch , by Colin Wilson , L. Sprague de Camp , Darrell Schweitzer , Michael H. Cline, Robert C. Carey, Jr., and James Platt (I)</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>44</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu"/>
    <ex:wasReleasedOnW>April 1982</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lockbox">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lockbox</rdfs:label>
    <ex:hasAnnotation>Despite being set in his keyport milieu, it has no connection to the keyport cthulhu cycle . A police detective investigating a series of brutal murders finds his inquiries taking him to the strange fishing town of keyport . There he discovers the murderer, a man who has killed to keep a copy of the revelations of gla'aki from reaching the hands of innocents .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Armand_Rosamilia"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Keyport_Cthulhu"/>
    <ex:wasPublishedOnW>2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Alan_Dean_Foster">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Alan Dean Foster</rdfs:label>
    <ex:hasAnnotation>Alandean foster is an american sci-fi and fantasy author . His works include the pip &amp; flenx series and the icerigger trilogy . Some of his stories are set in the cthulhu mythos .</ex:hasAnnotation>
    <ex:hasBirthplaceR>New York United States</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://alandeanfoster.com/version2.0/frameset.htm</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>18 November 1946</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Made_in_Goatswood">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Made in Goatswood</rdfs:label>
    <ex:hasAnnotation>The volume contains seventeen stories from a variety of authors along with a new piece from campbell himself and a map of the severn valley . Edited by scott david aniolowski, the volume runs to 268 pages .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>268</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu Fiction</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>July 1995</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#High_Voltage_Kill">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>High Voltage Kill</rdfs:label>
    <ex:hasAnnotation>Robin D. Laws English Cthulhu Confidential Pelgrane Press 38 is a scenario supplement for Pelgrane Press 's Cthulhu Mythos roleplaying game Cthulhu Confidential . Written by Robin D. Laws , one of the designers of the core game, it was initially published only as a digital download, but was later included in the omnibus collection Even Death Can Die . Overview</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robin_D._Laws"/>
    <ex:hasPageCountW>38</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Cthulhu_Confidential"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Apocalypse">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Apocalypse</rdfs:label>
    <ex:hasAnnotation>Graham Walmsley Gareth Ryder-Hanrahan Cover Artist Alessandro Alaia English Trail of Cthulhu Genre(s) Roleplaying game Pelgrane Press Release Date 2015 216 is a gamebook supplement for the Pelgrane Press pen-and-paper roleplaying game Trail of Cthulhu . Written by Graham Walmsley and Gareth Ryder-Hanrahan and featuring cover art by Alessandro Alaia, it runs to a total of 216 , and was published by Pelgrane in 2015; both hardcover and digital editions were released. Overview The book contains a selection of character creation tools and options, all custom-designed to be used in campaign with a post-apocalyptic theme. It also features several previously-published scenarios, and eight all-new ones for use in the same setting.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Gareth_Ryder-Hanrahan"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Graham_Walmsley"/>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>216</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Trail_of_Cthulhu"/>
    <ex:wasReleasedOnW>2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kulan_Gath">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Kulan Gath</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#NGarai"/>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Set"/>
    <ex:hasAnnotation>Marvel is a fictional character in the marvel universe who first appeared in 1972 in issue #14 of the 1st volume of conan the barbarian . He also has starred in the red sonja line of comics published by dynamicmite entertainment . He was an incredibly powerful sorcerer, whose power approached the level of the sorcerer supreme, doctor strange .</ex:hasAnnotation>
    <ex:hasAppearanceC>Marvel: The Second Coming of Shuma-Gorath An Age Undreamed Of The Death Song of Kulan Gath Dynamite: Prophecy</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC>Conan the Barbarian Vol 1 14</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Roy_Thomas"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Feaster_from_Afar_%28story%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Feaster from Afar (story)</rdfs:label>
    <ex:hasAnnotation>The feaster from afar" is a horror short story by joseph payne brennan . It was published in 1976 in the anthology the disciples of cthulhu . It tells the story of a professional author who rents a hunting lodge . He starts to experience nightmares and inexplicable fatigue .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Wizards_Daughter">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Wizard's Daughter</rdfs:label>
    <ex:hasAnnotation>Ann K. Schwader United States English Wildside Press Weirdbook Annual 2 date February 2019 " " is a Cthulhu Mythos poem by American and poet Ann K. Schwader . Synopsis The seven verses describe in brief the story of Asenath Waite and how her body was stolen by her father Ephraim , as first told in the H. P. Lovecraft short story " The Thing on the Doorstep ." History "A Wizard's Tale" was published in the Wildside Press anthology Weirdbook Annual 2 in February 2019.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ann_K._Schwader"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Weirdbook Annual 2</ex:isPublishedAsW>
    <ex:wasPublishedOnW>February 2019</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Gnai-Kah">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Gnai-Kah</rdfs:label>
    <ex:hasAffiliationC>Lobon Tamash Zo-Kalar</ex:hasAffiliationC>
    <ex:hasAnnotation>Mnar ( Sarnath ) High Priest Lobon Tamash Zo-Kalar Human First appearance HPL : " The Doom That Came to Sarnath " Created by H. P. Lovecraft was the high priest of the city of Sarnath at the time of the city's destruction from the vengeance of Bokrug . ( HPL : " The Doom That Came to Sarnath ")</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Doom_That_Came_to_Sarnath"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lilith">
    <rdf:type rdf:resource="http://example.org/lovecraft#Avatars"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Lilith</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Nodens"/>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#Ilythla"/>
    <ex:hasAlternativeNamesC>The Queen of the Night</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Exp : malleus monstrorum is a demonic character mentioned in jewish folklore . According to one account, she is an avatar of our ladies of sorrow . According to another, she is a great one said to have been an ancient one shaped like a female gug .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Malleus_Monstrorum"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Horror_at_Red_Hook"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Simon_Orne">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Simon Orne</rdfs:label>
    <ex:hasAlternativeNamesC>Jedidiah Orne</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Josef Nadek</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as jedidiah orne and josef nadek necromancer . Associate and collaborator of the main villain, joseph curwen . Lived in salem, massachusetts, until 1771, when he left for good .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Case_of_Charles_Dexter_Ward"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Final_Space">
    <rdf:type rdf:resource="http://example.org/lovecraft#MediaAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Final Space</rdfs:label>
    <ex:hasAnnotation>Invictus, the main antagonist of the series, is based on satan from christianity . Some elements of invictus' character were inspired by the antagonist from the cosmic horror short story, " the colour out of space " . The series featured lovecraftian horror elements .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>Canada</ex:hasCountryOfOriginW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW>Lovecraftian Horror</ex:isBasedOnW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2021 2018 – June 14 February 26</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shista">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Shista</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>God of Fidelity</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as God of Fidelity Great Old Ones Great Old Ones First appearance CIRCLE : " The Fidelity of Ghu " Created by R. H. Barlow , God of Fidelity , is a Great Old One created by the late American author R. H. Barlow for his short story "The Fidelity of Ghu". Overview A shape-shifting Great Old One that mainly manifests as a spiny five-legged crab, possesses a spider-like head and wears metallic bracelets on each limb.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Fidelity of Ghu</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#R._H._Barlow"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Paul_Dale_Anderson">
    <rdf:type rdf:resource="http://example.org/lovecraft#Critics"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Paul Dale Anderson</rdfs:label>
    <ex:diedOnR>13 December 2018</ex:diedOnR>
    <ex:hasAnnotation>Pseudonym(s) Paul Andrews Irwin Chapman Connection to the Mythos Author Birth Date 11 September 1944 Rockford, Illinois, USA Death Date 13 December 2018 United States Horror Fantasy Science Fiction (11 September 1944 - 13 December 2018) was an American author, critic and former vice-president and trustee of the Horror Writers Association. His Lovecraftian works have appeared in anthologies including Cthulhu: Weirdbook Annual 2 and The Arkham Sampler . Anderson counted popular horror writer and Cthulhu Mythos contributor Stephen King as amongst his major influences . Selected Bibliography Short Fiction " Tricks No Treats " (2019) External Links at the Internet Speculative Fiction Database at Goodreads References</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Illinois Rockford</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasPseudonymR>Irwin Chapman</ex:hasPseudonymR>
    <ex:hasPseudonymR>Paul Andrews</ex:hasPseudonymR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>11 September 1944</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Chilean_Gothic">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleFilmAndTelevisionAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Chilean Gothic</rdfs:label>
    <ex:hasAnnotation>Based on " Pickman's Model " Ricardo Harrington Production Company Kaos Producciones Release date 4 October 2000 Running time 45 minutes Chile Spanish is a 2000 Spanish- film based on the H. P. Lovecraft short story " Pickman's Model ". Synopsis A journalist searches for his missing friend who had recently been obsessing over artist Richard Upton Pickman . His investigations lead him to the terrifying truth behind Pickman's inspirations. Behind the Scenes Directed by Ricardo Harrington, was released on 4 October 2000 in Chile. It was also screened at the H. P. Lovecraft Film Festival the following year.</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>Chile</ex:hasCountryOfOriginW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#Pickmans_Model"/>
    <ex:isInLanguageW>Spanish</ex:isInLanguageW>
    <ex:wasReleasedOnW>4 October 2000</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Incident_at_the_Hanford_Inn">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Incident at the Hanford Inn</rdfs:label>
    <ex:hasAnnotation>Frank Forte English Asylum Press Beyond Lovecraft date September 2020  " " is a Lovecraftian short story by American Frank Forte , first published in his collection Beyond Lovecraft by Asylum Press in September 2020. Synopsis A journalist in post-civil war America investigates the reports of a missing child at the supposedly-abandoned Hanford Inn. What he finds there is a ghostly innkeeper and a demonic minion who use their dark magic to cloud his mind and cause him to shoot several innocent people who he mistakes for enemies. The man is soon captured by the vengeful authorities and hung, nobody ever believing his stories about magic and monsters.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Frank_Forte"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Beyond_Lovecraft"/>
    <ex:wasPublishedOnW>September 2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Kiss_of_Bugg-Shash">
    <rdf:type rdf:resource="http://example.org/lovecraft#BrianLumleyWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Kiss of Bugg-Shash</rdfs:label>
    <ex:hasAnnotation>"demoniacal" is a cthulhu mythos story by brian lumley . It first appeared in a pamphlet called cthulhu 3: tales of the cthulhu mythos in 1978 . It is a sequel to the short horror story "demoniacal," by david sutton .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Cthulhu 3: Tales of the Cthulhu Mythos</ex:isPartOfSeriesW>
    <ex:wasPublishedOnW>1978</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dust-Man">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Dust-Man</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Abdul_Alhazred"/>
    <ex:hasAnnotation>Dust-men are a fictional species of beings created by robert horowitz for chaosium's call of cthulhu role-playing game . They appear as humanoid figures in the dreamlands, and spend their time moving piles of dust or sand around in the waking world .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Malleus_Monstrorum"/>
    <ex:wasCreatedByC>Robert Horowitz</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ex_Libris_Miskatonici">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Ex Libris Miskatonici</rdfs:label>
    <ex:hasAnnotation>Joan C. Stanley English Necronomicon Press Publication date August 1993 : A Catalogue of Selected Items from the Special Collections in the Miskatonic University Library is a pseudofactual bibliography of the eldritch tomes that are supposedly found at Miskatonic University , written by Joan C. Stanley and published as a chapbook by Necronomicon Press in 1993. The book provides an in-universe examination of the major (and some minor) imaginary occult books of the Cthulhu Mythos , including origins, translations, publication histories and physical descriptions. The book is divided into sections on the Stone Library, covering the Pnakotic Manuscripts , the Eltdown Shards and Celaeno Fragments , and the G'harne and " Sussex Fragments "; the Department of Eastern Antiquities, including the Seven Cryptical Books of Hsan , the Book of Dzyan , the R'lyeh Text and the Dhôl Chants , and the Ponape Scripture ; and the Darby Collection, which comprises the Codex Dagonensis , Les Cultes des Goules , De Vermis Mysteriis , the Liber Ivonis , and Die Unaussprechlichen Kulten . Though the Necronomicon is described as part of the Darby Collection, it is given its own section. External Link " (1993) by Joan C. Stanley" review at Deep Cuts in a Lovecraftian Vein</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Joan_C._Stanley"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>August 1993</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Fall_of_Cthulhu_Volume_3:_The_Gray_Man">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Fall of Cthulhu Volume 3: The Gray Man</rdfs:label>
    <ex:hasAnnotation>Fall of cthulhu volume 4: godwar is a comic book omnibus . Collects issues 11 to 14 of the cult series fall of cthulhu . Includes two short stories, " the call " and " the rockets' red glare " .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Michael_Alan_Nelson"/>
    <ex:hasPageCountW>100</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>December 2008</ex:wasReleasedOnW>
  </rdf:Description>
