  <rdf:Description rdf:about="http://example.org/lovecraft#A._E._Waite">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPeople"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>A. E. Waite</rdfs:label>
    <ex:diedOnR>19 May 1942</ex:diedOnR>
    <ex:hasAnnotation>Full Name Arthur Edward Waite Connection to the Mythos Possible character inspiration Birth Date 2 October 1857 Brooklyn, New York, USA Death Date 19 May 1942 London, England Great Britain Arthur Edward Waite (2 October 1857 – 19 May 1942) was a British author, poet and occultist who was in part responsible for the creation of the wildly-popular Rider-Waite tarot deck. He was for a time a member of the Hermetic Order of the Golden Dawn, the organisation which inspired the Silver Twilight Lodge , and has been suggested by leading Lovecraft scholar Robert M. Price to be the figure on which " The Thing on the Doorstep "'s Ephraim Waite was based. External Links at Wikipedia</ex:hasAnnotation>
    <ex:hasBirthplaceR>Brooklyn New York USA</ex:hasBirthplaceR>
    <ex:hasFullNameR>Arthur Edward Waite</ex:hasFullNameR>
    <ex:hasNationalityR>Great Britain</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Possible character inspiration</ex:isConnectedToMythosR>
    <ex:wasBornOnR>2 October 1857</ex:wasBornOnR>
  </rdf:Description>
