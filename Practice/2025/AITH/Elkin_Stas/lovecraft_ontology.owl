  <rdf:Description rdf:about="http://example.org/lovecraft#The_Worlds_of_H._P._Lovecraft:_The_Tomb">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Worlds of H. P. Lovecraft: The Tomb</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft (original story) Steven Philip Jones (adaptation) Octavio Cariello United States English The Worlds of H. P. Lovecraft Caliber Comics (Tome Press imprint) Release Date 1997 Preceded by The Worlds of H. P. Lovecraft: The Lurking Fear Followed by The Worlds of H. P. Lovecraft: Beyond the Wall of Sleep is, as its title might suggest, a comic book adaptation of the H. P. Lovecraft short story " The Tomb ". Overview Published by Caliber Comics under their Tome Press imprint, The Tomb was the third in their short-lived Worlds of H. P. Lovecraft . It was adapted by Steven Philip Jones , illustrated by Octavio Cariello , and released in 1997.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Steven_Philip_Jones"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>The Worlds of H. P. Lovecraft</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>1997</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lilith_%28Sandro_D._Fossem%C3%B2%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lilith (Sandro D. Fossemò)</rdfs:label>
    <ex:hasAnnotation>Lilith (Sandro D. Fossemò) Sandro D. Fossemò English (translated from Italian) Rogue Planet Press Lovecraftiana Vol 5, Issue 3 date October 2020 " Lilith " is a fairly long Cthulhu Mythos poem by Italian and scholar Sandro D. Fossemò. Published in Vol 5, Issue 3 of the Lovecraftiana zine by Rogue Planet Press in 2020, it was translated into English by Luca Palantrani. Synopsis The poem describes an encounter with a mysterious, sensual entity named Lilith and her talking crow in the town of Dunwich , Massachusetts . Although somewhat ambiguous in its ending, it appears to conclude with the death of the unnamed narrator.</ex:hasAnnotation>
    <ex:hasAuthorW>Sandro D. Fossemò</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 3</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 5</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2020</ex:wasPublishedOnW>
  </rdf:Description>
