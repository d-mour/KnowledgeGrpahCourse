    <rdfs:label>Cells</rdfs:label>
    <ex:hasAnnotation>Deathrealm is a short story by american jeffrey thomas . It was first published in the september 1993 issue of deathrealm by tal publications .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Jeffrey_Thomas"/>
