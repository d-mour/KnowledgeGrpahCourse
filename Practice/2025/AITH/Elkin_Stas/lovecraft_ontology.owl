  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dunwich_Horror_%28ARTC_audio_drama%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAudioAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dunwich Horror (ARTC audio drama)</rdfs:label>
    <ex:hasAnnotation>The Dunwich Horror (ARTC audio drama) Based on " The Dunwich Horror " Henry Howard H. P. Lovecraft (original story) Thomas E. Fuller (adaptation) Running time 61 minutes United States English The Dunwich Horror is an audio drama adaptation of the H. P. Lovecraft short story of the same name produced by the Atlanta Radio Theatre Company . First performed live on stage at Dragon*Con 2, it was also broadcast on Atlanta radio station WRFG-FM. The complete production is available on the ARTC website in both compact disc and digital download formats.</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasWriterW>http://example.org/lovecraft#H._P._Lovecraft Thomas E. Fuller</ex:hasWriterW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Dunwich_Horror"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Vulthoom_%28short_story%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#ClarkAshtonSmithWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Vulthoom (short story)</rdfs:label>
    <ex:hasAnnotation>" vulthoom " is a short story by the late american and friend of h. p. lovecraft , clark ashton smith . It was first published in the september 1935 edition of weird tales . It has since appeared in a multitude of publications and has been translated into dutch, german, french and italian .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
