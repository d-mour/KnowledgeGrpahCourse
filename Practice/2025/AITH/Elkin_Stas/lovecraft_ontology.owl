    <rdf:type rdf:resource="http://example.org/lovecraft#SpeciesIncorporatedFromFolkloreMythAndReligion"/>
    <rdfs:label>Vampire</rdfs:label>
    <ex:hasAnnotation>Vampires are creatures sustained by the blood or lifeforce of a human . -like creatures occur in h. p. lovecraft's work, and appear more explicitly in other writers of the cthulhu mythos . The legend is a central theme in lovecraft's " the shunned house " .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Chapelwaite"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Malleus_Monstrorum"/>
    <ex:hasAppearanceC>Call of Cthulhu Cast a Deadly Spell</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC>Marvel Mystery Comics #34</ex:madeFirstAppearanceOnC>
  </rdf:Description>
