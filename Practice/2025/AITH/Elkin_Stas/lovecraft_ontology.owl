    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Clark Ashton Smith: Letters to H. P. Lovecraft</rdfs:label>
    <ex:hasAnnotation>Clark Ashton Smith English Genre(s) Non-fiction Necronomicon Press Release Date September 1987 is a collection of correspondence edited by Clark Ashton Smith scholar Steve Behrends . It was published in a paperback format by Necronomicon Press in September 1987 . Overview References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
