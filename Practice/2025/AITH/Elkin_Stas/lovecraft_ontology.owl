  <rdf:Description rdf:about="http://example.org/lovecraft#The_Best_of_Lovecraftiana">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Best of Lovecraftiana</rdfs:label>
    <ex:hasAnnotation>Is an anthology collection of works which have appeared in the lovecraftiana horror zine over the seven years since its launch . Edited by gavin chappell, it was published by rogue planet press in october 2023 . A number of stories originally slated to appear in the collection were pulled from the final line up .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>183</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Lovecraftiana"/>
    <ex:wasReleasedOnW>October 2023</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Thaumaturgical_Prodigies_in_the_New-England_Canaan">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Thaumaturgical Prodigies in the New-England Canaan</rdfs:label>
    <ex:hasAnnotation>"the lurker at the threshold" is a fictional book invented by h. p. lovecraft in notes that were incorporated into august derleth's " posthumous collaboration ," the novel . In the novel a copy of the book is found by ambrose dewart, bound in black imitation leather . The copy, bound in black imitation leather, was printed in boston in 1801, but this is not believed to be the first edition.</ex:hasAnnotation>
    <ex:hasTypeA>Book</ex:hasTypeA>
    <ex:isUsedByA>Ambrose Dewart</ex:isUsedByA>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_Lurker_at_the_Threshold"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Fall_of_Cthulhu_Volume_2:_The_Gathering">
