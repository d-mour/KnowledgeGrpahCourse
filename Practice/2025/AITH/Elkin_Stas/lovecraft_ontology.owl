    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Work"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#F%C3%ACfa_Finnsd%C3%B2ttir">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Fìfa Finnsdòttir</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Artist Reykjavík Icelandic http://www.florafaunafifa.com/ is an Icelandic artist who has worked on projects for American games manufacturer Chaosium , including their flagship Call of Cthulhu roleplaying game. Selected Works Cover Art Cold Harvest (2014) Interior Art Cold Harvest (2014) A Time to Harvest (2021)</ex:hasAnnotation>
    <ex:hasBirthplaceR>Reykjavík</ex:hasBirthplaceR>
    <ex:hasNationalityR>Icelandic</ex:hasNationalityR>
    <ex:hasWebsiteR>http://www.florafaunafifa.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Artist</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Looking_for_Darla:_Stories_of_Mythos_Noir">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Looking for Darla: Stories of Mythos Noir</rdfs:label>
    <ex:hasAnnotation>Looking for darla was first published by elder signs press in september 2008 . It runs to a total of 236 stories, and features cover art by christopher hill . In 2017, shiflet re-issued the book in a digital format under his tenoka press label .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror Noir</ex:hasGenreW>
    <ex:hasPageCountW>236</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>September 2008</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Disciples_of_Dagon">
    <rdf:type rdf:resource="http://example.org/lovecraft#Cults"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdfs:label>Disciples of Dagon</rdfs:label>
    <ex:hasAnnotation>The is a fictional organization in the marvel universe whose first appearance was in 1990 in issue #176 of the 1st volume of the savage sword of conan series . It is a cult dedicated to dagon which exists in the hyborian age . It consists of deep ones and humans whom have been transformed into fish people .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Midnight_Eye_Files">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#StoryCycles"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Midnight Eye Files</rdfs:label>
    <ex:hasAnnotation>The series began with the novel the amulet in october 2005 . The complete stories have been collected in two omnibuses, published in 2016 and 2019 respectively .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2005-2019</ex:wasReleasedOnW>
  </rdf:Description>
