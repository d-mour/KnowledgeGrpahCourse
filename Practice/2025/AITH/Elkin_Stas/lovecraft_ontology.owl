    <ex:hasAnnotation>This page lists the contents of the 2006 edition of Chaosium 's Malleus Monstrorum , a gaming supplement for the Call of Cthulhu horror roleplaying game. Creatures Deities Creatures of Legend &amp; Folklore Animals</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Armageddon_%28series%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#StoryCycles"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Armageddon (series)</rdfs:label>
    <ex:hasAnnotation>The cthulhu armageddon series is a cthulhu mythos story arc by american author, c. t. phipps . It comprises three novels and two anthologies featuring john henry booth and those allied with him against the forces of the great old ones . Frequent references are made to the titus crow series by brian lumley and works of robert e. howard .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#C._T._Phipps"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror Cosmic Horror Action Adventure Fantasy</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Very_Old_Folk">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Very Old Folk</rdfs:label>
    <ex:hasAnnotation>The story was first published in the small press magazine scienti-snaps . It was not republished until 1995 in miscellaneous writings . A variant of the story had already been incorporated into the 1931 novel .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>Untied States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Horror short story</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cynthia_Ward">
