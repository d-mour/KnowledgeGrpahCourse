  <rdf:Description rdf:about="http://example.org/lovecraft#The_Children_of_Fear">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Children of Fear</rdfs:label>
    <ex:hasAnnotation>is a Chaosium campaign sourcebook for their Call of Cthulhu RPG . It provides maps, handouts, rules, monsters and other details for a multi-part adventure across India, Tibet and neighbouring locations in 1922 to 1923. It is written by Lynne Hardy "and friends". In keeping with past Chaosium efforts, the players create characters or use past characters appropriate to the setting to go on a cross-country expedition to try and stop a cult and its servitors from destroying the world. In this case the gimmick is that the path taken by the characters imitates that in Pilgrimage to the West, a Medieval Chinese fairy tale based on the spread of Buddhism.</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Secret_of_Nephren-Ka">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Secret of Nephren-Ka</rdfs:label>
    <ex:hasAnnotation>The mighty warriors is a story by robert m. price that attempts a synthesis of the cthulhu mythos and mormon tradition . The story first appeared in the anthology the mighty warriors ( ulthar press , 2018 ) it is set in 39 a.d., and takes simon from egypt to north america via magical means .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>The Mighty Warriors</ex:isPublishedAsW>
    <ex:wasPublishedOnW>May 2015</ex:wasPublishedOnW>
  </rdf:Description>
