    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Fear and Loathing in Innsmouth: Richard Nixon's Revenge</rdfs:label>
    <ex:hasAnnotation>Jason andrew's story was published in the lovecraftian anthology whispers from the abyss by 01publishing in 2013 .</ex:hasAnnotation>
