  <rdf:Description rdf:about="http://example.org/lovecraft#Lin_Carter">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Lin Carter</rdfs:label>
    <ex:diedOnR>1988 February 7</ex:diedOnR>
    <ex:hasAnnotation>Linwood vrooman carter was an american author of science fiction and fantasy . He is best known for editing the ballantine adult fantasy series in the 1970s . In the 1970s he issued his own fantasy fanzine, titled kadath .</ex:hasAnnotation>
    <ex:hasFullNameR>Linwood Vrooman Carter</ex:hasFullNameR>
    <ex:wasBornOnR>1930 June 9</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Hellboy">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Hellboy</rdfs:label>
    <ex:hasAffiliationC>Bureau for Paranormal Research</ex:hasAffiliationC>
    <ex:hasAffiliationC>Defense</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Anung Un Rama</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>A.k.a. Anung un rama is a fictional character created by michael mignola for his dark fantasy comic book series of the same name . As an adult, works as one of the bureau for paranormal research and defense, defending mankind from supernatural threats . His allies include abe sapien, an ichthyoid humanoid; and johann kraus, an ectoplasmic spirit in a containment suit . A live action</ex:hasAnnotation>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Mike_Mignola"/>
  </rdf:Description>
