  <rdf:Description rdf:about="http://example.org/lovecraft#Temphill">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Temphill</rdfs:label>
    <ex:hasAnnotation>"the church in high street" is a fictional english town, created by ramsey campbell . "the church on high street" is said to exist "conterminously" with a temple of yog-sothoth . Other than the church, the main attraction of seems to be poole's general store .</ex:hasAnnotation>
    <ex:hasTypeL>Town</ex:hasTypeL>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#The_Tomb_Herd"/>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Severn_Valley"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Church_in_High_Street"/>
  </rdf:Description>
