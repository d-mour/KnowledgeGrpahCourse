    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Brian Barr's King in Yellow</rdfs:label>
    <ex:hasAnnotation>Brian Barr Cover Artist Don Noble United States English Brian Barr Books Release Date June 2019 is a collection of four Yellow Mythos short stories by American Brian Barr . edited by Jeff O'Brien with cover art supplied by Don Noble, it was independently published through Brian Barr Books in June 2019. Overview Contents " A Visage of Great Truths " " The Sacred House " " Venusian Hell " " Aldebaran Apocalypse "</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_Barr"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>June 2019</ex:wasReleasedOnW>
  </rdf:Description>
