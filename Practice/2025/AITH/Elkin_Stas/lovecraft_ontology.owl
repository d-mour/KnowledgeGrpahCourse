  <rdf:Description rdf:about="http://example.org/lovecraft#At_Your_Door">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>At Your Door</rdfs:label>
    <ex:hasAnnotation>L. N. Isynwill Herbert Hike Mark Morrison Barbara Manui Chris Adams Scott David Aniolowski Chaosium Publication Date December 1990 Call of Cthulhu is a contemporary campaign supplement book for the Call of Cthulhu horror roleplaying game. Containing six interlinked scenarios, it runs to a total of 180 pages and was published by Chaosium in December 1990. The book was written by L. N. Isynwill , Herbert Hike, Mark Morrison, Barbara Manui, Chris Adams, and Scott David Aniolowski . Artwork was provided by Steven Gilberts and Earl Geier . Overview Gallery</ex:hasAnnotation>
    <ex:wasPublishedOnW>December 1990</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Null_the_Living_Darkness">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Null the Living Darkness</rdfs:label>
    <ex:hasAnnotation>Background is a demonic entity created by the collective suicide of a once benign angelic race, after failing to find the meaning of life . It's a horrific construct of many eyes and tentacles, with vast mystical and psionic powers .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Dark_Ages">
