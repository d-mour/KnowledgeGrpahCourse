    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Work"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Eldritch_Society">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdfs:label>Eldritch Society</rdfs:label>
    <ex:hasAffiliationO>New Earth Government Tagers</ex:hasAffiliationO>
    <ex:hasAnnotation>Cthulhutech is a fictional organization in the cthulhutech pencil-and-paper roleplaying game by wildfire llc . It focuses on dealing with threats within the new earth government, mostly from cults and individuals who attempt to tap into the dark powers . Working for the society are "tagers," which is a group of warriors whom have bonded with alien s</ex:hasAnnotation>
    <ex:hasPurposeO>Fighting Eldritch threats</ex:hasPurposeO>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#H._P._Lovecrafts_Magazine_of_Horror">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>H. P. Lovecraft's Magazine of Horror</rdfs:label>
    <ex:hasAnnotation>John Betancourt Marvin Kaye John Betancourt English Wildside Press Quarterly (in practice infrequently) 11th April 2006 Final Publication Spring 2009 was a short-lived periodical whose focus was, as its name might suggest, the horror genre. History Initially advertised as a quarterly publication, was nevertheless issued in an irregular schedule by Wildside Press . The first issue, published in March 2004, was edited by Marvin Kaye , who would continue to edit the series for its entire (limited) run. After the first five issues (including #1.5, a free interim issue for subscribers only), the series was “indefinitely suspended” before the publication of Issue #5 in 2009, after which it was merged with the new Weird Tales , also printed by Wildside Press. Issues Spring 2004 Fall 2004 Spring 2005 Fall 2006 Spring/Summer 2007 Spring 2009 External Links at the Internet Speculative Fiction Database Gallery</ex:hasAnnotation>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Sacred_House">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Sacred House</rdfs:label>
    <ex:hasAnnotation>Brian Barr English J. Ellington Ashton Press Home Invasion date March 2017 ← Previous Next → " A Visage of Great Truths " " Venusian Hell " " " is a short story by American Brian Barr . It it the second of his King in Yellow stories, and was first published in the anthology Home Invasion by J. Ellington Ashton Press in March 2017. Synopsis A drug-addicted criminal steals a copy of The King in Yellow while committing a home invasion which results in the death of the targeted family. After reading the play he is visited by the spirits of the family, devoted to the King , who tear his body apart before his soul is brought into the service of their master. History Since its first appearance in 2017, "" has also appeared in an independently-published chapbook to which it lends its name (2018), and the collection Brian Barr's King in Yellow (2019).</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_Barr"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Home Invasion</ex:isPublishedAsW>
    <ex:wasPublishedOnW>March 2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Martha_Helen_Mathews">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Martha Helen Mathews</rdfs:label>
    <ex:diedOnR>1910</ex:diedOnR>
    <ex:hasAnnotation>Lovecraft’s maternal aunt through his uncle, Edwin Everett Phillips, whom Martha married on 30 July 1894 &lt;i&gt;and&lt;/i&gt; 23 March 1903.</ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1863</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Manuel_Silva">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Manuel Silva</rdfs:label>
    <ex:hasAnnotation>Petty criminal Human First appearance HPL : " The Terrible Old Man " Created by H. P. Lovecraft is a fictional character created by the late American author H. P. Lovecraft for his 1921 short story " The Terrible Old Man ". He was a literary representation of the animosity felt by Lovecraft towards the non-white immigrants of the time, who he believed were polluting the genetic pool of the United States. Overview In Lovecraft's story Silva, along with fellow criminals Joe Czanek and Angelo Ricci , intended to rob the titular Terrible Old Man of Kingsport , an elderly recluse reputed to be extremely wealthy. What they did not bargain on was the man's true nature, and the gang's corpses were found washed ashore, horribly mutilated, shortly afterwards. Silva was one of the more thuggish of the trio, appearing entirely willing to cause the old man any bodily harm necessary to persuade him to give up the location of his fortune.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Terrible_Old_Man"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
