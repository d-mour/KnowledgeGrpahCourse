  <rdf:Description rdf:about="http://example.org/lovecraft#Broken_Eye_Books">
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SmallPress"/>
    <rdfs:label>Broken Eye Books</rdfs:label>
    <ex:hasAnnotation>Current Status Active Scott Gable United States Speculative fiction https://www.brokeneyebooks.com/store/c1/Featured_Products.html#/ is an independent small press founded by Seattle, Washington-based American author Scott Gable . According to the description, it focuses on " the odd, strange, and offbeat side of speculative fiction ." The press has released several books of Lovecraftian and Cthulhu Mythos fiction, including the Miskatonic University series and Tomorrow's Cthulhu , an anthology of futuristic horror. Selected Publications Anthologies Tomorrow's Cthulhu (2016) Ride the Star Wind (2017) Welcome to Miskatonic University (2019) It Came from Miskatonic University (2020) External Links at the Internet Speculative Fiction Database References</ex:hasAnnotation>
    <ex:hasWebsiteR>#</ex:hasWebsiteR>
    <ex:hasWebsiteR>https://www.brokeneyebooks.com/store/c1/Featured_Products.html</ex:hasWebsiteR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Batman:_The_Doom_That_Came_to_Gotham_%28animated_film%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Crossovers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MediaAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Batman: The Doom That Came to Gotham (animated film)</rdfs:label>
    <ex:hasAnnotation>Batman: the doom that came to gotham is an animated film based on the comic book series of the same name . Produced by warner bros. animation and dc studios, it was given a direct-video release on 28 march 2023 . Amongst the cast are american actor jeffrey combs, who has had a long and illustrious involvement with cthulhu mythos screen productions .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#Batman:_The_Doom_That_Came_to_Gotham"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>28 March 2023</ex:wasReleasedOnW>
  </rdf:Description>
