    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Arkham (Call of Cthulhu)</rdfs:label>
    <ex:hasAnnotation>Call of Cthulhu: Arkham Mike Mason Keith Herber Bret Kramer Cover Artist Loïc Muzy English Call of Cthulhu Genre(s) Roleplaying game Chaosium Release Date 2024 270 Call of Cthulhu: Arkham is a setting supplement for the Call of Cthulhu horror roleplaying game. Written by Mike Mason , Keith Herber , and Bret Kramer , it runs to a total of 270 and was published by Chaosium in 2024; hardcover, digital, and deluxe leatherette editions were all released. Overview Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Bret_Kramer"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Keith_Herber"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mike_Mason"/>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
