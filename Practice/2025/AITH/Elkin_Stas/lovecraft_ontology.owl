  <rdf:Description rdf:about="http://example.org/lovecraft#Krang">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Krang</rdfs:label>
    <ex:hasAlternativeNamesC>The Dead One</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Dead One First appearance CIRCLE : "The Tomb of the God" Created by R. H. Barlow , also known as the Dead One, is a fictional entity created by the late American author and H. P. Lovecraft contemporary R. H. Barlow for his 1934 short story "The Tomb of the God". Description A monstrous brown, leathery, alien entity native to a mysterious planet, currently slumbers within a gigantic mausoleum lost in the desert-wastes. It is set to guard a priceless treasure made up of the oldest decayed planets.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Tomb of the God</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#R._H._Barlow"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Boonieman">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Boonieman</rdfs:label>
    <ex:hasAnnotation>Horror waris a short story by american edward m. erdelac . Set during the vietnam war when a firebase receives word of a major north vietnamese offensive . Amongst the survivors is a sorcerer who yearns for revenge .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Edward_M._Erdelac"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>War</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Horror_at_Oakdeene_and_Others">
    <rdf:type rdf:resource="http://example.org/lovecraft#BrianLumleyWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CrossroadPress"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Horror at Oakdeene and Others</rdfs:label>
    <ex:hasAnnotation>Brian Lumley United States English Genre(s) Horror Arkham House Release Date 1977 is Arkham House 's second collection of Brian Lumley 's short fiction, published in 1977. In 2019 Crossroad Press released an audio download reading. Contents " The Viking's Stone " " Aunt Hester " "No Way Home" " The Horror at Oakdeene " "The Cleaner Woman" " The Statement of Henry Worthy " " Darghud's Doll " " Born of the Winds " Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1977</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Evil_Dead_2:_The_Revenge_of_Hitler">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Evil Dead 2: The Revenge of Hitler</rdfs:label>
    <ex:hasAnnotation>Ian Edginton Jason Gorder, Kevin West, Larry Watts, Jacob Bascle English Space Goat Publishing Release Date 2016 Media Type Comic book Evil Dead 2: Revenge of Hitler is a one-shot comic book written by Ian Edginton in 2016 which was published by Space Goat Publishing. Synopsis Hitler who carved passages of the Ex-Mortis into his skin, was summoned back to Earth and now threatens both Earth and Hell. Ash Williams is summoned to Hell to stop Hitler and save Hell, before he threatens Earth.</ex:hasAnnotation>
    <ex:hasAuthorW>Ian Edginton</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2016</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Agnes_Baker">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Agnes Baker</rdfs:label>
    <ex:hasAlternativeNamesC>The Waitress</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Agnes was a waitress at a small-time arkham diner when she fell from the ladder and hit her head . The trauma to her head had unlocked memories of a past life in a strange place called hyperborea . She has since gone on to feature in other arkham horror files lines of cthulhu mythos -related games and fiction .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Innsmouth Horror Deluxe Expansion</ex:madeFirstAppearanceOnC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Animiculi">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OuterGods"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Animiculi</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAffiliationC>Outer Gods</ex:hasAffiliationC>
    <ex:hasAnnotation>Sociocultural Characteristics Antarctica Great Old Ones / Outer Gods Real World Information First appearance EXP : Beyond the Mountains of Madness Created by Charles and Janyce Engan The are entities created by Charles and Janyce Engan for Chaosium 's Call of Cthulhu tabletop roleplaying game. They made their first appearance in the scenario supplement Beyond the Mountains of Madness in 1999. Description The are severed pieces of a deceased Outer God or Great Old One caught in something called the " God Trap ", a mystical device located somewhere in the Antarctic . who manage to worm their way out of the God Trap become abraded to the point that they appear to be little more than black opal-like cysts. These cysts can reform into when exposed to heat.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Beyond_the_Mountains_of_Madness"/>
    <ex:wasCreatedByC>Charles</ex:wasCreatedByC>
    <ex:wasCreatedByC>Janyce Engan</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Brian_Yuzna">
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPeople"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Brian Yuzna</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Producer Director Writer United States Horror Science fiction is a prolific American producer, director and writer. Overview Yuzna's filmmaking concentrates primarily on the horror and science fiction genres. He has been a key player in the creation of several films based on the works of H. P. Lovecraft , many of these in collaboration with his friend, the late director Stuart Gordon . Selected Works Producer Re-Animator (1985) Dagon (2001) Director Necronomicon: Book of the Dead (1993) Writer From Beyond (1986) External Links at the Internet Movie Database</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Director</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Producer</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Writer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Boojum_%28story%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Boojum (story)</rdfs:label>
    <ex:hasAnnotation>"mongooseboojum" tells the story of the boojum lavinia whateley . She serves as a liveship for a crew of (mostly) human space pirates . Trouble comes when the pirates loot a cargo of mi-go brain cannisters . The boojums don't name themselves, so are given names by the humans .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Elizabeth_Bear"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Sarah_Monette"/>
    <ex:hasGenreW>Space Opera</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Boojumverse"/>
    <ex:isPublishedAsW>Black Sails</ex:isPublishedAsW>
    <ex:isPublishedAsW>Fast Ships</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2008</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nahum_Gardner">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Nahum Gardner</rdfs:label>
    <ex:ceasedOnC>1883</ex:ceasedOnC>
    <ex:hasAnnotation>Gardner was a farmer in the farming land west of arkham that would come to be known as "the blasted heath" he was married to a woman named nabby who bore him three children . The entire family, including nahum himself, were killed after exposure to the alien colour out of space .</ex:hasAnnotation>
    <ex:hasCharacterMateC>Nabby Gardner</ex:hasCharacterMateC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Colour_Out_of_Space"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Marc_Laidlaw">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Marc Laidlaw</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Birth Date 3 August 1960 Laguna Beach, California, USA United States https://www.marclaidlaw.com/ (born 3 August 1960) is an American author, games writer, and occasional poet and artist. He is perhaps best known for his extensive writing for the Half-Life series of video games by Valve, having been involved with four instalments of the franchise. He has also written a number of Lovecraftian stories, which have been published in anthologies such as Lovecraft Unbound , New Cthulhu: The Recent Weird , New Cthulhu 2: More Recent Weird , and Deepest, Darkest Eden , as well as the fanzine The Cthulhu Codex . Bibliography "The Vicar of R'lyeh" (2007) " Leng " (2009) External Links at Wikipedia at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA http://example.org/lovecraft#California Laguna Beach</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://www.marclaidlaw.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>3 August 1960</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Musketeers_vs._Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Musketeers vs. Cthulhu</rdfs:label>
    <ex:hasAnnotation>Various Various English Call of Cthulhu Genre(s) Roleplaying game Nightfall Games Release Date May 2024 112 is a scenario and setting supplement for Chaosium 's horror roleplaying game Call of Cthulhu . Written by Bill Heron, Benn Graybeaton, Mark Rapson, Chris McAuley, and Claudia Christian, it features artwork by Bart Wynants, Harry Boddice, and James Churchill, and was published by Nightfall Games in May 2024 after a successful Kickstarter campaign ; although released to Kickstarter backers in both print and digital formats , currently only digital editions have been made available to retail . was nominated for, but did not win, the Best Writing award at the 2024 ENNIES . Overview Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>112</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>May 2024</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Invictus">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Invictus</rdfs:label>
    <ex:hasAnnotation>The game takes place in the world of the cthulhu mythos . It mixes the mythology of the ancient greeks, romans, celts, germans, egyptians, and so on . Scenarios run the gamut from conspiracies in the capital (rome) to sinister cults in the outskirts of the empire.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Chad_Bowser"/>
    <ex:hasAuthorW>Andi Newton</ex:hasAuthorW>
    <ex:hasAuthorW>Deane P. Goodwin</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>Role-play</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Worlds_of_H._P._Lovecraft:_The_Shadow_Over_Innsmouth">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Worlds of H. P. Lovecraft: The Shadow Over Innsmouth</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft (original story) Steven Philip Jones (adaptation) Trey Baldwin United States English The Worlds of H. P. Lovecraft Genre(s) Weird fiction Caliber Comics Release Date 2020 80 Preceded by The Worlds of H. P. Lovecraft: Beyond the Wall of Sleep is a comic book adaptation of the Howard Phillips Lovecraft short story of the same name . Overview The Shadow Over Innsmouth was published by Caliber Comics as part of their Worlds of H. P. Lovecraft in 2020. It runs to a total of 80 and was adapted by Steven Philip Jones with artwork supplied by Trey Baldwin. Also included are a biography of Lovecraft, the original story, and notes on the adaptation process by Jones, Trivia The protagonist of The Shadow Over Innsmouth 's name has been established as Robert Olmstead in Lovecraft's notes for the story; oddly, this authorized version names him as Robert Loveless. Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Steven_Philip_Jones"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:hasPageCountW>80</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>The Worlds of H. P. Lovecraft</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2020</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Doug_Lyons">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Doug Lyons</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Games designer Horror Roleplaying games is a roleplaying game designer who has worked on a number of modules and sourcebooks for Chaosium 's game of Lovecraftian horror Call of Cthulhu . Selected Works Cthulhu Classics (1989, contributor) The Great Old Ones (1989, contributor) External Links at RPG.net</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Games designer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Blood_Will_Have_Its_Season">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Blood Will Have Its Season</rdfs:label>
    <ex:hasAnnotation>Joseph S. Pulver, Sr. English Hippocampus Press Release Date August 2009 Media Type Print Ebook (Kindle) 286 is an anthology of both fiction and poetry by Joseph S. Pulver, Sr. It contains a number of works which are a direct part of the H. P. Lovecraft -inspired Cthulhu Mythos , and several more which are more directly connected to Robert W. Chambers ' The King in Yellow . The contents are a mix of new and previously published pieces, and the collection runs to a total of 286 . Publication History First published in August 2009 by Hippocampus Press , has since been reissued in digital format. Contents "Choosing" "Carl Lee and Cassilda" "A Line of Questions" (1999) "Pitch Nothing" "I, Like the Coyote" (2001) "" "Mr Wind Sits" "The Prisoner" "An American Tango Ending in Madness" "Orchard Fruit" (1999) "The Songs Cassilda Shall Sing, Where Flap the Tatters of the King" (2006) " The Night Music of Oakdeene " (1985) "Dogs Begin to Bark All Over My Neighborhood" " Chasing Shadows " (1998) "But the Day Is a Tomb of Claws" "In This Desert Even the Air Burns" "And She Walks into the Room ..." "A Certain Mr. Hopfrog, Esq., Nightwalker" " The Black Litany of Nug and Yeb " (1998) "Erendira" "An Engagement of Hearts" "An Event Without Knives or Rope" "One Side's Ice, One's Fire" "A Spider in the Distance" "Pain" "A Night of Moon and Blood, Then Holstenwall" "Under the Mask Another Mask" "Waterlilies" "Yvrain's Black Dance" "No Exit Sign" "Lovecraft's Sentence" (1997) "Midnight on a Dead End Street in Noir City" "The Master and Margeritha" "Hello Is a Yellow Kiss" "The Faces of She" (1998) "Good Night and Good Luck" "Patti Smith, Lovecraft &amp; I" "The Collector and the Hand Puppet" "The Only Thing We Have to Fear ..." "The Corridor" "Stone Cold Fever" Gallery</ex:hasAnnotation>
    <ex:hasAuthorW>Joseph S. Pulver. Sr.</ex:hasAuthorW>
    <ex:hasPageCountW>286</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>August 2009</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Call_of_Cthulhu:_Beyond_the_Mountains_of_Madness">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Call of Cthulhu: Beyond the Mountains of Madness</rdfs:label>
    <ex:hasAnnotation>Headfirst Publication Date N/A Horror was a planned video game based on the roleplaying game scenario of the same name . Overview Announced in November 2002, Beyond the Mountains of Madness was developed by Headfirst in parallel with their Dark Corners of the Earth release. It was ultimately cancelled in 2006 after Headfirst were unsuccessful in securing a publisher; this cancellation was a major contributing factor in the bankruptcy of the company. Premise Stated to have been a first person shooter survival horror, it was set in the 1930s. The player was to assume the role of globetrotting Miskatonic University archaeologist Robert Naples, recalling the character of Indiana Jones.</ex:hasAnnotation>
    <ex:wasPublishedOnW>Unknown</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Music_of_Erich_Zann">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Music of Erich Zann</rdfs:label>
    <ex:hasAnnotation>" the other godsherbert west--reanimator" is a short story by american h. p. lovecraft . Written in december 1921, it was first published in the national amateur , march 1922 . The story takes place in a strange part of the city, on a street named " rue d'auseil " . One night, an old man named erich zann plays strange melodies and rhythms of sound to keep back unknown and unse</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>1922 March</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Raymond_Dirk">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Dreamers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Raymond Dirk</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Arkham_Police_Department"/>
    <ex:hasAnnotation>Dirk is a well built man somewhere in his late thirties . As of the end of the gray man story arc, apparently one of the last . Comes from a family with a tradition of holding the title of sheriff in arkham .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Fall_of_Cthulhu_Volume_3:_The_Gray_Man"/>
    <ex:madeFirstAppearanceOnC>issue 11</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Michael_Alan_Nelson"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Don_DAmmassa">
    <rdf:type rdf:resource="http://example.org/lovecraft#Critics"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Don D'Ammassa</rdfs:label>
    <ex:hasAnnotation>Full Name Donald Eugene D'Ammassa Connection to the Mythos Author Critic Birth Date 24 April 1946 Providence , Rhode Island , USA United States https://www.dondammassa.com/  Donald Eugene D'Ammassa is an American author, critic and sometime publisher with a focus on the horror, science fiction and fantasy genres. Born in H. P. Lovecraft 's home town of Providence , Rhode Island , he has produced several works set in and inspired by the Cthulhu Mythos . Selected Bibliography Collections Shadows Over R'lyeh (2015) More Shadows Over R'lyeh (2017) Still More Shadows Over R'lyeh (2019) External Links at Wikipedia at The Internet Speculative Fiction Database</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA http://example.org/lovecraft#Rhode_Island Providence</ex:hasBirthplaceR>
    <ex:hasFullNameR>Donald Eugene D'Ammassa</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://www.dondammassa.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Critic</ex:isConnectedToMythosR>
    <ex:wasBornOnR>24 April 1946</ex:wasBornOnR>
  </rdf:Description>
