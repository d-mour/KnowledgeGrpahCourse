    <ex:wasReleasedOnW>2014</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Vile-Oct">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Vile-Oct</rdfs:label>
    <ex:hasAnnotation>First appearance " Chronicles of Nibiru: A Plague of Demons " is a reptilian or draconic entity said to be a familiar of Yig .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Chronicles of Nibiru: A Plague of Demons</ex:madeFirstAppearanceOnC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#New_Cthulhu_2:_More_Recent_Weird">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>New Cthulhu 2: More Recent Weird</rdfs:label>
    <ex:hasAnnotation>Paula Guran , editor Cover Artist Nikita Veprikov English Genre(s) Cthulhu Mythos Prime Books Release Date March 18, 2015 480 Preceded by New Cthulhu: The Recent Weird is an anthology of Cthulhu Mythos fiction edited by Paula Guran , and published in 2015 by Prime Books. It is a sequel to New Cthulhu: The Recent Weird (Prime Books, 2011), also edited by Guran. With one exception-- Laird Barron 's "Mysterium Tremendum," originally published in 2010--the volume reprints stories that were published after its predecessor came out in 2011. Contents "All My Love, a Fishhook" by Helen Marshall (2014) "At Home with Azathoth" by John Shirley (2014) "Bloom" by John Langan (2012) "Equoid" by Charles Stross (2013) "Fishwife" by Carrie Vaughn (2013) "In the House of the Hummingbirds" by Silvia Moreno-Garcia (2012) " Momma Durtt " by Michael Shea (2012) "Mysterium Tremendum" by Laird Barron (2010) "Necrotic Cove" by Lois H. Gresh (2014) "On Ice" by Simon Strantzas (2014) "The Boy Who Followed Lovecraft" by Marc Laidlaw (2011) "The Doom That Came to Devil Reef" by Don Webb (2011) " The Litany of Earth " by Ruthanna Emrys (2014) "The Same Deep Waters as You" by Brian Hodge (2013) "The Song of Sighs" by Angela Slatter (2013) " The Transition of Elizabeth Haskings " by Caitlín R. Kiernan (2013) " The Wreck of the Charles Dexter Ward " by Elizabeth Bear and Sarah Monette (2012) "They Smell of Thunder" by W. H. Pugmire (2013) "Who Looks Back?" by Kyla Ward (2012)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Paula_Guran"/>
    <ex:hasAuthorW>editor</ex:hasAuthorW>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasPageCountW>480</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2015 March 18</ex:wasReleasedOnW>
  </rdf:Description>
