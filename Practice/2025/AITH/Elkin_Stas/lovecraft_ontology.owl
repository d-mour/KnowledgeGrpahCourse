    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The House of the Worm (Mearle Prout)</rdfs:label>
    <ex:hasAnnotation>"the house of the worm" is a short story by mearle prout . It was first published in pulp magazine weird tales in october 1933 . It has since been reprinted several times in different publications .</ex:hasAnnotation>
    <ex:hasAuthorW>Mearle Prout</ex:hasAuthorW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>October 1933</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Thousand_Young_%28Call_of_Cthulhu_LCG%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Thousand Young (Call of Cthulhu LCG)</rdfs:label>
    <ex:hasAnnotation>The thousand young is a deluxe expansion set for fantasy flight games' call of cthulhu: the card game . It focuses on the shub-niggurath faction with the usual scattering of cards for other factions and general purpose cards . As with all call of cthulhu: the card game releases, it was discontinued when that game was replaced with arkham horror: the card game .</ex:hasAnnotation>
    <ex:wasPublishedOnW>2015</ex:wasPublishedOnW>
  </rdf:Description>
