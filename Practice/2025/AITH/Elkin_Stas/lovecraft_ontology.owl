  <rdf:Description rdf:about="http://example.org/lovecraft#The_Keeper_of_the_Gate_%28chapbook%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Keeper of the Gate (chapbook)</rdfs:label>
    <ex:hasAnnotation>The Keeper of the Gate William Meikle English The William Meikle Chapbook Collection Genre(s) Horror William Meikle Release Date June 2019 Media Type Trade Paperback Ebook 75 The Keeper of the Gate is a chapbook collection of works by British William Meikle . Overview Consisting of three tales of Lovecraftian horror , The Keeper of the Gate was published by Meikle himself as part of a of collections of his own work, with the last story being new to this release. It runs to 75 and was issued in both digital and trade paperback editions. Contents " The Keeper of the Gate " (2014) " Out of the Black " (2012) " Eeny Meeny Miney Mi-Go " (2019) Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>75</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>The William Meikle Chapbook Collection</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>June 2019</ex:wasReleasedOnW>
  </rdf:Description>
