    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Venusian Hell</rdfs:label>
    <ex:hasAnnotation>"the sacred housealdebaran apocalypse" is a short story by american brian barr . It was first published in the anthology doorway to death in september 2015 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_Barr"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Doorway to Death</ex:isPublishedAsW>
