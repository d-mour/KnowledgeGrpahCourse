    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraft Annual No. 6</rdfs:label>
    <ex:hasAnnotation>Hippocampus press' long-running scholarly periodical runs to a total of 238 in a paperback format . It was edited by s. t. joshi . Running to a total of 238 in a paperback format, it was edited by s. t. joshi .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:hasPageCountW>238</ex:hasPageCountW>
