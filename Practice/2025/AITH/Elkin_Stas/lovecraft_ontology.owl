  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Picture_in_the_House">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Picture in the House</rdfs:label>
    <ex:hasAnnotation>The story was written on december 12, 1920, and first published in the july 1919 issue of the national amateur —which actually was published in the summer of 1921 . Lovecraft's analysis of the psychological roots of new england horror is echoed in his discussion of hawthorne in the essay " supernatural horror in literature "</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>The National Amateur</ex:isPublishedAsW>
    <ex:wasPublishedOnW>Summer 1921</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#H._P._Lovecrafts_The_Haunter_of_the_Dark">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>H. P. Lovecraft's The Haunter of the Dark</rdfs:label>
    <ex:hasAnnotation>Gou Tanabe Gou Tanabe Japanese Kadokawa Corporation Release Date 2016 Media Type Manga is a manga written and illustrated by Gou Tanabe which was published by Kadokawa Corporation in 2016. It is an adaptation of " The Haunter of the Dark " by Howard Phillips Lovecraft . The manga hasn't been translated by a in the English-speaking world.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Gou_Tanabe"/>
    <ex:isInLanguageW>Japanese</ex:isInLanguageW>
    <ex:wasReleasedOnW>2016</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_%28Michael_Fantina%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu (Michael Fantina)</rdfs:label>
    <ex:hasAnnotation>Cthulhu (Michael Fantina) Full story online here Michael Fantina United States English Nightscapes #11 date August 1999 " Cthulhu " is a short Cthulhu Mythos poem by American Michael Fantina . Overview The fifteen lines give a brief description of the Great Old One Cthulhu . History "Cthulhu" was published in the online Mythos fanzine Nightscapes #11 in August 1999.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Michael_Fantina"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Nightscapes #11</ex:isPublishedAsW>
    <ex:wasPublishedOnW>August 1999</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yakith_Lizard">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonSapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Yakith Lizard</rdfs:label>
    <ex:hasAnnotation>Sociocultural Characteristics Earth The sinking of Mu Real World Information First appearance HPL : " Out of the Aeons " Created by Howard Phillips Lovecraft &amp; Hazel Heald Yakith Lizards were a species created by H. P. Lovecraft and Hazel Heald for their short story " Out of the Aeons ". Native to the now-lost continent of Mu , the lizards went extinct when Mu sank beneath the waves.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Out_of_the_Aeons"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Hazel_Heald"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Howard_Phillips_Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Alone_Against_the_Frost">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Alone Against the Frost</rdfs:label>
    <ex:hasAnnotation>Solitaire adventure in canada's wilds is a solo-play adventure module for chaosium's award-winning call of cthulhu roleplaying game . Written in a similar style to the fighting fantasy gamebooks popular in the 1980s, requires the player only supply a pencil, paper and dice .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Gavin_Inglis"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Glenn_Rahman"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>120</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2019</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dwellers_in_the_Mirage">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dwellers in the Mirage</rdfs:label>
    <ex:hasAnnotation>Is a fantasy novel by a. merritt first published in 1932 . The novel concerns american leif langdon who discovers a warm valley in alaska . The inhabitants recognize langdon as the reincarnation of their long dead hero, dwayanu .</ex:hasAnnotation>
    <ex:hasAuthorW>A. Merritt</ex:hasAuthorW>
    <ex:hasGenreW>Fantasy</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1932</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Thanos_Imperative">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Thanos Imperative</rdfs:label>
    <ex:hasAnnotation>The six-issue comic book mini-series was written by dan abnett and andy lanning . It follows up the events of the crossover story "realm of kings" which introduced the cancerverse . The mini-series was bookended by two one-shot comics, thanos imperative: ignition and thanos imperative: devastation .</ex:hasAnnotation>
    <ex:hasAuthorW>Andy Lanning</ex:hasAuthorW>
    <ex:hasAuthorW>Dan Abnett</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>June 2010 - November 2010</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#In_Search_of_Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosFilmAndTelevision"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>In Search of Lovecraft</rdfs:label>
    <ex:hasAnnotation>David J. Hohl David J. Hohl Michael Rosen David J. Hohl Production Company HohloGraphic Productions Release date 2008 Running time 98 minutes United States English is a supernatural indie horror film, written and directed by David J. Hohl. It takes cues from H. P. Lovecraft 's Cthulhu Mythos and first premiered at the 2008 H. P. Lovecraft Film Festival . Synopsis A young reporter working on a Halloween fluff piece on H. P. Lovecraft comes to the realization that his writings are based in fact. Enlisting the help of an occultist and a witch, they do battle with the malevolent forces of Nyarlathotep . Gallery</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasWriterW>David J. Hohl</ex:hasWriterW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2008</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#I_Had_Vacantly_Crumpled_It_into_My_Pocket_._._._But_by_God,_Eliot,_It_Was_a_Photograph_from_Life%21">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>I Had Vacantly Crumpled It into My Pocket . . . But by God, Eliot, It Was a Photograph from Life!</rdfs:label>
    <ex:hasAnnotation>"i had vacantly crumpled it into my pocket . . But by god, eliot, it was a photograph from life!" Is a short story written by joanna russ . The story was republished in the book "the hidden side of the moon"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Joanna_Russ"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Science Fiction</ex:isPublishedAsW>
    <ex:isPublishedAsW>The Magazine of Fantasy</ex:isPublishedAsW>
    <ex:wasPublishedOnW>August 1964</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bethmoora">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsOriginatingFromMythosAdjacentWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Bethmoora</rdfs:label>
    <ex:hasAnnotation>Created by lord dunsany is a fictional city created by lord dunsany for his fantasy book a dreamer's tales . It is mentioned in h. p. lovecraft 's the whisperer in darkness and hugh b. cave 's " the isle of dark magic " in the latter it seems to refer to a being, rather than a place . One day, three men mounted on mules arrived at the gates and delivered a message to the people of which caused them</ex:hasAnnotation>
    <ex:hasAppearanceL>The Whisperer in Darkness The Isle of Dark Magic</ex:hasAppearanceL>
    <ex:hasTypeL>City</ex:hasTypeL>
    <ex:isInhabitedByL>Humans (formerly)</ex:isInhabitedByL>
    <ex:isLocatedAtL>Thuba Mleen's empire</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL>A Dreamer's Tales</ex:madeFirstAppearanceOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Miri_Nigri">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ServitorRaces"/>
    <rdfs:label>Miri Nigri</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Chaugnar_Faugn"/>
    <ex:hasAnnotation>The are mute semi-human dwarves created by chaugnar faugn from the flesh of toads . Their normal behaviour is to serve chaugnar faugn without question or hesitation, and in silence . They descend from the hills to abduct young men and women on whose blood their master can feast .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Horror_from_the_Hills"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Frank_Belknap_Long"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Witches_Hollow">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Witches' Hollow</rdfs:label>
    <ex:hasAnnotation>It was first published in 1962 anthology dark mind, dark heart . Tells the story of an arkham schoolteacher's efforts to save a student from a malignant influence . Written by august derleth based on an idea from lovecraft's commonplace book .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Dark Heart</ex:isPublishedAsW>
    <ex:isPublishedAsW>Dark Mind</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1962</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#J._Vernon_Shea">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsCorrespondents"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>J. Vernon Shea</rdfs:label>
    <ex:diedOnR>1981</ex:diedOnR>
    <ex:hasAnnotation>Full Name Joseph Vernon Shea Pseudonym(s) , Jr. John Vernon Shea Birth Date 1912 Dayton, Kentucky, USA Death Date 1981 Cleveland, Ohio, USA United States Weird fiction Non-fiction Years Active 1925-1981 Joseph Vernon Shea (1912-1981) was an American author and poet who corresponded with Howard Phillips Lovecraft and a number of his circle, including Clark Ashton Smith and August Derleth . Overview Shea contributed a number of works to the greater Cthulhu Mythos , and at age 19 entered into a correspondence with Lovecraft in 1931, this relationship lasting until the latter's death in 1937. He was also a long-term member of the Esoteric Order of Dagon Amateur Press Association , and by the time of his death had become their most prolific contributor, a record he still holds as of October 2022. In addition to his fiction output, Shea also wrote a number of non-fiction works on Lovecraft; these have been published in a variety of studies and periodicals. Selected Bibliography Short Fiction " The Haunter of the Graveyard " (1969) " The Necronomicon " Non-Fiction " On the Literary Influences Which Shaped Lovecraft's Works " (1980)</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Kentucky Dayton</ex:hasBirthplaceR>
    <ex:hasFullNameR>Joseph Vernon Shea</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasPseudonymR>J. Vernon Shea. Jr.</ex:hasPseudonymR>
    <ex:hasPseudonymR>John Vernon Shea</ex:hasPseudonymR>
    <ex:hasYearsActiveR>1925-1981</ex:hasYearsActiveR>
    <ex:wasBornOnR>1912</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tisha_Hewitt">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Tisha Hewitt</rdfs:label>
    <ex:hasAffiliationC>The Arkham Gazette</ex:hasAffiliationC>
    <ex:hasAnnotation>Tisha is a woman somewhere in middle age, a native of arkham, massachusetts . A former investigative journalist for the arkham gazette, she left this profession to author books on real-life ghost sightings .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Beneath_Cayugas_Churning_Waves"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Echo_of_a_Distant_Scream"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Lee_Clark_Zumpe"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yamil_Zacra">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Stars"/>
    <rdfs:label>Yamil Zacra</rdfs:label>
    <ex:hasAnnotation>Stellar body First appearance CIRCLE : " The Infernal Star " Created by Clark Ashton Smith is a fictional star created by the late American author Clark Ashton Smith for his 1933 story fragment " The Infernal Star ". It was later mentioned by John W. Patterson in his 1999 short story " Priestess of Nycrama ", which was inspired by Smith's earlier work. Overview Smith reveals little about , other than that it is part of a binary star system along with its sister Yuzh , that the two are orbited by the planet Pnidleethon , and that it is somehow bound to a sorcerous amulet ( CIRCLE : " The Infernal Star "). Although Patterson makes mention of in "Priestess of Nycrama", it plays no real part in the story, and no new information is revealed. Behind the Mythos In his afterword to the digital edition of "Priestess of Nycrama", Patterson states that is one of the " fantastic names and places … me to write ".</ex:hasAnnotation>
    <ex:hasTypeL>Stellar body</ex:hasTypeL>
    <ex:madeFirstAppearanceOnL>The Infernal Star</ex:madeFirstAppearanceOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Fungi_from_Yuggoth:_A_Sonnet_Cycle">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAudioAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Fungi from Yuggoth: A Sonnet Cycle</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft Cover Artist Kenneth Rahman English Genre(s) Audio recording Fedogan &amp; Bremer Release Date September 2015 is an audio adaptation of H. P. Lovecraft 's narrative sonnet sequence Fungi from Yuggoth . First published by Fedogan &amp; Bremer as an audio cassette in 1987, it received a re-release as a double-disc CD set in September 2015 . Overview Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasGenreW>Audio recording</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>September 2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Hidden_One">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Hidden One</rdfs:label>
    <ex:hasAnnotation>Hidden ones are beings who worship the god zulchequon . The veiled leader of the hidden ones is tsunth .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Spawn_of_the_Winds_%28novel%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#BrianLumleyWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CrossroadPress"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Spawn of the Winds (novel)</rdfs:label>
    <ex:hasAnnotation>Spawn of the winds is the fourth novel in the titus crow series . Notably, titus crow is entirely absent from the story . The novel has been translated into french, italian, and japanese .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasPageCountW>191</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Titus_Crow"/>
    <ex:wasReleasedOnW>July 1978</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Carols_of_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Carols of Cthulhu</rdfs:label>
    <ex:hasAnnotation>112 is a collection of cthulhu mythos -themed holiday carols . It was written by mike slater and features illustrations by kurt komoda . It was published by the countryman press in 2024 .</ex:hasAnnotation>
    <ex:hasAuthorW>Mike Slater</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>112</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2024 October 8</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Time_Lord">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Time Lord</rdfs:label>
    <ex:hasAlternativeNamesC>Gallifreyan</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Time Lady (females)</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Time Tot (children)</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Time lords are a fictional alien species featured in the doctor who franchise . They are notable for their time-traveling technology, psychic abilities, natural awareness of timelines and temporal phenomena, and regenerative capacity . Even the great old ones fear the time lords, considering them a potential threat .</ex:hasAnnotation>
    <ex:hasDistinctionC>Fatal aspirin allergy</ex:hasDistinctionC>
    <ex:hasDistinctionC>Keen temporal awareness</ex:hasDistinctionC>
    <ex:hasDistinctionC>Multicentennial lifespan</ex:hasDistinctionC>
    <ex:hasDistinctionC>Psychic abilities</ex:hasDistinctionC>
    <ex:hasDistinctionC>Regeneration</ex:hasDistinctionC>
    <ex:hasDistinctionC>Respiratory bypass system</ex:hasDistinctionC>
    <ex:hasDistinctionC>Two hearts</ex:hasDistinctionC>
    <ex:madeFirstAppearanceOnC>An Unearthly Child</ex:madeFirstAppearanceOnC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tales_of_Lovecraftian_Horror">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Tales of Lovecraftian Horror</rdfs:label>
    <ex:hasAnnotation>W. H. Pugmire Robert M. Price English Cryptic Publications Pre-June 1988 Final Publication April 1999 was a fanzine dedicated to Lovecraftian prose and fiction. First published some time before June 1988, it ran for eleven issues until the final release in April 1999. The earliest known issue, #2, was edited by W. H. Pugmire ; the next known issue, Hallowmas 1996 (#4), was edited by Robert M. Price , who released all future issues triannually until its cancellation. All known issues were released through Price's Cryptic Publications label. Known Issues 1988 #2 (June) 1996 Hallowmas (November) 1997 Eastertide (April) Lammas (August) Hallowmas (November) 1998 Eastertide (April) Lammas (August) Hallowmas (November) 1999 Eastertide (April) Gallery</ex:hasAnnotation>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#E._Hoffmann_Price">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsCoAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsCorrespondents"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>E. Hoffmann Price</rdfs:label>
    <ex:diedOnR>1988 June 18</ex:diedOnR>
    <ex:hasAnnotation>Price was an american writer of popular fiction for the pulp magazine marketplace . Published 24 solo stories in weird tales between 1925 and 1950 . Collaborated with h. p. lovecraft on "through the gates of the silver key"</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#California Fowler</ex:hasBirthplaceR>
    <ex:hasFullNameR>Edgar Hoffmann Price</ex:hasFullNameR>
    <ex:hasPseudonymR>E. Hoffman Price</ex:hasPseudonymR>
    <ex:hasPseudonymR>Hamlin Daly</ex:hasPseudonymR>
    <ex:wasBornOnR>1898 August 3</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Robert_W._Chambers">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsInspirationsAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosAdjacentAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Robert W. Chambers</rdfs:label>
    <ex:diedOnR>1916 16 December</ex:diedOnR>
    <ex:hasAnnotation>Robert chambers was an american artist and writer . His most famous effort is the king in yellow , a collection of weird fiction short stories, connected by the theme of a book which drives those who read it insane . Chambers' later novels selling well and a handful achieving best-seller status .</ex:hasAnnotation>
    <ex:hasBirthplaceR>Brooklyn New York USA</ex:hasBirthplaceR>
    <ex:hasChildrenR>Robert Edward Stuart Chambers (1899-1955)</ex:hasChildrenR>
    <ex:hasFullNameR>Robert William Chambers</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Inspiration</ex:isConnectedToMythosR>
    <ex:isKnownForR rdf:resource="http://example.org/lovecraft#The_King_in_Yellow"/>
    <ex:wasBornOnR>1865 26 May</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Moon-Bog">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Moon-Bog</rdfs:label>
    <ex:hasAnnotation>" the moon bog " is a short story by american horror fiction writer h. p. lovecraft . The story was written to order, as an after-supper "shocker" for a hub club gathering of amateur journalists in boston on march 10, 1921 . The story bears a similarity to lord dunsany 's first irish novel the curse of the wise woman in theme .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Howard_Phillips_Lovecraft_%28Muriel_E._Eddy%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Howard Phillips Lovecraft (Muriel E. Eddy)</rdfs:label>
    <ex:hasAnnotation>Howard Phillips Lovecraft (Muriel E. Eddy) Mrs. Clifford Eddy United States English Genre(s) Non-fiction Grant-Hadley Rhode Island on Lovecraft date 1945 " Howard Phillips Lovecraft " is a short non-fiction piece by H. P. Lovecraft 's former correspondent, Muriel E. Eddy . It was published in the collection Rhode Island on Lovecraft in 1945 and 1946. Trivia Eddy wrote the work under the name of Mrs. Clifford Eddy, taking the name from her husband, Clifford Martin Eddy, Jr. who had collaborated with Lovecraft on four short stories throughout his career.</ex:hasAnnotation>
    <ex:hasAuthorW>Mrs. Clifford Eddy</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Rhode_Island_on_Lovecraft"/>
    <ex:wasPublishedOnW>1945</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Sea-Spider">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Sea-Spider</rdfs:label>
    <ex:hasAnnotation>A writer moves to a seaside retreat for the dual purposes of finishing his book and escaping his psychotic ex-girlfriend . While strolling down the beach one day, he rescues a bizarre creature which he nicknames . Eventually his former partner tracks him down and attacks him, but is stopped and killed by and it’s kin .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mark_McLaughlin"/>
    <ex:hasAuthorW>Michael Sheehan. Jr.</ex:hasAuthorW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Abominations: 24 Tales of the Cthulhu Mythos</ex:isPublishedAsW>
    <ex:isPublishedAsW>Horrors</ex:isPublishedAsW>
    <ex:wasPublishedOnW>December 2018</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#E._F._Benson">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsInspirationsAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>E. F. Benson</rdfs:label>
    <ex:diedOnR>1940 February 29</ex:diedOnR>
    <ex:hasAnnotation>Edward frederic benson was an english novelist, biographer, memoirist and short story writer, known professionally as . His friends called him fred . He is principally known for his mapp and lucia series about emmeline "lucia" lucas and elizabeth mapp . His home, lamb house, served as the model for mallards, lucia's home in some of the tilling books .</ex:hasAnnotation>
    <ex:hasNationalityR>English</ex:hasNationalityR>
    <ex:wasBornOnR>1867 July 24</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Doel_Chants">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Doel Chants</rdfs:label>
    <ex:hasAnnotation>The are mentioned among a list of Mythos items. Logically they are simply the chants of the Doel , but they might be a variation of the Dhôl Chants . Mentioned by Robert Bloch .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Pestilence_of_Pandora_Peaslee">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Pestilence of Pandora Peaslee</rdfs:label>
    <ex:hasAnnotation>The story was first published in the jason . -edited thematic anthology apotheosis: stories of human survival after the rise of the . Elder gods by simian publishing in october 2015 . It features pandora peaslee , a recurrent character created by rawlik as the one of the main protagonists for a series of mythos-related stories .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Peter_Rawlik"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Apotheosis:_Stories_of_Human_Survival_After_the_Rise_of_the_Elder_Gods"/>
    <ex:wasPublishedOnW>October 2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Demons_by_Daylight">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RamseyCampbellWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Demons by Daylight</rdfs:label>
    <ex:hasAnnotation>Print is an anthology of short horror stories by british author . Originally scheduled for a 1971 release . Death of company's co-founder and chief editor caused a two-year delay .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
    <ex:hasGenreW>Horror Short Fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1973</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Statement_of_Henry_Worthy">
    <rdf:type rdf:resource="http://example.org/lovecraft#BrianLumleyWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Statement of Henry Worthy</rdfs:label>
    <ex:hasAnnotation>Brian Lumley English Genre(s) Cthulhu Mythos The Horror at Oakdeene and Others Date of writing September 1967 date 1977 "" is a Cthulhu Mythos story by Brian Lumley . Written in September 1967, it was first published ten years later, in Lumley's second Arkham House collection, The Horror at Oakdeene and Others (1977). Synopsis Henry Worthy's botanist nephew Matthew mysteriously disappears--and when he reappears, he is undergoing a horrific transformation. History After its initial appearance in The Horror at Oakdeene , "" was reprinted in the August 1991 of the magazine Frighteners . It was later included in Lumley's collections Dagon's Bell and Other Discords (New English Library, 1994), The Whisperer and Other Voices (Tor, 2001), and Haggopian and Other Stories ( Subterranean Press , 2008).</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Horror_at_Oakdeene"/>
    <ex:isPublishedAsW>Others</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1977</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>September 1967</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Jervas_Dudley">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Jervas Dudley</rdfs:label>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#Jervas_Hyde"/>
    <ex:hasAnnotation>Dudley was born to wealthy parents and would often play alone . One day, he discovered an old family crypt belonging to the well-off hyde family that once lived not far away . One night, during a storm, he found his way to the ruins of the hyde family . The manor was destroyed after lightning caught the building on fire during a ball, killing one of the family members .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Tomb"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ptm%C3%A2k">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Ptmâk</rdfs:label>
    <ex:hasAnnotation>Behind the mythos was created by clark ashton smith in letters to r. h. barlow . The letter is written ambiguously about who is a child of nug: "the immediate parent of cthulhu and his race (child of nug) was " .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>1934 letter to R. H. Barlow</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>September 10th</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Servitor_of_the_Outer_Gods">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Servitor of the Outer Gods</rdfs:label>
    <ex:hasAffiliationC>Outer Gods</ex:hasAffiliationC>
    <ex:hasAnnotation>The servitors of the outer gods are a mysterious species expanded upon by chaosium for the call of cthulhu roleplaying game . They are amorphous beings that resemble squids, frogs, and octopi which are constantly changing their shape and appearance . The music to which the outer gods dance to is made by these demonic drummers and flautists .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Lurker_at_the_Threshold"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Rats_in_the_Walls"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Colour_Out_of_Space">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Colour Out of Space</rdfs:label>
    <ex:hasAlternativeNamesC>Chromiant</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Space Seeds</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Spawn of the Meteor</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Strange Visitors</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The colour was an extraterrestrial force or entity featured in h.p. Lovecraft's tale of the same name . It arrived on earth via meteorite, and infected a large swath of arkham , massachusetts . The entity departs from earth to return where it came from, but another, smaller part is believed to be still in the former gardner's farm .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#At_the_Mountains_of_Madness"/>
    <ex:hasDistinctionC>A stream of insubstantial alien</ex:hasDistinctionC>
    <ex:hasDistinctionC>sentient colour</ex:hasDistinctionC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Colour_Out_of_Space"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Eldrazi">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Eldrazi</rdfs:label>
    <ex:hasAnnotation>The are entities that live in the blind eternities, a space between the planes of the multiverse . Each of the titans spawns an army of drones, beings, and creatures with a tiny fraction of the titan's power at most . The lineage of the is characterized by lattice-like flesh and are of unnatural hues .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Very_Black_Goat">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Very Black Goat</rdfs:label>
    <ex:hasAnnotation>Christine Morgan English April Moon Books The Call of Poohthulhu date May 2022 " " is a short Cthulhu Mythos /Winnie-the-Pooh crossover story by American Christine Morgan . It was published in the April Moon Books anthology The Call of Poohthulhu in May 2022. Synopsis When Pooh Bear and Christopher Robin decide to explore the Hundred Acre Wood - against the advice of wise old Owl - they encounter a young girl and her companion, a nasty black goat. The girl tells the two that she is the daughter of Shub-Niggurath , and tries to force them to visit her mother "for tea". Although they manage to fend off the horrid creatures and escape, during their retreat Christopher Robin witnesses something huge and terrible stirring in the depths of the forest.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Christine_Morgan"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Call_of_Poohthulhu"/>
    <ex:wasPublishedOnW>May 2022</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#They_Thrive_in_Darkness">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>They Thrive in Darkness</rdfs:label>
    <ex:hasAnnotation>The story was first published in the anthology arkham tales: legends of the haunted city in july 2006 . It was republished in the collection mythos and madness in june 2018 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Arkham_Tales:_Legends_of_the_Haunted_City"/>
    <ex:wasPublishedOnW>July 2006</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Sleeper_Below_%28Call_of_Cthulhu_LCG%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Sleeper Below (Call of Cthulhu LCG)</rdfs:label>
    <ex:hasAnnotation>The sleeper below is a deluxe expansion for fantasy flight games' call of cthulhu: the card game . It contains the usual mix of faction cards and neutral cards, with the majority being devoted to the cthulhu faction . Production of the sleeper below also ceased with the discontinuation of call of cthulhu: the card game .</ex:hasAnnotation>
    <ex:wasPublishedOnW>2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Three_Stooges_vs._Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Crossovers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Three Stooges vs. Cthulhu</rdfs:label>
    <ex:hasAnnotation>Three stooges is a horror comedy comic book published in 2023 by american mythology productions . It features the classic comedy trio known as the three stooges stumbling upon the cosmic horror of cthulhu . Written by adam f. goldberg and hans rodionoff, and illustrated by diego tapie .</ex:hasAnnotation>
    <ex:hasAuthorW>Adam F. Goldberg</ex:hasAuthorW>
    <ex:hasAuthorW>Hans Rodionoff</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Comedy</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>2023</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Bells_of_Horror">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Bells of Horror</rdfs:label>
    <ex:hasAnnotation>Historywas first published in pulp magazine strange stories in april 1939 . It was included in the kuttner-focused anthology the book of iod in 1995 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Henry_Kuttner"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Strange_Stories"/>
    <ex:wasPublishedOnW>April 1939</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#In_the_Mouth_of_Madness">
    <rdf:type rdf:resource="http://example.org/lovecraft#MediaAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>In the Mouth of Madness</rdfs:label>
    <ex:hasAnnotation>Is a 1994 psychological/supernatural horror film written by acclaimed american filmmaker john carpenter . The story follows an insurance agent tasked with tracking down horror writer sutter cane, who has gone missing . Revelations uncovered in cane's latest manuscript tear at trent's sanity and destroy his companion's mind . The film ends with trent realising that he is nothing more than a character in the stories of cane .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasWriterW>Michael De Luca</ex:hasWriterW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>10 December 1994</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yig">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Yig</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Progeny_of_Yig"/>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAffiliationC>Outer Gods</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Father of Serpents</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The father of serpents is a fictional deity introduced in the h. p. lovecraft revision story " the curse of " . He is introduced as "the snake-god of the central plains tribes," and "a shunned and feared object in central oklahoma" the serpentine was one of the many gods worshiped in the ancient continent of mu .</ex:hasAnnotation>
    <ex:hasAppearanceC>The Mound The Whisperer in Darkness Out of the Aeons The Shambler from the Stars The Invaders Snake Fever The Scales of Justice Pathfinder Roleplaying Game Bestiary 6</ex:hasAppearanceC>
    <ex:hasCharacterMateC rdf:resource="http://example.org/lovecraft#Coatlicue"/>
    <ex:hasCharacterMateC rdf:resource="http://example.org/lovecraft#Yidhra"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Curse_of_Yig"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Howard_Phillips_Lovecraft"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Zealia_Bishop"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Thing_in_the_Moonlight">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Thing in the Moonlight</rdfs:label>
    <ex:hasAnnotation>Based on a 1927 letter from h. p. lovecraft to donald . Wandrei, in which lovecraft recounted a dream . Lovecraft and miske co-edited the story for bizarre magazine .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasAuthorW>J. Chapman Miske</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>January 1941</ex:isPublishedAsW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Set">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ElderGods"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Set</rdfs:label>
    <ex:hasAlternativeNamesC>The Serpent Tiamat Ophion Leviathan Satha the Great Serpent Satha the Old One Apep Lotan Serpent God Father Set Apocalypse The Great Serpent Father of Serpents The Mighty Crawling One Snake God Great Destroyer Father of All Evil Slithering God The Old Serpent the snake beneath the moon the fate that finds us the snake that binds us the Stygian serpent</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as the serpent tiamat ophion leviathan . Appears as the primary dark / evil god in the conan mythos, worshipped by most of conan's greatest sorcerer foes .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>As Satha : The Scarlet Citadel</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>As Set: The Phoenix on the Sword</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>Marvel Feature Vol 2 #6</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>Supernatural Thrillers Vol 1 #3</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Roy_Thomas"/>
    <ex:wasCreatedByC>Frank Thorne</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Family_Snapshots">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Family Snapshots</rdfs:label>
    <ex:hasAnnotation>In lovecraft's shadow is a short story by american authors ron shiflet and peter a. worthy . It was published in the first (and only) issue of short-lived fanzine in lovecraft's shadow, also edited by shiflet, by tenoka press in march 2007 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Peter_A._Worthy"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#In_Lovecrafts_Shadow"/>
    <ex:wasPublishedOnW>March 2007</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Urban_Cthulhu:_Nightmare_Cities">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Urban Cthulhu: Nightmare Cities</rdfs:label>
    <ex:hasAnnotation>Urban Cthulhu:Nightmare Cities Various Cover Artist Paul Carrick English H. Harksen Productions Release Date May 2012 232 is an anthology of Lovecraftian fiction edited by Henrik Sandbeck Harksen , who also contributed one of the stories. Published by H. Harksen Productions, it contains 11 short stories and runs to a total of 232 . 's Description Contents "The Statement of Frank Elwood" by Pete Rawlik "Dancer of the Dying" by Jayaprakash Satyamurthy "The Neighbors Upstairs" by John Goodrich " Carcosapunk " by Glynn Owen Barrass "Architect Eyes" by Thomas Strømsholt "Slou" by Robert Tangiers "Ozeelah's Lake" by Morten Carlsen " In the Shadow of Bh'Yhlun " by Ian Davey "The Screamer" by T. E. Grau "Night Life" by Henrik Sandbeck Harksen "the guilt of each ... at the end ..." by Joseph S. Pulver, Sr. Gallery</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>232</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>May 2012</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Some_Notes_on_Interplanetary_Fiction">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Some Notes on Interplanetary Fiction</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft United States English French Spanish Genre(s) Non-fiction The Californian date Winter 1935 " ", also published as " Notes on Writing Interplanetary Fiction " and " Notes on Interplanetary Fiction " , is a short non-fiction piece by the late American H. P. Lovecraft . First published in the winter 1935 edition of The Californian , it has been reprinted several times, and has also been translated into French and Spanish . References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:isInLanguageW>Spanish</ex:isInLanguageW>
    <ex:isPublishedAsW>The Californian</ex:isPublishedAsW>
    <ex:wasPublishedOnW>Winter 1935</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ultraman_Tiga">
    <rdf:type rdf:resource="http://example.org/lovecraft#Crossovers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosFilmAndTelevision"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Ultraman Tiga</rdfs:label>
    <ex:hasAnnotation>Japanese is a japanese tokusatsu television series, produced by tsuburaya productions . It is the 12th installment of the ultra series and incorporates elements from the cthulhu mythos . The film : the final odyssey was released in 2000 as a direct sequel to the series .</ex:hasAnnotation>
    <ex:isInLanguageW>Japanese</ex:isInLanguageW>
    <ex:wasReleasedOnW>1997 1996 – August 30 September 7</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Valley_of_the_Worm">
    <rdf:type rdf:resource="http://example.org/lovecraft#JamesAllisonCycle"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RobertEHowardWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Valley of the Worm</rdfs:label>
    <ex:hasAnnotation>A modern day man by the name of . James allison is recounting a race-memory of his ancestor niord, and . His battle against a leftover of the old ones named the worm . The story forms part of . His mythos -related james allison cycle .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#James_Allison"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>February 1934</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Shadow_Out_of_Time_%28DART_production%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAudioAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Shadow Out of Time (DART production)</rdfs:label>
    <ex:hasAnnotation>The shadow out of time is an audio adaptation of the short story of the same name from the h. p. lovecraft historical society . Like all entries, it is stylised to sound like a radio drama from the 1930s . It was released in both compact disc and digital download formats, runs to a total of 77 minutes .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Shadow_Out_of_Time"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Cycle">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Cycle</rdfs:label>
    <ex:hasAnnotation>Chaosium the was a collection of cthulhu mythos anthologies published by chaosium as an accompaniment to their call of cthulhu roleplaying game . Most of the books are thematic, focusing on works related to a particular mythos-related entity, local, or tome .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Slithering_Shadow">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RobertEHowardWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Slithering Shadow</rdfs:label>
    <ex:hasAnnotation>" xuthal of the dusk " is a story written by robert e. howard first published in the september 1933 issue of weird tales as . Xuthal of the dusk . Conan and his companion end up in xuthal, a drug addicted city, where they encounter the man-eating</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>September 1933</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ubbo-Sathla">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OuterGods"/>
    <rdfs:label>Ubbo-Sathla</rdfs:label>
    <ex:hasAffiliationC>EXP )</ex:hasAffiliationC>
    <ex:hasAffiliationC>Great Old Ones ( AWD</ex:hasAffiliationC>
    <ex:hasAffiliationC>Outer Gods ( EXP )</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Unbegotten Source Demiurge Ubho-Shatla ( The Burrowers Beneath ) Hboshat ( The Burrowers Beneath ) Bothshash ( The Burrowers Beneath )</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The unbegotten source is a fictional amorphous monster created by clark ashton smith . It is identified as a primordial entity dwelling in the interior of the earth, and guardian of the tablets that preserve the knowledge of primal gods . In the role-playing game call of cthulhu , it is one of the ancient beings known collectively as the outer gods .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Descent_into_the_Abyss"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mupp">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Mupp</rdfs:label>
    <ex:ceasedOnC>1275-1266 BC Aged 57</ex:ceasedOnC>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Nyarlathotep"/>
    <ex:hasAnnotation>Michael sheehan, jr. is a character created by mark mclaughlin for their egyptian cthulhu mythos stories . Despite being to the pharaoh, 's hideous appearance meant that he was exiled to the catacombs beneath the royal palace . He is also a gifted magic user with the ability to cause blood to gush from the ears of others with but a whisper .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Blasphemy_In_The_Canopic_Jar"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Colossus_In_The_Catacombs"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Mark_McLaughlin"/>
    <ex:wasCreatedByC>Michael Sheehan. Jr.</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ygolonac">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Y'golonac</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Defiler</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The defiler is a god of perversion and depravity . Can sometimes be summoned merely by reading his name in the revelations of glaaki . Created by ramsey campbell for his short story " cold print "</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Cold Print</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Commoriom">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Commoriom</rdfs:label>
    <ex:hasAccessibilityL>Road</ex:hasAccessibilityL>
    <ex:hasAnnotation>Hyperborea is a city created by the late american author clark ashton smith for his hyperborean cycle of short stories . The city is located in a dense, primeval forest valley a days travel from the capital of uzuldaroum . At least some of the former citizens appear to have worshipped the toad-god tsathoggua .</ex:hasAnnotation>
    <ex:hasAppearanceL>The Whisperer in Darkness At the Mountains of Madness The Testament of Athammaus</ex:hasAppearanceL>
    <ex:hasNotableFeatureL>Temple to Tsathoggua</ex:hasNotableFeatureL>
    <ex:hasTypeL>Abandoned city</ex:hasTypeL>
    <ex:isInhabitedByL>At least one Formless Spawn</ex:isInhabitedByL>
    <ex:isInhabitedByL>Hyperboreans</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Hyperborea"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Tale_of_Satampra_Zeiros"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Comes_a_Pale_Rider">
    <rdf:type rdf:resource="http://example.org/lovecraft#CaitlinRKiernanWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Comes a Pale Rider</rdfs:label>
    <ex:hasAnnotation>Caitlin R. Kiernan Cover Artist Ted Naifeh Dancy Flammarion Subterranean Press Release Date November 30, 2020 186 Preceded by Alabaster is a collection of short fiction by Caitlin R. Kiernan that features their recurring character Dancy Flammarion , an albino teenager who fights Lovecraftian monsters. Published by Subterranean Press in 2020, it serves as a sequel of sorts to Alabaster (Subterranean Press, 2006), Kiernan's first collection of Dancy Flammarion stories. Contents "Bus Fare" (2014) "Dancy vs. the Pterosaur" (2015) "Tupelo (1998)" (2017) "Dreams of a Poor Wayfaring Stranger" (2020) "Requiem" (2020) "Afterword" (essay) (2020)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
    <ex:hasPageCountW>186</ex:hasPageCountW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Dancy_Flammarion"/>
    <ex:wasReleasedOnW>2020 November 30</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#His_Hour_Upon_the_Stage">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>His Hour Upon the Stage</rdfs:label>
    <ex:hasAnnotation>Historywas first published in the online fanzine nightscapes in september 1998 . It was included in the collection the best of dark legacy, volume 2 in 2016 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#J._B._Lee"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Nightscapes"/>
    <ex:wasPublishedOnW>September 1998</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#At_the_Root">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>At the Root</rdfs:label>
    <ex:hasAnnotation>The united amateur , 17, no. 6 was first published in july 1918 . Lovecraft sets out his beliefs for the base cause of the first world war: the tendency of human populations to revert to an atavistic state of aggression . He also expresses his belief that only the consistent and ongoing vigilance of armed states will prevent such conflicts .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_United_Amateur"/>
    <ex:isPublishedAsW>17</ex:isPublishedAsW>
    <ex:isPublishedAsW>No. 6</ex:isPublishedAsW>
    <ex:wasPublishedOnW>July 1918</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Chaos_Cascade">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Chaos Cascade</rdfs:label>
    <ex:hasAnnotation>Dan Slott Khoi Pham, Danny Miki, Allen Martinez English Marvel Comics Release Date March 2009-May 2009 Media Type Comic book is 3-part story arc in issues #21-23 of the 1st volume of Mighty Avengers written by Dan Slott. Synopsis The Elder God Chthon manipulates the sorcerer Modred and then takes possession of the mutant Quicksilver in its attempt to return to Earth .</ex:hasAnnotation>
    <ex:hasAuthorW>Dan Slott</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>March 2009-May 2009</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Into_the_Black">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Into the Black</rdfs:label>
    <ex:hasAnnotation>Short story was published in the collection of meikle's own works : tales of lovecraftian terror in may 2019 . Behind the mythoswas given a rewrite and published as " starry wisdom " in march 2021 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Into_the_Black:_Tales_of_Lovecraftian_Terror"/>
    <ex:wasPublishedOnW>May 2019</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#William_L._Sinclair">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>William L. Sinclair</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Arkham_Police_Department"/>
    <ex:hasAnnotation>William "billy" sinclair is a character created by josh finney for his casefile:arkham series of cthulhu mythos stories . Sinclair is a jaded cop working for arkham police department's homicide division in post-wwiiamerica . Sinclair has made the acquaintance of private investigator hank flynn and considers him to be "almost" a friend . Sinclair threatened flynn with legal action when he refused to leave</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Casefile:_Arkham-_Nightmare_on_the_Canvas"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Josh_Finney"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mappo_No_Ryujin">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Mappo No Ryujin</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Great_Old_One"/>
    <ex:hasAlternativeNamesC>Mother of all Snakes Harbinger of Doom Mappo's Dragon Leviathan Queztalcoatl Tiamat Kukulkan Typhon Apophis Tien Lung Vitra Bida Azhi Dahaki Nidhogg Zu The Mother of Yig</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The last time it visited earth was 50,000 years ago, when yig unleashed it to punish the serpent men who were worshiping ghatanothoa . It is believed that at the twilight of the age of man, when the celestial bodies are in perfect alignment, it will bring forth an orgy of destruction . It is a 1000 ft. long entity with two skeletal wings, a desiccated oriental dragon head, and 666 pseudopods</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Secrets_of_Japan"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Michael_Dziesinski"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Thing_in_the_Pit">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Thing in the Pit</rdfs:label>
    <ex:hasAnnotation>A horror fantasy short story by . Lin carter set in the cthulhu mythos, and part of his xothic legend . Cycle . The story purports to be part of prof. copeland's translation of the zanthu tablets . They narrate the life of the hierophant zanthu , high-priest of the god ythogtha in the ancient continent of mu .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:isPublishedAsW>Lost Worlds</ex:isPublishedAsW>
    <ex:wasPublishedOnW>August 1980</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kurpannga">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Kurpannga</rdfs:label>
    <ex:hasAlternativeNamesC>The Devil-dingo</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Devil-dingo First appearance EXP : H. P. Lovecraft's Dreamlands Created by Sandy Petersen is a giant hairless dingo-like fiend living in the Dreamlands (or the Dreamtime of Aboriginal myth).</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#H._P._Lovecrafts_Dreamlands"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Sandy_Petersen"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Jason_Van_Hollander">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Jason Van Hollander</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Artist Birth Date 9 September 1949 Philadelphia, Pennsylvania, USA United States http://www.jasonvanhollander.com/ 𝐓 is an American author and artist. An occasional writing collaborator of Darrell Schweitzer , Van Hollander has supplied artwork for a host of publishers and publications, including Mythos pillar Arkham House and long-running pulp magazine Weird Tales . Selected Works Short Stories " Those of the Air " (1994) See Also Images by External Links at the Internet Speculative Fiction Database</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Pennsylvania Philadelphia</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>http://www.jasonvanhollander.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Artist</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>9 September 1949</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Love_Is_Forbidden,_We_Croak_%26_Howl">
    <rdf:type rdf:resource="http://example.org/lovecraft#CaitlinRKiernanWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Love Is Forbidden, We Croak &amp; Howl</rdfs:label>
    <ex:hasAnnotation>The story presents a vignette of the impossible love between an innsmouth deep one hybrid and an arkham ghoul . A german translation, "liebe ist verboten, so krächzen und jaulen wir," was published in a german edition of lovecraft's monsters (festa</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Sirenia_Digest"/>
    <ex:wasPublishedOnW>May 2012</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mother_Hydras_Mythos_Rhymes">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Mother Hydra's Mythos Rhymes</rdfs:label>
    <ex:hasAnnotation>Jarred W. Wallace Heather Hudson English Pagan Publishing Release Date 2006 is a collection of Lovecraftian poetry by Jarred W. Wallace. Featuring illustrations by Heather Hudson, it was released by indie press Pagan Publishing in 2006. Overview</ex:hasAnnotation>
    <ex:hasAuthorW>Jarred W. Wallace</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2006</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_X-Files">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The X-Files</rdfs:label>
    <ex:hasAnnotation>Show follows two federal bureau of investigation special agents, fox mulder and dana scully . Overarching story of the franchise involves a government conspiracy to cover up their involvement with aliens . Some episodes, such as "squeeze" and "tooms," feature characters who will go to desperate lengths to extend their life spans .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2002 1993 – May 19 September 10</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Imprisoned_with_the_Pharaohs">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Imprisoned with the Pharaohs</rdfs:label>
    <ex:hasAnnotation>"under the pyramids" is a fictionalized account of an allegedly true experience of escape artist harry houdini . The narrative tells a fictionalized account in the first-person perspective of an encounter that he claims to have had while on vacation in egypt in 1910 . Set in 1910, in egypt, houdini finds himself kidnapped by a tour guide, who resembles an ancient pharaoh . While attempting to find his way out, he stumbles upon</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Fantasy short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>May July 1924 Jun</ex:wasPublishedOnW>
  </rdf:Description>
