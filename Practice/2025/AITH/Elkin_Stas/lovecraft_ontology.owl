    <ex:wasPublishedOnW>July 1938</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kranon">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Kranon</rdfs:label>
    <ex:hasAnnotation>Ulthar Burgomaster Human First appearance HPL : " The Cats of Ulthar " Created by H. P. Lovecraft is a fictional character created by the late American author Howard Phillips Lovecraft for his 1920 short story " The Cats of Ulthar ". Overview was the burgomaster (a title corresponding to that of mayor) of the town of Ulthar when the town passed a law that made it illegal to kill cats . ( HPL : " The Cats of Ulthar ")</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Cats_of_Ulthar"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ibid">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Ibid</rdfs:label>
    <ex:hasAnnotation>The dunwich horroris a parody by american horror fiction writer h. p. lovecraft . It was written in 1927 or 1928 and first published posthumously in the january 1938 issue of o-wash-ta-nong . The piece traces the skull of ibidus to a prairie dog hole in milwaukee, wisconsin .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Parody</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crypt_of_Cthulhu_Hallowmas_1982">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crypt of Cthulhu Hallowmas 1982</rdfs:label>
    <ex:hasAnnotation>Michaelmas 1982 was the ninth issue of robert m. price's long-running fanzine . It featured cover art by michael h. cline, ran to a total of 36 in an a5 format . It was self-published in november 1982 .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>36</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu"/>
    <ex:wasReleasedOnW>November 1982</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Hiru_Gyamu">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Hiru Gyamu</rdfs:label>
    <ex:hasAnnotation>The asylum diaries: arkham date may 2019is a short horror story by australian gerry huntman . It was published in the first issue of short-lived horror magazine the asylum diaries by oscillate wildly press in may 2019 .</ex:hasAnnotation>
    <ex:hasAuthorW>Gerry Huntman</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Asylum_Diaries:_Arkham"/>
    <ex:wasPublishedOnW>May 2019</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Unmasked">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Unmasked</rdfs:label>
    <ex:hasAnnotation>David Conyers Cover Artist Tithi Luadthong English Independently published Release Date July 2021 is a collection of Lovecraftian fiction by Australian David Conyers . It was published independently in July 2021; both paperback and digital editions were released . Overview In the introduction to , Conyers described the stories as: Contents "Sister of the Sands" "The Swelling" "From the Sick Trees" "The Faceless Watchers" "As Above So Below" "Winds of Nzambi" "Sweet as Decay" "A Shared Romance" "Solvent Hunger" "Vanishing Curves" "Screaming Crawler" "The Eldritch Force" "The Dream Quest of a Thousand Cats" "Outside Looking In" Appendix 1: The Code-89 Initiative Appendix 2: Major Harrison Peel Trivia The cover image by Tithi Luadthong, who also goes by the professional name of Grandfailure , was obtained for use through . It had previously been used as the cover art for Jeffrey Thomas 's 2019 collection The Summoning of the Old Ones ; as can be seen in the infobox image, Thomas also provided the cover blurb for . References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#David_Conyers"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>July 2021</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Michael_Patrick_Hicks">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Michael Patrick Hicks</rdfs:label>
    <ex:hasAnnotation>Salem hawley series concerns a freed black slave who combats the forces of the cthulhu mythos in the late 1700s . He has also authored numerous short stories and chapbooks, and four full-length novels . Hicks claims world-renowned horror writer stephen king among his major influences .</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Farmington Michigan</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isKnownForR>The Salem Hawley series</ex:isKnownForR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Elder_Evil">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Elder Evil</rdfs:label>
    <ex:hasAnnotation>The elder evils are interdimensional entities in the fictional universe of the d&amp;d pencil-and-paper roleplaying game by wizards of the coast . They are indigenous to planes of existence that are far beyond the material plane, realms which are lethal to mortals . Some of them are bound to their home dimensions, others are imprisoned within these realities by external powers .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Moon_Pool">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Moon Pool</rdfs:label>
    <ex:hasAnnotation>433 is a fantasy novel by a. merritt, first published in 1919 . It was followed in 1920 by a sequel, the metal monster . The first and second parts of the narrative were originally published separately .</ex:hasAnnotation>
    <ex:hasAuthorW>A. Merritt</ex:hasAuthorW>
    <ex:hasGenreW>Fantasy</ex:hasGenreW>
    <ex:hasPageCountW>433</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1919</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#TheSalemHawleySeries">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Work"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#R._C._Mulhare">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosAdjacentAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>R. C. Mulhare</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Birth Date 10 June 1977 Lowell, Massachusetts, USA United States Horror is an American author whose work has appeared in a wide range of publications. She has written a number of works in the horror and Cthulhu Mythos genres, and a member of the New England Horror Writers association. Her Lovecraftian works have been included in anthologies such as Cthulhu: Weirdbook Annual 2 , Deep Fried Horror Cthulhu Cheese Burger , and Cthulhu Christmas Special and Other Lovecraftian Yuletide Tales , as well as the popular fanzine Lovecraftiana . Selected Bibliography Short Fiction " The Horror in the Stable " (2017) " Something Eating at You " (2018) " Yellow Labelled VHS Tape " (2019) " The Dorm Mate Out of Dunwich " (2020) " Shreds of a Suit on a Library Floor " (2020) " The Fate of the Jaquiths " External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA http://example.org/lovecraft#Massachusetts Lowell</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>10 June 1977</ex:wasBornOnR>
  </rdf:Description>
