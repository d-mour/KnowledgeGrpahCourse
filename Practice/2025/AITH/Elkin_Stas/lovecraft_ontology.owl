    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Shadows Over Scotland</rdfs:label>
    <ex:hasAnnotation>288 is a sourcebook for playing call of cthulhu games north of the border in the united kingdom . Contains sections detailing the history of scotland - including how the forces of the mythos have shaped the country .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Stuart_Boon"/>
    <ex:hasPageCountW>288</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>August 2011</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#It_Lurks_in_the_Basement">
