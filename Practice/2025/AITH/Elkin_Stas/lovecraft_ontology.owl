  <rdf:Description rdf:about="http://example.org/lovecraft#Joe_Sargent">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Joe Sargent</rdfs:label>
    <ex:ceasedOnC>Unknown possibly winter 1927-28</ex:ceasedOnC>
    <ex:hasAffiliationC>Deep Ones</ex:hasAffiliationC>
    <ex:hasAnnotation>A minor character created by the late american author h. p. lovecraft for the novella the shadow over innsmouth . He first appeared in the novella in 1927 . He was a bus driver for the only bus between newburyport and arkham .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Shadow_Over_Innsmouth"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Thrumm">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Thrumm</rdfs:label>
    <ex:hasAffiliationC>DC Comics : Dark Giants (aka</ex:hasAffiliationC>
    <ex:hasAffiliationC>Elder Gods</ex:hasAffiliationC>
    <ex:hasAffiliationC>Many-Sided Ones)</ex:hasAffiliationC>
    <ex:hasAnnotation>Dc comics : dark giants (aka, elder gods and many-sided ones) first appeared in 2016 in issue #10 of volume 4 of the secret six comic book series .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Secret Six Vol 4 10</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Dale Eaglesham</ex:wasCreatedByC>
    <ex:wasCreatedByC>Gail Simone</ex:wasCreatedByC>
