    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Thick as a Brick</rdfs:label>
    <ex:hasAnnotation>Cthulhu mythos is a short story by brian brownlie . It was first published in the gavin chappell -edited zine lovecraftiana .</ex:hasAnnotation>
    <ex:hasAuthorW>Craig Brownlie</ex:hasAuthorW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
