    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Changing of the Guard</rdfs:label>
    <ex:hasAnnotation>The dark rites of cthulhu is a short story by american author peter rawlik . It was published in the anthology the dark rites of cthulhu by april moon books in march 2014 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Peter_Rawlik"/>
