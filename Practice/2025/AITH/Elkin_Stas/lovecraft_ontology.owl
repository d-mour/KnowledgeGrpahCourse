    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>H. P. Lovecraft in Hawthornian Perspective</rdfs:label>
    <ex:hasAnnotation>Peter Cannon United States English Genre(s) Non-fiction Ohio University Press H. P. Lovecraft: Four Decades of Criticism date 1980 " " is a very short non-fiction work by and Lovecraft scholar Peter Cannon . Overview Coming in at under a page in length, "" was published in the S. T. Joshi -edited collection of critical works H. P. Lovecraft: Four Decades of Criticism by Ohio University Press in 1980 and 1981.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Peter_Cannon"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
