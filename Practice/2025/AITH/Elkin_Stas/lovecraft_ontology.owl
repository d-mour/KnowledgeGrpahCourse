  <rdf:Description rdf:about="http://example.org/lovecraft#The_Shadow_Over_Innsmouth_Bayou">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Shadow Over Innsmouth Bayou</rdfs:label>
    <ex:hasAnnotation>Netsim English " " is a short Cthulhu Mythos story by an unknown writing under the pseudonym of Netsim. Running to a total of eleven pages, it was self-published through Amazon's digital Kindle platform on an unknown date. Synopsis A small group comprising an archaeologist, linguist and local guide traverse the Louisiana bayou in search of hidden truths. What they find is a cult of Cthulhu worshippers attempting to awaken their dark god. Although they are captured by the cult, two of them manage to escape; however, their enemies remain at large, and Cthulhu appears to be stirring…</ex:hasAnnotation>
    <ex:hasAuthorW>Netsim</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#H._P._Lovecraft:_A_Comprehensive_Bibliography">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>H. P. Lovecraft: A Comprehensive Bibliography</rdfs:label>
    <ex:hasAnnotation>682 is a non-fiction work by leading lovecraft scholar s. t. joshi . It was published by university of tampa press in december 2009 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#S._T._Joshi"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:hasPageCountW>682</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>December 2009</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shotguns_v._Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Shotguns v. Cthulhu</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Jason Morningstar English Stone Skin Press Release Date November 2012 296 is an anthology of Lovecraftian fiction edited by Robin D. Laws and released in November 2012. Published by Stone Skin Press, it was distributed by Pelgrane Press ; both paperback and digital editions were issued. Overview Contents "Who Looks Back?" by Kyla Ward "Old Wave" by Rob Heinsoo "Lithic" by Dennis Detwiller "Snack Time" by Chris Lackey "The Host from the Hill" by Dan Harms "Breaking Through" by Steve Dempsey "Last Things Last" by A. Scott Glancy "One Small, Valuable Thing" by Chad Fifer "Wuji" by Nick Mamatas "The One in the Swamp" by Natania Barron "Infernal Devices" by Kenneth Hite "Walker" by Dave Gross "And I Feel Fine" by Robin D. Laws "Welcome to Cthulhuville" by Larry Ditillio "End of White" by Ekaterina Sedia</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>296</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>November 2012</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Tree-House">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Tree-House</rdfs:label>
    <ex:hasAnnotation>The dunwich cycle is a short story by american authors robert m. price and w. h. pugmire . It was first published in the anthology the dunwich cycle in november 1995 . It tells the story of a man desperate to know his family's secret history .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#W._H._Pugmire"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu Fiction</ex:isPartOfSeriesW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Dunwich_Cycle"/>
    <ex:wasPublishedOnW>November 1995</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Flickering_Realms">
    <rdf:type rdf:resource="http://example.org/lovecraft#Dimensions"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Flickering Realms</rdfs:label>
    <ex:hasAccessibilityL>(To humans) mystical portals</ex:hasAccessibilityL>
    <ex:hasAlternativeNamesL>the Dark Heart of Chthon</ex:hasAlternativeNamesL>
    <ex:hasAlternativeNamesL>the Dimension of the Darkhold</ex:hasAlternativeNamesL>
    <ex:hasAnnotation>Also known as the dimension of the darkhold, the dark heart of chthon alternate dimension ruling powers chthon (to humans) mystical portals . First featured in 1995 in wolverine annual vol 2 in 1995 as the n'garai dimension . Later appeared as chthon's dimension in the next year, in issue #90 of the 1st volume of doctor strange: sorcerer supreme .</ex:hasAnnotation>
    <ex:hasNotableFeatureL>constantly changing landscape</ex:hasNotableFeatureL>
    <ex:hasNotableFeatureL>hellish celestial bodies</ex:hasNotableFeatureL>
    <ex:hasTypeL>Alternate Dimension</ex:hasTypeL>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#Chthon"/>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#NGarai"/>
    <ex:madeFirstAppearanceOnL>As Chthon's Dimension: Doctor Strange: Sorcerer Supreme Vol 1 90</ex:madeFirstAppearanceOnL>
    <ex:madeFirstAppearanceOnL>As the N'Garai Dimension: Wolverine Annual Vol 2 1992</ex:madeFirstAppearanceOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mythos_Collector_Fall_2002">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Mythos Collector Fall 2002</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Allen Koszowski English Mythos Collector Dark Tree Press Release Date November 2002 56 Preceded by Summer 2002 Followed by Spring 2003 was the fourth edition of the sporadically-released fanzine Mythos Collector . Edited by Brian Lingard, it featured cover art by Allen Koszowski , and was published by Dark Tree Press in November 2002 . Contents First Words by Brian Lingard Interview with Allen Koszowski by Brian Lingard "Human Study" by Paul Melniczek "On a Budget" by Darrell Schweitzer "What It Was or Could Really Be" by Eric Hermanson Interview with Bernie Wrightson by Christopher O'Brien "Lovecraft in the Pulps" by Brian Lingard Auction Watch Reviews Mythos Gallery (artwork by Allen Koszowski) Contributor Bios References</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>56</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Mythos_Collector"/>
    <ex:wasReleasedOnW>November 2002</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dig">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dig</rdfs:label>
    <ex:hasAnnotation>Historywas first published in cthulhu cultus #8 in march 1997, and appeared in the online fanzine nightscapes in august 1997 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Sean_Rodgers"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Cthulhu Cultus #8</ex:isPublishedAsW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Vindication_of_Yha-Nthlei">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Vindication of Y'ha-Nthlei</rdfs:label>
    <ex:hasAnnotation>The horrors that are &amp; shall be is a short story by american author david busboom . It first appeared in the anthology whispers from the abyss vol. 2: the horrors that are &amp; shall be in october 2015 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#David_Busboom"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Shall Be</ex:isPublishedAsW>
    <ex:isPublishedAsW>Whispers from the Abyss Vol. 2: The Horrors That Are</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Thog">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Thog</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Demon-God of Xuthal</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The ancient is a fictional entity created by the late american author robert e. howard for his 1933 short story " the slithering shadow " the ancient is a great old one , residing within the subterranean city of xuthal . It preyed on the city's lotus-dreaming inhabitants whom were slowly being consumed by the hungry entity . It was also prey to cosmic lusts, as conan's companion natala discovered to her horror .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Slithering_Shadow"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ydheem">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Ydheem</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Hziulquoigmnzhah"/>
    <ex:hasAnnotation>The are a race of extraterrestrial creatures . First appeared in the clark ashton smith short story " the door to saturn ", published in 1932 .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Door_to_Saturn"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Cthulhu_Cycle">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Cthulhu Cycle</rdfs:label>
    <ex:hasAnnotation>Thirteen Tentacles of Terror Various Cover Artist Harry Fassl United States English French Spanish Chaosium Release Date July 1996 : Thirteen Tentacles of Terror is an anthology of Lovecraftian fiction edited by Robert M. Price and published by Chaosium in 1996 as part of its Cthulhu Cycle series. It features the H. P. Lovecraft short story " The Call of Cthulhu ", along with two stories (and one poem) reputed to have inspired it, as well as ten stories that in turn took inspiration from it, showcasing the monstrous deity Cthulhu . The book includes a reproduction of a drawing of Cthulhu by Lovecraft himself. Contents "The Other Name of Azathoth" by Robert M. Price (1996) " The Kraken " by Alfred Lord Tennyson (1830) " A Shop in Go-by Street " by Lord Dunsany (1912) " Count Magnus " by M. R. James (1904) " The Call of Cthulhu " by H. P. Lovecraft (1928) " The Black Island " by August Derleth (1952) "Some Notes Concerning a Green Box" by Alan Dean Foster (1971) "Patiently Waiting" by C. J. Henderson (1996) "The Sign of Kutullu" by David C. Smith (1974) "Recrudescence" by Leonard Carpenter (1988) "Rude Awakening" by Will Murray (1995) "The Eye of Hlu-Hlu" by Donald R. Burleson (1993) "Black Fire" by Will Murray (1995) "In the Light of the Lamp" by Steven Paulsen (1993) "Zombies from R'lyeh" by Pierre Comtois (1994) Gallery</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:isInLanguageW>Spanish</ex:isInLanguageW>
    <ex:wasReleasedOnW>July 1996</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nemo_Me_Impune_Lacessit">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Nemo Me Impune Lacessit</rdfs:label>
    <ex:hasAnnotation>A two hundred-year-old sorcerer seeks revenge on a group of amoral people . He tailors each one's fate to their individual personality . Characters include a porn star, a pornographer and a snuff producer .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Michael_Shea"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Whispers #15-16</ex:isPublishedAsW>
    <ex:wasPublishedOnW>March 1982</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecraft_and_Benefit_Street_%28chapbook%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraft and Benefit Street (chapbook)</rdfs:label>
    <ex:hasAnnotation>Lovecraft and Benefit Street Dorothy C. Walker United States English Genre(s) Non-fiction Driftwind Press Release Date 1943 14 Lovecraft and Benefit Street is a non-fiction chapbook containing Dorothy C. Walter 's non-fiction work from which it takes its name. It was published by Driftwind Press in 1943 and runs to just 14 in length.</ex:hasAnnotation>
    <ex:hasAuthorW>Dorothy C. Walker</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:hasPageCountW>14</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1943</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Arkham_Detective_%28character%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Arkham Detective (character)</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Arkham_Police_Department"/>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#Byron_Craft"/>
    <ex:hasAnnotation>The arkham detective is a character created by american author and filmmaker byron craft for his eponymous series of cthulhu mythos stories . He has been stated to have lost two different partners in the twelve months leading up to the first story . The detective was once married with a son but, due to the long hours he spent on the job and with his drinking buddies in the town's many speakeasies, his wife left him .</ex:hasAnnotation>
    <ex:hasCharacterMateC>Nora Bishop</ex:hasCharacterMateC>
    <ex:hasCharacterMateC>Unnamed woman</ex:hasCharacterMateC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Cthulhus_Minions"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Byron_Craft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#John_Glasby">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>John Glasby</rdfs:label>
    <ex:diedOnR>2011 June 5</ex:diedOnR>
    <ex:hasAnnotation>John stephen glasby was a prolific author whose work spanned a range of popular genres . He produced over 300 novels and short stories, most of which were published pseudonymously under the badger books imprint . His contributions to the cthulhu mythos are numerous, including several short stories .</ex:hasAnnotation>
    <ex:hasNationalityR>United Kingdom</ex:hasNationalityR>
    <ex:hasPseudonymR>AJ Merak</ex:hasPseudonymR>
    <ex:hasPseudonymR>Chuck Adams</ex:hasPseudonymR>
    <ex:hasPseudonymR>John E Muller</ex:hasPseudonymR>
    <ex:hasPseudonymR>Karl Zeigfreid</ex:hasPseudonymR>
    <ex:hasPseudonymR>Tex Bradley</ex:hasPseudonymR>
    <ex:hasPseudonymR>Victor La Salle</ex:hasPseudonymR>
    <ex:wasBornOnR>1928 September 23</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Monstrosity">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Monstrosity</rdfs:label>
    <ex:hasAnnotation>The is a fictional demon in the prime reality of the marvel universe of comics . First appeared in issue #13 of the 1st volume of darkhold: pages from the book of sins . Possessed superhuman strength, durability, and speed . Siphoned the lifeforce of humans via its mouth, killing them .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>1993</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>Darkhold: Pages from the Book of Sins Vol 1 13</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Chris Cooper</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#MIBs">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>MIBs</rdfs:label>
    <ex:hasAnnotation>A man is driven insane by the attentions of the otherworldly men in black . Once his descent into madness is complete, he becomes one of them . Was published in issue #2 of the online zine nightscapes in august 1997 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Tim_Waggoner"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Nightscapes"/>
    <ex:wasPublishedOnW>August 1997</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Army_of_Darkness_Vol_3">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Army of Darkness Vol 3</rdfs:label>
    <ex:hasAnnotation>Elliott R. Serrano Marat Mychaels English Dynamite Entertainment Release Date Feb 2012 - May 2013 Media Type Comic book is a 13-issue comic book series that was written by Elliott R. Serrano in 2012-2013, which was published by Dynamite Entertainment. Synopsis Ash Williams is now working professionally as a Deadite hunter, getting paid to stop evil around the world. In the process he meets his female counterpart, Ashley K. Williams . Who has battling the Dark Ones and the Deadites across the multiverse.</ex:hasAnnotation>
    <ex:hasAuthorW>Elliott R. Serrano</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>Feb 2012 - May 2013</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Samuel_Loveman">
    <rdf:type rdf:resource="http://example.org/lovecraft#Critics"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#KalemClub"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Samuel Loveman</rdfs:label>
    <ex:diedOnR>14 May 1976</ex:diedOnR>
    <ex:hasAnnotation>Connection to the Mythos Friend of H. P. Lovecraft Birth Date 14 January 1887 Cleveland, Ohio, USA Death Date 14 May 1976 South Euclid, Ohio, USA United States Samuel E. Loveman (14 January 1887-14 May 1976) was a Jewish American author and critic. Overview A close friend of Howard Phillips Lovecraft and member of his literary circle the Kalem Club , also provided a source of inspiration for Lovecraft: in addition to appearing in the dreams which inspired " The Statement of Randolph Carter " (in which he became the major character Harley Warren) and " Nyarlathotep , the story " Hypnos " was dedicated to Loveman and he was the subject of the poem " To , Esquire, on His Poetry and Drama, Writ in the Elizabethan Style ". Loveman was also responsible for introducing Lovecraft to several authors and clients - the pair shared many literary acquaintances - and wrote two memoirs of his friend after his death. Despite this, after Lovecraft's death in early 1937, Loveman was informed by Lovecraft's ex-wife Sonia Greene of her former husband's anti-Semitic beliefs and this discovery caused Loveman to burn all of his correspondence and write a scathing essay (" Of Gold and Sawdust ") on the topic.</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Ohio Cleveland</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Friend of H. P. Lovecraft</ex:isConnectedToMythosR>
    <ex:wasBornOnR>14 January 1887</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#In_the_Dread_of_Night_%28Call_of_Cthulhu_LCG%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>In the Dread of Night (Call of Cthulhu LCG)</rdfs:label>
    <ex:hasAnnotation>In the dread of night is an expansion pack for fantasy flight games' call of cthulhu: the card game . It contains 60 cards in the standard format of three sets of 20 unique cards . It was first released in 2008, and was later revived through fantasy flights' in-house print-on-demand service .</ex:hasAnnotation>
    <ex:wasPublishedOnW>2008</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Zvilpogghua">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Zvilpogghua</rdfs:label>
    <ex:hasAffiliationC>Great Old One ( INFL</ex:hasAffiliationC>
    <ex:hasAffiliationC>Marvel Comics : Ultimate Fantastic Four #31 )</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Feaster from the Stars</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Ossadagowah</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Zvilpoggua</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>A.k.a. The feaster from the stars is a fictional monster created by clark ashton smith in his letters to r. h. barlow . It is regarded as another name for ossadagowah , a child of tsathoggua featured in a story fragment by h. p. lovecraft . He currently dwells on yrautrom , in the algol system .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Strange_Manuscript_Found_in_the_Vermont_Woods"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Feaster_from_the_Stars"/>
    <ex:isLocatedAtC>Yrautrom</ex:isLocatedAtC>
    <ex:isLocatedAtC>in the Algol system</ex:isLocatedAtC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Lurker_at_the_Threshold"/>
    <ex:madeFirstAppearanceOnC>Selected Letters of Clark Ashton Smith 189</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ran_Cartwright">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Ran Cartwright</rdfs:label>
    <ex:hasAnnotation>Pseudonym(s) R. S. Cartwright Robert Tangiers Connection to the Mythos Contributor Editor Salem, Ohio, United States United States Horror Science Fiction Fantasy http://otherworldlie.blogspot.com/ is an American writer with a focus on the horror who has contributed many works to the expanded Cthulhu Mythos . In addition to his works of fiction, he was also the editor of Dark Legacy magazine for two years between 2000 and 2001, and has provided a small number of illustrations for his work. Cartwright was also the founder of H'chtelegoth Press and Frogtown Press, independent publishers which are no longer active. Selected Bibliography Editor Dark Legacy (2000 - 2001) Innsmouth Tales - 2000 (2000, with Ron Shiflet ) Dark Legacy - The Poetry (2015) The Best of Dark Legacy Volume 1 (2016) The Best of Dark Legacy Volume 2 (2016) Author Gretchen's Wood: and Other Lovecraftian Tales of Terror in Columbiana County, Ohio (2005) Tales of Nephren Ka (2006) Y'ha-nthlei Rising and Other Tales of the Deep Ones (2006) Of Gods &amp; Aliens (2011) " The House in the Woods " (1997) " Innsmouth Harvest " (1997) "Damascus" (1997) " The Scuttler in the Dark " (1999) " De Marigny's Clock " (1999) "The Circle of Nyarlathotep" (1999) "The Stranger &amp; Tsathoggua" (2000) "The Stranger &amp; H'chtelegoth" (2000) " Azathoth Awakening " (2000) "Dreaming in Darkness" (2000) "The Stranger &amp; Dagon" (2001) "The Stranger &amp; Rhan-Tegoth" (2001) "The Stranger &amp; the Hounds of Tindalos" (2001) "Azathoth Awakened" (2003) "A Fisherman's Tale" (2005) "Gretchen's Wood" (2005) "Summoning Tsathoggua" (2005) "The Black Horror of Dungannon" (2005) "Tommy's Goat" (2005) "The Horror of Organ Grinder Road" (2005) "The Horror from the Sky" (2005) "The Calling of the Hounds" (2005) "The Highlandtown Lake Horror" (2005) "Alder's Rest" (2005) "Y'ha-nthlei Rising" (2006) "Of Gods and Aliens" (2006) "The Circle" (2006) "The Chronicler" (2006) "The Coming" (2006) "The Candidate" (2006) " Return to the Mountains of Madness " (2007) "Arkham Shadows" (2011) "Rhan-Tegoth" (2011) "Z'toggua" (2011) "Fires" (2011) "The Starlet and the Fishman" (2011) "Down on the Farm" (2011) "Nitiqret's Necklace" (2011) "Arkham Shadows" (2011) "The Dia Tesseron Destroyed" (2011) "The Spider and the Fly" (2011) "The House in the Valley" (2011) "Hagif" (2011) "Shar-i-Gholghola" (2011) "Ubar" (2011) "Shog-e'Yahg" (2011) "Ch'g-Ghral" (2011) "A Festival of Winds" (2011) "Fire and Ice" (2011) Artwork Innsmouth Tales - 2000 (2000) See Also Images by</ex:hasAnnotation>
    <ex:hasBirthplaceR>United States Ohio http://example.org/lovecraft#Salem</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasPseudonymR>R. S. Cartwright</ex:hasPseudonymR>
    <ex:hasPseudonymR>Robert Tangiers</ex:hasPseudonymR>
    <ex:hasWebsiteR>http://otherworldlie.blogspot.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Contributor</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Black_Fan">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MysticalArtefacts"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Black Fan</rdfs:label>
    <ex:hasAnnotation>The is a fictional artefact in the cthulhu mythos . It was created by chaosium for their call of cthulhu rpg . It is described as an enchanted fan used to change the wearer's appearance .</ex:hasAnnotation>
    <ex:hasFunctionA>Camouflage</ex:hasFunctionA>
    <ex:hasTypeA>Work Tool</ex:hasTypeA>
    <ex:isUsedByA rdf:resource="http://example.org/lovecraft#Nyarlathotep"/>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#Masks_of_Nyarlathotep"/>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#Nyarlathotep"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Body_in_the_Library">
    <rdf:type rdf:resource="http://example.org/lovecraft#Crossovers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Body in the Library</rdfs:label>
    <ex:hasAnnotation>Carnacki: starry wisdom and other stories was published in march 2021 . It is a short cthulhu mythos / thomas carnacki crossover story . The story is told by noted occultist and occultist, carnacki .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Carnacki: Starry Wisdom</ex:isPublishedAsW>
    <ex:isPublishedAsW>Other Stories</ex:isPublishedAsW>
    <ex:wasPublishedOnW>March 2021</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Face_of_Baphomet">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Face of Baphomet</rdfs:label>
    <ex:hasAnnotation>D'urberville believes his family can trace their lineage back to the secretive order of the knights templar . When confronted with one of basil rosier's artefacts, he is quickly convinced otherwise . With such a revelation is immediately welcomed into the folds of shub-niggurath 's cult .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Jeffrey_Thomas"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Unholy_Dimensions"/>
    <ex:wasPublishedOnW>October 2005</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Marvel_Multiverse">
    <rdf:type rdf:resource="http://example.org/lovecraft#Dimensions"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsOriginatingFromMythosAdjacentWorks"/>
    <rdfs:label>Marvel Multiverse</rdfs:label>
    <ex:hasAnnotation>The is a fictional multiverse created by marvel comics . It is the setting for two on-going on and off comic series published by marvel comics . There have been a few known multiversal-level incidents which threatened it .</ex:hasAnnotation>
    <ex:hasNotableFeatureL>Ever-expanding</ex:hasNotableFeatureL>
    <ex:hasNotableFeatureL>Infinite number of realities</ex:hasNotableFeatureL>
    <ex:hasTypeL>Multiverse</ex:hasTypeL>
    <ex:isInhabitedByL>infinite lifeforms</ex:isInhabitedByL>
    <ex:isLocatedAtL>Omniverse</ex:isLocatedAtL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Vthyarilops">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Vthyarilops</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Starfish God</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The starfish god is a fictional entity created by david perez for his short story " the likeness ". It is known to dwell in the void of outer space, waiting for victims to consume . Created by tattoo artist cal for his female client mindy .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Likeness"/>
    <ex:wasCreatedByC>Dan Perez</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tulu-metal">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MysticalArtefacts"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Tulu-metal</rdfs:label>
    <ex:hasAnnotation>The mound is a heavy, dark, lustrous and "richly mottled" metal . It has been brought to the planet by the god "tulu", a.k.a. Cthulhu . The k'n-yanians always had a deep respect for this rare substance . A talisman made of it belongs to the wichita chief grey eagle .</ex:hasAnnotation>
    <ex:hasTypeA>Advanced alien alloy</ex:hasTypeA>
    <ex:isUsedByA>K'n-yanians</ex:isUsedByA>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_Mound"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecrafts_Revisions:_How_Much_of_Them_Did_He_Write%3F">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraft's Revisions: How Much of Them Did He Write?</rdfs:label>
    <ex:hasAnnotation>"lovecraft's revisions: how much of them did he write? " Is a non-fiction work by leading h. p. lovecraft scholar s. t. joshi . It was first published in issue #11 of lovecraftian fanzine crypt of c</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#S._T._Joshi"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Crypt of Cthulhu #11</ex:isPublishedAsW>
    <ex:wasPublishedOnW>February 1983</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Eldridge_Collection">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Eldridge Collection</rdfs:label>
    <ex:hasAnnotation>Cryptic events evaluation section has been searching for a set of paintings . They have powers that make finding them and keeping them two very different things . The paintings have powers that make finding them and keeping them two very different things .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Will_Murray"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Disciples_of_Cthulhu_II"/>
    <ex:wasPublishedOnW>February 2003</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lake">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Lake</rdfs:label>
    <ex:hasAnnotation>Professor of biology at miskatonic university is the first to discover the mountains of madness . He is notable for his "alarmingly radical daring"; he is willing to put the expedition at risk in pursuit of knowledge . The narrator notes at one point that his "excitement had reached the point of mutiny"</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#At_the_Mountains_of_Madness"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Nightmare_Lake">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Nightmare Lake</rdfs:label>
    <ex:hasAnnotation>Full story online here H. P. Lovecraft United States English French The Vagrant date December 1919 " " is a poem by the late American Howard Phillips Lovecraft , first published in the December 1919 edition of amateur press The Vagrant . Synopsis The poem describes the narrator's dream of a sinister lake which is home to an ancient, sunken city and its monstrous inhabitants. History (Note: this list is compiled from information found at the H. P. Lovecraft Archive and Internet Speculative Fiction Database ) The Vagrant (1919) Scienti-Snaps (1940) Beyond the Wall of Sleep (1940) Collected Poems (1963) The World of H. P. Lovecraft (1971) Fungi from Yuggoth and Other Poems (1971) Weirdies: A Horrifying Concatenation of the Super-sur-real or Almost or Not-quite Real (1973, 1975) The Fantastic Poetry (1990) The Ancient Track: The Complete Poetical Works of H. P. Lovecraft (2001, 2013) Eldritch Tales: A Miscellany of the Macabre (2011, 2020) Complete Collection of H. P. Lovecraft (2014) To a Dreamer: Best Poems of H. P. Lovecraft (2019) Songs of Giants: The Poetry of Pulp (2019) Essais - Correspondance - Poésie - Révisions (2021) Intégrale (2021) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Vagrant"/>
    <ex:wasPublishedOnW>December 1919</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crypt_of_Cthulhu_Candlemas_1990">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crypt of Cthulhu Candlemas 1990</rdfs:label>
    <ex:hasAnnotation>Cover Artist Jason C. Eckhardt United States English Crypt of Cthulhu Cryptic Publications Release Date February 1990 72 Preceded by Yuletide 1989 Followed by Eastertide 1990 was the 70th issue of Robert M. Price 's long-running Lovecraftian fanzine Crypt of Cthulhu . Edited by Price and featuring cover art by Jason C. Eckhardt , it ran to 72 in an A5 format and was published by Cryptic Publications in February 1990. The issue was a special featuring the works of late American author Lin Carter , who had passed two years to the month before publication. Contents Editorial Shards by Robert M. Price Introduction to The Necronomicon, Book I: The Book of Episodes by Robert M. Price " The Doom of Yakthoob " by Lin Carter "The Thing Under Memphis" by Lin Carter "The City of Pillars" by Lin Carter "The Vault Beneath the Mosque" by Lin Carter "Mnomquah" by Lin Carter "The Madness Out of Time" by Lin Carter "Dreams of the Black Lotus" by Lin Carter "The Shadow from the Stars" by Lin Carter "The Necronomicon, Book II: The Book of Preparations" by Lin Carter "The Necronomicon, Book III: The Book of the Gates" by Lin Carter "The Necronomicon, Book IV: The Book of Dismissals" by Lin Carter Letters by Thomas R. Hall, III, Norman Fleck, S. T. Joshi , Stefan Dziemianowicz , Darrell Schweitzer , Donald R. Burleson, Ph.D.</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>72</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu"/>
    <ex:wasReleasedOnW>February 1990</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Space_Monster">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Space Monster</rdfs:label>
    <ex:hasAnnotation>Space monsters are an eldritch-like spaceborne insectoid race . They are the cosmic horror element in the fictional universe of the gunbuster anime . The first war between the space monsters and human race erupted in 2015 ad .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Clock_of_Dreams">
    <rdf:type rdf:resource="http://example.org/lovecraft#BrianLumleyWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CrossroadPress"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Clock of Dreams</rdfs:label>
    <ex:hasAnnotation>Titus crow is an occultist with a desire to rid the universe of the cthulhu cycle deities . He and his lover, tiania, forge alliances with some of the inhabitants of the dreamlands . The three forge alliances in preparation for the upcoming war against the cthulhu cycle deities .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror Cosmic Horror Action Adventure Fantasy</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Titus_Crow"/>
    <ex:wasReleasedOnW>1978</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Call_of_the_Sea_%28video_game%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Call of the Sea (video game)</rdfs:label>
    <ex:hasAnnotation>Call of the sea is an adventure game that explores the more dreamlike aspects of lovecraftian lore . Set in 1934, the story follows norah everhart as she searches for her missing husband on an island in the south pacific . Norah discovers that she isn't sick at all but undergoing a strange transformation that she must either embrace or reject .</ex:hasAnnotation>
    <ex:wasPublishedOnW>2021 April 15th</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nikki_Valens">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Nikki Valens</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Games designer is a games designer who develops for Fantasy Flight Games . Her output includes tie-in works for franchises such as Star Wars , as well as numerous releases for the Arkham Horror Files series of Cthulhu Mythos -related games. Selected Works Core Games Eldritch Horror (2013) Mansions of Madness Second Edition (2016) Arkham Horror Third Edition (2018) Expansion Sets Forsaken Lore (2014) Mountains of Madness (2014) Strange Remnants (2015) Under the Pyramids (2015) Signs of Carcosa (2016) Recurring Nightmares (2016) Suppressed Memories (2016) Cities in Ruin (2017) The Dreamlands (2017) Beyond the Threshold (2017) Masks of Nyarlathotep (2018) External Links at BoardGameGeek</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Games designer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lu-Kthu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OuterGods"/>
    <rdfs:label>Lu-Kthu</rdfs:label>
    <ex:hasAnnotation>First appearance EXP : "Correlated Contents" Created by James Ambuehl , otherwise known as Lew-Kthew or the Birth-womb of the Great Old Ones , is an Outer God whose first appeared in James Ambuehl 's short story " Correlated Contents ", published in 1998. Ambuehl is an American horror writer who has expanded H. P. Lovecraft 's Cthulhu Mythos with the creation of the Cycle or Pantheon of . Overview is described in the book called The Rituals of Glaa-Dith . The innumerable ovoid pustules on the slimy surface of the enormous creature are both inside and outside these tunnels and are in fact biological incubators. How often the larvae inside the incubators mature and spawn forth is unknown.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Correlated_Contents"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#James_Ambuehl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lumen">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Lumen</rdfs:label>
    <ex:hasAlternativeNamesC>Corpse Lights</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Fairy Lights</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Fox Fires</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Jack-o'-Lanterns</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Pine Lights</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Will-o'-the-Wisps</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Witch Lights</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Sociocultural Characteristics Also known as Pine Lights, Witch Lights, Will-o'-the-Wisps, Jack-o'-Lanterns, Corpse Lights, Fairy Lights, Fox Fires Real World Information First appearance " The Barrens " Created by F. Paul Wilson Lumens are an odd phenomena/lifeform created by F. Paul Wilson for his 1989 Cthulhu Mythos story " The Barrens ". Description Lumens are glowing lights that appear in "nexus points" where the fabric between reality is thin. Animals and plantlife that inhabit the areas where Lumens manifest mutate into strange forms. Behind the Mythos Lumens appear to draw inspiration from the entity in H. P. Lovecraft 's " The Colour Out of Space ", which also physically transforms living matter which it comes into contact with.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Barrens"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#F._Paul_Wilson"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Arinurian_Streams">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Arinurian Streams</rdfs:label>
    <ex:hasAnnotation>Outer space (speculative) First appearance HPL : " The Crawling Chaos " Created by H. P. Lovecraft The are cosmic boundary markers of uncertain nature that separate the Milky Way galaxy from the distant worlds of Teloe and Cytharion , mentioned in the story " The Crawling Chaos " by H. P. Lovecraft . They were part of an apocalyptic vision of the future experienced by the unnamed narrator of the story under the influence of opium, so their literal existence may or may not be taken for granted in the context of the Mythos .</ex:hasAnnotation>
    <ex:isLocatedAtL>Outer space (speculative)</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Crawling_Chaos"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bayt_al_Azif,_Issue_5,_March_2023">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Bayt al Azif, Issue 5, March 2023</rdfs:label>
    <ex:hasAnnotation>Bayt al Azif Issue 5 Various Cover Artist Holly Humphries English Bayt al Azif Genre(s) Roleplaying games Release Date March 2023 120 Preceded by Issue 4 Bayt al Azif Issue 5 is the fifth issue of sporadically-released Cthulhu Mythos roleplaying magazine Bayt al Azif . Running to a total of 120 , it was published in March 2023; paperback, hardcover, and digital formats were all released. Overview</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasGenreW>Roleplaying games</ex:hasGenreW>
    <ex:hasPageCountW>120</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Bayt_al_Azif"/>
    <ex:wasReleasedOnW>March 2023</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Shadow_Over_Innsmouth_High">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Shadow Over Innsmouth High</rdfs:label>
    <ex:hasAnnotation>It is an ironic take on h.p. Lovecraft 's the shadow over innsmouth . New girl in town cat meets some very strange characters on her first day . Determined not to fall foul of their cultish ways, she makes her escape .</ex:hasAnnotation>
    <ex:hasAuthorW>S. O. Green</ex:hasAuthorW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>It Calls From the Sea</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Godzilla_vs._Cthulhu:_A_Death_May_Die_Story">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Crossovers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Godzilla vs. Cthulhu: A Death May Die Story</rdfs:label>
    <ex:hasAnnotation>Jonathan Maberry Bruno Abdias United States English CMON Games Release Date July 27, 2024 Media Type Comic book is a comic that was published by CMON Games in July 27 at San Diego Comic-Con 2024, as a tie-in for their game Cthulhu: Death May Die and a crossover with the famous Japanese kaiju Godzilla , officially licensed by Toho. It was written by Jonathan Maberry and features artwork by Bruno Abdias. Synopsis To be added Trivia Godzilla was planned to fight Cthulhu in an unmade 1994 Heisei film and the Infestation 2 crossover comic story, but both instances were scrapped. Gallery External Links on Wikizilla References</ex:hasAnnotation>
    <ex:hasAuthorW>Jonathan Maberry</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2024 July 27</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecraft_Country_%28novel%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraft Country (novel)</rdfs:label>
    <ex:hasAnnotation>Lovecraft explores the issue of racism through an exploration of h.p. Lovecraft's cthulhu mythos . The novel was adapted in 2020 into a tv series for hbo . A sequel, the destroyer of worlds: a return to lovecraft, will be published in 2023 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Matt_Ruff"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>February 2016</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crypt_of_Cthulhu_Michaelmas_1982">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crypt of Cthulhu Michaelmas 1982</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Rick Bryant United States English Crypt of Cthulhu Release Date September 1982 36 Preceded by Lammas 1982 Followed by Hallowmas 1982 was the eighth issue of Robert M. Price 's long-running Lovecraftian fanzine Crypt of Cthulhu . Edited by Price, it featured cover art by Rick Bryant, ran to a total of 36 in an A5 format, and was self-published in August 1982. Contents Editorial Shards by Robert M. Price "H. P. Lovecraft" by Colin Wilson "Homosexual Panic in "The Outsider"" by Robert M. Price "Crypt-o-Cthulhu-Gram" (puzzle game) by Carol Selby "Lovecraft and the Male Gender Role" by Morgana LaVine "In Search of a Mythos Genealogy" by Bernadette Bosky "The Attestation Formula in the Necronomicon" by Robert M. Price "Two Burgers to Go... Mad!" by Ronald Shearer "Famous Last Words" by Robert M. Price "HPL and JFK" by Peter Cannon Review by Robert M. Price</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>36</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu"/>
    <ex:wasReleasedOnW>September 1982</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Cthulhu_Mythos_Megapack">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Cthulhu Mythos Megapack</rdfs:label>
    <ex:hasAnnotation>Ebook is a collection of forty short stories which are set in the fictional cthulhu mythos of h. p. lovecraft . Some of the stories are well-known, but there are also several more obscure additions to the mythos .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasGenreW>Horror Short Fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2012</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Autumn_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Autumn Cthulhu</rdfs:label>
    <ex:hasAnnotation>Mike Davis , editor English Lovecraft eZine Press Release Date May 4, 2016 406 is an anthology of Cthulhu Mythos fiction edited by Mike Davis , published in 2016 by Lovecraft eZine Press . "In autumn’s cold grasp, the bright petals of our reality shrivel and die," the book jacket proclaims. "The stories collected in reflect the darkest, most ancient truths of the season... nineteen beautiful, terrifying glimpses of decay and loss inspired by Lovecraft ’s work." Contents Introduction by Mike Davis "The Night Is a Sea" by Scott Thomas "In the Spaces Where You Once Lived" by Damien Angelica Walters "Memories of the Fall" by Peter Rawlik "Andy Kaufman Creeping Through the Trees" by Laird Barron "There Is a Bear in the Woods" by Nadia Bulkin "The Smoke Lodge" by Michael Griffin "Cul-de-Sac Virus" by Evan Dicken "DST (Fall Back)" by Robert Levy "The Black Azalea" by Wendy N. Wagner "After the Fall" by Jeffrey Thomas "Anchor" by John Langan "End of the Season" by Trent Kollodge "Water Main" by S. P. Miskowski "The Stiles of Palemarsh" by Richard Gavin "Grave Goods" by Gemma Files "The Well and the Wheel" by Orrin Grey "Trick... or the Other Thing" by Joseph S. Pulver, Sr. "A Shadow Passing" by Daniel Mills "Lavinia in Autumn" (poem) by Ann K. Schwader</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mike_Davis"/>
    <ex:hasAuthorW>editor</ex:hasAuthorW>
    <ex:hasPageCountW>406</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2016 May 4</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Black_Litany_of_Nug_and_Yeb">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Black Litany of Nug and Yeb</rdfs:label>
    <ex:hasAnnotation>Full story online here Joseph S. Pulver, Sr. English Genre(s) Fantasy Nightscapes date April 1998 " " is a short poem by American-born Joseph S. Pulver, Sr. Synopsis The poem is written in the style of a prayer to the twin blasphemies Nug and Yeb . History First published in the April 1998 edition of Nightscapes , "" was later reprinted in the Robert M. Price -edited anthology The Book of Eibon , and again in Pulver's own collection Blood Will Have Its Season .</ex:hasAnnotation>
    <ex:hasAuthorW>Joseph S. Pulver. Sr.</ex:hasAuthorW>
    <ex:hasGenreW>Fantasy</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Nightscapes"/>
    <ex:wasPublishedOnW>April 1998</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Monsters_in_the_Park">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Monsters in the Park</rdfs:label>
    <ex:hasAnnotation>The story is part of a cycle by british author, david hambling . It was first published in the collection of his own works shadows from norwood . It has since been released digitally in a self-titled chapbook .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#David_Hambling"/>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>The William Blake cycle</ex:isPartOfSeriesW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Shadows_from_Norwood"/>
    <ex:wasPublishedOnW>July 2013</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Quoggoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Quoggoth</rdfs:label>
    <ex:hasAffiliationC>Formerly Shuma-Gorath</ex:hasAffiliationC>
    <ex:hasAnnotation>Scott koblish is a lovecraftian creation of shuma-gorath from the marvel comics . He first appeared in the #12 issue of wolverine: first class in 2009 . His background is influenced by elements of the cthulhu mythos .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Wolverine: First Class #12</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Fred Van Lente</ex:wasCreatedByC>
    <ex:wasCreatedByC>Scott Koblish</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sweet_Ermengarde">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Sweet Ermengarde</rdfs:label>
    <ex:hasAnnotation>"polaris" is a short comedic story by american horror fiction writer h. p. lovecraft under the pseuodym "percy simple" it was probably written between 1919 and 1921; lovecraft scholars state it is "the only work of fiction by hpl that cannot be dated with precision" it was first published in the arkham house collection beyond the wall of sleep (1943)</ex:hasAnnotation>
    <ex:hasAuthorW>H. P. Lovecraft [as Percy Simple]</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Parody</ex:hasGenreW>
    <ex:hasGenreW>short</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Beyond_the_Wall_of_Sleep"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecraft:_The_Myth_of_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraft: The Myth of Cthulhu</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft (original stories) Esteban Maroto (adaptations) Esteban Maroto English IDW Publishing Release Date March 13, 2018 Media Type Comic book 80 is a Cthulhu Mythos anthology, published by IDW Publishing in 2018. It features three comic adaptations of H. P. Lovecraft 's stories, which were originally illustrated by Esteban Maroto for a small Spanish in 1982. Overview Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasAuthorW>Esteban Maroto</ex:hasAuthorW>
    <ex:hasPageCountW>80</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2018 March 13</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#One_For_the_Money">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>One For the Money</rdfs:label>
    <ex:hasAnnotation>Chris Spivey English Cthulhu Confidential Genre(s) Roleplaying game Pelgrane Press 47 is a scenario supplement for Pelgrane Press 's Cthulhu Mythos roleplaying game Cthulhu Confidential , written by Chris Spivey , one of the creators of the core game. Initially released in a solely digital format, it was later included in the omnibus collection Even Death Can Die . Overview</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Chris_Spivey"/>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>47</ex:hasPageCountW>
