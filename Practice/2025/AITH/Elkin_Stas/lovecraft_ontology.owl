  <rdf:Description rdf:about="http://example.org/lovecraft#Elder_Sign">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MysticalArtefacts"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Elder Sign</rdfs:label>
    <ex:hasAnnotation>The is a symbol used to protect against the great old ones / outer gods . It is engraved on most of the sealed doors in r'lyeh . Lovecraft himself at times seemed to consider the sign a hand gesture .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Mythos_Anthology_%28Sebastian_Greaves%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Mythos Anthology (Sebastian Greaves)</rdfs:label>
    <ex:hasAnnotation>Cthulhu Mythos Anthology Sebastian Greaves English Genre(s) Horror Amazon Kindle 50 Cthulhu Mythos Anthology , which has confusingly also been called Mythos Cthulhu: An Anthology Part One and Mythos Cthulhu Anthologies Book 1 , is a collection of short Cthulhu Mythos stories by Sebastian Greaves . Overview Containing a total of five short stories and running to 50 in length, Cthulhu Mythos Anthology was published on Amazon's digital Kindle platform. It is aimed at readers of the Young Adult level and above. Contents " Have You Seen the Yellow Sign? " " The Eye of Horus " " Great Cthulhu " " The Blind Idiot Godhead " " Nyarlathotep: The Man With No Face "</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Sebastian_Greaves"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>50</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Isaac_Waite">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Isaac Waite</rdfs:label>
    <ex:hasAffiliationC>K-FSH radio station</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Icthyic Ike</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Isaac "icthyic ike" waite is a character which features in the works of american author james ambuehl . He began his career as a radio dj at innsmouth's k-fsh fm . Later moved on to journalism, becoming the music editor and chief critic for the innsmouth courier . Currently a patient in arkham asylum , presumably as a result of believing himself to be a deep one .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Slime_Girls"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#James_Ambuehl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_New_Annotated_H._P._Lovecraft:_Beyond_Arkham">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The New Annotated H. P. Lovecraft: Beyond Arkham</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft United States English Liveright Release Date September 24, 2019 512 is a collection of H. P. Lovecraft 's stories, edited and annotated by Leslie S. Klinger. It was published by Liveright in 2019 as a follow-up to The New Annotated H. P. Lovecraft . Overview Contents Introduction by Victor LaValle Foreword Editor's Note The Stories " The Tomb " " Polaris " " The Transition of Juan Romero " " The Doom That Came to Sarnath " " The Terrible Old Man " " The Cats of Ulthar " " Facts Concerning the Late Arthur Jermyn and His Family " " The Temple " " Celephaïs " " From Beyond " " Ex Oblivione " " The Quest of Iranon " " The Outsider " " The Other Gods " " The Music of Erich Zann " " The Lurking Fear " " The Rats in the Walls " " Under the Pyramids " " The Shunned House " " The Horror at Red Hook " " He " " Cool Air " " The Strange High House in the Mist " " Pickman's Model " The Dream-Quest of Unknown Kadath Additional Material Appendix 1: Outline of the Life and Career of Howard Phillips Lovecraft Appendix 2: The Fiction of H. P. Lovecraft, in Order of Writing Appendix 3: The "Red Hook" Incantation Appendix 4: A Compleat Lovecraft Gazetteer Acknowledgments Works Cited</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>512</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2019 September 24</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhus_Heirs">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu's Heirs</rdfs:label>
    <ex:hasAnnotation>270 is an anthology of cthulhu mythos fiction edited by thomas m. k. straman . The stories mostly appeared for the first time in the collection . Won the origins award for best game-related fiction of 1994 .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>270</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu Fiction</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>March 1994</ex:wasReleasedOnW>
  </rdf:Description>
