    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>H. P. Lovecraft: Tales of Horror (Illustrated Classic Editions)</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft: Tales of Horror H. P. Lovecraft John Coulthart United States English Fall River Press Release Date October 25, 2022 377 H. P. Lovecraft: Tales of Horror is a collection of H. P. Lovecraft 's stories, featuring illustrations by John Coulthart. It was published by Fall River Press in 2022, as part of their Illustrated Classic Editions series. Contents Introduction by Stefan Dziemianowicz " The Call of Cthulhu " " The Colour Out of Space " " The Haunter of the Dark " The Whisperer in Darkness " The Dunwich Horror " " The Thing on the Doorstep " About the and Artist.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>377</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2022 October 25</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Collins">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Collins</rdfs:label>
    <ex:ceasedOnC>1925</ex:ceasedOnC>
    <ex:hasAlternativeNamesC>Capt. Collins</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>A character created by h. p. lovecraft for his short story " the call of cthulhu " . Was the captain of the schooner emma of auburn .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Call_of_Cthulhu"/>
