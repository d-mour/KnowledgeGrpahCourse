  <rdf:Description rdf:about="http://example.org/lovecraft#Rats_in_the_Cellars">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Rats in the Cellars</rdfs:label>
    <ex:hasAnnotation>Keyport cthulhu is a 1920s-era prequel to the main events of armand rosamilia's keyport cthulhu story cycle . A man travelling across finds himself in the backwards coastal town of keyport . There, he discovers his family heritage and witnesses his strangely-deformed grandfather as he sacrifices himself to a monstrous creature dwelling below the streets . Cut to several years later, and the man's firstborn child is born with</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Armand_Rosamilia"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Keyport_Cthulhu"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Keyport_Cthulhu"/>
    <ex:wasPublishedOnW>November 2013</ex:wasPublishedOnW>
  </rdf:Description>
