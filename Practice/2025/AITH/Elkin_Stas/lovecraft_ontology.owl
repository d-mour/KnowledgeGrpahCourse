  <rdf:Description rdf:about="http://example.org/lovecraft#KKligir">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>K'Kligir</rdfs:label>
    <ex:hasAnnotation>Sub-aquatic City Deep Ones First appearance " I Walk the World's Black Rim " Created by Mike Minnis is a city of the Deep Ones similar to Y'ha-nthlei. Not much is known of this city.</ex:hasAnnotation>
    <ex:hasTypeL>Sub-aquatic City</ex:hasTypeL>
    <ex:isInhabitedByL>Deep Ones</ex:isInhabitedByL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#I_Walk_the_Worlds_Black_Rim"/>
