    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Secret Santa</rdfs:label>
    <ex:hasAnnotation>Short story was first published in the anthology cthulhu christmas special and other lovecraftian yuletide tales in november 2017 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Steven_M._Vance"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
