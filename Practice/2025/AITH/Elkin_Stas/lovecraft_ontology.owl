    <ex:isPublishedAsW>Ambrosia #2</ex:isPublishedAsW>
    <ex:wasPublishedOnW>August 1973</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Momma_Durtt">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Momma Durtt</rdfs:label>
    <ex:hasAnnotation>A highly-skilled mob killer uses those he kills as sacrifices to awaken the youngest of the great old ones . He is successful, and the creature accepts his offerings but demands that he bring it more...</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Michael_Shea"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>Fall 2012</ex:wasPublishedOnW>
  </rdf:Description>
