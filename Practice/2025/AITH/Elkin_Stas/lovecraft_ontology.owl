    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Storybooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Antarctic Express</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft (original story) Kenneth Hite (adaptation) Christina Rodriguez English Genre(s) Children's Atlas Games Release Date August 2009 32 is a children's book, published by Atlas Games in 2009. It was written by Kenneth Hite and features illustrations by Christina Rodriguez. Part of the Mini Mythos series, the book is both an adaptation of H. P. Lovecraft 's At the Mountains of Madness and a parody of Chris Van Allsburg's The Polar Express . Overview</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Kenneth_Hite"/>
