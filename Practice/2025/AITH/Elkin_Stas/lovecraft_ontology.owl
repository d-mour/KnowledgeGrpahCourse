    <ex:isLocatedAtL>Western Europe</ex:isLocatedAtL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dagon_%28short_story%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dagon (short story)</rdfs:label>
    <ex:hasAnnotation>"dagon" is one of the first stories he wrote as an adult, and was first published in the november 1919 edition of the amateur press journal the vagrant . To some people, "dagon" is one of lovecraft's most forward-looking stories . The story is the testament of a tortured, morphine-addicted man who plans to commit suicide over an incident that occurred early on .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#H._P._Lovecrafts_Dreams_in_the_Witch-House">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleFilmAndTelevisionAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>H. P. Lovecraft's Dreams in the Witch-House</rdfs:label>
    <ex:hasAnnotation>Based on " The Dreams in the Witch-House " Stuart Gordon H. P. Lovecraft (original story) Stuart Gordon &amp; Dennis Paoli (screenplay) Production Company Showtime Release date 4 November 2005 United States English " " is an episode of the Showtime anthology series Masters of Horror . Written for the screen by Dennis Paoli and Stuart Gordon , who also directed, it was first broadcast on 4 November 2005 . As the title makes clear, it is an adaptation of Howard Phillips Lovecraft 's short story " The Dreams in the Witch-House ," albeit one which is updated to a contemporary time period. References</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasWriterW>http://example.org/lovecraft#Dennis_Paoli http://example.org/lovecraft#Stuart_Gordon http://example.org/lovecraft#H._P._Lovecraft</ex:hasWriterW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Dreams_in_the_Witch-House"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>4 November 2005</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Maria_Mitchell">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Maria Mitchell</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Poet United States  is an American author and poet who has written a number of works inspired by those of Howard Phillips Lovecraft and the Cthulhu Mythos . Aside from Lovecraft, she counts Edgar Allan Poe and John Keats as her influences. Her work has been published in anthologies such as Future Lovecraft (2011, Innsmouth Free Press ), Cthulhurotica (2011, Dagon Books), and Lovecraft after Dark (2015, James Ward Kirk Publishing). Selected Works Short Fiction "The Kadath Angle" (2011) " The Jewels of Arachne " (2015) Poetry " Sea Memory " (2015) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>United States</ex:hasBirthplaceR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Poet</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lynn_Willis">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Lynn Willis</rdfs:label>
    <ex:diedOnR>18 January 2013</ex:diedOnR>
    <ex:hasAnnotation>L. n. isinwyll was an american game designer and writer . Worked on the fifth and sixth editions of call of cthulhu roleplaying game . Died in 2013 after several years suffering from parkinson's disease .</ex:hasAnnotation>
    <ex:hasBirthplaceR>United States</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasPseudonymR>L. N. Isinwyll</ex:hasPseudonymR>
    <ex:isConnectedToMythosR>Game Designer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mordiggian">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Mordiggian</rdfs:label>
    <ex:hasAlternativeNamesC>Lord of Zul-Bha-Sair</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Morddoth</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Charnel God</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Great Ghoul</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The charnel god is a fictional deity created by clark ashton smith for his zothique story "the charnel god" the entity was later incorporated into the cthulhu mythos as a great old one by scott d. aniolowski in his call of cthulhu roleplaying game .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Dark_Eidolon"/>
    <ex:madeFirstAppearanceOnC>The Charnel God</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Keyport_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Keyport Cthulhu</rdfs:label>
    <ex:hasAnnotation>The first edition of , published in november 2013, contained the five stories which form the first part of armand rosamilia's story cycle . The revised and expanded edition was released in 2017 . This featured all of the stories from the original edition along with an additional two from chuck buda .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>March 2013</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Stephen_Jones">
    <rdf:type rdf:resource="http://example.org/lovecraft#Critics"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Stephen Jones</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Editor Author Birth Date 4 November 1953 London, England British Horror Supernatural http://stephenjoneseditor.com/ is a British editor and author, primarily in the horror and supernatural genres. The majority of his written work comprises non-fiction in the form of critical essays on horror fiction. He is a frequent editorial collaborator with Kim Newman , and has won numerous awards in this field. Selected Bibliography Editor H. P. Lovecraft's Book of Horror (1993) Shadows over Innsmouth (1994) Weird Shadows over Innsmouth (2005) The Horror in the Museum and Other Revisions (2007) Author " Lovecraft and the 'Literature of Cosmic Fear' " (1993)</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#England London</ex:hasBirthplaceR>
    <ex:hasNationalityR>British</ex:hasNationalityR>
    <ex:hasWebsiteR>http://stephenjoneseditor.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
    <ex:wasBornOnR>4 November 1953</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Der_Wahnsinn_aus_der_Gruft">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RamseyCampbellWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Der Wahnsinn aus der Gruft</rdfs:label>
    <ex:hasAnnotation>Ramsey Campbell Cover Artist Torstein Nordstrand Germany German H. P. Lovecraft's Bibliothek des Schreckens Genre(s) Weird fiction Festa Release Date October 2014 268 (English: Madness from the Crypt ) is a German- collection of the works of British Ramsey Campbell . Overview Containing 12 stories and running to a total of 268 , was published by Festa as part of their H. P. Lovecraft's Bibliothek des Schreckens in October 2014. It contains a translation of Campbell's introduction to the 1987 edition of Cold Print . Contents Auf der Jagd nach dem Unbekannten by Ramsey Campbell (Introduction: Chasing the Unknown) "Die Kirche in der High Street" (" The Church in High Street ") "Das Testament des Stanley Brooke" (" The Will of Stanley Brooke ") "Die Mondlinse" (" The Moon-Lens ") "Der Stein auf der Insel" (" The Stone on the Island ") "Vor dem Sturm" (" Before the Storm ") "Schwarz auf Weiß" (" Cold Print ") "Franklyns Botschaft" (" The Franklyn Paragraphs ") "" ("A Madness from the Vaults") "Dazu gehören folgende Bilder" (" Among the pictures are these: ") "Die Gesichter in Pine Dunes" (" The Faces at Pine Dunes ") "Die klingende Ebene" (" The Plain of Sound ") "Die Rückkehr der Hexe" (" The Return of the Witch ")</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
    <ex:hasCountryOfOriginW>Germany</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:hasPageCountW>268</ex:hasPageCountW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#H._P._Lovecrafts_Bibliothek_des_Schreckens"/>
    <ex:wasReleasedOnW>October 2014</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#From_Beyond_%28Adrian_M._Kleinbergen%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>From Beyond (Adrian M. Kleinbergen)</rdfs:label>
    <ex:hasAnnotation>From Beyond Full story online here Adrian M. Kleinbergen English Genre(s) Horror Nightscapes #8 date July 1998 " From Beyond " is a short Cthulhu Mythos poem by Canadian and artist Adrian M. Kleinbergen . Synopsis The three four-line verses recount in brief H. P. Lovecraft 's short story from which the poem takes its name. History "From Beyond" was published in the E. P. Berglund -edited Mythos fanzine Nightscapes in July 1988.</ex:hasAnnotation>
    <ex:hasAuthorW>Adrian M. Kleinbergen</ex:hasAuthorW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Nightscapes #8</ex:isPublishedAsW>
    <ex:wasPublishedOnW>July 1998</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Wilfred_Blanch_Talman">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsCorrespondents"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Wilfred Blanch Talman</rdfs:label>
    <ex:diedOnR>1986 February 28</ex:diedOnR>
    <ex:hasAnnotation>Pseudonym(s) Wilfred B. Talman W. B. Talman Birth Date November 19, 1904 Spring Valley, New York, USA Death Date February 28, 1986 Ridgewood, Bergen, New Jersey, USA American Horror fiction Charlotte Ann Talman Peter Talman, and Allen (Talman) 𝐓 is an American Horror fiction writer best known for his collaboration with Howard Phillips Lovecraft on the short story, " Two Black Bottles ", which was published in Weird Tales in August 1927 and credited solely to Talman. He was a correspondent with Lovecraft and a late member of the Kalem Club . Late in life, he wrote the memoir The Normal Lovecraft (1973). Bibliography Nonfiction The Normal Lovecraft (1973) Short fiction "Two Black Bottles" (1927; with H. P. Lovecraft) "The Curse of Alabad and Ghinu and Aratza" (1928) "Doom Around the Corner" (1931) "A Horror in Profile" (1934) Poems "Haunted Island" (1928) "Death" (1932) "Ballade of Creatures Abroad by Night" (1933) Essays "Letter" ( Weird Tales , October 1932) "Letter" ( Weird Tales , August 1933) References</ex:hasAnnotation>
    <ex:hasBirthplaceR>New York USA Spring Valley</ex:hasBirthplaceR>
    <ex:hasChildrenR>Allen (Talman)</ex:hasChildrenR>
    <ex:hasChildrenR>Peter Talman</ex:hasChildrenR>
    <ex:hasNationalityR>American</ex:hasNationalityR>
    <ex:hasPseudonymR>Wilfred B. Talman W. B. Talman</ex:hasPseudonymR>
    <ex:wasBornOnR>1904 November 19</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Rats_in_the_Walls_%28ARTC_audio_drama%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAudioAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Rats in the Walls (ARTC audio drama)</rdfs:label>
    <ex:hasAnnotation>The Rats in the Walls (ARTC audio drama) Based on " The Rats in the Walls " Thomas E. Fuller Henry Howard Production Company Atlanta Radio Theatre Company United States English " The Rats in the Walls " is an audio drama adaptation of the H. P. Lovecraft short story of the same name produced by the Atlanta Radio Theatre Company . It was performed live on stage at Georgia Fantasy Con in 1990. Trivia Accomplished science fiction author Harlan Ellison voiced the role of Delapore, as well as one of the shepherds and, interestingly, the controversially-named cat.</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Rats_in_the_Walls"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#H._P._Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#KalemClub"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>H. P. Lovecraft</rdfs:label>
    <ex:diedOnR>1937 March 15</ex:diedOnR>
    <ex:hasAnnotation>Lovecraft's major inspiration and invention was cosmic horror . His works were deeply pessimistic, fabricating a mythos that challenged the values of the enlightenment, romanticism, and christianity . One author theorized that lovecraft had used the pseudonym paul h. lovering .</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA http://example.org/lovecraft#Rhode_Island Providence</ex:hasBirthplaceR>
    <ex:hasNationalityR>American</ex:hasNationalityR>
    <ex:hasPseudonymR rdf:resource="http://example.org/lovecraft#Abdul_Alhazred"/>
    <ex:hasPseudonymR rdf:resource="http://example.org/lovecraft#Ward_Phillips"/>
    <ex:hasPseudonymR>Edward Softly</ex:hasPseudonymR>
    <ex:hasPseudonymR>Humphrey Littlewit</ex:hasPseudonymR>
    <ex:hasPseudonymR>Jun</ex:hasPseudonymR>
    <ex:hasPseudonymR>Lewis Theobald</ex:hasPseudonymR>
    <ex:wasBornOnR>1890 August 20</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Invisible_octopoid">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonSapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Invisible octopoid</rdfs:label>
    <ex:hasAnnotation>Real World Information First appearance AWD : " The Lurker at the Threshold " Created by H. P. Lovecraft &amp; August Derleth</ex:hasAnnotation>
