    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Conqueror Worm</rdfs:label>
    <ex:ceasedOnC>2000</ex:ceasedOnC>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Ogdru_Jahad"/>
    <ex:hasAffiliationC>Herman von Klempt</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Unknown</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as Unknown Dawn of Time 2000 Earth Powers and Abilities Turning people into Frog Monsters Relatives Ogdru Jahad (Parent) Nunn-Jahad Ogdru Hem (Sibling) Sadu-Hem Urgo-Hem Katha-Hem Salton Sea Monster Offspring Unknown Unknown Destroyer of world Ogdru Jahad, Herman von Klempt Unknown Ogdru Hem First appearance Unknown Hellboy: Created by Mike Mignola  The is one of of the 369 Ogdru Hem , offspring of the monstrous Ogdru Jahad . It served as the main antagonist in Hellboy: .</ex:hasAnnotation>
    <ex:hasAppearanceC>Hellboy: Conqueror Worm</ex:hasAppearanceC>
    <ex:hasCharacterMateC>Unknown</ex:hasCharacterMateC>
