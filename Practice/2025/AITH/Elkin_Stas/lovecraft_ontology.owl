    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Rise of the Basilisk</rdfs:label>
    <ex:hasAnnotation>Ashton McAllan English Fate of Cthulhu Genre(s) Roleplaying game Evil Hat Productions Release Date 2021 27 is a timeline supplement for the Fate of Cthulhu horror roleplaying game. Written by Ashton McAllan and featuring artwork by Fred Hicks and Kurt Komoda, it runs to a total of 27 , and was published in a digital format by Evil Hat Productions in 2021 . Overview References</ex:hasAnnotation>
    <ex:hasAuthorW>Ashton McAllan</ex:hasAuthorW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
