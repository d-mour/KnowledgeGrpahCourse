    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Rise of the Quiet</rdfs:label>
    <ex:hasAnnotation>John Rogers English Fate of Cthulhu Genre(s) Roleplaying game Evil Hat Productions Release Date 2021 38 is a timeline supplement for the Fate of Cthulhu horror roleplaying game. Written by John Rogers and featuring cover art by Fred Hicks and Kurt Komoda, it was published digitally by Evil Hat Productions in 2021 . Overview References</ex:hasAnnotation>
    <ex:hasAuthorW>John Rogers</ex:hasAuthorW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>38</ex:hasPageCountW>
