    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Jacob Maitland</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Sanbourne_Institute_of_Pacific_Antiquities"/>
    <ex:hasAnnotation>Professor is a character created by american author robert m. price as part of his cthulhu mythos writings . As a graduate assistant at the sanbourne institute of pacific antiquities, he aided occult detective anton zarnak with a matter regarding the acquisition of occult texts . As a senior faculty member at sanbourne, with the aid of his star pupil and the bimini glyphs, he decoded the mysteries of the r'ly</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Soul_of_the_Devil-Bought"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Down_in_Limbo"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
  </rdf:Description>
