  <rdf:Description rdf:about="http://example.org/lovecraft#Dancy_Flammarion">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Dancy Flammarion</rdfs:label>
    <ex:hasAnnotation>Dancy is a fictional character created by caitlin r. kiernan . She is an albino teenager from the backwoods of florida who hunts monsters at the direction of a lovecraftian angel . First appearing in the novel threshold (2001), she was later featured in a series of short stories collected in the volumes alabaster and comes a pale rider .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Threshold"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
  </rdf:Description>
