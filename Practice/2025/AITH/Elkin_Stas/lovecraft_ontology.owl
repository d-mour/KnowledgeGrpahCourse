    <ex:isPartOfSeriesW>Studies</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>April 2001</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A._R._Tilburne">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>A. R. Tilburne</rdfs:label>
    <ex:diedOnR>1965 January 22</ex:diedOnR>
    <ex:hasAnnotation>Albert roanoke tilburne was an american pulp illustrator . His work first appeared in the big magazine in 1935 before selling his services to weird tales in 1938 and strange stories in 1939 . In 1950 he retired from illustration and devoted his time to paintings of the old west until his death in 1965 .</ex:hasAnnotation>
    <ex:hasBirthplaceR>Indiana New Albany</ex:hasBirthplaceR>
    <ex:hasFatherR>Edward Oliver Tilburne</ex:hasFatherR>
    <ex:hasFullNameR>Albert Roanoke Tilburne</ex:hasFullNameR>
    <ex:hasMotherR>Marie Tilburne</ex:hasMotherR>
    <ex:hasNationalityR>American</ex:hasNationalityR>
    <ex:hasSisterR>Lillian</ex:hasSisterR>
    <ex:hasYearsActiveR>1935 - 1950</ex:hasYearsActiveR>
    <ex:wasBornOnR>1887 November 13</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#August">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>August</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft United States English Arkham House Something About Cats and Other Pieces Date of writing 1918 date 1949 𝐓 " " is a poem by the late American Howard Phillips Lovecraft . Written in 1918, it was published in the 1949 Arkham House collection Something About Cats and Other Pieces ; since then, it has been reprinted several times, including an appearance in Weird Tales , a pulp magazine closely associated with Lovecraft's works. History Something About Cats and Other Pieces (1949) Collected Poems (1963) The World of H. P. Lovecraft (1971) Fungi from Yuggoth and Other Poems (1971) Weird Tales (1974) The Californian: 1934-1938 (1977) The Ancient Track: The Complete Poetical Works of H. P. Lovecraft (2001, 2013) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Something_About_Cats"/>
    <ex:isPublishedAsW>Other Pieces</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1949</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>August 1918</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Cultus_Issue_12">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Periodicals"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Cultus Issue 12</rdfs:label>
    <ex:hasAnnotation>Cthulhu cultus #12 is an issue of sporadic american fanzine cthulhu cultus . Edited by tani jantsang and james ambuehl and published by p. marsh in april 1998 . Contains: "the suit" by g. w. thomas, "throk" by james gruetzmacher, "dies irae" by j. B. lee, "cthulhu" by james ambuehl</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>62</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>April 1998</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Harpy">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SpeciesIncorporatedFromFolkloreMythAndReligion"/>
    <rdfs:label>Harpy</rdfs:label>
    <ex:hasAnnotation>Harpies are a legendary species of winged female creatures from greek mythology . They are featured in h. p. lovecraft's poem " hallowe'en in a suburb ", and mentioned in the opening quote of " the dunwich horror " .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Halloween_in_a_Suburb"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dark_Boatman:_Tales_of_Horror_and_the_Cthulhu_Mythos">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dark Boatman: Tales of Horror and the Cthulhu Mythos</rdfs:label>
    <ex:hasAnnotation>John Glasby United States English Genre(s) Horror Short Fiction English Release date July 2012 is a collection of short stories by British John Glasby . Contents " The Dark Boatman " "Aunt Amelia" "That Deep Black Yonder" "Dust" "The Keeper of Dark Point" Behind the Mythos was first published in the United States in July 2012 by Borgo Press, a division of Wildside Press LLC . In November of the same year it received an ebook release in the US, Canada and United Kingdom. In August 2013 it was issued as a paperback in the United Kingdom. Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#John_Glasby"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror Short Fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Where_Yidhra_Walks">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Where Yidhra Walks</rdfs:label>
    <ex:hasAnnotation>The disciples of cthulhu is a short story by american writer walter debill . It was originally written as part of his mlandoth cycle . It has since been incorporated into the greater cthulhu mythos through chaosium 's call of cthulhu roleplaying game .</ex:hasAnnotation>
    <ex:hasAuthorW>Walter C. DeBill. Jr.</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:isInLanguageW>Italian</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Mlandoth_Cycle"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Disciples_of_Cthulhu"/>
    <ex:wasPublishedOnW>October 1976</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Study_for_The_Witch_House">
    <rdf:type rdf:resource="http://example.org/lovecraft#CaitlinRKiernanWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Study for The Witch House</rdfs:label>
    <ex:hasAnnotation>The story concerns the sale of a painting, called study for "the witch house" it depicts a "crooked, ramshackle house...clinging to the edge of a towering sea cliff" in the 1960s, the house became a mecca for "hippies and occultist types"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Dandridge_Cycle"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Sirenia_Digest"/>
    <ex:wasPublishedOnW>September 2013</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Vlad_Dracula">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Vlad Dracula</rdfs:label>
    <ex:hasAnnotation>Dracula was in his mortal life the ruler of the 15th century principality of wallachia, romania . Due to a series of events orchestrated by varnae the millennia old atlantean lord of vampires, he became a vampire . He has clashed with various supernatural beings, until the emergence of superhumans .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Army_of_Darkness:_Ash_Vs._The_Classic_Monsters"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Army_of_Darkness:_Furious_Road"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Montesi_Formula"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#X-Men:_Apocalypse_vs_Dracula"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#X-Men:_Soul_Killer"/>
    <ex:hasAppearanceC>Blood Feud</ex:hasAppearanceC>
    <ex:hasAppearanceC>Death of Dracula</ex:hasAppearanceC>
    <ex:hasAppearanceC>Dracula vs Thor</ex:hasAppearanceC>
    <ex:hasAppearanceC>Dynamite: Prophecy</ex:hasAppearanceC>
    <ex:hasAppearanceC>Marvel: Vampiric Verses</ex:hasAppearanceC>
    <ex:hasAppearanceC>Night Screams</ex:hasAppearanceC>
    <ex:hasAppearanceC>Space Goat: Evil Dead 2: Revenge of Dracula</ex:hasAppearanceC>
    <ex:hasAppearanceC>Tomb of Dracula Presents: Throne of Blood</ex:hasAppearanceC>
    <ex:hasAppearanceC>Tomb of Dracula Vol 4</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC>Dracula (1897)</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Bram Stoker</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Saturnalia_and_Other_Poems_by_H._P._Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Saturnalia and Other Poems by H. P. Lovecraft</rdfs:label>
    <ex:hasAnnotation>Crypt of cthulhu was edited by leading h. p. lovecraft scholar . It is the only issue of the fanzine in its 41 year run to be edited by anyone other than robert m. price . It featured cover art by rick bryant, and ran to a total of 72 in an a5 format .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>72</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu"/>
    <ex:wasReleasedOnW>April 1984</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Thuria">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Thuria</rdfs:label>
    <ex:hasAnnotation>It is the setting for the his king kull stories and the background history for the hyborian age of his more widely successful conan the barbarian stories . 20,000 years ago, on the thurian supercontinent were seven great empires dominated most of the continent, of which the western empire of valusia was the greatest .</ex:hasAnnotation>
    <ex:hasTypeL>Continent</ex:hasTypeL>
    <ex:isInhabitedByL>Humans</ex:isInhabitedByL>
    <ex:isInhabitedByL>Serpent People</ex:isInhabitedByL>
    <ex:isInhabitedByL>Wolf-Men</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Earth"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Shadow_Kingdom"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Before_the_Fall">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Before the Fall</rdfs:label>
    <ex:hasAnnotation>Ralph Dula Mike Lay Gary O'Connell Gary Sumpter Lucya Szachnowski Drashi Khendup M. Wayne Miller Tom Sullivan English (original) Spanish Call of Cthulhu Genre(s) Roleplaying game Chaosium La Factoría de Ideas Release Date 1998 64 is a thematic scenario supplement for Chaosium 's Call of Cthulhu horror roleplaying game. Written by Ralph Dula, Mike Lay, Gary O'Connell, Gary Sumpter , and Lucya Szachnowski, it runs to a total of 64 and was published in a softcover format in 1998 . Artwork was supplied by Drashi Khendup, M. Wayne Miller , and Tom Sullivan . La Factoría de Ideas also released a Spanish translation of the book, titled Antes de la Caída . Overview Contents "Mary" "Old Acquaintance" "The Innsmouth Connection" "The Occulted Light" Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Gary_Sumpter"/>
    <ex:hasAuthorW>Gary O'Connell</ex:hasAuthorW>
    <ex:hasAuthorW>Lucya Szachnowski</ex:hasAuthorW>
    <ex:hasAuthorW>Mike Lay</ex:hasAuthorW>
    <ex:hasAuthorW>Ralph Dula</ex:hasAuthorW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>64</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>Spanish</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>1998</ex:wasReleasedOnW>
  </rdf:Description>
