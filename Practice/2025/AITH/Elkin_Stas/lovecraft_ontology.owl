    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Hidden</rdfs:label>
    <ex:hasAnnotation>Historyis a short cthulhu mythos story by american scott t. goudsward . It was published in the thematic anthology return of the old ones: tales of lovecraftian horror in 2017 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Scott_T._Goudsward"/>
