  <rdf:Description rdf:about="http://example.org/lovecraft#BhYhlun_%28series%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#StoryCycles"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Bh'Yhlun (series)</rdfs:label>
    <ex:hasAnnotation>Bh'Yhlun (series) Ian Davey English Genre(s) Horror Publication date 1997-2012 The Bh'Yhlun series by Ian Davey is a series of post-apocalyptic Cthulhu Mythos short stories, several of which first appeared in the online zine Nightscapes . Overview The series tells the story of the return of the Old Ones ( Nyarlathotep being the most prominent) and the fall of mankind. However, amongst the survivors are a handful of people who possess supernatural knowledge on a way to fight back and, perhaps, reclaim the world in the name of humanity. Stories " Black Letter Day " (1997) " An Incarceration in Bh'Yhlun " (1997) " Francesci's Cult of the Necronomicon: An Interlude " (1997) " The Epiphany of Dissolution " (1998) " In the Shadow of Bh'Yhlun " (2012)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ian_Davey"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>1997-2012</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Emily_Jane_Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Emily Jane Lovecraft</rdfs:label>
    <ex:diedOnR>1925</ex:diedOnR>
    <ex:hasAnnotation>Lovecraft’s paternal aunt and wife of Isaac C. Hill. She gave birth to one child, Mary Ida Emily.</ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1849</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Derleth_%28Doctor_Who%29">
