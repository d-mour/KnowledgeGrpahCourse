  <rdf:Description rdf:about="http://example.org/lovecraft#George_Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>George Lovecraft</rdfs:label>
    <ex:diedOnR>1895</ex:diedOnR>
    <ex:hasAnnotation>Lovecraft’s paternal grandfather. He arrived in Rochester around 1831 and married Helen Allgood in 1839. He worked as a harness maker until at least 1850, after which he worked as a salesman for Mt. Hope Garden and Nursery. Some time after 1861, he moved his family to Mt. Vernon, New York.</ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1814</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Homes_and_Shrines_of_Poe">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Homes and Shrines of Poe</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft United States English (original) French German Genre(s) Non-fiction The Californian date Winter 1934 " " is a short non-fiction piece by the late American Howard Phillips Lovecraft , written on one of his great literary inspirations, Edgar Allan Poe . First published in the Winter 1934 edition of The Californian , it has since been reprinted several times, and has also been translated into both French and German . History The Californian (1934) The Acolyte (1943) The Californian: 1934-1938 (1977) Howard Phillips Lovecraft 1 (1991, French-) Miscellaneous Writings (1995) Collected Essays Volume 4: Travel (2006) Cthulhu (2009, German-) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:isPublishedAsW>The Californian</ex:isPublishedAsW>
    <ex:wasPublishedOnW>Winter 1934</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Achtung%21_Cthulhu:_Heroes_of_the_Sea">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Achtung! Cthulhu: Heroes of the Sea</rdfs:label>
    <ex:hasAnnotation>Sarah Newton Dim Martin Cover Artist Dim Martin English Call of Cthulhu Genre(s) Roleplaying game Modiphius Entertainment Release Date 2013 63 is a scenario supplement for Modiphius Entertainment 's Achtung! Cthulhu setting for Chaosium 's Call of Cthulhu horror roleplaying game. The second book in the Achtung! Cthulhu , and the second part of the Zero Point campaign, it was written by Sarah Newton , featured artwork by Dim Martin, and was published by Modiphius in 2013 . Overview Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Sarah_Newton"/>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>63</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2013</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Syththunu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Syththunu</rdfs:label>
    <ex:hasAffiliationC>DC Comics : Dark Giants (aka</ex:hasAffiliationC>
    <ex:hasAffiliationC>Elder Gods</ex:hasAffiliationC>
    <ex:hasAffiliationC>Many-Sided Ones)</ex:hasAffiliationC>
    <ex:hasAnnotation>Synththunu is an elder god , who at one time was feared and revered on earth . He was imprisoned in a crystal small enough to be held in the palm of a man's hand . Along with eclipso and others he recruited or enthralled, synththunu battled the justice league of america on the moon .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Justice League of America Vol 2 54</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Brett Booth</ex:wasCreatedByC>
    <ex:wasCreatedByC>James Robinson</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mountains_of_Madness_Revealed">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Mountains of Madness Revealed</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist J. K. Potter English PS Publishing Release Date September 2019 364 is a thematic anthology of Lovecraftian fiction edited by Darrell Schweitzer and published by PS Publishing in hardcover format in September 2019. Overview Contents Introduction by Darrell Schweitzer "Climate of Fear" by Ann K. Schwader "Cold Storage" by Adrian Cole "Beyond the Thaw" by Gordon Linzner "Echoes from the Ice" by James Chambers "New Birth" by Melinda LaFevers "The Embrace of Elder Things" by John R. Fultz "The Hill of the Beast" by Harry Turtledove "Skinny Dipping with the Old Ones" by James Van Pelt " The Unspeakable Spawning of the Proto-Shoggoths " by Robert M. Price "The Water of Dhul Nun" by Don Webb "A Boy and His Shoggoth" by John Shirley "The Yog-Sothoth Policemen's Union" by Paul Di Filippo "The Evening Calm" by Frederic S. Durbin "Strange Perfumes of a Polar Sun" by John Linwood Grant "At the Mountains of Magnates" by Geoffrey Hart "In Everything a Sound" by Amdi Silvestri "A Wind from the South" by Géza A. G. Reilly "Down to a Sunless Sea" by Darrell Schweitzer "The Ballad of the Black Mountain" by Adam Bolivar</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>364</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>September 2019</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Anne">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Anne</rdfs:label>
    <ex:diedOnR>unknown</ex:diedOnR>
    <ex:hasAnnotation>(Vyne) Tillery Renshaw, prolific amateur journalist and professor. She commissioned Lovecraft to revise a textbook of English usage, Well Bred Speech (1936), although much of the work Lovecraft did for it was excised and remains unpublished.</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1936</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Tall_Grass">
    <rdf:type rdf:resource="http://example.org/lovecraft#MediaAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Tall Grass</rdfs:label>
    <ex:hasAnnotation>Behind the mythosis the fifth episode, season 2 of the netflix original series love, death &amp; robots . It is based on the short story of the same name by joe r. lansdale . The design of main character laird clearly takes some inspiration from h. p. lovecraft himself .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW>The Tall Grass by Joe R. Lansdale</ex:isBasedOnW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>14 May 2021</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Spoken_Covenant_%28Call_of_Cthulhu_LCG%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Spoken Covenant (Call of Cthulhu LCG)</rdfs:label>
    <ex:hasAnnotation>The Spoken Covenant Fantasy Flight Games Publication Date 2010 Living Card Game Call of Cthulhu: The Card Game The Spoken Covenant is an expansion pack for Fantasy Flight Games ' Call of Cthulhu: The Card Game . Overview The third Asylum Pack in The Yuggoth Contract Cycle series of expansions, The Spoken Covenant contains 60 cards in the standard division of three sets of 20 unique cards. First released in 2010, it was discontinued with the demise of Call of Cthulhu: The Card Game . Contents Museum Security (Character; The Agency) Intervention (Event; The Agency) Priest of Two Faiths (Character; The Agency) Labyrinth of a Dead City (Support; Cthulhu ) Stygian Idol (Support; Cthulhu) Hastur , Lord of Carcosa (Character; Hastur) The Yellow Sign (Event; Hastur) Swooping Byakhee (Character; Hastur) Broken Glasses (Support; Miskatonic University ) Under the Microscope (Event; Miskatonic University) M.U. Chem Lab (Support; Miskatonic University) The Guardian of the Key (Conspiracy; Neutral) Drunken Hallucinations (Event; Neutral) Mi-Go Laboratory (Support; Shub-Niggurath ) Mi-Go Guard (Character; Shub-Niggurath) Mi-Go Scalpel (Support; Shub-Niggurath) Bound and Gagged (Support; Syndicate) Bootlegging Operation (Support; Syndicate) Flying Polyps (Character; Yog-Sothoth ) All are One (Event; Yog-Sothoth)</ex:hasAnnotation>
    <ex:wasPublishedOnW>2010</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Overseer_%28Kingdom_Rush_series%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>The Overseer (Kingdom Rush series)</rdfs:label>
    <ex:hasAnnotation>The overseer is the overarching antagonist of the kingdom rush franchise . It is a lovecraftian-like, eldritch being of unknown origins that seeks to enter the world of linerea to consume it with the help of his army, the unblinded cult . The overseer is a powerful entity that reigns over a dark, energy-filled realm called the void .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yogash_the_Ghoul">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Yogash the Ghoul</rdfs:label>
    <ex:hasAffiliationC>Ghouls</ex:hasAffiliationC>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Yogash the Black (possibly)</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Yogash is the offspring of shaurash-ho , who is a grandchild of nug . It's possible that yogash was the first of the ghouls, and the origin of that . It's not clear if this degree of separation renders him mortal .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Selected_Letters_of_H._P._Lovecraft"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Dream-Quest_of_Unknown_Kadath"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Charles_Christian">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Charles Christian</rdfs:label>
    <ex:diedOnR>2022</ex:diedOnR>
    <ex:hasAnnotation>Connection to the Mythos Author Scarborough, Yorkshire, England Death Date 2022 United Kingdom https://www.urbanfantasist.com/ (died 2022) was a British journalist and barrister turned author and editor. He has written a number of pieces set in the fictional Cthulhu Mythos inspired by the works of Howard Phillips Lovecraft . These have been published in anthologies such as World War Cthulhu (2014, Dark Regions Press ) and Atomic-Age Cthulhu (2015, Chaosium ). Christian passed away suddenly in 2022 ; the cause of his death is uncertain. Selected Bibliography Short Fiction " Long Island Weird - The Lost Interviews " (2014) "The Day the Music Died" (2015) External Links at the Internet Speculative Fiction Database at Goodreads References</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#England Scarborough Yorkshire</ex:hasBirthplaceR>
    <ex:hasNationalityR>United Kingdom</ex:hasNationalityR>
    <ex:hasWebsiteR>https://www.urbanfantasist.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#It_Hides_in_the_Village">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>It Hides in the Village</rdfs:label>
    <ex:hasAnnotation>The other: encounters with the cthulhu mythos book 1 date 2020 . It is the fourth instalment of the nyarlathotep cycle of stories .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Troy_Young"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Nyarlathotep_Cycle"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Other:_Encounters_with_the_Cthulhu_Mythos_Book_1"/>
    <ex:wasPublishedOnW>2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Species">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LifeformsAndEntities"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Species</rdfs:label>
    <ex:hasAnnotation>This category contains all creatures, (sentient, non-sentient, native, extra-terrestrial, etc.) that have been classified or described as a large population of similar creatures. This is to say that they share a single, unique, evolving gene pool. These have in the past been described using the archaic term "race", but are better described with a contemporary term based in biology and genetics.</ex:hasAnnotation>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Character"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lloigor_%28species%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Lloigor (species)</rdfs:label>
    <ex:hasAlternativeNamesC>The Invisible Ones from the Stars</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The lloigor are vortices of living power completely invisible except on occasions when they appear reptilian . They used humans as slaves (see the kthatans), have the power to transform people physically and can adopt corporal bodies if they wish .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Return_of_the_Lloigor"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Colin_Wilson"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Witness_in_Darkness">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Witness in Darkness</rdfs:label>
    <ex:hasAnnotation>The madness of cthulhu was first published in the anthology the madness of cthulhu by titan books in october 2014 . The story is told in the form of a transcript taken from a statement by scholar and explorer william dyer . Dyer had returned to antarctica years after the disastrous pabodie expedition and had encountered an elder thing .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#John_Shirley"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Madness_of_Cthulhu"/>
    <ex:wasPublishedOnW>October 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Edward_F._Daas">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Edward F. Daas</rdfs:label>
    <ex:diedOnR>1962</ex:diedOnR>
    <ex:hasAnnotation>Amateur journalist who recruited Lovecraft into the movement in 1914.</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1879</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ebenezer_Holt">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Ebenezer Holt</rdfs:label>
    <ex:ceasedOnC>Revolutionary War</ex:ceasedOnC>
    <ex:hasAlternativeNamesC>Eb Holt</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as eb holt 18th century merchant ship captain human . Mentioned in the story " the picture in the house " by h.p. Lovecraft . Traded a book to the unnamed old man from the story .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Picture_in_the_House"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Gathered_Dust_and_Others">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Gathered Dust and Others</rdfs:label>
    <ex:hasAnnotation>W. H. Pugmire Cover Artist Wayne Miller English Dark Regions Press Release Date March 2012  is a collection of Lovecraftian and weird fiction by the late American W. H. Pugmire . It was first published by Dark Regions Press in September 2011 in a hardcover format; paperback editions were released in March 2012 and August 2018, and an ebook edition has also been released. An introduction was included by fellow Mythos Jeffrey Thomas , with whom Pugmire had collaborated for the Enoch Coffin series of Lovecraftian short stories. Overview Contents "The Strange Case of Wilum Hopfrog Pugmire, an Introduction" by Jeffrey Thomas "The February 26, 2009 Interview of W. H. Pugmire" by Jeffrey Thomas "Gathered Dust" "Your Kiss of Corruption" " Yon Baleful God " "Time of Twilight" " These Deities of Rarest Air " "The Boy with the Bloodstained Mouth" " The Woven Offspring " "The Tangled Muse" "Let Us Wash This Thing" "Bloom of Sacrifice" "He Who Made Me Dream" "Cool Mist" "Descent into Shadow and Light" "Serenade of Starlight" "Graffito Flow" "Depths of Dreams and Madness" "The Host of Haunted Air" "A Vestige of Mirth"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#W._H._Pugmire"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>March 2012</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#M_Is_for_Mars">
    <rdf:type rdf:resource="http://example.org/lovecraft#CaitlinRKiernanWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>M Is for Mars</rdfs:label>
    <ex:hasAnnotation>Caitlin R. Kiernan English Genre(s) Cthulhu Mythos Centipede Press Houses Under the Sea: Mythos Tales date July 2018 "" is a short story by Caitlin R. Kiernan that first appeared in their collection Houses Under the Sea: Mythos Tales (Centipede Press, 2018). It is the only story in that collection to make its original appearance there. Synopsis It's a science fiction story set on a Mars that, in the wake of a selective plague, is inhabited only by women. The plot involves a conspiracy to awaken a sleeping god on the planet--a god associated at one point with the world " DAGON ."</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Houses_Under_the_Sea:_Mythos_Tales"/>
    <ex:wasPublishedOnW>July 2018</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sesqua_Valley_and_Other_Haunts">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Sesqua Valley and Other Haunts</rdfs:label>
    <ex:hasAnnotation>W. H. Pugmire Cover Artist Angie Wiedemann United States English Mythos Books Release Date October 2008 203  is a thematic collection of Lovecraftian and Cthulhu Mythos fiction by the late American W. H. Pugmire . It was published by Mythos Books in October 2008. Overview Contents "O, Christmas Tree" (with Jessica Amanda Salmonson) "The Ones Who Bow Before Me" "Born in Strange Shadow" "Another Flesh" "Immortal Remains" "Selene" "The Darkest Star" "The Songs of Sesqua Valley" "Heritage of Hunger" "An Imp of Aether" "The Million-Shadowed One" "The Child of Dark Mania" " The Hands That Reek and Smoke " "The Host of Haunted Air" " The Woven Offspring " "The Place of Old Insanity" "The Zanies of Sorrow" "Beneath An Autumn Moon" "The Balm of Nepenthe" "The Phantom of Beguilement" "A Vestige of Mirth"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#W._H._Pugmire"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>203</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>October 2008</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#It_Came_from_the_Sea">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>It Came from the Sea</rdfs:label>
    <ex:hasAnnotation>"it slumbers beneath the ice" is a short cthulhu mythos story by troy young . It is the first story in the nyarlathotep cycle . "history" was published in the other: encounters with the cthulhu mythos book 1 in 2020 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Troy_Young"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Other:_Encounters_with_the_Cthulhu_Mythos_Book_1"/>
    <ex:wasPublishedOnW>2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Imelod">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Imelod</rdfs:label>
    <ex:hasAnnotation>Todd H. C. Fischer Todd H. C. Fischer English Quarterly January 1996 Final Publication October 2000 , subtitled " The litzine of horror and the bizarre " was a short-lived fanzine dedicated to horror, science fiction and fantasy works. Overview Edited by Todd H. C. Fischer , who also provided some of the cover artwork, and published in Ontario, Canada, was a quarterly zine which ran for a total of seventeen issues between January 1996 and October 2000. It primarily focussed on art, poetry and fiction, but also featured reviews and the occasional interview, with notable authors S. T. Joshi and W. H. Pugmire both giving interviews. Gallery</ex:hasAnnotation>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Achtung%21_Cthulhu_%28Call_of_Cthulhu/Savage_Worlds%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Achtung! Cthulhu (Call of Cthulhu/Savage Worlds)</rdfs:label>
    <ex:hasAnnotation>Achtung! Cthulhu is a series of historical setting and scenario supplements originally designed for use with call of cthulhu horror roleplaying game . It was first published by third-party content provider modiphius entertainment after a successful kickstarter campaign . Modiphius have since cut tied with call of cthulhu and re-released the setting as a stand-alone roleplaying game .</ex:hasAnnotation>
    <ex:wasPublishedOnW>2012-2021</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Deuce_Richardson">
    <rdf:type rdf:resource="http://example.org/lovecraft#Critics"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Deuce Richardson</rdfs:label>
    <ex:hasAnnotation>Full Name Larry "Deuce" Richardson Connection to the Mythos Author Horror Fantasy Larry "Deuce" Richardson is an author and online critic who works in the horror and fantasy genres. Selected Bibliography Poems " Dolmen of the Moon " (2019)</ex:hasAnnotation>
    <ex:hasFullNameR>Larry Deuce Richardson</ex:hasFullNameR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Wildside_Press">
    <rdf:type rdf:resource="http://example.org/lovecraft#Publishers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Wildside Press</rdfs:label>
    <ex:hasAnnotation>1989 John Gregory Betancourt Kim Betancourt United States Cabin John, Maryland Distribution Method Print Digital Print on Demand Speculative Fiction Mystery Science Fiction Romance Nonfiction Borgo Press Cosmos Books Point Blank http://wildsidepress.com/ is an American independent publishing company whose output includes work from H. P. Lovecraft 's fictional Cthulhu Mythos . Overview Originally in 1989 by author John Gregory Betancourt and his wife Kim as an outlet for speculative fiction, Wildside's scope has since expanded to cover a number of genres, including mystery, science fiction, romance, and nonfiction. The company also produces a range of audiobooks (both in digital and compact disc formats) and downloadable eBooks, and maintains a print on demand service as well as a reprint project dedicated to publishing issues of old pulp magazines in their original format. incorporates the Borgo Press, Cosmos Books and Point Blank. Selected List of Publications Periodicals Weird Tales (2005-present) H. P. Lovecraft's Magazine of Horror (2006-2009) Anthologies The Cthulhu Mythos Megapack (2012) Cthulhu: Weirdbook Annual 2 (2019) Non-Fiction A Subtler Magick: The Writings and Philosophy of H. P. Lovecraft (1996) H. P. Lovecraft: The Decline of the West (2000) Howard Phillips Lovecraft: Dreamer on the Nightside (2016)</ex:hasAnnotation>
    <ex:hasWebsiteR>http://wildsidepress.com/</ex:hasWebsiteR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Modiphius_Entertainment">
    <rdf:type rdf:resource="http://example.org/lovecraft#Publishers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Modiphius Entertainment</rdfs:label>
    <ex:hasAnnotation>Modiphius is a uk-based traditional games manufacturer . Started out publishing achtung! Cthulhu supplements for call of cthulhu and pinnacle's generic savage worlds system . In 2023, they reissued achtung! Cthulhu as a stand-alone roleplaying game using their in-house 2d20 rules system .</ex:hasAnnotation>
    <ex:hasWebsiteR>https://modiphius.net/</ex:hasWebsiteR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#W._Paul_Cook">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonFictionAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>W. Paul Cook</rdfs:label>
    <ex:diedOnR>January 22 1948</ex:diedOnR>
    <ex:hasAnnotation>William paul cook was a printer, publisher, and editor in the amateur press movement . He was a friend and colleague of h. p. lovecraft, encouraging his writing . Cook published "dagon", which may be considered the first cthulhu story .</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Mount Tabor. Vermont</ex:hasBirthplaceR>
    <ex:hasFullNameR>William Paul Cook</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasPseudonymR>Willis T. Crossman</ex:hasPseudonymR>
    <ex:isConnectedToMythosR>Publisher</ex:isConnectedToMythosR>
    <ex:isKnownForR>Appreciations</ex:isKnownForR>
    <ex:isKnownForR>Estimates</ex:isKnownForR>
    <ex:isKnownForR>In Memoriam: Howard Phillips Lovecraft: Recollections</ex:isKnownForR>
    <ex:wasBornOnR>1881 August 31</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Fire_Vampires">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Fire Vampires</rdfs:label>
    <ex:hasAnnotation>Donald wandrei's short story, "wt," appeared in the february 1933 issue of weird tales . It is based on a true story about a comet and a sentient fireball in a tree . The fireball consumed people in fire with fingers of lightning, and forced them to hide . Six years later in august, norby and his assistant, hue, came across a sentient fireball .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Donald_Wandrei"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Science Fiction Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Cthulhu Mythos</ex:isPartOfSeriesW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>February 1933</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Infestation_2">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Crossovers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Infestation 2</rdfs:label>
    <ex:hasAnnotation>The elder gods are breaking out of their dimensional prison and bringing a wave of destruction to the infinite multiverse . Comic book is a crossover event in the idw comics that involved several fictional universes .</ex:hasAnnotation>
    <ex:hasAuthorW>Chris Ryall</ex:hasAuthorW>
    <ex:hasAuthorW>Chuck Dixon</ex:hasAuthorW>
    <ex:hasAuthorW>Duane Swierczynski</ex:hasAuthorW>
    <ex:hasAuthorW>Mike Raicht</ex:hasAuthorW>
    <ex:hasAuthorW>Paul Crilley</ex:hasAuthorW>
    <ex:hasAuthorW>Tristan Jones</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>January 2012 - April 2012</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Vampirella">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Vampirella</rdfs:label>
    <ex:hasAnnotation>A hero in the fictional dynamite universe, who was created in 1969 by forrest j ackerman . Possesses most of the powers of vampires and none of the weaknesses . Defends humanity from forces of supernatural which would enslave, torture, feed, or kill them .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Army_of_Darkness"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Prophecy"/>
    <ex:hasAppearanceC>Vampirella Vs. Reanimator</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC>Vampirella Vol 1 1</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Forrest_J_Ackerman"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Loved_Dead_and_Other_Revisions">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Loved Dead and Other Revisions</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft et al English Carroll &amp; Graf Release Date 1997 (first edition) 1999 (second edition) 243 is a collection of short stories which H. P. Lovecraft revised for other authors. It was first published in 1997 by Carroll &amp; Graf; a second edition was issued in 1999. Contents " The Last Test " for Adolphe de Castro " Medusa's Coil " for Zealia Bishop " The Man of Stone " for Hazel Heald " Out of the Aeons " Hazel Heald " The Horror at Martin's Beach " for Sonia H. Greene " Ashes " for C. M. Eddy, Jr. " The Ghost-Eater " for C. M. Eddy, Jr. " The Loved Dead " for C. M. Eddy, Jr. " Deaf, Dumb and Blind " for C. M. Eddy, Jr. " The Trap " for Henry S. Whitehead " The Tree on the Hill " with Duane W. Rimel " The Disinterment " for Duane W. Rimel " Till A' the Seas " for R. H. Barlow " The Night Ocean " for R. H. Barlow</ex:hasAnnotation>
    <ex:hasAuthorW>H. P. Lovecraft et al</ex:hasAuthorW>
    <ex:hasPageCountW>243</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1999 1997</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Saaitii">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Saaitii</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Great_Old_One"/>
    <ex:hasAnnotation>Created by william hope hodgson is a fictional entity which made its first appearance in " the hog ", although it was unnamed in that work . It was given a proper title and classified as a great old one in chaosium 's call of cthulhu roleplaying game in 1994 . In the original carnacki stories, the word "saiitii" is not the name of a single entity, but rather a dangerous class of supernatural manifestations .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Hog"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#William_Hope_Hodgson"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Cultus_Issue_13">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Periodicals"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Cultus Issue 13</rdfs:label>
    <ex:hasAnnotation>Cthulhu Cultus #13 Various Cover Artist Tani Jantsang United States English P. Marsh Release Date May 1998 62 Preceded by Cthulhu Cultus #12 Followed by Cthulhu Cultus #14 Cthulhu Cultus #13 is an issue of sporadic American fanzine Cthulhu Cultus , edited by Tani Jantsang and James Ambuehl and published by P. Marsh in May 1998. Contents " People of the Monolith " (Part 7 of 7) by Crispin Burnham "untitled ("Locked below cold stone...")" by G. W. Thomas "Newsflash" by Anon. "The Infinite Varieties of Chaos" by Robert Bee "I Am Nyarlathotep!" by P. J. Roberts "LA Dire Portico" by P. J. Roberts "Loathsome Putrescence" by P. J. Roberts "Dreadful Figures Prancing" by P. J. Roberts ""At the Sound of the Tone..."" by G. W. Thomas "Moon Depths" by James Gruetzmacher "Alum Chine" by D. F. Lewis "The Temple Beneath the Pines" by Lee Clark "Amber-Tinted Dusk" by P. J. Roberts "Cthulhu's Messengers" by P. J. Roberts "A Black Obelisk" by P. J. Roberts "Shoggoths" by P. J. Roberts "The Burrowers Beneath" by P. J. Roberts "The Critic, Colin Wilson (Oh Dear!)" by G. W. Thomas "Those Wonderful Other Nations: A Few Words in Favor of FAN-zines" by Tani Jantsang</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>62</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>May 1998</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kilderry">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Kilderry</rdfs:label>
    <ex:hasAnnotation>A fictional village created by the late american author h. p. lovecraft for his short story "the moon-bog" is located in county meath, ireland . It was the village to which denys barry relocated after emigrating from the u.s.</ex:hasAnnotation>
    <ex:hasNotableFeatureL>Haunted bog</ex:hasNotableFeatureL>
    <ex:hasNotableFeatureL>Restored castle</ex:hasNotableFeatureL>
    <ex:hasTypeL>Village</ex:hasTypeL>
    <ex:isInhabitedByL>Humans</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Ireland"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Moon-Bog"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mahtavat_Ammoiset">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Mahtavat Ammoiset</rdfs:label>
    <ex:hasAnnotation>Kuoriaskirjat (finnish for great old ones) is a 2012 finnish short horror story written by tuomas saloranta . The story starts around the 1980s when the unnamed narrator is spending time with uncle allan, who owns an antiquarian bookshop in punavuori . Allan claims that while cornelius and lovecraft had a productive correspondence, it ended in conflicts over the cthulhu-mythos .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Tuomas_Saloranta"/>
    <ex:hasCountryOfOriginW>Finland</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>short story</ex:hasGenreW>
    <ex:isInLanguageW>Finnish</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Cthulhu Mythos</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Voonith">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonSapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Voonith</rdfs:label>
    <ex:hasAnnotation>Sociocultural Characteristics Unknown Real World Information First appearance " The Dream-Quest of Unknown Kadath " Created by Howard Phillips Lovecraft</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Dream-Quest_of_Unknown_Kadath"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Final_Flight">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Final Flight</rdfs:label>
    <ex:hasAnnotation>John H. Crowe III Marius Hamilton Heather Hudson Cover Artist Richard Sardinha English Call of Cthulhu Genre(s) Roleplaying game Pagan Publishing Release Date 2008 is a short scenario supplement for Chaosium 's Call of Cthulhu horror roleplaying game. Written by John H. Crowe III , it was published by third-party content provider Pagan Publishing in 2008 . Overview Synopsis The plot involves a group of airline passengers, among them a rogue Serpent Person sorcerer, whose plane has crash landed in the Brazilian rainforest in the late 1930s. They are faced with the dual challenge of surviving and self-rescuing from an extremely hostile environment while avoiding the depredations of an enclave of Serpent People and their degenerate minions . Design Team Written by: John Crowe Artwork by: Marius Hamilton, Heather Hudson, and Richard Sardinha Production staff: Brian Appleton , Adam Scott Glancy , and Marius Hamilton Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#John_H._Crowe_III"/>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2008</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Rat-Thing">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ServitorRaces"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Rat-Thing</rdfs:label>
    <ex:hasAnnotation>Rat-things are a fictional species created for the role-playing game call of cthulhu , based on the character brown jenkin from h.p. Lovecraft's short story " the dreams in the witch-house " . Populations of rat-things have been reported from yorkshire, england, as well as massachusetts .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Dreams_in_the_Witch-House"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Drowning_at_Lake_Henpin">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Drowning at Lake Henpin</rdfs:label>
    <ex:hasAnnotation>The book is told in the form of an account kept by the sole survivor of an encounter with a malevolent cult . It was published in the ross e. lockhart -edited anthology the book of cthulhu ii by night shade books in october 2012 .</ex:hasAnnotation>
    <ex:hasAuthorW>Paul Tobin</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Book_of_Cthulhu_II"/>
    <ex:wasPublishedOnW>October 2012</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Eidolon">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Eidolon</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft United States English (original) French Arkham House Beyond the Wall of Sleep Date of writing October 1918 date 1943 " " is a poem by the late American Howard Phillips Lovecraft . Although it was written in October 1918, it did not see until its inclusion in the 1943 Arkham House collection Beyond the Wall of Sleep ; Since then, it has been reprinted several times, and has also been translated into French . History Beyond the Wall of Sleep (1943) Collected Poems (1963) The World of H. P. Lovecraft (1971) Fungi from Yuggoth and Other Poems (1971) The Fantastic Poetry (1990) The Ancient Track: The Complete Poetical Works of H. P. Lovecraft (2001, 2013) Essais - Correspondance - Poésie - Révisions (2021) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Beyond_the_Wall_of_Sleep"/>
    <ex:wasPublishedOnW>1943</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>October 1918</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Theodorus_Philetas">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Theodorus Philetas</rdfs:label>
    <ex:hasAlternativeNamesC>Theodoros Philetos</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Theodorus was a resident of . Constantinople who "secretly translated" the work in 1050 under the title necronomicon . No copy of the translation has been known to exist since one was burned in salem in 1692 .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#History_of_the_Necronomicon"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dark_Brotherhood_and_Other_Pieces">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dark Brotherhood and Other Pieces</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Frank Utpatel United States English Arkham House Release Date 1966 Media Type Hardback Print 321 is a collection of literary works by H. P. Lovecraft and others. The volume is particularly notable for the controversy caused by the inclusion of Jack L. Chalker's Lovecraft bibliography, with George T. Wetzel making accusations of plagiarism which seemed to have some foundation. Publication History First released in 1966 in hardback format by Arkham House , was edited by Lovecraft's friend and contemporary August Derleth , with a dust jacket illustration by noted Mythos artist Frank Utpatel . Contents "Introduction", by August Derleth " The Dark Brotherhood " by H. P. Lovecraft and August Derleth " Suggestions for a Reading Guide ", by H. P. Lovecraft " Alfredo ", by H. P. Lovecraft " Amateur Journalism: Its Possible Needs and Betterment ", by H. P. Lovecraft " What Belongs in Verse ", by H. P. Lovecraft Six Poems, by H. P. Lovecraft " Bells " " Oceanus " " Clouds " " Mother Earth " " Cindy " " On a Battlefield in France " Three Stories by C. M. Eddy, Jr. " The Loved Dead " " Deaf, Dumb, and Blind " " The Ghost-Eater " " The Lovecraft "Books": Some Addenda and Corrigenda ", by William Scott Home " To Arkham and the Stars ", by Fritz Leiber " Through Hyperspace With Brown Jenkin ", by Fritz Leiber " Lovecraft and the New England Megaliths ", by Andrew E. Rothovius " Howard Phillips Lovecraft: A Bibliography ", by Jack L. Chalker " Walks With H. P. Lovecraft ", by C. M. Eddy, Jr. " The Cancer of Superstition ", by C. M. Eddy, Jr. " The Making of a Hoax ", by August Derleth " Lovecraft's Illustrators ", by John E. Vetter "Final Notes", by August Derleth</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>321</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1966</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Droom-avista">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OuterGods"/>
    <rdfs:label>Droom-avista</rdfs:label>
    <ex:hasAlternativeNamesC>Possibly Nyogtha</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Possibly Zuchequon</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Dark Shining One</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Dweller Beyond</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Jester</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Dweller Beyond The Dark Shining One The Jester Possibly Zuchequon Possibly Nyogtha Relatives Possibly Ubbo-Sathla (parent) Possibly Cyäegha (offspring) First appearance CIRCLE : " The Jest of " Created by Henry Kuttner is not a "little god" but a slumbering Outer God who can grant "wishes" in a manner similar to djinn or genies. He knows many secrets, but dislikes being awakened and has a cruel sense of humour, often twisting requests so they come out ill for the one asking. He manifests in a silent cloud of darkness and might be the same as Zuchequon , the Dark Silent One, or Nyogtha . He is noted for his destruction of Bel Yarnak . This entity is the main antagonist in the eponymous " The Jest of Droom-Avesta " by Henry Kuttner .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Jest_of_Droom-Avista"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Henry_Kuttner"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Necronomicon_%28Zenescope_Entertainment%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Crossovers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Necronomicon (Zenescope Entertainment)</rdfs:label>
    <ex:hasAnnotation>Necronomicon is a cthulhu mythos comic book written by david wohl and chas! Pangburn, and featuring artwork from various authors . It was published digitally by zenescope entertainment in september 2024 .</ex:hasAnnotation>
    <ex:hasAuthorW>Chas! Pangburn</ex:hasAuthorW>
    <ex:hasAuthorW>David Wohl</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>September 2023</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Freddy_vs._Jason_vs._Ash">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Freddy vs. Jason vs. Ash</rdfs:label>
    <ex:hasAnnotation>James Kuhoric Jason Craig English Dynamite Entertainment, Wildstorm Productions Release Date Nov 2007 - March 2008 Media Type Comic book is a 6-issue crossover mini-series written by James Kuhoric. Synopsis Ash Williams finds himself in a 3-way battle with Freddy Krueger and Jason Voorhees at Crystal Lake.</ex:hasAnnotation>
    <ex:hasAuthorW>James Kuhoric</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>Nov 2007 - March 2008</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Chasing_Sunset">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Chasing Sunset</rdfs:label>
    <ex:hasAnnotation>Historywas first published in the lovecraftian anthology whispers from the abyss by 01publishing in 2013 . It was also included in the october 2015 anthology the monstrous .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#A._C._Wise"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Whispers_from_the_Abyss"/>
