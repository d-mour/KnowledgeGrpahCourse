  <rdf:Description rdf:about="http://example.org/lovecraft#The_Lair_of_the_Star-Spawn">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Lair of the Star-Spawn</rdfs:label>
    <ex:hasAnnotation>Weird tales is the first story to reference the "tcho-tcho people" and the entity lloigor . It is notable as the first story to reference the "tcho-tcho people" and the entity lloigor . Lloigor is a mythological creature that resembles a wolf or a bear .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#August_Derleth"/>
