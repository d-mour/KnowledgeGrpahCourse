    <ex:wasPublishedOnW>2001 November 12</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>October 2001</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dulwich_Horror_of_1927_%28chapbook%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
