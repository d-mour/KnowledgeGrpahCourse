    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Atonement</rdfs:label>
    <ex:hasAnnotation>"history" is a short story by american author ron shiflet . It functions as a follow-up to lovecraft's "herbert west-reanimator" the narrator is now a small-town physician in townsend, illinois .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
