    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Haiyoru! Nyaruani: Remember My Mr. Lovecraft</rdfs:label>
    <ex:hasAnnotation>Japanese is a series of flash-animated shorts, directed by azuma tani and produced by dle . It was made to be a second season for their previous anime haiyoru! Nyaruani .</ex:hasAnnotation>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#Haiyore%21_Nyaruko-san"/>
    <ex:isInLanguageW>Japanese</ex:isInLanguageW>
