  <rdf:Description rdf:about="http://example.org/lovecraft#A._C._Wise">
    <rdf:type rdf:resource="http://example.org/lovecraft#Critics"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>A. C. Wise</rdfs:label>
    <ex:hasAnnotation>Full Name Alison Campbell-Wise Connection to the Mythos Author Montreal, Quebec, Canada Speculative fiction http://acwise.net/ Alison Campbell-Wise is an award-winning Canadian author, editor and critic who has written a number of stories inspired by the works of the late Howard Phillips Lovecraft . These have appeared in anthologies such as Future Lovecraft (2011), Apotheosis: Stories of Human Survival After the Rise of the Elder Gods (2015), and Tomorrow's Cthulhu (2016). Selected Bibliography Short Fiction " Venice Burning " (2011) " Chasing Sunset " (2013) " We Are Not These Bodies, Strung Between the Stars " (2015) " Tekeli-li, They Cry " (2016) External Links at Wikipedia the Internet Speculative Diction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>Canada Montreal Quebec</ex:hasBirthplaceR>
    <ex:hasFullNameR>Alison Campbell-Wise</ex:hasFullNameR>
    <ex:hasWebsiteR>http://acwise.net/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Jeffrey_Combs">
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPeople"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Jeffrey Combs</rdfs:label>
    <ex:hasAnnotation>Jeffrey alan combs was born on 9 september 1954 in oxnard, california . He has appeared in a number of screen works with a connection to the cthulhu mythos . He played lead roles in re-animator (1985) and from beyond (1986) he also played fictionalised version of h.p. Lovecraft in 1993 movie necronomicon: book of the dead .</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA http://example.org/lovecraft#California Oxnard</ex:hasBirthplaceR>
    <ex:hasFullNameR>Jeffrey Alan Combs</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasYearsActiveR>1981-present</ex:hasYearsActiveR>
    <ex:isConnectedToMythosR>Actor</ex:isConnectedToMythosR>
    <ex:wasBornOnR>9 September 1954</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#New_York_%28Marvels_Prime_Reality%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>New York (Marvel's Prime Reality)</rdfs:label>
    <ex:hasAnnotation>The majority of the comic series mostly or large part in the big apple . The city has been the center of several stories with elements of cosmic horror . There are a number of criminal organizations which are involved in the city .</ex:hasAnnotation>
    <ex:hasNotableFeatureL>densely populated</ex:hasNotableFeatureL>
    <ex:hasNotableFeatureL>docks</ex:hasNotableFeatureL>
    <ex:hasNotableFeatureL>lots of noise</ex:hasNotableFeatureL>
    <ex:hasNotableFeatureL>pollution</ex:hasNotableFeatureL>
    <ex:hasNotableFeatureL>skyscrapers</ex:hasNotableFeatureL>
    <ex:hasNotableFeatureL>subways</ex:hasNotableFeatureL>
    <ex:hasTypeL>City</ex:hasTypeL>
    <ex:isInhabitedByL>Millions of humans</ex:isInhabitedByL>
    <ex:isLocatedAtL>Earth (Prime Reality)</ex:isLocatedAtL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Golarion">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Planets"/>
    <rdfs:label>Golarion</rdfs:label>
    <ex:hasAnnotation>Pathfinder: rise of the runelords is a planet created by paizo in 2007 . It became the primary setting for the pathfinder roleplaying game . There are dozens of sentient species inhabiting the planet . The outer gods and great old ones have servants and followers on .</ex:hasAnnotation>
    <ex:hasNotableFeatureL>Continents</ex:hasNotableFeatureL>
    <ex:hasNotableFeatureL>Oceans</ex:hasNotableFeatureL>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#Mhar"/>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#Orgesh"/>
    <ex:isInhabitedByL>dozens of sentient species</ex:isInhabitedByL>
    <ex:isLocatedAtL>Planet</ex:isLocatedAtL>
