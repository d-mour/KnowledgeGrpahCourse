  <rdf:Description rdf:about="http://example.org/lovecraft#Black_Wings_III">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Black Wings III</rdfs:label>
    <ex:hasAnnotation>New Tales of Lovecraftian Horror S. T. Joshi (editor) Cover Artist Jason Van Hollander English Black Wings Genre(s) Lovecraftian Horror PS Publishing Release Date February 2014 338 Preceded by Black Wings II Followed by Black Wings IV : New Tales of Lovecraftian Horror is an anthology of original Lovecraftian horror , edited by S. T. Joshi and published by PS Publishing in 2014 as part of the Black Wings of H. P. Lovecraft -influenced fiction. It was reprinted by Titan Books as Black Wings of Cthulhu 2: Seventeen Tales of Lovecraftian Horror in 2015. Contents "Introduction" by S. T. Joshi "China Holiday" by Peter Cannon "Dimply Dolly Doofy" by Donald R. Burleson "Down Black Staircases" by Joseph S. Pulver, Sr. "Further Beyond" by Brian Stableford "Hotel del Lago" by Mollie L. Burleson "Houdini Fish" by Jonathan Thomas "Necrotic Cove" by Lois Gresh "One Tree Hill (The World as Cataclysm)" by Caitlín R. Kiernan (2013) "Spiderwebs in the Dark" by Darrell Schweitzer "The Hag Stone" by Richard Gavin "The Man with the Horn" by Jason V. Brock "The Megalith Plague" by Don Webb "The Turn of the Tide" by Mark Howard Jones "Thistle's Find" by Simon Strantzas "Underneath an Arkham Moon" by W. H. Pugmire and Jessica Amanda Salmonson "Waller" by Donald Tyson "Weltschmerz" by Sam Gafford</ex:hasAnnotation>
    <ex:hasAuthorW>S. T. Joshi (editor)</ex:hasAuthorW>
    <ex:hasGenreW>Lovecraftian Horror</ex:hasGenreW>
    <ex:hasPageCountW>338</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Black_Wings"/>
    <ex:wasReleasedOnW>February 2014</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#RealWorld">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Location"/>
