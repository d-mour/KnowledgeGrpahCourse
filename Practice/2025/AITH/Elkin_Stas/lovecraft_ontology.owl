    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Peter J. Evans</rdfs:label>
    <ex:hasAnnotation>Feeders from within was a tie-in novel for arkham horror . His contribution to the cthulhu mythos was a tie-in novel for the series .</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isKnownForR rdf:resource="http://example.org/lovecraft#Feeders_from_Within"/>
