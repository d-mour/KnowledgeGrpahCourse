  <rdf:Description rdf:about="http://example.org/lovecraft#Player_from_Beyond_the_Void">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Player from Beyond the Void</rdfs:label>
    <ex:hasAnnotation>First appearance HPL : " The Music of Erich Zann " Created by H.P. Lovecraft The is a being of unknown origin. Its appearance is unknown but could be an insectoid one. It seems to have the power to travel through reality.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Music_of_Erich_Zann"/>
