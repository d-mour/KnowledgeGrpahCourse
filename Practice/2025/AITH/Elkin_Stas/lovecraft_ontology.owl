    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>A. A. Attanasio</rdfs:label>
    <ex:hasAnnotation>Alfred angelo attanasio was born on september 20, 1951, in newark, new jersey . His first novel, radix, won the prix cosmos 2000, a french literary award . He wrote the dominions of irth fantasy trilogy under the pseudonym adam lee .</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA http://example.org/lovecraft#New_Jersey Newark</ex:hasBirthplaceR>
    <ex:hasFullNameR>Alfred Angelo Attanasio</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
