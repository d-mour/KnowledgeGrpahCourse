    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Character"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Demon_Planet">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Demon Planet</rdfs:label>
    <ex:hasAnnotation>Demon planets are eldritch living planets in the fictional universe of the rifts pencil-and-paper roleplaying game by palladium . They are eldritch behemoths, alien intelligences which consume entire solar systems . They have spherical forms with a giant mouth over 1,600 km in diameter which have colossal tentacles coming out of them .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Rifts"/>
    <ex:wasCreatedByC>Palladium Games</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Casefile:_Arkham-_Her_Blood_Runs_Cold">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Casefile: Arkham- Her Blood Runs Cold</rdfs:label>
    <ex:hasAnnotation>Asenath waite hires private investigator hank flynn on the pretext of having him track down a manuscript belonging to her dead husband, edward pickman derby . However, she is actually using him to track down those responsible for her husband's death and as a weapon in her battle against her father's newly-embodied spirit . A subplot explaining glynda's backstory is also present, but has little bearing on the main storyline .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Josh_Finney"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>March 2018</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sona-Nyl">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Sona-Nyl</rdfs:label>
    <ex:hasAlternativeNamesL>Land of Fancy</ex:hasAlternativeNamesL>
    <ex:hasAnnotation>Dreamlands also known as the land of fancy , is a coastal region in the dreamlands of earth . The dreamer basil elton lived there for a time before embarking on his doomed sea voyage aboard the white ship . The land of is guarded by twin headlands of crystal that rise from the sea and meet in a resplendent arch .</ex:hasAnnotation>
    <ex:hasTypeL>Country</ex:hasTypeL>
    <ex:isInhabitedByL>Humans</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Dreamlands"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_White_Ship"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Alan_Moores_The_Courtyard">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Alan Moore's The Courtyard</rdfs:label>
    <ex:hasAnnotation>Alan Moore (original story) Antony Johnston (adaptation) Jacen Burrows English Avatar Press Release Date Jan 2003 - Feb 2003 Media Type Comic book is a 2-part comic book mini-series by Antony Johnston who adapted it from a 1994 prose story by Alan Moore . Synopsis The FBI agent Aldo Sax is investigating 3 ritual murders, leading him to a night club in New York City where he meets a mysterious veiled man named Johnny Carcosa. It is the prelude to the story Neonomicon .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Alan_Moore"/>
    <ex:hasAuthorW>Antony Johnston</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>Jan 2003 - Feb 2003</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Heroes_of_Red_Hook">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Heroes of Red Hook</rdfs:label>
    <ex:hasAnnotation>Various English Genre(s) Horror Golden Goblin Press Release Date September 2016 257 is a thematic anthology featuring works from several of the most prolific and respected authors working in the Lovecraftian genre of the day. Overview Contents " A True Telling of the Terror that Came to Red Hook " by William Meikle "Ivan and the Hurting Doll" by Mercedes M. Yardley "A Gentleman of Darkness" by Wilum Hopfrog Pugmire "Hungry Ghosts" by Cody Goodfellow "Tell Me No Lies" by Sam Stone "O Friend and Companion of Night" by Vincent Kovar "Across a River of Stars" by Scott R. Jones "Old Time Religion" by Paula R. Stiles "Men and Women" by Oscar Rios "The Eye of Infinity" by Sam Gafford "Lords of Karma" by Glynn Owen Barrass and Juliana Quartaroli "A Ghastly Detestable Pallor" by Penelope Love "Crossing the Line" by Tom Lynch "The Guilt of Nikki Cotton" by Pete Rawlik "Brickwalk Mollies" by Christine Morgan "The Backwards Man" by Tim Waggoner "Beyond the Black Arcade" by Edward M. Erdelac "Shadows Upon the Matanzas" by Lee Clark Zumpe Publication History Edited by Brian M. Sammons and Oscar Rios and running to a total of 257 , was published in September 2016 by Golden Goblin Press in both paperback and digital editions.</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>257</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>September 2016</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mr._Verhaeren">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Mr. Verhaeren</rdfs:label>
    <ex:hasAnnotation>Belgium Trade agent Human First appearance HPL : " Facts Concerning the Late Arthur Jermyn and His Family " Created by H. P. Lovecraft is a Belgian trade agent at a trading post on the Congo River in Africa. During the course of Arthur Jermyn 's investigation of his own ancestry, it was who obtained and delivered to Arthur the box that contained the stuffed and mummified remains of the white ape "goddess" who had been the wife of Arthur's ancestor Wade Jermyn . ( HPL : " Facts Concerning the Late Arthur Jermyn and His Family ")</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Facts Concerning the Late Arthur Jermyn</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>His Family</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dreamlands_%28Eldritch_Horror%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dreamlands (Eldritch Horror)</rdfs:label>
    <ex:hasAnnotation>The Dreamlands Nikki Valens Fantasy Flight Games Publication Date 2017 Board game Eldritch Horror The Dreamlands is an expansion set for the Eldritch Horror Cthulhu Mythos board game. Designed by Nikki Valens and featuring artwork from a host of artists, it was published by Fantasy Flight Games in 2017; since its released, it has been translated into eight different languages . Overview External Links "The Dreamlands" at the Fantasy Flight Games website Gallery References</ex:hasAnnotation>
    <ex:wasPublishedOnW>2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Donald_Tyson">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonFictionAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Donald Tyson</rdfs:label>
    <ex:hasAnnotation>Canadian author who has written more than a dozen nonfiction books on the western esoteric tradition . Tyson has also written fiction in the cthulhu mythos, including two novels that focus on the character of abdul alhazred .</ex:hasAnnotation>
    <ex:hasNationalityR>Canada</ex:hasNationalityR>
    <ex:isKnownForR rdf:resource="http://example.org/lovecraft#The_Dream_World_of_H._P._Lovecraft"/>
    <ex:wasBornOnR>1954 January 12</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Beowulf">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Beowulf</rdfs:label>
    <ex:hasAnnotation>Unknown Genre(s) Epic is an Old English epic poem. It’s exact date of writing is unclear, but the earliest known manuscript dates from the late 10th/early 11th century. Synopsis The story follows Swedish warrior as he ascends to become king of the Geats, battling a series of supernatural threats along the way. It culminates with the death of and his people going into mourning. Behind the Mythos appears to have been an influence on H. P. Lovecraft , as he mentions the poem in his essay Supernatural Horror in Literature as an example of how elements of horror have been an integral part of folklore throughout history.</ex:hasAnnotation>
    <ex:hasAuthorW>Unknown</ex:hasAuthorW>
    <ex:hasGenreW>Epic</ex:hasGenreW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Cloud-Thing">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OuterGods"/>
    <rdfs:label>The Cloud-Thing</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Azathoth"/>
    <ex:hasAffiliationC>Outer Gods</ex:hasAffiliationC>
    <ex:hasAnnotation>Outer Gods Azathoth First appearance EXP : King of Chicago Created by Gary Sumpter was an unnamed Outer God within the Court of Azathoth , it was described as man-eating, cloudy mass. References Gary Sumpter (1994). King of Chicago ( Call of Cthulhu ). Chaosium . ISBN 978-1-56882-020-0 .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#King_of_Chicago"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Gary_Sumpter"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Colonial_Gothic:_Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Colonial Gothic: Lovecraft</rdfs:label>
    <ex:hasAnnotation>Graeme Davis Richard Iorio Tony Ackland Khannea SunTzu Michal Majqello Knapik English Colonial Gothic Genre(s) Roleplaying game Rogue Games, Inc Release Date September 2015 140 is a gamebook supplement for Rogue Games, Inc's historical horror roleplaying game Colonial Gothic , which gives players options and ideas for incorporating Lovecraftian elements into their games. Written by Graeme Davis and Richard Iorio, and featuring artwork from Tony Ackland, Khannea SunTzu, and Michal Majqello Knapik, it runs to a total of 140 and was published in September 2015; both softcover and digital editions were released . Overview Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Graeme_Davis"/>
    <ex:hasAuthorW>Richard Iorio</ex:hasAuthorW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>140</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Colonial Gothic</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>September 2015</ex:wasReleasedOnW>
  </rdf:Description>
