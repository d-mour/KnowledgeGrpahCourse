  <rdf:Description rdf:about="http://example.org/lovecraft#Annotations_for_the_Book_of_Night">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Annotations for the Book of Night</rdfs:label>
    <ex:hasAnnotation>Al-azif #2 is a short story by american and leading h. p. lovecraft scholar robert m. price . It is a short cthulhu mythos story . When hyperborean sorcerer eibon recovers a tattered copy of the noctuary of vizooranos from an ancient tomb, he in</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Fantasy</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Al-Azif #2</ex:isPublishedAsW>
    <ex:wasPublishedOnW>March 1998</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Rainfall_Books">
    <rdf:type rdf:resource="http://example.org/lovecraft#Publishers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Rainfall Books</rdfs:label>
    <ex:hasAnnotation>Current Status Active Steve Lines John B. Ford United Kingdom Horror http://www.rainfallsite.com/ is a U.K.-based small-press publishing house which specialises in the horror and Cthulhu Mythos works in particular. Founded by Steve Lines and John B. Ford , it has been run by Ford since the death of Lines in early 2021. It publishes anthologies, chapbooks and periodicals in both physical and ebook formats. Selected Publications Periodicals Lovecraft's Disciples (2005-2020) E'ch Pi El (2006-2018) Anthologies Inhabitants of Innsmouth (2006) Tales of the Cthulhu Mythos: Cthulhu's Creatures (2007) Chapbooks Tales of Nephren Ka ( Ran Cartwright , 2006) Y'ha-nthlei Rising and Other Tales of the Deep Ones (Ran Cartwright, 2006)</ex:hasAnnotation>
    <ex:hasWebsiteR>http://www.rainfallsite.com/</ex:hasWebsiteR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#In_the_Court_of_the_Yellow_King">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>In the Court of the Yellow King</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Daniele Serra English Celaeno Press Release Date September 2014 354 is a collection of Lovecraftian fiction edited by Glynn Owen Barrass and published by Celaeno Press in September 2014. Featuring cover art by Daniele Serra, both paperback and digital editions were released. Overview Contents Introduction by Glynn Owen Barrass "These Harpies of Carcosa" by W. H. Pugmire "The Viking in Yellow" by Christine Morgan "Who Killed the King of Rock and Roll?" by Edward Morris "Masque of the Queen" by Stephen Mark Rainey "Grand Theft Hovercar" by Jeffrey Thomas "The Girl with the Star-Stained Soul" by Lucy A. Snyder "The Penumbra of Exquisite Foulness" by Tim Curran "Yield" by C. J. Henderson "Homeopathy" by Greg Stolze " Bedlam in Yellow " by William Meikle "A Jaundiced Light at the End" by Brian M. Sammons "The Yellow Film" by Gary McMahon "Lights Fade" by Laurel Halbany "Future Imperfect" by Glynn Owen Barrass "The Mask of the Yellow Death" by Robert M. Price "The Sepia Prints" by Pete Rawlik "Nigredo" by Cody Goodfellow "MonoChrome" by T. E. Grau</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>354</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>September 2014</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ghast">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonSapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Ghast</rdfs:label>
    <ex:hasAlternativeNamesC>Creeping Hoppers</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Crypt Lurkers</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Dark Fiends</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Faceless Ones</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Shunned</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Ghasts are humanoid creatures who dwell in the vaults of zin . May be encountered in places where sunlight never comes, such as underworld labyrinths, cavern networks, and deep tunnel systems . Their language appears to consist of "coughing gutturals"</ex:hasAnnotation>
    <ex:hasAppearanceC>Dragons</ex:hasAppearanceC>
    <ex:hasAppearanceC>Dungeons</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Dream-Quest_of_Unknown_Kadath"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#James_Gruetzmacher">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>James Gruetzmacher</rdfs:label>
    <ex:hasAnnotation>Full Name James A. Gruetzmacher Connection to the Mythos Poet Horror Years Active 1997-2006 James A. Gruetzmacher is a poet who has written a small number of works inspired by the Cthulhu Mythos born from the prose of H. P. Lovecraft and his contemporaries. His works have been published in zines such as Nightscapes , Cthulhu Cultus , Al-Azif , Tales of Lovecraftian Horror , Dark Legacy , and The Yellow Sign . Selected Bibliography Poetry " Spawn of Tindalos " (1997, with Ron Shiflet ) " Feast of Eihort " (1998) " Ei'lor " (1998) " The Crawler " (2006) External Links at the Internet Speculative Fiction Database</ex:hasAnnotation>
    <ex:hasFullNameR>James A. Gruetzmacher</ex:hasFullNameR>
    <ex:hasYearsActiveR>1997-2006</ex:hasYearsActiveR>
    <ex:isConnectedToMythosR>Poet</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tekeli-li%21_Disturbing_Language_in_Edgar_Allan_Poe_and_H._P._Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Tekeli-li! Disturbing Language in Edgar Allan Poe and H. P. Lovecraft</rdfs:label>
    <ex:hasAnnotation>Tekeli-li! Disturbing in . Eap and hp lovecraft is a short non-fiction piece by south african-born . Editor, and occasional scholar lynne jamneck .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lynne_Jamneck"/>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Lovecraft_Annual_No._6"/>
    <ex:wasPublishedOnW>August 2012</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Unholy_Cosmic_Terror">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Unholy Cosmic Terror</rdfs:label>
    <ex:hasAnnotation>Cameron Walker English Genre(s) Weird fiction Lovecraftiana Vol 5, Issue 1 date 2020 " " is a short Cthulhu Mythos story by Cameron Walker. Synopsis A veteran NASA mission controller stumbles across evidence of a secret mission involving a previously-unknown planet whilst conducting research for his memoirs. As he digs deeper, he uncovers video footage from a rover sent to explore the new world, which is in fact the Mi-Go colony of Yuggoth . Unfortunately for the man, the mere act of viewing the film catches the attention of the Outer God Nyarlathotep , who then manifests to consume him, body and soul. History "" was published in Vol 5, Issue 1 of the Lovecraftiana zine in 2020.</ex:hasAnnotation>
    <ex:hasAuthorW>Cameron Walker</ex:hasAuthorW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 1</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 5</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Paula_Guran">
    <rdf:type rdf:resource="http://example.org/lovecraft#Critics"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Paula Guran</rdfs:label>
    <ex:hasAnnotation>Multi-award winning american editor and critic, specializing in science fiction, fantasy, and horror . She has worked on numerous publications involving lovecraftian fiction and the cthulhu mythos . Guran has edited more than 50 science fiction, fantasy, and horror anthologies .</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://paulaguran.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bad_Medicine_%28DART_production%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAudioAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Bad Medicine (DART production)</rdfs:label>
    <ex:hasAnnotation>Bad medicine is an audio production by the h. p. lovecraft historical society . It is not a single story but a short anthology of three of lovecraft’s tales . Available in both compact disc and digital download formats, it runs to just over 77 minutes .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#Cool_Air"/>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Picture_in_the_House"/>
    <ex:isBasedOnW>The Facts in the Case of M. Valdemar</ex:isBasedOnW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Of_the_Fittest">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Of the Fittest</rdfs:label>
    <ex:hasAnnotation>Evan Dicken English Simian Publishing Apotheosis: Stories of Human Survival After the Rise of the Elder Gods date October 2015 " " is a short Cthulhu Mythos story by American Evan Dicken . It was published in the Jason Andrew -edited anthology Apotheosis: Stories of Human Survival After the Rise of the Elder Gods in October 2015. Synopsis After serving a compulsory five-year term in Hastur 's Yellow Guard, Sergeant Long returns home to his family in a world wracked by the conflict of warring abominations. He finds his wife and friends have formed a resistance to Hastur's reign, and agrees to help them strike back against an avatar of the Great Old One . However, at the last minute Long gets cold feet, and strikes a bargain with the being: hand over his friends to the Byakhee , and his family will be spared.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Evan_Dicken"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Apotheosis:_Stories_of_Human_Survival_After_the_Rise_of_the_Elder_Gods"/>
    <ex:wasPublishedOnW>October 2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Suck_It_Up,_Get_It_Done">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Suck It Up, Get It Done</rdfs:label>
    <ex:hasAnnotation>Historywas published in the lovecraftian anthology whispers from the abyss by 01publishing in 2013 . It is loosely connected to the cthulhu mythos .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brandon_Barrows"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Whispers_from_the_Abyss"/>
    <ex:wasPublishedOnW>2013</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Up_from_the_Deep">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Up from the Deep</rdfs:label>
    <ex:hasAnnotation>William Meikle English Genre(s) Lovecraftian fiction Release Date May 2023  : Three Lovecraftian Stories is a chapbook collection of Lovecraftian fiction by Scottish-born William Meikle . It was self-published in May 2023, with both paperback and digital editions receiving a release . Overview Contents " Call and Response " " The Hounds of the Dawn " " The Parkland Experiments " Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasGenreW>Lovecraftian fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>May 2023</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_House_in_the_Valley">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The House in the Valley</rdfs:label>
    <ex:hasAnnotation>Full story online here August Derleth United States English Weird Tales date July 1953 𝐓 "" is a short Cthulhu Mythos story by August Derleth , first published in the July 1953 issue of Weird Tales .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
