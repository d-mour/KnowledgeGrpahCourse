    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Clotton</rdfs:label>
    <ex:hasAnnotation>"the horror from the bridge" is a fictional town invented by ramsey campbell . It is part of his severn valley milieu . Only a few leaning red-brick houses remain of the "once-prosperous town"</ex:hasAnnotation>
    <ex:hasTypeL>Town</ex:hasTypeL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Severn_Valley"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Horror_from_the_Bridge"/>
