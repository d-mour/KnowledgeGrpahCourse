    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Middle Ocean</rdfs:label>
    <ex:hasAnnotation>Dreamlands Ocean Notable Features Isles of Nariel First appearance HPL : " The Doom That Came to Sarnath " Created by H. P. Lovecraft The is a fictional body of water created by the late American author H. P. Lovecraft for his 1920 short story " The Doom That Came to Sarnath ". Overview The is an ocean in the Dreamlands where the Isles of Nariel are located. ( HPL : " The Doom That Came to Sarnath ")</ex:hasAnnotation>
    <ex:hasNotableFeatureL rdf:resource="http://example.org/lovecraft#Isles_of_Nariel"/>
    <ex:hasTypeL>Ocean</ex:hasTypeL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Dreamlands"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Doom_That_Came_to_Sarnath"/>
  </rdf:Description>
