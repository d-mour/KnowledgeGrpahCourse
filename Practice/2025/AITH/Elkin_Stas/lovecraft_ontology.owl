  <rdf:Description rdf:about="http://example.org/lovecraft#Black_Sphinx">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Black Sphinx</rdfs:label>
    <ex:hasAffiliationC>Children of the Sphinx .</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Unknown God of the Dead</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The , also known as the unknown god of the dead, is a fictional monster created by h. p. lovecraft for the short story " imprisoned with the pharaohs ", ghostwritten for harry houdini . It is a huge being similar to a sphinx, with an indescribable face . The paws are covered in yellowish fur and have five toes with retractable claws . It is venerated by the sect of</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Imprisoned_with_the_Pharaohs"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Harry_Houdini"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#River_Ai">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>River Ai</rdfs:label>
    <ex:hasAnnotation>Mnar river is a river in the land of mnar . When tribes of wanderers first arrived in mnar they built the cities of thraa , ilarnek , and kadatheron along the river .</ex:hasAnnotation>
    <ex:hasAppearanceL rdf:resource="http://example.org/lovecraft#The_Quest_of_Iranon"/>
    <ex:hasTypeL>River</ex:hasTypeL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Mnar"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Doom_That_Came_to_Sarnath"/>
  </rdf:Description>
