    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Toad-thing</rdfs:label>
    <ex:hasAffiliationC>Outer Gods</ex:hasAffiliationC>
    <ex:hasAnnotation>Sociocultural Characteristics Unknown Outer Gods Real World Information First appearance " The Lurker at the Threshold " Created by Howard Phillips Lovecraft &amp; August Derleth</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Lurker_at_the_Threshold"/>
