    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Regency Cthulhu</rdfs:label>
    <ex:hasAnnotation>Andrew Peregrine Lynne Hardy Cover Artist Riley Spalding English Call of Cthulhu Genre(s) Roleplaying game Chaosium Release Date 2022 224 : Dark Designs in Jane Austen’s England is a period setting supplement for the Call of Cthulhu horror roleplaying game. Written by Andrew Peregrine and Lynne Hardy , and featuring cover art by Riley Spalding, it was published by Chaosium in 2022. Overview Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Andrew_Peregrine"/>
