    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Xalafu</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Great_Old_One"/>
    <ex:hasAlternativeNamesC>The Dread One</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Dread One Great Old One First appearance " The Life and Death of Zebros Santiago " is an extraterrestrial entity manifesting as a mass of globular dark colors with one huge eye.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Death of Zebros Santiago</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>The Life</ex:madeFirstAppearanceOnC>
  </rdf:Description>
