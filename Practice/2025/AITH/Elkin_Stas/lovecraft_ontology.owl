  <rdf:Description rdf:about="http://example.org/lovecraft#Nathicana">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Nathicana</rdfs:label>
    <ex:hasAnnotation>The vagrant date 1927is a narrative poem by h. p. lovecraft . Poem shares themes in common with lovecraft's dreamlands cycle . Set in the pale, mist-covered gardens of zas, a place of beauty and tranquility .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Vagrant"/>
    <ex:wasPublishedOnW>1927</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Thanaroa">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Thanaroa</rdfs:label>
    <ex:hasAlternativeNamesC>Tangaroa (possibly)</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Name recalls that of polynesian creator god tangaroa . Is the primal god worshiped by the murians .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Moon_Pool"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Abraham_Merritt"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Connection">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Connection</rdfs:label>
    <ex:hasAnnotation>Frank Forte English Asylum Press Beyond Lovecraft date September 2020  " " is a Lovecraftian short story by American Frank Forte , first published in his collection Beyond Lovecraft by Asylum Press in September 2020. Synopsis A mad doctor grafts another living human brain onto his own in an effort to make himself stronger, faster and more intelligent: in his words, "the perfect organism". Unfortunately, the original owner of the brain has other ideas, and before his individuality can be absorbed by the superior intellect of the doctor, he destroys the abomination they have both become.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Frank_Forte"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Beyond_Lovecraft"/>
    <ex:wasPublishedOnW>September 2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Stairs_in_the_Crypt">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Stairs in the Crypt</rdfs:label>
    <ex:hasAnnotation>": the history of the necromancer . Avalzaunt" is a horror fantasy short story set in the cthulhu mythos . The story is considered a "posthumous collaboration" between lin carter and clark ashton .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>August 1976</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Hideous_Communion">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Hideous Communion</rdfs:label>
    <ex:hasAnnotation>Carnacki: the lost cases is a short story by james gracey . It is loosely connected to the cthulhu mythos . Occult investigator carnacki is called in to help a grieving couple .</ex:hasAnnotation>
    <ex:hasAuthorW>James Gracey</ex:hasAuthorW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Carnacki:_The_Lost_Cases"/>
    <ex:wasPublishedOnW>June 2016</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Madness_of_Arthur_Malbrey">
    <rdf:type rdf:resource="http://example.org/lovecraft#Crossovers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Madness of Arthur Malbrey</rdfs:label>
    <ex:hasAnnotation>Carnacki is called in to help a friend whose sanity has been taken from him after reading the cursed play the king in yellow . He and another friend attempt to help the man, but he is ultimately carried off to carcosa with his new lord, leaving carnacki befuddled and the other man dead .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brandon_Barrows"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Other Tales of Carnacki</ex:isPublishedAsW>
    <ex:isPublishedAsW>The Castle-Town Tragedy</ex:isPublishedAsW>
    <ex:isPublishedAsW>the Ghost-Finder</ex:isPublishedAsW>
