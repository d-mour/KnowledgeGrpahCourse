    <ex:hasAlternativeNamesL>Realm of Dreams</ex:hasAlternativeNamesL>
    <ex:hasAlternativeNamesL>Realm of Nightmares</ex:hasAlternativeNamesL>
    <ex:hasAnnotation>Also known as r'lyeh limbo realm of dreams realm of nightmares dimension rabbit hole mirror to jabberwocky . Reimagined in 2007 as r'lyeh in its grimm fairy tales comic series and spin-off .</ex:hasAnnotation>
    <ex:hasTypeL rdf:resource="http://example.org/lovecraft#Dimension"/>
