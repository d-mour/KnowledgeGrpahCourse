  <rdf:Description rdf:about="http://example.org/lovecraft#Broadsword">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Broadsword</rdfs:label>
    <ex:hasAnnotation>Short story was first published in the thematic anthology world war cthulhu in 2014 . Appeared in the collection of meikle's own work into the black: tales of lovecraftian terror in 2019 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>War</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>August 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Evil_Dead_2:_Beyond_Dead_by_Dawn">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Evil Dead 2: Beyond Dead by Dawn</rdfs:label>
    <ex:hasAnnotation>Frank Hannah Chris Summers English Space Goat Publications Release Date June 2015 - Nov 2015 Media Type Comic book Beyond Dead by Dawn is a 3-issue mini-series written by Frank Hannah, set in the fictional Evil Dead / Army of Darkness universe. It was published in 2015 by Space Goat Publications. Synopsis Annie Knowby and the cabin (what cabin?) are pulled to Hell. Discovering the souls of her parents, she uses the Necronomicon Ex-Mortis to create a simulacrum of Ash to help her free their souls.</ex:hasAnnotation>
    <ex:hasAuthorW>Frank Hannah</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>June 2015 - Nov 2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Great_Library_of_Celaeno">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Great Library of Celaeno</rdfs:label>
    <ex:hasAnnotation>Library is located on a world orbiting the star celaeno . Contains "books and hieroglyphs stolen from the elder gods"</ex:hasAnnotation>
    <ex:hasAppearanceL>Demonbane Haiyore! Nyaruko-san</ex:hasAppearanceL>
    <ex:isLocatedAtL>Celaeno star system</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_House_on_Curwen_Street"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#King_of_Edom">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>King of Edom</rdfs:label>
    <ex:hasAnnotation>The kings of edom are the survivors of dimensions which ceased to exist eons ago . Their realm is one of utter ruin and anarchy, with no hope or end . The minions of the kings of edom are given one task above all else, which is to free their masters from their prisons .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Olatho%C3%AB">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Olathoë</rdfs:label>
    <ex:hasAnnotation>Polaris is a great fortified city of marble in the far northern kingdom of lomar in the dreamlands . It lies on the plateau of sarkis in a hollow between the mountains noton and kadiphonek . Faces external threats from a horde of ruthless conquerors known as the inutos .</ex:hasAnnotation>
    <ex:hasAppearanceL rdf:resource="http://example.org/lovecraft#At_the_Mountains_of_Madness"/>
    <ex:hasTypeL>City</ex:hasTypeL>
    <ex:isInhabitedByL>Humans</ex:isInhabitedByL>
    <ex:isLocatedAtL>Dreamlands ( Lomar )</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#Polaris"/>
  </rdf:Description>
