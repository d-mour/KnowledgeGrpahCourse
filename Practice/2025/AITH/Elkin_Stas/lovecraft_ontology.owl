    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Character"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mary_Louisa_Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Mary Louisa Lovecraft</rdfs:label>
    <ex:diedOnR>1916</ex:diedOnR>
    <ex:hasAnnotation>Lovecraft’s paternal aunt and wife of Paul Mellon.</ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1855</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nachtw%C3%B6lfe">
    <rdf:type rdf:resource="http://example.org/lovecraft#Cults"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdfs:label>Nachtwölfe</rdfs:label>
    <ex:hasAnnotation>is a fictional organization in the Achtung! Cthulhu pencil-and-paper roleplaying game by Modiphius Entertainment . Background was founded by a former member of the Black Sun, Mina Wolff who wanted to exploit the ancient technology that Black Sun expeditions had discovered but whose leader the sorcerer Weissler was not interested in. She gained the favor of the Führer with a demonstration, and her organization was born. Dedicated to the exploitation of lost technology and using it to create ever more powerful and fearsome machines of war.</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Fedogan_%26_Bremer">
    <rdf:type rdf:resource="http://example.org/lovecraft#Publishers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Fedogan &amp; Bremer</rdfs:label>
    <ex:hasAnnotation>The company takes its name from the two partners' college nicknames . It has published many titles related to the cthulhu mythos and lovecraftian fiction . Launched in 1987, the house won a special world fantasy award in 1998 .</ex:hasAnnotation>
    <ex:hasWebsiteR>https://www.fedoganandbremer.com/</ex:hasWebsiteR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Septimius_Felton">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Septimius Felton</rdfs:label>
    <ex:hasAnnotation>Nathaniel Hawthorne United States English Henry S. King &amp; Co. Publication date 1872 ; or the Elixir of Life , also titled Septimius: A Romance , is a gothic romance novel by the late American Nathaniel Hawthorne , first published posthumously by Henry S. King &amp; Co. In 1872. According to leading scholars S. T. Joshi and David E. Schultz , Lovecraft 's short story " The Dreams in the Witch-House " was "heavily influenced" by the work . References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Nathaniel_Hawthorne"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>1872</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Abbess_of_Erebus">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Abbess of Erebus</rdfs:label>
    <ex:hasAnnotation>David Schütz, II English James Ward Kirk Publishing Lovecraft after Dark date November 2015 " " is a Cthulhu Mythos poem by David Schütz, II. It was published in the James Ward Kirk Publishing thematic anthology Lovecraft after Dark in November 2015. Synopsis The fourteen lines tell of a creature dubbed the Abbess who dwells atop Mount Erebus in Antarctica . This ancient being is the bane of explorers, turning them into Shoggoths .</ex:hasAnnotation>
    <ex:hasAuthorW>David Schütz</ex:hasAuthorW>
    <ex:hasAuthorW>II</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Lovecraft_after_Dark"/>
    <ex:wasPublishedOnW>November 2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Phillip_A._Ellis">
    <rdf:type rdf:resource="http://example.org/lovecraft#Critics"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Scholars"/>
    <rdfs:label>Phillip A. Ellis</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Poet Birth Date 1968 Traralgon, Australia Australian is an Australian poet, critic, scholar and editor who has written a number of pieces on and about the greater Cthulhu Mythos begun with the works of H. P. Lovecraft . These have been seen in publications such as the periodicals Lovecraft Annual , Nightscapes and Dark Legacy , as well as anthologies including Tales of the Cthulhu Mythos: Cthulhu's Creatures . He has stated that H. P. Lovecraft is one of his major influences. Selected Bibliography Editor Lovecraft: An American Allegory (2015) Poems " The Dark Planet " (1999) " Beneath Evil Skies " (1999) "The Call of the Deep" (2000) " Grey skies at dusk fall: " (2006) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#Australia Traralgon</ex:hasBirthplaceR>
    <ex:hasNationalityR>Australian</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Poet</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1968</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Gentleman_from_Angell_Street">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Gentleman from Angell Street</rdfs:label>
    <ex:hasAnnotation>Muriel E. Eddy United States English Genre(s) Non-fiction Arkham House Lovecraft Remembered Date of writing 1961 date November 1998 " " is a short non-fiction piece by the late American and correspondent of H. P. Lovecraft 's, Muriel E. Eddy . Although it was written in 1961, it did not see until its inclusion in the Peter Cannon -edited Arkham House collection Lovecraft Remembered in November 1998. It does not appear to have been reprinted in the years since . References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Muriel_E._Eddy"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Lovecraft_Remembered"/>
    <ex:wasPublishedOnW>November 1998</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>1961</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crispin_Burnham">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Crispin Burnham</rdfs:label>
    <ex:hasAnnotation>14 October 1949 - ?) was a writer of Mythos tales as well as an active editor. He was the founder, writer and publisher of the fanzine Eldritch Tales , and the publisher of Yith Press . He was also a prolific essayist from 1973 to 1995, his final essay being a reflection on the life and career of Robert Bloch . Bibliography Short Fiction "The Thing in the Library" (1974) (with Edward P. Berglund ) "The Moon-God Awakens" (1974) "Demon in the Flesh" (1974) "Things in the Sea" (1974) "Images in Stone" (1975) "The Statement of Richard Landreth" (1975) "Demon Gods Walk Among Us" (1975) "The Vision" (1976) "The Murderer from Harkness" (1976) "A Visit to the Old Farm" (1977) "The Shadow Over Amoston" (1977) "Lurkers Beneath the Depths" (1977) "The Frightened of Llytatoggua" (1978) "Continent Beyond Time" (1978) "Temple of the Demon" (1980) "The Cold" (1982) "They Came From Below" (1982) "Just Outside" (1985) (with Gary A. Braunbeck) "Rotten Meat" (1989) "The Seven Cities of Gold" (1994) "Invocation from Beyond" (1996) " People of the Monolith " (1997) Selected Essays "Godzilla Vs. Cthulhu: What Would Happen if Toho Studios Ever Discovered Lovecraft" (1976) "In Memoriam: Manly Wade Wellman " (1987) " Robert Bloch : 1917-1994" (1995) External Link Summary Bibliography: at Internet Speculative Fiction Database</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ross_E._Lockhart">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Ross E. Lockhart</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Editor United States https://www.haresrocklots.com/ is an American author and editor who has produced a number of works related to the Cthulhu Mythos begun with the writings of Howard Phillips Lovecraft . Working primarily in the fantasy, horror and supernatural genres, he has worked extensively in the small-press industry, and is the founder and editor-in-chief of Word Horde, a speciality publisher. Selected Works Editor The Book of Cthulhu (2011) The Book of Cthulhu II (2012) Cthulhu Fhtagn! (2015) Author " Pick's Ghoul " (2014) External Links at The Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://www.haresrocklots.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Strangeness_of_the_Night">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Strangeness of the Night</rdfs:label>
    <ex:hasAnnotation>Kieran Dacey Boylan English Rogue Planet Press Lovecraftiana Vol 5, Issue 2 date July 2020  " " is a Lovecraftian poem by Australian Kieran Dacey Boylan . It was published in Vol 5, Issue 2 of Lovecraftiana by Rogue Planet Press in July 2020. Synopsis The two eight-line verses describe how the narrator one night has a strange experience that not all may be as it seems in the world.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Kieran_Dacey_Boylan"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 2</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 5</ex:isPublishedAsW>
    <ex:wasPublishedOnW>July 2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Keeper_Tips:_Collected_Wisdom_on_Running_Games">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Keeper Tips: Collected Wisdom on Running Games</rdfs:label>
    <ex:hasAnnotation>Various Simon Bray Andrey Fetisov United States English Call of Cthulhu Genre(s) Roleplaying games Chaosium Release Date 2021 113 is a gaming aid written for the horror roleplaying game Call of Cthulhu , but whose principles can be applied across a wide range of games. Published by Chaosium in 2021, it was written by an ensemble of contributors, including Scott David Aniolowski , Sean Branney , Allen Carey, Keris McDonald, Jason Durall, Paul Fricker , Bob Geis, Lynne Hardy , Bridgett Jeffries, Jo Kriel, David Larkins, Mike Mason , Mark Morrison, Thom Raley, Mathew Sanderson, Becca Scott, and Seth Skorkowsky . Overview Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Roleplaying games</ex:hasGenreW>
    <ex:hasPageCountW>113</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2021</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Goblin_Entity">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Goblin Entity</rdfs:label>
    <ex:hasAnnotation>The is an eldritch demonic cosmic entity and cosmic horror element in the fictional universe (earth-1298) of marvel by marvel comics . It is an insatiably hungry entity, which like the phoenix force possesses limitless power . The entity has consumed entire galaxies, and when confronted by the phoenix force, it consumed it too .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#France">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>France</rdfs:label>
    <ex:hasAnnotation>French history traces back to 507, when the merovingian dynasty of franks took over the province of gaul from the collapsing roman empire . Established itself as one of the great powers of europe, under leaders from charlemagne to napoleon . Had a bitter rivalry with england that lasted centuries, but found itself on the side of england in two world wars .</ex:hasAnnotation>
    <ex:hasTypeL>Country</ex:hasTypeL>
    <ex:isLocatedAtL>Western Europe</ex:isLocatedAtL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mwanu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Mwanu</rdfs:label>
    <ex:hasAffiliationC>Kaliri tribe</ex:hasAffiliationC>
    <ex:hasAnnotation>Congo, Africa Tribal chief Kaliri tribe Human First appearance HPL : " Facts Concerning the Late Arthur Jermyn and His Family " Created by H. P. Lovecraft is the chief of the Kaliri , a fictional tribe in the Congo region of Africa. When Arthur Jermyn mounted an expedition to Africa to investigate his own ancestry, provided him with valuable information. This included the lore pertaining to a ruined jungle city that was once inhabited by a race of white apes until these beings were wiped out by the N'bangu tribe. ( HPL : " Facts Concerning the Late Arthur Jermyn and His Family ")</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Facts Concerning the Late Arthur Jermyn</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>His Family</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Relic_In_The_Egyptian_Gallery">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Relic In The Egyptian Gallery</rdfs:label>
    <ex:hasAnnotation>Historywas first published in the collection &amp; more tales of the cthulhu mythos in 2017 . It was also included in horrors &amp; abominations: 24 tales of the cthulhu mythos in december 2018 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mark_McLaughlin"/>
    <ex:hasAuthorW>Michael Sheehan. Jr.</ex:hasAuthorW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>More Tales Of The Cthulhu Mythos</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Poetry_and_the_Gods">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Poetry and the Gods</rdfs:label>
    <ex:hasAnnotation>The streetcelephas is a short story by horror writer and poet h. p. lovecraft in collaboration with writer anna helen crofts . The narrative follows the dream-voyage of marcia, a young woman filled with weariness of the mundane world and all her woes . She resolves to ease her troubled soul by reading a magazine of poetry . As she does, the greek god hermes appears and bears marcia to the court of zeus and the olympians</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Anna_Helen_Crofts"/>
    <ex:hasAuthorW>H. P. Lovecraft (as Henry Paget-Lowe)</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Fantasy short story</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ctoggha">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Ctoggha</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Dream Daemon</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Dream Daemon Great Old Ones First appearance EXP : "Die Goldenen Hände Suc'naaths" Created by Peter Schott (The Dream-Daemon) is a mysterious Great Old One as there is little to nothing known about him. It is likely that he has some connection to dreams or the Dreamlands . Gallery</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Die Goldenen Hände Suc'naaths</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Peter Schott</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Death_Is_an_Elephant">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Death Is an Elephant</rdfs:label>
    <ex:hasAnnotation>A horror short story by robert bloch, first published in the february 1939 issue of weird tales . It is the second story in the stellar brothers circus series, following "fangs of vengeance" as with "fangs of vengeance", it incorporates elements from the cthulhu mythos .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_Bloch"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>February 1939</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Arkham_Horror_Third_Edition">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Arkham Horror Third Edition</rdfs:label>
    <ex:hasAnnotation>Core Set Nikki Valens Richard Launius Kevin Wilson Fantasy Flight Games Publication Date 2018 Board game Arkham Horror The Core Set is the second set of revised rules released for the Arkham Horror board game first released by Chaosium in 1987. Designed by Nikki Valens , Richard Launius , and Kevin Wilson , it was released by Fantasy Flight Games in 2018 . This new edition marks a dramatic departure from the original rules with the regards to the board layout: whereas earlier editions used a static, pre-planned board, the third edition uses hexagonal tiles, placed adjacent to each other, to create a dynamic layout which changes from game to game. Overview Gallery References</ex:hasAnnotation>
    <ex:wasPublishedOnW>2018</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Arkham_Horror">
    <rdf:type rdf:resource="http://example.org/lovecraft#ArkhamHorror"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Arkham Horror</rdfs:label>
    <ex:hasAnnotation>First edition was published by chaosium, with subsequent editions being developed and released by fantasy flight games . All versions involve a group of up to six players each taking control of one or more characters . Victory is achieved by closing all active portals on the board before a certain number of portals have opened . Second edition saw the changing from chaosium to fantasy flight games, and while it retained many of the features, was given a fairly major overhaul .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Kevin_Wilson"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Nikki_Valens"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Richard_Launius"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Action Adventure</ex:hasGenreW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#wasDestroyedOnA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>wasDestroyedOnA</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/lovecraft#Artefact"/>
