    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Crawling One</rdfs:label>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#Worm_that_Walks"/>
    <ex:hasAlternativeNamesC>Dark Ones</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Walking Corruptions</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Writhing Ones</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>A is a fictional race developed by chaosium for their call of cthulhu horror roleplaying game . Despite their ghastly appearance, a is not undead, for the worms that compose its form are living creatures . The "ingested" will of the wizard effectively drives the mass to work its malign intent .</ex:hasAnnotation>
    <ex:hasDistinctionC>Entities composed of thousand of worms</ex:hasDistinctionC>
    <ex:hasDistinctionC>each individually alive yet collectively forming a consciousness</ex:hasDistinctionC>
    <ex:hasDistinctionC>insects</ex:hasDistinctionC>
    <ex:hasDistinctionC>maggots</ex:hasDistinctionC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Festival"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
