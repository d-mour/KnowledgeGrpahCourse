  <rdf:Description rdf:about="http://example.org/lovecraft#Crypt_of_Cthulhu_St._Johns_Eve_1982">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crypt of Cthulhu St. John's Eve 1982</rdfs:label>
    <ex:hasAnnotation>Crypt of cthulhu was the sixth issue of the long-running fanzine . Edited by price, it featured cover art by jason c. eckhardt . It was self-published in june 1982 .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>44</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu"/>
    <ex:wasReleasedOnW>June 1982</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dagon_June-August_1989">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dagon June-August 1989</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Jeff Salmon United Kingdom English Dagon Press Release Date June 1989 58 was the twenty-fifth issue of the now-defunct Lovecraftian fanzine Dagon . It was edited by the late British and occasional Carl T. Ford . Contents "The Book of Jade" by Mark Valentine "Requiem" by David Park Barnitz "Sombre Sonnet" by David Park Barnitz "Mad Sonnet" by David Park Barnitz "Sonnet of the Instruments of Death" by David Park Barnitz "Corpse" by David Park Barnitz "The Mysteries of the Abyss" by Mark F. Samuels "On, to the Dark Port" by T. Winter-Damon "Blow Lamps and Wicked Milk: An Interview with Karl Edward Wagner" interview of Karl Edward Wagner by Carl T. Ford</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>58</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>June 1989</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mirror_Fishing">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Mirror Fishing</rdfs:label>
    <ex:hasAnnotation>The children of gla'aki is a short story by american author john langan . It was published in the dark regions press thematic anthology the children of gla'aki in 2017 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#John_Langan"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Children_of_Glaaki"/>
    <ex:wasPublishedOnW>2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mike_Davis">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Mike Davis</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Editor Author https://lovecraftzine.com/ is an editor, podcaster and occasional author whose works centre on weird fiction in general and the Cthulhu Mythos in particular. He is the founder of The Lovecraft eZine digital magazine and weekly podcast, which he has run since 2011. Selected Works Periodicals The Lovecraft eZine (2011-2016) Anthologies The Lovecraft eZine Presents Making the Cut (2014) Autumn Cthulhu (2016) Short Fiction " I Am the Key " (2012) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasWebsiteR>https://lovecraftzine.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Summer_of_Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Summer of Lovecraft</rdfs:label>
    <ex:hasAnnotation>Various English Genre(s) Horror Dark Regions Press Release Date September 2019 318 : Cosmic Horror in the 1960s is an anthology edited by Brian M. Sammons and Glynn Owen Barrass , published by Dark Regions Press in 2019, featuring a collection of stories that explore the zeitgeist of the late 1960s through the lens of Lovecraftian /cosmic horror. Contents: "Night Trippers" by Lois H. Gresh "Being for the Benefit of Mr. Sullivan" by Lee Clark Zumpe "Dreamland" by David Dunwoody "Lost In the Poppy-Fields of Flesh" by Konstantine Paradias "Five To One" by Edward M. Erdelac "Keeping the Faith" by Sam Stone "Mud Men" by Sean Hoade "Misconception" by Jamie D. Jenkins "No Colors Anymore" by Joe L. Murr "Operation Alice" by Peter Rawlik "Shimmer and Sway" by Jayaprakash Satyamurthy "Short Wave" by Stephen Mark Rainey "The Song that Crystal Sang" by Tom Lynch "Through a Looking Glass Darkly" by Glynn Owen Barrass and Brian M. Sammons "The Color from the Deep" by William Meikle "The Long Fine Flash" by Edward Morris "The Summer of Love" by C.J. Henderson "Just Another Afternoon in Arkham, Brought to You in Living Color" by Mark McLaughlin and Michael Sheehan, Jr. "Crystal Blue Persuasion" by Jeffrey Thomas</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>318</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>September 2019</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Bullet_and_the_Flesh">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Bullet and the Flesh</rdfs:label>
    <ex:hasAnnotation>A pair of covert-operations soldiers must deal with a despotic colonel, child soldiers, and a rampaging dark young of shub-niggurath in the remote scrublands of zimbabwe . It features major harrison peel , a recurrent character in conyers' mythos fiction .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#David_Conyers"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#David_Kernot"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>War</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_House_on_Curwen_Street">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The House on Curwen Street</rdfs:label>
    <ex:hasAnnotation>August Derleth United States English The Trail of Cthulhu Weird Tales date March 1944 Next → " The Watcher from the Sky " 𝐓 " " is a short story which forms part of August Derleth 's The Trail of Cthulhu , and is the first in the . Synopsis To be added Characters Laban Shrewsbury Andrew Phelan Timoto Fernandez Deep Ones History "" first saw in the March 1944 edition of Weird Tales as "The Trail of Cthulhu". It was later reprinted by Arkham House in the collection The Trail of Cthulhu in 1962, and has since been seen in numerous collections and translated versions.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Trail_of_Cthulhu"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>March 1944</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Conan:_Adventures_in_an_Age_Undreamed_Of">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Conan: Adventures in an Age Undreamed Of</rdfs:label>
    <ex:hasAnnotation>The world of conan is set 500 years before the end of the hyborian age . It is based on the universe created by robert e. howard . The game incorporates the cthulhu mythos , mostly in the background .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Chris_Birch"/>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Fantasy</ex:hasGenreW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
