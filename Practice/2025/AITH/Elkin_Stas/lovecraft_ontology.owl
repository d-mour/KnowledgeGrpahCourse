    <ex:wasPublishedOnW>2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cimmeria">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Cimmeria</rdfs:label>
    <ex:hasAnnotation>Modern-day Western Europe Region End of the Hyborian Age Conan Created by Robert E. Howard is a fictional land created by the late American author Robert E. Howard for his Conan series of sword-and-sorcery stories. Overview Located in the area occupied by the British Isles in the modern age, played host to the antecedent clans of the Gaelic peoples, and was the birthplace of mighty Conan himself. During the cataclysm which ended the Hyborian Age , the majority of sunk beneath the waves, all that remaining being the mountaintops which now form the various landmasses of Britain. Behind the Mythos appears to take its name from Greek mythology, which mentions the Cimmerians as a northern people who spend their lives in a mist-enshrouded realm near the Land of the Dead. Alternatively, it may have been derived from the Cimmerians, an ancient people active in the Crimea in the 8th and 7th century BC.</ex:hasAnnotation>
    <ex:hasTypeL>Region</ex:hasTypeL>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#Conan"/>
    <ex:isLocatedAtL>Modern-day Western Europe</ex:isLocatedAtL>
    <ex:wasDestroyedOnL>End of the Hyborian Age</ex:wasDestroyedOnL>
  </rdf:Description>
