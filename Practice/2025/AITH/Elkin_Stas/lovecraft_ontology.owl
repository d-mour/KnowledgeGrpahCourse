  <rdf:Description rdf:about="http://example.org/lovecraft#George_Gammell_Angell">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>George Gammell Angell</rdfs:label>
    <ex:ceasedOnC>1926 November 23</ex:ceasedOnC>
    <ex:hasAffiliationC>American Archaelogical Society</ex:hasAffiliationC>
    <ex:hasAnnotation>"angel" is a fictional character created by h. p. lovecraft . He makes his first appearance in the 1928 short story " the call of cthulhu " he is professor emeritus of semitic languages at brown university . At the time of his death, at age 92, he was a childless widower .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Call_of_Cthulhu"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Jonathan_Sharp">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Jonathan Sharp</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Weird fiction Years Active 2006 - 2015  is an author who has written a handful of stories set in the Cthulhu Mythos which originated in the writings of Howard Phillips Lovecraft . His stories have appeared in the anthologies Hardboiled Cthulhu: Two-Fisted Tales of Tentacled Terror (2006), Whispers from the Abyss (2014), and Whispers from the Abyss Vol. 2: The Horrors That Are &amp; Shall Be (2015). Selected Bibliography "The White Mountains" (2006) " Nation of Disease: The Rise &amp; Fall of a Canadian Legend " (2014) " Skoptsy " (2015)</ex:hasAnnotation>
    <ex:hasYearsActiveR>2006 - 2015</ex:hasYearsActiveR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Spike">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Spike</rdfs:label>
    <ex:hasAnnotation>The children of gla'aki was first published in the thematic anthology the children of gla'aki by dark regions press in 2017 . It was later included in the collection of jones' own works shout kill revel repeat in 2019 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Scott_R._Jones"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
