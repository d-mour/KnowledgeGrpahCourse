  <rdf:Description rdf:about="http://example.org/lovecraft#Miskatonic_University:_Elder_Gods_101">
    <rdf:type rdf:resource="http://example.org/lovecraft#CrossroadPress"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Miskatonic University: Elder Gods 101</rdfs:label>
    <ex:hasAnnotation>August 15, 2022 is a cthulhu mythos novel by american and editor matthew davenport and his brother michael davenport . It is tied to matthew's andrew doran but with a new cast and set during the present day . The staff of miskatonic university summon a fresh crop of students that are all tied to the most famous characters of hp lovecraft .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Matthew_Davenport"/>
    <ex:hasAuthorW>Michael Davenport</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Urban Fantasy</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Scion Series</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2022 August 15</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Arkham_Gazette">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdfs:label>Arkham Gazette</rdfs:label>
    <ex:hasAnnotation>The is a fictional newspaper created by h. p. lovecraft for his cthulhu mythos stories . It plays no appreciable part in his stories, but later authors have included it in their works .</ex:hasAnnotation>
    <ex:hasTypeO>Newspaper</ex:hasTypeO>
    <ex:isLocatedAtO rdf:resource="http://example.org/lovecraft#Arkham"/>
    <ex:isLocatedAtO rdf:resource="http://example.org/lovecraft#Massachusetts"/>
    <ex:wasCreatedBynO rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Long_Road_Home">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Long Road Home</rdfs:label>
    <ex:hasAnnotation>James Kuhoric, Mike Raicht Fernando Blanco English Dynamite Entertainment Release Date Jan 2008 - April 2008 Media Type Comic book is a 4-issue story arc written in 2008 by James Kuhoric and Mike Raicht which appeared in issues #5-8 of the 2nd volume of the Army of Darkness by Dynamite Entertainment. Synopsis In the aftermath of their battle with Evil Ash Prime, Ash and Sheila attempt to repair the world only to have to face a new threat, the Four Horsemen of the Apocalypse, who have been summoned by the Deadites .</ex:hasAnnotation>
    <ex:hasAuthorW>James Kuhoric</ex:hasAuthorW>
    <ex:hasAuthorW>Mike Raicht</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>Jan 2008 - April 2008</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#An_Epicure_in_the_Terrible:_A_Centennial_Anthology_of_Essays_in_Honor_of_H._P._Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>An Epicure in the Terrible: A Centennial Anthology of Essays in Honor of H. P. Lovecraft</rdfs:label>
    <ex:hasAnnotation>380 (revised edition) is a non-fiction collection edited by s. t. joshi and david e. schultz . Contains thirteen essays on a range of topics from lovecraft's life, career, works and legacy . 380 (revised edition) was released by hippocampus press in june 2011 .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:hasPageCountW>347 380</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>December 2010 August 1991</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Strange_Tales">
    <rdf:type rdf:resource="http://example.org/lovecraft#PulpMagazines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Strange Tales</rdfs:label>
    <ex:hasAnnotation>English Irregular September 1931 Final Publication September 2007 of Mystery and Terror was a pulp magazine launched in 1931 by Clayton Publishing to publish supernatural fiction; it was one of the main competitors to Weird Tales . It published stories by Robert E. Howard , Clark Ashton Smith , and August Derleth before folding with Clayton's bankruptcy in 1933. It was briefly revived in the 21st century by Wildside Press , which published three issues under the editorship of Robert M. Price between 2003 and 2007. Selected Stories to First Appear in " The Return of the Sorcerer " (September 1931), by Clark Ashton Smith " The Door to Saturn " (January 1932), by Clark Ashton Smith " The Trap " (March 1932), by H. P. Lovecraft and Henry S. Whitehead " The Nameless Offspring " (June 1932), by Clark Ashton Smith " The Thing That Walked on the Wind " (January 1933), by August Derleth</ex:hasAnnotation>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#H._P._Lovecraft:_A_Critical_Study">
