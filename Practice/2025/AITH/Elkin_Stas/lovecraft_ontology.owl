    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2011 December 6</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Monsters_in_the_Bush">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Monsters in the Bush</rdfs:label>
    <ex:hasAnnotation>David Rose United States English Screaming Banshee Press Release Date December 2023 143 : Lovecraftian Military Tales is a collection of Lovecraftian fiction by American and former marine David Rose . Published by Screaming Banshee Press in December 2023 , it was released in paperback and digitally through Amazon's Kindle platform; the digital edition has since been removed from their library. Overview Contents "The Shadow Over Onslow Beach" "The Brothers Khalid" "LZ Rep Disrupted" "Rejection Notice" "" "Lovecraft in Lockup" "Magic and the Desert" Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#David_Rose"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>143</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>December 2023</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Feaster_from_Afar">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Feaster from Afar</rdfs:label>
    <ex:hasAnnotation>Full story online here Ron Shiflet United States English Publication date August 1999 " " is a short poem by American Ron Shiflet . Synopsis The two verses in fourteen lines describe the dark horror of , which is in fact an avatar of the Great Old One Hastur . Publication History "" was published in E. P. Berglund 's online fanzine Nightscapes in August 1999.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>August 1999</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Smiling_People">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Smiling People</rdfs:label>
    <ex:hasAnnotation>Andrew Peregrine English Simian Publishing Apotheosis: Stories of Human Survival After the Rise of the Elder Gods date October 2015 " " is a Lovecraftian short story by Andrew Peregrine . It was published in the Jason Andrew -edited thematic anthology Apotheosis: Stories of Human Survival After the Rise of the Elder Gods by Simian Publishing in October 2015. Synopsis In a dystopian future city in which the human race is forced to perform soul-destroying tasks of drudgery under the watchful eyes of their new overlords, the titular Smiling People, one man attempts to find a degree of happiness with his co-worker. When this fails and he invokes the wrath of their masters, he attempts to escape the city, only to be confronted with a shocking revelation: care nothing for their subjects or their misery, and only watch them as a form of entertainment.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Andrew_Peregrine"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Apotheosis:_Stories_of_Human_Survival_After_the_Rise_of_the_Elder_Gods"/>
    <ex:wasPublishedOnW>October 2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shard_of_Panestes">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MysticalArtefacts"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Shard of Panestes</rdfs:label>
    <ex:hasAnnotation>The shard was an artefact which appeared in peter j. evans' 2013 novel feeders from within . It was utilised in ancient greece as a protective talisman by a man named paenoestes, an athenian scholar . The alien mr. stone then once again pieced it back together before using it as a device to shield himself and his acolytes .</ex:hasAnnotation>
    <ex:hasTypeA>Occult Artefact</ex:hasTypeA>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#Feeders_from_Within"/>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#Peter_J._Evans"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nightscapes">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Nightscapes</rdfs:label>
    <ex:hasAnnotation>Edward P. Berglund Edward P. Berglund English June 1997 Final Publication October 2006 http://www.epberglund.com/RGttCM//nsindex.htm was a relatively long-running online fanzine dedicated to the Cthulhu Mythos inspired by the works of H. P. Lovecraft . Overview Edited by noted Mythos author and scholar Edward P. Berglund , contained a mix of stories and poetry from both established authors and up-and-comers. Running for seventeen issues between June 1997 and December 2006 -- with a three-year gap before the final two issues -- it is now defunct, although the back issues are still hosted for free on the . Issues 1997 June August September October December 1998 January April July September 1999 March August December 2000 May 2001 August 2003 May 2006 October December</ex:hasAnnotation>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#At_the_Mountains_of_Madness:_A_Graphic_Novel">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>At the Mountains of Madness: A Graphic Novel</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft I. N. J. Culbard Cover Artist I. N. J. Culbard SelfMadeHero Release Date October 2010 is an adaptation of H. P. Lovecraft 's 1936 novella of the same name . It was illustrated by I. N. J. Culbard , who won the British Fantasy Award for the project, and published by SelfMadeHero in 2010. Since then it has also been translated into several languages for overseas markets. Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasReleasedOnW>October 2010</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Fuller_Memorandum">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Fuller Memorandum</rdfs:label>
    <ex:hasAnnotation>The title is inspired by the quiller memorandum (originally the berlin memorandum), a 1965 spy novel by elleston trevor (writing as adam hall) the fuller referred to in the title is major-general j. f. c. fuller, a historical figure who was an influential popularizer of military doctrine .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Charles_Stross"/>
    <ex:hasPageCountW>312</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Laundry_Files"/>
    <ex:wasReleasedOnW>2010</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dunwich_Cycle">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dunwich Cycle</rdfs:label>
    <ex:hasAnnotation>Robert M. Price , editor Cthulhu Cycle Genre(s) Cthulhu Mythos Chaosium Release Date 1995 252 : Where the Old Gods wait is a Cthulhu Mythos anthology edited by Robert M. Price and published by Chaosium in 1995, part of its Cthulhu Cycle . It includes the H. P. Lovecraft story "The Dunwich Horror" , two stories by Arthur Machen that inspired Lovecraft, and seven stories that take up where Lovecraft's story left off. Price, the editor, wrote or co-wrote three of the seven sequel tales, along with an introductory essay. Contents "What Roodmas Horror" by Robert M. Price " The Great God Pan " by Arthur Machen (1894) " The White People " by Arthur Machen (1904) " The Dunwich Horror " by H. P. Lovecraft (1929) " The Shuttered Room " by August Derleth " The Round Tower (Being the Narrative of Armitage Harper) " by Robert M. Price (1990) " The Devil's Hop Yard " by Richard A. Lupoff (1978) " The Road to Dunwich " by Ben P. Indick (1984) " The Tree-House " by Robert M. Price and W. H. Pugmire (1995) " You Can't Take It with You " by C. J. Henderson (1987) " Wilbur Whateley Waiting " by Robert M. Price (1987)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
    <ex:hasAuthorW>editor</ex:hasAuthorW>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasPageCountW>252</ex:hasPageCountW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Cthulhu_Cycle"/>
    <ex:wasReleasedOnW>1995</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#George_Barnaby">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>George Barnaby</rdfs:label>
    <ex:hasAlternativeNamesC>The Lawyer</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The lawyer is a character created by fantasy flight games for their arkham horror files range of cthulhu mythos-related content . He was originally conceived as an investigator character for the innsmouth horror expansion to arkham horror second edition . He was also included as a playable character in the similar eldritch horror board game .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Eldritch_Horror"/>
    <ex:hasCharacterMateC>Maria Barnaby (wife</ex:hasCharacterMateC>
    <ex:hasCharacterMateC>deceased)</ex:hasCharacterMateC>
    <ex:madeFirstAppearanceOnC>Innsmouth Horror Deluxe Expansion</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Fantasy_Flight_Games"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cloud_of_Darkness">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Cloud of Darkness</rdfs:label>
    <ex:hasAnnotation>The is a lovecraftian-like entity in the fictional universe of the final fantasy video game franchise . Appears as a humanoid female with sentient tentacles who possesses vast black magical powers . In battle wields lightning and particle beams, among other things .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Howard_Lovecraft_and_the_Undersea_Kingdom">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Howard Lovecraft and the Undersea Kingdom</rdfs:label>
    <ex:hasAnnotation>Preceded by howard lovecraft and the frozen kingdom followed by howard lovecraft and the kingdom of madness is a graphic novel published by arcana studio . Written by bruce brown and dwight l. mcpherson with artwork by thomas boatwright .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Bruce_Brown"/>
    <ex:hasAuthorW>Dwight L. McPherson</ex:hasAuthorW>
    <ex:hasPageCountW>66</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Howard Lovecraft</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>May 2012</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cryptic_Events_Evaluation_Section">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdfs:label>Cryptic Events Evaluation Section</rdfs:label>
    <ex:hasAlternativeNamesO>Cryptic Events Evaluation Taskforce</ex:hasAlternativeNamesO>
    <ex:hasAnnotation>General Information Also known as Cryptic Events Evaluation Taskforce Government agency Security service United States Real World Information First appearance " To Clear the Earth " Created by Will Murray The , also known as the Cryptic Events Evaluation Taskforce , is a fictional secret government organization created by writer Will Murray as a backdrop for his Cthulhu Mythos stories. Depicted as part of the real world's National Reconnaissance Office, the CEES is tasked with investigating "events"--"any unexplained or unclassifiable phenomenon" --often using paranormal means. Murray's stories that feature the CEES form a loosely connected series. He introduced the organization in the story " To Clear the Earth " (1994). Behind the Mythos Murray explained the creation of the CEES (or CEET) in the introduction to the first volume of The Wild Adventures of Cthulhu : Murray notes that CEES agents tend to have short lifespans, both in-universe and as fictional characters: Appearances " To Clear the Earth " (1994) "Rude Awakening" (1995) " The Sothis Radiant " (1996) " The Eldridge Collection " (2003) "What Brings the Void" (2010) "The Hour of Our Triumph" (2011) "Dark Redeemer" (2015) " Static " (2015) "A Trillion Young" (2017) "God General Nakji" (2021) "The Wild Ones of Weirport" (2022) References</ex:hasAnnotation>
    <ex:hasPurposeO>Security service</ex:hasPurposeO>
    <ex:hasTypeO>Government agency</ex:hasTypeO>
    <ex:isLocatedAtO>United States</ex:isLocatedAtO>
    <ex:wasCreatedBynO rdf:resource="http://example.org/lovecraft#Will_Murray"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Uralte_Schrecken">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Uralte Schrecken</rdfs:label>
    <ex:hasAlternativeNamesA>Ancient Horrors</ex:hasAlternativeNamesA>
    <ex:hasAnnotation>Also known as Ancient Horrors Graf Eric von Könnenberg Germany German Genre(s) Religious Occult Philosophy Real World Information Created by Walter C. DeBill Jr. is a treatise on ancient religious cults by the mysterious Graf Eric von Könnenberg . Written in German, c.1850. It relates the myth of Yidhra and Ngyr-Khorath , among others, concentrating heavily on the master creature Mlandoth ( ADJ : " The Bookseller's Second Wife ", Walter C. DeBill, Jr. )</ex:hasAnnotation>
    <ex:wasCreatedByA>Walter C. DeBill Jr.</ex:wasCreatedByA>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Xothic_Legend_Cycle">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#StoryCycles"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Xothic Legend Cycle</rdfs:label>
    <ex:hasAnnotation>The cycle is centered on a trinity of deities said to be the "sons" of cthulhu . The stories are " the dweller in the tomb " (1971), " out of the ages " (1975), " the horror in the gallery " (1976), " the thing in the pit " (1980) and " the winfield heritance " (1981) all these stories are to be found collected, with others, in the 1997 collection .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#An_Exchange_of_Souls_and_Lazarus">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>An Exchange of Souls and Lazarus</rdfs:label>
    <ex:hasAnnotation>Barry Pain Henri Béraud United States English Lovecraft's Library Hippocampus Press Release Date May 2007 224 is an omnibus which collects the novels An Exchange of Souls (1911, Barry Pain ) and Lazarus (1924, Henri Béraud ), stories which have been cited as inspirations for H. P. Lovecraft ’s " The Thing on the Doorstep " and The Shadow Out of Time , respectively. It was published by Hippocampus Press in May 2007 in a paperback format . Overview Contents An Exchange of Souls (1924, Barry Pain ) Lazarus (1911, Henri Béraud ) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Barry_Pain"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Henri_B%C3%A9raud"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>224</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Lovecraft's Library</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>May 2007</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#City_Below_the_Seas">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsOriginatingFromMythosInspiredWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>City Below the Seas</rdfs:label>
    <ex:hasAnnotation>The is an eldritch city lying in the seabed under the pacific ocean . It's where the undergod uluath slumbers and it's inhabited by fishmen . The chants of the happyology cult summoned it to the surface .</ex:hasAnnotation>
    <ex:hasTypeL>Aquatic city</ex:hasTypeL>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#Uluath"/>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Pacific_Ocean"/>
    <ex:madeFirstAppearanceOnL>Monsters Unleashed Vol 3 10</ex:madeFirstAppearanceOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crypt_of_Cthulhu_St._Johns_Eve_1989">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crypt of Cthulhu St. John's Eve 1989</rdfs:label>
    <ex:hasAnnotation>Various Bruce W. Timm Cover Artist Darrel Tutchton United States English Cryptic Publications Release Date June 1989 52 Preceded by Roodmas 1989 Followed by Lammas 1989 is the 65th issue of Robert M. Price 's long-running fanzine Crypt of Cthulhu . Edited by Price with cover art by Darrel Tutchton and interior work by Bruce W. Timm, it ran to 52 in an A5 format and was published by Cryptic Publications in June 1989. Contents Editorial Shards by Robert M. Price "The Gibbering Walls" by Eddy C. Bertin "The Voice in the Bones" by Thomas Ligotti "Surrealism and H. P. Lovecraft" by John Brower "The Bart House Paperbacks" by David E. Schultz "Wilbur Whateley" by Marie Lazzari "I Saw The Whisperer in Darkness" by Will Murray "Problem Child" by Darrell Schweitzer "Analects from the Mainstream #2: Of Machen and Henry Miller: Or, Anais, Meet Arthur" by Don Herron "Fun Guys from Yuggoth" by Eddy C. Bertin Reviews by Stefan Dziemianowicz Letters by Richard L. Tierney , by Henry James, by Kevin A. Ross , R. A. W. Lowndes , T. E. D. Klein , Susan Michaud, Stefan R. Dziemianowicz , Dan Gobbett, Wilum Pugmire , and Marie Lazari</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>52</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>June 1989</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Necronomicon">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Necronomicon</rdfs:label>
    <ex:hasAlternativeNamesA>Kitab al-Azif</ex:hasAlternativeNamesA>
    <ex:hasAnnotation>The is the archetypal book of forbidden knowledge whose contents threaten one's sanity . It was written in damascus in the early 8th century by a "mad poet" from sanaa in yemen . It was translated into greek in 950 ce by theodorus philetas of constantinople, who gave it the title .</ex:hasAnnotation>
    <ex:hasAppearanceA>The Festival The Descendant The Case of Charles Dexter Ward The Last Test History of the Necronomicon The Dunwich Horror Medusa's Coil The Whisperer in Darkness At the Mountains of Madness The Dreams in the Witch-House The Horror in the Museum Through the Gates of the Silver Key Out of the Aeons The Thing on the Doorstep The Shadow Out of Time The Diary of Alonzo Typer The Haunter of the Dark The Nameless Offspring The Shambler from the Stars The Salem Horror The Abyss The Shadow from the Steeple The Fishers from Outside Necronomicon: Book of the Dead Demonbane</ex:hasAppearanceA>
    <ex:madeFirstAppearanceOnA>The Hound</ex:madeFirstAppearanceOnA>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Necronomicon/Quotes">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Necronomicon/Quotes</rdfs:label>
    <ex:hasAnnotation>This is the page for quotes attributed to the Necronomicon and its many translations. Lovecraft's Work Circle Works Expanded Mythos Works Unsourced</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kn-yan">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>K'n-yan</rdfs:label>
    <ex:hasAccessibilityL>A mound near Binger</ex:hasAccessibilityL>
    <ex:hasAccessibilityL>A tunnel near the Pecos Pueblo villages</ex:hasAccessibilityL>
    <ex:hasAlternativeNamesL>Xinaián</ex:hasAlternativeNamesL>
    <ex:hasAnnotation>The mound is a fictional subterranean realm created by h. p. lovecraft in the revision tale the mound . It is depicted as a vast underground nation under a "sky" of glowing blue clouds similar to the northern lights . It is occupied by a hidden race of prehistoric humanoids who sealed themselves away from the rest of the world at some time after the sinking of mu .</ex:hasAnnotation>
    <ex:hasAppearanceL>The Whisperer in Darkness Out of the Aeons</ex:hasAppearanceL>
    <ex:isInhabitedByL>K'nyanians</ex:isInhabitedByL>
    <ex:isLocatedAtL>Under Oklahoma</ex:isLocatedAtL>
    <ex:isLocatedAtL>United States</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Mound"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#In_the_Shadow_of_Swords">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>In the Shadow of Swords</rdfs:label>
    <ex:hasAnnotation>The story's setting is shared by goodfellow's novels . It takes as a background assumption that saddam was concealing weapons of mass destruction . The story was first published as a chapbook in 2002 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Cody_Goodfellow"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>2002</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bhlemphroim">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Bhlemphroim</rdfs:label>
    <ex:hasAnnotation>Hairless humanoid beings roughly the same size as a human . First appeared in clark ashton smith's 1932 short story " the door to saturn " they are indigenous to the planet cykranosh .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Door_to_Saturn"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Celaeno_%28star%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Stars"/>
    <rdfs:label>Celaeno (star)</rdfs:label>
    <ex:hasAnnotation>Celaeno is one of the stars of the pleiades, between alcyone and electra on one side, and maia and taygeta on the other . The name comes from greek mythology, where celaeno was one of the seven pleiades, daughter of the titan atlas and the ocean nymph pleion . August derleth took up the name and put it in its astronomical sense in the mythos .</ex:hasAnnotation>
    <ex:hasNotableFeatureL>The Fourth Planet</ex:hasNotableFeatureL>
    <ex:hasNotableFeatureL>The Great Library of Celaeno</ex:hasNotableFeatureL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_House_on_Curwen_Street"/>
    <ex:madeFirstAppearanceOnL>The Dunwich Horror (mention)</ex:madeFirstAppearanceOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Grant_Morrison">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Grant Morrison</rdfs:label>
    <ex:hasAnnotation>Birth Date January 31, 1960 Glasgow, Scotland, United Kingdom United Kingdom (born January 31, 1960) is a Scottish comic book and prose writer whose work has frequently intersected with the Cthulhu Mythos , though he is best known for his superhero genre works for comic book giants DC and Marvel . Selected Bibliography Comic Books Zenith (1987-1992) Doom Patrol (1989-1993) The Invisibles (1994-2000) JLA (1997-2000) Nameless (2015) Final Crisis (2018) Prose "Lovecraft in Heaven" (1994) "Luvkraft vs Kutulu" (2009) External Links at Wikipedia at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>Glasgow Scotland United Kingdom</ex:hasBirthplaceR>
    <ex:hasNationalityR>United Kingdom</ex:hasNationalityR>
    <ex:wasBornOnR>1960 January 31</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Peter_Ruber">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonFictionAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Peter Ruber</rdfs:label>
    <ex:diedOnR>6 March 2014</ex:diedOnR>
    <ex:hasAnnotation>Connection to the Mythos Editor Non-Fiction Author Birth Date 29 September 1940 Death Date 6 March 2014 United States (29 September 1940-6 March 2014) was an American author and editor. Overview A friend of Lovecraft contemporary August Derleth , some of whose works he published under his own imprint Candlelight Press, Ruber became chief editor for Arkham House after the departure of Jim Turner in 1997. Whilst there, he caused controversy for the overtly hostile introductions he wrote for some of the authors appearing in his 2000 anthology Arkham's Masters of Horror . After suffering a stroke in 2004, he ceased his editorial duties for Arkham House; in 2014 he passed away. Selected Works Editor Arkham's Masters of Horror (2000)</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Non-Fiction Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>29 September 1940</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhus_Dark_Cults">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu's Dark Cults</rdfs:label>
    <ex:hasAnnotation>Ten Tales of Dark &amp; Secretive Orders Various Cover Artist Steven Gilberts United States English Call of Cthulhu Fiction Chaosium Release Date May 2010 245 : Ten Tales of Dark &amp; Secretive Orders is a thematic anthology of Cthulhu Mythos fiction, featuring stories which revolve around people and cults which have previously appeared in Call of Cthulhu gaming supplements. Edited by David Conyers , it runs to a total of 245 and was published by Chaosium in May 2010. Overview Contents Links in parentheses indicate the supplement/s from which the story takes its cue. "The Eternal Chinaman" by John Sunseri ( The Fungi from Yuggoth ) "Captains of Industry" by John Goodrich ( Shadows of Yog-Sothoth , Secrets of New York ) "Perfect Skin" by David Witteveen ( Horror on the Orient Express ) "Covenant of Darkness" by William Jones ( Secrets of New York ) "The Whisper of Ancient Secrets" by Penelope Love ( Masks of Nyarlathotep ) "Old Ghost" by Peter A. Worthy ( Masks of Nyarlathotep ) "The Nature of Faith" by Oscar Rios ( H. P. Lovecraft's Dunwich ) "'The Devil’s Diamonds" by Cody Goodfellow ( Masks of Nyarlathotep ) "Requiem for the Burning God" by Shane Jiraiya Cummings ( The Fungi from Yuggoth , At Your Door , Unseen Masters ) "Sister of the Sands" by David Conyers ( Masks of Nyarlathotep , Secrets of Kenya ) Gallery References at Wikipedia at the Internet Speculative Fiction Database</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>245</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu Fiction</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>May 2010</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Alberto_Guerra">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Alberto Guerra</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Artists Horror is an artist who has provided imagery for a number of Cthulhu Mythos publications, perhaps most notably the Call of Cthulhu gaming supplements and their associate fiction by Golden Goblin Press . Selected Artwork Collections Tales of Cthulhu Invictus (2015) Gaming Supplements The Legacy of Arrius Lurco (2011) Fronti Nulla Fides (2019) Heroes and Heroines of Britannia Heroes and Heroines of the Shadow War See Also Images by</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Artists</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Guillermo_del_Toro">
    <rdf:type rdf:resource="http://example.org/lovecraft#ContentCreators"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Guillermo del Toro</rdfs:label>
    <ex:hasAnnotation>Full Name Gómez Connection to the Mythos Filmmaker Birth Date 9 October 1964 Guadalajara, Mexico is a Mexican filmmaker best known for his work as director and producer. Many of his works show direct connections to the Cthulhu Mythos begun with the works of H. P. Lovecraft . Overview In addition to producing series such as 's Cabinet of Curiosities , which contains three adaptations directly related to the Cthulhu Mythos, del Toro was involved with an abortive attempt to film At the Mountains of Madness . He has also directly inserted elements of the Mythos into his Hellboy films, such as a reference to occult grimoire De Vermis Mysteriis ( Hellboy , 2004) and cameos of the Elder Things ( Hellboy II: The Golden Army , 2008). Selected Works Director Hellboy (2004, film) Hellboy II: The Golden Army (2008, film) At the Mountains of Madness (unrealised project) Producer 's Cabinet of Curiosities (2022, TV series): includes three episodes adapted from the mythos: " Graveyard Rats " " Pickman's Model " " The Dreams in the Witch House "</ex:hasAnnotation>
    <ex:hasBirthplaceR>Guadalajara Mexico</ex:hasBirthplaceR>
    <ex:hasFullNameR>Guillermo del Toro Gómez</ex:hasFullNameR>
    <ex:isConnectedToMythosR>Filmmaker</ex:isConnectedToMythosR>
    <ex:wasBornOnR>9 October 1964</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Obsidian_Eyes">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Obsidian Eyes</rdfs:label>
    <ex:hasAnnotation>Kieran Dacey Boylan English Rogue Planet Press Lovecraftiana Vol 5, Issue 2 date July 2020  " " is a Lovecraftian poem by Australian Kieran Dacey Boylan . It was published in Vol 5, Issue 2 of Lovecraftiana by Rogue Planet Press in July 2020. Synopsis The eight lines compare the death of a snake to the hopeless reality of life in an uncaring universe.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Kieran_Dacey_Boylan"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 2</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 5</ex:isPublishedAsW>
    <ex:wasPublishedOnW>July 2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#That_Which_Lurks">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>That Which Lurks</rdfs:label>
    <ex:hasAnnotation>Frank Forte English Asylum Press Beyond Lovecraft date September 2020 " " is a short Cthulhu Mythos story by American Frank Forte . It was published in his collection Beyond Lovecraft by Asylum Press in September 2020. Synopsis When young scholar Robert Doleman meets elderly fanatic Jacob Reid, the two unite their separate goals through a common means: Doleman wishes to discover the hidden truth behind the universe, while Reid craves the return of his dead wife, killed by a supernatural force years before. Abandoning their moral codes, the two use a ritual they uncovered in the cursed Necronomicon to summon the mighty Outer God Yog-Sothoth ; their wishes are granted after a fashion, Reid being horrifically merged with his dead wife's reanimated corpse, and Doleman witnessing the coming to Earth of Cthulhu and his spawn before being driven to insanity.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Frank_Forte"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Beyond_Lovecraft"/>
    <ex:wasPublishedOnW>September 2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Before_the_Storm">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RamseyCampbellWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Before the Storm</rdfs:label>
    <ex:hasAnnotation>Unnamed man stumbles into a tax office, seeking shelter from the sun's rays . Flashback tells story of how he became involved with a group called the society . At one point, he made a bargain with the great old one known as eihort . Bargain allowed him to travel the universe by switching bodies .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror Short Story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Cold Print</ex:isPartOfSeriesW>
    <ex:wasPublishedOnW>1985</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>1980</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crypt_of_Cthulhu_Michaelmas_1984">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crypt of Cthulhu Michaelmas 1984</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Stephen E. Fabian United States English Crypt of Cthulhu Cryptic Publications Release Date September 1984 60 Preceded by Lammas 1984 Followed by Hallowmas 1984 is the 25th issue of leading H. P. Lovecraft scholar Robert M. Price 's long-running Lovecraftian fanzine Crypt of Cthulhu . Edited by Price, it ran to a total of 60 in an A5 format, and was published by Cryptic Publications in September 1984. Cover art was by Stephen E. Fabian, with interior work from Jason Eckhardt , Jeff Dee, and Allen Koszowski . Contents Editorial Shards by Robert M. Price "Gateway to Forever" by Frank Belknap Long "Josephine Gage" by Carl Jacobi "Strange Shadows" by Clark Ashton Smith "The Supreme Moment" by Robert E. Howard "Just the Two of Us" by Hugh B. Cave "The Hampdon Horror" by Duane Rimel Reviews by Lin Carter , S. T. Joshi , Marc A. Cerasini, and Steven Mariconda Letters by Brian Lumley , Ramsey Campbell , S. T. Joshi, L. Sprague de Camp , Don S. Siegel, Basil M. Bourque, Jr., and Joel D. Lane</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>60</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu"/>
    <ex:wasReleasedOnW>September 1984</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dunwich,_Massachusetts">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Dunwich, Massachusetts</rdfs:label>
    <ex:hasAccessibilityL>Road</ex:hasAccessibilityL>
    <ex:hasAnnotation>Dunwich is a fictional town created by the late howard phillips lovecraft for his short story " the dunwich horror " located in the northeast american state of massachusetts, dunwich is one of the country’s oldest settlements . The most recently constructed building is a mill at the falls which, like much of dunwich, has fallen to ruin . A notable point of the town is sentinel hill, crowned by a circle of incredibly ancient standing stones .</ex:hasAnnotation>
    <ex:hasAppearanceL>The Ancient Track Wilbur Whateley Waiting</ex:hasAppearanceL>
    <ex:hasNotableFeatureL rdf:resource="http://example.org/lovecraft#Sentinel_Hill"/>
    <ex:hasTypeL>Town</ex:hasTypeL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Massachusetts"/>
    <ex:isLocatedAtL>USA</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Dunwich_Horror"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Jesper_Myrfors">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Jesper Myrfors</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Games Designer Artist Sweden is a Swedish artist and games designer best known for his work on Magic: The Gathering - for which he acted as the original art director - and White Wolf Publishing's Vampire: The Masquerade , although he has also worked on a handful of Cthulhu Mythos -related projects, including at least one supplement for Chaosium 's horror roleplaying game Call of Cthulhu . Selected Works Games Designer The Hills Rise Wild! (2000, with John Tynes ) Artwork Devil's Children (1993) External Links at Wikipedia at the Internet Speculative Fiction Database at BoardGameGeek References</ex:hasAnnotation>
    <ex:hasBirthplaceR>Sweden</ex:hasBirthplaceR>
    <ex:isConnectedToMythosR>Artist</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Games Designer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kolchak:_Necronomicon">
    <rdf:type rdf:resource="http://example.org/lovecraft#Crossovers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Kolchak: Necronomicon</rdfs:label>
    <ex:hasAnnotation>Kolchak: the night stalker moonstone release date june 2012 180 is a collection of works by the late american c.j. Henderson . Contains three stories written by . C.j. Henderson which are set in the world of the . Cthulhu mythos . Original artwork by robert hack and jaime calderon .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#C._J._Henderson"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>180</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Kolchak: The Night Stalker</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>June 2012</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Darkest_Dungeon">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Darkest Dungeon</rdfs:label>
    <ex:hasAnnotation>Roguelike horror roleplaying game at least partially inspired by the works of h. p. lovecraft . Game was first released by indie developer red hook studios on 19 january 2016 . Several dlc add-ons have been issued, including " the color of madness ", an expansion which takes its cue directly from " the colour out of space " .</ex:hasAnnotation>
    <ex:wasPublishedOnW>19 January 2016</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Scott_T._Goudsward">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Scott T. Goudsward</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Mythos Contributor United States Horror http://goudsward.com/scott/  is an American author who has contributed multiple stories to the Cthulhu Mythos created by H. P. Lovecraft and expanded upon by many others. These have been included in anthologies such as The Call of Lovecraft , The Dark Rites of Cthulhu , Return of the Old Ones , and Arkham Detective Agency . Selected Biography " With Death Comes Life " (2014) " The Hidden " (2017) " Witch Fire " (2017) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>http://goudsward.com/scott/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Mythos Contributor</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#RuthannaEmrysWorks">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Work"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Etepsed_Egnis_%28entity%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Etepsed Egnis (entity)</rdfs:label>
    <ex:hasAnnotation>Etepsed Egnis (entity) First appearance INFL : " Etepsed Egnis " INFL : "A Core Unto Itself" "The Gemstone From Out of Space" Created by D. F. Lewis  Etepsed Egnis is a fictional entity created by D. F. Lewis for his eponymous short story . Description Whilst almost nothing is known of Etepsed Egnis, it has been described as a vast, amorphous blob composed of an unidentifiable material. The only recognisable feature of this mass is the single great arm which protrudes from its disgusting form. The appearance of Etepsid Egnis seems to be very similar to that of the Great Old One Cynothoglys , The Mortician God , although whether these two beings are somehow related - or even the same entity masquerading under different names - has yet to be established.</ex:hasAnnotation>
    <ex:hasAppearanceC>A Core Unto Itself The Gemstone From Out of Space</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Etepsed_Egnis"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#D._F._Lewis"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Beneath_Evil_Skies">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Beneath Evil Skies</rdfs:label>
    <ex:hasAnnotation>Full story online here Phillip A. Ellis English Dark Legacy #5 date May 1999 " " is a short Cthulhu Mythos poem by Australian poet Phillip A. Ellis . Synopsis The fourteen lines in two verses comprise a brief cautionary tale on the dangers of ghouls . History First published in Dark Legacy #5 in May 1999, "" later appeared in the anthology Tales of the Cthulhu Mythos: Cthulhu's Creatures .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Phillip_A._Ellis"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Dark Legacy #5</ex:isPublishedAsW>
    <ex:wasPublishedOnW>May 1999</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nightmare_World">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Nightmare World</rdfs:label>
    <ex:hasAnnotation>Dirk Manning various English Image Comics Release Date December 2009, October 2010, October 2011, October 2017 Media Type Comic book is a series of volumes that was published by Image Comics and written by Dirk Manning. It was spread out over several years, with the first three volumes published in 2009-2011 and the fourth volume in 2017. An anthology of loosely tied stories about the apocalypse which merges Lovecraft 's Cthulhu Mythos with Christian theology. It involves aliens, zombies , demons, angels, Old Ones , kaiju, etc and revolves around Lucifer and God. Volumes Vol 1: Thirteen Tales of Terror Vol 2: Leave the Light On Vol 3: Demon Days Vol 4: The Mourning After</ex:hasAnnotation>
    <ex:hasAuthorW>Dirk Manning</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>October 2011 October 2010 December 2009 October 2017</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Lovecraft_Mysteries">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#StoryCycles"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Lovecraft Mysteries</rdfs:label>
    <ex:hasAnnotation>A trilogy of pulp cthulhu mythos novels by american author brandon berntson . Follows private investigator devlin macky and his secretary/love interest millie von clydesburgh as they tackle the various supernatural threats . Exactly when the series is set is not stated .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brandon_Berntson"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2018 - 2021</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Horror_in_the_Water_Tower">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Horror in the Water Tower</rdfs:label>
    <ex:hasAnnotation>A strange creature which was stolen away from a temple in peru ventures forth into the wide world of innsmouth on the day her owner dies in an accident . The creature and the man fall in love, and together they discover her extradimensional powers and origin, ultimately using them to escape the confines of this world .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mark_McLaughlin"/>
    <ex:hasAuthorW>Michael Sheehan. Jr.</ex:hasAuthorW>
    <ex:hasGenreW>Romance</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Abominations: 24 Tales of the Cthulhu Mythos</ex:isPublishedAsW>
    <ex:isPublishedAsW>Horrors</ex:isPublishedAsW>
    <ex:wasPublishedOnW>December 2018</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Look_Behind_the_Derleth_Mythos">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#JohnDHaefele"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Look Behind the Derleth Mythos</rdfs:label>
    <ex:hasAnnotation>Origins of the Cthulhu Mythos John D. Haefele United States English Genre(s) Nonfiction H. Harksen Productions Release Date March 2013 371 : Origins of the Cthulhu Mythos is a nonfiction book by John D. Haefele , first published in hardcover format by H. Harksen Publications in March 2013. It explores the contributions of August Derleth to the Cthulhu Mythos and responds to criticisms of Derleth by S. T. Joshi and others. Overview Publication History Since its first release in 2013, has also been released in an expanded edition, published independently through The Cimmerian Press in 2014; both paperback and digital versions were released. Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#John_D._Haefele"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Nonfiction</ex:hasGenreW>
    <ex:hasPageCountW>371 pages</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>March 2013</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Hugh_B._Cave">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsCorrespondents"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Hugh B. Cave</rdfs:label>
    <ex:diedOnR>27 June 2004</ex:diedOnR>
    <ex:hasAnnotation>W. t. cave (11 july 1910 – 27 june 2004) was a prolific american writer of pulp fiction . He wrote and published at least 800 stories in such outlets as weird tales , astounding , and black mask . His cthulhu mythos fiction includes " the island of dark magic " and " the death watch "</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#England Chester</ex:hasBirthplaceR>
    <ex:hasNationalityR>American</ex:hasNationalityR>
    <ex:hasPseudonymR>Geoffrey Vace</ex:hasPseudonymR>
    <ex:hasPseudonymR>James Pitt</ex:hasPseudonymR>
    <ex:hasPseudonymR>John Star</ex:hasPseudonymR>
    <ex:hasPseudonymR>Justin Case</ex:hasPseudonymR>
    <ex:hasPseudonymR>Margaret Hullinwall</ex:hasPseudonymR>
    <ex:wasBornOnR>11 July 1910</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Monstrous_frog">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonSapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Monstrous frog</rdfs:label>
    <ex:hasAnnotation>Sociocultural Characteristics Unknown Real World Information First appearance " The Shuttered Room " Created by Howard Phillips Lovecraft &amp; August Derleth</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Shuttered_Room"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Howard_Phillips_Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Chris_Birch">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Chris Birch</rdfs:label>
    <ex:hasAnnotation>Birch is best known for his work on creating and developing the achtung! Cthulhu line of cthulhu mythos roleplaying games . In 2013 birch and his wife rita founded the tabletop games publisher modiphius entertainment . Modiphius has gone on to release material for a wide variety of franchise tie-in games, including the robert e. howard-inspired conan: adventures in an age undreamed of .</ex:hasAnnotation>
    <ex:hasNationalityR>United Kingdom</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Games designer</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Publisher</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Victoria_Montesi">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Victoria Montesi</rdfs:label>
    <ex:hasAnnotation>A hero in the fictional marvel universe, who was created in 1992 and has often appeared in stories involving the darkhold . She was a founding member of the darkhold redeemers, a team of humans who fight chthon and his disciples, the darkholders . Due to her being a spawn of the elder god, her aging has drastically slowed and for the last 3-4 decades has continued to look like she was in her 30s .</ex:hasAnnotation>
    <ex:hasAppearanceC>Darkhold: Pages from the Book of Sins Born Again Sea Devil What Dwells Beneath</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC>Darkhold: Pages from the Book of Sins Vol 1 1</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Chris Cooper</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Parker">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Parker</rdfs:label>
    <ex:ceasedOnC>1925</ex:ceasedOnC>
    <ex:hasAnnotation>1925 Human First appearance HPL : " The Call of Cthulhu " Created by H. P. Lovecraft is a fictional character created by H. P. Lovecraft , who makes his only appearance in the 1928 short story " The Call of Cthulhu ". Description He was a crew member on the marine vessel Emma of Auburn, although his role is uncertain. After Donovan was successful in opening the vault discovered by the crew in R'lyeh , Cthulhu emerged, killing Donovan, Guerrera and Angstrom . Second Mate Gustaf Johansen recounts that during the slaughter, slipped and was "swallowed up by an angle of masonry which shouldn't have been there; an angle which was acute, but behaved as if it were obtuse."</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Call_of_Cthulhu"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Legacy_of_Arrius_Lurco">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Legacy of Arrius Lurco</rdfs:label>
    <ex:hasAnnotation>Oscar Rios Alberto Guerra Steff Worthington English Call of Cthulhu Genre(s) Roleplaying game Miskatonic River Press Golden Goblin Press Release Date 2011 132 is a scenario sourcebook for Chaosium 's Call of Cthulhu horror roleplaying game. Overview Containing a complete four-scenario campaign for the Cthulhu Invictus time period of Call of Cthulhu , also features new rules for the main game, including character professions, artefacts, weapons, and creatures, as well as background information on cults and secret societies of the time. Behind the Mythos Written by Oscar Rios with artwork provided by Alberto Guerra and Steff Worthington, runs to a total of 132 . First published in 2011 by Miskatonic River Press , it is currently available as a digital download from licensed third-party content provider Golden Goblin Press , who have also released an update to the rules to be compatible with the 7th edition of the game. Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Oscar_Rios"/>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>132</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2011</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Terrible_Old_Man_of_Keyport">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Terrible Old Man of Keyport</rdfs:label>
    <ex:hasAnnotation>Keyport cthulhu is a short story by american author chuck buda . It is a rewrite of h.p. Lovecraft's " the terrible old man " set in keyport . The titular character is replaced by a deep one hybrid .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Chuck_Buda"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Keyport_Cthulhu"/>
    <ex:wasPublishedOnW>November 2013</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#James_F._Morton">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#KalemClub"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsCorrespondents"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsInspirationsAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>James F. Morton</rdfs:label>
    <ex:diedOnR>17th October 1941</ex:diedOnR>
    <ex:hasAnnotation>Morton was an anarchist writer and political activist of the 1900s through the 1920s . His work focused on the single tax system, racism, and advocacy for women . After about 1920, he was beter known as a bahá', a notable museum curator, and an esperantist .</ex:hasAnnotation>
    <ex:hasBirthplaceR>http://example.org/lovecraft#Massachusetts Littleton</ex:hasBirthplaceR>
    <ex:hasFullNameR>James Ferdinand Morton. Jr.</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Close Friend of H. P. Lovecraft</ex:isConnectedToMythosR>
    <ex:wasBornOnR>18th October 1870</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dark_Rites_of_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dark Rites of Cthulhu</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Neil Baker English Genre(s) Horror April Moon Books Release Date March 2014 Media Type Paperback Ebook 230  is a thematic Cthulhu Mythos -focused anthology. Overview Including sixteen short stories based around the use of magic in the Cthulhu Mythos, was edited by Brian M. Sammons . It was first released in March 2014 by April Moon Books , runs to 230 , and is available in both paperback and digital editions. Contents "Unmentionable Rites for Nameless Horrors" introduction by Brian M. Sammons " The Keeper of the Gate " by William Meikle " Dead Man's Tongue " by Josh Reynolds " The Dark Horse " by John Goodrich " Changing of the Guard " by Peter Rawlik " The Murder at the Motel " by Brian M. Sammons " The Grey Rite of Azathoth " by Robert M. Price " The Vessel " by Sam Stone " Like Comment Share " by Don Webb " With Death Comes Life " by Scott T. Goudsward " The Dogs " by Jeffrey Thomas " Of Circles and Rings " by Tom Lynch " The Bride of the Beast " by Glynn Owen Barrass " The Nest of Pain " by C. J. Henderson " Black Tallow " by Edward M. Erdelac " The Mindhouse " by Christine Morgan " The Half Made Thing " by T. E. Grau Trivia The cover of is purposely designed to resemble a tattered paperback novel from the 1980s. Gallery</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>230</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>March 2014</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Something_About_Cats">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Something About Cats</rdfs:label>
    <ex:hasAnnotation>"cats and dogs" is a non-fiction essay by h. p. lovecraft . It defended his ailurophilia (love of cats) as part of an ongoing debate about the virtues of cats versus the virtues of dogs . Lovecraft accuses dog-lovers of judging the intellectual merits of a pet "by its degree of conformity to their own wishes"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Leaves</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1937</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>1926 November</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Interloper">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RamseyCampbellWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Interloper</rdfs:label>
    <ex:hasAnnotation>The short story was published in the 1973 collection demons by daylight . It is set in the expanded cthulhu mythos and is set in the fictional town of brichester . The boys discover a catacomb of human remains and a malevolent entity .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Demons_by_Daylight"/>
    <ex:wasPublishedOnW>1973</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Like_Comment_Share">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Like Comment Share</rdfs:label>
    <ex:hasAnnotation>The dark rites of cthulhu is a short story by american author don webb . It was published in the anthology the dark rites of cthulhu in march 2014 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Don_Webb"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
