    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Work"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Horror_in_the_Museum_and_Other_Revisions">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
