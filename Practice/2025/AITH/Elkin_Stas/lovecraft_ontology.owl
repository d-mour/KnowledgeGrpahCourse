    <ex:wasPublishedOnW>October 1997</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Vortis">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsOriginatingFromMythosAdjacentWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Planets"/>
    <rdfs:label>Vortis</rdfs:label>
    <ex:hasAnnotation>Planet created by bill strutton for the science fiction series doctor who . Made its first appearance in the storyline in the second series in 1965 . For a time it was dominated by the animus which enslaved the zarbi .</ex:hasAnnotation>
    <ex:hasNotableFeatureL>Acid pools Rock formations</ex:hasNotableFeatureL>
    <ex:hasTypeL>Planet</ex:hasTypeL>
    <ex:isInhabitedByL>Animus Optera Zarbi Menoptera</ex:isInhabitedByL>
    <ex:madeFirstAppearanceOnL>The Web Planet</ex:madeFirstAppearanceOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Strange_Cases_of_Rudolph_Pearson">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Strange Cases of Rudolph Pearson</rdfs:label>
    <ex:hasAnnotation>William Jones Cover Artist Steven Gilberts English Genre(s) Cthulhu Mythos Chaosium Release Date 2008 238 : Horriplicating Tales of the Cthulhu Mythos is a collection of Mythos stories by William Jones , centering on the character Rudolph Pearson. It was published by Chaosium in 2008. The book's Foreword and Afterward are written from an in-universe perspective and attributed to "Joshua Pearson, PhD." Contents "'s Note" "Foreword" "Feasters of the Dark" (2003) "The Transgression of Effram Harris" (2004) "Shadow of the Past" "The Whispering Dead" The Haunted Horror" "Harami" (2004) "The Missing Curiosity" "The Mysterious Millionaire" "An Ancient Summoning" "Through the Eye of a Needle" (2006) "Afterword"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Jones"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasPageCountW>238</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2008</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shocking_Terrors">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Shocking Terrors</rdfs:label>
    <ex:hasAnnotation>" #13 " is a lovecraftian short story by american frank forte . First published in his collection beyond lovecraft by asylum press in september 2020 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Frank_Forte"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Beyond_Lovecraft"/>
    <ex:wasPublishedOnW>September 2020</ex:wasPublishedOnW>
