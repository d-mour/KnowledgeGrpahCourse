    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Maurice W Moe</rdfs:label>
    <ex:diedOnR>1940</ex:diedOnR>
    <ex:hasAnnotation>Amateur journalist, English teacher, and longtime friend and correspondent of Lovecraft. He lived successively in Appleton and Milwaukee, Wisconsin.</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
