    <rdfs:label>Forbidden Alchemy</rdfs:label>
    <ex:hasAnnotation>Corey Konieczka Fantasy Flight Games Publication Date 2011 is an expansion set for the Fantasy Flight Games board game Mansions of Madness first released in 2011 and reissued in 2016. It was designed by Corey Konieczka , who was the game's original creator. Overview Gallery</ex:hasAnnotation>
    <ex:wasPublishedOnW>2011</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Herbert_West%E2%80%94Reanimated">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Herbert West—Reanimated</rdfs:label>
    <ex:hasAnnotation>The story is told in six chapters, each written by a different writer . It serves as a sequel of sorts to the short story " herbert west—reanimator " the story is told in the roodmas 1989 edition of the crypt of cthulhu zine .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Donald_R._Burleson"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
