  <rdf:Description rdf:about="http://example.org/lovecraft#Lorrore_di_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>L'orrore di Cthulhu</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Boris Vallejo Italy Italian I Miti di Cthulhu Fanucci Editore Release Date March 1986 234 is an Italian- collection of Lovecraftian horror edited by Gianni Pilo. It was published in March 1986 by Fanucci Editore as part of their I Miti di Cthulhu , and is currently out of print. Contents "I miti di Cthulhu" introduction by Gianni Pilo "Zoth-Ommog" by Lin Carter (" Zoth-Ommog ") "Ghroth" by J. Ramsey Campbell (" The Tugging ") "Il segreto di Sebek" by Robert Bloch (" The Secret of Sebek ") "La strada illuminata dalla luna" by Ambrose Bierce ("The Moonlit Road") "Haggopian" by Brian Lumley (" Haggopian ") "La casa nella valle" by August Derleth (" The House in the Valley ") "Gli pseudobiblia di Cthulhu" by Domenico Cammarota References</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>Italy</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>234</ex:hasPageCountW>
    <ex:isInLanguageW>Italian</ex:isInLanguageW>
    <ex:isPartOfSeriesW>I Miti di Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>March 1986</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Steve_Perrin">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Steve Perrin</rdfs:label>
    <ex:hasAnnotation>Stephen Herbert Perrin (born January 22, 1946), often simply known as , is a game designer. He has also worked previously as an editor, reviewer, publisher and technical writer. Perrin is best known for creating the tabletop role-playing game rules for RuneQuest for the tabletop gaming company Chaosium . He also worked on their most famous game, Call of Cthulhu . He worked as a freelance game writer and designer for two decades before returning to Chaosium in 2020 as a consultant, primarily for the Call of Cthulhu game line.</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#isSpouseOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
