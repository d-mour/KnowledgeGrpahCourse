  <rdf:Description rdf:about="http://example.org/lovecraft#The_Terror_from_the_Depths">
    <rdf:type rdf:resource="http://example.org/lovecraft#FritzLeiberWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Terror from the Depths</rdfs:label>
    <ex:hasAnnotation>The story concerns a young poet who dreams obsessively about strange winged worms flying through a network of tunnels under the pacific ocean . Leiber reportedly began writing the story in 1937, the year of h. p. lovecraft 's death, but did not complete it until 1975 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Fritz_Leiber"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Disciples_of_Cthulhu"/>
    <ex:wasPublishedOnW>October 1976</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Memoir_of_Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Memoir of Lovecraft</rdfs:label>
    <ex:hasAnnotation>Rheinhart Kleiner United States English Genre(s) Non-fiction Arkham House The Arkham Sampler , Spring 1948 date 1948 " " is a short non-fiction piece by the late American Rheinhart Kleiner . Overview Written by Lovecraft 's close friend and contemporary Rheinhart Kleiner, "" is, as should be clear from its title, a look back at Lovecraft’s life, written only a year before Kleiner's death in 1949. It was first published in The Arkham Sampler in the Spring 1948 edition , and was later included in Something About Cats and Other Pieces (1949) and Lovecraft Remembered (1998).</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Rheinhart_Kleiner"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Arkham_Sampler"/>
    <ex:isPublishedAsW>Spring 1948</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1948</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cultes_des_Goules">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Cultes des Goules</rdfs:label>
    <ex:hasAlternativeNamesA>Cults of Ghouls</ex:hasAlternativeNamesA>
    <ex:hasAnnotation>Cults of ghouls is a fictional book of black magic . It is said to have been written by françois honoré-balfour in 1702 . Only a handful of copies are in existence . One of the known copies was kept for 91 years in an arcane library .</ex:hasAnnotation>
    <ex:hasFunctionA>Book</ex:hasFunctionA>
    <ex:hasPlaceOfOriginA>http://example.org/lovecraft#France</ex:hasPlaceOfOriginA>
    <ex:hasTypeA>Data Storage</ex:hasTypeA>
    <ex:hasTypeA>Transmission</ex:hasTypeA>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_Suicide_in_the_Study"/>
    <ex:wasCreatedByA>François Honoré-Balfour</ex:wasCreatedByA>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nameless_Cults:_The_Cthulhu_Mythos_Fiction_of_Robert_E._Howard">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RobertEHowardWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Nameless Cults: The Cthulhu Mythos Fiction of Robert E. Howard</rdfs:label>
    <ex:hasAnnotation>Robert E. Howard , Robert M. Price , editor Cover Artist Harry Fassl English Call of Cthulhu Fiction Genre(s) Cthulhu Mythos Chaosium Release Date October 2001 353 is a collection of Howard 's Mythos -related fiction, edited by Robert M. Price and published by Chaosium in 2001. The title is a reference to Nameless Cults , the fictional tome that is one of Howard's signature contributions to the Mythos. Contents All pieces by Robert E. Howard unless otherwise indicated. "Introduction: Raven, Son of Morn" essay by Robert M. Price (2001) " The Black Stone " (1931) " Worms of the Earth " (1932) " The Little People " (1970) " People of the Dark " (1932) " The Children of the Night " (1931) " The Thing on the Roof " (1932) " The Abbey " (fragment) (1975) " The Fire of Asshurbanipal " (1936) " The Door to the World " by Robert E. Howard and Joseph S. Pulver (1977) " The Hoofed Thing " (1970) " Dig Me No Grave " (1937) " The House in the Oaks " by August Derleth and Robert E. Howard (1971) " The Black Bear Bites " (1974) " The Shadow Kingdom " (1929) " The Gods of Bal-Sagoth " (1931) " Skull-Face " (1929) " Black Eons " by Robert E. Howard and Robert M. Price (1985) " The Challenge from Beyond " by Robert E. Howard, Frank Belknap Long , H. P. Lovecraft , A. Merritt , and C. L. Moore (1935)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
    <ex:hasAuthorW>author</ex:hasAuthorW>
    <ex:hasAuthorW>editor</ex:hasAuthorW>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasPageCountW>353</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu Fiction</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>October 2001</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dreams_in_the_Witch_House_%28Video_Game%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dreams in the Witch House (Video Game)</rdfs:label>
    <ex:hasAnnotation>Dreams in the witch house is an open world horror adventure game . The player guides walter gilman as he prepares to face the dreaded may-eve witch ritual in the legend-haunted city of arkham . Based on the short story " the dreams in the witch house " by h.p. Lovecraft .</ex:hasAnnotation>
    <ex:wasPublishedOnW>February 16th 2023</ex:wasPublishedOnW>
  </rdf:Description>
