    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Grim Investigations</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Anders Finér English Arkham Horror Fiction Aconyte (print editions) Tantor Audio/Tantor &amp; Blackstone Publishing (audio editions) Release Date February 2022 464 is a collection of Cthulhu Mythos novellas and short stories from Fantasy Flight Games ' Arkham Horror Fiction line. First published in paperback and digital editions by Aconyte in February 2022, an audiobook version was released in several formats by Tantor Audio/Tantor &amp; Blackstone Publishing simultaneously . Overview Contents (incomplete) To Fight the Black Wind by Jennifer Brozek The Blood of Baalshandor by Richard Lee Byers Dark Revelations by Amanda Downum References</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>464</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
