    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Tales Vol. 1</rdfs:label>
    <ex:hasAnnotation>Keith Giffen, John Rogers, Michael Alan Nelson Andy Kuhn, Mark Badger, Andrew Ritchie English Boom! Studios Release Date June 2006 Media Type Comic book is a collection of Cthulhu Mythos stories which was first published in June 2006 by Boom! Studios. Overview Stories " The Beach " " Witch Hunter " " Quality Time " " Cthulhu Calls " " The Oddly Amourous Phineas Flynn and the Troublesome Trouble He Got Himself In "</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Michael_Alan_Nelson"/>
    <ex:hasAuthorW>John Rogers</ex:hasAuthorW>
    <ex:hasAuthorW>Keith Giffen</ex:hasAuthorW>
