    <ex:isInhabitedByL>Sentient animals</ex:isInhabitedByL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#Return_to_Wonderland"/>
    <ex:madeFirstAppearanceOnL>Alice's Adventures in Wonderland</ex:madeFirstAppearanceOnL>
