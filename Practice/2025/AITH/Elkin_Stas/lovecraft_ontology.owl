  <rdf:Description rdf:about="http://example.org/lovecraft#Monstrous_mammal">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonSapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Monstrous mammal</rdfs:label>
    <ex:hasAnnotation>Real World Information First appearance HPL : " The Doom That Came to Sarnath " Created by H. P. Lovecraft The is a creature created by the late American author Howard Phillips Lovecraft for his short story " The Doom That Came to Sarnath ". What the creature's real name may be is not mentioned in the text.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Doom_That_Came_to_Sarnath"/>
