    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Miscellaneous Writings</rdfs:label>
    <ex:hasAnnotation>569 is a collection of works by howard phillips lovecraft with section introductions by scholar s. t. joshi . A limited run of 4959 copies was printed by arkham house in february 1995 . It has not been reissued .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>569</ex:hasPageCountW>
