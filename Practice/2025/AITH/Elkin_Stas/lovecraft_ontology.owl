    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Horror in the Museum and Other Revisions</rdfs:label>
    <ex:hasAnnotation>First published by arkham house in 1970, the collection ran to 383 pages . A revised edition was released in 1989 by s. t. joshi . A trade paperback was then released in 2007, this time by stephen jones .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1970</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Eeyore_Makes_a_Friend">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Eeyore Makes a Friend</rdfs:label>
    <ex:hasAnnotation>The call of poohthulhu was published in the anthology the call of poohthulhu in may 2022 . It introduces the characters of a. a. milne's winnie-the-pooh stories to lovecraftian horror .</ex:hasAnnotation>
    <ex:hasAuthorW>Jackson Parker</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Call_of_Poohthulhu"/>
    <ex:wasPublishedOnW>May 2022</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Cards_of_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Cards of Cthulhu</rdfs:label>
    <ex:hasAnnotation>Cards-and-dice game is a cooperative mythos -based cards-and-dice game . Behind the mythos was developed from a regular 52-card deck game created by ian richard in 2012 . It was published by dan verssen games following a successful kickstarter campaign in 2014 .</ex:hasAnnotation>
    <ex:wasPublishedOnW>2014</ex:wasPublishedOnW>
  </rdf:Description>
