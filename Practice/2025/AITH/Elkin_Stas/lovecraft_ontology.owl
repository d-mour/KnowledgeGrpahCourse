  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu:_Land_of_the_Long_White_Cloud">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu: Land of the Long White Cloud</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Steve Santiago Australia English IFWG Publishing International Release Date 2019 Media Type Print 206 is a short story collection focused on Cthulhu Mythos stories set in New Zealand. Overview Contents "Te Ika" by J.C. Hart "Ortensia And Osvaldo" by Lucy Sussex "The Silence At The Edge Of The Sea" by Dan Rabarts "The Caverns Of The Unnamed One" by Jane Percival "Kopura Rising" by David Kuraria "The Ward of Tindalos" by Debbie &amp; Matt Cowens "A Brighter Future" by Grant Stone "The Shadow Over Tarehu Cove" by Tracie McBride "Memories To Ashes" by Paul Mannering "Masquerades" by Marty Young "Edward's Journal" by Lee Murray Publication History Edited by Steve Proposch , Christopher Sequeira, and Bryce Stevens, was published in both trade paperback and ebook editions in 2018. Gallery</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW rdf:resource="http://example.org/lovecraft#Australia"/>
    <ex:hasPageCountW>206</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2019</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dragon_King">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Dragon King</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Sligguth"/>
    <ex:hasAlternativeNamesC>Dragon-Lords</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Scaly ones</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Dragon-lords are descendants of the elder god set . Spawned a million years ago, together with the race known as the serpent men . First appeared in 1965 in the wizard of lemuria . Later adapted into comic book format by marvel comics .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Wizard_of_Lemuria"/>
    <ex:madeFirstAppearanceOnC>Creatures on the Loose Vol 1</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>issue #26</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#When_the_Light_Comes">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>When the Light Comes</rdfs:label>
    <ex:hasAnnotation>Mike VandeVenter English Rogue Planet Press Swords Against Cthulhu II: Hyperborean Nights date January 2017 " " is a short story by Mike VandeVenter, which is loosely related to the Cthulhu Mythos . It was published in the Gavin Chappell -edited anthology Swords Against Cthulhu II: Hyperborean Nights by Rogue Planet Press in January 2017. Aside from a vague reference to Aphoom-Zhah , it has little to do with the Mythos proper. Synopsis A man whose village is attacked by barbarian raiders in service to Aphoom-Zhah is tricked into killing his wife and child. At this moment of realisation, he is inexplicably transported into the modern world, and he escapes from the attending police before disappearing into the night.</ex:hasAnnotation>
    <ex:hasAuthorW>Mike VandeVenter</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Swords_Against_Cthulhu_II:_Hyperborean_Nights"/>
    <ex:wasPublishedOnW>January 2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Electric_Executioner">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Electric Executioner</rdfs:label>
    <ex:hasAnnotation>Full story online here Howard Phillips Lovecraft and Adolphe de Castro United States English Genre(s) Horror short stories Weird Tales ← Previous Next → " The Dunwich Horror " " The Mound " with Zealia Bishop 𝐓 " " is the name of H. P. Lovecraft 's revision of Adolphe de Castro 's "The Automatic Executioner" previously published in 1893 in In the Confessional and the following .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Adolphe_de_Castro"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Howard_Phillips_Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short stories</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yaldabaoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Yaldabaoth</rdfs:label>
    <ex:hasAffiliationC>Supposedly Worshipped by monotheistic creeds that would have mistaken him for the true god or Monad</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Ariel (or Aariel)</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Nebro</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Saklas</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Samael (sometimes listed as Samaël)</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Satanael</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Demiurge</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as the demiurge saklas samael (sometimes listed as samal) satanael powers and abilities can blind those who see it and has great magical powers . According to some creeds, at first matter did not exist and everything was spirit . A proud and jealous god, tried to structure everything by recreating the spirit in a material world .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Zadok_Allen_%28publisher%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#DefunctRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SmallPress"/>
    <rdfs:label>Zadok Allen (publisher)</rdfs:label>
    <ex:hasAnnotation>Zadok Allen (publisher) Current Status Defunct 1995 Darrell Schweitzer (speculated) Zadok Allen was an indie publishing house which released a handful of works between 1995 and 2006. Specialising in poetry, it seems likely to have been by prolific weird fiction author Darrell Schweitzer, several of whose chapbook collections were issued through the press. It appears to have gone inactive after 2006. Selected Output Chapbooks The Innsmouth Tabernacle Choir Hymnal (2004) The Arkham Alphabet Book (2006)</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Passing_of_Eric_Holm">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Passing of Eric Holm</rdfs:label>
    <ex:hasAnnotation>Eric holm was last seen alive on april 3, 1939, returning home with a newly-bought book . The book, confessions of the mad monk clithanus, identified the creature in question as one of the spawn of cthulhu . Holm proposed to send the spawn of cthulhu after lansing, who would then banish it back to the sea .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Strange_Stories"/>
    <ex:wasPublishedOnW>December 1939</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Achtung%21_Cthulhu:_Assault_on_the_Mountains_of_Madness">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Achtung! Cthulhu: Assault on the Mountains of Madness</rdfs:label>
    <ex:hasAnnotation>Jason Durall Dim Martin, Pierre Droal &amp; Yap Kun Rong Cover Artist Dim Martin English Call of Cthulhu ( Achtung! Cthulhu ) Genre(s) Roleplaying game Modiphius Entertainment Release Date 2013 Assault on the Mountains of Madness is a campaign supplement for the Achtung! Cthulhu sub-setting of Chaosium 's Call of Cthulhu horror roleplaying game. Written by Jason Durall, it was published by third-party content provider Modiphius Entertainment in 2013; both print and digital editions were released . Overview Production Team Writer: Jason Durall Additional Writing: Bill Bodden, Alex Bund, Alex Flagg &amp; Paul Fricker Savage Worlds Conversion: Luis Enrique Torress Proofreading &amp; Editing: Scott Dorward &amp; Lynne Hardy Cover Art: Dim Martin Interior Artwork: Dim Martin, Pierre Droal &amp; Yap Kun Rong Cartography: Giorgio Baroni Graphic Design: Michal E. Cross Layout by Thomas Shook &amp; Ben Acevedo Production &amp; Art Direction: Chris Birch Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW>Jason Durall</ex:hasAuthorW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2013</ex:wasReleasedOnW>
  </rdf:Description>
