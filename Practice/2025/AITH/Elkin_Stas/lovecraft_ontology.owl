  <rdf:Description rdf:about="http://example.org/lovecraft#Immaterium">
    <rdf:type rdf:resource="http://example.org/lovecraft#Dimensions"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsOriginatingFromMythosInspiredWorks"/>
    <rdfs:label>Immaterium</rdfs:label>
    <ex:hasAnnotation>The is a dimension from the fictional universe of the warhammer 40k and warhammer fantasy tabletop miniature wargames by games workshop . It's in the where the chaos gods and the daemons were born and reside . For most of the spacefaring races, faster-than-light travel is accomplished via the use of warp-drives .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Michael_Cisco">
    <rdf:type rdf:resource="http://example.org/lovecraft#Critics"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonFictionAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Michael Cisco</rdfs:label>
    <ex:hasAnnotation>Cisco's first novel, the divinity student, won of the international horror guild award for best first novel of 1999 . He has since written 12 more novels, including the best weird novel of 2011 . Since 2008, he has taught english at hostos community college, part of the city university of new york .</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA http://example.org/lovecraft#California Glendale</ex:hasBirthplaceR>
    <ex:hasFullNameR>Michael Terry Cisco</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://www.michaelcisco.com/</ex:hasWebsiteR>
    <ex:hasYearsActiveR>1999-</ex:hasYearsActiveR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
