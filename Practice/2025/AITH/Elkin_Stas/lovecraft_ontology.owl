    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Alive</rdfs:label>
    <ex:hasAnnotation>Kieran Dacey Boylan English Rogue Planet Press Lovecraftiana Vol 5, Issue 2 date July 2020  " " is a Lovecraftian poem by Australian Kieran Dacey Boylan . It was published in Vol 5, Issue 2 of Lovecraftiana by Rogue Planet Press in July 2020. Synopsis The five four-line verses describe the horror of the human condition and the ephemeral condition of the human race.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Kieran_Dacey_Boylan"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
