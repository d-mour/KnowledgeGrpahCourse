  <rdf:Description rdf:about="http://example.org/lovecraft#His_Carnivorous_Regard">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>His Carnivorous Regard</rdfs:label>
    <ex:hasAnnotation>Short story was first published in the kat rocha -edited collection of lovecraftian fiction whispers from the abyss vol. 2: the horrors that are &amp; shall be in october 2015 .</ex:hasAnnotation>
