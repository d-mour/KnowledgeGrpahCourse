  <rdf:Description rdf:about="http://example.org/lovecraft#Graham_Masterton">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Graham Masterton</rdfs:label>
    <ex:hasAnnotation>Masterton's debut novel, the manitou, featured as its villain misquamacus . Masterton went on to write a series of novels featuring misquamacus . The manitou was made into a 1978 film of the same name, starring tony curtis, susan strasberg, and michael ansara .</ex:hasAnnotation>
    <ex:hasBirthplaceR>Scotland Edinburgh</ex:hasBirthplaceR>
    <ex:hasNationalityR>British</ex:hasNationalityR>
    <ex:isKnownForR>The Manitou</ex:isKnownForR>
    <ex:wasBornOnR>1946 January 16</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Charles_Dodgson">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Charles Dodgson</rdfs:label>
    <ex:hasAnnotation>Ralph tedesco is a fictional character loosely based on the historical figure . Born in the early 19th century, he contracted an incurable disease . To prevent his death, he made a pact with the jabberwocky . In exchange for the restoration of his youth and health, he sacrificed humans to wonderland .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Grimm Fairy Tales: Return to Wonderland Vol 1 6</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Joe Tyler</ex:wasCreatedByC>
    <ex:wasCreatedByC>Ralph Tedesco</ex:wasCreatedByC>
    <ex:wasCreatedByC>Raven Gregory</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sarah_Newton">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Sarah Newton</rdfs:label>
    <ex:hasAnnotation>Newton is perhaps best known for her mindjammer property, which explores transhumanism in a distant future setting . She was also the author of the zero point campaign supplement for the call of cthulhu horror roleplaying game . Her short fiction has been included in anthologies such as cubicle 7 entertainment's tie-in collection world war cthulhu .</ex:hasAnnotation>
    <ex:hasNationalityR>http://example.org/lovecraft#France</ex:hasNationalityR>
    <ex:hasWebsiteR>https://sarahnewtonwriter.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Traditional games designer</ex:isConnectedToMythosR>
  </rdf:Description>
