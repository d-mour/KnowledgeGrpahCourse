  <rdf:Description rdf:about="http://example.org/lovecraft#Deans_Corners">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Dean's Corners</rdfs:label>
    <ex:hasAccessibilityL>Road (via the Aylesbury Pike )</ex:hasAccessibilityL>
    <ex:hasAnnotation>New England , USA Township Road (via the Aylesbury Pike ) First appearance HPL : " The Dunwich Horror " Created by H. P. Lovecraft is a fictional town created by the late American author Howard Phillips Lovecraft , which was first mentioned in his short story " The Dunwich Horror ," published in 1929. Overview First referenced in the short story "The Dunwich Horror," little was said of in Lovecraft's works. Located somewhere along the Miskatonic River Valley in the fictional region of New England most commonly referred to as ' Lovecraft Country ', it can be reached via the Aylesbury Pike junction when travelling from Arkham (the other turnoff leading to the backwards and degenerate township of Dunwich ). Another small and obscure township, Aylesbury, is located nearby.</ex:hasAnnotation>
    <ex:hasTypeL>Township</ex:hasTypeL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#New_England"/>
    <ex:isLocatedAtL>USA</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Dunwich_Horror"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mnagalah">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>M'nagalah</rdfs:label>
    <ex:hasAffiliationC>Dark Giants</ex:hasAffiliationC>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Cancer God</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Nightmare's disciple is a great old one in the expanded cthulhu mythos . Originally created by len wein for dc comics . Made its first appearance in swamp thing vol 1 #8 " the lurker in tunnel 13 " .</ex:hasAnnotation>
    <ex:hasAppearanceC>Challengers of the Unknown The Trenchcoat Brigade My Life in Miniature House of Strangers The Tugging Nightmare's Disciple</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Lurker_in_Tunnel_13"/>
    <ex:wasCreatedByC>Bernie Wrightson</ex:wasCreatedByC>
    <ex:wasCreatedByC>Len Wein</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Coins_From_Yha-nthlei">
