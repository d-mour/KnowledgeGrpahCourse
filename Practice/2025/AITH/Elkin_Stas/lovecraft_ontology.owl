  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#An_Investigation_into_the_Myth-Patterns_of_Latter-day_Primitives_with_Especial_Reference_to_the_R%E2%80%99lyeh_Text">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>An Investigation into the Myth-Patterns of Latter-day Primitives with Especial Reference to the R’lyeh Text</rdfs:label>
    <ex:hasAnnotation>Laban Shrewsbury English Real World Information First appearance AWD : " The House on Curwen Street " Created by August Derleth is a fictional scholarly work created by August Derleth , attributed to his character Laban Shrewsbury . It first appeared in Derleth's story " The House on Curwen Street " (1944) and is also mentioned in his The Lurker at the Threshold (1945), " The Gorge Beyond Salapunco " (1949), and " The Keeper of the Key " (1951). The book also figures in Lin Carter 's " The Horror in the Gallery ."</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_House_on_Curwen_Street"/>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#August_Derleth"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Well_%28Tim_Jeffreys%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Well (Tim Jeffreys)</rdfs:label>
    <ex:hasAnnotation>The Well (Tim Jeffreys) Tim Jeffreys English Genre(s) Weird fiction Grim Corps Magazine #1 date February 2013  " The Well " is a Lovecraftian flash fiction piece by British Tim Jeffreys. Synopsis A man trapped at the bottom of a well is surrounded by a pack of sleeping beasts. As those at the top of the well attempt to make contact with him, their shouting awakens the creatures, dooming him to a grisly death. History "The Well" was first published in Grim Corps Magazine #1 in February 2013. Later that year it was also included in the Lovecraft -inspired collection Whispers from the Abyss .</ex:hasAnnotation>
    <ex:hasAuthorW>Tim Jeffreys</ex:hasAuthorW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Grim Corps Magazine #1</ex:isPublishedAsW>
    <ex:wasPublishedOnW>February 2013</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Thuumha">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtinctSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ServitorRaces"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Thuum'ha</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Bokrug"/>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Dagon"/>
    <ex:hasAffiliationC>Deep Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Beings of Ib</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Ibians</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The were - or possibly are - natives of the land mnar , seemingly amphibious humanoids who share numerous physical characteristics with deep ones and those that have the hybridized innsmouth look . They are described as "weak, and soft as jelly to the touch of stones and spears and arrows"</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Doom_That_Came_to_Sarnath"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Messenger_%28song%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAudioAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Messenger (song)</rdfs:label>
    <ex:hasAnnotation>The Messenger Original title Вестник (Vestnik) Nilolai Shoshunov (into russian) Korol i Shut Russia Russian Ten' klouna (Тень клоуна) Genre(s) Punk-rock Horror-punk Никитин: CD (2008) Астра: CD (2008) Ukrainian Distribution/Astra Records: MC (2008) Media type Song Date of writing 1929 (text) 2006 (music) Publication date November 20, 2008 Vestnik (literally "The Messenger" , Russian "Вестник" ) is as song by the Russian horror-punk band " Korol i Shut " ("Король и Шут") from the album "Shadow of the Clown" (Russian "Тень клоуна"), released in November 20, 2008. The lyrics of the song is taken from the poem of the same name by H. P. Lovecraft . Lyrics</ex:hasAnnotation>
    <ex:hasAuthorW>Korol i Shut</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>Russia</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror-punk</ex:hasGenreW>
    <ex:hasGenreW>Punk-rock</ex:hasGenreW>
    <ex:isInLanguageW>Russian</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Ten' klouna (Тень клоуна)</ex:isPartOfSeriesW>
    <ex:wasPublishedOnW>2008 November 20</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>1929 (text) 2006 (music)</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ghoul">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
