  <rdf:Description rdf:about="http://example.org/lovecraft#Victor_LaValle">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Victor LaValle</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Birth Date 3 February 1972 Honolulu, Hawaii, USA United States Notable Works EXP : The Ballad of Black Tom http://www.victorlavalle.com/ (born February 3, 1972 in Honolulu, Hawaii) is a writer. He has written a short story collection as well as the novels The Ecstatic, Big Machine, The Devil in Silver, and The Changeling . Mythos works The Ballad of Black Tom , a novella, was published by Tor Books on February 16, 2016. It is a retelling of the H. P. Lovecraft story " The Horror at Red Hook " from the point of view of a young black man living in Harlem with a reference to the Nation of Gods and Earths. Selected Bibliography Novellas The Ballad of Black Tom (2016) External Links at Wikipedia at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Hawaii Honolulu</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>http://www.victorlavalle.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isKnownForR rdf:resource="http://example.org/lovecraft#The_Ballad_of_Black_Tom"/>
    <ex:wasBornOnR>3 February 1972</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nevil_Jermyn">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Nevil Jermyn</rdfs:label>
    <ex:ceasedOnC>1852 Oct 19</ex:ceasedOnC>
    <ex:hasAnnotation>Arthur was the second son of the famous anthropologist and explorer robert jermyn . Robert discovered to his horror that there was a simian strain in his own family originating from a union between his grandfather wade jermyn and a female member of a race of african white apes . Robert murdered his own three children including nevil, but the two year old alfred survived .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Facts Concerning the Late Arthur Jermyn</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>His Family</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Devil_Came_to_Arkham">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Devil Came to Arkham</rdfs:label>
    <ex:hasAnnotation>The arkham detective is a novella by american byron craft . It was independently published through the createspace platform in march 2017 . Despite being set during america's prohibition era, at one point the detective notes that the entrance to astaroth's mansion is large enough to "let in a parade of sherman tanks"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Byron_Craft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Arkham_Detective"/>
    <ex:wasReleasedOnW>March 2017</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kthanid">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ElderGods"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Kthanid</rdfs:label>
    <ex:hasAffiliationC>Elder Gods</ex:hasAffiliationC>
    <ex:hasAnnotation>Elder god made its first appearance in the 1975 novel the transition of titus crow . He is the head of the pantheon of elder gods who oppose both the great old ones and outer gods .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Clock_of_Dreams"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Transition_of_Titus_Crow"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Brian_Barrs_King_in_Yellow">
