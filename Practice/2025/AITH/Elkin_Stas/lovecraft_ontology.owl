  <rdf:Description rdf:about="http://example.org/lovecraft#Journey_Into_Mystery_Vol_2_3">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Journey Into Mystery Vol 2 3</rdfs:label>
    <ex:hasAnnotation>Journey Into Mystery Vol 2 #3 Robert Bloch (original story) Ron Goulart (adaptation) United States English Marvel Comics Publication date November 21, 1972 Journey Into Mystery Vol 2 #3 is an issue of Marvel Comics ' long-running horror anthology series. It features an adaptation of Robert Bloch 's short story " The Shambler from the Stars ", written by Ron Goulart and illustrated by Jim Starlin. External Links at the Marvel Database wiki</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_Bloch"/>
    <ex:hasAuthorW>Ron Goulart</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>1972 November 21</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Alan_D._Peschke">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Alan D. Peschke</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Poet Horror is an author and poet who has contributed a handful of works to the Cthulhu Mythos inspired by the works of the late H. P. Lovecraft and his circle of friends. Selected Bibliography Poetry " In Ulthar " (1997) " Yuggoth on the Rim " (1998) Trivia A fictionalised version of Peschke was mentioned to have been a friend of the main characters in Ron Shiflet 's short story " When in Leng... ". External Links at the Internet Speculative Fiction Database</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Poet</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Floor">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Floor</rdfs:label>
    <ex:hasAnnotation>Jeff Provine English Genre(s) Weird fiction 01Publishing Whispers from the Abyss date November 2014  " " is a short story by Jeff Provine. It is inspired by the works of the late American Howard Phillips Lovecraft . Synopsis When a pair of property-flippers uncover a mind-mending mural beneath the carpets of their latest dilapidated acquisition, they destroy it before burning the house to the ground. The story's final paragraph hints that the discovery of these artefacts is a more common occurrence than the general public are led to believe. History "" was published in the anthology of H. P. Lovecraft-inspired works Whispers from the Abyss by 01Publishing in November 2014.</ex:hasAnnotation>
    <ex:hasAuthorW>Jeff Provine</ex:hasAuthorW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Whispers_from_the_Abyss"/>
    <ex:wasPublishedOnW>November 2014</ex:wasPublishedOnW>
  </rdf:Description>
