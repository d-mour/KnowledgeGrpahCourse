    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Lovecraft Library Volume 1: Horror Out of Arkham</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft United States English IDW Publishing Release Date December 6, 2011 232 is a collection of H. P. Lovecraft 's stories, featuring illustrations by Menton3. It was published by IDW Publishing in 2011 and was later followed by a second volume in 2012. Contents Introduction by Robert Weinberg " Herbert West--Reanimator " " The Unnamable " " The Colour Out of Space " " The Dunwich Horror " " The Dreams in the Witch-House " " The Thing on the Doorstep "</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
