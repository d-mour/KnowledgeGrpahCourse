    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Once Men</rdfs:label>
    <ex:hasAnnotation>Michael LaBossiere English Call of Cthulhu Genre(s) Roleplaying game Chaosium Release Date 2008 184 is a science fiction sourcebook supplement for the Call of Cthulhu horror roleplaying game. Written by Michael LaBossiere , it was published by Chaosium in 2008 as part of their Monograph of gamebooks. It is currently out of print. Synopsis References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Michael_LaBossiere"/>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>184</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2008</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Averoigne">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Averoigne</rdfs:label>
    <ex:hasAnnotation>Created by clark ashton smith is a fictional province in france . It is the setting for a series of horror fantasy stories set in a pre-modern era . The fictional land appears to based on the historical province of auvergne .</ex:hasAnnotation>
    <ex:hasAppearanceL>Out of the Aeons A Rendezvous in Averoigne The Satyr The Maker of Gargoyles The Mandrakes The Beast of Averoigne The Holiness of Azédarac The Colossus of Ylourgne The Disinterment of Venus Mother of Toads The Enchantress of Sylaire Averoigne</ex:hasAppearanceL>
    <ex:isInhabitedByL>Humans</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#France"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_End_of_the_Story"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Richard_Fry">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Richard Fry</rdfs:label>
    <ex:diedOnR>1855</ex:diedOnR>
    <ex:hasAnnotation>Brother of Lucy Fry and husband of Waite Phillips, whom he married 6 October 1811.</ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1789</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dawnward_Spire,_Lonely_Hill:_The_Letters_of_H._P._Lovecraft_and_Clark_Ashton_Smith:_1932-1937_%28Volume_2%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#ClarkAshtonSmithWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dawnward Spire, Lonely Hill: The Letters of H. P. Lovecraft and Clark Ashton Smith: 1932-1937 (Volume 2)</rdfs:label>
    <ex:hasAnnotation>The letters cover the period 1932 to 1937 . They were edited and compiled by david e. schultz with assistance from s.t. Joshi . Lovecraft kept his own ailment—cancer of the intestine—a secret from most other colleagues .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Scrag">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Scrag</rdfs:label>
    <ex:hasAlternativeNamesC>Wizard or Duke of Sheol</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Sociocultural Characteristics Also known as Wizard or Duke of Sheol Quake Real World Information First appearance Quake 1 Created by id software  The are a fictional race created by Ideas from the Deep Software for the First Person Shooter called Quake . Background In Quake , a is a kind of floating creature resembling a white cobra snake combined with a human torso that spits small yellowish green globs of poison at their opponents. floats by means of a gas bladder. If the is killed, it will fall to the ground.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Quake 1</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>id software</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Terrible_Old_Man_%28Bryan_Aiello%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Terrible Old Man (Bryan Aiello)</rdfs:label>
    <ex:hasAnnotation>The terrible old man is a reimagining of lovecraft's short story of the same name . Despite being billed as a graphic novel, it is structured as a mix between a conventional short story and a comic book . The artwork was created using dall*e 2 artificial intelligence software .</ex:hasAnnotation>
    <ex:hasAuthorW>Bryan Aiello</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>May 2023</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mount_Semura">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Mount Semura</rdfs:label>
    <ex:hasAccessibilityL>Stairway</ex:hasAccessibilityL>
    <ex:hasAnnotation>Mountain is a paradise of green gardens and perfect weather . A great tibetan-like temple is at the top, its spire reaching so high that those in the region often mistaken for the north star .</ex:hasAnnotation>
    <ex:hasNotableFeatureL>Green gardens Temple</ex:hasNotableFeatureL>
    <ex:hasTypeL>Mountain</ex:hasTypeL>
    <ex:isInhabitedByL>Ancient beings Lamas</ex:isInhabitedByL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#Secrets_of_Japan"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Asylum_%26_Other_Tales">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Asylum &amp; Other Tales</rdfs:label>
    <ex:hasAnnotation>'80 is an adventure module supplement for chaosium 's call of cthulhu roleplaying game . Consists of seven unrelated short scenarios each supplied by a different designer . Creation of the book was overseen by sandy petersen , lynn willis , and charlie krank .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>80</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>1983</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Thirteen_Plus-1_Lovecraftian_Narratives">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Thirteen Plus-1 Lovecraftian Narratives</rdfs:label>
    <ex:hasAnnotation>Nancy Kilpatrick English Genre(s) Lovecraftian fiction Release Date May 2023 201 is a collection of Lovecraftian fiction by Canadian Nancy Kilpatrick . Running to a total of 201 , it was self-published in May 2023 ; both print and digital editions were released . Overview Contents (Note: Contents taken from Amazon's "Read sample" feature, retrieved on 16 August 2024) Foreword, by S. T. Joshi "A Crazy Mistake" "Always a Castle?" "Cold Comfort" "Death Dreaming" "Eye of the Beholder" "Flesh and Bones" "Gurrl UnDeleted" "Mourning People" "Sympathy for the Devil" "The Oldies" "The Visitor" "Trogs" "Your Shadow Knows You Well" "Your Essential Unsung Hero" Acknowledgments Reception In a review in Vol 8, Issue 2 of Lovecraftiana , editor Gavin Chappell praises the book, stating that " he anthology as a whole is well textured, with running themes at some points, while at others introducing stories that come as a complete surprise " and that " the has the good grace and gratitude to praise Lovecraft’s ‘ingenious mind’ rather than sanctimoniously deplore his politics while simultaneously stealing his ideas, unlike some authors I won’t mention. " References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Nancy_Kilpatrick"/>
    <ex:hasGenreW>Lovecraftian fiction</ex:hasGenreW>
    <ex:hasPageCountW>201</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>May 2023</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Jerusalems_Lot">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Jerusalem's Lot</rdfs:label>
    <ex:hasAnnotation>Historywas first published in the 1978 collection of king's own works night shift . It has since been reprinted dozens of times in a plethora of publications . It functions as something of a follow-on or prequel to king's 1975 novel 'salem's lot .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Stephen_King"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>Dutch</ex:isInLanguageW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>Finnish</ex:isInLanguageW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:isInLanguageW>Portuguese</ex:isInLanguageW>
    <ex:isInLanguageW>Spanish</ex:isInLanguageW>
    <ex:isPublishedAsW>Night Shift</ex:isPublishedAsW>
    <ex:wasPublishedOnW>February 1978</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Secrets_of_Morocco">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Secrets of Morocco</rdfs:label>
    <ex:hasAnnotation>Eldritch explorations in the ancient kingdom is a supplement for chaosium’s iconic roleplaying game call of cthulhu . Contains a general rundown on all aspects of 1920s and 30s morocco, including political, social, geographical and cultural information . Also features a more detailed look at three of the 's more prominent cities: rabat, casablanca and marrakesh .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Jones"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>130</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>July 2008</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Atwood">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Atwood</rdfs:label>
    <ex:hasAnnotation>Professor of physics at Miskatonic University Human First appearance At the Mountains of Madness Created by H. P. Lovecraft is a character created by the late American author H. P. Lovecraft for his novella At the Mountains of Madness . Overview A member of the Miskatonic University physics department, and also a meteorologist, was a member of the Pabodie expedition to the Antarctic. Whilst there, he joined the Lake sub-expedition and was butchered by the Elder Things along with the rest of the party. Trivia In the animated film Howard Lovecraft and the Kingdom of Madness , his name is given as Jaswant .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#At_the_Mountains_of_Madness"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Children_of_the_Night">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RobertEHowardWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Children of the Night</rdfs:label>
    <ex:hasAnnotation>The story is explicitly racist, asserting and celebrating the idea of innate racial enmity . It is based on a true story, told by a man named john o'donnel .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>May 1931</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Keyport">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Keyport</rdfs:label>
    <ex:hasAccessibilityL>Road</ex:hasAccessibilityL>
    <ex:hasAnnotation>New jersey is a fictionalised town in the united states . It has featured in a number of expanded cthulhu mythos stories . Is under the sway of the esoteric order of dagon , a cult .</ex:hasAnnotation>
    <ex:hasTypeL>Town</ex:hasTypeL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#New_Jersey"/>
    <ex:isLocatedAtL>USA</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#Ancient"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Doom_of_Yakthoob">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Doom of Yakthoob</rdfs:label>
    <ex:hasAnnotation>The story concerns alhazred's education, in which he "learned the summoning-up of evil things" it was reprinted in the yuletide 1985 issue of crypt of cthulhu (#36), and again in the candlemas 1990 issue (#70)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Arkham_Collector"/>
    <ex:wasPublishedOnW>1971</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bohm">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Bohm</rdfs:label>
    <ex:ceasedOnC>1917 June 20th</ex:ceasedOnC>
    <ex:hasAffiliationC>Imperial German Navy</ex:hasAffiliationC>
    <ex:hasAnnotation>June 20th, 1917 Germany Navy Seaman (Submariner) Imperial German Navy Human First appearance HPL : " The Temple " Created by H. P. Lovecraft Seaman is a fictional character created by the late American author H. P. Lovecraft for his short story " The Temple ", in which he made his first and only appearance. Overview served aboard the German submarine U-29 under Lieutenant-Commander Karl Heinrich during the First World War. As a result of the supernatural events experienced by the crew, both and Seaman Schmidt became sick and lapsed into violent insanity. Their constant ravings concerning a "terrible curse" upon the submarine led Heinrich to execute them in order to maintain discipline.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Temple"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Wings_in_the_Night">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Wings in the Night</rdfs:label>
    <ex:hasAnnotation>The strange company was first published in the first issue of dark messenger reader in 1975 . The story is notable for featuring the first appearance of mynoghra, a great old one who would go on to appear in several other properties .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Edward_P._Berglund"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Dark Messenger Reader #1</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1975</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Wedding_of_Sheila-Na-Gog">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Wedding of Sheila-Na-Gog</rdfs:label>
    <ex:hasAnnotation>Simon of gitta is a sword-and-sorcery hero in an ancient version of clark ashton smith 's mythos setting . The story first appeared in the candlemas 1985 issue of crypt of cthulhu (#29) it was reprinted in the january 2003 issue of the black book (#3) and in the anthology the averoigne legacy (pickman's press, 2019)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Glenn_Rahman"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Richard_L._Tierney"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasGenreW>Sorcery</ex:hasGenreW>
    <ex:hasGenreW>Sword</ex:hasGenreW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Simon_of_Gitta"/>
    <ex:isPublishedAsW>February 1985</ex:isPublishedAsW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shatterer_of_Worlds">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Shatterer of Worlds</rdfs:label>
    <ex:hasAnnotation>The was a nigh-omnipotent eldritch entity from another reality . Summoned to earth by the cult of wrarrl to resurrect their master . Wrarrl consumed the souls of the cultists to boost his eldritch powers .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Denizens_of_the_Underworld_%28Call_of_Cthulhu_LCG%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Denizens of the Underworld (Call of Cthulhu LCG)</rdfs:label>
    <ex:hasAnnotation>Denizens of the Underworld Fantasy Flight Games Publication Date 2013 Living Card Game Call of Cthulhu: The Card Game Denizens of the Underworld is a deluxe expansion pack for Fantasy Flight Games ' Call of Cthulhu: The Card Game . Overview Released in 2013, Denizens of the Underworld contains a total of 165 cards (three copies each of 55 unique cards). As with most of the deluxe expansion sets it focuses on one faction, in this case the crime organisation known as the Syndicate, but also includes a small number of cards for each of the other factions, plus a handful of general-purpose cards which can be used by any faction. When Call of Cthulhu: The Card Game was replaced by Arkham Horror: The Card Game (likely due to licensing arrangements with Chaosium ), Denizens of the Underworld was discontinued. Contents Naomi O'Bannion , Ruthless Tactician (Character; Syndicate) Melisande LeBeau, Playing with Fire (Character; Syndicate) O'Bannion's Inner Council, Blood is Thicker (Character; Syndicate) Tommy Malloy, "The Big Palooka" (Character; Syndicate) Lena Di Boerio, Occult Consultant (Character; Syndicate) Jacob Finnegan, In Over His Head (Character; Syndicate) Henry Knoll, A Real Wiseguy (Character; Syndicate) Martin Herring, "Quick Kip" (Character; Syndicate) Isaac Miles, Willing to Lend an Ear (Character; Syndicate) Clover Club High Roller (Character; Syndicate) Clover Club Ringer (Character; Syndicate) Clover Club Pit Boss (Character; Syndicate) Numbers Runner (Character; Syndicate) Fall Guy (Character; Syndicate) Marine Salvager (Character; Syndicate) Cat Burglar (Character; Syndicate) Crooked Attorney (Character; Syndicate) Hatchet Man (Character; Syndicate) Wheelman (Character; Syndicate) The Clover Club, Den of Iniquity (Support; Syndicate) Danny O'Bannion 's Office, "Now Hiring" (Support; Syndicate) Under Cover of Darkness (Support; Syndicate) House Advantage (Support; Syndicate) City Map (Support; Syndicate) Concrete and Chains (Support; Syndicate) Indebted (Support; Syndicate) Length of Pipe (Support; Syndicate) La Bella Luna, Seedy Restaurant (Support; Syndicate) Made Man (Support; Syndicate) Immurement (Event; Syndicate) On the Lam (Event; Syndicate) Reallocate (Event; Syndicate) Forced Compliance (Event; Syndicate) Pay Tribute (Event; Syndicate) Turf War (Event; Syndicate) Roll the Dice (Event; Syndicate) A Cunning Ruse (Conspiracy; Syndicate) Wandering Tinker (Character; Neutral) Zstylzhemgni , Matriarch of Swarms (Character; Neutral) Sarnath , Too Proud (Support; Neutral) Outmaneuvered (Event; Neutral) Special Agent Callahan, Always Gets His Man (Character; The Agency) Deep Undercover (Event; The Agency) Robert Friendly, Disgruntled Dockworker (Character; Cthulhu ) Calculated Mutation (Event; Cthulhu) Jeff Harson, Manic Musician (Character; Hastur ) Hali's Directive (Event; Hastur) Elijah Conrad, Distinguished Alumnus (Character; Miskatonic University ) Strategic Planning (Event; Miskatonic University) Bill Strauss, Blessed of Shub-Niggurath (Character; Shub-Niggurath ) Ambush (Event; Shub-Niggurath) Josef Meiger, Metaphysicist (Character; Silver Twilight) Hoarding Knowledge (Event; Silver Twilight) Sebastion Blake, Attuned to the Universe (Character; Yog-Sothoth ) Mind Swap (Event; Yog-Sothoth) Gallery</ex:hasAnnotation>
    <ex:wasPublishedOnW>2013</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Khats">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Khats</rdfs:label>
    <ex:hasAnnotation>The are a fictional race in the marvel universe which first appeared in 1986 in issue #77 of the 2nd volume of the dr. Strange comic book series . They are a race of demonic cat-like beings with claws whose touch caused physical damage .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Dr. Strange Vol 2 #77</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Chris Warner</ex:wasCreatedByC>
    <ex:wasCreatedByC>Peter B. Gillis</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Manhattan_Museum_of_Fine_Arts">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Manhattan Museum of Fine Arts</rdfs:label>
    <ex:hasAnnotation>The is a fictional institution located in new york city, created by frank belknap long . The museum becomes enmeshed in horror when it acquires what it thinks is a statue of the entity chaugnar faugn . The museum's field workers have included richardson, who was tortured to death by the followers of chaugnar faugn .</ex:hasAnnotation>
    <ex:hasTypeL>Museum</ex:hasTypeL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#New_York_City"/>
    <ex:isLocatedAtL>New York</ex:isLocatedAtL>
    <ex:isLocatedAtL>USA</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Horror_from_the_Hills"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dh%C3%B4l_Chants">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Dhôl Chants</rdfs:label>
    <ex:hasAnnotation>The , or dhol chants , is the name of two fictional books in the cthulhu mythos . The original was created by h. p. lovecraft in his story " the horror in the museum" the spells of vengeance usually work only after the death of the caster .</ex:hasAnnotation>
    <ex:hasFunctionA>Book</ex:hasFunctionA>
    <ex:hasPlaceOfOriginA>Plateau of Leng (Leng book)</ex:hasPlaceOfOriginA>
    <ex:hasTypeA>Data Storage</ex:hasTypeA>
    <ex:hasTypeA>Transmission</ex:hasTypeA>
    <ex:madeFirstAppearanceOnA>Dead of Night (German book)</ex:madeFirstAppearanceOnA>
    <ex:madeFirstAppearanceOnA>The Horror in the Museum (Leng book)</ex:madeFirstAppearanceOnA>
    <ex:wasCreatedByA>Heinrich Zimmerman (German book)</ex:wasCreatedByA>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Haunter_of_the_Ring">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RobertEHowardWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Haunter of the Ring</rdfs:label>
    <ex:hasAnnotation>The malicious joseph roelocke gifts a woman who rejected him a possessed ring, which causes her to attempt to murder her husband . Unfortunately for roelocke, the evil entity which inhabits the ring turns on him and rends his soul from his body .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>June 1934</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Aihai">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ServitorRaces"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Aihai</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Vulthoom"/>
    <ex:hasAffiliationC>The Dweller in the Gulf</ex:hasAffiliationC>
    <ex:hasAnnotation>The are a species of alien created by the late american author clark ashton smith for his 1932 short story " the vaults of yoh-vombis " they possess a tough, leathery hide, a triple-nostrilled nose, sunken eyes, twin sets of sharp teeth, four-jointed fingers, and satyr-like legs .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Vulthoom"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Ye_Booke_of_Monstres_II"/>
    <ex:hasAppearanceC>The Dweller in the Gulf</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Vaults_of_Yoh-Vombis"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Aaron_J._French">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonFictionAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Aaron J. French</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Editor Weird Occult Dark Fiction https://aaronjfrench.com/ is an author, editor and essayist whose works fall for the most part into the weird, occult and dark fantasy genres. He has produced a number of works set within the Cthulhu Mythos inspired by the late H. P. Lovecraft . Selected Bibliography Editor The Shadow of the Unknown (2011) The Gods of H. P. Lovecraft (2015) Azathoth: Ordo ab Chao (2023) Short Fiction " My Stalk " (2014)</ex:hasAnnotation>
    <ex:hasWebsiteR>https://aaronjfrench.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Xothic_Legend_Cycle:_The_Complete_Mythos_Fiction_of_Lin_Carter">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Xothic Legend Cycle: The Complete Mythos Fiction of Lin Carter</rdfs:label>
    <ex:hasAnnotation>Chaosium release date 1997 is a collection of lin carter's cthulhu mythos fiction . It contains the five stories that make up the xothic legend cycle . In october 2004, it received a german-release through festa as part of their h. p. lovecraft's bibliothek des schreckens series .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:wasReleasedOnW>1997</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Drowned_Geologist_%281898%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#CaitlinRKiernanWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Crossovers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Drowned Geologist (1898)</rdfs:label>
    <ex:hasAnnotation>"the drowned geologist (1898)" is a short story by caitlin r. kiernan . It combines the fictional worlds of h.p. Lovecraft, arthur conan doyle and bram stoker . The story is narrated by paleontologist tobias logan .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Shadows_Over_Baker_Street"/>
    <ex:wasPublishedOnW>2003</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ronnie_and_the_River">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Ronnie and the River</rdfs:label>
    <ex:hasAnnotation>Ronnie is a quiet, unassuming young man with down's syndrome and a love of painting . One evening, while working at the university, ronnie uncovers a secret trapdoor which he proceeds to investigate . When he emerges a little while later, something about him has changed, although he doesn’t realise it .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Christian_Riley"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Weirdbook Annual 2</ex:isPublishedAsW>
    <ex:wasPublishedOnW>February 2019</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Odin">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Odin</rdfs:label>
    <ex:hasAffiliationC>Elder Gods ( Demonbane )</ex:hasAffiliationC>
    <ex:hasAffiliationC>Norse Gods</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Godan</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The All Father</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Gray Man</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Raven God</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Wednesday Man</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Wōtan</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Demonbane is a diety in norse mythology, the ruler of asgard and chief god of the sir tribe of deities . Appears as the main antagonist of robert e. howard 's short story " the cairn on the headland " hundreds of years later, was dug up to be resurrected .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Demonbane"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Cairn_on_the_Headland"/>
    <ex:madeFirstAppearanceOnC>Poetic Edda</ex:madeFirstAppearanceOnC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Averoigne_Archives:_The_Complete_Averoigne_Tales_of_Clark_Ashton_Smith">
    <rdf:type rdf:resource="http://example.org/lovecraft#ClarkAshtonSmithWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Averoigne Archives: The Complete Averoigne Tales of Clark Ashton Smith</rdfs:label>
    <ex:hasAnnotation>Clark Ashton Smith Tim Kirk Cover Artist Jairo Geovanny Veintimilla Andrade (ebook edition) Manshuri Yusuf (paperback edition) United States English Averoigne Pickman's Press Release Date June 2019 203 is a collection of Smith's Averoigne of Cthulhu Mythos -related short fiction, and includes a map of the region by Tim Kirk . It was issued by independent publishing house Pickman's Press in June 2019; both digital and paperback editions were released. Overview Contents Introduction by Ron Hilger " Mother of Toads " " The Maker of Gargoyles " " The Holiness of Azédarac " "A Night in Malnéant" " The Colossus of Ylourgne " " The Enchantress of Sylaire " " The Beast of Averoigne " " The Mandrakes " " A Rendezvous in Averoigne " " The Disinterment of Venus " " The Satyr " " The End of the Story " " Averoigne " Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>203</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Averoigne"/>
    <ex:wasReleasedOnW>June 2019</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Hawkins">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Hawkins</rdfs:label>
    <ex:ceasedOnC>1925</ex:ceasedOnC>
    <ex:hasAnnotation>1925 Human First appearance HPL : " The Call of Cthulhu " Created by H. P. Lovecraft is a fictional character created by H. P. Lovecraft , who makes his only appearance in the 1928 short story " The Call of Cthulhu ". Overview was a member of the Emma of Auburn, although his role is uncertain. When Donovan successfully opened Cthulhu 's vault in R'lyeh , the "quick-eared" was the first to hear the creature's "nasty, slopping sound." As the crew continued to listen, Cthulhu emerged, killing Donovan, Guerrera and Angstrom . ' fate isn't made explicit, but as he did not escape the island with Gustaf Johansen and William Briden , his death by Cthulhu may have simply gone unwritten, or he might have been swallowed with Cthulhu when R'lyeh re-submerged.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Call_of_Cthulhu"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Jaap_Boekestein">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Jaap Boekestein</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Birth Date 8 April 1968 Naaldwijk, South Holland, Netherlands Netherlands http://www.jaapboekestein.com/ is a Dutch author, artist and critic who writes in both his native language and English. He has written a number of works set in the greater Cthulhu Mythos : these have been published in collections such as Lovecraft after Dark (2015, James Ward Kirk Publishing) and Urban Temples of Cthulhu (2016, First United Church of Cthulhu ). Selected Works Short Fiction " Under the Keeper of the Key " (2015) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>Naaldwijk Netherlands South Holland</ex:hasBirthplaceR>
    <ex:hasNationalityR>Netherlands</ex:hasNationalityR>
    <ex:hasWebsiteR>http://www.jaapboekestein.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>8 April 1968</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Andrew_Doran_Omnibus:_Volume_1">
    <rdf:type rdf:resource="http://example.org/lovecraft#CrossroadPress"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Andrew Doran Omnibus: Volume 1</rdfs:label>
    <ex:hasAnnotation>Matthew Davenport Cover Artist Putnam Finch English Andrew Doran Crossroad Press Release Date November 2021 828 is a collection of the Andrew Doran of Cthulhu Mythos fiction by American Matthew Davenport . Running to a total of 828 , it was published in digital format by Crossroad Press in November 2021. Overview Contents Introduction "The Early Adventures of Andrew Doran" "Andrew Doran and the Forever Gate" "Andrew Doran and the Journey to the Serpent Temple" The Statement of Andrew Doran Andrew Doran at the Mountains of Madness "Andrew Doran and the Obsidian Key" Andrew Doran and the Crawling Caves Andrew Doran and the Scroll of Nightmares</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Matthew_Davenport"/>
    <ex:hasPageCountW>828</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Andrew Doran</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>November 2021</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Return_to_Wonderland">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Return to Wonderland</rdfs:label>
    <ex:hasAnnotation>Raven Gregory, Linda Ly Richard Bonk English Zenescope Entertainment Release Date May 2007-Feb 2008 Media Type Comic book is a seven-issue comic book mini-series written by Raven Gregory and Linda Ly in 2007-2008 which was published by Zenescope Entertainment as the first series in their Wonderland franchise. Synopsis Years after Alice Liddle went down the rabbit hole, she has a family of her own. Yet all is not right with Alice and her daughter Calie Liddle is forced to take a journey into the Wonderland , the "realm of madness." Continuity Wonderland is the same location as Limbo or R'lyeh , and is the source of madness which influenced Hitler, Jack the Ripper and Elizabeth Bathory among others.</ex:hasAnnotation>
    <ex:hasAuthorW>Linda Ly</ex:hasAuthorW>
    <ex:hasAuthorW>Raven Gregory</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>May 2007-Feb 2008</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tatsu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SpeciesIncorporatedFromFolkloreMythAndReligion"/>
    <rdfs:label>Tatsu</rdfs:label>
    <ex:hasAnnotation>Dragons originated in chinese mythology (long) and spread to korean (yong), vietnamese (rng), and japanese () mythology . Dragons are the personification of earth's life force, gaia's living will . Dragons can communicate with humans via telepathy, projecting images, and use electricity, chi, and spirit .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Secrets_of_Japan"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Scorn">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Scorn</rdfs:label>
    <ex:hasAnnotation>'s atmosphere and themes strongly resonate with the works of h.p. Lovecraft . The game's narrative is intentionally vague, leaving much to the player's interpretation . Released in october 2022 for microsoft windows and xbox series x/s, and later for playstation 5 in october 2023 .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Walker_in_the_Wastes">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Walker in the Wastes</rdfs:label>
    <ex:hasAnnotation>John H. Crowe III Dennis Detwiller Cover Artist Blair Reynolds English Call of Cthulhu Genre(s) Roleplaying game Pagan Publishing Release Date 1994 is a campaign supplement for Chaosium 's Call of Cthulhu horror roleplaying game. Written by John H. Crowe III and featuring artwork by Blair Reynolds and Dennis Detwiller , it was published by third-party content provider Pagan Publishing in 1994 . Overview Design Team Written by: John H. Crowe III Artwork by: Jeff Barber , Dennis Detwiller , and Blair Reynolds Production staff: Brian Appleton, Jeff Barber, John Tynes Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#John_H._Crowe_III"/>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>1994</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Howard_Phillips_Lovecraft_3">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Howard Phillips Lovecraft 3</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft Cover Artist Virgil Finlay France French Robert Laffont Release Date March 1992 1341 is a French- collection of the works of late American H. P. Lovecraft , which includes a selection of collaborations with other authors, the stories " written posthumously " with August Derleth , and a number of Mythos stories credited solely to Derleth. Published in March 1992 by Robert Laffont, a second edition was issued in September 2016 . Contents "Sur le tapis volant du rêve" by Francis Lacassin "Polaris" (" Polaris ") "Le bateau blanc" (" The White Ship ") "La malédiction de Sarnath" (" The Doom That Came to Sarnath ") "L'arbre" (" The Tree ") "Les chats d'Ulthar" (" The Cats of Ulthar ") "Les autres dieux" (" The Other Gods ") "Céléphaïs" (" Celephaïs ") "La quête d'Iranon" (" The Quest of Iranon ") "Le témoignage de Randolph Carter" (" The Statement of Randolph Carter ") "À la recherche de Kadath" ( The Dream-Quest of Unknown Kadath ) "La clé d'argent" (" The Silver Key ") "À travers les portes de la clé d'argent" with E. Hoffmann Price (" Through the Gates of the Silver Key ") "Rêves et chimères" (" Dreams and Fancies ") "Quand Lovecraft s'amuse" by Francis Lacassin "Quelques souvenirs sur le Dr. Johnson" (" A Reminiscence of Dr. Samuel Johnson ") "Old bugs" (" Old Bugs ") "Douce Ermengarde" (" Sweet Ermengarde ") "Ibid" (" Ibid ") "Alfredo" (" Alfredo: A Tragedy ") "La bataille qui marqua la fin du siècle" with R. H. Barlow (" The Battle That Ended the Century ") "August Derleth ou le saint Paul du Lovecratisme" by Francis Lacassin Le rôdeur devant le seuil with August Derleth ( The Lurker at the Threshold ) "Le survivant" with August Derleth (" The Survivor ") "Le jour à Wentworth" with August Derleth (" Wentworth's Day ") "L'héritage Peabody" with August Derleth (" The Peabody Heritage ") "La lampe d'Alhazred" with August Derleth (" The Lamp of Alhazred ") "La fenêtre à pignon" with August Derleth (" The Gable Window ") "L'ancêtre" with August Derleth (" The Ancestor ") "L'ombre venue de l'espace" with August Derleth (" The Shadow Out of Space ") "Le retour d'Hastur" by August Derleth (" The Return of Hastur ") "Les engoulevents de la colline" by August Derleth (" The Whippoorwills in the Hills ") "Quelque chose en bois" by August Derleth (" Something in Wood ") "Le pacte des Sandwin" by August Derleth (" The Sandwin Compact ") "La maison dans la vallée" by August Derleth (" The House in the Valley ") "Le sceau de R'lyeh" by August Derleth (" The Seal of R'lyeh ") "La maison de Curwen street" by August Derleth (" The Trail of Cthulhu ") "La vigie céleste" by August Derleth (" The Watcher from the Sky ") "La gorge au-delà de Salapunco" by August Derleth (" The Testament of Claiborne Boyd ") "Le gardien de la clé" by August Derleth (" The Keeper of the Key ") "L'île noire" by August Derleth (" The Black Island ") "La chambre condamnée" with August Derleth (" The Shuttered Room ") "Le pêcheur du Falcon Point" with August Derleth (" The Fisherman of Falcon Point ") "Le trou des sorcières"with August Derleth (" Witches' Hollow ") "L'ombre dans la mansarde" with August Derleth (" The Shadow in the Attic ") "Les frères de la nuit" with August Derleth (" The Dark Brotherhood ") "L'horreur de l'arche centrale" with August Derleth (" The Horror from the Middle Span ") "L'argile bleue d'Innsmouth" with August Derleth (" Innsmouth Clay ") "Les veilleurs hors du temps" with August Derleth (" The Watchers Out of Time ") "Un loyal sujet de sa gracieuse majesté" by Francis Lacassin "Description de la ville de Québec…" (" A Description of the Town of Quebeck, in New Fance, Lately added to His Britannick Majesty's Dominions ") "De quelques empreintes hollandaises en Nouvelle-Angleterre" (" Some Dutch Footprints in New England ") "Aperçus européens" with Sonia Greene (" European Glimpses ") "Mars est-il un monde habité ?" (" Is Mars an Inhabited World? ") "Le cosmos et la religion" (" The Cosmos &amp; Religion ") "L'incantation de Red Hook" (" The Incantation from Red Hook ") "La confession d'un incroyant" (" A Confession of Unfaith ") "Sur le catholicisme" (original title unknown ) "Merlinus Redivivus" (" Merlinus Redivivus ") "Le cancer de la superstition" with C. M. Eddy, Jr. (" The Cancer of Superstition ") "Les limites du surnaturel" (original title unknown ) "Le temps et l'espace" (" Time and Space ") "Héritage ou modernisme : l'intelligence de l'art" (" Heritage or Modernism: Common Sense in Art Forms ") "Idéalisme et matérialisme : une réflexion" (" Idealism and Materialism: A Reflection ") "Nietzschéisme et réalisme" (" Nietzscheism and Realism ") "À la racine" (" At the Root ") "La renaissance de l'humanité" (" The Renaissance of Manhood ") "Le crime du siècle" (" The Crime of the Century ") "La Vieille Angleterre et le "trait d'union"" (" Old England and the "Hyphen" ") "L'américanisme" (" Americanism ") "Le monde anglo-saxon" (" Anglo-Saxondom ") "La coalition loyale" (" The Loyal Coalition ") Bibliographie by Jean-Luc Buard "Répertoire commenté de la critique lovecraftienne de langue française (1936-1991)" by Jean-Luc Buard Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW rdf:resource="http://example.org/lovecraft#France"/>
    <ex:hasPageCountW>1341</ex:hasPageCountW>
    <ex:isInLanguageW>French</ex:isInLanguageW>
    <ex:wasReleasedOnW>March 1992</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Jendicks_Swamp">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Jendick's Swamp</rdfs:label>
    <ex:hasAnnotation>The story is set in the fictional town of greystone bay, created by charles l. grant for the multi- anthology of the same name . The area is named after the jendicks, a supposedly extinct family of squatters who lived there . A hunter who got lost in the swamp found the supposedly abandoned house, and fled in terror after he saw a pair of eyes watching him from the window .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Joseph_Payne_Brennan"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>Italian</ex:isInLanguageW>
    <ex:isPublishedAsW>Doom City</ex:isPublishedAsW>
    <ex:wasPublishedOnW>December 1987</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mystic_Arcana">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Mystic Arcana</rdfs:label>
    <ex:hasAnnotation>Louise Simonson, Roy Thomas, Jeff Parker, C.B. Cebulski Steve Scott, Phil Noto, Scott Hanna, Tom Grummett, Juan Santacruz English Marvel Comics Release Date Aug 2007- Jan 2008 Media Type Comic book is a 4-issue miniseries written by multiple writers, in which each issue is focused on one character (Magik, Black Knight, Scarlet Witch, and Sister Grimm being the featured heroes). Synopsis Various magic using heroes are manipulated by the Elder God Chthon in his attempt to return to Earth .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Roy_Thomas"/>
    <ex:hasAuthorW>C.B. Cebulski</ex:hasAuthorW>
    <ex:hasAuthorW>Jeff Parker</ex:hasAuthorW>
    <ex:hasAuthorW>Louise Simonson</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>Aug 2007- Jan 2008</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Necronomicon:_The_Dawning_of_Darkness_%28video_game%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Necronomicon: The Dawning of Darkness (video game)</rdfs:label>
    <ex:hasAnnotation>Necronomicon: the dawning of darkness is a 2001 video game developed by wanadoo edition . The game is set in 1927, where the ordinary life of william h. stanton is affected by matters of the occult and darker truths about our world . The player has to solve a series of puzzles and question shady people to uncover the truth about the horrible fate that has befallen edgar .</ex:hasAnnotation>
    <ex:wasPublishedOnW>2000 October 23</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Resurrected_Volume_One:_Grace_Under_Pressure">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Resurrected Volume One: Grace Under Pressure</rdfs:label>
    <ex:hasAnnotation>Jeff Barber John Tynes Jeff Barber Blair Reynolds English Call of Cthulhu Genre(s) Roleplaying game Pagan Publishing Release Date 1993 Followed by The Resurrected Volume Two: Of Keys &amp; Gates is a scenario sourcebook for Chaosium 's Call of Cthulhu horror roleplaying game released by third-party content provider Pagan Publishing in 1993. Written by Jeff Barber and John Tynes , it featured artwork by Barber and Blair Reynolds . The book was published as part of Pagan's sporadically-released The Resurrected , which reprinted rare and out of print material originally appearing in the gaming magazine The Unspeakable Oath . Overview Grace Under Pressure contains a complete, stand-alone adventure for Call of Cthulhu , first published in The Unspeakable Oath #2 in 1991 , and includes a selection of pre-generated characters, maps and handouts. Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Jeff_Barber"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#John_Tynes"/>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>1993</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ravormos">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Ravormos</rdfs:label>
    <ex:hasAccessibilityL>Tunnel network from the surface</ex:hasAccessibilityL>
    <ex:hasAnnotation>Beneath the surface of Mars Subterranean city Tunnel network from the surface CIRCLE : Vulthoom CIRCLE : A sect of Aihai First appearance CIRCLE : " Vulthoom " Created by Clark Ashton Smith is a subterranean city located beneath the surface Mars . Home to a radical offshoot sect of the indigenous Aihai , it is the current home of Vulthoom , a malevolent alien (possibly extra-dimensional) entity who is worshipped by these creatures. Trivia Death/doom metal band Burial released a track on their album The Aeons of Horror .</ex:hasAnnotation>
    <ex:hasTypeL>Subterranean city</ex:hasTypeL>
    <ex:isInhabitedByL rdf:resource="http://example.org/lovecraft#Vulthoom"/>
    <ex:isInhabitedByL>A sect of Aihai</ex:isInhabitedByL>
    <ex:isLocatedAtL>Beneath the surface of Mars</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#Vulthoom"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Necro-Nom-Nom-Nom-I-Con">
    <rdf:type rdf:resource="http://example.org/lovecraft#Crossovers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosFilmAndTelevision"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Necro-Nom-Nom-Nom-I-Con</rdfs:label>
    <ex:hasAnnotation>The episode was written by luke brookshier and first aired in 2024 . It was based on the necronomicon ex-mortis from the evil dead franchise .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2024 February 26</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Stone_City,_Old_As_Immeasurable_Time">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Stone City, Old As Immeasurable Time</rdfs:label>
    <ex:hasAnnotation>A grieving mother is drawn to a temple where she believes her dead children will be returned to her by an ancient earth mother . These creatures will not be entirely human, and are believed by the locals to be harbingers of something far darker .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Deborah_Walker"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>June 2014</ex:isPublishedAsW>
    <ex:isPublishedAsW>Niteblade</ex:isPublishedAsW>
    <ex:wasPublishedOnW>June 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Eyes_Like_Red_Balls_of_Flame">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Eyes Like Red Balls of Flame</rdfs:label>
    <ex:hasAnnotation>Glynn Owen Barrass Jon Gibbons English Call of Cthulhu Genre(s) Roleplaying game Stygian Fox Release Date 2020 is a short scenario supplement for the Cthulhu by Gaslight setting of Chaosium 's Call of Cthulhu horror roleplaying game. Written by Glynn Owen Barrass and featuring artwork by Jon Gibbons, it was published by Stygian Fox in 2020 . Overview Production Team Writer: Glynn Owen Barrass Artwork: Jon Gibbons Book Design: Badger McInnes &amp; Leigh Woosey Handouts: Dean Engelhardt Editor: Chitin Proctor Cartography: Stephanie McAlea Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Glynn_Owen_Barrass"/>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2020</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bunyip">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonSapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SpeciesIncorporatedFromFolkloreMythAndReligion"/>
    <rdfs:label>Bunyip</rdfs:label>
    <ex:hasAnnotation>The is a type of man-eating aquatic monster that lurks in lakes and billabongs . It has been incorporated into the mythos by the role-playing game call of cthulhu . When hunting, they produce a distinctive sound described as "dire and desolate as death"</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Terror_Australis"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Revelations_of_Glaaki">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosBooksFictional"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>The Revelations of Glaaki</rdfs:label>
    <ex:hasAlternativeNamesA>The Secret Revelations of Glakki</ex:hasAlternativeNamesA>
    <ex:hasAnnotation>The revelations of glaaki is a fictional grimoire in the expanded cthulhu mythos . It was originally created by ramsey campbell for his short story " the inhabitant of the lake " the book was published in a pirated, edited 9 volume version, published in 1865 as a folio, which is more common . A rumour claims that originally there were only 11 volumes but a man on mercy hill (england) dreamed and wrote the 12th volume</ex:hasAnnotation>
    <ex:hasAppearanceA>I Stand at the Door</ex:hasAppearanceA>
    <ex:hasAppearanceA>Knock The Lakeside Cottages</ex:hasAppearanceA>
    <ex:hasAppearanceA>The Plain of Sound The Tugging Behold</ex:hasAppearanceA>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_Inhabitant_of_the_Lake"/>
    <ex:wasCreatedByA rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Eldritch_Horrors:_Dark_Tales">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Eldritch Horrors: Dark Tales</rdfs:label>
    <ex:hasAnnotation>Various English H. Harksen Productions Release Date 2009 306 is an anthology of Lovecraftian fiction edited by Henrik Sandbeck Harksen and published by H. Harksen Productions in 2009. Overview Contents Introduction: Opening the Doors to Unspeakable Realms by Henrik Sandbeck Harksen "Recompense of Sorrow" by W. H. Pugmire "One Thousand and One Words" by Paul S. Kemp "Ashanna's Whispers" by Simon Bleaken "Devouring Darkness Hovers" by Thomas Strømsholt "The Specimen" by Linda Navroth "Rest in Peace, Jeremy Crandall" by Gary Hill "The Bibliophile" by Henrik Sandbeck Harksen "A Haunting from Beyond" by Benjamin Szumskyj "The Door to Nowhere" by Blake Wilson " Out of the Frying Pan " by Ron Shiflet "The Dying God" by Dan Clore "The People of the Island" by Paul Mackintosh "The Return of Zoth-Ommog" by Leigh Blackmore "The Jest of Yig" by Don Webb</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>306</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2009</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kandar_the_Destroyer">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Kandar the Destroyer</rdfs:label>
    <ex:hasAnnotation>Demon was unleashed by the dark ones to test mankind's mettle . It was impervious to all types of attacks (e.g. Bullets, explosives) except for the kandarian dagger which could kill it .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Episode 9)</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>Judgement Day (Ash vs. Evil Dead</ex:madeFirstAppearanceOnC>
    <ex:madeFirstAppearanceOnC>Season 3</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Rick Jacobson</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Worm_that_Gnaws_in_the_Night">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>The Worm that Gnaws in the Night</rdfs:label>
    <ex:hasAlternativeNamesC>Doom of Shaggai</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The worm is a massive polychaete worm-like fiend that was observed by the wizard eibon . He noticed that it was slowly eating away at the planet shaggai . The elder gods couldn't even handle it and the worm has survived the radiation from ghroth , the outer god who destroyed all life on that planet .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Shaggai"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Codex_Lammas_1997">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Codex Lammas 1997</rdfs:label>
    <ex:hasAnnotation>Various Paul Monteleone Cover Artist Pavel P. Lujardo English Necronomicon Press Release Date August 1997 40 Preceded by Eastertide 1997 Followed by Hallowmas 1997 is the eleventh issue of the Necronomicon Press fanzine Cthulhu Codex . Running to a total of 40 , it was edited by Robert M. Price , featured cover art by Pavel P. Lujardo, and was published in August 1997. Contents Editorial: From the Scriptorium by Robert M. Price " The Shadow Over Uxmal " by Will Murray "Still There" by Darrell Schweitzer "On Dead Gods" by Roger Johnson "The Box from the Attic" by Jennifer McIlwee Myers "One for the Books" by Mark Francis " R'lyeh Rising " by John R. Fultz " Servile " by Jeffrey Thomas " Folks of Innsmouth " by Franklyn Searight "Carven Faces" by Alan Gullette " Music of Mi-Go " by Chad Hensley</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>40</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>August 1997</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Hank_Samson">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Hank Samson</rdfs:label>
    <ex:hasAlternativeNamesC>The Farmhand</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The farmhand is a character created by fantasy flight games . First appeared in the arkham horror expansion innsmouth horror . Has since appeared in a number of other fantasy flight works .</ex:hasAnnotation>
    <ex:hasAppearanceC>See list</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC>Innsmouth Horror</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Fantasy_Flight_Games"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Hasuta">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Hasuta</rdfs:label>
    <ex:hasAffiliationC>Carcosa Computer Entertainment</ex:hasAffiliationC>
    <ex:hasAffiliationC>Space Defense Agency</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#Hastur"/>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#The_King_in_Yellow"/>
    <ex:hasAnnotation>Hastur is an extraterrestrial entity from the fictional universe of the haiyore! Nyaruko-san series . He is a childhood friend of nyaruko and kuuko . His father is the owner of the carcosa computer entertainment corporation . He was the inspiration for the character " hastur " from the cthulhu mythos .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Haiyore! Nyaruko-san Vol. 8</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Koin</ex:wasCreatedByC>
    <ex:wasCreatedByC>Manta Aisora</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Abbie_E._Phillips">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Abbie E. Phillips</rdfs:label>
    <ex:diedOnR>1873</ex:diedOnR>
    <ex:hasAnnotation>Wife of Jeremiah E. Phillips, to whom she gave four children.</ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1839</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Glove:_A_Tale_Of_The_King_In_Yellow">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Glove: A Tale Of The King In Yellow</rdfs:label>
    <ex:hasAnnotation>Short story was published in the 2018 collection horrors &amp; abominations: 24 tales of the cthulhu mythos .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mark_McLaughlin"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Abominations: 24 Tales of the Cthulhu Mythos</ex:isPublishedAsW>
    <ex:isPublishedAsW>Horrors</ex:isPublishedAsW>
    <ex:wasPublishedOnW>December 2018</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Miskatonic_River">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Miskatonic River</rdfs:label>
    <ex:hasAnnotation>The miskatonic is a fictional river in massachusetts , created by h. p. lovecraft . It links two of the most important settings in lovecraft country -- arkham and dunwich . The river is the source of the name of miskatonic university .</ex:hasAnnotation>
    <ex:hasAppearanceL>The Strange High House in the Mist The Dunwich Horror The Dreams in the Witch-House</ex:hasAppearanceL>
    <ex:hasTypeL>River</ex:hasTypeL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Lovecraft_Country"/>
    <ex:madeFirstAppearanceOnL>The Picture in the House (unnamed)</ex:madeFirstAppearanceOnL>
    <ex:madeFirstAppearanceOnL>The Silver Key (named)</ex:madeFirstAppearanceOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Professor_Bradley">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Professor Bradley</rdfs:label>
    <ex:hasAffiliationC>Columbia College</ex:hasAffiliationC>
    <ex:hasAnnotation>Elizabeth berkeley is a fictional character who appears in " the green meadow ", a story written by h. p. lovecraft based on a dream by winifred v. jackson . In the story, bradley is an expert who studies a metallic rocklike object that lands off the coast of potowonket, maine .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Green_Meadow"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasCreatedByC>Elizabeth Berkeley</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Starro">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Starro</rdfs:label>
    <ex:hasAnnotation>The conqueror is an extraterrestrial entity from the fictional universe of dc by dc comics . He resembles a giant one-eyed starfish and enslaves entire planets by sending millions of smaller drones to attach to his victims' faces, mind-controlling them in the process . Attempted to conquer earth several times, although he was defeated by the justice league every time .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ysbaddaden">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Ysbaddaden</rdfs:label>
    <ex:hasAnnotation>Scathach is a fictional extraterrestrial being created by american author kevin l. o'brien for his short cthulhu mythos story " october surprise " . Chief of giants is the name of a character from welsh mythology which is loosely related to the legend of king arthur .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#October_Surprise"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Kevin_L._OBrien"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Haiogh-Yai">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OuterGods"/>
    <rdfs:label>Haiogh-Yai</rdfs:label>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#The_Outsider"/>
    <ex:hasAnnotation>Also known as The Outsider First appearance EXP : " The Outsider " Created by James Ambuehl is a monstrous, amorphous, whirling entity who took his abode within a wandering black hole called Vix'ni-Aldru in the Elder Lore. It also hosts a city made of titanic blocks, inhabited by mysterious creatures resembling either worms or lizards ( Servitors of ). Behind the Mythos was created by James Ambuehl as part of the Lu-Kthu Cycle .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Outsider"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#James_Ambuehl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#So_Runs_the_World_Away">
    <rdf:type rdf:resource="http://example.org/lovecraft#CaitlinRKiernanWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>So Runs the World Away</rdfs:label>
    <ex:hasAnnotation>The story was first published in 2001 in the mammoth book of vampire stories by women . It was later reprinted in kiernan's collection to charles fort, with love, and in their 2018 cthulhu mythos omnibus . The story introduces characters and settings that will play important roles in later fiction .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Caitlin_R._Kiernan"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>Portuguese</ex:isInLanguageW>
    <ex:isPublishedAsW>The Mammoth Book of Vampire Stories by Women</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2001</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ancient">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Ancient</rdfs:label>
    <ex:hasAnnotation>" history" is a short cthulhu mythos story by american armand rosamilia . It forms the first part of his keyport cthulhu story cycle . " History" is first published in the chapbook : a keyport cthulhu tale in 2012 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Armand_Rosamilia"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Keyport_Cthulhu"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Ancient:_A_Keyport_Cthulhu_Tale"/>
    <ex:wasPublishedOnW>July 2012</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Wonderland:_Down_the_Rabbit_Hole">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Wonderland: Down the Rabbit Hole</rdfs:label>
    <ex:hasAnnotation>Patrick Shand, Raven Gregory Gregbo Watson, Yusuf Idrias English Zenescope Entertainment Release Date May 2013 - October 2013 Media Type Comic book is a five-issue comic book mini-series written by Patrick Shand and Raven Gregory in 2013 which was published by Zenescope Entertainment. Synopsis Alice Liddle managed to escape from Wonderland , but without her psyche intact. She tries to prevent the evil of Wonderland from infiltrating her world and infecting all she loves with its madness.</ex:hasAnnotation>
    <ex:hasAuthorW>Patrick Shand</ex:hasAuthorW>
    <ex:hasAuthorW>Raven Gregory</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>May 2013 - October 2013</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#isBasedOnW">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>isBasedOnW</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:range rdf:resource="http://example.org/lovecraft#Location"/>
    <rdfs:range rdf:resource="http://example.org/lovecraft#Work"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lloigor_%28disambiguation%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Disambiguations"/>
    <rdfs:label>Lloigor (disambiguation)</rdfs:label>
    <ex:hasAnnotation>Lloigor may refer to one of the following: Lloigor , the Great Old One , the twin of Zhar. The Lloigor species, that often manifest as giant lizards.</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Case_of_Charles_Dexter_Ward">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Case of Charles Dexter Ward</rdfs:label>
    <ex:hasAnnotation>Wt is a short novel (51,500 words) by h. p. lovecraft . It was written in early 1927, but not published during the 's lifetime . Set in lovecraft's hometown of providence, r.i., it describes how charles dexter ward becomes obsessed with his distant ancestor .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short novel</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Violet_Liddle">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Violet Liddle</rdfs:label>
    <ex:hasAnnotation>Violet annabelle liddle was created by raven gregory in 2009, first appearing in issue #1 of the 1st volume of beyond wonderland by zenescope entertainment . She was born and joined her family's history of connection to wonderland .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Beyond Wonderland Vol 1 1</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Raven Gregory</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Perdition">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Perdition</rdfs:label>
    <ex:hasAccessibilityL>Land</ex:hasAccessibilityL>
    <ex:hasAnnotation>Earth Land Notable Features Nearby mine M'nagalah Humans First appearance ADJ : " The Lurker in Tunnel 13 " Created by Len Wein is a fictional town in the DC universe which first appeared in Swamp Thing Vol 1 #8 " The Lurker in Tunnel 13 ". Background is a mining community located in Pennsylvania's Appalachian mountains. In 1904, the mystical spellbook Visions of a Dead Priest was discovered by Abraham Monroe, which ended up opening a doorway that gave M'nagalah access to Earth. M'nagalah took up residence in one of the mine shafts and the town experienced a reign of terror for over 70 years. At one point, the townspeople attempted to use Swamp Thing as a sacrifice.</ex:hasAnnotation>
    <ex:hasNotableFeatureL>Nearby mine</ex:hasNotableFeatureL>
    <ex:isInhabitedByL>M'nagalah Humans</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Earth"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Lurker_in_Tunnel_13"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Vy%C3%B4nes">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Vyônes</rdfs:label>
    <ex:hasAnnotation>Averoigne (pronounced vee-own) is a fictional town created by clark ashton smith . It was mentioned in the first tale, " the end of the story ", published in the may 1930 issue of weird tales . It was not used as an actual setting until the third tale, " the maker of gargoyles ", in weird tales ' august 1932 issue .</ex:hasAnnotation>
    <ex:hasTypeL>town</ex:hasTypeL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Averoigne"/>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#France"/>
    <ex:madeFirstAppearanceOnL>The End of the Story (1930)</ex:madeFirstAppearanceOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Brian_M._Sammons">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Brian M. Sammons</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Editor Writer United States United States Horror is an editor, author, and games designer from Michigan, USA, who has written several stories based in the Cthulhu Mythos , and edited collections of several more. He frequently collaborates with British author Glynn Owen Barrass . Selected Bibliography Editor The Dark Rites of Cthulhu (2014) Steampunk Cthulhu (2014) Tales of Cthulhu Invictus (2015) Edge of Sundown (2015) Undead &amp; Unbound (2015) Legacy of the Reanimator (2015) Atomic-Age Cthulhu (2015) Heroes of Red Hook (2016) Eldritch Chrome (2016) Return of the Old Ones (2017) The Children of Gla'aki (2017) Arkham Detective Agency (2017) Tails of Terror (2018) Shadows of an Inner Darkness (2019) Summer of Lovecraft (2019) Children of Lovecraft Country (2020, with Oscar Rios) An Eldritch Legacy (2020, with Oscar Rios) Tales of Cthulhu Invictus: Britannia (2020, with Oscar Rios) Tales from Arkham Sanitarium (2022) Short Stories " The Murder at the Motel " (2014) " Dark Cell " (2014) " Clear the Air " (2017) Gaming Supplements Secrets (1997) Terrors From Beyond (2009, contributor) Atomic-Age Cthulhu (2013, contributor) Island of Ignorance: The Third Cthulhu Companion (2013, contributor) Tales of the Sleepless City (2013, contributor) Punktown (2018, with Mike Tresca and Glynn Owen Barrass ) Aspirations (2019, contributor) A Time to Harvest (2021) An Inner Darkness (contributor) External Links at the Internet Speculative Fiction Database at Goodreads "A Graveside Chat with " interview at The Blog Where Horror Dwells</ex:hasAnnotation>
    <ex:hasBirthplaceR>United States</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Editor Writer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dark_Horse">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dark Horse</rdfs:label>
    <ex:hasAnnotation>The dark rites of cthulhu was published in the thematic anthology the dark rites of cthulhu by april moon books in march 2014 . Story is about a survivor who teaches a spell which will destroy the great old ones when recited by enough people at the correct time . While imprisoned, laura sees the sky light up in green and begins the chant, which is taken up by all of those whom she has taught . However,</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#John_Goodrich"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Dark_Rites_of_Cthulhu"/>
    <ex:wasPublishedOnW>March 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Witch-Cult_in_Western_Europe">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Witch-Cult in Western Europe</rdfs:label>
    <ex:hasAnnotation>Margaret murray english release date 1921 is a 1921 speculative anthropology book . It claims that until the early modern age, there existed a cult in existence across western europe which worshipped a horned god of pagan ancestry . This organisation was so successful in keeping its existence hidden from the ever-expanding influence of christianity that it was not until the reformation that the church took any real notice of it .</ex:hasAnnotation>
    <ex:hasAuthorW>Margaret Murray</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1921</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Galactus">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Galactus</rdfs:label>
    <ex:hasAlternativeNamesC>Galan</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Devourer of Worlds</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as galan the devourer of worlds is an eldritch cosmic entity in the fictional universe of marvel by comics . Empowers chosen individuals to become his cosmic heralds, who represent him in the cosmos and find worlds for him to feed on . Grew to be larger than several combined galaxies in one alternate future .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Fantastic Four #48</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Jack Kirby</ex:wasCreatedByC>
    <ex:wasCreatedByC>Stan Lee</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Codex_Eastertide_1998">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Codex Eastertide 1998</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Robert H. Knox English Necronomicon Press Release Date April 1998 40 Preceded by Hallowmas 1997 Followed by Lammas 1998 is the thirteenth issue of fanzine Cthulhu Codex . Edited by Robert M. Price and featuring cover art by Robert H. Knox, it was published by Necronomicon Press in April 1998. Contents Editorial: From the Scriptorium by Robert M. Price "Godzilla vs. Cthulhu" by C. L. Werner "The Snakefarm" by James Ambuehl "Early Closing Day" by D. F. Lewis "The Devil's Due" by Mark Francis "Eldritch Gifts" by Darrell Schweitzer "Miskatonic Magic" by R. L. Tierney "The Audient Void" by W. H. Pugmire</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>40</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>April 1998</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Call_of_the_Wild">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Call of the Wild</rdfs:label>
    <ex:hasAnnotation>Corey Konieczka Fantasy Flight Games Publication Date 2013 2016 Board game Mansions of Madness was an expansion set for Fantasy Flight Games ' Mansions of Madness board game, designed by Corey Konieczka and first published in 2013. It was reissued in 2016 to complement the core game's second edition. Overview Gallery</ex:hasAnnotation>
    <ex:wasPublishedOnW>2016 2013</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dreams_in_the_House_of_Weir">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dreams in the House of Weir</rdfs:label>
    <ex:hasAnnotation>The story is set in 1931 and consists of extracts from the diary of a linguist named hareton paine . In his dreams, paine is aware that kzoora is an insectoid alien living on a world named yaddith . In his nightmares, paine is aware that kzoora is a wizard trying to find ways to combat the burrowing dholes .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Weird Tales #1</ex:isPublishedAsW>
    <ex:wasPublishedOnW>December 1980</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Thraa">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Thraa</rdfs:label>
    <ex:hasAnnotation>Mnar City Notable Features River Ai Humans First appearance HPL : " The Doom That Came to Sarnath " HPL : " The Quest of Iranon " HPL : The Dream-Quest of Unknown Kadath Created by H. P. Lovecraft is a city in the land of Mnar on the River Ai in the Dreamlands . It was built by the same wandering tribes that built the Mnaran cities of Ilarnek , Kadatheron , and Sarnath . Sarnath eventually conquered the neighboring cities and lands (including ) and forged an empire. ( HPL : " The Doom That Came to Sarnath ") Pearls from the coastal region of Mtal dissolved in vinegar produced in were considered a delicacy in Sarnath. ( HPL : " The Doom That Came to Sarnath ")</ex:hasAnnotation>
    <ex:hasAppearanceL rdf:resource="http://example.org/lovecraft#The_Dream-Quest_of_Unknown_Kadath"/>
    <ex:hasAppearanceL rdf:resource="http://example.org/lovecraft#The_Quest_of_Iranon"/>
    <ex:hasNotableFeatureL rdf:resource="http://example.org/lovecraft#River_Ai"/>
    <ex:hasTypeL>City</ex:hasTypeL>
    <ex:isInhabitedByL>Humans</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Mnar"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Doom_That_Came_to_Sarnath"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Golden_mead">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MysticalArtefacts"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdfs:label>Golden mead</rdfs:label>
    <ex:hasAnnotation>The is a fictional substance created by august derleth for his cthulhu mythos series of short stories . According to the celaeno fragments , the is a product of the elder gods .</ex:hasAnnotation>
    <ex:hasFunctionA>Expanded consciousness</ex:hasFunctionA>
    <ex:hasTypeA>Mystical elixir</ex:hasTypeA>
    <ex:isUsedByA rdf:resource="http://example.org/lovecraft#Laban_Shrewsbury"/>
    <ex:isUsedByA>Andrew Phelan</ex:isUsedByA>
    <ex:madeFirstAppearanceOnA rdf:resource="http://example.org/lovecraft#The_House_on_Curwen_Street"/>
    <ex:wasCreatedByA>The Elder Gods</ex:wasCreatedByA>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Rats_in_the_Walls_%28DART_production%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAudioAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Rats in the Walls (DART production)</rdfs:label>
    <ex:hasAnnotation>The rats in the walls is a production from the h. p. lovecraft historical society . It runs to slightly over 73 minutes and is available in both compact disc and digital download formats .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Rats_in_the_Walls"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#William_Meikle">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>William Meikle</rdfs:label>
    <ex:hasAnnotation>William barclay meikle was born in ayrshire, scotland, in 1958 . He has published over 30 novels and more than 300 short stories . Meikle has expanded upon the character of occult detective, thomas carnacki .</ex:hasAnnotation>
    <ex:hasBirthplaceR>Scotland Ayrshire Kilbirnie</ex:hasBirthplaceR>
    <ex:hasFullNameR>William Barclay Meikle</ex:hasFullNameR>
    <ex:hasWebsiteR>https://www.williammeikle.com/index.htm</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1958 January 25</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Vorvadoss">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ElderGods"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Vorvadoss</rdfs:label>
    <ex:hasAffiliationC>Elder Gods</ex:hasAffiliationC>
    <ex:hasAnnotation>perhaps Bel Yarnak Current location perhaps Betelgeuse or Bel Yarnak Relatives Nodens (possible father) EXP : Lythalia (mother) Yaggdytha (twin) Elder Gods First appearance CIRCLE : " The Eater of Souls " CIRCLE : " The Invaders " Created by Henry Kuttner ( The Flaming One, Lord of the Universal Spaces, The Troubler of the Sands, Who Waiteth in the Outer Dark ) is an Elder God that appears as a cloaked, hooded being, enveloped in green flames, with fiery eyes. He is reported in some sources as son of the Elder God Nodens and the Great Old One Lythalia and has a twin brother, Yaggdytha . Notes was created by Henry Kuttner . He first appeared in Kuttner's " The Eater of Souls " and is also invoked in Kuttner's " The Invaders ", in which his huge face with flaming eyes manifests at the climax of the story. He was mentioned as an Elder God by Lin Carter in his The Necronomicon: The Dee Translation along with Nodens and Kthanid .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Invaders"/>
    <ex:isLocatedAtC>perhaps Betelgeuse or Bel Yarnak</ex:isLocatedAtC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Eater_of_Souls"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Henry_Kuttner"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Sebek">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdfs:label>Sebek</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Crocodile God</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Egyptian mythology was an egyptian god worshipped in the form of a nile crocodile, or of a man with a crocodile's head . The center of 's worship was the egyptian region of faiyum, with its capital at crocodilopolis . 's name is also given as sobek or sobki; it is spelled sbk in hieroglyphics; scholars can only guess at the actual vowels .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Secret_of_Sebek"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Robert_Bloch"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mi-Go">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Mi-Go</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Nyarlathotep"/>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Sedmelluq"/>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Shub-Niggurath"/>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Yog-Sothoth"/>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#The_Fungi_from_Yuggoth"/>
    <ex:hasAlternativeNamesC>Abominable Snowmen</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Nevermen</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Ones from the Sky</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Outer Beings</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Outer Ones</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Outside Things</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Winged Ones</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Yuggothians</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The , also known as the fungi from yuggoth, are a fictional alien species first introduced by h. p. lovecraft in his 1931 short story . They are described as winged fungal creatures that resemble crustaceans, with large claws and heads covered in antennae . Their name originates from the or " abominable snow-men " of nepalese folklore .</ex:hasAnnotation>
    <ex:hasAppearanceC>At the Mountains of Madness Through the Gates of the Silver Key The Warder of Knowledge The Dweller in the Tomb Shaggai Planetfall on Yuggoth Malleus Monstrorum Yuggoth on the Rim Boojum The Thing in the Vault</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Whisperer_in_Darkness"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#God_of_the_Bloody_Tongue">
    <rdf:type rdf:resource="http://example.org/lovecraft#Avatars"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>God of the Bloody Tongue</rdfs:label>
    <ex:hasAffiliationC>Revered in Africa by the Cult of the Bloody Tongue</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Moon Howler</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Howler of Darkness</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The is an avatar of nyarlathotep revered in africa by the cult of the bloody tongue . He is also known as the howler of darkness in sandy petersen's cthulhu mythos . Worshipers of the make a pilgrimage to the mountain of the dark wind to participate in the rituals .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Other_Gods"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Infinite">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Infinite</rdfs:label>
    <ex:hasAnnotation>The infinites are a trio of abstract beings of incomprehensible power . Their mission is to align the energies of all the realities into a more harmonious structure . Aiding the infinites in their "missioni" are the walkers and servitors .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ulthar_Press">
    <rdf:type rdf:resource="http://example.org/lovecraft#DefunctRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SmallPress"/>
    <rdfs:label>Ulthar Press</rdfs:label>
    <ex:hasAnnotation>Current Status Inactive Sam Gafford United States Weird fiction Occult detective was an indie publishing house which largely published weird fiction, with a particular focus on the occult detective . As of 2019, it can be assumed to be inactive. Overview Founded by the late American author and editor Sam Gafford , after Gafford's passing in 2019, his wife stated her intent to continue in his honour. Unfortunately, this appears to have been impossible, and the company has not released any new material since 2018; their website is no longer hosted, and the last post on their Facebook account is dated January 2020 . Selected Publications Anthologies A Lonely and Curious (2015) Carnacki: The Lost Cases (2016) Lovecraftian Tales: Volume 1 (2017) Pickman's Gallery (2018) Non-Fiction Providence Pals: Memories and Miscellany (2015) External Links at the Internet Speculative Fiction Database at Goodreads References</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Collect_Call_of_Cathulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Crossovers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosFilmAndTelevision"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Collect Call of Cathulhu</rdfs:label>
    <ex:hasAnnotation>The episode was written by real ghostbusters michael reaves . It was first aired on the abc network on october 27, 1987 . It includes several in-jokes relating to mythos authors .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasWriterW>http://example.org/lovecraft#Michael_Reaves</ex:hasWriterW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>27 October 1987</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Exham_Priory">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Exham Priory</rdfs:label>
    <ex:hasAnnotation>Exham is a fictional in england that features prominently in the short story " the rats in the walls " it is located some three miles from the equally fictional village of anchester . In the story, it is the ancestral home of the de la poer family, whose last surviving heir restores it .</ex:hasAnnotation>
    <ex:hasTypeL>Monastery</ex:hasTypeL>
    <ex:hasTypeL>Stately home</ex:hasTypeL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#England"/>
    <ex:isLocatedAtL>United Kingdom</ex:isLocatedAtL>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Rats_in_the_Walls"/>
    <ex:wasDestroyedOnL>Circa 1923</ex:wasDestroyedOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#H_Warner_Munn">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>H Warner Munn</rdfs:label>
    <ex:diedOnR>1981</ex:diedOnR>
    <ex:hasAnnotation>Friend of Lovecraft and W. Paul Cook and author of horror and adventure tales for the pulps, notably “The Werewolf of Ponkert” (Weird Tales, July 1925) and its several sequels. Lovecraft met him frequently at his home in Athol, Massachusetts.</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1903</ex:wasBornOnR>
  </rdf:Description>
