    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Secret Painting of Thomas Cartwright</rdfs:label>
    <ex:hasAnnotation>The children of gla'aki is a short story by the late american writer w. h. pugmire . It was published in the thematic anthology the children of gla'aki by dark regions press in 2017 . The story takes place in the sesqua valley .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#W._H._Pugmire"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
