    <rdfs:label>H. P. Lovecraft: Myth-Maker</rdfs:label>
    <ex:hasAnnotation>Dirk W. Mosig English German Genre(s) Non-fiction Whispers #9 date December 1976 " " is a short non-fiction piece by Lovecraft scholar Dirk W. Mosig . History Whispers #9 (1976) H. P. Lovecraft: Four Decades of Criticism (1980, 1981) Über H. P. Lovecraft (1984)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Dirk_W._Mosig"/>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:isPublishedAsW>Whispers #9</ex:isPublishedAsW>
