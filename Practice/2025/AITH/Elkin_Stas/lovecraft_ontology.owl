  <rdf:Description rdf:about="http://example.org/lovecraft#The_Lovecraft_Library_Volume_1:_Horror_Out_of_Arkham">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
