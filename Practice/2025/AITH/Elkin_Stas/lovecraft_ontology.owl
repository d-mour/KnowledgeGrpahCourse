    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Seven Geases</rdfs:label>
    <ex:hasAnnotation>Clark Ashton Smith United States English 𝐓 " " is a short story by Clark Ashton Smith , and forms part of his Hyperborean cycle . It was first published in Weird Tales in October 1934.</ex:hasAnnotation>
