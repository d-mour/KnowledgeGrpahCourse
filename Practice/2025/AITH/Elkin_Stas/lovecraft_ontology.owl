    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Hagarg Ryonis</rdfs:label>
    <ex:hasAffiliationC>Great Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Lier-in-Wait</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Lier-in-Wait Great Ones First appearance EXP : H. P. Lovecraft's Dreamlands Created by Sandy Petersen , also known as The Lier-in-Wait is one of the Great Ones , the gods of Earth that reside in Kadath . He appears as a huge reptilian monster.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#H._P._Lovecrafts_Dreamlands"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Sandy_Petersen"/>
