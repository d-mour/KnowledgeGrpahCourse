    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Recruiter</rdfs:label>
    <ex:hasAnnotation>History was first published in the anthology lovecraft unbound in 2009 . Was later included in the posthumous collection of shea's own works demiurge: the complete cthulhu mythos tales of michael shea .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Michael_Shea"/>
