    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>H. P. Lovecraft: The Decline of the West</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft: Decline of the West S. T. Joshi United States English Starmont Studies in Literary Criticism Genre(s) Non-fiction Starmont House Wildside Press Release Date 1990 2000 172 is a non-fiction work by prominent H. P. Lovecraft scholar and critic S. T. Joshi . Overview Running to a total of 172 , was first published by Starmont House as part of their Starmont Studies in Literary Criticism ; both paperback and hardcover formats were released. In 2000, it received a reissue through Wildside Press . Contents Preface Introduction: On Methodology Part I: The Philosophy I: Lovecraft’s Philosophical Development II: Metaphysics III: Ethics IV: Aesthetics V: Politics Part II: The Fiction I: Metaphysics II: Ethics III: Aesthetics IV: Politics Part III: The Decline of the West I: The Decline of the West Notes Bibliography Index</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#S._T._Joshi"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:hasPageCountW>172</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Starmont Studies in Literary Criticism</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>2000 1990</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Broken_Moon:_Legends_of_the_Deep">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Broken Moon: Legends of the Deep</rdfs:label>
    <ex:hasAnnotation>Philip Kim Nat Jones English American Gothic Press Release Date Aug 2016 - Aug 2017 Media Type Comic book is a 6-issue mini-series from 2016-2017, written by Philip Kim. It's the 2nd volume of the post-apocalyptic Broken Moon comic books which are printed by American Gothic Press. Synopsis In a post-apocalyptic world, a village of fishermen in the Nebraskan coastline is threatened by monsters from the sea. Cthulhu has risen and humans join forces with vampires , werewolves , and fishmen to stop the Old One before it's too late.</ex:hasAnnotation>
    <ex:hasAuthorW>Philip Kim</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>Aug 2016 - Aug 2017</ex:wasReleasedOnW>
  </rdf:Description>
