  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Scuttler_in_the_Dark">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Scuttler in the Dark</rdfs:label>
    <ex:hasAnnotation>Gary receives a mysterious bite whilst hiking in northern arizona's hualapai mountains . Soon afterwards, the bizarre dreams begin, along with a voice in his head which imparts to gary indecipherable knowledge . He is confronted by a nest of the children of atlach-nacha, along with the fearsome being itself .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ran_Cartwright"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Cthulhu Cultus #15</ex:isPublishedAsW>
    <ex:wasPublishedOnW>February 1999</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#I_Want_to_Break_Free">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>I Want to Break Free</rdfs:label>
    <ex:hasAnnotation>Edward Morris United States English Genre(s) Horror Dark Regions Press The Children of Gla'aki date 2017 " " is a short Cthulhu Mythos story by American Edward Morris . Synopsis A Mercy Hill patient describes how, as a child, he and his friends travelled to Lakeside Terrace where they discovered and read all eleven volumes of the occult text the Revelations of Gla'aki , an act which was directly responsible for his incarceration. Characters The Unnamed Narrator , a psychiatric patient at the Severn Valley 's Mercy Hill hospital. History "" was published in the thematic anthology The Children of Gla'aki by Dark Regions Press in 2017.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Edward_Morris"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Children_of_Glaaki"/>
    <ex:wasPublishedOnW>2017</ex:wasPublishedOnW>
  </rdf:Description>
