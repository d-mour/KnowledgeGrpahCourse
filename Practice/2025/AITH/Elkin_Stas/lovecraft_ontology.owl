  <rdf:Description rdf:about="http://example.org/lovecraft#Mollie_L._Burleson">
    <rdf:type rdf:resource="http://example.org/lovecraft#NonFictionAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Scholars"/>
    <rdfs:label>Mollie L. Burleson</rdfs:label>
    <ex:hasAnnotation>Donald r. burleson is an author and poet who has written both prose and non-fiction pieces related to lovecraft and the greater cthulhu mythos . The two met at a rhode island horror convention in 1979, and were long-term members of the providence pals, an informal group of lovecraft scholars .</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
