  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Casebook">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Casebook</rdfs:label>
    <ex:hasAnnotation>Various United States English Call of Cthulhu Genre(s) Horror Chaosium Release Date 1990 Media Type Softcover Print 144 The : A Plethora of Plots and Adventures is a scenario supplement book for the Call of Cthulhu roleplaying game by Chaosium . Overview Collecting together two of the scenarios from Curse of the Chthonians with the contents of The Asylum &amp; Other Tales , the also includes a selection of play aids and story seeds along with an article giving hints and tips on fighting the monsters of the Mythos . It is printed in black and white with a full colour cover and 8 colour plates, and runs to 144 . Contents "The Asylum" Randy McCall "The Auction" Randy McCall "Black Devil Mountain" David A. Hargrave "Gate From the Past" John Scott Clegg "The Madman" Mark Harmon "The Mauretania " M. B. Willner "Westchester House" Elizabeth A. Wolcott "The Curse of Chaugnar Faugn" William A. Barton "Thoth's Dagger" William Hamblin Publication History First released in 1990, the is currently out of print.</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>144</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>1990</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Wild_Adventures_of_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
