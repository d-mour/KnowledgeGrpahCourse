    <ex:wasReleasedOnW>November 2003</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Legacy_of_the_Reanimator">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Legacy of the Reanimator</rdfs:label>
    <ex:hasAnnotation>Various Victor Manuel Leza Moreno United States English Chaosium Release Date December 2015 272 is a thematic anthology centred around the titular protagonist of H. P. Lovecraft 's short story " Herbert West—Reanimator ". Edited by Peter Rawlik and Brian M. Sammons , it was published by Chaosium in December 2015. Both paperback and digital editions were released. Overview Contents (With dates of first publication for stories that are not original to the volume.) "Introduction: That Tow-Headed Fiend" (essay) by Peter Rawlik " Thought He Was a Goner " by Christine Morgan " Herbert West in Love " by Molly Tanzer (2013) " Herbert West—Reanimator " by H. P. Lovecraft (1922) "The Horror on the Freighter" by Richard Lee Byers "A Man Called West" by Ron Shiflet and Glynn Owen Barrass (2008) " Herbert West—Reanimated " (1989) "Charnel Secrets" by Robert M. Price "The Body from the Bog" by Peter H. Cannon "Tombstone Tribunal" by Will Murray "What Came up from the Cellar" by Donald R. Burleson "Tears of the Dead" by Charles Hoffman "The Corpse Spawn" by Robert M. Price "Charnel House" by Tim Curran "The Crypt in Key West" by David Bernard " Herbert West—Reincarnated " (2000) "Colluding Cosmos" by Rod Heather "The Horror of the Holyland" by Brian McNaughton "In the Devil’s Garden" by Joseph S. Pulver, Sr. "The Thing from the Ovens" by Robert M. Price "The Fear in the Waiting" by C. J. Henderson "The Chaos into Time" by Michael Cisco "Cruel Heaven" by Rick Lai "Blood and Guts in High School" by Ed Morris Afterword by Brian M. Sammons</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>272</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>December 2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Inutos">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Inutos</rdfs:label>
    <ex:hasAnnotation>Dreamlands Human First appearance HPL : " Polaris " Created by H. P. Lovecraft The are an Arctic race of humans native to the Dreamlands . They appeared out of the "unknown west" to ravage the far northern kingdom of Lomar as ruthless conquerors. When they sacked the city of Daikos , the way was made clear for them to assault the city of Olathoë . The are presented as Dreamland ancestors of the real world Inuit. ( HPL : " Polaris ")</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Polaris"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Greenland">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Greenland</rdfs:label>
    <ex:hasAnnotation>North atlantic ocean island is mentioned in h.p. Lovecraft's cthulhu mythos stories . It is thought to be at least part of the of clark ashton smith's hyperborea . The island lies to the east of north america off the coast of canada .</ex:hasAnnotation>
    <ex:hasTypeL>Island</ex:hasTypeL>
    <ex:isLocatedAtL>North Atlantic Ocean</ex:isLocatedAtL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Wrath_of_NKai">
    <rdf:type rdf:resource="http://example.org/lovecraft#ArkhamHorrorFiction"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Wrath of N'Kai</rdfs:label>
    <ex:hasAnnotation>Countess alessandra zorzi is an infamous cat burglar from a family of con men and grifters . She has made her career dealing in occult artifacts stolen from an eclectic and eccentric clientele . Countess recruits a local taxi driver named pepper kelly to serve as her guide . The countess must play against forces she never imagined existed in order to not only survive but prevent an even greater tragedy .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Josh_Reynolds"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Action Adventure</ex:hasGenreW>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasPageCountW>337</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Arkham_Horror_Fiction"/>
    <ex:wasReleasedOnW>2020 September 1st</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Fat_Face">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Fat Face</rdfs:label>
    <ex:hasAnnotation>A working girl in los angeles harbours a fantasy about the strange occupant of the building opposite the hotel from which she plies her trade . But the man is in fact the head of an enclave of evolved shoggoths who have been preying on the strays of the city, both animal and human .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Michael_Shea"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>May 1987</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Babys_First_Mythos">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Storybooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Baby's First Mythos</rdfs:label>
    <ex:hasAnnotation>C. J. Henderson Erica Henderson English Genre(s) Children's Z-Man Games Release Date January 19, 2005 48 is a Cthulhu Mythos -themed educational children's book, originally published by Z-Man Games in 2005. It was written by C. J. Henderson and features illustrations by Erica Henderson. Contents "Sacred Words of Wizened Wisdom" by Robert M. Price "The Eldritch Alphabet" "Strange &amp; Blasted Numbers" Afterword by Professor William Jones</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#C._J._Henderson"/>
    <ex:hasGenreW>Children's</ex:hasGenreW>
    <ex:hasPageCountW>48</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2005 January 19</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Eldritch_New_England_Holiday_Collection">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Eldritch New England Holiday Collection</rdfs:label>
    <ex:hasAnnotation>Oscar Rios Golden Goblin Press Publication Date February 2021 Roleplaying game Call of Cthulhu is a thematic scenario supplement for Chaosium 's Call of Cthulhu roleplaying game. Overview contains four separate holiday-themed scenarios, a family history and tree, and 24 pregenerated player characters (the Morgan cousins as children and their friends, as well as two iterations of the cousins as adults. It runs to a total of 250 pages, was written by Oscar Rios with artwork by David Lee Ingersoll , and was published by Golden Goblin Press in both physical and digital download formats. Scenarios "Halloween in Dunwich" "Christmas in Kingsport" "Easter in Arkham" "Innsmouth Independence Day" Gallery</ex:hasAnnotation>
    <ex:wasPublishedOnW>February 2021</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Strange_High_House_in_the_Mist">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Strange High House in the Mist</rdfs:label>
    <ex:hasAnnotation>The dream-quest of unknown kadath is a short story by h. p. lovecraft . Written on november 9, 1926, it was first published in the october 1931 issue of weird tales . The story features the celtic god nodens , who also appears in the story .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Cthulhu Mythos</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Haunter_of_the_Dark_%28Caedmon_Records%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAudioAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Haunter of the Dark (Caedmon Records)</rdfs:label>
    <ex:hasAnnotation>The Haunter of the Dark Based on " The Haunter of the Dark " David McCallum Production Company Caedmon Records Release date 1979 Running time 61 minutes (approx.) United States English The Haunter of the Dark is a spoken work adaptation of the Howard Phillips Lovecraft short story of the same name . Overview Released by Caedmon Records , a recording label specialising in spoken-word content, as a vinyl LP in 1979, The Haunter of the Dark runs to a total of 61 minutes. Vocal talents were supplied by Scottish actor David McCallum . External Links The Haunter of the Dark , available to listen at the Internet Archive.</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Haunter_of_the_Dark"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1979</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Structure_of_Lovecrafts_Longer_Narratives">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Structure of Lovecraft's Longer Narratives</rdfs:label>
    <ex:hasAnnotation>S. T. Joshi United States English Genre(s) Non-fiction Necronomicon Press Crypt of Cthulhu #37 date February 1986 " " is a non-fiction piece by prominent H. P. Lovecraft scholar S. T. Joshi . History First published in issue #37 of fanzine Crypt of Cthulhu in February 1986, it was also included in the collection of Joshi's own works Selected Papers on Lovecraft by Necronomicon Press in June 1989.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#S._T._Joshi"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Crypt of Cthulhu #37</ex:isPublishedAsW>
    <ex:wasPublishedOnW>February 1986</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Xenomorph">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonSapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Xenomorph</rdfs:label>
    <ex:hasAnnotation>Xenomorphs are an extra-terrestrial species and the cosmic horror element in the fictional universe of the alien movie franchise . They are a parasitic hostile species, a race of predators who kill or infect any lifeforms they encounter . Xenomorphs have a vaguely bipedal form though usually they adopt a hunched quadrupedal stance .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Alien</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Dan_OBannon"/>
    <ex:wasCreatedByC>H. R. Giger (visuals)</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Madness_of_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Madness of Cthulhu</rdfs:label>
    <ex:hasAnnotation>S. T. Joshi , editor Cover Artist John Jude Palencar English Genre(s) Cthulhu Mythos Titan Books Release Date 2014 299 Followed by : Volume Two  is an anthology of Cthulhu Mythos and Lovecraftian fiction edited by S. T. Joshi , published by Titan Books in 2014, and later given an ebook release through Amazon's Kindle platform. It was followed by : Volume Two in 2015. Contents "Foreword" by Jonathan Maberry "Introduction" by S. T. Joshi " At the Mountains of Murkiness " by Arthur C. Clarke " The Fillmore Shoggoth " by Harry Turtledove " Devil's Bathtub " by Lois H. Gresh " The Witness in Darkness " by John Shirley " How the Gods Bargain " by William Browning Spencer " A Mountain Walked " by Caitlín R. Kiernan "Diana of the Hundred Breasts" by Robert Silverberg " Under the Shelf " by Michael Shea "Cantata" by Melanie Tem " Cthulhu Rising " by Heather Graham " The Warm " by Darrell Schweitzer " Last Rites " by Gael Baudino "Little Lady" by Gini Koch " White Fire " by Joseph S. Pulver, Sr. "A Quirk of the Mistral" by Jonathan Thomas " The Dog Handler's Tale " by Donald Tyson</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#S._T._Joshi"/>
    <ex:hasAuthorW>editor</ex:hasAuthorW>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasPageCountW>299</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2014</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#David_A._Hargrave">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>David A. Hargrave</rdfs:label>
    <ex:diedOnR>29 August 1988</ex:diedOnR>
    <ex:hasAnnotation>Full Name David Allen Hargrave Connection to the Mythos Game Designer Birth Date 25 May 1946 Death Date 29 August 1988 United States Fantasy Science Fiction Horror David Allen Hargrave was a prolific American games designer. Overview Although most famous for the creation of early roleplaying game Arduin , which began as a personal project but eventually evolved into one of the first rivals to Dungeons &amp; Dragons , Hargrave also wrote a number of works for the Call of Cthulhu roleplaying game by Chaosium , despite a falling-out with Chaosium's founder, Greg Stafford . Selected Bibliography "Black Devil Mountain", a scenario appearing in The Asylum &amp; Other Tales (1983) "Dark Carnival", a scenario appearing in Curse of the Chthonians (1984), and later Cthulhu Classics (1989).</ex:hasAnnotation>
    <ex:hasFullNameR>David Allen Hargrave</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Game Designer</ex:isConnectedToMythosR>
    <ex:wasBornOnR>25 May 1946</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shaurash-ho">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Shaurash-ho</rdfs:label>
    <ex:hasAlternativeNamesC>Father of All Ghouls (source)</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Naggob (source)</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Prowler in the Tombs (source)</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Naggoob is a descendant of cthulhu and parent of yogash the ghoul . Also known as the prowler in the tombs and father of all ghouls . Created by h.p. Lovecraft .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Selected Letters of H. P. Lovecraft 4.617</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecraft_Annual_No._9">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Periodicals"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraft Annual No. 9</rdfs:label>
    <ex:hasAnnotation>Various English Genre(s) Non-fiction Hippocampus Press Release Date August 2015 231 is the ninth instalment in the long-running non-fiction series from which it takes its name. Edited by leading Lovecraft scholar S. T. Joshi and published by Hippocampus Press in August 2015, it runs to a total of 231 . Contents "Letters to Marian F. Bonner" by H. P. Lovecraft " Miscellaneous Impressions of H.P.L. " by Marian F. Bonner "Can You Direct Me to Ely Court? Some Notes on 66 College Street" by Kenneth W. Faig, Jr. "66 College Street" by David E. Schultz "The Thing (Flung Daily) on the Doorstep: Lovecraft in the Antipodean Press, 1803-2007" by Brendan Whyte "The Search for Joseph Curwen's Town Home" by Donovan K. Loucks "Charles Baxter on Lovecraft" by S. T. Joshi "Six Degrees of Lovecraft: Henry Miller" by Bobby Derie "Cassie Symmes: Inadvertent Lovecraftian" by David Goudsward "Clergymen among Lovecraft's Paternal Ancestors" by Kenneth W. Faig, Jr. "Lovecraft and Houellebecq: Two Against the World" by Todd Spaulding "Donald A. Wollheim's Hoax Review of the Necronomicon" by Donovan K. Loucks Reviews by Steven J. Mariconda and Darrell Schweitzer Gallery</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:hasPageCountW>231</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>August 2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Time_Flies">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Time Flies</rdfs:label>
    <ex:hasAnnotation>A mass migration of yithians to earth brings with it a wealth of new scientific knowledge, although it is not known that they have chosen to inhabit the bodies of the recently deceased . After a series of catastrophic events signalling the return of the old ones and the downfall of humankind, the yithians reveal that they are simply there as tourists .</ex:hasAnnotation>
    <ex:hasAuthorW>Pete Rawlik</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Return of the Old Ones: Spocalyptic Lovecraftian Horror</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Pickmans_Modem">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Pickman's Modem</rdfs:label>
    <ex:hasAnnotation>Lawrence watt-evans wrote the short story set in the fictional cthulhu mythos of h.p. Lovecraft . It was later reprinted in arkham house's anthology cthulhu 2000: a lovecraftian anthology, and again in isaac asimov's sf-lite . Watt-evans also included it in his own collection, celestial debris .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lawrence_Watt-Evans"/>
    <ex:hasGenreW>Short Fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Cthulhu 2000: A Lovecraftian Anthology Isaac Asimov's SF-Lite Celestial Debris The Cthulhu Mythos Megapack</ex:isPartOfSeriesW>
    <ex:wasPublishedOnW>February 1992</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Richard_F._Searight">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsCorrespondents"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Richard F. Searight</rdfs:label>
    <ex:diedOnR>September 1975</ex:diedOnR>
    <ex:hasAnnotation>Richard franklyn searight (13 june 1902 - ? September 1975) was an american author and correspondent of h. p. lovecraft . He was the creator of the ancient mystic writings known as the eltdown shards . Searight was the father of the late franklyn searight , who wrote a significantly larger proportion of the mythos pieces than his father .</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Michigan Manistee</ex:hasBirthplaceR>
    <ex:hasChildrenR rdf:resource="http://example.org/lovecraft#Franklyn_Searight"/>
    <ex:hasFullNameR>Richard Franklyn Searight</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasPseudonymR>R. F. Searight</ex:hasPseudonymR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>13 June 1902</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Seth_Phillips">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Seth Phillips</rdfs:label>
    <ex:diedOnR>28 July 1851</ex:diedOnR>
    <ex:hasAnnotation></ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1827</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Herbert_West_and_the_Mammaries_of_Madness">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Herbert West and the Mammaries of Madness</rdfs:label>
    <ex:hasAnnotation>Inspired by h.p. Lovecraft's short story " herbert west--reanimator ", it was included in the james ward kirk publishing thematic anthology lovecraft after dark in november 2015 .</ex:hasAnnotation>
    <ex:hasAuthorW>Dixie Pinoit</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Lovecraft_after_Dark"/>
    <ex:wasPublishedOnW>November 2015</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Yellow_Sign">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsInspirationsWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MysticalArtefacts"/>
    <rdfs:label>Yellow Sign</rdfs:label>
    <ex:hasAnnotation>In the cthulhu mythos, the is a symbol that is usually used by the brotherhood of the , a cult that worships the great old one hastur . It is said that the symbol can bestow supernatural powers such as mind-control and possession, and is used to place individuals under the control of the aforementioned king in yellow . Within the context of the mythos, the (and hastur himself) are only offhandedly mentioned once in h. p. lovecraft'</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#David_McCallum">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPeople"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>David McCallum</rdfs:label>
    <ex:diedOnR>25 September 2023</ex:diedOnR>
    <ex:hasAnnotation>Full Name David Keith McCallum Connection to the Mythos Audiobook reader Birth Date 19 September 1933 Glasgow, Scotland Death Date 25 September 2023 New York City, U.S. United Kingdom (19 September 1933 – 25 September 2023) was a Scottish actor and musician best known for his starring role as secret agent Illya Kuryakin in the 1960s spy series The Man from U.N.C.L.E. and as Dr. Donald “Ducky” Mallard on crime procedural NCIS . He has also produced a number of studio albums, and in the 1970s read three of H. P. Lovecraft 's short stories for Caedmon Records , a label specialising in spoken word audio releases. Selected Works Audio Adaptations The Rats in the Walls (1973) The Dunwich Horror (1976) The Haunter of the Dark (1979) External Links at Wikipedia</ex:hasAnnotation>
    <ex:hasBirthplaceR>Glasgow Scotland</ex:hasBirthplaceR>
    <ex:hasFullNameR>David Keith McCallum</ex:hasFullNameR>
    <ex:hasNationalityR>United Kingdom</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Audiobook reader</ex:isConnectedToMythosR>
    <ex:wasBornOnR>19 September 1933</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Edgar_Rice_Burroughs">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftsInspirationsAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Edgar Rice Burroughs</rdfs:label>
    <ex:diedOnR>19 March 1950</ex:diedOnR>
    <ex:hasAnnotation>Burroughs is an inductee into the science fiction and fantasy hall of fame . He is perhaps best known for being the creator of the tarzan and john carter of mars series . He was vocal in espousing the tenets of eugenics and scientific racism .</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Chicago Illinois</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1 September 1875</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#T._E._D._Klein">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>T. E. D. Klein</rdfs:label>
    <ex:hasAnnotation>Theodore eibon is an american writer and editor . Wrote his honours thesis on h. p. lovecraft while attending brown university . Added "eibon" to his name in part as a nod to the character created by clark ashton smith .</ex:hasAnnotation>
    <ex:hasBirthplaceR>United States http://example.org/lovecraft#New_York_City</ex:hasBirthplaceR>
    <ex:hasFullNameR>Theodore Donald Klein</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Contributor</ex:isConnectedToMythosR>
    <ex:wasBornOnR>15 July 1947</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Horror_from_the_Bridge">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RamseyCampbellWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Horror from the Bridge</rdfs:label>
    <ex:hasAnnotation>"the inhabitant of the lake and less welcome tenants date 1964" is a short story by ramsey campbell that appeared in his 1964 collection . The story is largely a pastiche of h. p. lovecraft 's " the dunwich horror " .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Inhabitant_of_the_Lake"/>
    <ex:isPublishedAsW>Less Welcome Tenants</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1964</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Gods_Eye_View">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A God's Eye View</rdfs:label>
    <ex:hasAnnotation>Ron Shiflet United States English Elder Signs Press Looking for Darla: Stories of Mythos Noir date September 2008 " " is a short Cthulhu Mythos story by American Ron Shiflet . It was published in the collection Looking for Darla: Stories of Mythos Noir by Elder Signs Press in September 2008. Synopsis Wendell Willis , now incarcerated in the Hillsdale Asylum, an institution for the criminally insane, attempts to escape by communing with the dark god Chor-Tal . The divinity agrees to aid him by magically disguising the man as a security guard, but upon his escape, Willis is attacked and presumably killed by the jealous husband of a woman with whom the guard had been having an affair. Trivia Both Wendell Willis and Chor-Tal are semi-recurrent characters created by Ron Shiflet for his Cthulhu Mythos fiction: the former made his first appearance in " When in Leng… " (1998), the latter in "The Last Laugh" (1997).</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Looking_for_Darla:_Stories_of_Mythos_Noir"/>
    <ex:wasPublishedOnW>September 2008</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ragnalla">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Ragnalla</rdfs:label>
    <ex:hasAlternativeNamesC>Nest Mistress of the Winged Ones</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Seeker in the Skies</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as Nest Mistress of the Winged Ones The Seeker in the Skies First appearance EXP : " " Created by James Ambuehl ( Nest Mistress of the Winged Ones and The Seeker in the Skies ) is a vulturine and raptorial creature. They are also described to have a single, huge eye and a crown of tentacles.</ex:hasAnnotation>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#James_Ambuehl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bonanza">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Bonanza</rdfs:label>
    <ex:hasAnnotation>" witch firereeling back" is a short story by author sam gafford . It forms part of the arkham detective agency created by the late c.j. Henderson . Story takes place when ex-cop and former agent mike dolan is tricked into hunting down the shining trapezohedron . A monstrous creature breaks into our dimension before being beaten back .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Sam_Gafford"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Hardboiled</ex:hasGenreW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Arkham_Detective_Agency"/>
    <ex:wasPublishedOnW>November 2017</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Salom%C3%A9_Jones">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Salomé Jones</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Editor United States United States http://www.salomejones.com/ http://www.thenakedamerican.com/ is an American-born editor and occasional author based in the United Kingdom . Currently the Acquisitions Editor for small press publisher Ghostwoods Books , her editorial output has included at least two anthologies of Lovecraftian fiction published through Ghostwoods. Jones has cited British fantasy maestro Neil Gaiman as amongst her influences . Selected Works Editor Cthulhu Lives! (2014) Cthulhu Lies Dreaming (2016) External Links at the Internet Speculative Fiction Database at Goodreads References</ex:hasAnnotation>
    <ex:hasBirthplaceR>United States</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>http://www.salomejones.com/</ex:hasWebsiteR>
    <ex:hasWebsiteR>http://www.thenakedamerican.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Delta_Green_%28setting%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Delta Green (setting)</rdfs:label>
    <ex:hasAnnotation>Delta green is a roleplaying game setting originally created for chaosium 's call of cthulhu . It has since been expanded into its own stand-alone game, as well as a series of sourcebooks . The setting is a top-secret, black-ops organisation dedicated to combatting the threats presented by various cthulhu mythos creatures .</ex:hasAnnotation>
    <ex:wasPublishedOnW>1992</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Outpost">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Outpost</rdfs:label>
    <ex:hasAnnotation>Full story online here H. P. Lovecraft United States English Fantasy Magazine Date of writing 26 November 1929 date May 1934 " " is a poem by the late American H. P. Lovecraft . Synopsis The thirteen four-line stanzas describe how a Zimbabwean monarch, whilst travelling the wilds of his kingdom, happens across an unexplored veldt where the alien Fishers from Outside have established a lair. The king returns to his palace and forever after is afraid to sleep without the fires burning bright. History Fantasy Magazine (1934) Spaceways (1940) Beyond the Wall of Sleep (1943) Collected Poems (1963) The World of H. P. Lovecraft (1971) Fungi from Yuggoth and Other Poems (1971, 2016) The Fantastic Poetry (1990) The Ancient Track: The Complete Poetical Works of H. P. Lovecraft (2001)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Fantasy Magazine</ex:isPublishedAsW>
    <ex:wasPublishedOnW>May 1934</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>26 November 1929</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Unspeakable_Spawning_of_the_Proto-Shoggoths">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Unspeakable Spawning of the Proto-Shoggoths</rdfs:label>
    <ex:hasAnnotation>Robert M. Price United States English Genre(s) Non-fiction Necronomicon Press Crypt of Cthulhu St. John's Eve 1991 date June 1991 " The Unspeakable Spawn of the Proto-Shoggoths " is a short non-fiction work by leading Lovecraft scholar Robert M. Price . It was first published in the St. John's Eve edition of Lovecraftian fanzine Crypt of Cthulhu in June 1991. History Since its debut in Crypt of Cthulhu , "" has also appeared in the Darrell Schweitzer -edited anthology Mountains of Madness Revealed in September 2019.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu_St._Johns_Eve_1991"/>
    <ex:wasPublishedOnW>June 1991</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Serpents_of_Tenoka">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Serpents of Tenoka</rdfs:label>
    <ex:hasAnnotation>Historywas first published in the online fanzine nightscapes #4 in october 1997 . It has since appeared in the anthologies worlds of cthulhu (2012) and they thrive in darkness: mythos and madness (2018) .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
