    <rdfs:domain rdf:resource="http://example.org/lovecraft#Location"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Akachi_Onyele">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Dreamers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Akachi Onyele</rdfs:label>
    <ex:hasAlternativeNamesC>The Shaman</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Akachi is a character created by fantasy flight games for their arkham horror files range of mythos-related content . She was trained by one of the elders of her small nigerian village to be the tribe's next shaman from a young age . She has since made in eldritch horror , mansions of madness and arkham horror: the card game .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Arkham_Horror:_The_Card_Game"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Eldritch_Horror"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#Mansions_of_Madness"/>
    <ex:madeFirstAppearanceOnC>Innsmouth Horror Deluxe Expansion</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Fantasy_Flight_Games"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shudde_Mell">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Shudde M'ell</rdfs:label>
    <ex:hasAffiliationC>Chthonians Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#The_Burrower_Beneath"/>
    <ex:hasAlternativeNamesC>The Cataclysm from Below</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Great Chthonian</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Created by brian lumley is a mile long great grey worm-like creature that burrows through the earth, melting all rocks in its wake . Believed to be the supreme regent of the chthonians as well as the largest and most powerful of the race .</ex:hasAnnotation>
    <ex:isLocatedAtC>Deep Beneath the Earth</ex:isLocatedAtC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Cement_Surroundings"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Othkkartho">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ElderGods"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Othkkartho</rdfs:label>
    <ex:hasAffiliationC>Elder Gods</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Order</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Sire of the Four Titans of Balance</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as Sire of the Four Titans of Balance and Order Elder Gods First appearance Nightmare's Disciple Created by Joseph S. Pulver, Sr. is the son of the Elder God Nodens . It features in the Mythos/crime novel Nightmare's Disciple , by Joseph S. Pulver, Sr. .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Nightmares_Disciple"/>
    <ex:wasCreatedByC>Joseph S. Pulver. Sr.</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mythos_Expeditions">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Mythos Expeditions</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Jérôme Huguenin and David Lewis Johnson English Trail of Cthulhu Pelgrane Press Release Date September 2018 240 is a scenario supplement book for Pelgrane Press 's Cthulhu Mythos roleplaying game Trail of Cthulhu . It was published by Pelgrane in September 2018; both hardcover and digital editions were released, although it is currently only available in a digital format. Overview Containing a total of ten different scenarios, each by a different , it features cover art by Jérôme Huguenin and David Lewis Johnson and runs to a total of 240 . Gallery</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>240</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Trail_of_Cthulhu"/>
    <ex:wasReleasedOnW>September 2018</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Tugging">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RamseyCampbellWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Tugging</rdfs:label>
    <ex:hasAnnotation>Ramsey Campbell English Genre(s) Horror Appears in The Disciples of Cthulhu DAW 1976 "" is a short story by Ramsey Campbell that first appeared in the 1976 anthology The Disciples of Cthulhu . Synopsis The story centers on Ingels, a reporter for the Brichester Herald covering the discovery of a new planet, which turns out to be the entity Ghroth , the harbinger of the apocalypse. History Since its first appearance, "" has been reprinted several times, and has been translated into Italian ("Ghroth") and German ("Ein unheimlicher Drang"). The Disciples of Cthulhu (1976, 1996) Cold Print (1985, 1987, 1993) L'orrore di Cthulhu (1986) The Book of Cthulhu (2011, 2022) Die Offenbarungen des Glaaki (2014) Visions from Brichester (2015, 2018) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Disciples_of_Cthulhu"/>
    <ex:isPublishedAsW>1976</ex:isPublishedAsW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Walter_Gilman">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Walter Gilman</rdfs:label>
    <ex:ceasedOnC>1928 c. May 1</ex:ceasedOnC>
    <ex:hasAnnotation>Gilman is a fictional character created by h. p. lovecraft for his 1932 short story " the dreams in the witch-house " . He is a man from haverhill, massachusetts, who attended miskatonic university to advance his research in non-euclidean calculus and quantum physics . While there he came into contact with the necronomicon , the book of eibon and the unaussprechlichen kulten .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Dreams_in_the_Witch-House"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Son_of_Misharga">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Son of Misharga</rdfs:label>
    <ex:hasAnnotation>"the temple of bones" is a short cthulhu mythos story by and editor f. c. adams . It claims to be the real-world translation of a fragment of an occult volume titled the book of yng . It tells of a conflict between shub-niggurath and a high priestess of set .</ex:hasAnnotation>
    <ex:hasAuthorW>F. C. Adams</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Translations_from_the_Book_of_Yng"/>
    <ex:isPublishedAsW>Nightscapes #9</ex:isPublishedAsW>
    <ex:wasPublishedOnW>September 1998</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dr._Reid">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Dr. Reid</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Cabot_Museum"/>
    <ex:hasAffiliationC>Boston's artistic community</ex:hasAffiliationC>
    <ex:hasAnnotation>A fictional character created in 1926 by the late american author h. p. lovecraft . Created for his iconic short story " pickman's model " well-educated man with morbid interest in science . Tutored at the cabot museum by the skilled taxidermist will minot .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Studies_of_Dr._Reid"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Pickmans_Model"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Joseph_S._Pulver,_Sr.">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Joseph S. Pulver, Sr.</rdfs:label>
    <ex:diedOnR>24 April 2020</ex:diedOnR>
    <ex:hasAnnotation>Joseph s. pulver, sr. was an american-born author and editor . Many of his stories relate to the mythology of the king in yellow created by robert chambers . As an editor, pulver focused on the horror, and worked on both anthologies and periodicals .</ex:hasAnnotation>
    <ex:hasBirthplaceR>New York United States</ex:hasBirthplaceR>
    <ex:hasWebsiteR>http://thisyellowmadness.wordpress.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
    <ex:wasBornOnR>5 July 1955</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Study_in_Emerald_%28comic_book%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Study in Emerald (comic book)</rdfs:label>
    <ex:hasAnnotation>"a study in emerald" is a comic book adaptation of neil gaiman's alternate-history short story of the same name . A man identified only as "the detective" investigates the brutal murder of one of the german ruling family in an alternate victorian england . The killers, who belong to a group dedicated to reclaiming mankind's destiny, outwit both the detective and the police, and are never caught .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Neil_Gaiman"/>
    <ex:hasAuthorW>Rafael Albuquerque</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>June 2018</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_King_in_Yellow_%28Arkham_Horror_Expansion%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#ArkhamHorror"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The King in Yellow (Arkham Horror Expansion)</rdfs:label>
    <ex:hasAnnotation>The king in yellow was a small-box expansion for the second edition of the board game of lovecraftian adventure . It was the third expansion to be released . The expansion introduced the herald mechanic, with heralds being minions of the great old ones who are working towards the coming of their masters to earth .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Kevin_Wilson"/>
    <ex:hasAuthorW>Rob Vaughn</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Action Adventure</ex:hasGenreW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Arkham_Horror"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Black_Book_Issue_3_%28January_2003%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Black Book Issue 3 (January 2003)</rdfs:label>
    <ex:hasAnnotation>The Black Book Issue 3 Various Cover Artist Daniel Alan Ross English The Black Book Release Date January 2003 Preceded by Issue 2 The Black Book Issue 3 is the third and final issue of the short-lived Lovecraftian fanzine The Black Book . Edited by Peter Worthy and featuring cover art by Daniel Alan Ross, it was self-published in a digital format in January 2003. Contents Editorial by Peter A. Worthy "Mind-Pilot" by William Laughlin "The Sad Saga of Mad Jake Roberts" by Adam Niswander "Dying for Dagon" by Mark Francis "The Thing That Collected Bloch" by Randall D. Larson "A Pair of Old Shears" by Kenneth W. Faig, Jr. "The Man in the Bookstore" by Lee Clark Zumpe "Cthulhu, the Tentacled Old One" by Franklyn Searight " The Wedding of Shiela-Na-Gog " by Glenn Rahman and Richard L. Tierney "Against the Stars Themselves" by James Chambers "The Tulu Jar" by Ann K. Schwader "The Groveler in the Grotto" by Mark McLaughlin "Yhagni's Priest" by James William Hjort "The Devil's Steps" by Robert M. Price "The Laughing Man" by C. J. Henderson "From Darker Heavens" by Stanley C. Sargent</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>The Black Book</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>January 2003</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Weird_Tales">
    <rdf:type rdf:resource="http://example.org/lovecraft#PulpMagazines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Weird Tales</rdfs:label>
    <ex:hasAnnotation>Wt is an american fantasy and horror fiction magazine first published in march 1923 . The magazine was set up in chicago by an ex-journalist with a taste for the macabre . The magazine lost a considerable sum of money under editor edwin baird .</ex:hasAnnotation>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Untold_Tales_by_Clark_Ashton_Smith">
    <rdf:type rdf:resource="http://example.org/lovecraft#ClarkAshtonSmithWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Untold Tales by Clark Ashton Smith</rdfs:label>
    <ex:hasAnnotation>Cover Artist Ros Calverley United States English Crypt of Cthulhu Cryptic Publications Release Date November 1984 52 Preceded by Hallowmas 1984 Followed by Yuletide 1984 is the 27th issue of leading H. P. Lovecraft scholar Robert M. Price 's long running Lovecraftian fanzine Crypt of Cthulhu . Edited by Price and featuring cover art by Ros Calverley, it ran to a total of 52 in an A5 format and was published by Cryptic Publications in November 1984. The issue is a special dedicated to the works of Loevcraft's close friend Clark Ashton Smith , and includes a story credited to Smith in error. Interestingly, some of the interior text for issue 26 hints that Price may have been assisted in his role as editor by Clark Ashton Smith scholar Steve Behrends ; if true, this would make Behrends the only person in the zine's long run to have performed this task other than S. T. Joshi , who edited a single issue, a special issue titled Saturnalia and Other Poems by H. P. Lovecraft , in April 1984. Contents "Introduction: The Lost Worlds of Clark Ashton Smith", by Steve Behrends "Nemesis of the Unfinished" "The Dart of Rasasfa" "The Brahmin's Wisdom" by Gustav Meyrink, credited to Clark Ashton Smith in error "The House of Haon-Dor" "In a Hashish-Dream" "Slaves of the Black Pillar" "The Point of the Jest" "Unquiet Boundary" "Shapes of Adamant" "Mandor's Enemy" "Asharia" "The Master of Destruction" "The Ocean-World of Alioth" "Vizaphmal in Ophiuchus" "The Feet of Sidaiva" "The Sorceress of Averoigne" "Queen of the Sabbat" "The Werewolf of Averoigne" "The Hyperborean City" "The Rebirth of the Flame" References</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>52</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu"/>
    <ex:wasReleasedOnW>November 1984</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Red_Brain:_Great_Tales_of_the_Cthulhu_Mythos">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Red Brain: Great Tales of the Cthulhu Mythos</rdfs:label>
    <ex:hasAnnotation>S. T. Joshi , editor English Genre(s) Cthulhu Mythos Dark Regions Press Release Date November 27, 2017 270 Preceded by A Mountain Walked is an anthology of Cthulhu Mythos fiction edited by S. T. Joshi , and published by Dark Regions Press in 2017. Contents "Introduction" by S. T. Joshi "Falco Ossifracus: by Mr. Goodguile" by Edith Miniter "The Red Brain" by Donald Wandrei " The Beast of Averoigne " by Clark Ashton Smith " The Will of Claude Ashur " by C. Hall Thompson "The Pattern" by Ramsey Campbell "The Sect of the Idiot" by Thomas Ligotti " Meryphillia " by Brian McNaughton " The Peddler's Tale; or, Isobel's Revenge " by Caitlín R. Kiernan "Integrity" by Jonathan Thomas "Pickman's Lazarus" by W. H. Pugmire "The Crimson Fog" by Mark Samuels "Misanthrope" by Ray Garton</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#S._T._Joshi"/>
    <ex:hasAuthorW>editor</ex:hasAuthorW>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasPageCountW>270</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2017 November 27</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ernesto_Canepa">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Ernesto Canepa</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Weird fiction  is an author who has written a number of works set in the greater Cthulhu Mythos . These have been published in anthologies such as the Rogue Planet Press releases Swords Against Cthulhu (2015) and Swords Against Cthulhu II: Hyperborean Nights (2017), and zines such as Lovecraftiana . Selected Bibliography Short Fiction " Silence, Please " (2017, with Sergio Palumbo ) " Experiments… " (2020, with Sergio Palumbo) External Links at The Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Gyyagin">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Gyyagin</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#De_Vermis_Mysteriis"/>
    <ex:hasAffiliationC>Yog-Sothoth (possibly)</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Blinder of Time</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Star-Eater</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Worm</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>A giant extraterrestrial worm that transforms its human followers into undead servitors . Is heavily implied to be the titular worm in the grimoire known as de vermis mysteriis . Is known to have some kind of connection to the grimoire, to the point that burning the book will force the deity to retreat .</ex:hasAnnotation>
    <ex:isLocatedAtC rdf:resource="http://example.org/lovecraft#Jerusalems_Lot"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Jerusalems_Lot"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Stephen_King"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Scooby_Doom_versus_the_Cult_of_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Scooby Doom versus the Cult of Cthulhu</rdfs:label>
    <ex:hasAnnotation>Khurt Khave English First United Church of Cthulhu Release Date October 2016 134 is a gamebook based in the expanded universe of the Cthulhu Mythos . Published by the First United Church of Cthulhu via Lulu in October 2016, it was written by Khurt Khave , the organisation's head priest. The book is written in a parody style of Bantam's Choose Your Own Adventure series, a line of children's storytelling gamebooks which were hugely popular in the 1980s. Overview</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Khurt_Khave"/>
    <ex:hasPageCountW>134</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>October 2016</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#S._A._Sidor">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>S. A. Sidor</rdfs:label>
    <ex:hasAnnotation>Full Name Steven A. Sidor Connection to the Mythos Author Birth Date 1968 United States Lovecraftian horror Pulp adventure Thriller https://www.sasidor.com/ Steven A. Sidor (born 1968), who often goes by the pen names or SA Sidor, is an American author based near Chicago, USA . He has written a handful of novels set in H. P. Lovecraft 's Cthulhu Mythos , which have been published through Fantasy Flight Games ' Arkham Horror Fiction line . Sidor's non-Mythos works include The Institute for Singular Antiquities , a short series of pulp adventure stories, and several dark thriller novels . Selected Bibliography Novels The Last Ritual (2020) Cult of the Spider Queen (2021) Lair of the Crystal Fang (2022) External Links at the Internet Speculative Fiction Database at Goodreads Steven Sidor at Goodreads References</ex:hasAnnotation>
    <ex:hasFullNameR>Steven A. Sidor</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://www.sasidor.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1968</ex:wasBornOnR>
  </rdf:Description>
