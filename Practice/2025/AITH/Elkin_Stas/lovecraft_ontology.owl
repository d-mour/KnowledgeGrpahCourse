    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Cthugha</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Flaring God ( Ultimate Antihero )</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Grand Order )</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Kathigu-Ra ( Baggage Check)</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Kuuko ( Haiyore! Nyaruko-san )</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Lord of Fire</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Old Entity Cthugua ( Yu-Gi-Oh! )</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Burning One</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Living Flame</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Scorching One</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Yang Guifei ( Fate</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Fomalhaut is a fictional deity in the cthulhu mythos . Created by august derleth . First mentioned in his short story " the house on curwen street " (1943) but did not appear until " the dweller in darkness " (1944)</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Dweller_in_Darkness"/>
