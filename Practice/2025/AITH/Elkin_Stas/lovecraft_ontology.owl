    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Michael Fisher</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Editor United States is an award-winning American writer, artist and editor who has authored and edited a number of Lovecraftian works. He is also the art director for small-press publisher J. Ellington Ashton Press. Selected Works Editor Within Stranger Aeons (2016) External Links at the Internet Speculative Fiction Database</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Il_Segno_Giallo">
