    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Grimm Spotlight: Lovecraft's Legacy</rdfs:label>
    <ex:hasAnnotation>Cthulhu mythos is a comic book story written by joe brusha and featuring artwork by juan francisco mota . It was published digitally by zenescope entertainment in june 2023; a variety of variant covers were created .</ex:hasAnnotation>
    <ex:hasAuthorW>Joe Brusha</ex:hasAuthorW>
