    <rdfs:label>Eldritch Prisoners</rdfs:label>
    <ex:hasAnnotation>A Cthulhu Mythos Anthology Various English Crossroad Press Release Date February 2023 324 : A Cthulhu Mythos Anthology is a thematic collection of four Lovecraftian novellas. It was published by Crossroad Press through Amazon's digital Kindle platform in February 2023. It is part of the Books of Cthulhu series. Overview Contents "Broken Singularity" by David Conyers "The Prisoner from Beyond" by Matthew Davenport "Body Snatchers" by David Hambling "Leng's Labyrinth" by John A. DeLaughter</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>324</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>February 2023</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Joe_Mills">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Joe Mills</rdfs:label>
    <ex:hasAffiliationC>The Department of Extraordinary Phenomena</ex:hasAffiliationC>
    <ex:hasAffiliationC>The Royal Canadian Mounted Police</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Millsy</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Mills is a character created by troy young for his nyarlathotep cycle series of cthulhu mythos stories . He is a paranormal investigator and law enforcement officer . He has encountered and defeated elements of "the other" and an entire cult devoted to the outer god nyarlathotep .</ex:hasAnnotation>
    <ex:hasCharacterMateC>Shelley</ex:hasCharacterMateC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#It_Came_from_the_Sea"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Troy_Young"/>
  </rdf:Description>
