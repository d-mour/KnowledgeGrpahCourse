    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Little People</rdfs:label>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#Worms_of_the_Earth"/>
    <ex:hasAlternativeNamesC>Children of the Night</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Degenerate Serpent Folk</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The are a fictional humanoid species featured most extensively in the works of arthur machen and robert e. howard . They are believed to be the inspiration for the folkloric fair folk, or "fairies" in the role-playing game call of cthulhu, they are known as the degenerate serpent folk .</ex:hasAnnotation>
    <ex:hasAppearanceC>The Novel of the Black Seal The Children of the Night People of the Dark Worms of the Earth The Little People</ex:hasAppearanceC>
    <ex:hasDistinctionC>Claws</ex:hasDistinctionC>
    <ex:hasDistinctionC>aversion to light</ex:hasDistinctionC>
    <ex:hasDistinctionC>fangs</ex:hasDistinctionC>
    <ex:hasDistinctionC>hissing vocalizations</ex:hasDistinctionC>
    <ex:madeFirstAppearanceOnC>The Shining Pyramid</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Arthur_Machen"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Brotherhood">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Brotherhood</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft United States English The Tryout date December 1916 " " is a poem by the late American Howard Phillips Lovecraft . It was first published in the amateur press magazine The Tryout in December 1916 ; it did not see print again until its inclusion in the 1980 Necronomicon Press collection Uncollected Prose &amp; Poetry Volume 2 . History The Tryout (1916) Uncollected Prose &amp; Poetry Volume 2 (1980) Medusa and Other Poems by H. P. Lovecraft (1986) The Ancient Track: The Complete Poetical Works of H. P. Lovecraft (2001, 2013) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Tryout"/>
    <ex:wasPublishedOnW>December 1916</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Objects_from_the_Gilman-Waite_Collection">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Objects from the Gilman-Waite Collection</rdfs:label>
    <ex:hasAnnotation>Ann K. Schwader English Genre(s) Cthulhu Mythos Lindisfarne Press Strange Stars &amp; Alien Shadows date November 2003 " " is a short Cthulhu Mythos story by American and editor Ann K. Schwader , first published in her collection Strange Stars &amp; Alien Shadows (2003, Lindisfarne Press) . Synopsis A visit to an unusual museum exhibit - one which displays, amongst other things, bizarre golden jewellery with distinctly aquatic motifs - triggers memories of a heinous crime committed by the man during his university days. As the time in the exhibition drags on, his sanity becomes increasingly frayed, and he begins to believe that the attendant is in fact the woman he violated so many years ago, come back to exact the price for his foul deed… Behind the Mythos The artefacts on display in the museum are clearly intended to be pieces created by the Deep Ones , as described in H. P. Lovecraft 's The Shadow Over Innsmouth , while the woman's description closely matches most common depictions of the Innsmouth Look . Additionally, the names Gilman and Waite are often associated with the scions of Innsmouth in Lovecraft's fiction. History Strange Stars &amp; Alien Shadows (2003, Lindisfarne Press) Tales of the Cthulhu Mythos: Cthulhu's Creatures (2007, Rainfall Books ) The Book of Cthulhu II (2012, 2022, Night Shade Books) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ann_K._Schwader"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Alien Shadows</ex:isPublishedAsW>
    <ex:isPublishedAsW>Strange Stars</ex:isPublishedAsW>
    <ex:wasPublishedOnW>November 2003</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Call_of_Cthulhu_%28Role-Playing_Game%29">
