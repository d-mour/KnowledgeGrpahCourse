    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>H. P. Lovecraft's Reanimator Tales</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft Steven Philip Jones Cover Artist Terry Pavlet English Caliber Comics Release Date January 2016 148 is a collection of works first published by Caliber Comics in January 2016. It was reissued with a different cover in September 2020; both paperback and digital editions were released. Overview Contents Foreword by Justin Beahm " Herbert West--Reanimator " " The Empty House on Harley Street " " From the Dark " (audio script) Supernatural Horror in Literature Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Steven_Philip_Jones"/>
