  <rdf:Description rdf:about="http://example.org/lovecraft#Cynothoglys">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Cynothoglys</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>She Whose Hand Embalms</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Mortician God</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Mortician God, She Whose Hand Embalms Great Old Ones First appearance EXP : " The Prodigy of Dreams " Created by Thomas Ligotti , The Mortician God , She Whose Hand Embalms , appears as a formless mound with one arm-like appendage. She uses this arm-like appendage to kill whoever summons her. She once held a cult in Italy which paid homage to her rather than worship. Gallery</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Prodigy of Dreams</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Thomas_Ligotti"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Empty">
    <rdf:type rdf:resource="http://example.org/lovecraft#Cults"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdfs:label>Empty</rdfs:label>
    <ex:hasAnnotation>The is a fictional organization in the cthulhutech pencil-and-paper roleplaying game by wildfire llc . They are the lost and desperate whose call was answered by a mysterious entity . The homeless also come under its influence but they don't commit atrocities .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Creatures_%26_Cultists">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Creatures &amp; Cultists</rdfs:label>
    <ex:hasAnnotation>The furiously fuggly card game is a card combat game based on the cthulhu mythos . It was created by jeff barber and john tynes with supplementary material by dennis detwiller and jonathan tweet . Game was issued as a book containing rules and player sheets .</ex:hasAnnotation>
    <ex:wasPublishedOnW>1990 1993</ex:wasPublishedOnW>
  </rdf:Description>
