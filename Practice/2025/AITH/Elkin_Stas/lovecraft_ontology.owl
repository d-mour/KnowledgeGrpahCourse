    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Scholars"/>
    <rdfs:label>S. T. Joshi</rdfs:label>
    <ex:hasAnnotation>Sunand tryambak joshi was born in pune, india, in 1958 . He is a leading figure in the study of h. p. lovecraft and other authors of weird and fantastic fiction . Joshi has compiled, edited or written over 200 books, detailed in the recent publication 200 books by s.t. Joshi (hippocampus press, 2014)</ex:hasAnnotation>
    <ex:hasBirthplaceR>India Pune</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States since 1978</ex:hasNationalityR>
    <ex:hasWebsiteR>stjoshi.org</ex:hasWebsiteR>
    <ex:wasBornOnR>1958 22 June</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Greg_Stafford">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Greg Stafford</rdfs:label>
    <ex:diedOnR>10 October 2018</ex:diedOnR>
    <ex:hasAnnotation>Full Name Francis Gregory Stafford Birth Date 9 February 1948 Waterbury, Connecticut, USA Death Date 10 October 2018 Arcata, California, USA United States Francis Gregory Stafford (9 February 1948-10 October 2018) was a prolific American games designer, editor and occasional author. Overview The co-creator of a multitude of roleplaying games including RuneQuest , White Bear and Red Moon and Ghostbusters , and founder of games publishing company Chaosium , also published the Lovecraftian roleplaying game Call of Cthulhu , arguably the greatest driving force behind the upsurge in popularity of the Cthulhu Mythos in the 1980s. Stafford was also responsible for the creation of the Call of Cthulhu Fiction line of expanded mythos literature. External Links at Wikipedia at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Connecticut Waterbury</ex:hasBirthplaceR>
    <ex:hasFullNameR>Francis Gregory Stafford</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:wasBornOnR>9 February 1948</ex:wasBornOnR>
  </rdf:Description>
