  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecraft_Unbound">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraft Unbound</rdfs:label>
    <ex:hasAnnotation>Ellen Datlow , editor English Dark Horse Release Date 2009 336  : Twenty Stories is a collection of Lovecraftian short fiction edited by Ellen Datlow , published by Dark Horse Books in 2009. Contents “Introduction ()” by Ellen Datlow “The Crevasse” by Dale Bailey and Nathan Ballingrud “The Office of Doom” by Richard Bowes “Sincerely, Petrified” by Anna Tambour “The Din of Celestial Birds” by Brian Evenson “The Tenderness of Jackals” by Amanda Downum “Sight Unseen” by Joel Lane “Cold Water Survival” by Holly Phillips “Come Lurk With Me and Be My Love” by William Browning Spencer “ Houses Under the Sea ” by Caitlín R. Kiernan “Machines of Concrete Light and Dark” by Michael Cisco “ Leng ” by Marc Laidlaw “In the Black Mill” by Michael Chabon “One Day, Soon” by Lavie Tidhar “Commencement” by Joyce Carol Oates “Vernon, Driving” by Simon Kurt Unsworth “ The Recruiter ” by Michael Shea “Marya Nox” by Gemma Files “ Mongoose ” by Elizabeth Bear and Sarah Monette “Catch Hell” by Laird Barron “That of Which We Speak When We Speak of the Unspeakable” by Nick Mamatas</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ellen_Datlow"/>
    <ex:hasAuthorW>editor</ex:hasAuthorW>
    <ex:hasPageCountW>336</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2009</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Pazuzus_Children">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Pazuzu's Children</rdfs:label>
    <ex:hasAnnotation>A downed american pilot during the gulf war's operation desert storm is captured by a mysterious cult living in caverns beneath the sands . He soon discovers that they are in service to an ancient entity - whose name they give as pazuzu, but who he also hears being referred to as " cth- "</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Jeffrey_Thomas"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Cthulhu Codex</ex:isPublishedAsW>
    <ex:wasPublishedOnW>April 1997</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Memories_of_Lovecraft_%281934%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Memories of Lovecraft (1934)</rdfs:label>
    <ex:hasAnnotation>R. H. Barlow United States English Genre(s) Non-fiction Necronomicon Press On Lovecraft and Life date October 1992 " " is a short non-fiction work by Lovecraft 's correspondent and friend R. H. Barlow . Overview An 8-page essay, "" was posthumously published by Necronomicon Press in the chapbook On Lovecraft and Life in October 1992. Barlow himself passed in the first days of 1951.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#R._H._Barlow"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Life</ex:isPublishedAsW>
    <ex:isPublishedAsW>On Lovecraft</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 1992</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Michael_Patty">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Michael Patty</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Games Designer Horror is a games designer who has written supplements for the Dark Ages line of Chaosium 's Call of Cthulhu horror roleplaying game. Selected Bibliography Gaming Supplements Cthulhu Dark Ages: The Abbey (2004)</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Games Designer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Rat_King">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Rat King</rdfs:label>
    <ex:hasAnnotation>The alien gardener is the first story in book 2 of the nyarlathotep cycle . It tells the story of a cult dedicated to an entity named meph’hibb’anauth .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Troy_Young"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Nyarlathotep_Cycle"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Other:_Encounters_with_the_Cthulhu_Mythos_Book_2"/>
    <ex:wasPublishedOnW>2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dagon_%28Ben_10%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Dagon (Ben 10)</rdfs:label>
    <ex:hasAnnotation>Despite its name being taken from that of dagon, it is clearly more closely based on cthulhu . Dagon is a demonic entity from another dimension, an interdimensional conqueror who has conquered 100 dimensions . It has other forms including one of a giant serpentine octopus with a gigantic tentacle coming out of its back like a tail .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Chapelwaite">
    <rdf:type rdf:resource="http://example.org/lovecraft#MediaAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Chapelwaite</rdfs:label>
    <ex:hasAnnotation>Adrien brody stars as captain charles boone, who inherits a house called in the town of preacher's corners, maine, in the year 1850 . The series is a 2021 television series adaptation of stephen king 's cthulhu mythos short story " jerusalem's lot " (which also serves as a prequel to his non-mythos novel 'salem's lot').</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasWriterW>Jason Filardi Peter Filardi</ex:hasWriterW>
