    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Nightscapes"/>
    <ex:wasPublishedOnW>August 1997</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Edwin_Everett_Phillips">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Edwin Everett Phillips</rdfs:label>
    <ex:diedOnR>29 August 1852</ex:diedOnR>
    <ex:hasAnnotation>Lovecraft’s maternal uncle and husband of Martha Helen Mathews, whom Edwin married on 30 July 1894 &lt;i&gt;and&lt;/i&gt; 23 March 1903. Edwin was involved in the business of his father, Whipple Van Buren Phillips, until Whipple’s death in 1904. After that, he worked as a “manufacturer’s representative, real estate and mortgage agent, rent collector, notary public...coin dealer” and “salesman and treasurer for a refrigeration company” [&lt;i&gt;Some of the Descendants...,&lt;/i&gt; Faig].</ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1803</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Annie_M._Davidson">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Annie M. Davidson</rdfs:label>
    <ex:diedOnR>17 June 1884</ex:diedOnR>
    <ex:hasAnnotation>James Phillips’ third wife, married on 18 June 1860.</ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1794</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ogdru_Hem">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Ogdru Hem</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Ogdru_Jahad"/>
    <ex:hasAlternativeNamesC>Dragon</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The were the spawn of the ogdru jahad and serve as major antagonists in the fictional universe of hellboy by dark horse comics . Their main mission was to prepare the earth for the coming of their parents, mainly by turning humans into frog monsters .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Hellboy: Seed of Destruction</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Mike_Mignola"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nathan_Shumate">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Nathan Shumate</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Editor Author Utah, USA United States https://nathanshumate.com/ is an American editor, artist and occasional author whose work focuses on the weird fiction and horror genres. His editorial credits include the complete run of Arkham Tales magazine as well as the Eldritch series of anthologies, while his artwork has appeared on the covers of several publications. The majority of his written and editorial work has been released through small press publisher Cold Fusion Media. Selected Works Editor Arkham Tales (2008-2009) Space Eldritch (2012) Space Eldritch II: The Haunted Stars (2013) Redneck Eldritch (2016) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Utah</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>https://nathanshumate.com/</ex:hasWebsiteR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
  </rdf:Description>
