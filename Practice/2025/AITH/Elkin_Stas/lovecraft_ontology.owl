    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Description of the Town of Quebeck, in New France, Lately added to His Britannick Majesty's Dominions</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft English Genre(s) Non-fiction Travel Donald M. Grant To Quebec and the Stars date 1976 is a substantial travelogue by the late American Howard Phillips Lovecraft . It was first published by Donald M. Grant in L. Sprague de Camp 's 1976 non-fiction collection To Quebec and the Stars . History To Quebec and the Stars (1976) Howard Phillips Lovecraft 3 (1992, 2016) Collected Essays Volume 4: Travel (2006) References</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:hasGenreW>Travel</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>To Quebec</ex:isPublishedAsW>
    <ex:isPublishedAsW>the Stars</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1976</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dagoniad">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dagoniad</rdfs:label>
    <ex:hasAnnotation>A supernatural killer stalks the streets of san francisco, feeding upon drug users . Two women accidentally eat marijuana-laced cookies . They face their end at the hands of the creature but fight back .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Michael_Shea"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Copping_Squid"/>
    <ex:isPublishedAsW>Other Mythos Tales</ex:isPublishedAsW>
    <ex:wasPublishedOnW>October 2009</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Madeline_Rothleschilde">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Madeline Rothleschilde</rdfs:label>
    <ex:hasAlternativeNamesC>Sugarbaby</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as sugarbaby powers and abilities voodoo, melee combat, nursing, psychology, parapsychologist, demonologist, agent of t.a.r.d. Was created in 2005 by james kuhoric .</ex:hasAnnotation>
    <ex:wasCreatedByC>James Kuhoric</ex:wasCreatedByC>
  </rdf:Description>
