    <rdfs:label>Mrs. Hudson's Fancies</rdfs:label>
    <ex:hasAnnotation>Inspector lestrade: the black temple and other stories is a short story set in the extended sherlock holmes universe . It was published in his collection inspector lestrade: the black temple and other stories by weird house press in february 2023 .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasGenreW>Lovecraftian horror</ex:hasGenreW>
