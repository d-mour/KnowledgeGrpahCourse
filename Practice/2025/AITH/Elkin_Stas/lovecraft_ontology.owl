    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Diary_of_Alonzo_Typer">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Diary of Alonzo Typer</rdfs:label>
    <ex:hasAnnotation>Lovecraft's revision of lumley's ", found after his mysterious disappearance" features the ancient one, as well as a passing reference to the city of yian-ho . Settingis set in the village of chorazin, a six-hour walk from batavia, new york .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Howard_Phillips_Lovecraft"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Lumley"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Progeny_of_Yig">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ServitorRaces"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Progeny of Yig</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Yig"/>
    <ex:hasAnnotation>Half-human, half-snake hybrid creatures that result from curse of snake-god yig . Either the humans turned into snakes for offending yig, or else the offspring of such humans . The child of audrey davis is the one such creature seen in " the curse of yig "</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Curse_of_Yig"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Zealia_Bishop"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Peabody_Heritage">
    <rdf:type rdf:resource="http://example.org/lovecraft#AugustDerlethWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Peabody Heritage</rdfs:label>
    <ex:hasAnnotation>The survivor and others is a short story by august derleth . It tells the story of the great-grandson of asaph peabody . The narrator returns to claim his ancestral estate northeast of wilbraham, massachusetts .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Survivor"/>
    <ex:isPublishedAsW>Others</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1957</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lgyhxian">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>L'gy'hxian</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Nyarlathotep"/>
    <ex:hasAnnotation>The l'gy'hxians are a fictional alien species created by ramsey campbell for his short story " the insects from shakeggai ". They were further developed by chaosium in 1994 for the call of cthulhu roleplaying game . They are extremely strong and physically dense creatures .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Insects_from_Shaggai"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Discovering_H._P._Lovecraft">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Discovering H. P. Lovecraft</rdfs:label>
    <ex:hasAnnotation>Various United States English Genre(s) Non-fiction Wildside Press Release Date August 2001 172 is a collection of non-fiction works compiled and edited by Darrell Schweitzer . Overview Consisting of eighteen works - including several from those who actually knew him and one from H. P. Lovecraft himself - and running to 172 , was compiled and edited by Darrell Schweitzer, and published by Wildside Press in August 2001. The majority of the included pieces were previously collected in Schweitzer's 1976 anthology Essays Lovecraftian . Contents "Notes on an Entity", by Robert Bloch "When the Stars Are Right", by Richard L. Tierney "The Four Faces of the Outsider", by Dirk W. Mosig "The First Lewis Theobald", by R. Boerem "Lovecraft and Lord Dunsany", by Darrell Schweitzer "Some Thoughts on Lovecraft", by Arthur Jean Cox " The Derleth Mythos ". by Richard L. Tierney "Genesis of the Cthulhu Mythos", by George T. Wetzel "Lovecraft's Ladies", by Ben P. Indick "H. P. Lovecraft and Pseudomathematics", by Robert Weinberg " A Literary Copernicus ", by Fritz Leiber "Textual Problems in Lovecraft: A Preliminary Survey", by S. T. Joshi "Story-Writing: A Letter from H. P. Lovecraft", by H. P. Lovecraft "Introduction ()", by Darrell Schweitzer "Character Gullibility in Weird Fiction", by Darrell Schweitzer "H. P. Lovecraft: The Books", by Lin Carter "H. P. Lovecraft: A Basic Reading List", by Darrell Schweitzer</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:hasPageCountW>172</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>August 2001</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Mark_Brandon_Allen">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Mark Brandon Allen</rdfs:label>
    <ex:hasAnnotation>A. L. Gengler Pseudonym(s) Connection to the Mythos Author Poet United States  A. L. Gengler , who publishes his works of fiction under the byline , is an author and poet who has written a handful of works inspired by Howard Phillips Lovecraft and the Cthulhu Mythos . These have appeared in publications such as the 2015 James Ward Kirk Publishing anthology Lovecraft after Dark . Selected Works Short Fiction " An Evening at Mount Baldy " (2015) Poetry " Masdevallia " (2015) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Poet</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cult_of_Ecstasy">
    <rdf:type rdf:resource="http://example.org/lovecraft#Cults"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OrganisationsOriginatingFromMythosInspiredWorks"/>
    <rdfs:label>Cult of Ecstasy</rdfs:label>
    <ex:hasAnnotation>The is a secretive and enigmatic organization within the lust universe . It is known for its hedonistic pursuits, mystical practices, and deep understanding of the human psyche . The group was formed by doreen austerlitz to help benedict yelverton . The traces its origins to ancient times, where early practitioners sought to transcend the physical world .</ex:hasAnnotation>
    <ex:hasPurposeO>Hedonistic pursuits Access to Lusst'ghaa Worship of Lauv'abrarc</ex:hasPurposeO>
    <ex:hasTypeO>Hedonistic Cult</ex:hasTypeO>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Menes">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Menes</rdfs:label>
    <ex:hasAnnotation>Orphaned as a child during a plague, he found comfort in a small black kitten that he kept as a companion . When his kitten went missing the blame was placed on an old man and his wife, residents of ulthar who were notorious for capturing and killing cats . ( hpl : " the cats of ulthar ") prayed to the gods of his people for justice, and after his caravan departed ulthar, all the cats of the village converged</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Cats_of_Ulthar"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nyarlathotep_%28short_story%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Nyarlathotep (short story)</rdfs:label>
    <ex:hasAnnotation>" nyarlathotep " is a prose poem/short story by h. p. lovecraft written in 1920 . It is the first mention in fiction of the cthulhu mythos entity nyarlathotep . The story describes the appearance of nyarlathotep as a "man" of the race of the pharaohs, who claims to have been dormant for the past twenty-seven centuries .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_United_Amateur"/>
    <ex:wasPublishedOnW>November 1920</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Hound_of_Tindalos">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonSapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Hound of Tindalos</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Mhithrha"/>
    <ex:hasAlternativeNamesC>Bandersnatch</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Cŵn Annwn</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The hounds of tindalos are extra-dimensional predatory creatures . They are said to inhabit the "angles" of time, while humans live in the "curves" little is known about their appearance, as few victims survive attacks .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Transition_of_Titus_Crow"/>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Whisperer_in_Darkness"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Hounds_of_Tindalos"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Frank_Belknap_Long"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kuranes">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Dreamers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Kuranes</rdfs:label>
    <ex:hasAnnotation>As a youth, he created the city of celephas in the dreamlands . As he grew older, he became more desperate to return to that city . It wasn't until his death that he would return to his dream-city for the final time .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Dream-Quest_of_Unknown_Kadath"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Celepha%C3%AFs"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cthulhu_Classics">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cthulhu Classics</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Lee Gibbons United States English Call of Cthulhu Chaosium Release Date 1989 152 is a sourcebook for Chaosium ’s Call of Cthulhu roleplaying game. Overview An anthology collecting a seven-scenario campaign and five individual scenarios, the adventures contained within are reprinted from earlier publications, with the exception of "The Warren" which is new to this collection and a continuation of Shadows of Yog-Sothoth . was a 152-page softcover with a full-colour cover, black and white interiors, a set of 8 colour plates and various player handouts. Contents "Dark Carnival" by David A. Hargrave "The Pits of Bendal-Dolum" by Doug Lyons "The Secret of Castronegro" by Mark Pettigrew and Sandy Petersen Shadows of Yog-Sothoth by Mark Hutchison, Sandy Petersen, John Scott Clegg, John Carnahan and Randy McCall "The Temple of the Moon" by Michael Szymanski and Scott David Aniolowski "The Warren" by Ed Gore (bonus scenario for Shadows of Yog-Sothoth ) Publication History First published in 1989, is now out of print; unlike many of Chaosium's older scenario books, it is not currently available as a PDF download.</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>152</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>1989</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Solstice_Carol_%28DART_production%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleAudioAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Solstice Carol (DART production)</rdfs:label>
    <ex:hasAnnotation>A solstice carol is a dark adventure radio theatre production by the h. p. lovecraft historical society . It is a festive edition of the series containing adaptations of " the festival ", "pickman's model", and " the outsider ", linked by a tale based on a christmas carol . As with all of the dart productions, it comes complete with a set of period-authentic props to enhance the immersive experience .</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#Pickmans_Model"/>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Festival"/>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Outsider"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#William_Jones">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>William Jones</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Writer Editor Games designer United States is an American author, editor, and games designer, as well as the founder of independent publisher Elder Signs Press . He has edited several anthologies with Cthulhu Mythos and other horror themes, and has also written numerous Mythos stories, notably the Rudolph Pearson stories collected as The Strange Cases of Rudolph Pearson ( Chaosium , 2008). Selected Bibliography Fiction Artifacts (2006) The Strange Cases of Rudolph Pearson (2008) "Feasters of the Dark" (2004) "The Transgression of Effram Harris" (2004) "Harami" (2004) "Through the Eye of a Needle" (2006) "A Change of Life" (2006) "They Who Dwell Below" (2007) "Shadow of the Past" (2008) "The Whispering Dead" (2008) The Haunted Horror" (2008) "The Missing Curiosity" (2008) "The Mysterious Millionaire" (2008) "An Ancient Summoning" (2008) Editor Horrors Beyond: Tales of Terrifying Realities ( Elder Signs Press , 2005) Arkham Tales: New Terrors Threaten Arkham ( Chaosium , 2006) Horrors Beyond II: Stories of Strange Creations (Elder Signs Press, 2007) High Seas Cthulhu (Elder Signs Press, 2007) Frontier Cthulhu (Chaosium, 2007) R'lyeh Rising (Chaosium, 2008) The Anthology of Dark Wisdom: The Best of Dark Fiction (Elder Signs Press, 2009) Ancient Shadows: Dark Tales of Eldritch Fantasy (Elder Signs Press, 2010) Gaming Supplements Secrets of New York (2005) Secrets of Morocco (2008) External Links (game designer) at Wikipedia at the Internet Speculative Fiction Database</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Games designer</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Writer</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Chandler_Davies">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Chandler Davies</rdfs:label>
    <ex:ceasedOnC>1962</ex:ceasedOnC>
    <ex:hasAnnotation>Created by brian lumley is a fictional character created by brian lumley . He first appears in lumley's titus crow story "an item of supporting evidence" davies is a skeptic of the idea that there is a reality behind the eldritch horrors in lovecraftian fiction .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#An_Item_of_Supporting_Evidence"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Beast">
    <rdf:type rdf:resource="http://example.org/lovecraft#Avatars"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>The Beast</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Brotherhood_of_the_Beast"/>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Brotherhood_of_the_Black_Pharaoh"/>
    <ex:hasAnnotation>Egypt Avatar of Nyarlathotep Brotherhood of Brotherhood of the Black Pharaoh First appearance EXP : The Fungi from Yuggoth Created by Keith Herber is an avatar of Nyarlathotep worshiped in Egypt . It is, in fact, one of the avatars associated with the Sphinx of Giza, the others being the Black Lion, destroyer of Egypt, and the Faceless God .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Fungi_from_Yuggoth"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Keith_Herber"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nazzadi">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Nazzadi</rdfs:label>
    <ex:hasAffiliationC>Migou (formerly)</ex:hasAffiliationC>
    <ex:hasAffiliationC>New Earth Government (currenty)</ex:hasAffiliationC>
    <ex:hasAnnotation>Sociocultural Characteristics Migou (formerly) New Earth Government (currenty) Real World Information Created by Wildfire LLC are a former servitor race of the Migou (Mi-Go). Gallery</ex:hasAnnotation>
    <ex:wasCreatedByC>Wildfire LLC</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Prophecy">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Prophecy</rdfs:label>
    <ex:hasAnnotation>Ron Marz Walter Geovani English Dynamite Entertainment Release Date June 2012 - February 2013 Media Type Comic book is a 7-issue crossover mini-series written by Ron Marz. Synopsis Ash Williams , Vampirella , Red Sonja , Herbert West , Dracula , Pantha , Dracula's daughter Eva , and the goddess Athena fight to save the modern world from the time displaced Hyborian sorcerer Kulan Gath and the Army of Darkness .</ex:hasAnnotation>
    <ex:hasAuthorW>Ron Marz</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>June 2012 - February 2013</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Earth_%28Rifts%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsOriginatingFromMythosInspiredWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Planets"/>
    <rdfs:label>Earth (Rifts)</rdfs:label>
    <ex:hasAnnotation>Earth is a planet in the fictional universe of the rifts pencil-and-paper roleplaying game by palladium . It has been invaded or infiltrated by extra-terrestrial beings, demons, extra-dimensional beings, gods, and alien intelligences . A third of mankind uses or accepts magic and psionic abilities, and have accepted the aliens among them . A third of mankind is now living in primitive barbarism .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Azathoth:_Ordo_ab_Chao">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Azathoth: Ordo ab Chao</rdfs:label>
    <ex:hasAnnotation>Various Various English Genre(s) Weird fiction JournalStone Release Date August 2023 314 is a collection of Azathoth -themed Cthulhu Mythos stories. It was edited by Aaron J. French and published by JournalStone in 2023, as a follow-up to their previous anthology The Gods of H. P. Lovecraft . Contents "Ordo ab Chao: Toward That Endlessness" by Maxwell I. Gold "Agent of Chaos" by T. Kingfisher "Expatriate" by Jamieson Ridenhour "...And Peer Aloft to Glimpse Some Fragment" by Ruthanna Emrys "Making a Difference" by Brian Evenson "The Recreationist" by Kaaron Warren "The Blind God's Game" by Matthew Cheney "In the Grove" by Erica Ruppert "Church of the Void" by Donald Tyson "Upon an Iron Bed, Under the Eyes of Chaos" by Richard Gavin "The Root King" by Lauri Taneli Lassila "The Infinite Beat" by Nathan Carson "The Door at 21 Bis Rue Xavier Privas" by R. B. Payne "An Unusual Pedigree" by Richard Thomas "Dust-Clotted Eyes" by Samuel Marzioli "The Revelations of Azathoth" by Lena Ng "Primordial Jack" by Akis Linardos "Respect Your Elders" by Adam L. G. Nevill</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:hasPageCountW>314</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>August 2023</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dweller_in_the_Gulf">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Dweller in the Gulf</rdfs:label>
    <ex:hasAffiliationC>Aihais</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Eidolon of the Blind</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The , which appears only in the clark ashton smith story of the same name, is an ancient, possibly immortal creature that dwells deep within the planet aihai . It is served and worshiped by a cult of martians who have been captured and blinded by the dweller, which is equipped with two proboscides for the extraction of eyes .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Dweller in the Gulf</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Clark_Ashton_Smith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Fatal_Exception_Has_Occurred_at...">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Fatal Exception Has Occurred at...</rdfs:label>
    <ex:hasAnnotation>A man named wilbur has managed to gain access to the necronomicon . He threatens to post it online unless the u.s. government pays him ten million dollars . He has already claimed responsibility for an earthquake in denver and a ship sinking in pohnpei .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Alan_Dean_Foster"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Children_of_Cthulhu"/>
    <ex:wasPublishedOnW>January 2002</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crypt_of_Cthulhu_Hallowmas_1989">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crypt of Cthulhu Hallowmas 1989</rdfs:label>
    <ex:hasAnnotation>Various S. Thomas Brown Cover Artist S. Thomas Brown United States English Crypt of Cthulhu Cryptic Publications Release Date November 1989 68 Preceded by Michaelmas 1989 Followed by Yuletide 1989 is the 68th issue of Robert M. Price 's long-running Lovecraftian fanzine Crypt of Cthulhu . Edited by Price with cover and interior art by S. Thomas Brown, it ran to 68 in an A5 format and was published by Cryptic Publications in November 1989. This issue is notable for being a special devoted to American Mythos luminary Thomas Ligotti . Contents Editorial Shards by Robert M. Price "The Prodigy of Dreams" by Thomas Ligotti "Allen and Adelaide: An Arabesque" by Thomas Ligotti "Ghost Stories for the Dead" by Thomas Ligotti "Studies in Horror" by Thomas Ligotti "Order of Illusion" by Thomas Ligotti "Charnelhouse of the Moon" by Thomas Ligotti "Ten Steps to Thin Mountain" by Thomas Ligotti "Selections of Lovecraft" by Thomas Ligotti "The Consolations of Horror" by Thomas Ligotti Reviews by Stefan Dziemianowicz Letters by Steve Brenner, Marie Lazzari, Henry James, Brian Lumley , Darrell Schweitzer , Krishna C. Sherman, Wilum Pugmire , Simon MacCulloch, Pierre Comtois , L. Sprague de Camp , Dennis Rickard, Kenneth W. Faig, Jr., David E. Schultz , Richard L. Tierney , and Stefan R. Dziemianowicz</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>68</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu"/>
    <ex:wasReleasedOnW>November 1989</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Black_Star_Magic">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Black Star Magic</rdfs:label>
    <ex:hasAnnotation>Pelgrane press 18 is a gamebook supplement for the roleplaying game the yellow king . Written by robin d. laws , sarah saltiel , gareth ryder-hanrahan , and ruth tillman . Introduces advanced rules for using magic in the game .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Gareth_Ryder-Hanrahan"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robin_D._Laws"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ruth_Tillman"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Sarah_Saltiel"/>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:hasPageCountW>18</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>The Yellow King</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Anton_Zarnak_%28series%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#StoryCycles"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Anton Zarnak (series)</rdfs:label>
    <ex:hasAnnotation>Anton Zarnak Lin Carter et al English Genre(s) Weird fiction The Anton Zarnak series is a collection of occult detective stories centred around the character from which it takes its name . Overview Fully integrated into the Cthulhu Mythos , the Anton Zarnak series follows the titular character and his loyal manservant Ram Singh as they battle supernatural threats to humanity, including gods, monsters, evil cults, and insane sorcerers. Behind the Mythos Created by Mythos stalwart Lin Carter for his 1988 short story " Dead of Night ", the tales of Anton Zarnak have been expanded upon by several other authors, including Robert M. Price (who was also Carter's literary executor), C. J. Henderson , Pierre Comtois , and Joseph S. Pulver, Sr. Entries Lin Carter's Works " Dead of Night " (1988) Other Works " Dope War of the Black Tong " (1976, Robert M. Price) " The Soul of the Devil-Bought " (1996, Robert M. Price)</ex:hasAnnotation>
    <ex:hasAuthorW>Lin Carter et al</ex:hasAuthorW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
