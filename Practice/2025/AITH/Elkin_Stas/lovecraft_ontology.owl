    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Traube</rdfs:label>
    <ex:ceasedOnC>1917 July 2nd</ex:ceasedOnC>
    <ex:hasAffiliationC>Imperial German Navy</ex:hasAffiliationC>
    <ex:hasAnnotation>July 2nd, 1917 Germany Navy Seaman (Submariner) Imperial German Navy Human First appearance HPL : " The Temple " Created by H. P. Lovecraft Seaman is a fictional character in the story " The Temple " by H. P. Lovecraft . He served aboard the German submarine U-29 under Lieutenant-Commander Karl Heinrich during the First World War. As a result of the fear and stress suffered by the crew during the supernatural events that befell them, they started to become mutinous. When they sighted an American battleship the men were restless in their desire to surrender to it. in particular insisted on this with such violence that Lieutenant Klenze shot him to death in order to maintain discipline.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Temple"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
