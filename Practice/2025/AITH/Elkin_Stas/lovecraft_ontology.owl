    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Derelict</rdfs:label>
    <ex:hasAnnotation>Sandy Petersen (with Mike Mason ) M. Wayne Miller Cover Artist M. Wayne Miller United States English Call of Cthulhu Genre(s) Roleplaying game Chaosium Release Date June 2016 48 is a scenario supplement for the Call of Cthulhu horror roleplaying game. Written by Sandy Petersen with Mike Mason , it featured artwork by M. Wayne Miller and cartography by Stephanie McAlea . The book was released as a digital download by Chaosium in June 2016 as part of the Free RPG Day initiative , with physical copies later being made available at Lulu.com . Overview Set aboard a derelict freighter in the North Atlantic, the scenario is less of an actual story, and more of a sandbox setting where investigators are rewarded for improvising solutions in a desperate fight for survival against the Sciapod, a monstrous creature incorporated from Norwegian folklore. Gallery References</ex:hasAnnotation>
    <ex:hasAuthorW>Sandy Petersen (with Mike Mason )</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
