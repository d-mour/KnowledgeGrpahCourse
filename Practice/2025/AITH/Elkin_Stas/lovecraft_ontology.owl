  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dagon_Rising:_William_Meikle_vs._H._P._Lovecrafts_Dagon">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dagon Rising: William Meikle vs. H. P. Lovecraft's Dagon</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft William Meikle Luke Spooner Cover Artist Ben Baldwin English Crystal Lake Publishing Release Date December 2019 45 is a chapbook collection of Cthulhu Mythos works by H. P. Lovecraft and William Meikle . It was published in paperback format by Crystal Lake Publishing in December 2019. Cover art was supplied by Ben Baldwin, and it featured interior illustrations by Luke Spooner. Overview Contents " Dagon " by H. P. Lovecraft "Dagon Rising" by William Meikle</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasPageCountW>45</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>December 2019</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Men_of_Shadow">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Crossovers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Men of Shadow</rdfs:label>
    <ex:hasAnnotation>The story is set in arkham and involves the protagonists facing off against dagon and his vampire cult . The story was heavily inspired by h. p. lovecraft 's the shadow over innsmouth . The vampire cult takes allard to innsmouth and attempts to use him as a sacrifice .</ex:hasAnnotation>
    <ex:hasAuthorW>A.C. Farley</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>March 1990</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Andrew_Leman">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Andrew Leman</rdfs:label>
    <ex:hasAnnotation>Leman is an american author, editor, artist, filmmaker, games designer, and co-founder of the h. p. lovecraft historical society . He has produced a multitude of lovecraftian works over a career spanning decades . The 2005 film the call of cthulhu won two (audience choice and best of the fest) at the 2005 h. p. lovecraft film festival .</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Artist</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Filmmaker</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>The H. P. Lovecraft Historical Society co-founder</ex:isConnectedToMythosR>
    <ex:isKnownForR rdf:resource="http://example.org/lovecraft#The_Call_of_Cthulhu"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shawn_Ramsey">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonFictionAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Shawn Ramsey</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Editor Author Horror is an author, poet, and editor who specialises in the horror . His work has been featured in periodicals such as The Arkham Sampler , Tales of Lovecraftian Horror , Deathrealm , Eldritch Tales , and Chronicles of the Cthulhu Codex , and he contributed numerous pieces to Robert M. Price 's long-running Lovecraftian fanzine Crypt of Cthulhu . Ramsey's editorial credits include all three issues of the fanzine Revelations from Yuggoth . Selected Works Editor Revelations from Yuggoth (1987-1989) Non-Fiction " Henry Kuttner's Cthulhu Mythos Tales: An Overview " (1987) External Links at the Internet Speculative Fiction Database</ex:hasAnnotation>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Hep_Cats_of_Ulthar_and_Other_Lovecraftian_Tales">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Hep Cats of Ulthar and Other Lovecraftian Tales</rdfs:label>
    <ex:hasAnnotation>Richard Lee Byers English Macabre Ink Release Date May 2018 200  is a collection of works by American Richard Lee Byers . Containing 13 stories, it was published by Macabre Ink, an imprint of Crossroad Press, in May 2018. Contents "The Hep Cats of Ulthar" "The Horror on the Freighter" "Hate, Courage, and Blood" "IV-F" "Vermin" "The Bubble Man" " Kickstarter " "Floater" "Advanced Placement" "Leaves" "Bug Zapper" "The Body Shop" "Hope"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Richard_Lee_Byers"/>
    <ex:hasPageCountW>200</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>May 2018</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecraftiana_Vol_5,_Issue_3">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraftiana Vol 5, Issue 3</rdfs:label>
    <ex:hasAnnotation>Various Dean Wirth Cover Artist James Toeken English Rogue Planet Press Release Date 31 October 2020 127  was edited by Gavin Chappell and published by Rogue Planet Press in October 2020. Both physical and digital versions were released. It features a cover by James Toeken and interior art by Dean Wirth (who also provided one of the stories). Contents " Answering the Call " by Ngo Binh Anh Khoa " The Thing in the Jar " by Carlton Herzog " Catch of the Day " by Ed Nobody " The Randy Oswald Story " by Dean Wirth " Unexpected Turbulence " by Daniel Purcell " The Shadow by the Altar " by David A. Riley " A Fidus Aranea " by Kevin L. O'Brien " Anadhan " by Kieran Judge " Experiments… " by Sergio Palumbo and Ernesto Canepa " The Shadow Resurrection " by Lee Clark Zumpe and David Hopewell " Portents and Omens " by John M. McCormick "Review: The Children of Gla'aki" by John C. Adams " Lilith " by Sandro D. Fossemò " Bête Noire " by Greg Francis</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>127</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>31 October 2020</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Quy">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Quy</rdfs:label>
    <ex:hasAnnotation>First appearance EXP : "The Thing in the Library" Created by E. P. Berglund Crispin Burnham is a continent with a prehuman civilisation which seem to have been active even before Atlantis and Valusia , including the "seven cities" mentioned in The Black Book of the Skull . Once it covered the whole continent of America, but when the Old Ones and their servants retreated the humans who had moved into the area divided into two groups: those who maintained in the south, influenced by the gods and worshipping the Old Ones; and those who established the civilisation of Cakatomia, in North America. Appearances "The Worm" ( Crispin Burnham )</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnL>The Thing in the Library</ex:madeFirstAppearanceOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Taint_and_Other_Novellas">
    <rdf:type rdf:resource="http://example.org/lovecraft#BrianLumleyWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CrossroadPress"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Taint and Other Novellas</rdfs:label>
    <ex:hasAnnotation>Brian Lumley Cover Artist Bob Eggleton English Genre(s) Cthulhu Mythos Subterranean Press Release Date October 2007 279 is a collection of mid-length Cthulhu Mythos stories by Brian Lumley , first published by Subterranean Press in 2007. It is a companion to Haggopian and Other Stories , which comprises many of Lumley's shorter Mythos tales. Contents "Introduction" (essay) The Horror at Oakdeene (1977) Born of the Winds (1975) The Fairground Horror (1976) The Taint (2005) Rising with Surtsey (1971) Lord of the Worms (1983) The House of the Temple (1980)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasPageCountW>279</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>October 2007</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#To_Sea">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>To Sea</rdfs:label>
    <ex:hasAnnotation>Short story was published in the digital zine lovecraftiana vol 5, issue 4 in 2021 . A man commits to paper the story of how the world ended . Spore-transmitted contagion washed ashore by something malevolent .</ex:hasAnnotation>
    <ex:hasAuthorW>Josef Desade</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Issue 4</ex:isPublishedAsW>
    <ex:isPublishedAsW>Lovecraftiana Vol 5</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2021</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Bring_the_Thunder">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Bring the Thunder</rdfs:label>
    <ex:hasAnnotation>Behind the mythoswas written as part of an online writing challenge which gave story prompts from h.p. Lovecraft's commonplace book .</ex:hasAnnotation>
    <ex:hasAuthorW>Chris Lynch</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Welcome_to_Neverbury"/>
    <ex:wasPublishedOnW>June 2023</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Hog">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Hog</rdfs:label>
    <ex:hasAnnotation>William Hope Hodgson English Thomas Carnacki Carnacki: The Ghost-Finder date 1947 " " is a short story by the late William Hope Hodgson which first appeared in the collection Carnacki: The Ghost-Finder in 1947, nearly three decades after Hodgson's death. Chaosium retroactively incorporated the story into the Cthulhu Mythos when they included the antagonist, which they dubbed " Saaitti ", as a Great Old One in the Call of Cthulhu roleplaying game. Synopsis Thomas Carnacki takes on the case of a man plagued by a malignant supernatural swine. He is eventually able to banish the entity, but discovers that the creature may have entered our world through the man's mind.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Hope_Hodgson"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Thomas_Carnacki"/>
    <ex:isPublishedAsW>Carnacki: The Ghost-Finder</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1947</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Shards_of_Darkness">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Shards of Darkness</rdfs:label>
    <ex:hasAnnotation>E. P. Berglund Cover Artist D. L. Hutchison English Mythos Books Release Date 2000 158 is a collection of Lovecraftian fiction by the late American E. P. Berglund . Running to a total of 158 , it featured cover art by D. L. Hutchison, an introduction by leading H. P. Lovecraft scholar Robert M. Price , and was published by Mythos Books in 2000. Overview Contents Disciple of Cthulhu, introduction by Robert M. Price "The Feaster from the Stars" "Vision of Madness" " Wings in the Night " "The Sand Castle" "The Towers" "Sword of the Seven Suns" "The Eyes of Darkness" "The Crystal" "Dream-Sendings" "The Inner Gateway" "The Drive" Notes on the Stories by E. P. Berglund</ex:hasAnnotation>
    <ex:hasAuthorW>E. P. Berglund</ex:hasAuthorW>
    <ex:hasPageCountW>158</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2000</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Albino_penguin">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonSapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Albino penguin</rdfs:label>
    <ex:hasAffiliationC>Elder Things</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Aptenodytes albus (source)</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Aptenodytes miskatonensis</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Albino penguins are a species of penguin described by explorer william dyer as standing six-feet-tall . Despite being incredibly large, they are harmless, calm and apathetic towards humans . Specimens are kept as exhibits in san francisco zoo, the only zoo in the world to have successfully bred them .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#At_the_Mountains_of_Madness"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Night_Sea-Maid_Went_Down">
    <rdf:type rdf:resource="http://example.org/lovecraft#BrianLumleyWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Night Sea-Maid Went Down</rdfs:label>
    <ex:hasAnnotation>The story is told in the form of a letter from bernard jordan, nicknamed "pongo" it is one of the two stories that lumley later incorporated into his 1974 novel . The story is told in the form of a letter from "pongo" to his boss .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_Lumley"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>The Caller of the Black</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1971</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Gods_of_Ragnarok">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Gods of Ragnarok</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAnnotation>Great old ones are extradimensional entities created by the bbc in 1988 for doctor who . They were later identified as great old ones by the doctor . The time lord rassilon was the one who named them raag (father ragnarok), nah (mother ragnarok), and rok (little girl)</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Greatest Show in the Galaxy</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Stephen Wyatt</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#isCharacterMateOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>isCharacterMateOf</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/lovecraft#Character"/>
    <rdfs:range rdf:resource="http://example.org/lovecraft#Character"/>
    <owl:inverseOf rdf:resource="http://example.org/lovecraft#hasCharacterMateC"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Fenris_Wolf">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Fenris Wolf</rdfs:label>
    <ex:hasAffiliationC>Asgardians (Norse Gods)</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Fenrir</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Fenris</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Fenris the Wolf</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Iron-jawed Fenris</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>the Wolf God</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>the Wolf of Wolves</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The (also known as fenrir) is a giant wolf deity from norse mythology . It was first mentioned in the anonymous narrative poem collection poetic edda . The marvel comics incarnation was created in 1965 by stan lee and jack kirby .</ex:hasAnnotation>
    <ex:hasAppearanceC>Various Marvel Comics</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC>Poetic Edda</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Jack Kirby</ex:wasCreatedByC>
    <ex:wasCreatedByC>Stan Lee</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Vampiric_Verses">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Vampiric Verses</rdfs:label>
    <ex:hasAnnotation>This is a 5-part story arc in issues #14-18 of the 1st volume of doctor strange, sorcerer supreme written by roy thomas and dann thomas . The vampires of marvel earth are part of the mythos . Being created by the darkhold (the source of the necromicon)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Roy_Thomas"/>
    <ex:hasAuthorW>Dann Thomas</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>Feb 1990 - June 1990</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#H._P._Lovecraft_in_the_Argosy">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>H. P. Lovecraft in the Argosy</rdfs:label>
    <ex:hasAnnotation>Collected Correspondence from the Munsey Magazines H. P. Lovecraft United States English Genre(s) Non-fiction Necronomicon Press Release Date April 1990 40 : Collected Correspondence From The Munsey Magazines is a short non-fiction work edited by noted Howard Phillips Lovecraft scholar and critic S. T. Joshi . Overview As can be gleaned from the title, collects the letters sent by Lovecraft to Munsey's Magazine and Argosy , human interest and pulp magazines respectively, which merged in October 1929. It runs to a total of 40 and was first published in 1994 by Necronomicon Press .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:hasPageCountW>40</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>April 1990</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Misquamacus">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Misquamacus</rdfs:label>
    <ex:hasAffiliationC>Wampanoag Nation</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Quamis</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Quamis is a fictional character created by h. p. lovecraft and august derleth . He first appeared in a fragment written by lovecraft and incorporated into a larger narrative . The character has since gone on to appear in works by other creators .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Lurker_at_the_Threshold"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Chaos_Wastes">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsOriginatingFromMythosInspiredWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Chaos Wastes</rdfs:label>
    <ex:hasAnnotation>Northern Pole of the World-that-Was Ruling Powers The Chaos Gods Created by Games Workshop  The are warped lands from the fictional universe of the Warhammer Fantasy tabletop miniature wargame by Games Workshop . Background The are the northern part of the world where for aeons, ever since the collapse of the Old One's Warp Gates, the Immaterium has been bleeding into the material world. It has claimed much of the great Northern Steppes and all of Norsca, corrupting the lands with the warping energies of the Immaterium. Among the vicious Kurgan, Hung, and Northmen of the lands, the physical mutations brought about by it is common and accepted as gift by the Chaos Gods. Gallery</ex:hasAnnotation>
    <ex:isLocatedAtL>Northern Pole of the World-that-Was</ex:isLocatedAtL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Asylum_Diaries:_Arkham">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Periodicals"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Asylum Diaries: Arkham</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Brian Craddock Australia English The Asylum Diaries Oscillate Wildly Press Release Date May 2019 110  was the first issue in an intended horror magazine titled The Asylum Diaries , published by the now-defunct Australian small press Oscillate Wildly Press. Edited by Claire Fitzpatrick and Matt Schuler, it featured cover art by Brian Craddock, interior work by Fitzpatrick and Aaron Sterns, and was released in May 2019 in a digital format. The issue consists of four Lovecraftian short stories, three of which are directly set in the Cthulhu Mythos , a parody horoscope, and some scattered art plates, one of which features a mock advertisement for enrolment in the Psychology curriculum at Miskatonic University . Contents " Dead Deal " by Drew Nicks " HorrorScopes " by uncredited "The Old Ways" by Art Robinson " Hiru Gyamu " by Gerry Huntman " Atishfishan " by Brian Craddock</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW rdf:resource="http://example.org/lovecraft#Australia"/>
    <ex:hasPageCountW>110</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>The Asylum Diaries</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>May 2019</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ilarnek">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalLocations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Ilarnek</rdfs:label>
    <ex:hasAnnotation>Mnar city is a city in the land of mnar on the river ai in the dreamlands . It was built by the same wandering tribes that built the cities of thraa , kadatheron , and sarnath . The green stone idol of bokrug , the great water lizard, was found on the marshy lakeshore where the city once stood .</ex:hasAnnotation>
    <ex:hasAppearanceL rdf:resource="http://example.org/lovecraft#The_Dream-Quest_of_Unknown_Kadath"/>
    <ex:hasAppearanceL rdf:resource="http://example.org/lovecraft#The_Quest_of_Iranon"/>
    <ex:hasNotableFeatureL rdf:resource="http://example.org/lovecraft#River_Ai"/>
    <ex:hasTypeL>City</ex:hasTypeL>
    <ex:isInhabitedByL>Humans</ex:isInhabitedByL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Mnar"/>
    <ex:madeFirstAppearanceOnL rdf:resource="http://example.org/lovecraft#The_Doom_That_Came_to_Sarnath"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Shadow_Kingdom">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RobertEHowardWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Shadow Kingdom</rdfs:label>
    <ex:hasAnnotation>Kull of valusia is the first story in the kull of atlantis series . It is the story of a renegade atlantean renegade who seized the throne of the ancient kingdom of valusia . It is notable for introducing the serpent people , a species that would also be featured in the stories of h. p. lovecraft .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Kull of Valusia</ex:isPartOfSeriesW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>August 1929</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Stainless_Steel_Sarcophagus:_Tales_of_Lovecraftian_Fantasy_%26_Horror">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Stainless Steel Sarcophagus: Tales of Lovecraftian Fantasy &amp; Horror</rdfs:label>
    <ex:hasAnnotation>Mark McLaughlin Michael Sheehan, Jr. English Release Date 2018 66  is a collection of short stories by authors Mark McLaughlin and Michael Sheehan, Jr. Overview Consisting of seven stories and running to a total of 66 , was released as a digital download for Amazon's Kindle platform in 2018. It is divided into two thematic sections, the first devoted to Lovecraftian weird fiction, and the second to Mythos content. Contents Part 1: Dimensions Of Doom " Stainless Steel Sarcophagus " " The Dollmaker's Vengeance " " Queen Of The Vultures " " The House Of The Ocelot " Part 2: Mythos Misadventures " Unspeakable " " Spawn Of The Rancid Deepnesses " " The Inside-Outsider "</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mark_McLaughlin"/>
    <ex:hasAuthorW>Michael Sheehan. Jr.</ex:hasAuthorW>
    <ex:hasPageCountW>66</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2018</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kyuss">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Kyuss</rdfs:label>
    <ex:hasAnnotation>Eldritch god-like abomination from the fictional universe of the forgotten realms pencil-and-paper roleplaying game . First appeared in the dungeons &amp; dragons fiend folio released for advanced dndfe . Selected for inclusion in that book having previously been entered in a monster design competition in white dwarf magazine .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#It">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>It</rdfs:label>
    <ex:hasAnnotation>"pennywise the clown" tells the story of a shapeshifting entity that emerges every 27 years to prey on the fears of the residents of derry, maine . Parallels have been drawn between pennywise and h. p. lovecraft 's cthulhu . Much of the first half</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Stephen_King"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>1986</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Downward_to_Darkness">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Downward to Darkness</rdfs:label>
    <ex:hasAnnotation>Cthulhu mythos followed by worse things waiting is a novel by brian mcnaughton . It was originally published in 1978 as satan's mistress (carlyle books) it was followed by a sequel, worse things waiting (aka satan's seductress) a 15-year-old boy has vivid dreams about a mysterious woman .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Brian_McNaughton"/>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Daughter_of_Atlach-Nacha">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ServitorRaces"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Daughter of Atlach-Nacha</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Atlach-Nacha"/>
    <ex:hasAlternativeNamesC>Children of the Spider God</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Harvesters</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Loathsome Creepers</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Makarasa Jeisa</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Puer Aranea</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The daughters of atlach-nacha are a species of arachnid horrors created for the call of cthulhu roleplaying game . Every one of them started out as human, women chosen to become companions of the great old one . Eventually the women undergo a nightmarish transformation, as they shed their skin and change into a giant spider .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Andaman Islands</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Keith_Herber"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Scrying_Stones_of_Chthon">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artefact"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ArtefactsOriginatingFromMythosAdjacentWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MysticalArtefacts"/>
    <rdfs:label>Scrying Stones of Chthon</rdfs:label>
    <ex:hasAnnotation>The first appeared in "doctor voodoo: avenger of the supernatural vol 1 #1" in 2009 . It has not been revealed if the stones were created by chthon himself or others . Through the stones one can see the location of other beings, including hell lords .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnA>Doctor Voodoo: Avenger of the Supernatural Vol 1 #1</ex:madeFirstAppearanceOnA>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crawford_Tillinghast">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Crawford Tillinghast</rdfs:label>
    <ex:ceasedOnC>Early 20th century</ex:ceasedOnC>
    <ex:hasAnnotation>Tillinghast is a character created by the late american author h. p. lovecraft . Tillinghast is the best friend of the story's narrator . He was the creator of a machine which could open gateways between worlds . His experiments ended in disaster when his friend destroyed the machine .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#From_Beyond"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Fall_of_Cthulhu">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Fall of Cthulhu</rdfs:label>
    <ex:hasAnnotation>Various English Horrified Press Release Date May 2015 170 Followed by Volume II is an anthology of Lovecraftian fiction edited by Douglas Draa and released in June 2015. Unusually, it was published by Horrified Press , the parent company of specialty imprint Rogue Planet Press , who normally issue their Lovecraftian releases through this label. Overview Contents "The Black Winged Ones" by W. H. Pugmire "The Madness of Understanding" by Vincent LaManna "A Dark and Stormy Night" by Ran Cartwright "A Rather Rude Summoning" by David Neilsen "The Confession of Trevor Gordon" by Kachina Fhtagn "Chains in the Dark" by Matt Sullivan and Robert Trska "Corpses Sweet Oranges" by Nicholaus Patnaude "Darkness Has Its Reasons" by Roo Bardookie "Cthulhu in Oz" by Peter Kelly "Cthulhu Rises" by R. L. Andrew "Hollowed • short story by Patrick Tumblety "Hope" by Richard Lee Byers "The House of Omicron" by Anthony Labriola "Loc Phuket and Humanity's Second Chance" by E. W. Farnsworth "One to the Other" by Joseph Patchen "Periphery" by Julio Toro San Martin "Ouroboros" by Patrick Oakley "Spider Stories" by Andre Harewood "Pnakotic Reaction" by Duane Pesice "Ubbo-Sathla Night" by Frederick J. Mayer "Come Hell or High Water, Corporate Wants a Monster Movie" by Dave Fragments Gallery</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>170</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>May 2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#J._Michael_Straczynski">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>J. Michael Straczynski</rdfs:label>
    <ex:hasAnnotation>American writer best known for his work in television and comic books . Created the science fiction series babylon 5 and acted as a writer and story editor on the animated series the real ghostbusters . Was one of the writers of the classic animated series he-man and the masters of the universe .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Stainless_Steel_Sarcophagus">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Stainless Steel Sarcophagus</rdfs:label>
    <ex:hasAnnotation>Mark McLaughlin Michael Sheehan, Jr. English Genre(s) Horror The House of the Ocelot &amp; More Lovecraftian Nightmares date 2019 " " is a short Cthulhu Mythos story by authors Mark McLaughlin and Michael Sheehan, Jr. Synopsis A magical mirror once owned by the pharaoh Nephren-Ka is unleashed on an unsuspecting department store where it proceeds to suck in customers and staff before enacting vile procedures upon them. Characters Professor Michael Farmington , historian, antiquarian and owner of the store. Mr. Graham , the floor manager. Mrs. Richards , the head of Women's Wear. History "" was included in the collections The House of the Ocelot &amp; More Lovecraftian Nightmares and Nightmares &amp; Tentacles: 13 Tales Of The Cthulhu Mythos .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Mark_McLaughlin"/>
    <ex:hasAuthorW>Michael Sheehan. Jr.</ex:hasAuthorW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>More Lovecraftian Nightmares</ex:isPublishedAsW>
    <ex:isPublishedAsW>The House of the Ocelot</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2019</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Tales_of_Inspector_Legrasse">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Tales of Inspector Legrasse</rdfs:label>
    <ex:hasAnnotation>C. J. Henderson Cover Artist Ben Fogletto United States English Mythos Books Release Date April 2005 217 is a collection of Cthulhu Mythos fiction by the late American C. J. Henderson . The stories centre around the activities of Inspector John Raymond Legrasse , a character created by H. P. Lovecraft for " The Call of Cthulhu ", and the collection includes the original story. Published by Mythos Books in 2005, it runs to 217 and features cover art by Ben Fogletto with an introduction by Robert M. Price . Contents Introduction by Robert M. Price " The Call of Cthulhu " by H. P. Lovecraft "Patiently Waiting" "To Cast Out Fear" "So Free We Seem" "Locked Room" "Where Shadow Falls" "Nothing to Fear but Dust"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#C._J._Henderson"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>217</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>April 2005</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Cthulhu_Cult">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Cthulhu Cult</rdfs:label>
    <ex:hasAnnotation>Full story online here Dan Clore English Genre(s) Humour Edward P. Berglund Nightscapes December 1997 date December 1997 " " is a humorous Cthulhu Mythos work by and poet Dan Clore. It was published in the December 1997 edition of Edward P. Berglund 's online fanzine Nightscapes . Synopsis Written to be sung to the tune of 1960s/70s sitcom The Brady Bunch , "" features one verse for the Old Ones , one for the Cthulhu cultists, and one to be sung by both. It describes the formation of the cult after the meeting of Abdul Alhazred and Cthulhu .</ex:hasAnnotation>
    <ex:hasAuthorW>Dan Clore</ex:hasAuthorW>
    <ex:hasGenreW>Humour</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Nightscapes_December_1997"/>
    <ex:wasPublishedOnW>December 1997</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cult_of_the_Bloody_Tongue">
    <rdf:type rdf:resource="http://example.org/lovecraft#Cults"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdfs:label>Cult of the Bloody Tongue</rdfs:label>
    <ex:hasAnnotation>The is an ancient african cult that worships the god of the bloody tongue . It began its activity in western kenya, but it spread throughout the continent . The most important of its celebrations is the orgiastic ritual once every five years .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crouch_End">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crouch End</rdfs:label>
    <ex:hasAnnotation>Lonnie and doris freeman are on their way to a dinner party when they find themselves lost in the london suburb of . As they make their way through an increasingly-bizarre world, lonnie is taken by a nightmarish creature . The story was adapted into an episode of nightmares and dreamscapes: from the stories of stephen king by television network tnt .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Stephen_King"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Dreamscapes (1993)</ex:isPartOfSeriesW>
    <ex:isPartOfSeriesW>New Tales of the Cthulhu Mythos (1980) Nightmares</ex:isPartOfSeriesW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#James_Ambuehl">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#NonFictionAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>James Ambuehl</rdfs:label>
    <ex:hasAnnotation>Mike jury is an american writer, poet and editor who has made a number of contributions to the h. p. lovecraft -inspired cthulhu mythos . Many of ambuehl's mythos works are set in or around the town of braving, minnesota . Although unconfirmed at the time of writing, it would appear that he is somehow related to author and poet tracy ambuehl .</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasPseudonymR>H. P. Filkcraft</ex:hasPseudonymR>
    <ex:hasPseudonymR>Lew Cthew</ex:hasPseudonymR>
    <ex:hasPseudonymR>Mike Jury</ex:hasPseudonymR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Loyalty">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Loyalty</rdfs:label>
    <ex:hasAnnotation>The last days of an alien invasion in 2087, the surviving humans enlist the aid of an elderly professor with the aim of awakening great cthulhu to destroy the aggressors . However, cthulhu wants something from humanity in return, and the survivors discover that the cost of salvation is far worse than they had expected .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#John_Shirley"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>Science Fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Keeper_of_the_Gate">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Keeper of the Gate</rdfs:label>
    <ex:hasAnnotation>Two police officers, unhappy at the official explanation for a family annihilation to which they were the first responders, launch their own investigation into the crime . They uncover a cult dedicated to yog-sothoth who trade their lives for the gift of prophecy .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Dark_Rites_of_Cthulhu"/>
    <ex:wasPublishedOnW>March 2014</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#PulpMagazines">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#Work"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Eldritch_Investigations:_Lovecraftian_Tales_of_Occult_Detection">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Eldritch Investigations: Lovecraftian Tales of Occult Detection</rdfs:label>
    <ex:hasAnnotation>Volume 1 Various Cover Artist Josiah Witkofsky English Genre(s) Lovecraftian horror Mythos Press Release Date July 2023 502 is a collection of Lovecraftian horror edited by Tim Mendees , featuring cover art by Josiah Witkofsky, and published by Mythos Press in July 2023; both print and digital editions were released . Overview Contents "Where Dreams Come True" by Simon Bleaken "The Idol of Dragon" by Stephen Herczeg "Fruiting Bodies" by Gavin Chappell "The Professor Snow Affair" by Robert Poyton "Mother of Serpents" by Glynn Owen Barrass "Grinder Rock" by B. Harlan Crawford "The Maltese Cthulhu" by C. T. Phipps "Deepest Darkest Geometry" by John A. DeLaughter "Harlan Cormell &amp; the Cult of Byakhee" by Josiah Witkofsky "The Fung Mystery" by Matthew Davenport "The Horror of Angove Hall" by Tim Mendees "The O'Conner Files: The Cults" by Charles Reis "The Yellow Door" by Mark Rankin References</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasGenreW>Lovecraftian horror</ex:hasGenreW>
    <ex:hasPageCountW>502</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>July 2023</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#White_Darkness">
    <rdf:type rdf:resource="http://example.org/lovecraft#Crossovers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>White Darkness</rdfs:label>
    <ex:hasAnnotation>The doctor is a time lord from the planet gallifrey who travels through time and space in a ship called the tardis . He and his two human companions mistakenly land in 1915 haiti, in the middle of a revolution . They are arrested and brought before the cruel general etienne . The tardis key is confiscated by captain petion, who is assigned as their guide .</ex:hasAnnotation>
    <ex:hasAuthorW>David A. McIntee</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Science fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>New Adventures ( Doctor Who )</ex:isPartOfSeriesW>
    <ex:wasPublishedOnW>1993</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Gi-Hoveg">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Gi-Hoveg</rdfs:label>
    <ex:hasAlternativeNamesC>The Aether Anemone</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Aether Anemone Unknown First appearance EXP : " The Advent of Uvhash " Created by James Ambuehl is a Great Old One with giant spongy flesh and spikes protruding from it's body. It is the arch rival of Uvhash , The Blood Mad God Of The Void.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Advent_of_Uvhash"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#James_Ambuehl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Andrew_Doran_%28character%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Andrew Doran (character)</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Miskatonic_University"/>
    <ex:hasAnnotation>Andrew doran is a character created by american author matthew davenport for his cthulhu mythos series . He made his first appearance in the novel the statement of andrew doran in 2013 . An athletic man with a thick crop of unruly brown hair and matching beard, he is a proficient user of magic . In 1941, he was tasked by the serving dean of miskatonic university with recovering their copy of the necronomicon .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Statement_of_Andrew_Doran"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Matthew_Davenport"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Cold_Print_%28short_story%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RamseyCampbellWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Cold Print (short story)</rdfs:label>
    <ex:hasAnnotation>"cold print" is a short story by english horror writer ramsey campbell . It first appeared in the anthology tales of the cthulhu mythos in 1969 . The story is the first appearance of the great old one y'golonac .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror Short Fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasWrittenOnW>1969</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Voor">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Voor</rdfs:label>
    <ex:hasAnnotation>The voors were once the most prosperous race on earth, but steady out-competition by the hyperboreans forced them underground . Their name comes from the "kingdom of " mentioned in arthur machen 's " the white people "</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Secret in the Parchment</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Richard_A._Lupoff">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosInspiredAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Richard A. Lupoff</rdfs:label>
    <ex:diedOnR>22 October 2020</ex:diedOnR>
    <ex:hasAnnotation>Richard allen lupoff (21 february 1935 - 22 october 2020) was a prolific american author who wrote fiction in several genres, as well as non-fiction . He has written a number of pieces set in the greater cthulhu mythos, including at least one which features a fictionalised version of h.p. Lovecraft .</ex:hasAnnotation>
    <ex:hasBirthplaceR>Brooklyn New York USA</ex:hasBirthplaceR>
    <ex:hasFullNameR>Richard Allen Lupoff</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasPseudonymR>A. E. Van Hocked</ex:hasPseudonymR>
    <ex:hasPseudonymR>Addison E. Steele</ex:hasPseudonymR>
    <ex:hasPseudonymR>Addison Steele II</ex:hasPseudonymR>
    <ex:hasPseudonymR>Ova Hamlet</ex:hasPseudonymR>
    <ex:hasPseudonymR>Ray Razzberry</ex:hasPseudonymR>
    <ex:hasPseudonymR>Robert A. Mainline</ex:hasPseudonymR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>21 February 1935</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tharapithia">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Tharapithia</rdfs:label>
    <ex:hasAlternativeNamesC>The Shadow in the Crimson Light</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Shadow in the Crimson Light First appearance " The Shadow in the Crimson Light " Created by Adrian Shepard is a Slavic and Ugric god-like creature, photophobic and burrowing fiend worshipped in the Middle Ages. It cannot endure sunlight, and eludes it by tunneling deep underneath the roots of oak trees.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>The Shadow in the Crimson Light</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Adrian Shepard</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#William_Blake_%28character%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>William Blake (character)</rdfs:label>
    <ex:hasAnnotation>William blake is a recurrent character in the works of british author david hambling . By the 1920s, he was one of the bright young things, a term given to the post-world war i generation of the london party scene . While studying for his phd, he made a living by tutoring promising lower-achievers, at that time renting a room in the house of an older couple by the name of hall . Later in life, blake would become a teacher, living</ex:hasAnnotation>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#David_Hambling"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dionysus_Club">
    <rdf:type rdf:resource="http://example.org/lovecraft#Cults"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Organisation"/>
    <rdfs:label>Dionysus Club</rdfs:label>
    <ex:hasAffiliationO rdf:resource="http://example.org/lovecraft#Disciples_of_Deaths_Shadow"/>
    <ex:hasAnnotation>The is a fictional organization in the cthulhutech pencil-and-paper roleplaying game by wildfire llc . It recruits the rich and operates as a club where they can indulge their vices . Initiates are coerced to commit crimes, humiliate themselves, or do something that damages their career or position .</ex:hasAnnotation>
    <ex:hasPurposeO>Indoctrination</ex:hasPurposeO>
    <ex:hasPurposeO>blackmail</ex:hasPurposeO>
    <ex:hasTypeO>Cult</ex:hasTypeO>
    <ex:isLocatedAtO>Global</ex:isLocatedAtO>
    <ex:wasCreatedBynO>Wildfire LLC</ex:wasCreatedBynO>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Stanley_Pickman">
    <rdf:type rdf:resource="http://example.org/lovecraft#Avatars"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Stanley Pickman</rdfs:label>
    <ex:ceasedOnC>Exact date unknown likely sometime in the early 21st century</ex:ceasedOnC>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Nyarlathotep"/>
    <ex:hasAnnotation>Exact date unknown, likely sometime in the early 21st century Nyarlathotep First appearance " Black Letter Day " Created by Ian Davey is a character created by Ian Davey for his short Cthulhu Mythos story " Black Letter Day ". At the culminations of the events of " The Epiphany of Dissolution " he is revealed to be an avatar of Nyarlathotep . Description At first appearing as an older man who claims a professorship in an unknown subject, after the fall of mankind and return of the Old Ones looked considerably younger, as if the global catastrophe has somehow rejuvenated him. Later, in a confrontation with Glyph and Lucy , Pickman was obliterated when Nyarlathotep fully manifested and called forth his fellow Outer God Yog-Sothoth . Appearances " Black Letter Day " (1997) " An Incarceration in Bh'Yhlun " (1997) " The Epiphany of Dissolution " (1998)</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Black_Letter_Day"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Ian_Davey"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crypt_of_Cthulhu_Yuletide_1984">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crypt of Cthulhu Yuletide 1984</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Robert M. Price United States English Crypt of Cthulhu Cryptic Publications Release Date December 1984 40 Preceded by Untold Tales by Clark Ashton Smith Followed by Candlemas 1985 is the 28th issue of leading H. P. Lovecraft scholar Robert M. Price 's long-running Lovecraftian fanzine Crypt of Cthulhu . Edited by Price, who also provided the cover art, it features interior panels by W. H. Wesley, De Bry and Jeff Dee, ran to a total of 40 in an A5 format, and was published by Cryptic Publications in December 1984. This was a special edition devoted to the horror works of Lovecraft which do not involve the "canon" Cthulhu Mythos . Contents Editorial Shards by Robert M. Price "Sources for "The Colour Out of Space"" by Will Murray "The Humor at Red Hook" by Robert M. Price "Abnormal Longevity in "The Picture in the House"" by Darrell Schweitzer "Lovecraft and the Regnum Congo" by S. T. Joshi "The Terrible Old Cat" by Will Murray "A Note on "Cool Air"" by Will Murray "Truth Is Stranger Than Lovecraft" by uncredited contributor "The Slitherer from the Slime" by Lin Carter and Dave Foley "Advice to the Lovecraft-Lorn" by Donna Death "Fun Guys from Yuggoth: In Pickman's Footsteps" by Will Murray Reviews by Robert M. Price Letters by Karl Edward Wagner , Robert Bloch , Gahan Wilson , Richard L. Tierney , Donald R. Burleson , Duane Rimel , Hugh B. Cave , Frank Belknap Long , and Carl Jacobi</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>40</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu"/>
    <ex:wasReleasedOnW>December 1984</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Iden-Inshi">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Iden-Inshi</rdfs:label>
    <ex:hasAnnotation>'whispers from the abyss' is a lovecraftian short story . Written as a series of diary entries kept by a kidnapped geneticist . Follows the woman and a fellow scientist as they attempt to create genetically-modified bodies .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Greg_Stolze"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Whispers_from_the_Abyss"/>
    <ex:wasPublishedOnW>2013</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecrafts_Disciples_June_2006">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraft's Disciples June 2006</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Steve Lines English Lovecraft's Disciples Rainfall Books Release Date June 2006 52 Preceded by April 2006 Followed by August 2006 is the fourth issue of the long-running Lovecraftian fanzine Lovecraft's Disciples . Edited by John B. Ford and Steve Lines , and featuring cover art by Lines, it ran to a total of 52 and was published by Rainfall Books in an A5 format . Contents "Cemetery Dance" by Steve Lines (as Lucy Francis) " Episode in an Arkham Pool Hall " by James Ambuehl "Colours" by Derek M. Fox " Seven Serpents Waiting " by Ron Shiflet "The Condensed Lovecraft" by Joel Lane "I Love a Monster Parade" by Franklyn Searight References</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>52</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Lovecrafts_Disciples"/>
    <ex:wasReleasedOnW>June 2006</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Mysterious_Ship">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Mysterious Ship</rdfs:label>
    <ex:hasAnnotation>Full story online here H. P. Lovecraft Date of writing 1902 ← Previous Next → " The Mystery of the Grave-Yard " " The Beast in the Cave " is an unfinished work by Howard Phillips Lovecraft , written in 1902. It is considered part of Lovecraft's juvenilia, or earliest works. Synopsis In abbreviated form, the story of the search for a vanished man takes place, involving a submarine and a battle with pirates.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasWrittenOnW>1902</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Rhan-Tegoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Rhan-Tegoth</rdfs:label>
    <ex:hasAlternativeNamesC>He of the Ivory Throne</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Terror of the Hominids</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Hazel heald is a fifteen foot tall, medusa-like, insectoid god-being (great old one) of comparatively little power but vital to the return of the old ones . 3 million years ago, during the pliocene epoch, it inhabited an area of alaska before going into a hibernation like trance.</ex:hasAnnotation>
    <ex:hasAppearanceC>The Scroll of Morloc Wilbur Whateley Waiting The Return of Rhan-Tegoth Pathfinder Adventure Path #109 Strange Aeons</ex:hasAppearanceC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Horror_in_the_Museum"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Hazel_Heald"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Crypt_of_Cthulhu_Lammas_1985">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Crypt of Cthulhu Lammas 1985</rdfs:label>
    <ex:hasAnnotation>Various Mike Mackenzie Cover Artist Dirk W. Mosig United States English Crypt of Cthulhu Cryptic Publications Release Date August 1985 52 Preceded by St. John's Eve Followed by Crypt of Cthulhu Michaelmas 1985 is the 33rd issue of leading H. P. Lovecraft scholar Robert M. Price 's long-running Lovecraftian fanzine Crypt of Cthulhu . Edited by Price with a cover by Dirk W. Mosig and interior art by Mike Mackenzie, it ran to a total of 52 in an A5 format, and was published by Cryptic Publications in May 1985 . This issue was a special devoted to pioneering H. P. Lovecraft scholar Dr. Dirk W. Mosig . Contents Editorial Shards by Robert M. Price "The Great American Throw-Away" by Dirk W. Mosig "The Prophet from Providence" by Dirk W. Mosig "Lovecraft: The Dissonance Factor in Imaginative Literature" by Dirk W. Mosig "Poe, Hawthorne, and Lovecraft: Variations on a Theme of Panic" by Dirk W. Mosig "Mosig at Last: My Years with the Greatest of Lovecraft Scholars" by S. T. Joshi "The Man Who Was Mosig" by Peter Cannon "Fra Mosigius" by Donald R. Burleson "Truth Is Stranger Than Lovecraft" by Alan Ziebarth Reviews by Robert M. Price, Allen Koszowski , and Peter Cannon Letters by Jean-Daniel Brèque, William Fulwiler, David Dello Monaco, Will Murray , John W. Rectenwald, Chris Beekman, and David T. Pudelwitts References</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>52</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Crypt_of_Cthulhu"/>
    <ex:wasReleasedOnW>August 1985</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Adele_Kramer">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Adele Kramer</rdfs:label>
    <ex:hasAffiliationC>Dalhousie University</ex:hasAffiliationC>
    <ex:hasAffiliationC>The Department of Extraordinary Phenomena</ex:hasAffiliationC>
    <ex:hasAnnotation>Dr. is a character who features in troy young 's nyarlathotep cycle of cthulhu mythos stories . She is a marine biologist, currently employed by the department of extraordinary phenomena . The agency stands in opposition to "the other": a catch-all term given to the forces of the cthulhu mythos . She briefly possessed a wide range of extremely powerful psychic powers as a result of spending time in</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#It_Came_from_the_Sea"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Troy_Young"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Robert_Blake">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Robert Blake</rdfs:label>
    <ex:ceasedOnC>1935 at 2:12am August 9</ex:ceasedOnC>
    <ex:hasAnnotation>Robert harrison blake is the alter ego of real life author robert bloch . Created by h. p. lovecraft and placed as the protagonist of the story " the haunter of the dark " . Primarily based on robert bloch but also incorporates elements of the personality and history of h. p. lovecraft himself .</ex:hasAnnotation>
    <ex:hasAppearanceC rdf:resource="http://example.org/lovecraft#The_Shadow_from_the_Steeple"/>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Haunter_of_the_Dark"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Robert_Silverberg">
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Robert Silverberg</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Author Birth Date 15 January 1935 New York, USA United States Years Active 1955 - present http://www.robert-silverberg.com/ (born 15 January 1935) is an American author and editor, most active in the sci-fi and fantasy genres, who wrote the Cthulhu Mythos short story " Demons of Cthulhu ". His work notably includes the Majipoor series, set on the eponymous planet populated by multiple sapient species. He is married to fellow science fiction author Karen Haber. Silverberg's Lovecraftian works have been included in anthologies such as The Madness of Cthulhu: Volume 1 and The Necronomicon: Selected Stories and Essays Concerning the Blasphemous Tome of the Mad Arab , as well as Robert M. Price 's long running fanzine Crypt of Cthulhu . Selected Bibliography Short Fiction " Demons of Cthulhu " (1959) "Diana of the Hundred Breasts" (1996) External Links at Wikipedia at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>New York USA</ex:hasBirthplaceR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasWebsiteR>http://www.robert-silverberg.com/</ex:hasWebsiteR>
    <ex:hasYearsActiveR>1955 - present</ex:hasYearsActiveR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>15 January 1935</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#A_Few_Memories">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>A Few Memories</rdfs:label>
    <ex:hasAnnotation>James F. Morton United States English Genre(s) Non-fiction SSR Publications Howard Phillips Lovecraft: Memoirs, Critiques &amp; Bibliographies date 1955 " " is a very short non-fiction piece on Howard Phillips Lovecraft written by his contemporary and correspondent James F. Morton . History Howard Phillips Lovecraft: Memoirs, Critiques &amp; Bibliographies (1955) Commentaries (1955) Lovecraft Remembered (1998)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#James_F._Morton"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Bibliographies</ex:isPublishedAsW>
    <ex:isPublishedAsW>Critiques</ex:isPublishedAsW>
    <ex:isPublishedAsW>Howard Phillips Lovecraft: Memoirs</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1955</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Psycho_Re-Animated">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosFilmAndTelevision"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Psycho Re-Animated</rdfs:label>
    <ex:hasAnnotation>English is a very short film which blends alfred hitchcock's psycho with stuart gordon's comedy-horror re-animator . It contains no real plot, consisting of scenes recreated from psycho to the backdrop of audio taken from re-animator . Directed by abner pastoll, it was released in the united kingdom on 23 january 2021 .</ex:hasAnnotation>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#Re-Animator"/>
    <ex:isBasedOnW>Psycho</ex:isBasedOnW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>23 January 2021</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dunwich_Legacy_%28Expansion%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dunwich Legacy (Expansion)</rdfs:label>
    <ex:hasAnnotation>The dunwich legacy is an expansion set for fantasy flight games' 'arkham horror: the card game' it was chronologically the first deluxe expansion to be issued, receiving a release in 2017 . It contains 156 cards, which include five new investigators along with 64 player cards and 68 encounter cards .</ex:hasAnnotation>
    <ex:hasAuthorW>MJ Newman</ex:hasAuthorW>
    <ex:hasAuthorW>Nate French</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>Living Card Game</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#Arkham_Horror:_The_Card_Game"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Advice_for_the_Weird_Fictioneer">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Advice for the Weird Fictioneer</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft United States English Fungoid Press Chronicles of the Cthulhu Codex Winter 2000 date December 2000 " " is a short non-fiction pice by the late American horror writer H. P. Lovecraft . It was published in the final issue of long-running fanzine Chronicles of the Cthulhu Codex in December 2000.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Chronicles_of_the_Cthulhu_Codex_Winter_2000"/>
    <ex:wasPublishedOnW>December 2000</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Fred_L._Pelton">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Fred L. Pelton</rdfs:label>
    <ex:diedOnR>22 September 1950</ex:diedOnR>
    <ex:hasAnnotation>Full Name Frederick Lee Pelton Connection to the Mythos Author Birth Date 29 August 1921 Alliance, Nebraska, USA Death Date 22 September 1950 United States Frederick Lee Pelton (29 August 1921-22 September 1950) was an American author who has penned a handful of works which intersect with the purview of this wiki. These include a fictional text purporting to be an ancient grimoire which describes the history of Cthulhu Mythos forces on Earth , and a pseudo-factual work on the history and practices of the Cthulhu Cult . Selected Works " The Sussex Manuscript " (1989) A Guide to the Cthulhu Cult (1998) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Alliance Nebraska</ex:hasBirthplaceR>
    <ex:hasFullNameR>Frederick Lee Pelton</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
    <ex:wasBornOnR>29 August 1921</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Recurring_Nightmares">
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
