    <ex:wasReleasedOnW>2020</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Brotherhood_of_the_Beast_%28DART_production%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAudioAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Brotherhood of the Beast (DART production)</rdfs:label>
    <ex:hasAnnotation>The Brotherhood of the Beast Based on The Fungi from Yuggoth Production Company The H. P. Lovecraft Historical Society United States English The Brotherhood of the Beast is a Dark Adventure Radio Theatre play from the H. P. Lovecraft Historical Society . It is an authorised adaptation of Chaosium 's Call of Cthulhu supplement The Fungi from Yuggoth . Overview As with all of the DART productions, The Brotherhood of the Beast comes with a set of period-authentic props. These include a Boston Globe article covering the recent deaths, a horoscope, a telegram, and a factory tour brochure. Gallery</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Fungi_from_Yuggoth"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Obmbu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Ob'mbu</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Shatterer</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Also known as The Shatterer Great Old Ones First appearance EXP : Nightmare's Disciple Created by Joseph S. Pulver, Sr. is a monstrosity that resembles a giraffe-like reptile.</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Nightmares_Disciple"/>
    <ex:wasCreatedByC>Joseph S. Pulver. Sr.</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Zathog">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Zathog</rdfs:label>
    <ex:hasAlternativeNamesC>The Black Lord of Whirling Vortices</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Dark lord of the whirling vortices is a fictional character created by the late american author richard l. tierney for his 1975 short story "from beyond the stars" it is one of the few gods not deep in torpor, and additionally still possesses its full powers . It became the patron god of the zarrians offering them rulership of the universe in return for freeing the elder gods (or pain lords)</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>From Beyond the Stars</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Richard_L._Tierney"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Worlds_of_H._P._Lovecraft:_The_Alchemist">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Worlds of H. P. Lovecraft: The Alchemist</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft (original story) Steven Philip Jones (adaptation) Octavio Cariello English The Worlds of H. P. Lovecraft Caliber Comics Release Date 1997 Preceded by The Worlds of H. P. Lovecraft: The Statement of Randolph Carter Followed by The Worlds of H. P. Lovecraft: The Lurking Fear is, as it’s title may hint at, a comic book format adaptation of the H. P. Lovecraft short story " The Alchemist ". Overview Released as part of Caliber Comics ' short-lived Worlds of H. P. Lovecraft , The Alchemist was published under their Tome Press imprint. Adapted by Steven Philip Jones and featuring artwork by Octavio Cariello , it was first released in 1997 with a digital version issued in November 2014. Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Steven_Philip_Jones"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>The Worlds of H. P. Lovecraft</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>1997</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Rats_in_the_Walls">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Rats in the Walls</rdfs:label>
    <ex:hasAnnotation>Wtis a short story by american horror writer h. p. lovecraft . Written in august–september 1923, it was first published in weird tales . Narrator's family maintained an underground city where they raised generations of "human cattle"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Nasht_and_Kaman-Thah">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraDimensionalCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Nasht and Kaman-Thah</rdfs:label>
    <ex:hasAnnotation>Dreamlands priests are fictional characters created by h. p. lovecraft for his fantasy novel the dream-quest of unknown kadath . Describe are bearded, pshent-wearing priests who guard a cavern-temple where a pillar of flame burns .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Dream-Quest_of_Unknown_Kadath"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Carolyn_Fern_Sanitorium">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>Carolyn Fern Sanitorium</rdfs:label>
    <ex:hasAccessibilityL>Road</ex:hasAccessibilityL>
    <ex:hasAnnotation>The is an institution created by author sebastian greaves for his short cthulhu mythos story " have you seen the yellow sign? " Located in the city of arkham , massachusetts, the dominates the local skyline .</ex:hasAnnotation>
    <ex:hasTypeL>Mental health facility</ex:hasTypeL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Arkham"/>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#Massachusetts"/>
    <ex:madeFirstAppearanceOnL>Have You Seen the Yellow Sign</ex:madeFirstAppearanceOnL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Duke_Givens">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Duke Givens</rdfs:label>
    <ex:hasAffiliationC>Innsport Police Department</ex:hasAffiliationC>
    <ex:hasAnnotation>Inspector is a character created by author brandon berntson for his lovecraft mysteries trilogy of cthulhu mythos novels . Made his debut appearance in 2018's the night of dagon . Married to an unnamed woman, and has a love/hate relationship with the protagonist of the series, private investigator devlin macky .</ex:hasAnnotation>
    <ex:hasCharacterMateC>Unnamed wife</ex:hasCharacterMateC>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Night_of_Dagon"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Brandon_Berntson"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Rise_of_the_Basilisk">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
