  <rdf:Description rdf:about="http://example.org/lovecraft#The_Secret_of_Kralitz">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Secret of Kralitz</rdfs:label>
    <ex:hasAnnotation>Henry Kuttner United States English Weird Tales date October 1936 "" is a Cthulhu Mythos short story by Henry Kuttner . The tale, which first appeared in Weird Tales in October 1936, was described as follows: “A story of the shocking revelation that came to the twenty-first Baron Kralitz.”</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Henry_Kuttner"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
