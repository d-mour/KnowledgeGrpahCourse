    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Stefan Dziemianowicz</rdfs:label>
    <ex:hasAnnotation>Full Name Stefan Richard Dziemianowicz Connection to the Mythos Critic Editor Author Birth Date 1957 United States Horror Stefan Richard Dziemianowicz (born 1957) is a prolific American editor, critic and author who specialises in the horror . His work has appeared in a wide range of publications since his early days as an avid letter writer to magazines and fanzines such as Robert M. Price 's long-running Crypt of Cthulhu . External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasFullNameR>Stefan Richard Dziemianowicz</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Author</ex:isConnectedToMythosR>
