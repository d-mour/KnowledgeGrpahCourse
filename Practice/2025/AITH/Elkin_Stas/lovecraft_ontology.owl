    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lily_Chen">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Lily Chen</rdfs:label>
    <ex:hasAffiliationC>Unnamed Monastic Order</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>The Martial Artist</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Lily is a fictional character created by fantasy flight games for inclusion in their vision of h.p. Lovecraft's cthulhu mythos . She was first introduced in the expansion for the second edition of arkham horror , kingsport horror . Has since been incorporated into some of their other games, including eldritch horror and mansions of madness .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Kingsport Horror Deluxe Expansion</ex:madeFirstAppearanceOnC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Atomic-Age_Cthulhu:_Tales_of_Mythos_Horror_in_the_1950s">
    <rdf:type rdf:resource="http://example.org/lovecraft#Books"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Atomic-Age Cthulhu: Tales of Mythos Horror in the 1950s</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Victor Leza United States English Call of Cthulhu Fiction Chaosium Release Date March 2015 285 is a thematic Cthulhu Mythos anthology. Overview Released by Chaosium as part of their Call of Cthulhu Fiction of roleplaying game tie-ins, Atomic-Age Cthulhu contains 19 stories and runs to a total of 285 . Edited by Glynn Owen Barrass and Brian M. Sammons with cover art supplied by Victor Leza, it was published in March 2015, and was given an ebook release in December of the same year. Contents "Bad Reception" by Jeffrey Thomas "Unamerican" by Cody Goodfellow "Fallout" by Sam Stone "Eldritch Lunch" by Adam Bolivar "Little Curly" by Neil Baker "The Day the Music Died" by Charles Christian " The Terror that Came to Dounreay " by William Meikle "The Romeo Transference" by Josh Reynolds "It Came to Modesto" by Ed Erdelac "Within the Image of the Divine" by Bear Weiter "Yellow Is the Color of the Future" by Jason Andrew "Fears Realized" by Tom Lynch "Professor Patriot and the Doom That Came to Niceville" by Christine Morgan "Rose-Colored Glasses" by Michael Szymanski "The Preserved Ones" by Christopher M. Geeson "Putnam's Monster" by Scott T. Goudsward "Operation Switch" by Pete Rawlik "Names on the Black List" by Robert M. Price "The End of the Golden Age" by Glynn Owen Barrass and Brian M. Sammons</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>285</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu Fiction</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>March 2015</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Skinless_One">
    <rdf:type rdf:resource="http://example.org/lovecraft#Avatars"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Skinless One</rdfs:label>
    <ex:hasAffiliationC>Brothers of the Skin</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Fleshless Abomination</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The is an avatar of nyarlathotep created by chaosium for their call of cthulhu horror roleplaying game . It was designed by geoff gillan for the expansion horror on the orient express . Behind the mythos the was inspired by a passage from h.p. Lovecraft's short story .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Horror_on_the_Orient_Express"/>
    <ex:wasCreatedByC>Geoff Gillan</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Zkauba">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExtraterrestrialCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Zkauba</rdfs:label>
    <ex:hasAnnotation>Yaddith Wizard Yaddithian First appearance HPL : " Through the Gates of the Silver Key " Created by H. P. Lovecraft and E. Hoffmann Price is an alien mystic native to the planet Yaddith and a facet of Randolph Carter .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Through_the_Gates_of_the_Silver_Key"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#E._Hoffmann_Price"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Julie_Sands">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Humans"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Julie Sands</rdfs:label>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#Queen_of_Hearts"/>
    <ex:hasAnnotation>Also known as queen of hearts powers and abilities intellect power of words college student hero ruler was created by dan wickline in 2012 . First appeared in issue #1 of the 1st volume of grimm fairy tales: call of wonderland by zenescope entertainment .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC>Grimm Fairy Tales Presents Call of Wonderland Vol 1 1</ex:madeFirstAppearanceOnC>
    <ex:wasCreatedByC>Dan Wickline</ex:wasCreatedByC>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Mine_on_Yuggoth">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RamseyCampbellWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Mine on Yuggoth</rdfs:label>
    <ex:hasAnnotation>Ramsey Campbell English Genre(s) Weird fiction Arkham House The Inhabitant of the Lake and Less Welcome Tenants date 1964 "" is a short Cthulhu Mythos story by Ramsey Campbell , originally published in The Inhabitant of the Lake and Less Welcome Tenants ( Arkham House , 1964). Synopsis Expanding on elements from H. P. Lovecraft 's The Whisperer in Darkness , the story concerns the efforts of Edward Taylor (b. 1899), a former Brichester University student obsessed with the occult, to travel to Yuggoth to obtain the unique metal tok'l. History The story was later reprinted in The Spawn of Cthulhu , edited by Lin Carter , the 1985 edition of Cold Print , and Chaosium 's The Hastur Cycle .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ramsey_Campbell"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Inhabitant_of_the_Lake"/>
    <ex:isPublishedAsW>Less Welcome Tenants</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1964</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Helen_Allgood">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSRelatives"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Helen Allgood</rdfs:label>
    <ex:diedOnR>1881</ex:diedOnR>
    <ex:hasAnnotation>Lovecraft’s paternal grandmother. Wife of George Lovecraft, whom she married in 1839. She gave birth to five children: a stillborn, Cordelia Amanda, Emily Jane, Winfield Scott, and Mary Louisa. Her sister, Augusta Charlotte Allgood, who was 22 years her junior, was adopted when she was 10 by George Lovecraft upon the death of her father, making Helen her own sister’s mother.</ex:hasAnnotation>
    <ex:isRelativeToR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1820</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Eternal_Lovecraft:_The_Persistence_of_H._P._Lovecraft_in_Popular_Culture">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Eternal Lovecraft: The Persistence of H. P. Lovecraft in Popular Culture</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Nicholas Jainschigg English Golden Gryphon Press Release Date October 1998 411  is an anthology of Lovecraftian fiction published by Golden Gryphon Press in October 1998. It was edited by Golden Gryphon's founder Jim Turner , and featured cover art by Nicholas Jainschigg. Contents "The "Shadow" over Lovecraft" introduction by Jim Turner "Her Misbegotten Son" by Alan Rodgers "Daoine Domhain" by Peter Tremayne " To Mars and Providence " by Don Webb "Weird Tales" by Fred Chappell "The Land of the Reflected Ones" by Nancy A. Collins "The Shadow at the Bottom of the World" by Thomas Ligotti "Sensible City" by Harlan Ellison "The Golden Keeper" by Ian R. MacLeod "Ralph Wollstonecraft Hedge: A Memoir" by Ron Goulart " Crouch End " by Stephen King " The Turret " by Richard A. Lupoff "The Giant Rat of Sumatra" by Paula Volsky "Black as the Pit, from Pole to Pole" by Steven Utley and Howard Waldrop "The Other Dead Man" by Gene Wolfe " The Events at Poroth Farm " by T. E. D. Klein "The Ocean and All Its Devices" by William Browning Spencer "A Bit of the Dark World" by Fritz Leiber "The Perseids" by Robert Charles Wilson</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasPageCountW>411</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>October 1998</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Messenger">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Messenger</rdfs:label>
    <ex:hasAnnotation>The two verses describe the unnamed narrator's wait for an unknown "thing" to come upon him at 3 o'clock in the morning . The poem was written in 1929 and was dedicated to providence journal columnist bernard k. hart . It has since seen inclusion in a number of works, both anthologies and periodicals .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>July 1938</ex:wasPublishedOnW>
    <ex:wasWrittenOnW>1929</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Black_Book_%28fanzine%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Black Book (fanzine)</rdfs:label>
    <ex:hasAnnotation>The black book was a short-lived fanzine devoted to cthulhu mythos and lovecraftian fiction . Edited by peter a. worthy and was available in a digital format only . Featured stories from both established mythos authors and</ex:hasAnnotation>
    <ex:isInLanguageW>English</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Out_of_the_Ages">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Out of the Ages</rdfs:label>
    <ex:hasAnnotation>In 1928, dr. henry stephenson blaine has been tasked with cataloguing the objects and documents of the copeland collection . He finds evidence of a prehistoric civilization in ancient mu which worshipped the xothic gods, sons of cthulhu . He also learns from his housekeeper that he has been sleepwalking . One night, two police officers find blaine in his pijamas, standing knee-deep in sea water by the</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Nameless Places</ex:isPublishedAsW>
    <ex:wasPublishedOnW>1975</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Gazira">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Gazira</rdfs:label>
    <ex:hasAlternativeNamesC>Gadzella</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>Smasher of Cities</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Background is a colossal monster whose existence and activities the japanese government has kept a secret . Nuclear radiation wakes it from hibernation, as does strong seismic activity . It considers japan to be its turf and will battle creatures which are of similar size, including various great old ones .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Secrets_of_Japan"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Michael_Dziesinski"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Botsu">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#CharactersIncorporatedFromFolkloreMythAndReligion"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OuterGods"/>
    <rdfs:label>Botsu</rdfs:label>
    <ex:hasAffiliationC rdf:resource="http://example.org/lovecraft#Outer_God"/>
    <ex:hasAlternativeNamesC>Buddha</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Enlightened One</ex:hasAlternativeNamesC>
    <ex:hasAlternativeNamesC>The Seeker</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The cosmic buddha is a timeless entity who exists beyond time and space, where it appears as a statue . A mortal on a path to enlightenment awakened to the cosmos true nature and became the cosmic buddha's physical incarnation on earth . Upon his death, he ascended to the outer realm of nirvana, where he merged with the cosmic buddha's absolute body .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Secrets_of_Japan"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Amoeboid">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Amoeboid</rdfs:label>
    <ex:hasAnnotation>Is a short story by british-born william meikle . Contains no direct references to either the works of h.p. Lovecraft or the greater cthulhu mythos .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#William_Meikle"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isPublishedAsW>B. E. M.</ex:isPublishedAsW>
    <ex:wasPublishedOnW>April 2016</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Ephraim_Waite">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedInMythos"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MagicUsers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdfs:label>Ephraim Waite</rdfs:label>
    <ex:hasAnnotation>Waite is a wizard who has the power to transfer his consciousness into another's body . In the course of the story, his spirit inhabits the body of his daughter asenath waite . In life, waite is described as having a "wolfish, saturnine" appearance .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Thing_on_the_Doorstep"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Out_of_Her_Gourd">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Out of Her Gourd</rdfs:label>
    <ex:hasAnnotation>Historywas published in the mythos-dedicated anthology they thrive in darkness: mythos and madness by american ron shiflet in 2018 . It is a short story about a young girl who is gang raped by three brothers . She uses the power given to her by a dying witch to summon shub</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Ron_Shiflet"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Madness</ex:isPublishedAsW>
    <ex:isPublishedAsW>They Thrive in Darkness: Mythos</ex:isPublishedAsW>
    <ex:wasPublishedOnW>2018</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Tales_of_the_Marvellous_and_Ridiculous">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Tales of the Marvellous and Ridiculous</rdfs:label>
    <ex:hasAnnotation>Edmund Wilson United States English (original) German (translation) Genre(s) Non-fiction Ohio University Press H. P. Lovecraft: Four Decades of Criticism date 1980 " " is a short non-fiction piece written on the works of the late Howard Phillips Lovecraft . Overview Running to only a handful of pages, "" was penned by American Edmund Wilson. History H. P. Lovecraft: Four Decades of Criticism (1980) Über H. P. Lovecraft (1984)</ex:hasAnnotation>
    <ex:hasAuthorW>Edmund Wilson</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Non-fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft:_Four_Decades_of_Criticism"/>
    <ex:wasPublishedOnW>1980</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Terror_Australis">
    <rdf:type rdf:resource="http://example.org/lovecraft#Chaosium"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamesAndAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GamingSupplements"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Terror Australis</rdfs:label>
    <ex:hasAnnotation>First published in 1987 and revised in 2018 to bring it in line with the contemporary version of the game . A full-colour revised edition was released, which replaced the three scenarios included in the original book with two new scenarios . The new edition also includes expanded sections on australian history, the lgbt+ community of the period, law and order, and more .</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Roleplaying game</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>1987</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Kappa">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SpeciesIncorporatedFromFolkloreMythAndReligion"/>
    <rdfs:label>Kappa</rdfs:label>
    <ex:hasAlternativeNamesC>Water-Tigers</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The are a vampiric amphibious species who are up to 3ft tall with sharp bird-like beak, a thick tortoise-like shell on their back, and lion-like facial features . Most of them live off japan's coast in underwater kingdoms .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#Secrets_of_Japan"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Laniqua_Luahuan">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#EarthNativeSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#SapientSpecies"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Species"/>
    <rdfs:label>Laniqua Lua'huan</rdfs:label>
    <ex:hasAffiliationC>The Sand Castle</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC>Deep One sub-species</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>Sociocultural Characteristics Also known as Deep One sub-species " The Sand Castle " Real World Information Created by Edward P. Berglund are a dolphin-like sub-species of Deep One . It is not known if they have a complex physiological development as other Deep Ones do. See also Raandeese</ex:hasAnnotation>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Edward_P._Berglund"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Finding_God%28s%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Finding God(s)</rdfs:label>
    <ex:hasAnnotation>"finding god(s) " is a short humour story by american james ambuehl . It is written as a series of postcards from three sisters to each other . Each describes how they have found a new god, and how that god has blessed them with an unusual child .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#James_Ambuehl"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Humour</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasPublishedOnW>March 1998</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#E_Hoffmann_Price">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftSFriendsAndAcquaintances"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>E Hoffmann Price</rdfs:label>
    <ex:diedOnR>1988</ex:diedOnR>
    <ex:hasAnnotation>Prolific pulp writer of weird and adventure tales. Lovecraft met him in New Orleans in 1932 and corresponded extensively with him thereafter.</ex:hasAnnotation>
    <ex:hasRealPersonMateR rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:wasBornOnR>1898</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Jest_of_Droom-Avista">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Jest of Droom-Avista</rdfs:label>
    <ex:hasAnnotation>Story first appeared in pulp fiction magazine weird tales in august 1937 . Set in the city of bel yarnak where a would-be powerful wizard summons and binds droom-avista to exact from this god the alchemical ability to transmute gold into iron .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Henry_Kuttner"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Fantasy</ex:hasGenreW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>August 1937</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Whisperer_in_Darkness:_Collected_Stories_Volume_One">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Whisperer in Darkness: Collected Stories Volume One</rdfs:label>
    <ex:hasAnnotation>H. P. Lovecraft Cover Artist Nichola Trayler-Barbrook United Kingdom English Genre(s) Fantasy, Horror, Science fiction short stories Wordsworth Editions Limited Release Date 2007 Media Type Print (paperback) xiii, 370 pp Followed by The Horror in the Museum: Collected Short Stories Volume Two The Whisperer in Darkness: Collected Short Stories Volume One is a collection of fantasy, horror and science fiction short stories by the American H. P. Lovecraft edited by M. J. Elliott. Contents The Whisperer in Darkness: Collected Short Stories Volume One contains the following works: " Dagon " " The Nameless City " " The Hound " " The Festival " " The Call of Cthulhu " " The Case of Charles Dexter Ward " " The Dunwich Horror " " The Whisperer in Darkness " " At the Mountains of Madness " External links Preview on Book2Look.</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Fantasy</ex:hasGenreW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:hasGenreW>Science fiction short stories</ex:hasGenreW>
    <ex:hasPageCountW>xiii 370 pp</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>2007</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Steven_J._Mariconda">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Critics"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Scholars"/>
    <rdfs:label>Steven J. Mariconda</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Scholar Critic United States Non-fiction Years Active 1983-present is an American editor, scholar, critic and one-time artist who has written numerous pieces on the works of H. P. Lovecraft and the Cthulhu Mythos . His works have seen print in publications such as Crypt of Cthulhu and Lovecraft Studies , and he has collaborated with other leaders in the field such as S. T. Joshi , Donald R. Burleson and Marc A. Michaud . Mariconda was also a member of the Providence Pals , an informal group of H. P. Lovecraft enthusiasts and scholars active from the late 1970s through to the 1990s. Selected Works Non-Fiction On the Emergence of 'Cthulhu' and Other Observations (1995) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasYearsActiveR>1983-present</ex:hasYearsActiveR>
    <ex:isConnectedToMythosR>Critic</ex:isConnectedToMythosR>
    <ex:isConnectedToMythosR>Scholar</ex:isConnectedToMythosR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Das_schleichende_Chaos">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Das schleichende Chaos</rdfs:label>
    <ex:hasAnnotation>Germany German H. P. Lovecraft's Bibliothek des Schreckens Festa Release Date September 2006 285 is a German- collection of Howard Phillips Lovecraft works, and includes a pair of non-fiction essays from other authors. Edited by Frank Festa , it was published by Festa as part of their H. P. Lovecraft's Bibliothek des Schreckens in September 2006. Contents "Der Baum" by Howard Phillips Lovecraft (" The Tree ") "Hypnos" by Howard Phillips Lovecraft (" Hypnos ") "Iranons Suche" by Howard Phillips Lovecraft (" The Quest of Iranon ") "Polaris" by Howard Phillips Lovecraft (" Polaris ") "In der Gruft" by Howard Phillips Lovecraft (" In the Vault ") "Das Bild im Haus" by Howard Phillips Lovecraft (" The Picture in the House ") "Jäger der Finsternis" by Howard Phillips Lovecraft (" The Haunter of the Dark ") "Das Verderben, das über Sarnath kam" by Howard Phillips Lovecraft (" The Doom That Came to Sarnath ") "Die Anderen Götter" by Howard Phillips Lovecraft (" The Other Gods ") "Die Musik des Erich Zann" by Howard Phillips Lovecraft (" The Music of Erich Zann ") "Träume im Hexenhaus" by Howard Phillips Lovecraft (" The Dreams in the Witch-House ") "Der Schatten aus der Zeit" Howard Phillips Lovecraft (" The Shadow Out of Time ") "Drei Stunden mit H. P. Lovecraft" by Dorothy C. Walter (" Three Hours with H. P. Lovecraft ") "Notizen zu Lovecraft" by Robert H. Barlow ("The Barlow Journal")</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>Germany</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>285</ex:hasPageCountW>
    <ex:isInLanguageW>German</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#H._P._Lovecrafts_Bibliothek_des_Schreckens"/>
    <ex:wasReleasedOnW>September 2006</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Toad_God">
    <rdf:type rdf:resource="http://example.org/lovecraft#Character"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#GreatOldOnes"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosCharacters"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherSupernaturalBeings"/>
    <rdfs:label>Toad God</rdfs:label>
    <ex:hasAffiliationC>Great Old Ones or Lesser Old Ones</ex:hasAffiliationC>
    <ex:hasAlternativeNamesC rdf:resource="http://example.org/lovecraft#The_Thing_on_the_Roof"/>
    <ex:hasAlternativeNamesC>The Toad</ex:hasAlternativeNamesC>
    <ex:hasAnnotation>The is a fictional entity, created by robert e. howard for his short story " the thing on the roof " the used to be worshipped by an ancient tribe in central america, during the pre-columbian era .</ex:hasAnnotation>
    <ex:madeFirstAppearanceOnC rdf:resource="http://example.org/lovecraft#The_Thing_on_the_Roof"/>
    <ex:wasCreatedByC rdf:resource="http://example.org/lovecraft#Robert_E._Howard"/>
