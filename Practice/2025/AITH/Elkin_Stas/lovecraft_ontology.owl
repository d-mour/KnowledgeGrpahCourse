    <ex:wasReleasedOnW>1990</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Inscrutable_Alien">
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Inscrutable Alien</rdfs:label>
    <ex:hasAnnotation>Richard King Perkins, II English James Ward Kirk Publishing Lovecraft after Dark date November 2015  " " is a Lovecraftian poem by Richard King Perkins, II , first published in the James Ward Kirk Publishing anthology Lovecraft after Dark in November 2015. Synopsis The poem tells of a compassionate gardener who is attacked by one of the insects she has so carefully relocated in the past. Easily scooping the creature up, she weeps as she is forced to kill it.</ex:hasAnnotation>
    <ex:hasAuthorW>II</ex:hasAuthorW>
    <ex:hasAuthorW>Richard King Perkins</ex:hasAuthorW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Lovecraft_after_Dark"/>
    <ex:wasPublishedOnW>November 2015</ex:wasPublishedOnW>
  </rdf:Description>
