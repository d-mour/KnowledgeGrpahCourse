    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Those Who Seek</rdfs:label>
    <ex:hasAnnotation>Historywas first published in pulp magazine weird tales in january 1932 . Widely considered to be a part of the cthulhu mythos .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#August_Derleth"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Weird_Tales"/>
    <ex:wasPublishedOnW>January 1932</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Innsmouth_Cycle">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Innsmouth Cycle</rdfs:label>
    <ex:hasAnnotation>Robert M. Price , editor Cover Artist H. E. Fassl English Call of Cthulhu Fiction Genre(s) Cthulhu Mythos Chaosium Release Date February 1998 233 : The Taint of the Deep Ones in Thirteen Tales and Three Poems is an anthology of writings related to H. P. Lovecraft 's The Shadow over Innsmouth , including stories that inspired and were in turn inspired by it. Edited by Robert M. Price , it was published by Chaosium in 1998, part of the Call of Cthulhu Fiction . Contents "Introduction: Ontogeny Recapitulates Phylogeny" (essay) by Robert M. Price (1998) "Of Yoharneth-Lahai" by Lord Dunsany (1916) "The Harbor-Master" by Robert W. Chambers (1906) "Fishhead" by Irvin S. Cobb (1913) " The Shadow over Innsmouth " by H. P. Lovecraft (1936) " The Deep Ones " by James Wade (1969) "A Darker Shadow Over Innsmouth" by James Wade (1969) "The Innsmouth Head" by Franklyn Searight (1975) "Innsmouth Gold" by Henry J. Vester III (1986) "Custos Sanctorum" by Roger Johnson (1987) "Rapture in Black" by Stephen Mark Rainey (1988) "Live Bait" by Stanley C. Sargent (1996) "Devil Reef" by John Glasby (1998) "The Transition of Zadok Allen" by Robert M. Price (as Lewis Theobald, III) (1995) "Shadow Over Innsmouth" (poem) by Virginia Anderson (1942) "Innsmouth—Dread City by the Sea" (poem) by R. Flavie Carson (1950) "After Innsmouth" (poem) by Ann K. Schwader (1990)</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Robert_M._Price"/>
    <ex:hasAuthorW>editor</ex:hasAuthorW>
    <ex:hasGenreW>Cthulhu Mythos</ex:hasGenreW>
    <ex:hasPageCountW>233</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW>Call of Cthulhu Fiction</ex:isPartOfSeriesW>
    <ex:wasReleasedOnW>February 1998</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Arkham_Detective_Agency">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Arkham Detective Agency</rdfs:label>
    <ex:hasAnnotation>A lovecraftian-noir tribute to c. j. henderson is a collection of short pulp horror stories set in the expanded cthulhu mythos . The idea for was originally pitched to editor brian m. sammons by henderson shortly before his death in 2014 . The finished work was not published until after henderson's passing, with sammons lamenting "that the publishing world didn't move so slowly"</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Pulp Detective Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>November 2017</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Adrian_Kleinbergen">
    <rdf:type rdf:resource="http://example.org/lovecraft#Artists"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#ExpandedMythosAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Adrian Kleinbergen</rdfs:label>
    <ex:hasAnnotation>Connection to the Mythos Poet Birth Date 1961 Edmonton, Alberta, Canada Canada Horror Science Fiction Fantasy Adrian M. Kleinbergen is a Canadian artist, author and poet who has contributed a number of works to H. P. Lovecraft 's Cthulhu Mythos . His written works have been published in fanzines such as Nightscapes and Dark Legacy , while his Mythos-related art includes images for Red Sonja . Selected Bibliography Poetry " Algol " (1998) " From Beyond " (1998) " The Colour Out of Space " (1998) External Links at the Internet Speculative Fiction Database at Goodreads</ex:hasAnnotation>
    <ex:hasBirthplaceR>Alberta Canada Edmonton</ex:hasBirthplaceR>
    <ex:hasNationalityR>Canada</ex:hasNationalityR>
    <ex:isConnectedToMythosR>Poet</ex:isConnectedToMythosR>
    <ex:wasBornOnR>1961</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Marvin_Kaye">
    <rdf:type rdf:resource="http://example.org/lovecraft#DeceasedRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Editors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Marvin Kaye</rdfs:label>
    <ex:diedOnR>13 May 2021</ex:diedOnR>
    <ex:hasAnnotation>Full Name Marvin Nathan Kaye Pseudonym(s) Eugene D. Goodman Joseph Lavinson Connection to the Mythos Editor Birth Date 10 March 1938 Philadelphia, Pennsylvania, USA Death Date 13 May 2021 New York City, New York, USA United States Mystery Fantasy Science Fiction Horror Saralee Kaye 𝐓 (10 March 1938-13 May 2021) was a prolific author and editor as well as an actor and stand-up comedian. Amongst his editorial credits was the long-running pulp fiction magazine Weird Tales , which he edited from 2012 until 2019. He also edited at least one Weird Tales anthology with his wife Saralee Kaye. Although Kaye edited many Lovecraftian tales, and even wrote non-fiction works on H. P. Lovecraft , he does not appear to have written any Mythos -related works himself. Selected Bibliography Editor H. P. Lovecraft's Magazine of Horror (2004-2009) Weird Tales (2012-2019) Weird Tales: The Magazine that Never Dies (1988)</ex:hasAnnotation>
    <ex:hasBirthplaceR>USA Pennsylvania Philadelphia</ex:hasBirthplaceR>
    <ex:hasFullNameR>Marvin Nathan Kaye</ex:hasFullNameR>
    <ex:hasNationalityR>United States</ex:hasNationalityR>
    <ex:hasPseudonymR>Eugene D. Goodman</ex:hasPseudonymR>
    <ex:hasPseudonymR>Joseph Lavinson</ex:hasPseudonymR>
    <ex:isConnectedToMythosR>Editor</ex:isConnectedToMythosR>
    <ex:wasBornOnR>10 March 1938</ex:wasBornOnR>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Alien_Gardener">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Alien Gardener</rdfs:label>
    <ex:hasAnnotation>"the other: encounters with the cthulhu mythos" is a short story by canadian troy young . It is the second story in book 2 of his nyarlathotep cycle . The story is framed as field agent mindy nguyen relating the story of her most impactful encounter with "the other"</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Troy_Young"/>
    <ex:hasGenreW>Weird fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPartOfSeriesW rdf:resource="http://example.org/lovecraft#The_Nyarlathotep_Cycle"/>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#The_Other:_Encounters_with_the_Cthulhu_Mythos_Book_2"/>
    <ex:wasPublishedOnW>2020</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Earth">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Planets"/>
    <rdfs:label>Earth</rdfs:label>
    <ex:hasAnnotation>The planet is the homeworld of humanity . It has been colonized by several extraterrestrial races that struggled with each other for dominance, including the elder things , the cthulhi , the great race of yith , the flying polyps , and the mi-go .</ex:hasAnnotation>
    <ex:hasNotableFeatureL>Oceans</ex:hasNotableFeatureL>
    <ex:hasNotableFeatureL>continents</ex:hasNotableFeatureL>
    <ex:hasNotableFeatureL>seas</ex:hasNotableFeatureL>
    <ex:isInhabitedByL>Deep Ones Formless Spawn Ghouls Humans Sea-dwellers Serpent People Shoggoths Voormis Winged Ones Etc.</ex:isInhabitedByL>
    <ex:isLocatedAtL>Planet</ex:isLocatedAtL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#British_Museum">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Structures"/>
    <rdfs:label>British Museum</rdfs:label>
    <ex:hasAnnotation>The museum was established by an act of parliament in 1753, establishing a museum based on the collection of curiosities bequeathed by sir hans sloane . The museum houses cultural artefacts from around the world, brought back by british archaeologists and adventurers from capt. James cook to t. e. lawrence . The museum's natural history collections were spun off into a new of natural history in 1887, which was not legally separated from the museum until 1963 .</ex:hasAnnotation>
    <ex:hasTypeL>Museum</ex:hasTypeL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#England"/>
    <ex:isLocatedAtL>London</ex:isLocatedAtL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Mound">
    <rdf:type rdf:resource="http://example.org/lovecraft#HPLovecraftWorks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Mound</rdfs:label>
    <ex:hasAnnotation>H. p. lovecraft ghostwrote this horror and sci-fi novella from 1929 to 1930 . It is one of only three by lovecraft where a non-human culture is described in rich details . The story is located in binger in caddo county, which unlike the fictional towns and locations in the majority of his works is a real town .</ex:hasAnnotation>
    <ex:hasAuthorW>H. P. Lovecraft (ghostwriter)</ex:hasAuthorW>
    <ex:hasAuthorW>Zealia Bishop (original idea)</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror short story</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasWrittenOnW>December 1929-January 1930</ex:wasWrittenOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Strange_Manuscript_Found_in_the_Vermont_Woods">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Strange Manuscript Found in the Vermont Woods</rdfs:label>
    <ex:hasAnnotation>The journal of winthrop hoag has been found inside a briefcase in vermont in 1936 . It reveals how he inherited a cabin in the woods in the vicinity of arkham . From it, he learns that his cousin, jared fuller, had found a dead man . The body was broken as if he had fallen from a great height and covered in slime .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Lin_Carter"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW>Crypt of Cthulhu Eastertide 1988</ex:isPublishedAsW>
    <ex:wasPublishedOnW>December 1988</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#The_Dunwich_Horror_%281979_comic%29">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleComicBookAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>The Dunwich Horror (1979 comic)</rdfs:label>
    <ex:hasAnnotation>The Dunwich Horror H. P. Lovecraft Alberto Breccia Spanish (original) English Genre(s) Horror English Release date October 1979 The Dunwich Horror is a comic book-format adaptation of the H. P. Lovecraft short story of the same name Overview Adapted by Argentinian comic book artist Alberto Breccia , and originally written in Spanish, it was published in an English- version in a special Lovecraft edition of Heavy Metal magazine in October 1979. Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#H._P._Lovecraft"/>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isInLanguageW>Spanish</ex:isInLanguageW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Marvel_Comics">
    <rdf:type rdf:resource="http://example.org/lovecraft#ComicBooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Publishers"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RealWorldPerson"/>
    <rdfs:label>Marvel Comics</rdfs:label>
    <ex:hasAnnotation>Marvel is one of the two largest comic book publishers in the world and has been around since 1939 . Since it was purchased by disney in 2009, its property has become the most valuable in the movie business with numerous blockbusters . Recently marvel published a 3-part mini-series called the " haunt of horror: h.p. Lovecraft " under the max line of comics .</ex:hasAnnotation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Curse_of_the_Crimson_Altar">
    <rdf:type rdf:resource="http://example.org/lovecraft#LovecraftCircleFilmAndTelevisionAdaptations"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Curse of the Crimson Altar</rdfs:label>
    <ex:hasAnnotation>Based on HPL : " The Dreams in the Witch-House " Vernon Sewell Christopher Lee Boris Karloff Production Company Tigon British Film Productions Release date December 1968 (United Kingdom) April 1970 (United States) Running time 89 minutes United Kingdom English is a 1968 British horror film from Vernon Sewell and legendary horror actors Christopher Lee and Boris Karloff. It was loosely based on H. P. Lovecraft 's " The Dreams in the Witch-House ", although the studio did not acknowledge this fact. Released in the United Kingdom in December 1968, it made its debut in the United States in April 1970 under the title The Crimson Cult . External Links at Wikipedia The Crimson Cult at IMDb Gallery</ex:hasAnnotation>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:isBasedOnW rdf:resource="http://example.org/lovecraft#The_Dreams_in_the_Witch-House"/>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>April 1970 December 1968</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#When_the_Stars_Are_Ripe">
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Pastiches"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>When the Stars Are Ripe</rdfs:label>
    <ex:hasAnnotation>Nightscapes is a short story by american stanley c. sargent . It is set after the discovery of ancient tunnels predating complex life on earth . Only one of the two scientists makes it out of the tunnels alive .</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Stanley_C._Sargent"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Horror</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:isPublishedAsW rdf:resource="http://example.org/lovecraft#Nightscapes"/>
    <ex:wasPublishedOnW>December 1997</ex:wasPublishedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Lovecrafts_Book">
    <rdf:type rdf:resource="http://example.org/lovecraft#Ebooks"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#MythosLiterature"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Lovecraft's Book</rdfs:label>
    <ex:hasAnnotation>Richard A. Lupoff Cover Artist Jeffrey K. Potter United States English Genre(s) Historical fiction Arkham House Release Date June 1985 , by Richard A. Lupoff , is a historical novel originally published by Arkham House in 1985. The plot, set in 1927, involves H. P. Lovecraft being hired by a far-right politician to write an American Mein Kampf , in exchange for the publication of a collection of Lovecraft's horror fiction. An expanded version of the novel was published as Marblehead: A Novel of H. P. Lovecraft by Ramble House in 2006. Gallery</ex:hasAnnotation>
    <ex:hasAuthorW rdf:resource="http://example.org/lovecraft#Richard_A._Lupoff"/>
    <ex:hasCountryOfOriginW>United States</ex:hasCountryOfOriginW>
    <ex:hasGenreW>Historical fiction</ex:hasGenreW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>June 1985</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Dagon_January-February_1987">
    <rdf:type rdf:resource="http://example.org/lovecraft#Fanzines"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#OtherAuthors"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#Work"/>
    <rdfs:label>Dagon January-February 1987</rdfs:label>
    <ex:hasAnnotation>Various Cover Artist Martin McKenna United Kingdom English Carl T. Ford Release Date January 1987 44 is the sixteenth issue of the now-defunct Lovecraftian fanzine Dagon . It was edited by the late British and occasional Carl T. Ford . Contents (incomplete) "The Sinister Secret of Shoggoth Street" by H. P. Luddite "Mildew from Shaggai" by Robert M. Price "Bloody Peculiar Aeons, or, What's a Tentacle-Faced Thing Like Me Doing in a Sunken City Like This (Latitude 47° 9' S, Longitude 126° 43' W)?" by Neil Gaiman</ex:hasAnnotation>
    <ex:hasAuthorW>Various</ex:hasAuthorW>
    <ex:hasCountryOfOriginW>United Kingdom</ex:hasCountryOfOriginW>
    <ex:hasPageCountW>44</ex:hasPageCountW>
    <ex:isInLanguageW>English</ex:isInLanguageW>
    <ex:wasReleasedOnW>January 1987</ex:wasReleasedOnW>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/lovecraft#Rhode_Island">
    <rdf:type rdf:resource="http://example.org/lovecraft#Location"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#LocationsIncorporatedFromTheRealWorld"/>
    <rdf:type rdf:resource="http://example.org/lovecraft#RegionsTerritories"/>
    <rdfs:label>Rhode Island</rdfs:label>
    <ex:hasAnnotation>New england state is the home state of h. p. lovecraft and the setting of several cthulhu mythos tales . Its capital and largest city is providence . It was founded by roger williams, who was expelled from the massachusetts bay colony over his advocacy of religious tolerance.</ex:hasAnnotation>
    <ex:hasTypeL>State</ex:hasTypeL>
    <ex:isLocatedAtL rdf:resource="http://example.org/lovecraft#New_England"/>
  </rdf:Description>
