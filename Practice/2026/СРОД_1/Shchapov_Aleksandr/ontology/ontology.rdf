<?xml version="1.0"?>
<rdf:RDF xmlns="https://example.org/guitar/ontology#"
     xml:base="https://example.org/guitar/ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="https://example.org/guitar/ontology">
        <rdfs:comment xml:lang="ru">Учебное пространство идентификаторов; модель/версия, не доказанный физический экземпляр. Свойства наблюдений сохраняются на аннотациях с происхождением.</rdfs:comment>
        <rdfs:label>Guitar multimodal annotations</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://example.org/guitar/candidateComponent -->

    <owl:ObjectProperty rdf:about="https://example.org/guitar/candidateComponent">
        <rdfs:domain rdf:resource="https://example.org/guitar/AudioInterval"/>
        <rdfs:range rdf:resource="https://example.org/guitar/Component"/>
        <rdfs:comment xml:lang="ru">Предварительное соответствие по позиции из подписи источника; не подтверждённое использование.</rdfs:comment>
        <rdfs:label>candidateComponent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/guitar/demonstrates -->

    <owl:ObjectProperty rdf:about="https://example.org/guitar/demonstrates">
        <rdfs:domain rdf:resource="https://example.org/guitar/AudioMaterial"/>
        <rdfs:range rdf:resource="https://example.org/guitar/Guitar"/>
        <rdfs:label>demonstrates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/guitar/depicts -->

    <owl:ObjectProperty rdf:about="https://example.org/guitar/depicts">
        <rdfs:comment xml:lang="ru">ImageMaterial или ImageRegion изображает Guitar или индивидуальную Component; узкий domain/range намеренно не задан.</rdfs:comment>
        <rdfs:label>depicts</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/guitar/describes -->

    <owl:ObjectProperty rdf:about="https://example.org/guitar/describes">
        <rdfs:domain rdf:resource="https://example.org/guitar/TextMaterial"/>
        <rdfs:range rdf:resource="https://example.org/guitar/Guitar"/>
        <rdfs:label>describes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/guitar/evidence -->

    <owl:ObjectProperty rdf:about="https://example.org/guitar/evidence">
        <rdfs:range rdf:resource="https://example.org/guitar/Annotation"/>
        <rdfs:comment xml:lang="ru">Аннотация, служащая источником сведений об объекте; признаки position и типы сохраняются на самой аннотации.</rdfs:comment>
        <rdfs:label>evidence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/guitar/hasComponentGroup -->

    <owl:ObjectProperty rdf:about="https://example.org/guitar/hasComponentGroup">
        <rdfs:domain rdf:resource="https://example.org/guitar/Guitar"/>
        <rdfs:range rdf:resource="https://example.org/guitar/ComponentGroup"/>
        <rdfs:label>hasComponentGroup</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/guitar/hasPart -->

    <owl:ObjectProperty rdf:about="https://example.org/guitar/hasPart">
        <rdfs:domain rdf:resource="https://example.org/guitar/Guitar"/>
        <rdfs:range rdf:resource="https://example.org/guitar/Component"/>
        <rdfs:label>hasPart</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/guitar/hasPartMention -->

    <owl:ObjectProperty rdf:about="https://example.org/guitar/hasPartMention">
        <rdfs:domain rdf:resource="https://example.org/guitar/TextMention"/>
        <rdfs:range rdf:resource="https://example.org/guitar/TextMention"/>
        <rdfs:comment xml:lang="ru">Исходный HAS_PART между текстовыми упоминаниями.</rdfs:comment>
        <rdfs:label>hasPartMention</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/guitar/inMaterial -->

    <owl:ObjectProperty rdf:about="https://example.org/guitar/inMaterial">
        <rdfs:domain rdf:resource="https://example.org/guitar/Annotation"/>
        <rdfs:range rdf:resource="https://example.org/guitar/Material"/>
        <rdfs:label>inMaterial</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/guitar/inParagraph -->

    <owl:ObjectProperty rdf:about="https://example.org/guitar/inParagraph">
        <rdfs:domain rdf:resource="https://example.org/guitar/Token"/>
        <rdfs:range rdf:resource="https://example.org/guitar/Paragraph"/>
        <rdfs:label>inParagraph</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/guitar/inSentence -->

    <owl:ObjectProperty rdf:about="https://example.org/guitar/inSentence">
        <rdfs:domain rdf:resource="https://example.org/guitar/Token"/>
        <rdfs:range rdf:resource="https://example.org/guitar/Sentence"/>
        <rdfs:label>inSentence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/guitar/refersTo -->

    <owl:ObjectProperty rdf:about="https://example.org/guitar/refersTo">
        <rdfs:domain rdf:resource="https://example.org/guitar/TextMention"/>
        <rdfs:label>refersTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/guitar/usesComponent -->

    <owl:ObjectProperty rdf:about="https://example.org/guitar/usesComponent">
        <rdfs:domain rdf:resource="https://example.org/guitar/AudioInterval"/>
        <rdfs:range rdf:resource="https://example.org/guitar/Component"/>
        <rdfs:comment xml:lang="ru">Только подтверждённая по записи настройка, сопоставленная индивидуальной детали.</rdfs:comment>
        <rdfs:label>usesComponent</rdfs:label>
    </owl:ObjectProperty>
    


