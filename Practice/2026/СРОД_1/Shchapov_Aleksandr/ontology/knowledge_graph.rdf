    <g:recording_chain rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clip 2: mic centered, 1 inch away. Amp, mic model and interface not identified in clip notes</g:recording_chain>
    <g:limitations rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clip 5 says Dirty Bridge to Dirty, likely an error; do not use it. Do not infer a complete five-position sequence from bridge-to-neck shorthand.</g:limitations>
