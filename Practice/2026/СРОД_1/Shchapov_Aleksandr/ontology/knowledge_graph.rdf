  <rdf:Description rdf:about="https://example.org/guitar/GTR009">
    <rdf:type rdf:resource="https://example.org/guitar/Guitar"/>
    <g:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GTR009</g:identifier>
    <g:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Squier Paranormal Super-Sonic</g:name>
    <g:version rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sparkle blue; two zebra humbuckers; two volume controls, no tone control</g:version>
    <g:review_author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Charles Saufley</g:review_author>
    <g:review_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-11-08</g:review_date>
    <g:checked_on rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-09-20</g:checked_on>
    <g:audio_mapping rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rhythm uses bridge; lead starts with bridge then unspecified combinations</g:audio_mapping>
    <g:recording_chain rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TC Hall Of Fame reverb -&gt; black-panel Fender Tremolux -&gt; UA OX tweed Deluxe cabinet</g:recording_chain>
    <g:limitations rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rhythm/lead layers overlap. Clip note says tone settings despite article saying no tone control; flag contradiction.</g:limitations>
    <g:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.premierguitar.com/gear/reviews/squier-paranormal-super-sonic</g:sourceUrl>
