    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book123656"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-10-24T10:40:31</ns1:firstPublicationDate>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пар, эфир, индустриализация. Монархия и аристократы. Цивилизация под контролем кланов и родов, помнящих прошлые ошибки, стиравшие мир с лица земли раз за разом. Прочное равновесие, постоянное пробуемое на зуб. Мир, где магия - проклятый и преследуемый соблазн амбициозных и безответственных.</ns1:cycleDescription>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
