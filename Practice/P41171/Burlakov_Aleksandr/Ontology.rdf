    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-12-18T07:20:24</ns1:publicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book022161"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book022170"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#bap63"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book036766"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Оружейники»</ns1:hasName>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book022159"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-10-29T15:47:23</ns1:firstPublicationDate>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Действие происходит в 22 веке на территории Колониального союза. Содержит два подцикла: квадрологию "Оружейники" (полностью завершена) - главный герой Денис Смальков, Оружейник, занятый поиском и освоением инопланетных технологий; подцикл "Оружейники: Aftermath", состоящий из самостоятельных сюжетно законченных романов, объединенных местом действия - бывшим Колониальным союзом, и сквозным второстепенным персонажем - тем же Денисом Смальковым, только повзрослевшим и заматеревшим. Тайны сгинувших цивилизаций, загадки, космическая археология, драки, перестрелки, постоянная опасность - полный набор. Ну и любовь, как же без нее.Состав основного цикла: 1) Оружейники. Книга 1; 2) Оружейники. Книга 2. Неестественный отбор; 3) Оружейники. Книга 3. След Химеры; 4) Оружейники. Книга 4. Зверь из Бездны.Состав подцикла "Оружейники: Aftermath" (в порядке написания): 1) Книга 1. Беглец/Бродяга; 2) Книга 2. Из глубин.</ns1:cycleDescription>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book022167"/>
  </rdf:Description>
