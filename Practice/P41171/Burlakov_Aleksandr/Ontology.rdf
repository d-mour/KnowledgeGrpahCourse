    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Попаданец из наших дней в двадцатые года прошлого века (НЭП). Помогаем советской власти бороться со всякой сволочью. СССР спасать не надо - сами хорошо справляются.</ns1:cycleDescription>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle04384">
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#aristorg1233"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book049928"/>
