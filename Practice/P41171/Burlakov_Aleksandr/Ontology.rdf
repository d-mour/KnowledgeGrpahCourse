  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle03325">
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book015577"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">"Мир, в котором технологии сделали рывок вперед, люди владеют боевыми искусствами и манипулированием энергией, раскрывающей потенциал человеческого тела, а в обществе царит мир и порядок". Вранье! Фальшивая надуманная идиллия.Всему виной пришедшие в этот мир Фантомы, незримые сверхъестественные существа, способные захватывать любое оружие и уничтожающие любую угрозу на корню. Пытаясь обмануть новый порядок вещей, люди организовались в Новые Семьи, где готовят бойцов Рэйки для противостояния друг другу и незримой угрозе, засевшей в таинственных Разломах, а в этом деле им помогают технодевы – девушки, олицетворяющие собой разные виды боевой техники.</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book033955"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#nonsemper"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-04-19T17:36:24</ns1:firstPublicationDate>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Фантомный мир»</ns1:hasName>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book033953"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-23T16:00:06</ns1:publicationDate>
