  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle04436">
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book022396"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-11-02T12:43:49</ns1:firstPublicationDate>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Марья Бессмертная»</ns1:hasName>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-25T19:01:31</ns1:publicationDate>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#zhiltsova"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book039834"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Не думала, не гадала, а в сказку попала. Да как попала! Титул получила и царство в придачу с огро-омной сокровищницей. Повезло, скажете?       Ага, как же! Царство-то нечистое, Кощеево, с мертвяками и прочей пакостью. Причем пакость эта бунтует, а к границам враги-покусители на сокровищницу и магический источник подбираются. Так что, чтобы прожить здесь долго и, желательно, счастливо, папочку моего срочно спасать из плена надо.       И спасать, имея в союзниках лишь коня Вещего, посох магический, да странного колдуна, который при первой встрече натуральным образом сжег меня заживо.</ns1:cycleDescription>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle06781">
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#farg"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Клан Ито»</ns1:hasName>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book069569"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book086241"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book104620"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-03T10:58:36</ns1:firstPublicationDate>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book060436"/>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-13T14:00:01</ns1:publicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book058345"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мир феодальной Японии. Прекрасный и ужасный одновременно. Здесь враждуют неко и кицуне, а лживые боги смотрят на это с небес и смеются.Земли разделены между враждующими кланами. И территория клана Ито является лакомым кусочком для остальных. Но никто не решится идти открытой войной, ведь на востоке каждые пять лет прорываются кровожадные мору. и остановить их не всем под силу.Мир, населённый призраками и мифическими существами. Дружелюбными и на очень. Но все одинаково опасны для людей. Ведь человеческой расы практически нет. И за каждым человеком ведётся наблюдение. Ведь именно они убили прошлого Императора.И какого же будет обычному землянину, попавшему в этот чудесный и опасный мир? Поживём – увидим.</ns1:cycleDescription>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
  </rdf:Description>
