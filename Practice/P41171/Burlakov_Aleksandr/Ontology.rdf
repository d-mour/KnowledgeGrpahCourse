    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-05T08:49:05</ns1:publicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book041905"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#m31galaxypro"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-08-07T16:09:40</ns1:firstPublicationDate>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">В Москве будущего, где каждый шаг фиксируется уличными камерами, а падение социального рейтинга чревато потерей работы, мало кто отважится рисковать статусом “благонадежного”. Но Рэм играл и на съемочной площадке, и в жизни: в дурака – с полицией, в любовь – с женщинами, в рулетку – со смертью. Однажды ситуация выходит из-под контроля, и сокровенные тайны оказываются под угрозой раскрытия. Задорная игра превращается в поединок за жизнь и свободу.</ns1:cycleDescription>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Планета FREEков»</ns1:hasName>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
  </rdf:Description>
