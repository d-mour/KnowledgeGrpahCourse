  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle12293">
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ставя закорючку на бумажке, помни - написанное пером не вырубишь топором. Будучи молодым оболтусом я поддался алчности и не думая продал в НИИ свою... душу. Условия сделки были замечательными - деньги сейчас, а душа потом, когда умру. Но знал ли я, что через 22 года моего пути к величию всё обернется именно так? Не живой и не мертвый - теперь я одна из шестеренок проекта по колонизации Нового мира. Но мирится с этим я не намерен...</ns1:cycleDescription>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#zelcber2016"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-13T14:58:37</ns1:publicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book125761"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-02-16T19:59:11</ns1:firstPublicationDate>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Сафлоровая хроника»</ns1:hasName>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book114622"/>
  </rdf:Description>
