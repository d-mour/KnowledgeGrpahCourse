  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle02607">
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">"Кабирский цикл" (фэнтези) состоит из трех романов: "Путь Меча", "Дайте им умереть" и "Я возьму сам". Действие романа "Дайте им умереть" происходит через сотни лет после романа "Путь Меча" в том же мире; действие романа "Я возьму сам" -- за сотни лет до "Пути Меча". Каждый роман -- вполне самостоятельный, со своим сюжетом, идеей и главными героями. Тем не менее, вместе эти три романа образуют единый Кабирский цикл.</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book024361"/>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-12-01T11:54:21</ns1:publicationDate>
