    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book015514"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Всё начинается со сбоя в работе ИИ одной из самых популярных игр виртуальной реальности для взрослых. Главному герою предстоит найти выход из игры, в которой оказался заперт с тысячами товарищей по несчастью. Усугубляет всё тот факт, что умерев игре, можно умереть и в реальном мире или стать овощем.</ns1:cycleDescription>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Виват, квартерон!»</ns1:hasName>
  </rdf:Description>
