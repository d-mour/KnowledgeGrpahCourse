    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book119493"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Конец 21 века. Сбываются тревожные прогнозы футурологов. Перенаселение, подъем уровня мирового океана,  глобальные войны и кризисы. США распались, оставив после себя несколько крупных городов-государств на побережьях. В Бостонской агломерации пытаются построить новый тип общества, основанный на системе социального рейтинга. При этом все больше людей уходит в виртуал, поскольку в реальной жизни оказываются не востребованы. Растет новая, виртуальная экономика, вполне соперничающая с реальной. Утопия? Антиутопия? Ответить на этот вопрос не так уж просто...</ns1:cycleDescription>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-13T10:58:13</ns1:publicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book067125"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#vladimirvasilenko"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Наследие Странников»</ns1:hasName>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle01877">
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book018098"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Наследник»</ns1:hasName>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Жил-был дракон, да не простой, а отец всех драконов. А потом умер. Или нет?..</ns1:cycleDescription>
