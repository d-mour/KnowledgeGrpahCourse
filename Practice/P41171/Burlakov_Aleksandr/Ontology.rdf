    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Вселенная Наруто. Рью Нара.»</ns1:hasName>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#zang15"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book111323"/>
