  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle04939">
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-02T14:29:35</ns1:firstPublicationDate>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T03:23:25</ns1:publicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book069079"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Генетический кот»</ns1:hasName>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book043869"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Город Необходимск не обойти за один день, да и нужен он буквально всем. Здесь нашли приют генмоды — разумные животные, побочный продукт отшумевшей несколько десятилетий назад Большой войны. Здесь образование бесплатно, а гражданство стоит немалых денег. Здесь все еще в моде шляпки и пенсне, зато над городом рассекают воздушные такси. Здесь даже кот может стать сыщиком, а пес — инспектором полиции… если справятся с теми, кому это поперек горла.</ns1:cycleDescription>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#madoshi1"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book106479"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#sergeyplotnikov"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book049350"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle05624">
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Миром Валтарсии уже несколько тысяч лет правят демоны объединившие многие народы и почти всех людей под пятой Длани. Но даже в этом мире находятся смельчаки и безумцы еще не подчинившиеся Империи. Целое государство, Славия, так же называемая Междулесьем, все еще является непокоренной.</ns1:cycleDescription>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-28T21:00:10</ns1:firstPublicationDate>
