  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle06470">
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#sailor50"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-23T07:43:40</ns1:firstPublicationDate>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «КиберКлерк»</ns1:hasName>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-05T10:51:46</ns1:publicationDate>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Прогресс, новые технологии, безлимитный интернет, бесплатное электричество - ничего этого не было бы без чуткого и эффективного руководства топ-менеджеров. Власть корпораций - это совсем не плохо, особенно если ты работаешь на хозяев мира. Зачем что-то менять? Ведь мир уже идеален! Хватай зарплату и бегом в интернет, там столько новых сериалов!Хочешь попробовать иначе? Вперед, герой! Посмотрим, встанет ли кто-нибудь рядом с тобой.</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book057207"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book045545"/>
  </rdf:Description>
