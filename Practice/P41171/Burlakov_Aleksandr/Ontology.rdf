    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book015386"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Если человек не смог ничего достичь в жизни - это не означает, что он ничего из себя не представляет. Зачастую большие обстоятельства сильнее маленького человека, а талант не всегда имеет возможность проявиться.Но что, если обыватель вдруг получает достаточно сил, чтобы иметь возможность реально повлиять на мир, пусть и не на свой?Кем он станет, кто он есть, и что сможет сделать?</ns1:cycleDescription>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#momagic"/>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-04-10T03:13:34</ns1:publicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book019265"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Как варить зелья и создавать государства»</ns1:hasName>
  </rdf:Description>
