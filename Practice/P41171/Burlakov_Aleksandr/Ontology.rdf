  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle03459">
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нечистая сила существует. Наши предки об этом знали и даже жили бок о бок со сверхъестественными существами. Но современный человек всё забыл, считая остатки информации, дошедшие из глубины веков, сказками. И не среагировал вовремя, когда прошлое снова заявило о себе.Городское фэнтези, славянские (и не только) мифы и легенды, мистика, ужасы, постапокалипсис. Добро пожаловать в Вырай.</ns1:cycleDescription>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book044920"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-01-22T17:50:31</ns1:firstPublicationDate>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-31T05:28:48</ns1:publicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book032752"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book057180"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book027462"/>
