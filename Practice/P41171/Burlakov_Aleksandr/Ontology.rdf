  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle04271">
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#andrey0000"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book066210"/>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-10-09T13:37:29</ns1:publicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book046516"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Осколки миров »</ns1:hasName>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Осколок мира, что это? Просто маленький мирок, плавающий где-то? Или может, это особый мир, со своими законами, которые просто, еще никто, не смог понять и постигнуть? Да и вообще, осколок мира, как это возможно? Как мир может разбиться на осколки? Как вообще, виртуальная игра могла стать новым, "живым" миром? И как потом этот мир "погиб", породив осколок? Вопросов много, еще меньше возможностей на них ответить. Но хочешь ты или нет, осознать их все, постигнуть вплоть до мельчайшей тонкости, тебе придется. Иначе - смерть. Нельзя умереть в виртуальном мире? Скажи это тигру, вцепившемуся в твою глотку или троллю, опускающему на тебя свою дубину. Кого, вообще волнуют твои желания? Вот правильный вопрос, на который всегда есть ответ. Никого. А уж тем более багнутую систему осколка. Ей плевать, что ты хочешь, ей плевать, что и как ты будешь делать. Ты попал к ней в гости. Хотя нет, ты просто попал. Что дальше? Живи или умри.</ns1:cycleDescription>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-19T20:33:11</ns1:firstPublicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book056817"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book038287"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Tag00571">
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">троцкий</ns1:hasName>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Tags"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Tag00044">
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">становление героя</ns1:hasName>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Tags"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Tag01527">
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">отряд авантюристов</ns1:hasName>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Tags"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle06465">
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#elka256"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book074031"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Попасть в другой мир? Замечательно! Вы княжна? Вау! Аристократия - это круто. Только вот вас замуж выдавать собираются, уже почти завтра. И ограничений у вас, и требований к вам - список можно на три метра составить. Вы - маг? Это еще круче. Но учить вас никто не будет, и не надейтесь. Вы влюблены и вас любят? Ну... тут тоже не без подвоха. А что делать в такой ситуации обычной русской женщине? Жить. И верить в светлое завтра, даже если вокруг весьма сомнительное сегодня. А жить - хорошо. Во всех смыслах. И не все с этим согласны. Но Маруся обязательно разберется. Такой уж она человек... обязательный.</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book057510"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-13T16:46:53</ns1:firstPublicationDate>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book047248"/>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-30T18:14:44</ns1:publicationDate>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Маруся.»</ns1:hasName>
  </rdf:Description>
