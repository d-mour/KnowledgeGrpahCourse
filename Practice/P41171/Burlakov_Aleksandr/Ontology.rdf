  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Tag00289">
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">эксперимент</ns1:hasName>
