  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle12351">
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#sergeyplotnikov"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-02-17T17:49:28</ns1:firstPublicationDate>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Сталь»</ns1:hasName>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book115140"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book124107"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Большая война в этом мире отгремела пятьдесят лет назад, из нынешних жителей мало кто помнит, из-за чего она вообще началась и кто с кем сражался. Зато все отлично знают, какие шрамы она оставила. И мины вкупе с неразорвавшиеся снарядами в земле — самая меньшая из проблем. Неизвестно откуда взявшаяся мегафауна, против которой надо выходить с автопушками и на броне. Аномальные зоны, в которые можно незаметно для себя провалиться и больше никогда не выбраться. Погодные катаклизмы, с лёгкостью уничтожающие урожай на корню. В конце концов солнце, больше не появляющееся на небе. Таковы теперь Земли Хель. Но самым большим злом, конечно, как были, так и остаются люди. Из тех, что оценивают чужое мнение, чужие права и чужие жизни по цене патрона.</ns1:cycleDescription>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-16T15:00:40</ns1:publicationDate>
  </rdf:Description>
