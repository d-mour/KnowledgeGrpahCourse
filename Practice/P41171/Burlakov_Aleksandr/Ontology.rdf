  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle05931">
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-11T12:14:26</ns1:publicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book052553"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-24T08:55:19</ns1:firstPublicationDate>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Номер Один.»</ns1:hasName>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Будет чуть позже.</ns1:cycleDescription>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#heavensword"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book014648"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle08076">
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book066711"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Сломанный мир»</ns1:hasName>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-08T10:34:08</ns1:publicationDate>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Когда-то это был самый обычный мир. Несколько разумных рас отлично уживались в нём, строя свои государства, развивая искусство и культуру, науку и технологии. Но однажды что-то произошло, и мир треснул. Сквозь трещины в ткани мироздания в мир проникла мудрость, дарившая немалые силы, но и сама изменявшая все, чего касалась. Трудолюбивые северные карлики превратились в жадный подгорный народ, горделивые и мудрые гиганты стали глупыми и злыми великанами, измененные люди обозлились и деградировали. Мертвые больше не лежали спокойно в своих могилах - они поднимались в не-живой ипостаси. Но люди сумели приручить мудрость, сумели постичь ее тайны. И однажды смогли влить души в искусственные тела. Души грешников, которым предстояли вечные муки в Земле Боли - их вернули, чтобы поставить на службу. Так появились нерожденные, ааори, одним из которых и стал главный герой книги. Его цель - защищать людей и их союзников от измененных. Но будут ли ему благодарны местные, и был ли он грешником?</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book082995"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#leosuhov"/>
