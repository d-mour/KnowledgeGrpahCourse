  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle02334">
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book021790"/>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-10-20T13:37:42</ns1:publicationDate>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Война за выживание»</ns1:hasName>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">История жителей небольшого городка, перенесённого глобальным катаклизмом в некий аналог Ада. В комплекте особая магия, демоны, волшебные монстры, оборотни, секты и всевозможные превозмогания. По сути цикл имеет общую начальную точку с романом "Безымянный раб" (действие начинается в одном и том же городе).</ns1:cycleDescription>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#vzyckov"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-10-20T12:47:25</ns1:firstPublicationDate>
