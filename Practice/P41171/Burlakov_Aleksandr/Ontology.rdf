  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle01067">
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book011393"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book011773"/>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-11-10T03:40:38</ns1:publicationDate>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Великая Империя»</ns1:hasName>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#sergeyplotnikov"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Этот мир когда-то почти не отличался от нашего, несмотря на наличие магии. Однако в конце XIV века там произошло событие, кардинально изменившее дальнейшую историю народов Евразии. Сейчас, в начале двадцать первого века тут на месте России и Китая располагается огромное пан-евразийское государство, Великая Империя - конституционная монархическая республика с премьер-министром во главе. Семьдесят лет назад Империя выиграла тяжелейшую Великую Войну - тридцатилетнее противостояние с государствами Европы и поддерживающей их из-за моря Америкой. Мир царил долго, многим он даже стал казаться вечным... Но - время спокойствия закончилось. Начинается время перемен и, как предупреждает древнее китайское проклятье, - мало не покажется никому.</ns1:cycleDescription>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-11-10T02:12:18</ns1:firstPublicationDate>
  </rdf:Description>
