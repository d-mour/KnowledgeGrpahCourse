    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-03-10T19:05:18</ns1:firstPublicationDate>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">История о девочке, последней из рода, способной слышать и говорить с душами живых существ. Её судьба не может быть простой, и никогда такой не была, но она пока этого не знает. Ведь всё что она помнит, это то что она всегда была одна и старалась выжить как сирота, брошенная родителями в маленьком городе.</ns1:cycleDescription>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-03-10T19:52:43</ns1:publicationDate>
