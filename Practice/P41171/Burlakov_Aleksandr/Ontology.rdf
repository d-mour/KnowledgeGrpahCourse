  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle01266">
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book015370"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Многие предполагают, что истории о вампирах, оборотнях, демонах и прочей нечисти являются не просто выдумками, а самым настоящим пересказом реальных событий. А что, если темные существа не просто охотятся на людей, а еще и делят территорию, повышая навыки и получая умения, созданные кем-то еще именно для них? В такой закулисной войне простым людям уцелеть крайне сложно, и тогда на арену выходят Некоманты – маги, с легкостью способные перемещаться между мирами и умеющие усиливать нек; тех самых всем известных кошкодевочек, чья невероятная талантливость под умелым руководством способна свернуть горы, а преданная любовь к своему хозяину способна удовлетворить любое похотливое желание…</ns1:cycleDescription>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-04-06T14:00:21</ns1:publicationDate>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#nonsemper"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book011198"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Некомант»</ns1:hasName>
