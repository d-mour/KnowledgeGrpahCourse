  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle00756">
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book007914"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-06-14T17:37:45</ns1:firstPublicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book007919"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Псимаг»</ns1:hasName>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-15T05:15:02</ns1:publicationDate>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book076886"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book011291"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book103956"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#efanovsa"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Российская Империя, Москва, XXIII век от рождества Христова, больше двухсот пятидесяти лет прошло после планетарной катастрофы унесшей жизни 90% мужчин Земли. Из-за катастрофы на каждого родившегося мальчика приходится больше двух родившихся девочек. Земные государства по большей части уцелели, но миром теперь правят псимаги — люди открывшие в себе сверхъестественные способности. Новый строй называется неомонархизмом. Тех у кого в детстве не открылись псимагические способности называют простолюдинами. Их большинство, они лишены избирательных прав, но в остальном практически ни в чём не ограничены, живя простой жизнью, мало отличающейся от жизни их предков до Катастрофы.</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book048725"/>
  </rdf:Description>
