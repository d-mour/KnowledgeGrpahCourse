    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book025179"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book024940"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Реттийский цикл (он же "Чистая фэнтези")»</ns1:hasName>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book024629"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Это цикл ироничной и местами юмористической авантюрно-приключенческой фэнтези, которая, тем не менее, исподволь поднимает вполне серьёзные вопросы. Действие всех произведений цикла развивается в славном Реттийском королевстве. В цикл входят романы "Шмагия", "Приют героев" и "Гарпия", а также подцикл из трёх повестей "Три повести о чудесах" ("Захребетник", "Снулль вампира Реджинальда" и "Скорлупарь") и подцикл "Архивы Надзора Семерых", состоящий из пяти рассказов : "Старое доброе Зло", "Принцесса без дракона", "Турнир в Блезуа", "Дуэль" и "Проклятие".</ns1:cycleDescription>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-12-13T15:45:47</ns1:publicationDate>
