    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Эра Огня»</ns1:hasName>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book055076"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book046300"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-13T11:57:24</ns1:firstPublicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book038760"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book041241"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-15T08:24:07</ns1:publicationDate>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#istianid"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book124230"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book035655"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Он попал в другой мир не по воле случая. Его выбрали из миллионов живущих не за выдающиеся личные качества. Хотя, это смотря с какой стороны посмотреть... Неприятно услышать от красивой девушки, что единственные твои достоинства - слабоволие и слабохарактерность, а единственная перспектива - стать живым инкубатором для древней силы Огня. Здесь его называют Мортегар. Он - надежда почти погибшего клана. Он - таинственный безродный, которого пытаются использовать все, кому не лень. Однако даже в этом мире магов, цепляющихся за остатки былого величия, можно найти настоящих друзей и из безвольного инструмента превратиться в того, кто диктует миру свои правила.</ns1:cycleDescription>
  </rdf:Description>
