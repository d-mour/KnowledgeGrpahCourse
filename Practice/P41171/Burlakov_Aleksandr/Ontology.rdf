  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle02198">
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-08-22T18:50:51</ns1:firstPublicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book031673"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Серия указана как завершенная, но по факту завершена только трилогия. Написание продолжения весьма вероятно, как и продолжение всей серии о новых богах.Магия и физика на перекрестках миров; кровь и вино во дворцах и на аренах. Третья мировая, как предтеча первой войны кланов. Беспринципная новая знать и хищная старая аристократия - среди которой готовая заявить о своих правах принцесса, ведущая свою родословную от Меровингов, Иисуса из Назарета и Марии Магдалины. И оказавшийся не в том месте и не в то время вчерашний студент из Красноярска, захваченный водоворотом событий."Молодые боги - они пришли в этот мир, чтобы взять все"</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book019243"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-04-25T20:10:36</ns1:publicationDate>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#gelodelacruz"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Молодые Боги»</ns1:hasName>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book027353"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
  </rdf:Description>
