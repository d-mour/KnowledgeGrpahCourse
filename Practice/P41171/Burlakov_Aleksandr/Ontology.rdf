  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle02315">
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-27T10:06:38</ns1:publicationDate>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-10-16T19:15:12</ns1:firstPublicationDate>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мультивселенная, объединяющая в себе множество разных миров, связанных общими явлениями, технологиями и, конечно же, персонажами. Включает в себя произведения "Вор-неудачник", цикл "Фантомный мир", цикл "Призван, чтобы...", цикл "Грешные боги", цикл "Некомант", "Девятихвостая академия" и "Наследие Безликих"</ns1:cycleDescription>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «SemperVerse»</ns1:hasName>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book021645"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book042616"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#nonsemper"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle02335">
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book021797"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл книг о становлении молодого мага, живущего в мире, который пережил два вторжения демонов. В мире, где суша существует только в виде островов, и где ценятся лишь две вещи — магическая энергия и знания. Поединки, сражения, магические изыскания, интриги, взлёты и падения прилагаются.</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book037659"/>
