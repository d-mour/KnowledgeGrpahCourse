    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book019734"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#wl_lastleaf"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#jkr"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Героев.net»</ns1:hasName>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-12-14T08:07:08</ns1:publicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book015848"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book014017"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Охотник Себастиан любит пиво, женщин и бить людей. Ну и золото, конечно. У вампира Винсента золота в достатке, а ещё ему нужна помощь в прохождении квеста. Украденного из-под носа у топ-клана, между прочим! И так уж вышло, что Себастиан успел поссориться с теми же топами – такое случается, когда бьёшь и грабишь людей без разбора, не спрашивая ника и клана.К тому же, они все застряли в игре и не могут выйти. Ну или насчёт «всех» – это они так думают, пока Себастиан не избивает того, у кого кнопка «Выход» имеется...</ns1:cycleDescription>
  </rdf:Description>
