  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle09255">
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-04-26T17:11:49</ns1:publicationDate>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#svi6519"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book092378"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сыну ведьмы судьбой уготованы тяжкие испытания. Его дух будет закаляться в горниле Первой мировой и хаосе Гражданской войны, да и в Южной Америке доведётся изрядно повоевать. Зато с телом бойцу повезло — чудная наследственность, силой мысли может управлять гравитационным полем. И левитация — самый невинный дар от инопланетной ведьмы, с остальными подарками сироте предстоит разбираться всю жизнь. Стезя воина лёгкой не бывает, даже в параллельном мире.</ns1:cycleDescription>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#ss20333"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book061638"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Сын ведьмы»</ns1:hasName>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-29T15:11:44</ns1:firstPublicationDate>
  </rdf:Description>
