    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Он мечтал стать военным, как и все в роду князей Пожарских, но судьба распорядилась по-другому, наделив его уникальными возможностями в защите и не оставив способностей для нападения. Что он выберет – спокойную жизнь и учёбу в Университете, или службу в Отдельном корпусе жандармов?</ns1:cycleDescription>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-12-01T23:45:29</ns1:firstPublicationDate>
