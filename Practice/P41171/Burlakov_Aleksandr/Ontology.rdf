  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle04610">
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#lantsov_ma"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-28T20:24:41</ns1:firstPublicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book041116"/>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-28T20:47:10</ns1:publicationDate>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Демон»</ns1:hasName>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Простой российский паренек, сын плотника и столяра... эм... не так. Он не такой. Не подумайте. У него и мама была. :)&#13;
Так вот, попытался наш Максим помочь девушке, попавшей в опасную ситуацию, и не заметил как вляпался. Превратился в молодого демона, которому нужно как-то выжить, чего очень многим не хочется. Причем не на Земле, а в другом мире, совершенно незнакомом и непонятном.&#13;
&#13;
Цикл написан под впечатлением от "Одинокого Демона" Андрея Кощиенко, за что ему большое спасибо. Следствием этого впечатления есть некоторая схожесть композиции первых глав. Завязка слишком уж богата. А вот дальше идет уже совсем другая история...&#13;
&#13;
/// &#13;
Том 1. Демон - готов; &#13;
Том 2. Демон-дракон - готов; &#13;
Том 3 - в плане</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book041109"/>
  </rdf:Description>
