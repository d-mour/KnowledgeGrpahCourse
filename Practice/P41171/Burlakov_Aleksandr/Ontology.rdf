  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle01373">
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book014098"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book022311"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book022308"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл романов, описывающих приключения нашего человека в параллельном мире,  где история и география привычному ему порядку более или менее соответствует, но и различий более чем достаточно, ведь научный прогресс по большей части заменен магией. Небо этой Земли бороздят многопушечные летучие  корабли, отличающиеся от их морских собратьев лишь зачарованием корпуса и наличием баллона с горячим паром. В городах помимо людей можно встретить орков, эльфов, оборотней, наделенных гражданскими правами духов, разумных магических андроидов и много кого еще. По полям сражений помимо пехотинцев бегают боевые химеры, нежить, демоны и огромные боевые роботы. А в леса ходить опасно, ибо там живут чудовища, на которых иной раз и целой армии мало. Ах да, и еще там война. Четвертая Мировая. И век двадцать третий. А главного героя угораздило оказаться в немного изувеченном теле молодого колдуна, которого забирают на военную службу.</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book021201"/>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-05T14:49:49</ns1:publicationDate>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#mjasedvvladmir"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book087274"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Ведьмак 23го века»</ns1:hasName>
