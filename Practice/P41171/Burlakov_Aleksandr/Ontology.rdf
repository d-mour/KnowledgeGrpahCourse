  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle08146">
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Инициатива -  дело наказуемое?  Это мы еще посмотрим. Неунывающая ведьмочка Веся, верный друг леший, Мудрый ворон, кот Ученый, дуб Знаний и самая размножательно-ориентированная Заповедная чаща в мире готовы к любым невзгодам и трудностям. И вообще, кто к ним с проблемой придет, тот сам нарвался. Коронавирусу посвящается (в смысле книга была написана во времена COVID-19 для повышения иммунитета и хорошего настроения).</ns1:cycleDescription>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-24T09:03:21</ns1:publicationDate>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Лесная Ведунья »</ns1:hasName>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book073629"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#elenazvezdnaya"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-22T07:29:47</ns1:firstPublicationDate>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle01110">
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-11-13T20:57:49</ns1:publicationDate>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book011362"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book011168"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book019615"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Создатель эхоров.»</ns1:hasName>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Приключения вселенца с Земли в тело молодого человека в альтернативной вселенной, где наравне с обычными людьми проживают обладатели сверхспособностей, те, кого называют эхорами. Одним из них с необычными возможностями стал герой повествования.</ns1:cycleDescription>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-10-05T01:57:24</ns1:firstPublicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book014847"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#bakovetc_mihail"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
  </rdf:Description>
