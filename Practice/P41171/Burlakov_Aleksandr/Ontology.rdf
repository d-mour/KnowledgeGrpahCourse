    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Кваzи Эпсил'ON»</ns1:hasName>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
  </rdf:Description>
