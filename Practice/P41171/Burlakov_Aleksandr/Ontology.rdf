  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle05130">
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Порог Тяж»</ns1:hasName>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сеть собирает героев, ведь близится прорыв окружающих Порог миров. Захватить центральный, связующий мир - значит получить доступ к любому миру, и ради этого противники готовы пойти на все.Становление Тяжа (Вадим) - танка дримтим, которая попробует спасти Порог от иномирных захватчиков</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book017523"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-07-06T16:42:04</ns1:firstPublicationDate>
