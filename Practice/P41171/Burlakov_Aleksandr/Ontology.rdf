    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Серия эротических произведений про будущее и новые технологии. Здесь вы встретитесь с виртуальной реальностью, кибернетическими организмами, андроидами, уникальной химией и физикой, ну и конечно же эротикой. Куда уж там без неё? Жанры самые разные. Комедия, триллер, ужасы, повседневность, драма, боевик и тд и тп.</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book017794"/>
