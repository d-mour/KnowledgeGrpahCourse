  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle04578">
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#paymay"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book034235"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Вадик»</ns1:hasName>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вадик думал что его жизнь намазана маслом, а сверху чёрной икрой... Но пришло время платить за свои успехи. Его жопа уже давно числится активом в адском ломбарде и дьявол идёт к нему собирать долги. Но, порочность Вадика радует глаз дьявола из старой школы и он решил, что жопа Вадика сбережет свою девственность до тех пор пока он отработает долг. Но долг может подождать пока Вадик не наиграется с местными красавицами и не перемеряет на своего крупнокалиберного питона представительниц местных красоток всех рас и возрастов...</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book040892"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book040895"/>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-26T01:17:54</ns1:publicationDate>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-04-22T18:32:00</ns1:firstPublicationDate>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book125307">
    <ns1:hasCycles rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle07353"/>
    <ns1:hasRewards rdf:datatype="http://www.w3.org/2001/XMLSchema#int">37</ns1:hasRewards>
    <ns1:bookCharacters rdf:datatype="http://www.w3.org/2001/XMLSchema#int">324993</ns1:bookCharacters>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">В подземелье я пойду, там свой level подниму X</ns1:hasName>
    <ns1:hasTags rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Tag00031"/>
