    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «"Ученики Ворона"»</ns1:hasName>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">История молодых людей, которые стали подмастерьями мага, по прозвищу "Ворон". Не "академка", не любовный роман, не "ми-ми-ми" ни разу. Нет наставников-вампиров с благородной бледностью, нет трогательных героинь. Зато крови и всего такого хватает.</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book019775"/>
