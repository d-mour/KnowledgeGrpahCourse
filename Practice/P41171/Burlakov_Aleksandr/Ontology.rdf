    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-13T08:30:55</ns1:publicationDate>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Подземелье Кинга.»</ns1:hasName>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл повествует о приключениях трейсера Кинга, который попал в мир Альтерии в качестве "темного властелина", которому необходимо создать свою империю, и подчинить своей воле всех разумных существ этого мира.Данный цикл является продолжением цикла "Эволюция Кинга", но также легко читается и в отрыве от него.</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book119367"/>
