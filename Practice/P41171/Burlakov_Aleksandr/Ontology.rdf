  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle00701">
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book031598"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book048549"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book081687"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#harry_uerg"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нориа - виртуальный мир, созданный ради развлечения миллионов игроков. В нем ты можешь стать практически кем угодно и вершить историю, что повлияет на мир Нории и изменит его!Но не все так просто...Незыблемость законов виртуальности постепенно рушится, срываются программные замки с запретов и правил. И Крэйбен, ставший заложником новой реальности по воле трагического случая и рабом в самой могущественной гильдии убийц среди неписей, единственный, кто понимает и видит сокрытое ото всех остальных игроков. То, что мир Нории давно уже живёт своей собственной жизнью, а управляемые искусственным интеллектом персонажи и боги ведут игру, цели которой покрыты мраком тайны. И по иронии судьбы Крэйбен оказывается в самом центре разгорающихся событий, где на кону не только его свобода, но и жизнь!</ns1:cycleDescription>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
