  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle06299">
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-20T07:28:17</ns1:firstPublicationDate>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «ERROR»</ns1:hasName>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#krygent"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book061012"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book056031"/>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-31T20:18:08</ns1:publicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book056019"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Однажды Илье во сне явилась прекрасная дева из его самых смелых грёз. Вместо того, чтобы сказать "ня!", она спросила, не желает ли Илья установить себе в голову интерфейс продвинутой реальности. Тот ответил, пусть ставит что захочет, хоть с браузером Амиго в придачу!Как оказалось, шуток "богиня" не понимает и просьбы воспринимает буквально. Утром Илья обнаружил, что интерфейс ему достался с сюрпризом и работает совсе-е-е-е-ем не так, как ожидалось... Земля тебе пухом, парень, вряд ли ты выживешь...</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book056142"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book037067">
    <ns1:hasRewards rdf:datatype="http://www.w3.org/2001/XMLSchema#int">97</ns1:hasRewards>
    <ns1:bookCharacters rdf:datatype="http://www.w3.org/2001/XMLSchema#int">477154</ns1:bookCharacters>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-02T07:09:25</ns1:publicationDate>
    <ns1:hasTags rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Tag00011"/>
    <ns1:hasTags rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Tag00008"/>
