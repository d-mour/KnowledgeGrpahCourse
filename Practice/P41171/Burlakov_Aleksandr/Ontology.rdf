  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle09446">
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Громадная империя, раздираемая заговорами и испещрённая железными дорогами. Маги, состоящие на службе государства, но скрывающие свои секреты от всех, включая императора. Соседи, жаждущие оторвать кусок земли.Именно в этом мире ты просыпаешься после того, как врачи засунули твоё тело в капсулу для проведения операции по экспериментальной методике. Теперь ты - принц, почти вся семья которого мертва. Твой "дядя", успевший стать регентом, посылает тебя в магический университет, обещая что там ты будешь в безопасности, пока не вернётся память или не найдут заговорщиков. А всё чего хочешь ты - выжить и занять место в новом для тебя мире.</ns1:cycleDescription>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Эйгор»</ns1:hasName>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book096096"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book129112"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-23T18:36:06</ns1:firstPublicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book109986"/>
