    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#dmitrnightingale"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book079876"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «То ли сурок, то ли белка...»</ns1:hasName>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Наш современник, попав в мир магии, не сразу понимает, с чем ему   пришлось столкнуться. Решив одну проблему и получив сильную магию, он осознаёт, что вопросов прибавилась. Их всего трое, кто в курсе секрета и реально понимает, какую угрозу представляют язычники.</ns1:cycleDescription>
  </rdf:Description>
