  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle00818">
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book008634"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-07-09T20:48:15</ns1:firstPublicationDate>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book017453"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book011348"/>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-24T15:16:38</ns1:publicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book009546"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#pochta_marka"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Легко бить себя в грудь и навязывать собственное мнение, когда уверенно стоишь на ногах в этой жизни. А что если эта самая жизнь вот-вот подойдет к концу? Именно в такой ситуации оказался Артём Северов, ещё вчера обычный парень со своими планами на будущее, а уже сейчас обреченный на медленное угасание. Оказавшись на грани, Артём осознал, что готов на многое, а тут всего-то нужно устроиться на работу, да и не где попало, а в легендарно корпорации «Трансформа». Работёнка не пыльная: стать бета-тестером новой игры с полным погружением. Подарок судьбы! Разве что раса досталась весьма специфическая со всеми вытекающими, да болевой фильтр чуть выше, чем у остальных. Но для Артёма всё это мелочи, ведь главное выжить</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book011350"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book011347"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Трансформа»</ns1:hasName>
  </rdf:Description>
