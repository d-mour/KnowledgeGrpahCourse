    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Дорогой Ищущих»</ns1:hasName>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-01-27T14:33:04</ns1:publicationDate>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
