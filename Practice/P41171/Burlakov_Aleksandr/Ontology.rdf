  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle02374">
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book022126"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#bap63"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Вселенная Сафари.»</ns1:hasName>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book022134"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book022114"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book022121"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-10-28T20:57:30</ns1:firstPublicationDate>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book022127"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book022128"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book022131"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Действие происходит в 25 веке на планетах Земной Федерации. Содержит три подцикла: "Сафари" - главный герой капитан-лейтенант Александр Тарасов, бравый штурмовик; "Егерь" - главный герой Егерь-фелинолог Олег Денисов, напарник - спецкот Петрович; "Черный археолог" - главный герой бывший военный ксенопсихолог Павел Гаранин, главный антагонист - черный археолог Пьер Виньерон. В первых двух подциклах есть собственный законченный сюжет, плюс элементы сюжета глобального, объединяющего восемь книг в законченный цикл. Глобальный сюжет посвящен загадке Первых и их наследия - Ковчегу.Книги в хронологическом порядке:1) Операция "Сафари". Книга 1. Разведка боем; 2) Операция "Сафари". Книга 2. Огонь на поражение; 3) Егерь. Книга 1; 4) Егерь. Книга 2. Последний билет в рай; 5) Егерь. Книга 3. Котенок; 6) Черный археолог. Книга 1; 7) Черный археолог. Книга 2. По ту сторону тайны; 8) Черный археолог. Книга 3. Конец игры.</ns1:cycleDescription>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-03-15T18:23:45</ns1:publicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book022125"/>
  </rdf:Description>
