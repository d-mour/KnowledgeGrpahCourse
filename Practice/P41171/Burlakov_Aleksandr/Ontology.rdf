  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle03760">
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-01-10T15:02:07</ns1:publicationDate>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «S-T-I-K-S Элли»</ns1:hasName>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#arthurstonekonkurs"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book012992"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book012994"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-01-10T14:55:35</ns1:firstPublicationDate>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мы - лучшие, мы элита мира красоты. Высокие стены оберегают нас от мужской назойливости и опасностей Стикса. Нашу привлекательность шлифуют выдающиеся мастера своего дела, над образованием работают лучшие педагоги. И каждая воспитанница в итоге должна стать покорной избранницей важного господина. Но, несмотря на строжайшее воспитание, есть среди нас те, которые готовы пойти на немыслимое - поменять безопасность и комфорт Цветника на риск свободы. Все, что для этого надо - перебраться через стену, преодолеть охранные периметры, избежать внимания патрулей, избавиться от следящего браслета. И, главное - не дать себя убить, ведь в мире, где правит Смерть, у нас нет друзей, зато врагов великое множество.</ns1:cycleDescription>
  </rdf:Description>
