  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle08032">
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Страта»</ns1:hasName>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#kronos"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book082188"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-18T22:10:50</ns1:firstPublicationDate>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сгоревший пятьдесят лет назад в атмосфере астероид изменил жизнь человечества. Выбросы в атмосферу привели к смерти пяти процентов человечества. У единиц из числа выживших развились генные мутации, которые привели к непредсказуемым последствиям. Каждый из них получил новую уникальную способность, которая передавалась части детей. Попытка национальных правительств и международных структур установить контроль за "изменёнными" привела к полномасштабным столкновениям и многочисленным жертвам. В итоге был подписан "Пакт" по которому семьи людей с генетическими изменениями получали полную неприкосновенность и расширенные гражданские права. Долгое время на планете поддерживалась относительная стабильность. Пока в одной из частей света "изменённые" не начали убивать друг друга без видимых на то причин.</ns1:cycleDescription>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-12-10T21:25:07</ns1:publicationDate>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book072060"/>
  </rdf:Description>
