  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle03420">
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#kibolion"/>
