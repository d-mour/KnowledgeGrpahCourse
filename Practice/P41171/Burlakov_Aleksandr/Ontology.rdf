  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle07463">
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#aesler"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пророчество сказано, война неизбежна. Лёд и пламя разрывают мир Орна на части. Времени на подготовку не осталось, хор неверующих сильнее шёпота тех, кого считают безумцами. Старейшие кланы запирают свои цитадели, чтобы переждать самую длинную зиму в истории. Собирается снежный шторм, он способен навсегда стереть границы Империи. Пришёл Владеющий, в его груди тлеет искра истинной силы и он должен раздуть целое пламя... пламя войны.</ns1:cycleDescription>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-29T16:02:54</ns1:firstPublicationDate>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Избранный огнём»</ns1:hasName>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-12T08:03:36</ns1:publicationDate>
