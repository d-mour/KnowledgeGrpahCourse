  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle05027">
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-13T17:15:21</ns1:firstPublicationDate>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-11T18:48:09</ns1:publicationDate>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Путь Искателя»</ns1:hasName>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book044743"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book051649"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book090687"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book067595"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book057450"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ремиан родился в мире РПГ, где человеческие способности определяет магия и Система. Его отец из другого мира, его мать сильный маг, и ему предстоит нелегкий путь, если он хочет полностью освоить доставшиеся по наследству силы. Найдет ли он свое место в мире Системы?</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book101794"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#mishka_hill"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle01566">
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book015786"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#zelcber2016"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-04-29T08:38:10</ns1:firstPublicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book018175"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-08-09T15:12:46</ns1:publicationDate>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вы готовы познакомится с самыми невероятными существами, что только может представить себе воображение? До легенд, им конечно, далековато... Но вот хотя бы тенями этих самых легенд они вполне могут быть! Тут у нас представлены сольники таких неординарных персонажей, как Николай, Лейзар, Метатроныч и еще много-много разной дич... Интересных и занимательных личностей!</ns1:cycleDescription>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Тени городских легенд.»</ns1:hasName>
  </rdf:Description>
