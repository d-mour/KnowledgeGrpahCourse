  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle01770">
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Это цикл о боевых магах, работающих на управление пор контролю магии и сверхъестественного. В их задачу входит: устранение опасной нечисти, поимка магов-уголовников, постановка на место зарвавшихся божков, содействовать министерства обороны в случае применения врагом потустороннего оружия. Приключения, опасные враги и необычные друзья в комплекте прилагаются.Цикл состоит из двух арок про двух разных героев.Арка 1. "Ярость проклятых" - про боевого мага Егора Соснова (закончена);Арка 2. "Цвет проклятых" - про вырванного из бездны веков витязя Ярополка (пишется).</ns1:cycleDescription>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#yosarmor"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-06-25T12:56:56</ns1:firstPublicationDate>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-11-03T16:22:09</ns1:publicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book017265"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book017284"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Боевая магия»</ns1:hasName>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book017283"/>
  </rdf:Description>
