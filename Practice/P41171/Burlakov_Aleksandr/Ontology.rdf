  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle04090">
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book034239"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#andreslaa"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book036779"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-04-22T20:00:22</ns1:firstPublicationDate>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">История последней реинкарнации обычного русского мужика Витька, за которым числился вагон тяжёлых грехов. В этот раз ему придётся пойти через настоящий ад наяву. Станет ли он бессмертным если его личность и знания переместятся в совершенно иное существо? Останется ли он самим собой напичкав своё тело новыми органами других живых существ потеряв свою генетическую информацию омолаживая или полностью заменяя исходное тело? Одно точно...Он изнасилует каждую приличную девушку встреченную в этом мире в этом мире не смотря на их расы и видовые различия.</ns1:cycleDescription>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#paymay"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book036780"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «GREYRAT»</ns1:hasName>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book038962"/>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-19T08:00:00</ns1:publicationDate>
  </rdf:Description>
