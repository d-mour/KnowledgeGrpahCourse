  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle03786">
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-16T13:53:55</ns1:publicationDate>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Крестоносцы»</ns1:hasName>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#emptyperson"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Они пришли, чтобы вернуть себе Благодать Его. Они забрали земли, покорили неверных, построили новые государства на костях павших. Потому что мечом и огнем несли Слово Его и Веру в Него.Имя им - Легион. Крест на их груди. И победа будет за ними...</ns1:cycleDescription>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-04-29T01:02:22</ns1:firstPublicationDate>
