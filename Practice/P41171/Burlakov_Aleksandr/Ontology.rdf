    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">сарказм и юмор</ns1:hasName>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Tags"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle02515">
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-11-15T04:43:12</ns1:publicationDate>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Созерцатель»</ns1:hasName>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Риерта — город среди воды, сотканный из серебряных нитей дождя, пелены тумана, чугунной безнадеги и несбывшихся надежд. Родина нового индустриального бога — мотории, подмявшего под себя пар и уголь. Мотория принесла прогресс в каждый дом, а вместе с ним боль, смерть и страх перед теми, кто скрывается в развалинах затопленных улиц и кто уже давно перестал быть людьми.Риерта недружелюбна к чужакам, и Итан Шелби, приехавший сюда, сам того не желая, ввязался в историю, сплетенную из мрачных тайн прошлого, опасностей и приключений.</ns1:cycleDescription>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book023308"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book023305"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#alexey_pehov"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-11-15T04:43:03</ns1:firstPublicationDate>
  </rdf:Description>
