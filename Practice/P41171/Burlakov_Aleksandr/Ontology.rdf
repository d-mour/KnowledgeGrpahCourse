    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">повелитель хаоса</ns1:hasName>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle05131">
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book019511"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Порог Серый»</ns1:hasName>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вновь появляются давным-давно утерянные артефакты и оживают древние пророчества. Еще немного и миру Порог придется столкнуться в битве с иномирными захватчиками. Ведь тот, кто владеет Порогом - владеет всем.Становление Серого (Джам) - дд/антимаг дримтим, которая постарается спасти Порог от иномирных захватчиков</ns1:cycleDescription>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-08-30T09:56:59</ns1:firstPublicationDate>
