  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle02147">
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#sergeyplotnikov"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-11-04T04:41:21</ns1:firstPublicationDate>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-11-04T04:41:21</ns1:publicationDate>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book020327"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Тёмный»</ns1:hasName>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Княжества на Побережье - древняя вотчина князей-мореплавателей, пиратов и светлых магов, которым никто не указ. Правда, на самом деле независимость - лишь досадная фикция. Крупное государство-сосед вынужденно терпеть гордых самовластных правителей местных маноров ради сохранения буферной зоны. Потому, если кто-то в княжеской вольнице о себе слишком много возомнит и забудет свое место - расплата следует незамедлительно. Например, очередной кандидат на роль объединителя Княжеств "случайно" заполучил проклятье "метки зла", из-за чего в семье сильнейшего светлого родился темный наследник. Опасное это заблуждение - считать себя всемогущим вершителем судеб, особенно когда дело доходит до плохо изученных разделов чужой магии. Попытка додавить ситуацию обернулась тем, что на месте затравленного маленького ребенка оказался взрослый ученый из другого мира. Одно неосторожное действие со стороны ничего не понимающего попаданца - и все планы всех сторон пошли кувырком под откос...</ns1:cycleDescription>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Tag00355">
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">грустная сказка</ns1:hasName>
