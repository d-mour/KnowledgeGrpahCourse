    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Ойкумена»</ns1:hasName>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book027458"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book027961"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book027896"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book027725"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book027322"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">«Ойкумена» (космическая опера) -- авторская эпопея Г. Л. Олди, широкомасштабное галактическое полотно, которое пишется уже более 10 лет. На сегодняшний день "Ойкумена" состоит из пяти законченных романов-трилогий:1. «Ойкумена» (космическая симфония):Книга 1: «Кукольник».Книга 2: «Куколка».Книга 3: «Кукольных дел мастер».2. «Urbi et Orbi, или Городу и Миру» (космическая сюита):Книга 1: «Дитя Ойкумены».Книга 2: «Королева Ойкумены».Книга 3: «Изгнанница Ойкумены».3. «Дикари Ойкумены» (космический марш):Книга 1: «Волчонок».Книга 2: «Волк».Книга 3: «Вожак».4. «Побег на рывок» (космическая серенада):Книга 1: «Клинки Ойкумены».Книга 2: «Призраки Ойкумены».Книга 3: «Ангелы Ойкумены».5. «Блудный сын, или Ойкумена: двадцать лет спустя» (космическая фуга):Книга 1: «Отщепенец».Книга 2: «Беглец».Книга 3: «Сын Ветра».Каждый роман-трилогию "Ойкумены" можно, в принципе, читать отдельно от других. Но вместе они образуют единую эпопею со своим мета-сюжетом.</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book027107"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book025766"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book028064"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book026225"/>
