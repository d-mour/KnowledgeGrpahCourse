  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle02206">
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-07-01T11:37:01</ns1:publicationDate>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-05-06T09:28:46</ns1:firstPublicationDate>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#zelcber2016"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Агенты "Стилет". »</ns1:hasName>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book016508"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book015481"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Жил был на свете Анто... В смысле, Семен! И не Городецкий, а Васильев. Был рядовым полицейским, который хотел "изменить мир к лучшему". Но одно задание полностью меняет его жизнь. Прям таки знаете, на все 180 градусов! С тех пор прошло пять долгих лет и из невинного полицейского, наш герой превратился в самого натурального отбитого спеца, который охотится за нечистью. Итак, эта серия книг об Обществе с Неограниченной Безответственностью. Нравится жанр комедийного триллера с нотками сюра и фэнтези-детектива? Тогда тебе к нам!</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book016724"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle01204">
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл « "Age of 50" ("Эпоха Полтины").»</ns1:hasName>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Постмэджик фэнтези в мире, пережившем магический коллапс.</ns1:cycleDescription>
