    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book058605"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book055342"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book055343"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">В тридцать лет остаться без работы, без каких-либо внятных перспектив... А теперь еще и без жены. Крах - или все-таки последний шанс ввязаться в авантюру? Потерявший былую популярность писатель Антон Смирнов принимает приглашение от старого друга и отправляется на виртуальные просторы морей в поисках наживы. Поначалу "Гардарика" кажется простой игрушкой. Но все изменится, когда Антон поймет, что грызня кланов уже скоро выльется в войну и в реальном мире, а некоторые друзья и враги покажутся смутно знакомыми.</ns1:cycleDescription>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Видящий»</ns1:hasName>
  </rdf:Description>
