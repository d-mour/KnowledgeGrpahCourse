  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle10026">
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#sergeyplotnikov"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#a_pribylov"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Ведьмино варево»</ns1:hasName>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-13T19:34:06</ns1:publicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book092388"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-10-08T11:35:56</ns1:firstPublicationDate>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ведьмы славятся своей способностью из всякой гадости типа кротовьих когтей или еще чего похуже сварить хоть приворотное зелье, хоть смертельный яд, хоть суп себе на обед. Конечно, не всё, добытое окрест или привезенное из далеких краев идет именно в котел: залетному добру молодцу можно и баньку протопить, и спать его уложить, и гостинцев в дорогу дать. Вот только... иногда из лесу выходит такое, что ни в сказке сказать, ни бульдозером убрать!</ns1:cycleDescription>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
  </rdf:Description>
