  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle05539">
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book062952"/>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-01T17:00:22</ns1:publicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book049878"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book049235"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-06T13:57:01</ns1:firstPublicationDate>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#ariohalex"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Зимние сказки»</ns1:hasName>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сбежать от убийц, истребивших твой народ, и жить мечтой о возвращении и мести. А вернувшись, понять, что уже поздно. Слишком поздно мстить кому бы то ни было. Коварны межмировые потоки времени, и несколько мгновений в безмирье могут равняться тысяче лет твоего родного мира. И поздно мстить убийцам - они давно мертвы. Они мертвы, - а твой мир умирает. Какой бы он ни был - злой, жестокий, коварный... но он твоя родина. И есть средство спасти его. Избавить от вечной агонии хаоса. Вот только цена... Спасти мир ценой предательства... А стоит ли мир такой высокой цены?</ns1:cycleDescription>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle05192">
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-01T12:34:34</ns1:publicationDate>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-01T11:51:03</ns1:firstPublicationDate>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#zhiltsova"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Невеста»</ns1:hasName>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Что может быть желанней, чем стать невестой будущего императора? Избежать этой участи! Эту истину я поняла, когда неожиданно оказалась среди избранных богиней претенденток. В одно мгновение мой древний род, где особый магический дар передавался только по женской линии, оказался на грани исчезновения, ибо по воле богини у императриц рождались лишь мальчики. Но это еще не все! Могущественный враг в стремлении захватить наш мир и уничтожить императорскую семью открыл на избранниц богини охоту. И едва начались первые испытания, претендентки стали погибать. Отбор невест превратился в игру со смертью. Теперь, чтобы сохранить свою жизнь, я должна пройти эту игру до конца.</ns1:cycleDescription>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book046330"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book046339"/>
  </rdf:Description>
