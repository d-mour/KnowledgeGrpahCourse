    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Тёмный лорд ONLINE»</ns1:hasName>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-31T08:25:36</ns1:publicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book054921"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book055473"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book054925"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-04T10:45:22</ns1:firstPublicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book066971"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Серёга просто выпил с мужиками, а утром очнулся в склепе, в теле почившего Тёмного Лорда! Двигается иссохшая тушка плохо, словно Владыка тоже любил в танчики до утра погонять – срочно надо прокачиваться! В некромантии Серёга ни черта не понимает, но когда это останавливало хорошего айтишника? У него свой взгляд на порабощение мира – людей сподручнее подчинять при помощи социальных сетей, благо в мире магии есть аналог. Лайки и репосты города берут... А страшнее Саурона может быть только Саурон-блогер.</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book054931"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book095364">
