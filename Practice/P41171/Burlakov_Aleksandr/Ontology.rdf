    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Как создать хентай»</ns1:hasName>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-12T14:00:06</ns1:publicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book110160"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hanaben кажется тихим и неприметным городом на побережье Тихого океана. Но так же, как и океан, внутри полиса кипит жизнь и порой довольно активно.В антологию «Hanaben» будут включены истории нескольких персонажей. Несколько жизней, переплетённые между собой. Чьи-то весёлые, а чьи-то могут показаться довольно мрачными. Но такова наша реальность, где никто не может с уверенностью сказать, что ждёт его завтра.</ns1:cycleDescription>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#farg"/>
  </rdf:Description>
