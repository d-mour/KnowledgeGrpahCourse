  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle03204">
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book012805"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Будущее. Технологии позволяют буквально переселяться в виртуальные миры. Каково это - отстраивать свой Замок, нанимать армии, прокачивать героев, изучать могущественные заклинания и познавать тайны магии, но когда всё это не игра, а реальность? Звучит заманчиво, но только для тех, кто пришёл в мир "Земель Меча и Магии" поиграть и отдохнуть. Повеселиться. Увы, Ренат не из их числа, им движет отчаяние. В надежде найти застрявшую где-то в глубине игры супругу он с головой ныряет в суровый виртуальный мир, не думая о последствиях. Удастся ли ему добиться цели? Сможет ли он остаться собой? Игра покажет...  Цикл произведений является частью межавторской серии "Земли Меча и Магии".</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book034632"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Замок мага»</ns1:hasName>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book029239"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-23T04:53:04</ns1:publicationDate>
