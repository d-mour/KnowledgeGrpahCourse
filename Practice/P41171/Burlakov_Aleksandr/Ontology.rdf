    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book109017"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-15T13:28:37</ns1:firstPublicationDate>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-16T17:13:13</ns1:publicationDate>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Тут магия и технология идут рука об руку. На полях сражений бронеходы давят армии нежити, демоны бьются с измененными живыми, в небе кружат дирижабли, а срочные грузы таскают драконы.Приключения двух наглухо отмороженных волшебников. Без жалости, без любви, без великой цели.Здравый смысл будет страдать! Добро пожаловать!</ns1:cycleDescription>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
