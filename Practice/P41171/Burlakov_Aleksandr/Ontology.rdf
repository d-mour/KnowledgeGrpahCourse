  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle05783">
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book089102"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book109108"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book079752"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">История пробуждения Силы, что всегда была в крови людей. Рода, кланы, дворцы и могущественные Императоры. Ключи от Пангеи - это книга-история о РеалРПГ, в которой есть монстры живущие среди людей. Изнанка мира, Бездна, пришлые твари и иномиряне, действующие в своих интересах. Вы читаете первые строки эпопеи о Системе, которая не "приходила в наш мир", а просто проснулась от долгого сна. Рассказ о Чуде, как человеке, а не феномене человеческого общества.Приятного вам чтения, дорогой читатель.</ns1:cycleDescription>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#siu_tower_of_god"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book060799"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book069783"/>
