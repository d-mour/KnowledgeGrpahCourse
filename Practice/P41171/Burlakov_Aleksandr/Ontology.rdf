    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Tags"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">момент настоящего и самое лучшее в нем</ns1:hasName>
