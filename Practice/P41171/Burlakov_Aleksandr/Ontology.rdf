    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-16T01:37:53</ns1:publicationDate>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-29T03:04:37</ns1:firstPublicationDate>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «АСКЕТ»</ns1:hasName>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Добрыми намерениями выложен путь в АД. Этот закон в полной мере испытал на себе Максим, по ошибке попав в место, где человеческая жизнь не стоит и глотка воды. Хотя нет, стоит, только совсем иного - сферы души! И чем больше сфер ты соберёшь, тем больше у тебя шансов выбраться из творящегося вокруг АДА. А вот кем ты выберешься - человеком, или безумной тварью, решать только тебе!</ns1:cycleDescription>
  </rdf:Description>
