    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book013412"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#alehin00724"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Мир Валькирий »</ns1:hasName>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-02-19T05:54:42</ns1:publicationDate>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Главный герой попадает в мир, немного опережающий наш в развитии, где после всемирной катастрофы правят женщины. Кланы, боярские рода и девушки, способные взмахом руки стереть с лица земли целый город. Как устроиться в этом мире мужчине, привыкшему быть сильным и считающему женщин слабым полом?</ns1:cycleDescription>
  </rdf:Description>
