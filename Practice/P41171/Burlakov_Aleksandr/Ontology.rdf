    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Эгида»</ns1:hasName>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book062229"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book038619"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book054079"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book038618"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Приключения главного героя в компьютерной игре "Эгида". Инженер едет домой к семье, но внезапно погибает в автомобильной аварии. Жизнь после смерти приобретает форму участия в виртуальной игре, в ней ему поставлены строгие ограничения, невыполнение которых приведет к окончательной гибели. Но если герой справится с испытаниями, то получит шанс вернуться к семье.</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book038616"/>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-14T14:00:14</ns1:publicationDate>
  </rdf:Description>
