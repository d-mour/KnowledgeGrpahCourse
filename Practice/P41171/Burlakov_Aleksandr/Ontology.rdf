    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-03-30T11:38:37</ns1:firstPublicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book015125"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#sailor50"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Жрец»</ns1:hasName>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book019029"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Молодому поколению не нужны нравоучения, им нужны игры! Фан, веселье, приключения! Именно для этого Норман регистрируется в новой ММОRPG игре с полным погружением. Только вот беда, любимый класс лекаря целиком и полностью завязан на вопросах веры. Обеты, аскезы и сломанные судьбы…что может безоружный лекарь без постоянной пати? Это и многое другое вы найдете в трилогии «Жрец».</ns1:cycleDescription>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book015178"/>
