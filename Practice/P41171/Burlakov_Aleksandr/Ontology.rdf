  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle01126">
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book012330"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book012181"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Квантовая телепортация сознания... Для кого-то просто непонятные слова, а для меня приговор. Мое сознание переместили сюда, в Верравию, компьютерную игру последнего поколения. И теперь я баг, ошибка, незарегистрированный персонаж, которому нельзя того, что можно остальным - умирать.</ns1:cycleDescription>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-04-24T17:22:14</ns1:publicationDate>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
