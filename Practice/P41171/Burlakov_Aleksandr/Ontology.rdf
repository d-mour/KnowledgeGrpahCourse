    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book061031"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Много гоблинов и часто с пушками. Иногда тупых, иногда даже очень. Иногда с матом, иногда за дело. Если горит костёр - значит сожгли хату. На нём готовится енот - за ним три дня как посылали танки. Атаман зовёт - караул в ружьё! Люди пришли - сами виноваты! Их скоро перебьют - простая ситуация. Это Гоблин ОПГ - запрещённая на территории всех королевств организация.</ns1:cycleDescription>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book089293"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-25T21:02:09</ns1:firstPublicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book105725"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Автократия Гоблинов»</ns1:hasName>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-26T12:07:04</ns1:publicationDate>
  </rdf:Description>
