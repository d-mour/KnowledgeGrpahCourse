  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle04519">
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-11-05T20:29:09</ns1:firstPublicationDate>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book039235"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#asababkov"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Совершенно неготовый к приключениям "в игре" человек, после своей смерти оказывается в настоящем мире где действует чуждая для него "игровая система". Признавая наличие такой системы, все вокруг обижаются на обращение "игрок" и даже могут дать за это в морду. А еще все подобные герою попаданцы как один имеют "профессию" либо вора, либо убийцы. Вот только выбравший себе имя "Геракл" попаданец не является ни тем, ни другим, а хуже всего, что никто ему не верит. Так что герою предстоит найти свое место в жизни и раскрыть главную тайну окружающего Мира и все это под бесконечное спасение себя и других, ибо иначе боги прогневаются и тогда все станет еще хуже...</ns1:cycleDescription>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-18T13:25:38</ns1:publicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book011683"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «ЛитРПГ - Геракл и его приключения (дилогия)»</ns1:hasName>
  </rdf:Description>
