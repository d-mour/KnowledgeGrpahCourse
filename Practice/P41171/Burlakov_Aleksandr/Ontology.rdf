  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle07650">
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Про что тут? Если коротко, о магическом или вроде того апокалипсисе. О том, как на Землю высадился десант из демонов, а потом бравые воины церкви начали с ними бороться. Святой водой, добрым пастырьским словом, плазменными метателями и освященными рельсотронами.Цикл закончен.</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book069270"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-21T11:51:35</ns1:firstPublicationDate>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «После Судного Дня»</ns1:hasName>
