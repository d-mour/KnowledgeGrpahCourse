    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book048631"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-28T11:11:19</ns1:firstPublicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book048429"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book048481"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">"Зловещая Долина" - психологический феномен, реакция человеческой психики на существ, напоминающих людей, но имеющих другую природу. "Похож, но не является" - особенно если объект не живое существо, а робот, андроид, движущаяся кукла. Любимая тема для страшных фантастических рассказов или фильмов ужасов: роботы взбунтовались против своих создателей.&#13;
Но зачем роботам бунтовать? А что, если Искусственный Интеллект будет совершенно лоялен, полностью дружелюбен, если роботы станут не опасными чужаками, а теми самыми братьями по разуму, которых так не хватает человечеству? Избавит ли людей от страха в Зловещей Долине добрая воля Искусственного Разума ?</ns1:cycleDescription>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Зловещая долина»</ns1:hasName>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book049125"/>
  </rdf:Description>
