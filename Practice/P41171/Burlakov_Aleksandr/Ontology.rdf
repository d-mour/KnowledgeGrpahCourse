  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle05757">
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кому-то Фортуна подкидывает подарки с самого рождения, а кого-то игнорирует на протяжении всей жизни. Но, если ты идёшь к своей цели, не смотря на удары и подножки, которыми изобилует жизненный путь, Удача вынуждена будет обратить на тебя внимание. Ведь она любит упорных!</ns1:cycleDescription>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#aristorg1233"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book046469"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Удача любит упорных»</ns1:hasName>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-28T02:28:15</ns1:publicationDate>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-18T03:22:06</ns1:firstPublicationDate>
  </rdf:Description>
