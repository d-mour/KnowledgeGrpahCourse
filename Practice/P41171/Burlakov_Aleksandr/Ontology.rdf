    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-26T04:12:53</ns1:firstPublicationDate>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">История о попаданце, который решил стать наёмником.Герой сопровождает в пути юного претендента на трон Винэрии. Однако это не просто путь. Это дорога, которую должен пройти каждый король. На пути героев ждут испытания, которые призваны закалить в будущем правителе стальной характер. Вот только наёмник, соглашаясь на контракт об этом не знал, да и паренек не ожидал того с чем придется столкнуться.</ns1:cycleDescription>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-13T22:57:14</ns1:publicationDate>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book126983"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#oleg4eloveg"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
  </rdf:Description>
