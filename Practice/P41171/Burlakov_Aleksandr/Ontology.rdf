  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle12737">
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">"Алюмен" - это трехтомный роман, написанный в соавторстве Г. Л. Олди и Андреем Валентиновым.Время действия - первая половина XIX века. Место действия - изрядная часть Европы, Россия, Китай, Окинава...Герои - исторические личности, в чьих биографиях нашлись весьма интересные факты и "темные пятна" - и колоритные авторские персонажи. Наука и мистика, стимпанк и электропанк, авантюрно-приключенческий роман и криптоистория, философский боевик, фэнтези и почти научная фантастика.Скучно не будет!</ns1:cycleDescription>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Алюмен или Земная опера»</ns1:hasName>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-18T03:53:50</ns1:firstPublicationDate>
