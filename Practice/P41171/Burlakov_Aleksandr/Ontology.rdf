    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-08T03:22:42</ns1:publicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book004963"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">В одночасье мир изменился. Подаренные возможности ломают прошлые законы и позволяют начать новую жизнь. Те, кто примет правила и не испугается трудностей смогут достигнут невиданного доселе могущества.</ns1:cycleDescription>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle02850">
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book026228"/>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-08-12T07:33:52</ns1:publicationDate>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#grishanin777"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Тегваар»</ns1:hasName>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book040528"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Добро пожаловать в город Тегваар, существующий в невидимом обычным людям расширенном магией пространстве, где магия соседствует с современными технологиями. Здесь рядом с людьми живут эльфы, гномы, тролли и пр. фэнтезийные существа. Реальный мир за границей своего города тегваарцы называют Широкое Запрелелье, попасть туда из Тегваара можно только порталом и доступно это только магам.</ns1:cycleDescription>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-01-04T14:11:59</ns1:firstPublicationDate>
  </rdf:Description>
