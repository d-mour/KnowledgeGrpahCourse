    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">История об Эларде, Защитнике дома Сорас, что вынужден участвовать в сражениях не на жизнь а на смерть во славу АрхиВладыки.</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book102921"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-11-17T10:30:31</ns1:firstPublicationDate>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
