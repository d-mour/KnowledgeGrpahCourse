    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book022046"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Несколько книг, объединенных общей идеей, но не общим главным героем. Концепция нагло стырена у Стругацких, Лема и прочих мамонтов фантастики.</ns1:cycleDescription>
