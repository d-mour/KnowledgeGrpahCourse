  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle13713">
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дорога, драки и рок-н-ролл. Это роад-муви четверых отмороженных придурков, с боями пробивающихся на запад, причем самый низкоуровневый едет верхом на пятом члене этой компании, вполне себе разумном. Еще в этой книге есть драчливые демоны и похотливые демонессы, троллинг и булинг, дружеские подколки, серьезные косяки и принцип "душу свою положи за други своя" как руководство к действию.В шестнадцатом веке тоже понимали про секс, насилие и фэнтези. Эта книга - пересказ-ремейк написанного во времена Ивана Грозного классического китайского романа "Путешествие на Запад" - с блэкджеком и РеалРПГ.</ns1:cycleDescription>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-13T21:00:10</ns1:publicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book128812"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#id86412741"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Куда идём мы...»</ns1:hasName>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-11T07:19:11</ns1:firstPublicationDate>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
  </rdf:Description>
