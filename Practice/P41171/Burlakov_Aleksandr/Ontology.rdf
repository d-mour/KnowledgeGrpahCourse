    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">былина аниме</ns1:hasName>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Tag01257">
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Tags"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">путешествие в неизведанное</ns1:hasName>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle04608">
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">У Виктора всегда все проблемы были из-за женщин. Но кто бы мог подумать, что именно в этот раз они заведут его в мир слабоумия и отваги... Люди, эльфы, орки, драконы, боги и один леший разберет что еще. И во всем этом Виктору предстоит разобраться. Выйдя, в конечном итоге за пределы планеты и отправившись в галактические приключения.</ns1:cycleDescription>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-28T16:59:49</ns1:firstPublicationDate>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Наглая морда»</ns1:hasName>
