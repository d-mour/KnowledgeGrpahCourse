    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-11-30T09:43:17</ns1:firstPublicationDate>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Виртуальная реальность изменила все. Вирт заменил сон и это значительно удлинило жизнь людей. А значит и сместило приоритеты. Теперь игра такая же реальность, как и привычная жизнь. И ставки в таком случае высоки!</ns1:cycleDescription>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#artbogdanov1982"/>
