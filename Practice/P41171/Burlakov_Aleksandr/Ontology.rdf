  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle09661">
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-06T14:26:30</ns1:publicationDate>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «КОС ЕИВ»</ns1:hasName>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл книг о группе попаданцев-наших современников в 1904 год. Самое начало войны с Японией в реальности, которая так похожа на нашу. Однако, имеющие отличия столь малы, на первый взгляд, но так весомы, что становится не по себе - если оставить все как есть, можно ли надеяться хотя бы на такое же развитие событий, какое было в нашей истории.Поэтому, Корпус Особых Советников Его Императорского Величества, подзатянув пояса, берется за работу по перекраиванию раскладов в новом для них мире.</ns1:cycleDescription>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book078323"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#ilya_semenov1"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-17T08:30:11</ns1:firstPublicationDate>
  </rdf:Description>
