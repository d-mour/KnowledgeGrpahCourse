    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-14T07:34:49</ns1:publicationDate>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book048195"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book101141"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Наш современник Иван Громов после смерти приходит в себя в теле отрока – старшего сына Великого князя Ивана III - Ивана Молодого. Попадает и начинает выживать, крутится, вертеться. Ведь мать убили. Скоро должна приехать мачеха - знаменитая Софья Палеолог. А это приговор... и ему... и России...// Эпоха Ивана III - ключевая эпоха для Руси и России, определившая судьбу нашей страны и до сих пор ее определяющая. Эта эпоха - как первый лист в заборе - малейшая кривизна и весь забор пойдет в пляс.</ns1:cycleDescription>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-25T04:41:39</ns1:firstPublicationDate>
