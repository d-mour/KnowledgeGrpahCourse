  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle09760">
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book100744"/>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-13T04:34:32</ns1:publicationDate>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Эпоха стражей.»</ns1:hasName>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">В этот мир пришла магия, ознаменовав новую эпоху. Эпоху, где один человек может стоить тысячи. Эпоху постоянной угрозы от порождений магии и мутантов. Эпоху постоянных сражений. Эпоху сотен героев оберегающих мирную жизнь обычных людей и непрекращающейся войны за выживание вида. Эпоху стражей!</ns1:cycleDescription>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
