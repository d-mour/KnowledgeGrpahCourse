  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle02863">
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-09T16:45:38</ns1:publicationDate>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Наследник лепрекона»</ns1:hasName>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Третьеклассник Лис Решкин, спасаясь от хулиганов, проваливается в бутылку из-под шампанского. Так начинается история знакомства юного волшебника с миром Радуги. Мальчик переживает череду головокружительных приключений и узнает о семи Великих Домах.Красном Доме – Доме перевёртышей (или оборотней) и их магии живой крови или магии жизни.Оранжевом Доме – Доме ифритов и магии огня.Желтом Доме – Доме ткачей и магии земли.Зеленом Доме – Доме фейри и магии природы.Голубом Доме – Доме джинов и магии воздуха.Синем Доме – Доме тритонов и магии воды.Фиолетовом Доме – Доме вампиров и магии мёртвой крови или магии смерти.Жизнь Лиса круто меняется.  Теперь, наряду с обычными уроками, в его школьном расписании появятся уроки магии.</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book040741"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-01-05T16:07:50</ns1:firstPublicationDate>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#grishanin777"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book026298"/>
  </rdf:Description>
