    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Роякс»</ns1:hasName>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пустой, умирающий после глобальной войны мир. Нет победителей, есть выжившие. Обитаемых миров во вселенной множество, войны между ними запрещены, некой древней расой смотрящих. Но никто не запрещал захватывать то, что уже опустело, и всегда  есть те, кто хотят этот мир взять под свой контроль.</ns1:cycleDescription>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
