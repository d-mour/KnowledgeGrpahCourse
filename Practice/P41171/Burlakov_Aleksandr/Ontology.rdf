  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle02864">
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-08-18T09:44:50</ns1:publicationDate>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book026299"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book042015"/>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Волшебный хоккей»</ns1:hasName>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#grishanin777"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-01-05T17:38:38</ns1:firstPublicationDate>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Правила в Волшебном хоккее такие же, как в обычном хоккее с шайбой. Только вместо людей здесь на ледовых площадках сражаются поставленные на коньки и вооруженные клюшками животные и даже насекомые. Для людей Волшебный хоккей долгое время был под запретом. Но однажды трое пятиклассников находят в сугробе Шайбира - волшебную шайбу-пропуск на площадку Волшебного хоккея. История начинается...</ns1:cycleDescription>
  </rdf:Description>
