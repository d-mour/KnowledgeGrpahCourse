  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle01082">
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#sergeyplotnikov"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book011529"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book014677"/>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-10-27T14:03:22</ns1:firstPublicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book011540"/>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-16T10:33:10</ns1:publicationDate>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Последний экзорцист»</ns1:hasName>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Есть такая профессия: колдунов и демонов уничтожать. Точнее - была. Экзорцистов больше нет - оказавшись более не востребованными демоноборцы тихо пропали из церковных летописей и скрижалей истории. Однако противники их не исчезли: живут себе и здравствуют и поныне внутри пространственных искажений-холдов, и, в общем-то неплохо живут. Многие и в гости к обычным людям ходят и использования благ человеческой цивилизации отнюдь не чураются. Правда, магия в нашем мире после закончившегося не без участия демоноборцев противостояния уже лет этак двести как не работает... ...Конечно же, всегда находится тот, кого сложившееся положение дел не устраивает. Попытки  "вернуть" магию из легенд и религиозных страшилок забывшему о колдовстве, как о страшном сне, человечеству раз за разом повторялись за прошедшие века. И ни разу не обошлось без участия экзорцистов. Не обойдется и теперь.</ns1:cycleDescription>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
  </rdf:Description>
