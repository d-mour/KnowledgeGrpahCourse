    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Раскол цивилизации»</ns1:hasName>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#ktatukov"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
