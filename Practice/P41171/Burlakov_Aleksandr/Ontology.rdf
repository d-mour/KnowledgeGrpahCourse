  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle13035">
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#semenafanasiev"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book121974"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns1:isEnded>
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-11T11:03:06</ns1:publicationDate>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Очень странный мир, в котором эльфы - это вовсе не возвышенные любители поэзии и музыки, а порой - просто утончённые садисты, пытающие детей.Гномы - не только очаровательные мастера на все руки, но и раса, считающая всех по определению ниже себя. Соответственно, и жить не-гномам незачем.Люди - с ними только предстоит разбираться. Не особо они тут что-то решают...А ты - самый обычный попаданец.</ns1:cycleDescription>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Очкарик»</ns1:hasName>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book117766"/>
