  <rdf:Description rdf:about="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Cycle02489">
    <ns1:publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-16T04:30:44</ns1:publicationDate>
    <ns1:firstPublicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-11-11T17:06:10</ns1:firstPublicationDate>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book030699"/>
    <ns1:cycleDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Небесный эфир пронизывает всё сущее, и знающие люди способны прикасаться к нему, изменять, использовать в собственных целях. И отнюдь не всегда – во благо окружающим. Императорский эдикт вывел учёное сообщество из-под юрисдикции и светских, и церковных властей, но университетские суды рассматривают лишь пьяные выходки школяров и тяжбы повздоривших профессоров, расследование наиболее важных инцидентов находится в юрисдикции Вселенской коллегии по этике.Филипп Олеандр вон Черен по прозвищу Ренегат - магистр-расследующий, молодой и амбициозный. У него собственные счёты к чернокнижникам, хватает и скелетов в шкафу. Филипп не любит вспоминать обстоятельства гибели брата-близнеца, но когда-нибудь... Когда-нибудь кто-то ответит за всё.</ns1:cycleDescription>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book052417"/>
    <ns1:hasBooksInCycle rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#Book068312"/>
    <ns1:isEnded rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:isEnded>
    <ns1:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цикл «Небесный эфир»</ns1:hasName>
    <ns1:hasAuthor rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#kornev"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/samit/ontologies/2021/4/authortoday#BookCycles"/>
