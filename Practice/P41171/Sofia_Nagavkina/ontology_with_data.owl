###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#doorsCount
:doorsCount rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:domain :Car ;
            rdfs:range [ rdf:type rdfs:Datatype ;
                         owl:oneOf [ rdf:type rdf:List ;
                                     rdf:first 0 ;
                                     rdf:rest [ rdf:type rdf:List ;
                                                rdf:first 1 ;
                                                rdf:rest [ rdf:type rdf:List ;
                                                           rdf:first 2 ;
                                                           rdf:rest [ rdf:type rdf:List ;
                                                                      rdf:first 3 ;
                                                                      rdf:rest [ rdf:type rdf:List ;
                                                                                 rdf:first 4 ;
                                                                                 rdf:rest [ rdf:type rdf:List ;
                                                                                            rdf:first 5 ;
                                                                                            rdf:rest rdf:nil
                                                                                          ]
                                                                               ]
                                                                    ]
                                                         ]
                                              ]
                                   ]
                       ] .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#fuelConsumption
:fuelConsumption rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf owl:topDataProperty ;
                 rdfs:domain :Car ;
                 rdfs:range xsd:double .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#height
:height rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf owl:topDataProperty ;
        rdfs:domain :Car ;
        rdfs:range xsd:integer .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#length
:length rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf owl:topDataProperty ;
        rdfs:domain :Car ;
        rdfs:range xsd:integer .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#photo
:photo rdf:type owl:DatatypeProperty ;
       rdfs:domain :Car ;
       rdfs:range xsd:anyURI .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#power
:power rdf:type owl:DatatypeProperty ;
       rdfs:domain :Car ;
       rdfs:range xsd:integer .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#safety
:safety rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf owl:topDataProperty .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#seats
:seats rdf:type owl:DatatypeProperty ;
       rdfs:subPropertyOf owl:topDataProperty ;
       rdfs:domain :Car ;
       rdfs:range xsd:integer .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#width
:width rdf:type owl:DatatypeProperty ;
       rdfs:subPropertyOf owl:topDataProperty ;
       rdfs:domain :Car ;
       rdfs:range xsd:integer .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#year
:year rdf:type owl:DatatypeProperty ;
      rdfs:domain :Car ;
      rdfs:range [ rdf:type rdfs:Datatype ;
                   owl:onDatatype xsd:integer ;
                   owl:withRestrictions ( [ xsd:minInclusive 1886
                                          ]
                                          [ xsd:maxExclusive 2021
                                          ]
                                        )
                 ] .


###  http://www.w3.org/2002/07/owl#topDataProperty
owl:topDataProperty rdf:type owl:FunctionalProperty .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#BudjetCar
:BudjetCar rdf:type owl:Class ;
           rdfs:subClassOf :CarType .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#Car
:Car rdf:type owl:Class ;
     rdfs:subClassOf :Model .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#CarType
:CarType rdf:type owl:Class .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#FamilyCar
:FamilyCar rdf:type owl:Class ;
           rdfs:subClassOf :CarType .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#LuxCar
:LuxCar rdf:type owl:Class ;
        rdfs:subClassOf :CarType .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#Manufacturer
:Manufacturer rdf:type owl:Class .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#Model
:Model rdf:type owl:Class .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#RareCar
:RareCar rdf:type owl:Class ;
         rdfs:subClassOf :CarType .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#SmallCar
:SmallCar rdf:type owl:Class ;
          rdfs:subClassOf :CarType .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#
: rdf:type owl:NamedIndividual ,
           :Manufacturer .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#A1
:A1 rdf:type owl:NamedIndividual ,
             :Model ;
    :createdBy :AUDI ;
    :availabilityCount 70 ;
    :isPopular "false"^^xsd:boolean ;
    :name "A1" ;
    :year_from 2010 ;
    :year_to 2021 .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#A1_HATCHBACK_3_DOORS_2010
:A1_HATCHBACK_3_DOORS_2010 rdf:type owl:NamedIndividual ,
                                    :Car ;
                           :isOfModel :A1 ;
                           :availabilityCount 1 ;
                           :bodyType "HATCHBACK_3_DOORS" ;
                           :class "B" ;
                           :clearence 130 ;
                           :cost 650000 ;
                           :doorsCount 3 ;
                           :fuelConsumption 5 ;
                           :height 1416 ;
                           :length 3954 ;
                           :photo "http://avatars.mds.yandex.net/get-verba/1030388/2a000001609d043f03938248d6ae13f8a9bc/cattouchret" ;
                           :power 86 ;
                           :width 1740 ;
                           :year 2010 .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#A1_HATCHBACK_3_DOORS_2011
:A1_HATCHBACK_3_DOORS_2011 rdf:type owl:NamedIndividual ,
                                    :Car ;
                           :isOfModel :A1 ;
                           :availabilityCount 2 ;
                           :bodyType "HATCHBACK_3_DOORS" ;
