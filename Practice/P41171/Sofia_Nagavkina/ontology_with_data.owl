@prefix : <http://www.semanticweb.org/sofia/ontologies/2021/3/cars#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/sofia/ontologies/2021/3/cars> .

<http://www.semanticweb.org/sofia/ontologies/2021/3/cars> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#isPopular
:isPopular rdf:type owl:AnnotationProperty .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#name
:name rdf:type owl:AnnotationProperty .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#year_from
:year_from rdf:type owl:AnnotationProperty .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#year_to
:year_to rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#createdBy
:createdBy rdf:type owl:ObjectProperty ;
           owl:inverseOf :producesModel ;
           rdf:type owl:FunctionalProperty ,
                    owl:TransitiveProperty ;
           rdfs:domain :Car ,
                       :Model ;
           rdfs:range :Manufacturer .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#isOfModel
:isOfModel rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf owl:topObjectProperty ;
           rdf:type owl:FunctionalProperty ;
           rdfs:domain :Car ;
           rdfs:range :Model .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#isOfType
:isOfType rdf:type owl:ObjectProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :Car ;
          rdfs:range :CarType .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#producesModel
:producesModel rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdf:type owl:InverseFunctionalProperty .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#AOP
:AOP rdf:type owl:DatatypeProperty ;
     rdfs:subPropertyOf :safety ;
     rdfs:domain :Car ;
     rdfs:range xsd:integer .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#COP
:COP rdf:type owl:DatatypeProperty ;
     rdfs:subPropertyOf :safety ;
     rdfs:domain :Car ;
     rdfs:range xsd:integer .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#SA
:SA rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf :safety ;
    rdfs:domain :Car ;
    rdfs:range xsd:integer .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#VRU
:VRU rdf:type owl:DatatypeProperty ;
     rdfs:subPropertyOf :safety ;
     rdfs:domain :Car ;
     rdfs:range xsd:integer .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#availabilityCount
:availabilityCount rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Car ,
                               :Model ;
                   rdfs:range xsd:integer .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#bodyType
:bodyType rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf owl:topDataProperty ;
          rdfs:domain :Car ;
          rdfs:range xsd:string .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#class
:class rdf:type owl:DatatypeProperty ;
       rdfs:subPropertyOf owl:topDataProperty ;
       rdfs:domain :Model ;
       rdfs:range [ rdf:type rdfs:Datatype ;
                    owl:oneOf [ rdf:type rdf:List ;
                                rdf:first "A" ;
                                rdf:rest [ rdf:type rdf:List ;
                                           rdf:first "B" ;
                                           rdf:rest [ rdf:type rdf:List ;
                                                      rdf:first "C" ;
                                                      rdf:rest [ rdf:type rdf:List ;
                                                                 rdf:first "D" ;
                                                                 rdf:rest [ rdf:type rdf:List ;
                                                                            rdf:first "E" ;
                                                                            rdf:rest [ rdf:type rdf:List ;
                                                                                       rdf:first "F" ;
                                                                                       rdf:rest [ rdf:type rdf:List ;
                                                                                                  rdf:first "G" ;
                                                                                                  rdf:rest [ rdf:type rdf:List ;
                                                                                                             rdf:first "H" ;
                                                                                                             rdf:rest [ rdf:type rdf:List ;
                                                                                                                        rdf:first "MPV" ;
                                                                                                                        rdf:rest [ rdf:type rdf:List ;
                                                                                                                                   rdf:first "SUV1" ;
                                                                                                                                   rdf:rest [ rdf:type rdf:List ;
                                                                                                                                              rdf:first "SUV2" ;
                                                                                                                                              rdf:rest rdf:nil
                                                                                                                                            ]
                                                                                                                                 ]
                                                                                                                      ]
                                                                                                           ]
                                                                                                ]
                                                                                     ]
                                                                          ]
                                                               ]
                                                    ]
                                         ]
                              ]
                  ] .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#clearence
:clearence rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf owl:topDataProperty ;
           rdfs:domain :Car ;
           rdfs:range xsd:integer .


###  http://www.semanticweb.org/sofia/ontologies/2021/3/cars#cost
:cost rdf:type owl:DatatypeProperty ;
      rdfs:subPropertyOf owl:topDataProperty ;
      rdfs:range xsd:integer .


