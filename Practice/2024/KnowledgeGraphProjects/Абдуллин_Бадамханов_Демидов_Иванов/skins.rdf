    <ex:weaponName>M4A4</ex:weaponName>
    <ex:skinName>Облом</ex:skinName>
    <ex:skinEnglishName>Buzz Kill</ex:skinEnglishName>
    <ex:floatRange>0.00 - 1.00</ex:floatRange>
