    <ex:weaponName>P250</ex:weaponName>
    <ex:skinName>Сверхновая</ex:skinName>
    <ex:skinEnglishName>Supernova</ex:skinEnglishName>
    <ex:floatRange>0.00 - 0.50</ex:floatRange>
    <ex:rarity>Раритетное</ex:rarity>
    <ex:collection>Прорыв</ex:collection>
    <ex:operation>Operation Breakout Weapon Case</ex:operation>
    <ex:description>Космический узор с оттенками фиолетового и оранжевого.</ex:description>
